export type Input = { left: i32
 right: i32 }

export type Output = { sum: i32
 difference: i32
 product: i32
 quotient: i32
 remainder: i32 }

export default function (in: Input): Output {
return { sum: in.left + in.right, difference: in.left - in.right, product: in.left * in.right, quotient: in.left / in.right, remainder: in.left % in.right }
}
