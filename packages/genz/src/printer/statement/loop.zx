import integers from "std:integer"

import { Action, ByteSource } from "../model"
import { StatementsKind } from "../model/statements"
import { Token } from "../model/token"

import type { Step, Frame } from "../model"

export type Input = Step

export type Output = Frame[]

export default function (in: Input): Output {
    const tree = in.source.statements
    const kind = tree.tags[integers.widen(in.frame.id)]
    const id = tree.offsets[integers.widen(in.frame.id)]
    const row = integers.widen(id)
    const frame: Frame = { action: Action.Text, token: Token.Empty, bytes: ByteSource.None, id: id, count: 0, index: 0, number: 0 }

    if (kind == StatementsKind.ForLoop) {
        const indexed = tree.for_loop_index_capture[row] != null
        const opening: Frame[] = [{ ...frame, token: Token.ForOpen }, { ...frame, action: Action.Expression, id: tree.for_loop_iterable[row] }]
        const range = indexed ? opening.push({ ...frame, token: Token.IndexRange })[0] : opening
        const capture = range.push({ ...frame, token: Token.ForCapture })[0]
        const referenced = tree.for_loop_capture_reference[row] ? capture.push({ ...frame, token: Token.Multiply })[0] : capture
        const named = referenced.push({ ...frame, action: Action.BindingIdentifier, bytes: ByteSource.ForCapture })[0]
        const bound = indexed ? named.concat([{ ...frame, token: Token.CommaSpace }, { ...frame, action: Action.Identifier, bytes: ByteSource.ForIndexCapture }])[0] : named

        return bound.concat([{ ...frame, token: Token.CaptureClose }, { ...frame, action: Action.Block, id: tree.for_loop_body_start[row], count: tree.for_loop_body_len[row] }, { ...frame, token: Token.Newline }])[0]
    }

    const opening: Frame[] = [{ ...frame, token: Token.WhileOpen }, { ...frame, action: Action.Expression, id: tree.while_loop_condition[row] }, { ...frame, token: Token.CloseSpace }]
    const captured = tree.while_loop_capture[row] == null ? opening : opening.concat([{ ...frame, token: Token.CaptureOpen }, { ...frame, action: Action.Identifier, bytes: ByteSource.WhileCapture }, { ...frame, token: Token.CaptureClose }])[0]

    return captured.concat([{ ...frame, action: Action.Block, id: tree.while_loop_body_start[row], count: tree.while_loop_body_len[row] }, { ...frame, token: Token.Newline }])[0]
}
