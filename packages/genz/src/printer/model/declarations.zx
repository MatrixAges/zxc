export enum DeclarationsKind { Constant, Variable, Function, Field, ComptimeScope }

export type Declarations = {
    tags: DeclarationsKind[]
    offsets: u32[]
    constant_name: u8[][]
    constant_type_expr: u32?[]
    constant_value: u32[]
    constant_exported: bool[]
    variable_name: u8[][]
    variable_type_expr: u32?[]
    variable_value: u32[]
    variable_exported: bool[]
    function_name: u8[][]
    function_parameters_start: u32[]
    function_parameters_len: u32[]
    function_return_type: u32[]
    function_body_start: u32[]
    function_body_len: u32[]
    function_exported: bool[]
    function_abi_export: bool[]
    function_inlined: bool[]
    function_calling_convention: u32?[]
    field_name: u8[][]
    field_value: u32[]
    field_default_value: u32?[]
    field_comptime_parameter: bool[]
    comptime_scope_start: u32[]
    comptime_scope_len: u32[]
}
