import { decimal_radix } from "core/const"

import {decimal_digits} from "../../const"

export type Input = {
    output: u8[],
    value: u64
}

export type Output = u8[]

export default function (in: Input): Output {
    const first = in.output.length

    const written = loop({
        output: in.output,
        value: in.value
    }, {
        do: current => {
            current.output =
                current.output.push(
                    decimal_digits[current.value % decimal_radix]
                )[0]
            current.value = current.value / decimal_radix
        },
        while: current => current.value != 0,
        return: state => state.output
    })

    return loop({
        output: written,
        left: first,
        right: written.length - 1
    }, {
        while: current => current.left < current.right,
        next: current => {
            const left = current.output[current.left]

            current.output[current.left] = current.output[current.right]
            current.output[current.right] = left
            current.left += 1
            current.right -= 1
        },
        return: state => state.output
    })
}
