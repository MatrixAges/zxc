import integers from "std:integer"
import {
    ascii_backslash,
    ascii_carriage_return,
    ascii_double_quote,
    ascii_line_feed,
    ascii_lower_n,
    ascii_lower_r,
    ascii_lower_t,
    ascii_lower_x,
    ascii_printable_last,
    ascii_space,
    ascii_tab
} from "core/ascii/const"
import { hexadecimal_radix } from "core/const"

import { hexadecimal_digits } from "../../const"

export type Input = {
    output: u8[],
    bytes: u8[]
}

export type Output = u8[]

export default function (in: Input): Output {
    return loop({
        output: in.output.push(ascii_double_quote)[0],
        index: 0,
        bytes: in.bytes,
        digits: hexadecimal_digits
    }, {
        while: current => current.index < current.bytes.length,
        next: current => {
            const byte = current.bytes[current.index]

            if (byte == ascii_double_quote || byte == ascii_backslash) {
                current.output = current.output.concat([
                    ascii_backslash,
                    byte
                ])[0]
            } else {
                const condition = (
                    - byte == ascii_line_feed
                    - or byte == ascii_carriage_return
                    - or byte == ascii_tab
                )

                if (condition) {
                    current.output =
                        current.output.concat(
                            [
                                ascii_backslash,
                                match byte {
                                    ascii_line_feed => ascii_lower_n,
                                    ascii_carriage_return => ascii_lower_r,
                                    _ => ascii_lower_t,
                                }
                            ]
                        )[0]
                } else if (byte >= ascii_space && byte <= ascii_printable_last) {
                    current.output = current.output.push(byte)[0]
                } else {
                    current.output =
                        current.output.concat(
                            [
                                ascii_backslash,
                                ascii_lower_x,
                                current
                                    .digits[integers.widenByte(byte) /
                                        hexadecimal_radix],
                                current
                                    .digits[integers.widenByte(byte) %
                                        hexadecimal_radix]
                            ]
                        )[0]
                }
            }

            current.index += 1
        },
        return: state => state.output.push(ascii_double_quote)[0]
    })
}
