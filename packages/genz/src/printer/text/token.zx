import { Token } from "../model/token"
import {
    token_discard_error,
    token_float_open,
    token_set_runtime_safety,
    token_unreachable_statement
} from "./token/const"
import {
    token_add,
    token_address_open,
    token_align_cast,
    token_and,
    token_anyerror,
    token_anyopaque,
    token_anytype,
    token_arm_arrow,
    token_array_close,
    token_array_open,
    token_as,
    token_assignment,
    token_bool,
    token_brace_close,
    token_brace_open,
    token_break,
    token_break_label,
    token_builtin,
    token_call_convention,
    token_capture_close,
    token_capture_open,
    token_catch,
    token_catch_break,
    token_catch_capture,
    token_close,
    token_close_space,
    token_colon,
    token_comma,
    token_comma_space,
    token_compile_error,
    token_comptime_open,
    token_comptime_prefix,
    token_conditional_open,
    token_const_cast,
    token_const_pointer,
    token_const_prefix,
    token_const_slice,
    token_continue,
    token_defer_prefix,
    token_dereference,
    token_discard,
    token_div_trunc,
    token_divide,
    token_dot,
    token_else,
    token_else_separator,
    token_embed_file,
    token_enum_from_int,
    token_enum_open,
    token_equal,
    token_errdefer_prefix,
    token_error_name,
    token_error_set_open,
    token_error_union,
    token_error_value,
    token_export,
    token_export_prefix,
    token_f32,
    token_f64,
    token_false,
    token_field,
    token_field_builtin,
    token_field_end,
    token_field_type,
    token_float_cast,
    token_float_close,
    token_float_from_int,
    token_fn_prefix,
    token_for_capture,
    token_for_open,
    token_greater,
    token_greater_equal,
    token_has_field,
    token_i32,
    token_i33,
    token_i64,
    token_i65,
    token_if_open,
    token_import,
    token_index,
    token_index_range,
    token_inferred_array,
    token_inline_prefix,
    token_int,
    token_int_cast,
    token_int_from_bool,
    token_int_from_enum,
    token_int_from_float,
    token_int_from_ptr,
    token_less,
    token_less_equal,
    token_many_pointer,
    token_max,
    token_memcpy,
    token_multiply,
    token_negate_open,
    token_newline,
    token_not_equal,
    token_not_open,
    token_null,
    token_object_close,
    token_object_field,
    token_opaque,
    token_open,
    token_optional,
    token_optional_value,
    token_or,
    token_orelse,
    token_ptr_cast,
    token_pub_prefix,
    token_range,
    token_reference_capture,
    token_rem,
    token_return,
    token_saturating_add,
    token_selection_body,
    token_shift_left,
    token_size_of,
    token_slice,
    token_space,
    token_splat,
    token_statement_end,
    token_struct_open,
    token_subtract,
    token_switch_open,
    token_tag_name,
    token_this,
    token_true,
    token_trunc,
    token_try_open,
    token_tuple_open,
    token_tuple_type_open,
    token_type,
    token_type_info,
    token_type_of,
    token_u16,
    token_u32,
    token_u64,
    token_u8,
    token_undefined,
    token_unit,
    token_unreachable,
    token_usize,
    token_var_prefix,
    token_vector,
    token_void,
    token_while_open,
    token_zero
} from "./token/const"

export type Input = Token

export type Output = string

export default function (in: Input): Output {
    return match in {
        Token.Add => token_add,
        Token.AddressOpen => token_address_open,
        Token.AlignCast => token_align_cast,
        Token.And => token_and,
        Token.Anyerror => token_anyerror,
        Token.Anyopaque => token_anyopaque,
        Token.Anytype => token_anytype,
        Token.ArmArrow => token_arm_arrow,
        Token.ArrayClose => token_array_close,
        Token.ArrayOpen => token_array_open,
        Token.As => token_as,
        Token.Assignment => token_assignment,
        Token.Bool => token_bool,
        Token.BraceClose => token_brace_close,
        Token.BraceOpen => token_brace_open,
        Token.Break => token_break,
        Token.BreakLabel => token_break_label,
        Token.Builtin => token_builtin,
        Token.CallConvention => token_call_convention,
        Token.CaptureClose => token_capture_close,
        Token.CaptureOpen => token_capture_open,
        Token.Catch => token_catch,
        Token.CatchBreak => token_catch_break,
        Token.CatchCapture => token_catch_capture,
        Token.Close => token_close,
        Token.CloseSpace => token_close_space,
        Token.Colon => token_colon,
        Token.Comma => token_comma,
        Token.CommaSpace => token_comma_space,
        Token.CompileError => token_compile_error,
        Token.ComptimeOpen => token_comptime_open,
        Token.ComptimePrefix => token_comptime_prefix,
        Token.ConditionalOpen => token_conditional_open,
        Token.ConstCast => token_const_cast,
        Token.ConstPointer => token_const_pointer,
        Token.ConstPrefix => token_const_prefix,
        Token.ConstSlice => token_const_slice,
        Token.Continue => token_continue,
        Token.DeferPrefix => token_defer_prefix,
        Token.Dereference => token_dereference,
        Token.Discard => token_discard,
        Token.DiscardError => token_discard_error,
        Token.DivTrunc => token_div_trunc,
        Token.Divide => token_divide,
        Token.Dot => token_dot,
        Token.Else => token_else,
        Token.ElseSeparator => token_else_separator,
        Token.EmbedFile => token_embed_file,
        Token.EnumFromInt => token_enum_from_int,
        Token.EnumOpen => token_enum_open,
        Token.Equal => token_equal,
        Token.ErrdeferPrefix => token_errdefer_prefix,
        Token.ErrorName => token_error_name,
        Token.ErrorSetOpen => token_error_set_open,
        Token.ErrorUnion => token_error_union,
        Token.ErrorValue => token_error_value,
        Token.Export => token_export,
        Token.ExportPrefix => token_export_prefix,
        Token.F32 => token_f32,
        Token.F64 => token_f64,
        Token.False => token_false,
        Token.Field => token_field,
        Token.FieldBuiltin => token_field_builtin,
        Token.FieldEnd => token_field_end,
        Token.FieldType => token_field_type,
        Token.FloatCast => token_float_cast,
        Token.FloatClose => token_float_close,
        Token.FloatFromInt => token_float_from_int,
        Token.FloatOpen => token_float_open,
        Token.FnPrefix => token_fn_prefix,
        Token.ForCapture => token_for_capture,
        Token.ForOpen => token_for_open,
        Token.Greater => token_greater,
        Token.GreaterEqual => token_greater_equal,
        Token.HasField => token_has_field,
        Token.I32 => token_i32,
        Token.I33 => token_i33,
        Token.I64 => token_i64,
        Token.I65 => token_i65,
        Token.IfOpen => token_if_open,
        Token.Import => token_import,
        Token.Index => token_index,
        Token.IndexRange => token_index_range,
        Token.InferredArray => token_inferred_array,
        Token.InlinePrefix => token_inline_prefix,
        Token.Int => token_int,
        Token.IntCast => token_int_cast,
        Token.IntFromBool => token_int_from_bool,
        Token.IntFromEnum => token_int_from_enum,
        Token.IntFromFloat => token_int_from_float,
        Token.IntFromPtr => token_int_from_ptr,
        Token.Less => token_less,
        Token.LessEqual => token_less_equal,
        Token.ManyPointer => token_many_pointer,
        Token.Max => token_max,
        Token.Memcpy => token_memcpy,
        Token.Multiply => token_multiply,
        Token.NegateOpen => token_negate_open,
        Token.Newline => token_newline,
        Token.NotEqual => token_not_equal,
        Token.NotOpen => token_not_open,
        Token.Null => token_null,
        Token.ObjectClose => token_object_close,
        Token.ObjectField => token_object_field,
        Token.Opaque => token_opaque,
        Token.Open => token_open,
        Token.Optional => token_optional,
        Token.OptionalValue => token_optional_value,
        Token.Or => token_or,
        Token.Orelse => token_orelse,
        Token.PtrCast => token_ptr_cast,
        Token.PubPrefix => token_pub_prefix,
        Token.Range => token_range,
        Token.ReferenceCapture => token_reference_capture,
        Token.Rem => token_rem,
        Token.Return => token_return,
        Token.SaturatingAdd => token_saturating_add,
        Token.SelectionBody => token_selection_body,
        Token.SetRuntimeSafety => token_set_runtime_safety,
        Token.ShiftLeft => token_shift_left,
        Token.SizeOf => token_size_of,
        Token.Slice => token_slice,
        Token.Space => token_space,
        Token.Splat => token_splat,
        Token.StatementEnd => token_statement_end,
        Token.StructOpen => token_struct_open,
        Token.Subtract => token_subtract,
        Token.SwitchOpen => token_switch_open,
        Token.TagName => token_tag_name,
        Token.This => token_this,
        Token.True => token_true,
        Token.Trunc => token_trunc,
        Token.TryOpen => token_try_open,
        Token.TupleOpen => token_tuple_open,
        Token.TupleTypeOpen => token_tuple_type_open,
        Token.Type => token_type,
        Token.TypeInfo => token_type_info,
        Token.TypeOf => token_type_of,
        Token.U16 => token_u16,
        Token.U32 => token_u32,
        Token.U64 => token_u64,
        Token.U8 => token_u8,
        Token.Undefined => token_undefined,
        Token.Unit => token_unit,
        Token.Unreachable => token_unreachable,
        Token.UnreachableStatement => token_unreachable_statement,
        Token.Usize => token_usize,
        Token.VarPrefix => token_var_prefix,
        Token.Vector => token_vector,
        Token.Void => token_void,
        Token.WhileOpen => token_while_open,
        Token.Zero => token_zero,
        _ => "",
    }
}
