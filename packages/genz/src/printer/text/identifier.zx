import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_underscore,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import keyword from "./identifier/keyword"

export type Input = u8[]

export type Output = bool

export default function (in: Input): Output {
    if (in.length == 0) {
        return false
    }

    if (in.length == 1 && in[0] == ascii_underscore) {
        return false
    }

    const first = in[0]

    const first_2 = !(first >= ascii_upper_first && first <= ascii_upper_last)

    const first_3 = !(
        first >= ascii_lower_first && first <= ascii_lower_last
    )

    const condition_2 = (
        - first != ascii_underscore
        - and first_2
        - and first_3
    )

    if (condition_2) {
        return false
    }

    if (
        !in.every(
            byte => {
                const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
                const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
                const digit = byte >= ascii_digit_first && byte <= ascii_digit_last

                return (
                    - byte == ascii_underscore
                    - or upper
                    - or lower
                    - or digit
                )
            }
        )
    ) {
        return false
    }

    return !keyword(in)
}
