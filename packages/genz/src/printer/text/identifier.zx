import {
    ascii_lower_b,
    ascii_lower_c,
    ascii_lower_d,
    ascii_lower_e,
    ascii_lower_f,
    ascii_lower_i,
    ascii_lower_l,
    ascii_lower_n,
    ascii_lower_o,
    ascii_lower_p,
    ascii_lower_r,
    ascii_lower_s,
    ascii_lower_t,
    ascii_lower_u,
    ascii_lower_v,
    ascii_lower_w
} from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_underscore,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import {
    keyword_addrspace,
    keyword_align,
    keyword_allowzero,
    keyword_anyframe,
    keyword_asm,
    keyword_break,
    keyword_callconv,
    keyword_catch,
    keyword_comptime,
    keyword_const,
    keyword_continue,
    keyword_defer,
    keyword_enum,
    keyword_errdefer,
    keyword_error,
    keyword_extern,
    keyword_fn,
    keyword_for,
    keyword_if,
    keyword_inline,
    keyword_linksection,
    keyword_noalias,
    keyword_noinline,
    keyword_nosuspend,
    keyword_opaque,
    keyword_packed,
    keyword_pub,
    keyword_resume,
    keyword_struct,
    keyword_suspend,
    keyword_switch,
    keyword_test,
    keyword_threadlocal,
    keyword_try,
    keyword_union,
    keyword_var,
    keyword_volatile,
    keyword_while
} from "./identifier/const"
import {
    token_and,
    token_anytype,
    token_else,
    token_export,
    token_or,
    token_orelse,
    token_return,
    token_unreachable
} from "./token/const"

export type Input = u8[]

export type Output = bool

export default function (in: Input): Output {
    if (in.length == 0 || (in.length == 1 && in[0] == ascii_underscore)) {
        return false
    }

    const first = in[0]

    if (
        first != ascii_underscore &&
            !(first >= ascii_upper_first && first <= ascii_upper_last) && !(
                first >= ascii_lower_first && first <= ascii_lower_last
            )
    ) {
        return false
    }

    if (
        !in.every(
            byte =>
                byte == ascii_underscore ||
                (byte >= ascii_upper_first && byte <= ascii_upper_last) ||
                (
                    byte >= ascii_lower_first && byte <= ascii_lower_last
                ) || (
                    byte >= ascii_digit_first && byte <= ascii_digit_last
                )
        )
    ) {
        return false
    }

    const candidates: string[] = match first {
        ascii_lower_first =>
            [
                keyword_addrspace,
                keyword_align,
                keyword_allowzero,
                token_and,
                keyword_anyframe,
                token_anytype,
                keyword_asm
            ],
        ascii_lower_b => [keyword_break],
        ascii_lower_c =>
            [
                keyword_callconv,
                keyword_catch,
                keyword_comptime,
                keyword_const,
                keyword_continue
            ],
        ascii_lower_d => [keyword_defer],
        ascii_lower_e =>
            [
                token_else,
                keyword_enum,
                keyword_errdefer,
                keyword_error,
                token_export,
                keyword_extern
            ],
        ascii_lower_f => [keyword_fn, keyword_for],
        ascii_lower_i => [keyword_if, keyword_inline],
        ascii_lower_l => [keyword_linksection],
        ascii_lower_n => [keyword_noalias, keyword_noinline, keyword_nosuspend],
        ascii_lower_o => [keyword_opaque, token_or, token_orelse],
        ascii_lower_p => [keyword_packed, keyword_pub],
        ascii_lower_r => [keyword_resume, token_return],
        ascii_lower_s => [keyword_struct, keyword_suspend, keyword_switch],
        ascii_lower_t => [keyword_test, keyword_threadlocal, keyword_try],
        ascii_lower_u => [keyword_union, token_unreachable],
        ascii_lower_v => [keyword_var, keyword_volatile],
        ascii_lower_w => [keyword_while],
        _ => [],
    }

    const found = loop({
        bytes: in,
        candidates: candidates,
        index: 0,
        keyword: false
    }, {
        while: current =>
            current.index < current.candidates.length && !current.keyword,
        next: current => {
            const word = current.candidates[current.index]

            if (word.length == current.bytes.length) {
                const compared = loop({
                    bytes: current.bytes,
                    word: word,
                    index: 0,
                    equal: true
                }, {
                    while: comparison =>
                        comparison.index < comparison.bytes.length &&
                        comparison.equal,
                    next: comparison => {
                        comparison.equal =
                            comparison.bytes[comparison.index] ==
                            comparison.word[comparison.index]
                        comparison.index += 1
                    }
                })

                current.keyword = compared.equal
            }

            current.index += 1
        }
    })

    return !found.keyword
}
