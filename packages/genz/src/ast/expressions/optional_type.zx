import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { ExpressionsKind as Kind } from "../../printer/model/expressions"

export type Columns = {
    tags: Kind[],
    offsets: u32[],
    optional_type: u32[]
}

export type Input = {
    table: Columns,
    base: u32,
    value: u32
}

export type Output = {
    table: Columns,
    id: u32,
    valid: bool
}

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.OptionalType,
        offset: in.table.optional_type.length
    })

    return {
        table: {
            tags: result.tags,
            offsets: result.offsets,
            optional_type: in.table.optional_type.push(in.value)[0]
        },
        id: result.id,
        valid: result.valid
    }
}
