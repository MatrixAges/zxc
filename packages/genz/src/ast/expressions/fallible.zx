import { ExpressionsKind } from "../../printer/model/expressions"
import catchValue from "./catch"
import wrapper from "./wrapper"

import type { Columns, Result } from "./model"

export type Capture = {
    name: u8[],
    label: u8[],
    failure: u32
}

export type Input = {
    table: Columns,
    base: u32,
    value: u32,
    capture?: Capture
}

export type Output = Result

export default function (in: Input): Output {
    const capture = in.capture

    if (capture == null) {
        return wrapper({
            table: in.table,
            base: in.base,
            kind: ExpressionsKind.TryValue,
            value: in.value
        })
    }

    return catchValue({
        table: in.table,
        base: in.base,
        value: in.value,
        capture: capture.name,
        label: capture.label,
        result: capture.failure
    })
}
