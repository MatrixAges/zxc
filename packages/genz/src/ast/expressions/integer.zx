import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    value: u64
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: ExpressionsKind.Integer,
        offset: in.table.integer.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            integer: result.table.integer.push(in.value)[0]
        }
    }
}
