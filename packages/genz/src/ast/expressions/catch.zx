import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    value: u32,
    capture: u8[],
    label: u8[],
    result: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.CatchValue,
        offset: in.table.catch_value_value.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            catch_value_value: in.table.catch_value_value.push(in.value)[0],
            catch_value_capture: in.table.catch_value_capture.push(in.capture)[0],
            catch_value_label: in.table.catch_value_label.push(in.label)[0],
            catch_value_result: in.table.catch_value_result.push(in.result)[0]
        }
    }
}
