import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    target: u32,
    name: u8[]
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: ExpressionsKind.Field,
        offset: in.table.field_target.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            field_target: result.table.field_target.push(in.target)[0],
            field_name: result.table.field_name.push(in.name)[0]
        }
    }
}
