import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

export type Columns = {
    tags: ExpressionsKind[],
    offsets: u32[],
    catch_scope_value: u32[],
    catch_scope_capture: u8[]?[],
    catch_scope_body_start: u32[],
    catch_scope_body_len: u32[]
}

export type Input = {
    table: Columns,
    base: u32,
    value: u32,
    capture?: u8[],
    start: u32,
    count: u32
}

export type Output = {
    table: Columns,
    id: u32,
    valid: bool
}

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.CatchScope,
        offset: in.table.catch_scope_value.length
    })

    return {
        id: result.id,
        valid: result.valid,
        table: {
            tags: result.tags,
            offsets: result.offsets,
            catch_scope_value: in.table.catch_scope_value.push(in.value)[0],
            catch_scope_capture: in.table.catch_scope_capture.push(in.capture)[0],
            catch_scope_body_start: in.table.catch_scope_body_start.push(in.start)[0],
            catch_scope_body_len: in.table.catch_scope_body_len.push(in.count)[0]
        }
    }
}
