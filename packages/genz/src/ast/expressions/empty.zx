import type { Columns } from "./model"

export type Input = {}

export type Output = Columns

export default function (in: Input): Output {
    return {
        tags: [],
        offsets: [],
        unary_operator: [],
        unary_operand: [],
        binary_operator: [],
        binary_left: [],
        binary_right: [],
        builtin_name: [],
        builtin_arguments: []
    }
}
