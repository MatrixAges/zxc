import type { Columns } from "./model"

export type Input = {}

export type Output = Columns

export default function (in: Input): Output {
    return {
        tags: [],
        offsets: [],
        unary_operator: [],
        unary_operand: [],
        binary_operator: [],
        binary_left: [],
        binary_right: [],
        builtin_name: [],
        builtin_arguments: [],
        identifier: [],
        integer: [],
        field_target: [],
        field_name: [],
        call_callee: [],
        call_arguments: [],
        try_value: [],
        comptime_value: [],
        dereference: [],
        catch_value_value: [],
        catch_value_capture: [],
        catch_value_label: [],
        catch_value_result: [],
        slice_target: [],
        slice_start: [],
        slice_end: [],
        range_start: [],
        range_end: [],
        index_target: [],
        index_index: [],
        block_label: [],
        block_statements_start: [],
        block_statements_len: []
    }
}
