import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { ExpressionsBuiltinName } from "../../printer/model/expressions"
import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    name: ExpressionsBuiltinName,
    arguments: u32[]
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.Builtin,
        offset: in.table.builtin_name.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            builtin_name: in.table.builtin_name.push(in.name)[0],
            builtin_arguments: in.table.builtin_arguments.push(in.arguments)[0]
        }
    }
}
