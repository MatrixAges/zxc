import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { ExpressionsBuiltinName } from "../../printer/model/expressions"
import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    name: ExpressionsBuiltinName,
    arguments: u32[]
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: ExpressionsKind.Builtin,
        offset: in.table.builtin_name.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            builtin_name: result.table.builtin_name.push(in.name)[0],
            builtin_arguments: result.table.builtin_arguments.push(in.arguments)[0]
        }
    }
}
