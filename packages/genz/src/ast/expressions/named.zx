import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

export type Input = {
    tags: ExpressionsKind[],
    offsets: u32[],
    values: u8[][],
    base: u32,
    kind: ExpressionsKind,
    name: u8[]
}

export type Output = {
    tags: ExpressionsKind[],
    offsets: u32[],
    values: u8[][],
    id: u32,
    valid: bool
}

export default function (in: Input): Output {
    const result = header({
        ...in.pick([
            "tags",
            "offsets",
            "base",
            "kind"
        ]),
        offset: in.values.length
    })

    if (!result.valid) {
        return {
            ...result,
            values: in.values
        }
    }

    return {
        ...result,
        values: in.values.push(in.name)[0]
    }
}
