import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    kind: ExpressionsKind,
    value: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = match in.kind {
        ExpressionsKind.TryValue => in.table.try_value.length,
        ExpressionsKind.ComptimeValue => in.table.comptime_value.length,
        _ => in.table.dereference.length
    }
        -> header({
            ...in.table.pick([
                "tags",
                "offsets"
            ]),
            base: in.base,
            kind: in.kind,
            offset: _
        })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return match in.kind {
        ExpressionsKind.TryValue => {
            id: result.id,
            valid: result.valid,
            table: {
                ...in.table,
                tags: result.tags,
                offsets: result.offsets,
                try_value: in.table.try_value.push(in.value)[0]
            }
        },
        ExpressionsKind.ComptimeValue => {
            id: result.id,
            valid: result.valid,
            table: {
                ...in.table,
                tags: result.tags,
                offsets: result.offsets,
                comptime_value: in.table.comptime_value.push(in.value)[0]
            }
        },
        ExpressionsKind.Dereference => {
            id: result.id,
            valid: result.valid,
            table: {
                ...in.table,
                tags: result.tags,
                offsets: result.offsets,
                dereference: in.table.dereference.push(in.value)[0]
            }
        },
        _ => {
            table: {
                ...in.table,
                tags: result.tags,
                offsets: result.offsets
            },
            id: result.id,
            valid: false
        }
    }
}
