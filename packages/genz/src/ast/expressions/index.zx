import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    target: u32,
    index: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.Index,
        offset: in.table.index_target.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            index_target: in.table.index_target.push(in.target)[0],
            index_index: in.table.index_index.push(in.index)[0]
        }
    }
}
