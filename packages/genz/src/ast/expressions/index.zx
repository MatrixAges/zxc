import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    target: u32,
    index: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: ExpressionsKind.Index,
        offset: in.table.index_target.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            index_target: result.table.index_target.push(in.target)[0],
            index_index: result.table.index_index.push(in.index)[0]
        }
    }
}
