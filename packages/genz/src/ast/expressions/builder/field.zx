import { ExpressionsKind } from "../../../printer/model/expressions"
import header from "../header"

import type { State, Node as Output } from "./model"

export type Input = {
    state: State,
    target: u32,
    name: u8[]
}

export default function (in: Input): Output {
    const result = header({
        ...in.state.pick([
            "tags",
            "offsets",
            "base"
        ]),
        kind: ExpressionsKind.Field,
        offset: in.state.field_target.length
    })

    if (!result.valid) {
        return {
            state: {
                ...in.state,
                valid: false
            },
            id: result.id
        }
    }

    return {
        state: {
            ...in.state,
            tags: result.tags,
            offsets: result.offsets,
            field_target: in.state.field_target.push(in.target)[0],
            field_name: in.state.field_name.push(in.name)[0],
            valid: in.state.valid
        },
        id: result.id
    }
}
