import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    start: u32,
    end: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: ExpressionsKind.Range,
        offset: in.table.range_start.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            range_start: result.table.range_start.push(in.start)[0],
            range_end: result.table.range_end.push(in.end)[0]
        }
    }
}
