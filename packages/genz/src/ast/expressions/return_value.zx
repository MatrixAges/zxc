import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

export type Columns = {
    tags: ExpressionsKind[],
    offsets: u32[],
    return_value: u32?[]
}

export type Input = {
    table: Columns,
    base: u32,
    value?: u32
}

export type Output = {
    table: Columns,
    id: u32,
    valid: bool
}

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.ReturnValue,
        offset: in.table.return_value.length
    })

    return {
        table: {
            tags: result.tags,
            offsets: result.offsets,
            return_value: in.table.return_value.push(in.value)[0]
        },
        id: result.id,
        valid: result.valid
    }
}
