import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { ExpressionsUnaryOperator } from "../../printer/model/expressions"
import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    operator: ExpressionsUnaryOperator,
    operand: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.Unary,
        offset: in.table.unary_operator.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            unary_operator: in.table.unary_operator.push(in.operator)[0],
            unary_operand: in.table.unary_operand.push(in.operand)[0]
        }
    }
}
