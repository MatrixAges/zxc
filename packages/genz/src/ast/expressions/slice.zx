import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    target: u32,
    start?: u32,
    end?: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick(["tags", "offsets"]),
        base: in.base,
        kind: ExpressionsKind.Slice,
        offset: in.table.slice_target.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            slice_target: in.table.slice_target.push(in.target)[0],
            slice_start: in.table.slice_start.push(in.start)[0],
            slice_end: in.table.slice_end.push(in.end)[0]
        }
    }
}
