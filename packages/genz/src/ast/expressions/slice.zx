import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    target: u32,
    start: u32?,
    end: u32?
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: ExpressionsKind.Slice,
        offset: in.table.slice_target.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            slice_target: result.table.slice_target.push(in.target)[0],
            slice_start: result.table.slice_start.push(in.start)[0],
            slice_end: result.table.slice_end.push(in.end)[0]
        }
    }
}
