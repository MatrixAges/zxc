import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { ExpressionsBinaryOperator } from "../../printer/model/expressions"
import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    operator: ExpressionsBinaryOperator,
    left: u32,
    right: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: ExpressionsKind.Binary,
        offset: in.table.binary_operator.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            binary_operator: in.table.binary_operator.push(in.operator)[0],
            binary_left: in.table.binary_left.push(in.left)[0],
            binary_right: in.table.binary_right.push(in.right)[0]
        }
    }
}
