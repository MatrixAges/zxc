import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    name: u8[]
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick(["tags", "offsets"]),
        base: in.base,
        kind: ExpressionsKind.Identifier,
        offset: in.table.identifier.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            identifier: in.table.identifier.push(in.name)[0]
        }
    }
}
