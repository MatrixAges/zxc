import { ExpressionsKind } from "../../printer/model/expressions"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    callee: u32,
    arguments: u32[]
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick(["tags", "offsets"]),
        base: in.base,
        kind: ExpressionsKind.Call,
        offset: in.table.call_callee.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            id: result.id,
            valid: false
        }
    }

    return {
        id: result.id,
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            call_callee: in.table.call_callee.push(in.callee)[0],
            call_arguments: in.table.call_arguments.push(in.arguments)[0]
        }
    }
}
