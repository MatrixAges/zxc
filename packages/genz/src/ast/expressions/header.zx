import integers from "std:integer"
import { max_u32 } from "core/const"

import type { ExpressionsKind } from "../../printer/model/expressions"
import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    kind: ExpressionsKind,
    offset: u64
}

export type Output = Result

export default function (in: Input): Output {
    const id = integers.widen(in.base) + in.table.tags.length

    if (id >= integers.widen(max_u32)) {
        return {
            table: in.table,
            id: 0,
            valid: false
        }
    }

    return {
        table: {
            ...in.table,
            tags: in.table.tags.push(in.kind)[0],
            offsets: in.table.offsets.push(integers.narrow(in.offset))[0]
        },
        id: integers.narrow(id),
        valid: true
    }
}
