import integers from "std:integer"
import { max_u32 } from "core/const"

import type { ExpressionsKind } from "../../printer/model/expressions"

export type Input = {
    tags: ExpressionsKind[],
    offsets: u32[],
    base: u32,
    kind: ExpressionsKind,
    offset: u64
}

export type Output = {
    tags: ExpressionsKind[],
    offsets: u32[],
    id: u32,
    valid: bool
}

export default function (in: Input): Output {
    const id = integers.widen(in.base) + in.tags.length

    if (id >= integers.widen(max_u32)) {
        return {
            tags: in.tags,
            offsets: in.offsets,
            id: 0,
            valid: false
        }
    }

    return {
        tags: in.tags.push(in.kind)[0],
        offsets: in.offsets.push(integers.narrow(in.offset))[0],
        id: integers.narrow(id),
        valid: true
    }
}
