import { ExpressionsBuiltinName as Builtin } from "../../printer/model/expressions"
import builtin from "../context/builtin"
import evaluate from "./evaluate"

import type { StateBody } from "./model"

export type Input = {
    state: StateBody,
    target: u32,
    source: u32
}

export type Output = StateBody

export default function (in: Input): Output {
    const value = builtin({
        state: in.state.context,
        name: Builtin.Memcpy,
        arguments: [
            in.target,
            in.source
        ]
    })

    return evaluate({
        state: {
            context: value.state,
            body: in.state.body
        },
        value: value.id,
        discard: false
    })
}
