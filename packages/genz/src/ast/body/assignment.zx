import construct from "../statements/assignment"

import type { StateBody } from "./model"

export type Input = {
    state: StateBody,
    target: u32,
    value: u32
}

export type Output = StateBody

export default function (in: Input): Output {
    const { context, body } = in.state

    const result = construct({
        table: {
            ...context.statements,
            ...body
        },
        base: 0,
        target: in.target,
        value: in.value
    })

    return {
        context: {
            ...context,
            statements: {
                ...result.table,
                tags: context.statements.tags,
                offsets: context.statements.offsets
            },
            valid: context.valid && result.valid
        },
        body: result.table.pick([
            "tags",
            "offsets"
        ])
    }
}
