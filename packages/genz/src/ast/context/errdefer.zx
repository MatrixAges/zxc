import { StatementsKind } from "../../printer/model/statements"
import header from "../statements/header"

import type { State } from "./model"

export type Input = {
    state: State,
    value: u32
}

export type Output = State

export default function (in: Input): Output {
    const result = header({
        ...in.state.statements.pick([
            "tags",
            "offsets"
        ]),
        base: in.state.source.statement_base,
        kind: StatementsKind.ErrdeferExpression,
        offset: in.state.statements.errdefer_expression.length
    })

    return {
        ...in.state,
        statements: {
            ...in.state.statements,
            tags: result.tags,
            offsets: result.offsets,
            errdefer_expression:
                in.state.statements.errdefer_expression.push(in.value)[0]
        },
        valid: in.state.valid && result.valid
    }
}
