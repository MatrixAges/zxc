import call from "../expressions/call"
import checked from "../expressions/fallible"

import type { State, Node } from "./model"

export type Input = {
    state: State,
    callee: u32,
    arguments: u32[],
    fallible: bool
}

export type Output = Node

export default function (in: Input): Output {
    const result = call({
        table: in.state.expressions,
        base: in.state.source.expression_base,
        callee: in.callee,
        arguments: in.arguments
    })

    if (!in.fallible) {
        return {
            id: result.id,
            state: {
                ...in.state,
                expressions: result.table,
                valid: in.state.valid && result.valid
            }
        }
    }

    const value = checked({
        table: result.table,
        base: in.state.source.expression_base,
        value: result.id,
        capture: in.state.source.capture
    })

    return {
        id: value.id,
        state: {
            ...in.state,
            expressions: value.table,
            valid: in.state.valid && result.valid && value.valid
        }
    }
}
