import call from "./call"
import standardField from "./standard_field"

import type { State, Node } from "./model"

export type Input = {
    state: State,
    path: string[],
    arguments: u32[],
    fallible: bool
}

export type Output = Node

export default function (in: Input): Output {
    const target = standardField({
        state: in.state,
        path: in.path
    })

    return call({
        state: target.state,
        callee: target.id,
        arguments: in.arguments,
        fallible: in.fallible
    })
}
