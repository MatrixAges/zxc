import { StatementsKind } from "../../printer/model/statements"
import header from "../statements/header"

import type { State } from "./model"

export type Input = {
    state: State,
    name: u8[],
    type_expr: u32,
    value: u32
}

export type Output = State

export default function (in: Input): Output {
    const result = header({
        ...in.state.statements.pick([
            "tags",
            "offsets"
        ]),
        base: in.state.source.statement_base,
        kind: StatementsKind.Variable,
        offset: in.state.variables.variable_name.length
    })

    if (!result.valid) {
        return {
            ...in.state,
            valid: false
        }
    }

    return {
        ...in.state,
        statements: {
            ...in.state.statements,
            tags: result.tags,
            offsets: result.offsets
        },
        variables: {
            variable_name: in.state.variables.variable_name.push(in.name)[0],
            variable_type_expr:
                in.state.variables.variable_type_expr.push(in.type_expr)[0],
            variable_value: in.state.variables.variable_value.push(in.value)[0],
            variable_exported: in.state.variables.variable_exported.push(false)[0]
        }
    }
}
