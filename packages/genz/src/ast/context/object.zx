import object from "../expressions/object"

import type { State, Node as Output } from "./model"

export type Input = {
    state: State,
    type_expr?: u32,
    first: u32,
    count: u32
}

export default function (in: Input): Output {
    const state = in.state

    const result = object({
        table: {
            ...state.expressions.pick([
                "tags",
                "offsets"
            ]),
            ...state.forms.pick([
                "object_type_expr",
                "object_fields_start",
                "object_fields_len"
            ])
        },
        base: state.source.expression_base,
        type_expr: in.type_expr,
        start: in.first,
        count: in.count
    })

    return {
        id: result.id,
        state: {
            ...state,
            expressions: {
                ...state.expressions,
                ...result.table.pick([
                    "tags",
                    "offsets"
                ])
            },
            forms: {
                ...state.forms,
                ...result.table.omit([
                    "tags",
                    "offsets"
                ])
            },
            valid: state.valid && result.valid
        }
    }
}
