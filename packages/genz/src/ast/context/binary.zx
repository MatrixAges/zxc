import construct from "../expressions/binary"

import type { ExpressionsBinaryOperator } from "../../printer/model/expressions"
import type { State, Node } from "./model"

export type Input = {
    state: State,
    operator: ExpressionsBinaryOperator,
    left: u32,
    right: u32
}

export type Output = Node

export default function (in: Input): Output {
    const { state, operator, left, right } = in

    const result = construct({
        operator,
        left,
        right,
        table: state.expressions,
        base: state.source.expression_base
    })

    return {
        id: result.id,
        state: {
            ...state,
            expressions: result.table,
            valid: state.valid && result.valid
        }
    }
}
