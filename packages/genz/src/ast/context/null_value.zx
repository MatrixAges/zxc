import { ExpressionsKind } from "../../printer/model/expressions"
import header from "../expressions/header"

import type { State as Input, Node as Output } from "./model"

export default function (in: Input): Output {
    const result = header({
        ...in.expressions.pick([
            "tags",
            "offsets"
        ]),
        base: in.source.expression_base,
        kind: ExpressionsKind.NullValue,
        offset: in.null_count
    })

    return {
        id: result.id,
        state: {
            ...in,
            expressions: {
                ...in.expressions,
                tags: result.tags,
                offsets: result.offsets
            },
            null_count: in.null_count + 1,
            valid: in.valid && result.valid
        }
    }
}
