import { ExpressionsKind } from "../../printer/model/expressions"
import header from "../expressions/header"

import type { State, Node } from "./model"

export type Input = {
    state: State,
    condition: u32,
    yes: u32,
    no: u32
}

export type Output = Node

export default function (in: Input): Output {
    const result = header({
        ...in.state.expressions.pick([
            "tags",
            "offsets"
        ]),
        base: in.state.source.expression_base,
        kind: ExpressionsKind.Conditional,
        offset: in.state.forms.conditional_condition.length
    })

    if (!result.valid) {
        return {
            id: result.id,
            state: {
                ...in.state,
                valid: false
            }
        }
    }

    return {
        id: result.id,
        state: {
            ...in.state,
            expressions: {
                ...in.state.expressions,
                tags: result.tags,
                offsets: result.offsets
            },
            forms: {
                ...in.state.forms,
                conditional_condition:
                    in.state.forms.conditional_condition.push(in.condition)[0],
                conditional_yes: in.state.forms.conditional_yes.push(in.yes)[0],
                conditional_no: in.state.forms.conditional_no.push(in.no)[0],
                conditional_capture: in.state.forms.conditional_capture.push(null)[0],
                conditional_error_capture:
                    in.state.forms.conditional_error_capture.push(null)[0]
            }
        }
    }
}
