import { ExpressionsKind } from "../../printer/model/expressions"
import wrapper from "../expressions/wrapper"

import type { State, Node as Output } from "./model"

export type Input = {
    state: State,
    value: u32
}

export default function (in: Input): Output {
    const value = wrapper({
        table: in.state.expressions,
        base: in.state.source.expression_base,
        kind: ExpressionsKind.Dereference,
        value: in.value
    })

    return {
        id: value.id,
        state: {
            ...in.state,
            expressions: value.table,
            valid: in.state.valid && value.valid
        }
    }
}
