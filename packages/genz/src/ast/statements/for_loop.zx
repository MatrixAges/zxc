import { StatementsKind } from "../../printer/model/statements"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    iterable: u32,
    capture: u8[],
    start: u32,
    count: u32,
    index?: u8[],
    capture_reference?: bool
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: StatementsKind.ForLoop,
        offset: in.table.for_loop_iterable.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            valid: false
        }
    }

    return {
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            for_loop_iterable: in.table.for_loop_iterable.push(in.iterable)[0],
            for_loop_capture: in.table.for_loop_capture.push(in.capture)[0],
            for_loop_body_start: in.table.for_loop_body_start.push(in.start)[0],
            for_loop_body_len: in.table.for_loop_body_len.push(in.count)[0],
            for_loop_capture_reference:
                in.table.for_loop_capture_reference.push(in.capture_reference ?? false)[0],
            for_loop_index_capture:
                in.table.for_loop_index_capture.push(in.index)[0]
        }
    }
}
