import { StatementsKind } from "../../printer/model/statements"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    iterable: u32,
    capture: u8[],
    start: u32,
    count: u32,
    index: u8[]?
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: StatementsKind.ForLoop,
        offset: in.table.for_loop_iterable.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            for_loop_iterable: result.table.for_loop_iterable.push(in.iterable)[0],
            for_loop_capture: result.table.for_loop_capture.push(in.capture)[0],
            for_loop_body_start: result.table.for_loop_body_start.push(in.start)[0],
            for_loop_body_len: result.table.for_loop_body_len.push(in.count)[0],
            for_loop_capture_reference:
                result.table.for_loop_capture_reference.push(false)[0],
            for_loop_index_capture:
                result.table.for_loop_index_capture.push(in.index)[0]
        }
    }
}
