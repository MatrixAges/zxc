import integers from "std:integer"

import { StatementsKind } from "../../../printer/model/statements"
import header from "./header"

import type { State, Scope } from "./model"

export type Columns = {
    while_loop_condition: u32[],
    while_loop_body_start: u32[],
    while_loop_body_len: u32[],
    while_loop_capture: u8[]?[]
}

export type Input = {
    scope: Scope,
    columns: Columns,
    condition: u32,
    capture?: u8[]
}

export type Output = {
    state: State,
    columns: Columns
}

export default function (in: Input): Output {
    const child = in.scope.state
    const first = child.base + integers.narrow(child.tags.length)
    const count = integers.narrow(child.root_tags.length)

    const state = header({
        state: {
            ...child,
            tags: child.tags.concat(child.root_tags)[0],
            offsets: child.offsets.concat(child.root_offsets)[0],
            root_tags: in.scope.parent_tags,
            root_offsets: in.scope.parent_offsets
        },
        kind: StatementsKind.WhileLoop,
        offset: in.columns.while_loop_condition.length
    })

    return {
        state,
        columns: {
            while_loop_condition:
                in.columns.while_loop_condition.push(in.condition)[0],
            while_loop_body_start: in.columns.while_loop_body_start.push(first)[0],
            while_loop_body_len: in.columns.while_loop_body_len.push(count)[0],
            while_loop_capture: in.columns.while_loop_capture.push(in.capture)[0]
        }
    }
}
