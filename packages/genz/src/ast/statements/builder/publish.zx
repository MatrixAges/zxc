import empty from "../empty"

import type { Variables } from "../../context/model"
import type { Columns } from "../model"
import type { State as Input } from "./model"

export type Output = {
    statements: Columns,
    variables: Variables,
    valid: bool
}

export default function (in: Input): Output {
    return {
        statements: {
            ...empty({}),
            ...in.pick([
                "tags",
                "offsets",
                "assignment_target",
                "assignment_value",
                "branch_condition",
                "branch_yes_start",
                "branch_yes_len",
                "branch_no_start",
                "branch_no_len",
                "branch_capture",
                "branch_capture_reference",
                "branch_error_capture",
                "constant_name",
                "constant_type_expr",
                "constant_value",
                "constant_exported",
                "expression",
                "discard",
                "result"
            ])
        },
        variables: in.pick([
            "variable_name",
            "variable_type_expr",
            "variable_value",
            "variable_exported"
        ]),
        valid: in.valid && in.root_tags.length == 0
    }
}
