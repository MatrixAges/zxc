import { StatementsKind } from "../../printer/model/statements"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    target: u32,
    value: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: StatementsKind.Assignment,
        offset: in.table.assignment_target.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            valid: false
        }
    }

    return {
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            assignment_target: in.table.assignment_target.push(in.target)[0],
            assignment_value: in.table.assignment_value.push(in.value)[0]
        }
    }
}
