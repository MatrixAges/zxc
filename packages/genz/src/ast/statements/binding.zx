import { StatementsKind } from "../../printer/model/statements"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    name: u8[],
    value: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: StatementsKind.Constant,
        offset: in.table.constant_name.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            valid: false
        }
    }

    return {
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            constant_name: in.table.constant_name.push(in.name)[0],
            constant_type_expr: in.table.constant_type_expr.push(null)[0],
            constant_value: in.table.constant_value.push(in.value)[0],
            constant_exported: in.table.constant_exported.push(false)[0]
        }
    }
}
