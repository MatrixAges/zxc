import { StatementsKind } from "../../printer/model/statements"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    name: u8[],
    value: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: StatementsKind.Constant,
        offset: in.table.constant_name.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            constant_name: result.table.constant_name.push(in.name)[0],
            constant_type_expr: result.table.constant_type_expr.push(null)[0],
            constant_value: result.table.constant_value.push(in.value)[0],
            constant_exported: result.table.constant_exported.push(false)[0]
        }
    }
}
