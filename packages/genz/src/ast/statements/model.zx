import type { StatementsKind } from "../../printer/model/statements"

export type Columns = {
    tags: StatementsKind[],
    offsets: u32[],
    errdefer_expression: u32[],
    defer_expression: u32[],
    expression: u32[],
    result: u32?[],
    constant_name: u8[][],
    constant_type_expr: u32?[],
    constant_value: u32[],
    constant_exported: bool[],
    assignment_target: u32[],
    assignment_value: u32[],
    for_loop_iterable: u32[],
    for_loop_capture: u8[][],
    for_loop_body_start: u32[],
    for_loop_body_len: u32[],
    for_loop_capture_reference: bool[],
    for_loop_index_capture: u8[]?[],
    break_value_label: u8[][],
    break_value_value: u32[],
    branch_condition: u32[],
    branch_yes_start: u32[],
    branch_yes_len: u32[],
    branch_no_start: u32[],
    branch_no_len: u32[],
    branch_capture: u8[]?[],
    branch_capture_reference: bool[],
    branch_error_capture: u8[]?[]
}

export type Result = {
    table: Columns,
    valid: bool
}
