import { StatementsKind } from "../../printer/model/statements"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    label: u8[],
    value: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        ...in.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.base,
        kind: StatementsKind.BreakValue,
        offset: in.table.break_value_label.length
    })

    if (!result.valid) {
        return {
            table: in.table,
            valid: false
        }
    }

    return {
        valid: result.valid,
        table: {
            ...in.table,
            tags: result.tags,
            offsets: result.offsets,
            break_value_label: in.table.break_value_label.push(in.label)[0],
            break_value_value: in.table.break_value_value.push(in.value)[0]
        }
    }
}
