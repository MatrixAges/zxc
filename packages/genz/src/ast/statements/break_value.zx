import { StatementsKind } from "../../printer/model/statements"
import header from "./header"

import type { Columns, Result } from "./model"

export type Input = {
    table: Columns,
    base: u32,
    label: u8[],
    value: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = header({
        table: in.table,
        base: in.base,
        kind: StatementsKind.BreakValue,
        offset: in.table.break_value_label.length
    })

    if (!result.valid) {
        return result
    }

    return {
        ...result,
        table: {
            ...result.table,
            break_value_label: result.table.break_value_label.push(in.label)[0],
            break_value_value: result.table.break_value_value.push(in.value)[0]
        }
    }
}
