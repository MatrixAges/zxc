import integers from "std:integer"
import { max_u32 } from "core/const"

import type { StatementsKind } from "../../printer/model/statements"

export type Input = {
    tags: StatementsKind[],
    offsets: u32[],
    base: u32,
    kind: StatementsKind,
    offset: u64
}

export type Output = {
    tags: StatementsKind[],
    offsets: u32[],
    valid: bool
}

export default function (in: Input): Output {
    const id = integers.widen(in.base) + in.tags.length

    if (id >= integers.widen(max_u32)) {
        return {
            tags: in.tags,
            offsets: in.offsets,
            valid: false
        }
    }

    return {
        tags: in.tags.push(in.kind)[0],
        offsets: in.offsets.push(integers.narrow(in.offset))[0],
        valid: true
    }
}
