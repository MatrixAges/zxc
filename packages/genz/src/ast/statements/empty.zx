        assignment_target: [],
        assignment_value: [],
        for_loop_iterable: [],
        for_loop_capture: [],
        for_loop_body_start: [],
        for_loop_body_len: [],
        for_loop_capture_reference: [],
        for_loop_index_capture: [],
        break_value_label: [],
        break_value_value: [],
        branch_condition: [],
        branch_yes_start: [],
        branch_yes_len: [],
        branch_no_start: [],
        branch_no_len: [],
        branch_capture: [],
        branch_capture_reference: [],
        branch_error_capture: []
