import bytes from "std:bytes"

export type Input = {
    names: u8[][],
    name: u8[]
}

export type Output = bool

export default function (in: Input): Output {
    return loop(0, {
        while: index => index < in.names.length &&
            !bytes.equals(in.names[index], in.name),
        next: index => {
            index += 1
        },
        return: index => index < in.names.length
    })
}
