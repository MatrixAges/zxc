import integers from "std:integer"

import mark from "./mark"

import type { Input } from "./model"

export type Output = bool[]

export default function (in: Input): Output {
    const marked = loop({
        members: in.members,
        needed: in.functions.expressions.map(body => false)[0],
        index: 0
    }, {
        while: current => current.index < current.members.length,
        next: current => {
            current.needed[integers.widen(
                current.members[current.index]
            )] = true
            current.index += 1
        }
    })

    return loop({
        roots: in.roots,
        needed: marked.needed,
        index: 0
    }, {
        while: current => current.index < current.roots.length,
        next: current => {
            current.needed = mark({
                body: current.roots[current.index],
                needed: current.needed
            })
            current.index += 1
        },
        return: state => state.needed
    })
}
