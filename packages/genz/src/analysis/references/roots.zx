import integers from "std:integer"
import { map } from "std:utils"

import mark from "./mark"

import type { Input } from "./model"

export type Output = bool[]

export default function (in: Input): Output {
    const marked = loop({
        members: in.members,
        needed: map(in.functions.expressions, body => false),
        index: 0
    }, {
        while: current => current.index < current.members.length,
        next: current => {
            current.needed[integers.widen(
                current.members[current.index]
            )] = true
            current.index += 1
        }
    })

    const result = loop({
        roots: in.roots,
        needed: marked.needed,
        index: 0
    }, {
        while: current => current.index < current.roots.length,
        next: current => {
            current.needed = mark({
                body: current.roots[current.index],
                needed: current.needed
            })
            current.index += 1
        }
    })

    return result.needed
}
