import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Body } from "./model"

export type Input = {
    body: Body,
    needed: bool[]
}

export type Output = bool[]

export default function (in: Input): Output {
    return loop({
        body: in.body,
        needed: in.needed,
        table: 0
    }, {
        while: current => current.table <= current.body.contracts.expressions.length,
        next: current => {
            const expressions = current.table == 0 ? current.body.expressions :
                current.body.contracts.expressions[current.table - 1]

            current.needed = loop({
                expressions,
                needed: current.needed,
                index: 0
            }, {
                while: items => items.index < items.expressions.kinds.length,
                next: items => {
                    if (
                        items.expressions.kinds[items.index] == ExpressionKind.Call
                    ) {
                        const callee =
                            integers.widen(
                                items.expressions.payloads[items.index]
                            )
                            -> integers.widen(
                                items.expressions.call_functions[_]
                            )

                        items.needed[callee] = true
                    }

                    items.index += 1
                },
                return: state => state.needed
            })
            current.table += 1
        },
        return: state => state.needed
    })
}
