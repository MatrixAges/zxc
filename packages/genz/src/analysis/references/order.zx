export type Input = string[]

export type Output = string[]

export default function (in: Input): Output {
    const empty: string[] = []

    const result = loop({
        names: in.sort()[0],
        values: empty,
        index: 0
    }, {
        while: current => current.index < current.names.length,
        next: current => {
            if (
                current.index == 0 ||
                    current.names[current.index] != current.names[current.index - 1]
            ) {
                current.values =
                    current.values.push(current.names[current.index])[0]
            }

            current.index += 1
        }
    })

    return result.values
}
