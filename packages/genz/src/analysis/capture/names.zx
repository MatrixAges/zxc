import fresh from "../../ast/fresh"
import { error_prefix, capture_prefix } from "./const"

export type Input = {
    serial: u64
}

export type Output = {
    name: u8[],
    label: u8[],
    serial: u64
}

export default function (in: Input): Output {
    const name = fresh({
        serial: in.serial,
        prefix: error_prefix
    })

    const label = fresh({
        serial: name.serial,
        prefix: capture_prefix
    })

    return {
        name: name.name,
        label: label.name,
        serial: label.serial
    }
}
