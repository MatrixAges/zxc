import detached from "../types/detached"

import type { Table } from "core/type_table/model"
import type { Unit } from "../unit"

export type Input = { types: Table, units: Unit[], pure: bool[] }

export type Output = bool[]

export default function (in: Input): Output {
    return loop({ types: in.types, units: in.units, pure: in.pure, readers: in.pure.map(value => false), position: 0 }, {
        while: current => current.position < current.pure.length,
        next: current => {
            current.readers[current.position] = current.pure[current.position] && detached({ types: current.types, id: current.units[current.position].output_type })
            current.position += 1
        }
    }).readers
}
