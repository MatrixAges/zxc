import free from "./free"
import hash from "./hash"

import type { Nodes } from "./model"

export type Input = { nodes: Nodes, pool: u32[], capacity: u64 }

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    const zeros = loop({ slots: empty, capacity: in.capacity }, {
        while: current => current.slots.length < current.capacity,
        next: current => { current.slots = current.slots.push(0)[0] }
    }).slots

    const result = loop({ slots: zeros, nodes: in.nodes, pool: in.pool, index: 0 }, {
        while: current => current.index < current.nodes.instances.length,
        next: current => {
            const nodes = current.nodes
            const start = hash({ instance: nodes.instances[current.index], id: nodes.expressions[current.index], pool: current.pool, first: nodes.firsts[current.index], count: nodes.counts[current.index] }) % current.slots.length
            const slot = free({ slots: current.slots, slot: start })

            current.slots = current.slots.with(slot, current.index + 1)
            current.index += 1
        }
    })

    return result.slots
}
