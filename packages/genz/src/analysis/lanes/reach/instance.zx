import integers from "std:integer"

import owner from "./owner"

import type { Iteration, Unit } from "../../unit"
import type { Machine } from "./model"

export type Input = { machine: Machine, unit: u64, limit: u64, origins: u32[][], loops: Iteration[][] }

export type Output = Machine

export default function (in: Input): Output {
    const machine = in.machine
    const unit = machine.units[in.unit]
    const origin_first = machine.origins.owners.length
    const loops_first = machine.loops.expressions.length

    const origins = loop({ types: machine.types, input: unit.input_type, origins: in.origins, pool: machine.pool, firsts: machine.origins.firsts, counts: machine.origins.counts, owners: machine.origins.owners, position: 0 }, {
        while: current => current.position < current.origins.length,
        next: current => {
            const path = current.origins[current.position]
            const first = current.pool.length

            current.pool = current.pool.concat(path)[0]
            current.firsts = current.firsts.push(first)[0]
            current.counts = current.counts.push(path.length)[0]
            current.owners = current.owners.push(owner({ types: current.types, input: current.input, pool: current.pool, first: first, count: path.length }))[0]
            current.position += 1
        }
    })

    const loops = loop({ loops: in.loops, pool: origins.pool, origin_first: origin_first, origins_column: machine.loops.origins, expressions: machine.loops.expressions, firsts: machine.loops.firsts, counts: machine.loops.counts, position: 0 }, {
        while: current => current.position < current.loops.length,
        next: current => {
            const selected = current.loops[current.position]

            const added = loop({ selected: selected, origin: current.origin_first + current.position, pool: current.pool, origins_column: current.origins_column, expressions: current.expressions, firsts: current.firsts, counts: current.counts, index: 0 }, {
                while: items => items.index < items.selected.length,
                next: items => {
                    const item = items.selected[items.index]

                    items.origins_column = items.origins_column.push(items.origin)[0]
                    items.expressions = items.expressions.push(item.expression)[0]
                    items.firsts = items.firsts.push(items.pool.length)[0]
                    items.counts = items.counts.push(item.path.length)[0]
                    items.pool = items.pool.concat(item.path)[0]
                    items.index += 1
                }
            })

            current.origins_column = added.origins_column
            current.expressions = added.expressions
            current.firsts = added.firsts
            current.counts = added.counts
            current.pool = added.pool
            current.position += 1
        }
    })

    const instances = machine.instances

    return {
        ...machine,
        pool: loops.pool,
        origins: { firsts: origins.firsts, counts: origins.counts, owners: origins.owners },
        loops: { origins: loops.origins_column, expressions: loops.expressions, firsts: loops.firsts, counts: loops.counts },
        instances: {
            units: instances.units.push(in.unit)[0],
            limits: instances.limits.push(in.limit)[0],
            widths: instances.widths.push(in.origins.length)[0],
            origins: instances.origins.push(origin_first)[0],
            loops_first: instances.loops_first.push(loops_first)[0],
            loops_count: instances.loops_count.push(loops.expressions.length - loops_first)[0],
            currents: instances.currents.push(0)[0]
        }
    }
}
