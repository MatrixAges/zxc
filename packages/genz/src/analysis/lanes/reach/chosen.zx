import integers from "std:integer"

import same from "../trace/same"

import type { Loops } from "./model"

export type Input = { loops: Loops, pool: u32[], loops_first: u64, loops_count: u64, origin_first: u64, width: u64, id: u64, path_first: u64, path_count: u64 }

export type Output = { found: bool, mask: bool[] }

export default function (in: Input): Output {
    const empty: bool[] = []

    const mask = loop({ mask: empty, width: in.width }, {
        while: current => current.mask.length < current.width,
        next: current => { current.mask = current.mask.push(false)[0] }
    }).mask

    const result = loop({ loops: in.loops, pool: in.pool, origin_first: in.origin_first, id: in.id, path_first: in.path_first, path_count: in.path_count, mask: mask, found: false, position: in.loops_first, end: in.loops_first + in.loops_count }, {
        while: current => current.position < current.end,
        next: current => {
            const loops = current.loops
            const matched = integers.widen(loops.expressions[current.position]) == current.id && same({ left: current.pool, left_first: loops.firsts[current.position], left_count: loops.counts[current.position], right: current.pool, right_first: current.path_first, right_count: current.path_count })

            if (matched) {
                current.mask = current.mask.with(loops.origins[current.position] - current.origin_first, true)
                current.found = true
            }

            current.position += 1
        }
    })

    return { found: result.found, mask: result.mask }
}
