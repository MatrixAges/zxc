import nextRow from "./next_row"
import write from "./write"

import type { Machine } from "./model"

export type Input = { machine: Machine, index: u64 }

export type Output = { machine: Machine, changed: bool }

export default function (in: Input): Output {
    const machine = in.machine
    const width = machine.instances.widths[machine.nodes.instances[in.index]]
    const row = nextRow({ nodes: machine.nodes, bits: machine.bits, children: machine.children, index: in.index, width: width })
    const written = write({ bits: machine.bits, row: row, first: machine.nodes.rows[in.index] })

    return { machine: { ...machine, bits: written.bits }, changed: written.changed }
}
