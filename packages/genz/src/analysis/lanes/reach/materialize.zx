import prepend from "../trace/prepend"

import type { Request } from "./model"

export type Input = { pool: u32[], requests: Request[] }

export type Output = { pool: u32[], firsts: u64[], counts: u64[] }

export default function (in: Input): Output {
    const numbers: u64[] = []

    const result = loop({ pool: in.pool, requests: in.requests, firsts: numbers, counts: numbers, position: 0 }, {
        while: current => current.position < current.requests.length,
        next: current => {
            const request = current.requests[current.position]

            if (request.mode == 0) {
                current.firsts = current.firsts.push(request.first)[0]
                current.counts = current.counts.push(request.count)[0]
            } else if (request.mode == 1) {
                current.firsts = current.firsts.push(current.pool.length)[0]
                current.counts = current.counts.push(request.count + 1)[0]
                current.pool = prepend({ pool: current.pool, index: request.index, first: request.first, count: request.count })
            } else {
                current.firsts = current.firsts.push(current.pool.length)[0]
                current.counts = current.counts.push(request.path.length)[0]
                current.pool = current.pool.concat(request.path)[0]
            }

            current.position += 1
        }
    })

    return { pool: result.pool, firsts: result.firsts, counts: result.counts }
}
