import type { Origins } from "./model"

export type Input = { firsts: u64[], counts: u64[], origins: Origins, origin_first: u64, selected: bool[] }

export type Output = { firsts: u64[], counts: u64[] }

export default function (in: Input): Output {
    const result = loop({ firsts: in.firsts, counts: in.counts, origins: in.origins, origin_first: in.origin_first, selected: in.selected, position: 0 }, {
        while: current => current.position < current.selected.length,
        next: current => {
            if (current.selected[current.position]) {
                const origin = current.origin_first + current.position

                current.firsts = current.firsts.push(current.origins.firsts[origin])[0]
                current.counts = current.counts.push(current.origins.counts[origin])[0]
            }

            current.position += 1
        }
    })

    return { firsts: result.firsts, counts: result.counts }
}
