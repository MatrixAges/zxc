import type { Origins } from "./model"

export type Input = { origins: Origins, first: u64, mask: bool[], target: u32 }

export type Output = bool[]

export default function (in: Input): Output {
    const empty: bool[] = []

    const result = loop({ owners: in.origins.owners, first: in.first, base: in.mask, target: in.target, mask: empty, position: 0 }, {
        while: current => current.position < current.base.length,
        next: current => {
            current.mask = current.mask.push(current.owners[current.first + current.position] != current.target && current.base[current.position])[0]
            current.position += 1
        }
    })

    return result.mask
}
