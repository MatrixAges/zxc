import type { ReachFrame, ReachOp } from "./model"

export type Input = { op: ReachOp, instance: u64, id: u64, first: u64, count: u64 }

export type Output = ReachFrame

export default function (in: Input): Output {
    return { op: in.op, instance: in.instance, id: in.id, first: in.first, count: in.count, index: 0, parent: 0, total: 0, callee: 0, argument: 0 }
}
