import type { Dependencies, ReachFrame } from "./model"

export type Input = { frames: ReachFrame[], visit: ReachFrame, dependencies: Dependencies, entry: u64 }

export type Output = ReachFrame[]

export default function (in: Input): Output {
    const items = in.dependencies
    const first = items.inputs_first[in.entry]

    const result = loop({ frames: in.frames, visit: in.visit, firsts: items.input_firsts, counts: items.input_counts, first: first, remaining: items.inputs_count[in.entry] }, {
        while: current => current.remaining != 0,
        next: current => {
            current.remaining -= 1
            current.frames = current.frames.push({ ...current.visit, first: current.firsts[current.first + current.remaining], count: current.counts[current.first + current.remaining] })[0]
        }
    })

    return result.frames
}
