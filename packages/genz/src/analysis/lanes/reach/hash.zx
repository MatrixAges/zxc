import integers from "std:integer"

export type Input = { instance: u64, id: u64, pool: u32[], first: u64, count: u64 }

export type Output = u64

export default function (in: Input): Output {
    const start = ((in.instance * 1000003) % 2147483647 + in.id * 31) % 2147483647

    const result = loop({ pool: in.pool, position: in.first, end: in.first + in.count, value: start }, {
        while: current => current.position < current.end,
        next: current => {
            current.value = (current.value * 131 + integers.widen(current.pool[current.position]) + 7) % 2147483647
            current.position += 1
        }
    })

    return result.value
}
