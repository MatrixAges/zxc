import integers from "std:integer"

import descendant from "../../types/descendant"

import type { Table } from "core/type_table/model"
import type { Origins } from "./model"

export type Input = { types: Table, origins: Origins, first: u64, width: u64, selected: u32 }

export type Output = bool[]

export default function (in: Input): Output {
    const mask: bool[] = []

    const result = loop({ types: in.types, owners: in.origins.owners, first: in.first, width: in.width, selected: in.selected, mask: mask, position: 0 }, {
        while: current => current.position < current.width,
        next: current => {
            const owner = current.owners[current.first + current.position]
            const excluded = current.types.kinds[integers.widen(owner)] == 3 && current.selected != owner && !descendant({ types: current.types, parent: current.selected, root: owner })

            current.mask = current.mask.push(!excluded)[0]
            current.position += 1
        }
    })

    return result.mask
}
