import integers from "std:integer"

import type { Request } from "./model"

export type Input = { requests: Request[], items: u32[], first: u64, count: u64, path_first: u64, path_count: u64 }

export type Output = Request[]

export default function (in: Input): Output {
    const path: u32[] = []

    const result = loop({ items: in.items, path: path, path_first: in.path_first, path_count: in.path_count, position: in.first, end: in.first + in.count, requests: in.requests }, {
        while: current => current.position < current.end,
        next: current => {
            current.requests = current.requests.push({ id: integers.widen(current.items[current.position]), mode: 0, first: current.path_first, count: current.path_count, index: 0, path: current.path })[0]
            current.position += 1
        }
    })

    return result.requests
}
