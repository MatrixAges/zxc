import { ReachOp } from "./model"

import type { ReachFrame, Request } from "./model"

export type Input = { frames: ReachFrame[], frame: ReachFrame, requests: Request[], firsts: u64[], counts: u64[] }

export type Output = ReachFrame[]

export default function (in: Input): Output {
    const result = loop({ frames: in.frames, frame: in.frame, requests: in.requests, firsts: in.firsts, counts: in.counts, remaining: in.requests.length }, {
        while: current => current.remaining != 0,
        next: current => {
            current.remaining -= 1
            current.frames = current.frames.push({ ...current.frame, op: ReachOp.Visit, id: current.requests[current.remaining].id, first: current.firsts[current.remaining], count: current.counts[current.remaining] })[0]
        }
    })

    return result.frames
}
