import integers from "std:integer"
import { CollectionKind, ExpressionKind } from "core/expression_table/kinds"

import detached from "../../types/detached"
import same from "../trace/same"
import chosen from "./chosen"
import filter from "./filter"
import { NodeKind } from "./model"
import owned from "./owned"
import popped from "./popped"
import prefixed from "./prefixed"
import selected from "./selected"
import sequence from "./sequence"

import type { Machine, Plan, Request } from "./model"

export type Input = { machine: Machine, instance: u64, id: u64, first: u64, count: u64 }

export type Output = Plan

export default function (in: Input): Output {
    const machine = in.machine
    const instances = machine.instances
    const unit_index = instances.units[in.instance]
    const table = machine.units[unit_index].expressions
    const facts = machine.facts[unit_index]
    const types = machine.types
    const id = in.id
    const first = in.first
    const count = in.count
    const width = instances.widths[in.instance]
    const origin_first = instances.origins[in.instance]
    const requests: Request[] = []
    const flags: bool[] = []
    const path: u32[] = []
    const none: Plan = { kind: NodeKind.None, lanes: 0, mask: flags, owned: flags, base: flags, requests: requests, call: false, callee: 0, argument: 0 }
    const target = selected({ types: types, type_id: table.types[id], pool: machine.pool, first: first, count: count })

    if (!target.valid || detached({ types: types, id: target.id }) || types.kinds[integers.widen(target.id)] == 8) {
        return none
    }

    const mask = filter({ types: types, origins: machine.origins, first: origin_first, width: width, selected: target.id })
    const join = { ...none, kind: NodeKind.Join, mask: mask }
    const kind = table.kinds[id]
    const payload = integers.widen(table.payloads[id])
    const keep: Request = { id: 0, mode: 0, first: first, count: count, index: 0, path: path }
    const root: Request = { id: 0, mode: 0, first: 0, count: 0, index: 0, path: path }

    if (kind == ExpressionKind.Iteration) {
        const initial = { ...keep, id: integers.widen(table.iteration_initials[payload]) }
        const body = { ...keep, id: integers.widen(table.iteration_bodies[payload]) }
        const lanes = chosen({ loops: machine.loops, pool: machine.pool, loops_first: instances.loops_first[in.instance], loops_count: instances.loops_count[in.instance], origin_first: origin_first, width: width, id: id, path_first: first, path_count: count })

        if (lanes.found && lanes.mask.every(value => value)) {
            return { ...join, requests: [initial] }
        }

        return { ...join, kind: lanes.found ? NodeKind.Iteration : NodeKind.Join, owned: lanes.found ? lanes.mask : flags, requests: [initial, body] }
    }

    if (kind == ExpressionKind.ListUpdate) {
        return { ...join, requests: [{ ...root, id: integers.widen(table.update_targets[payload]) }, { ...root, id: integers.widen(table.update_values[payload]) }] }
    }

    if (kind == ExpressionKind.Scope) {
        return { ...join, requests: [{ ...keep, id: integers.widen(table.scope_results[payload]) }] }
    }

    if (kind == ExpressionKind.Reference) {
        const symbol = integers.widen(table.references[payload])

        if (symbol == 0) {
            return { ...none, kind: NodeKind.Base, base: prefixed({ origins: machine.origins, first: origin_first, mask: mask, pool: machine.pool, path_first: first, path_count: count }) }
        }

        const binding = facts.bindings[symbol]

        if (binding != 0) {
            return { ...join, requests: [{ ...keep, id: binding - 1 }] }
        }

        const iteration = facts.iterations[symbol]

        if (iteration != 0) {
            return { ...join, requests: [{ ...keep, id: iteration - 1 }] }
        }

        return { ...none, kind: NodeKind.All, mask: mask }
    }

    if (kind == ExpressionKind.Conditional) {
        return { ...join, requests: [{ ...keep, id: integers.widen(table.conditional_yes[payload]) }, { ...keep, id: integers.widen(table.conditional_no[payload]) }] }
    }

    if (kind == ExpressionKind.Match) {
        const fallback: Request[] = [{ ...keep, id: integers.widen(table.match_fallbacks[payload]) }]

        return { ...join, requests: sequence({ requests: fallback, items: table.match_results, first: integers.widen(table.match_first[payload]), count: integers.widen(table.match_count[payload]), path_first: first, path_count: count }) }
    }

    if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
        return { ...join, requests: [{ ...keep, id: integers.widen(table.projection_targets[payload]), mode: 1, index: table.projection_indices[payload] }] }
    }

    if (kind == ExpressionKind.Object) {
        const fields = loop({ table: table, pool: machine.pool, keep: keep, first: integers.widen(table.object_first[payload]), total: integers.widen(table.object_count[payload]), path_first: first, path_count: count, position: 0, requests: requests }, {
            while: current => current.position < current.total,
            next: current => {
                const field = current.first + current.position
                const value = integers.widen(current.table.object_field_values[field])

                if (current.path_count == 0) {
                    current.requests = current.requests.push({ ...current.keep, id: value })[0]
                } else if (current.table.object_field_indices[field] == current.pool[current.path_first]) {
                    current.requests = current.requests.push({ ...current.keep, id: value, first: current.path_first + 1, count: current.path_count - 1 })[0]
                }

                current.position += 1
            }
        }).requests

        return { ...join, requests: fields }
    }

    if (kind == ExpressionKind.Tuple) {
        const sequence_first = integers.widen(table.sequence_first[payload])

        if (count != 0) {
            return { ...join, requests: [{ ...keep, id: integers.widen(table.sequence_items[sequence_first + integers.widen(machine.pool[first])]), first: first + 1, count: count - 1 }] }
        }

        return { ...join, requests: sequence({ requests: requests, items: table.sequence_items, first: sequence_first, count: integers.widen(table.sequence_count[payload]), path_first: 0, path_count: 0 }) }
    }

    if (kind == ExpressionKind.List) {
        return { ...join, requests: sequence({ requests: requests, items: table.sequence_items, first: integers.widen(table.sequence_first[payload]), count: integers.widen(table.sequence_count[payload]), path_first: 0, path_count: 0 }) }
    }

    if (kind == ExpressionKind.Some || kind == ExpressionKind.OptionalValue) {
        const child = kind == ExpressionKind.Some ? table.some[payload] : table.optional_values[payload]

        return { ...join, requests: [{ ...keep, id: integers.widen(child) }] }
    }

    if (kind == ExpressionKind.Capture) {
        if (count != 0 && machine.pool[first] != 1) {
            return none
        }

        return { ...join, requests: [{ ...keep, id: integers.widen(table.captures[payload]), first: count == 0 ? first : first + 1, count: count == 0 ? 0 : count - 1 }] }
    }

    if (kind == ExpressionKind.Binary) {
        return { ...join, requests: [{ ...keep, id: integers.widen(table.binary_left[payload]) }, { ...keep, id: integers.widen(table.binary_right[payload]) }] }
    }

    if (kind == ExpressionKind.Index) {
        return { ...join, requests: [{ ...root, id: integers.widen(table.index_targets[payload]) }] }
    }

    if (kind == ExpressionKind.ListOperation) {
        const operand = integers.widen(table.collection_targets[payload])
        const targets: Request[] = [{ ...root, id: operand }]
        const all = sequence({ requests: targets, items: table.collection_arguments, first: integers.widen(table.collection_first[payload]), count: integers.widen(table.collection_count[payload]), path_first: 0, path_count: 0 })

        if (table.collection_kinds[payload] == CollectionKind.Pop && count != 0 && machine.pool[first] == 1) {
            return { ...join, mask: popped({ origins: machine.origins, first: origin_first, mask: mask, target: table.types[operand] }), requests: all }
        }

        return { ...join, requests: all }
    }

    if (kind == ExpressionKind.Call) {
        const callee = integers.widen(table.call_functions[payload])
        const argument = integers.widen(table.call_arguments[payload])
        const limit = instances.limits[in.instance]

        const matched = callee >= limit ? requests : loop({ lanes: machine.summaries[callee], pool: machine.pool, first: first, count: count, argument: argument, root: root, position: 0, requests: requests }, {
            while: current => current.position < current.lanes.length,
            next: current => {
                const lane = current.lanes[current.position]

                if (same({ left: lane.output, left_first: 0, left_count: lane.output.length, right: current.pool, right_first: current.first, right_count: current.count })) {
                    current.requests = current.requests.push({ ...current.root, id: current.argument, mode: 2, path: lane.input })[0]
                }

                current.position += 1
            }
        }).requests

        const ownership = matched.length != 0 && types.kinds[integers.widen(target.id)] == 3 ? owned({ origins: machine.origins, first: origin_first, width: width, selected: target.id }) : flags

        return { kind: NodeKind.Call, lanes: matched.length, mask: mask, owned: ownership, base: flags, requests: matched, call: true, callee: callee, argument: argument }
    }

    if (kind == ExpressionKind.Transform) {
        const initial = table.transform_initials[payload]
        const pair: Request[] = [{ ...root, id: integers.widen(table.transform_targets[payload]) }, { ...root, id: integers.widen(table.transform_bodies[payload]) }]

        return { ...join, requests: initial == null ? pair : pair.push({ ...root, id: integers.widen(initial) })[0] }
    }

    return none
}
