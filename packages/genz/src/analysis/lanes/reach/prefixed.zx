import type { Origins } from "./model"

export type Input = { origins: Origins, first: u64, mask: bool[], pool: u32[], path_first: u64, path_count: u64 }

export type Output = bool[]

export default function (in: Input): Output {
    const empty: bool[] = []

    const result = loop({ origins: in.origins, first: in.first, base: in.mask, pool: in.pool, path_first: in.path_first, path_count: in.path_count, mask: empty, position: 0 }, {
        while: current => current.position < current.base.length,
        next: current => {
            const origin = current.first + current.position
            const origin_first = current.origins.firsts[origin]
            const origin_count = current.origins.counts[origin]
            const shorter = origin_count < current.path_count ? origin_count : current.path_count

            const shared = loop({ pool: current.pool, left: origin_first, right: current.path_first, index: 0, end: shorter, equal: true }, {
                while: items => items.equal && items.index < items.end,
                next: items => {
                    items.equal = items.pool[items.left + items.index] == items.pool[items.right + items.index]
                    items.index += 1
                }
            }).equal

            current.mask = current.mask.push(shared && current.base[current.position])[0]
            current.position += 1
        }
    })

    return result.mask
}
