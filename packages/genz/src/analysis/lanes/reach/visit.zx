import bits from "./bits"
import connect from "./connect"
import grow from "./grow"
import lookup from "./lookup"
import materialize from "./materialize"
import { ReachOp } from "./model"
import plan from "./plan"
import schedule from "./schedule"
import zeros from "./zeros"

import type { Machine, ReachFrame } from "./model"

export type Input = { machine: Machine, frame: ReachFrame }

export type Output = Machine

export default function (in: Input): Output {
    const machine = in.machine
    const frame = in.frame
    const found = lookup({ slots: machine.slots, nodes: machine.nodes, pool: machine.pool, instance: frame.instance, id: frame.id, first: frame.first, count: frame.count })

    if (found.node != 0) {
        const index = found.node - 1
        const caller = machine.instances.currents[frame.instance]
        const nodes = machine.nodes.active[index] && caller != 0 ? connect({ nodes: machine.nodes, caller: caller - 1, low: index }) : machine.nodes

        return { ...machine, nodes: nodes, results: machine.results.push(index)[0] }
    }

    const equation = plan({ machine: machine, instance: frame.instance, id: frame.id, first: frame.first, count: frame.count })
    const grown = (machine.used + 1) * 2 > machine.slots.length ? grow({ nodes: machine.nodes, pool: machine.pool, capacity: machine.slots.length * 2 }) : machine.slots
    const slot = lookup({ slots: grown, nodes: machine.nodes, pool: machine.pool, instance: frame.instance, id: frame.id, first: frame.first, count: frame.count }).slot
    const index = machine.nodes.instances.length
    const width = machine.instances.widths[frame.instance]
    const nodes = machine.nodes
    const mask_first = machine.bits.length
    const masked = bits({ bits: machine.bits, values: equation.mask })
    const owned_first = masked.length
    const owned = bits({ bits: masked, values: equation.owned })
    const base_first = owned.length
    const based = bits({ bits: owned, values: equation.base })
    const row_first = based.length
    const rows = zeros({ bits: based, count: width })
    const parent = machine.instances.currents[frame.instance]

    const created = {
        instances: nodes.instances.push(frame.instance)[0],
        expressions: nodes.expressions.push(frame.id)[0],
        firsts: nodes.firsts.push(frame.first)[0],
        counts: nodes.counts.push(frame.count)[0],
        lows: nodes.lows.push(index)[0],
        active: nodes.active.push(true)[0],
        kinds: nodes.kinds.push(equation.kind)[0],
        lanes: nodes.lanes.push(equation.lanes)[0],
        masks: nodes.masks.push(equation.mask.length == 0 ? 0 : mask_first + 1)[0],
        owned: nodes.owned.push(equation.owned.length == 0 ? 0 : owned_first + 1)[0],
        bases: nodes.bases.push(equation.base.length == 0 ? 0 : base_first + 1)[0],
        children_first: nodes.children_first.push(0)[0],
        children_count: nodes.children_count.push(0)[0],
        rows: nodes.rows.push(row_first)[0]
    }

    const paths = materialize({ pool: machine.pool, requests: equation.requests })
    const finish = { ...frame, op: ReachOp.Finish, index: index, parent: parent, total: equation.requests.length }
    const dependencies = { ...frame, op: ReachOp.CallDependencies, callee: equation.callee, argument: equation.argument }
    const pending = equation.call ? machine.frames.concat([finish, dependencies])[0] : machine.frames.push(finish)[0]
    const frames = schedule({ frames: pending, frame: frame, requests: equation.requests, firsts: paths.firsts, counts: paths.counts })

    return {
        ...machine,
        nodes: created,
        slots: grown.with(slot, index + 1),
        used: machine.used + 1,
        bits: rows,
        pool: paths.pool,
        stack: machine.stack.push(index)[0],
        instances: { ...machine.instances, currents: machine.instances.currents.with(frame.instance, index + 1) },
        frames: frames
    }
}
