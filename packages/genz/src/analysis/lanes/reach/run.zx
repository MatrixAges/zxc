import collect from "./collect"
import dependencies from "./dependencies"
import finish from "./finish"
import { ReachOp } from "./model"
import visit from "./visit"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => current.frames.length != 0,
        next: current => {
            const frame = current.frames[current.frames.length - 1]
            const step = { machine: { ...current, frames: current.frames.pop()[0] }, frame: frame }

            const next = match frame.op {
                ReachOp.Visit => visit(step),
                ReachOp.Finish => finish(step),
                ReachOp.CallDependencies => dependencies(step),
                _ => collect(step),
            }

            current.instances = next.instances
            current.origins = next.origins
            current.loops = next.loops
            current.nodes = next.nodes
            current.slots = next.slots
            current.used = next.used
            current.bits = next.bits
            current.children = next.children
            current.pool = next.pool
            current.stack = next.stack
            current.dependencies = next.dependencies
            current.callee_instances = next.callee_instances
            current.frames = next.frames
            current.results = next.results
        }
    })
}
