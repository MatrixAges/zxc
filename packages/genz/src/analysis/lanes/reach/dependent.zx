import type { Nodes } from "./model"

export type Input = { nodes: Nodes, bits: bool[], results: u64[], start: u64, width: u64 }

export type Output = bool[]

export default function (in: Input): Output {
    const empty: bool[] = []

    const result = loop({ nodes: in.nodes, bits: in.bits, results: in.results, start: in.start, width: in.width, row: empty, bit: 0 }, {
        while: current => current.bit < current.width,
        next: current => {
            const value = loop({ nodes: current.nodes, bits: current.bits, results: current.results, position: current.start, bit: current.bit, value: false }, {
                while: items => !items.value && items.position < items.results.length,
                next: items => {
                    items.value = items.bits[items.nodes.rows[items.results[items.position]] + items.bit]
                    items.position += 1
                }
            }).value

            current.row = current.row.push(value)[0]
            current.bit += 1
        }
    })

    return result.row
}
