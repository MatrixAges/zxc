import dependent from "./dependent"
import record from "./record"

import type { Machine, ReachFrame } from "./model"

export type Input = { machine: Machine, frame: ReachFrame }

export type Output = Machine

export default function (in: Input): Output {
    const machine = in.machine
    const frame = in.frame
    const start = machine.results.length - frame.total
    const width = machine.instances.widths[frame.instance]
    const origin_first = machine.instances.origins[frame.instance]
    const selected = dependent({ nodes: machine.nodes, bits: machine.bits, results: machine.results, start: start, width: width })
    const items = machine.dependencies
    const inputs = record({ firsts: items.input_firsts, counts: items.input_counts, origins: machine.origins, origin_first: origin_first, selected: selected })

    const results = loop({ results: machine.results, length: start }, {
        while: current => current.results.length > current.length,
        next: current => { current.results = current.results.pop()[0] }
    }).results

    return {
        ...machine,
        results: results,
        dependencies: {
            instances: items.instances.push(frame.instance)[0],
            callees: items.callees.push(frame.callee)[0],
            firsts: items.firsts.push(frame.first)[0],
            counts: items.counts.push(frame.count)[0],
            inputs_first: items.inputs_first.push(items.input_firsts.length)[0],
            inputs_count: items.inputs_count.push(inputs.firsts.length - items.input_firsts.length)[0],
            input_firsts: inputs.firsts,
            input_counts: inputs.counts
        }
    }
}
