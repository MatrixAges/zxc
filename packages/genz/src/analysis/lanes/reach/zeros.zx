export type Input = { bits: bool[], count: u64 }

export type Output = bool[]

export default function (in: Input): Output {
    const result = loop({ bits: in.bits, remaining: in.count }, {
        while: current => current.remaining != 0,
        next: current => {
            current.bits = current.bits.push(false)[0]
            current.remaining -= 1
        }
    })

    return result.bits
}
