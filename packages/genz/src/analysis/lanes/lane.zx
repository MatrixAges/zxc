import integers from "std:integer"

import iterations from "./iterations"
import calls from "./trace/calls"
import query from "./trace/query"
import same from "./trace/same"
import slice from "./trace/slice"
import store from "./trace/store"

import type { Lane } from "../unit"
import type { Trace } from "./trace/model"

export type Input = { trace: Trace, output: u32[] }

export type Output = { trace: Trace, present: bool, lane: Lane }

export default function (in: Input): Output {
    const ids: u32[] = []
    const numbers: u64[] = []
    const first = in.trace.pool.length
    const cleared = { ...in.trace, pool: store({ pool: in.trace.pool, path: in.output }), appends: ids, pops: ids, updates: ids, loops: { expressions: ids, firsts: numbers, counts: numbers }, calls: { expressions: ids, lanes: numbers } }

    const traced = loop({ trace: cleared, first: first, count: in.output.length, position: 0, valid: true, found: false, input_first: 0, input_count: 0 }, {
        while: current => current.valid && current.position < current.trace.facts.results.length,
        next: current => {
            const queried = query({ trace: current.trace, id: integers.widen(current.trace.facts.results[current.position]), first: current.first, count: current.count })
            const origin = queried.origin

            current.trace = queried.trace

            if (!origin.present) {
                current.valid = false
            } else if (current.found && !same({ left: current.trace.pool, left_first: current.input_first, left_count: current.input_count, right: current.trace.pool, right_first: origin.first, right_count: origin.count })) {
                current.valid = false
            } else {
                current.input_first = origin.first
                current.input_count = origin.count
                current.found = true
            }

            current.position += 1
        }
    })

    const trace = traced.trace
    const lane: Lane = { input: slice({ pool: trace.pool, first: traced.input_first, count: traced.input_count }), output: in.output, appends: trace.appends, pops: trace.pops, updates: trace.updates, iterations: iterations({ loops: trace.loops, pool: trace.pool }), calls: calls(trace.calls), rejected: false }

    return { trace: trace, present: traced.valid && traced.found, lane: lane }
}
