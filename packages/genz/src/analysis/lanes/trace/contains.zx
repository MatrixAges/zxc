export type Input = { items: u32[], id: u32 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ items: in.items, id: in.id, position: 0, found: false }, {
        while: current => !current.found && current.position < current.items.length,
        next: current => {
            current.found = current.items[current.position] == current.id
            current.position += 1
        }
    })

    return result.found
}
