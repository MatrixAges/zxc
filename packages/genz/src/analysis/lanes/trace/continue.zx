import integers from "std:integer"

import looped from "./looped"
import { TraceOp } from "./model"
import same from "./same"

import type { Origin, Trace, TraceFrame } from "./model"

export type Input = { trace: Trace, frame: TraceFrame }

export type Output = Trace

export default function (in: Input): Output {
    const trace = in.trace
    const frame = in.frame
    const table = trace.unit.expressions
    const payload = integers.widen(table.payloads[frame.id])
    const top = trace.stack[trace.stack.length - 1]
    const absent: Origin = { present: false, first: 0, count: 0 }

    if (frame.op == TraceOp.IterationInitial) {
        if (!top.present) {
            return trace
        }

        return { ...trace, frames: trace.frames.concat([{ ...frame, op: TraceOp.IterationBody }, { ...frame, op: TraceOp.Evaluate, id: integers.widen(table.iteration_bodies[payload]) }])[0] }
    }

    if (frame.op == TraceOp.JoinFirst) {
        if (!top.present) {
            return trace
        }

        return { ...trace, frames: trace.frames.concat([{ ...frame, op: TraceOp.JoinSecond }, { ...frame, op: TraceOp.Evaluate, id: frame.other }])[0] }
    }

    if (frame.op == TraceOp.MatchArm) {
        if (!top.present || frame.index == integers.widen(table.match_count[payload])) {
            return trace
        }

        return { ...trace, frames: trace.frames.concat([{ ...frame, op: TraceOp.MatchCheck }, { ...frame, op: TraceOp.Evaluate, id: integers.widen(table.match_results[integers.widen(table.match_first[payload]) + frame.index]) }])[0] }
    }

    const right = top
    const left = trace.stack[trace.stack.length - 2]
    const agreed = right.present && same({ left: trace.pool, left_first: left.first, left_count: left.count, right: trace.pool, right_first: right.first, right_count: right.count })
    const without_right = trace.stack.pop()[0]

    if (!agreed) {
        return { ...trace, stack: without_right.pop()[0].push(absent)[0] }
    }

    if (frame.op == TraceOp.MatchCheck) {
        return { ...trace, stack: without_right, frames: trace.frames.push({ ...frame, op: TraceOp.MatchArm, index: frame.index + 1 })[0] }
    }

    if (frame.op == TraceOp.JoinSecond) {
        return { ...trace, stack: without_right }
    }

    const known = looped({ loops: trace.loops, pool: trace.pool, id: frame.id, first: frame.first, count: frame.count })
    const loops = known ? trace.loops : { expressions: trace.loops.expressions.push(integers.narrow(frame.id))[0], firsts: trace.loops.firsts.push(frame.first)[0], counts: trace.loops.counts.push(frame.count)[0] }

    return { ...trace, stack: without_right, loops: loops }
}
