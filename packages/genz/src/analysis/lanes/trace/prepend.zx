export type Input = { pool: u32[], index: u32, first: u64, count: u64 }

export type Output = u32[]

export default function (in: Input): Output {
    const started = in.pool.push(in.index)[0]

    const result = loop({ pool: started, first: in.first, position: 0, count: in.count }, {
        while: current => current.position < current.count,
        next: current => {
            current.pool = current.pool.push(current.pool[current.first + current.position])[0]
            current.position += 1
        }
    })

    return result.pool
}
