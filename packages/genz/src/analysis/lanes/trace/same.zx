export type Input = { left: u32[], left_first: u64, left_count: u64, right: u32[], right_first: u64, right_count: u64 }

export type Output = bool

export default function (in: Input): Output {
    if (in.left_count != in.right_count) {
        return false
    }

    const result = loop({ left: in.left, right: in.right, left_first: in.left_first, right_first: in.right_first, count: in.left_count, position: 0, equal: true }, {
        while: current => current.equal && current.position < current.count,
        next: current => {
            current.equal = current.left[current.left_first + current.position] == current.right[current.right_first + current.position]
            current.position += 1
        }
    })

    return result.equal
}
