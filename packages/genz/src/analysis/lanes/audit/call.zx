import integers from "std:integer"

import candidate from "./candidate"
import classify from "./classify"
import forwarded from "./forwarded"

import type { Audit } from "./context"

export type Input = { audit: Audit, id: u64 }

export type Output = Audit

export default function (in: Input): Output {
    const audit = in.audit
    const trace = audit.trace
    const table = trace.unit.expressions
    const payload = integers.widen(table.payloads[in.id])
    const callee = integers.widen(table.call_functions[payload])
    const stores = table.call_store_count[payload]

    if (callee < trace.limit && stores == 0 && callee < audit.readers.length && audit.readers[callee]) {
        return audit
    }

    const argument = integers.widen(table.call_arguments[payload])
    const classified = classify({ audit: audit, id: argument })
    const counted = classified.audit

    if (classified.count == 0) {
        return counted
    }

    if (callee >= trace.limit || stores != 0) {
        return { ...counted, code: 13 }
    }

    const buffered = forwarded({ calls: counted.lane.calls, id: in.id, lane: 0, any: true })

    if (!buffered) {
        return counted
    }

    if (classified.count != 1) {
        return { ...counted, code: 5 }
    }

    const selected = candidate({ trace: counted.trace, lanes: counted.trace.summaries[callee], argument: argument, input: counted.lane.input })

    if (selected.lane == counted.trace.summaries[callee].length) {
        return { ...counted, trace: selected.trace, code: 13 }
    }

    return { ...counted, trace: selected.trace, code: forwarded({ calls: counted.lane.calls, id: in.id, lane: selected.lane, any: false }) ? 0 : 14 }
}
