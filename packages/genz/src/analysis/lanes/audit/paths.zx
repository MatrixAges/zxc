export type Input = { pool: u32[], paths: u32[][] }

export type Output = { pool: u32[], firsts: u64[], counts: u64[] }

export default function (in: Input): Output {
    const numbers: u64[] = []

    const result = loop({ pool: in.pool, paths: in.paths, firsts: numbers, counts: numbers, position: 0 }, {
        while: current => current.position < current.paths.length,
        next: current => {
            const path = current.paths[current.position]

            current.firsts = current.firsts.push(current.pool.length)[0]
            current.counts = current.counts.push(path.length)[0]
            current.pool = current.pool.concat(path)[0]
            current.position += 1
        }
    })

    return { pool: result.pool, firsts: result.firsts, counts: result.counts }
}
