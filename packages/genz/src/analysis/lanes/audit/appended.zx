import integers from "std:integer"

import type { Expressions } from "core/expression_table/model"

export type Input = { table: Expressions, appends: u32[], target: u64 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ table: in.table, appends: in.appends, target: in.target, position: 0, found: false }, {
        while: current => !current.found && current.position < current.appends.length,
        next: current => {
            const projection = integers.widen(current.appends[current.position])

            current.found = integers.widen(current.table.projection_targets[integers.widen(current.table.payloads[projection])]) == current.target
            current.position += 1
        }
    })

    return result.found
}
