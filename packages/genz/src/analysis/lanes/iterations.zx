import slice from "./trace/slice"

import type { Iteration } from "../unit"
import type { Loops } from "./trace/model"

export type Input = { loops: Loops, pool: u32[] }

export type Output = Iteration[]

export default function (in: Input): Output {
    const items: Iteration[] = []

    const result = loop({ loops: in.loops, pool: in.pool, items: items, position: 0 }, {
        while: current => current.position < current.loops.expressions.length,
        next: current => {
            const loops = current.loops

            current.items = current.items.push({ expression: loops.expressions[current.position], path: slice({ pool: current.pool, first: loops.firsts[current.position], count: loops.counts[current.position] }) })[0]
            current.position += 1
        }
    })

    return result.items
}
