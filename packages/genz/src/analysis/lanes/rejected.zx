import type { Lane } from "../unit"

export type Input = { lanes: Lane[], codes: u8[] }

export type Output = Lane[]

export default function (in: Input): Output {
    const items: Lane[] = []

    const result = loop({ lanes: in.lanes, codes: in.codes, items: items, position: 0 }, {
        while: current => current.position < current.lanes.length,
        next: current => {
            current.items = current.items.push({ ...current.lanes[current.position], rejected: current.codes[current.position] != 0 })[0]
            current.position += 1
        }
    })

    return result.items
}
