import same from "./trace/same"

import type { Lane } from "../unit"

export type Input = Lane[]

export type Output = Lane[]

export default function (in: Input): Output {
    const found: Lane[] = []

    const result = loop({ lanes: in, position: 0, unique: found }, {
        while: current => current.position < current.lanes.length,
        next: current => {
            const candidate = current.lanes[current.position]

            const duplicated = loop({ lanes: current.lanes, input: candidate.input, skip: current.position, index: 0, found: false }, {
                while: items => !items.found && items.index < items.lanes.length,
                next: items => {
                    const other = items.lanes[items.index].input

                    items.found = items.index != items.skip && same({ left: other, left_first: 0, left_count: other.length, right: items.input, right_first: 0, right_count: items.input.length })
                    items.index += 1
                }
            }).found

            if (!duplicated) {
                current.unique = current.unique.push(candidate)[0]
            }

            current.position += 1
        }
    })

    return result.unique
}
