import type { Modules } from "core/native_module_table/model"
import type { Table } from "core/type_table/model"
import type { Functions } from "../model"

export type Origins = {
    ids: u32[],
    kinds: u8[],
    owners: string[],
    members: string[],
    names: string[]
}

export type Capabilities = {
    io: bool[],
    process: bool[]
}

export type Input = {
    types: Table,
    functions: Functions,
    files: string[],
    native_members: string[][],
    native_exports: string?[],
    modules: Modules,
    origins: Origins,
    known: bool,
    io: bool[],
    process: bool[]
}

export enum Status {
    Valid,
    InvalidOrigin,
    MissingOrigin
}

export type Output = {
    status: Status,
    types: string[],
    functions: string[]
}
