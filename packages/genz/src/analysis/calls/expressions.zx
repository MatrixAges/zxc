import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    allowed: bool[],
    expected: bool,
    self_function?: u64,
    limit: u64,
    tasks: bool
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        kinds: in.expressions.kinds,
        payloads: in.expressions.payloads,
        call_functions: in.expressions.call_functions,
        allowed: in.allowed,
        expected: in.expected,
        self_function: in.self_function,
        limit: in.limit,
        tasks: in.tasks,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.kinds.length,
        next: current => {
            const kind = current.kinds[current.index]

            const condition = (
                - current.tasks
                - and (
                    - kind == ExpressionKind.Task
                    - or kind == ExpressionKind.AwaitTask
                    - or kind == ExpressionKind.CancelTask
                    - or kind == ExpressionKind.Parallel
                )
            )

            if (condition) {
                current.valid = false
            } else if (kind == ExpressionKind.Call) {
                const target =
                    integers.widen(
                        current
                            .call_functions[integers.widen(
                                current.payloads[current.index]
                            )]
                    )

                current.valid =
                    (
                        - current.self_function != null
                        - and target == current.self_function
                        - or (
                            target < current.limit &&
                                current.allowed[target] == current.expected
                        )
                    )
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
