import integers from "std:integer"
import { CollectionKind, ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = { expressions: Expressions, id: u64 }

export type Output = bool

export default function (in: Input): Output {
    const table = in.expressions

    if (table.kinds[in.id] != ExpressionKind.ListOperation) {
        return false
    }

    const payload = integers.widen(table.payloads[in.id])

    if (table.collection_kinds[payload] != CollectionKind.Splice) {
        return false
    }

    const start = integers.widen(table.collection_arguments[integers.widen(table.collection_first[payload])])

    return table.kinds[start] == ExpressionKind.Integer && table.integers[integers.widen(table.payloads[start])] == 0
}
