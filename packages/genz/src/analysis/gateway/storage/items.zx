import item from "./item"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return loop({
        state: in,
        index: 0
    }, {
        while: current => current.index < in.source.modules.length,
        next: current => {
            current.state = item({
                state: current.state,
                index: current.index
            })
            current.index += 1
        },
        return: current => current.state
    })
}
