import bytes from "std:bytes"
import integers from "std:integer"
import { max_u32 } from "core/const"

import header from "../../../ast/expressions/header"
import { ExpressionsKind } from "../../../printer/model/expressions"
import { pending_name } from "../../store/lifecycle/const"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const structure = header({
        ...in.context.expressions.pick([
            "tags",
            "offsets"
        ]),
        base: in.source.bases.expression_base,
        kind: ExpressionsKind.StructType,
        offset: 0
    })

    const constants = in.constants.push({
        name: bytes.fromText(pending_name),
        value: structure.id,
        type_expr: null,
        exported: true
    })[0]

    return {
        context: {
            ...in.context,
            expressions: {
                ...in.context.expressions,
                tags: structure.tags,
                offsets: structure.offsets
            }
        },
        fields: {
            name: in.field_names,
            value: in.field_values,
            default_value: in.field_defaults,
            comptime_parameter: in.field_comptime
        },
        constants,
        extra: {
            optional_type: in.optional_type,
            struct_type_start: [in.source.bases.field_base],
            struct_type_len: [integers.narrow(in.field_names.length)]
        },
        valid: in.context.valid && structure.valid &&
            constants.length <= integers.widen(max_u32)
    }
}
