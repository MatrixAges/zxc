import context from "../../../ast/context/initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        source: in,
        context: context(in.bases),
        field_names: [],
        field_values: [],
        field_defaults: [],
        field_comptime: [],
        constants: [],
        optional_type: []
    }
}
