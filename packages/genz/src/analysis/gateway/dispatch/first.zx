import bytes from "std:bytes"

import type { First as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const path = in.routes[in.index].path

    return loop({
        index: 0,
        found: false
    }, {
        while: current => !current.found && current.index < in.index,
        next: current => {
            current.found = bytes.equals(
                path,
                in.routes[current.index].path
            )
            current.index += 1
        },
        return: current => !current.found
    })
}
