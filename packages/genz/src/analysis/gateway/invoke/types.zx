import bytes from "std:bytes"

import binary from "../../../ast/context/binary"
import emptyObject from "../../../ast/context/empty_object"
import field from "../../../ast/context/field"
import integer from "../../../ast/context/integer"
import primitive from "../../../ast/context/primitive"
import text from "../../../ast/context/text"
import {
    ExpressionsBinaryOperator as B,
    ExpressionsKind as K,
    ExpressionsPrimitive as P
} from "../../../printer/model/expressions"
import requestTypes from "../request_types"
import { input_type_name, output_type_name, out_of_memory_name } from "./const"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const input = field({
        state: in.context,
        target: in.symbols.module,
        name: bytes.fromText(input_type_name)
    })

    const output = field({
        state: input.state,
        target: in.symbols.module,
        name: bytes.fromText(output_type_name)
    })

    const unit = primitive({
        state: output.state,
        value: P.Void
    })

    const parameters = requestTypes(unit.state)
    const empty = emptyObject(parameters.state)

    const zero = integer({
        state: empty.state,
        value: 0
    })

    const error_value = text({
        state: zero.state,
        kind: K.ErrorValue,
        value: bytes.fromText(out_of_memory_name)
    })

    const oom = binary({
        state: error_value.state,
        operator: B.Equal,
        left: in.symbols.err,
        right: error_value.id
    })

    return {
        ...in,
        context: oom.state,
        types: {
            input: input.id,
            output: output.id,
            unit: unit.id,
            scope: parameters.types.scope,
            io: parameters.types.io,
            process: parameters.types.process,
            request: parameters.types.request
        },
        symbols: {
            ...in.symbols,
            empty: empty.id,
            zero: zero.id,
            oom: oom.id
        }
    }
}
