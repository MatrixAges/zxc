import bytes from "std:bytes"
import integers from "std:integer"

import object from "../../../../ast/context/object"
import standard from "../../../../ast/context/standard"
import text from "../../../../ast/context/text"
import append from "../../../../ast/fields/append"
import branch from "../../../../ast/statements/builder/branch"
import close from "../../../../ast/statements/builder/close"
import open from "../../../../ast/statements/builder/open"
import result from "../../../../ast/statements/builder/result"
import { ExpressionsKind as K } from "../../../../printer/model/expressions"
import caught from "../catch"
import {
    allocate_name,
    always_name,
    json_name,
    parse_name,
    bad_request_name,
    invalid_input_message
} from "../const"
import response from "../error_response"

import type { State as Input, State as Output } from "../model"

export default function (in: Input): Output {
    const allocate = text({
        state: in.context,
        kind: K.EnumLiteral,
        value: bytes.fromText(always_name)
    })

    const fields = append({
        table: in.fields,
        name: bytes.fromText(allocate_name),
        value: allocate.id,
        comptime_parameter: false
    })

    const options = object({
        state: allocate.state,
        first: in.source.bases.field_base + integers.narrow(in.fields.name.length),
        count: 1
    })

    const parsed = standard({
        state: options.state,
        path: [
            json_name,
            parse_name
        ],
        arguments: [
            in.types.input,
            in.symbols.allocator,
            in.symbols.body,
            options.id
        ],
        fallible: false
    })

    const outer = open(in.statements)
    const scope = open(outer.state)

    const propagate = result({
        state: scope.state,
        value: in.symbols.err
    })

    const checked = branch({
        scope: {
            ...scope,
            state: propagate
        },
        condition: in.symbols.oom
    })

    const sent = response({
        state: {
            ...in,
            context: parsed.state,
            fields
        },
        status: bad_request_name,
        message: invalid_input_message
    })

    const body = close(result({
        state: checked,
        value: sent.id
    }))

    const capture = caught({
        state: {
            ...sent.state,
            statements: {
                ...body.state,
                root_tags: outer.parent_tags,
                root_offsets: outer.parent_offsets
            }
        },
        value: parsed.id,
        first: body.first,
        count: body.count
    })

    return {
        ...capture.state,
        parsed_input: capture.id
    }
}
