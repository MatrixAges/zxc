import publish from "../../../ast/statements/builder/publish"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const body = publish(in.statements)

    return {
        context: in.context,
        statements: {
            ...body.statements,
            ...body.variables,
            ...in.fors,
            ...in.scopes,
            ...in.breaks,
            defer_scope_start: [],
            defer_scope_len: [],
            discard_error: [],
            while_loop_condition: [],
            while_loop_body_start: [],
            while_loop_body_len: [],
            while_loop_capture: []
        },
        fields: in.fields,
        declarations: in.declarations,
        extra: in.extra,
        root: in.root,
        valid: in.valid && in.context.valid && body.valid
    }
}
