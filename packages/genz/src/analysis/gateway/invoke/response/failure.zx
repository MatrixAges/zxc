import bytes from "std:bytes"

import text from "../../../../ast/context/text"
import close from "../../../../ast/statements/builder/close"
import open from "../../../../ast/statements/builder/open"
import result from "../../../../ast/statements/builder/result"
import { ExpressionsKind as K } from "../../../../printer/model/expressions"
import { non_finite_name, internal_error_name, service_failure_message } from "../const"
import response from "../error_response"
import log from "../log_failure"

import type { State as Input, State as Output } from "../model"

export default function (in: Input): Output {
    const scope = open(in.statements)

    const name = text({
        state: in.context,
        kind: K.String,
        value: bytes.fromText(non_finite_name)
    })

    const logged = log({
        state: {
            ...in,
            context: name.state,
            statements: scope.state
        },
        value: name.id
    })

    const sent = response({
        state: logged,
        status: internal_error_name,
        message: service_failure_message
    })

    const body = close(result({
        state: sent.state.statements,
        value: sent.id
    }))

    return {
        ...sent.state,
        statements: {
            ...body.state,
            root_tags: scope.parent_tags,
            root_offsets: scope.parent_offsets
        },
        failure_first: body.first,
        failure_count: body.count
    }
}
