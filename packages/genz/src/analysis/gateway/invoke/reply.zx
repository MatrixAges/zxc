import reply from "../response"

import type { Reply as Input, Node as Output } from "./model"

export default function (in: Input): Output {
    const response = reply({
        state: in.state.context,
        respond: in.state.symbols.respond,
        request: in.state.symbols.request,
        status: in.status,
        body: in.body,
        headers: in.headers
    })

    return {
        id: response.id,
        state: {
            ...in.state,
            context: response.state
        }
    }
}
