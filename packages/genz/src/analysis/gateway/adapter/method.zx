import bytes from "std:bytes"
import integers from "std:integer"

import functionDeclaration from "../../../ast/declarations/function"
import append from "../../../ast/declarations/table/function"
import appendField from "../../../ast/fields/append"

import type { State } from "./model"

export type Input = {
    state: State,
    name: string,
    names: string[],
    types: u32[],
    result: u32,
    first: u32,
    count: u32,
    exported: bool
}

export type Output = State

export default function (in: Input): Output {
    const first =
        in.state.source.bases.field_base + integers.narrow(in.state.fields.name.length)

    const fields = loop({
        fields: in.state.fields,
        index: 0
    }, {
        while: current => current.index < in.names.length,
        next: current => {
            current.fields = appendField({
                table: current.fields,
                name: bytes.fromText(in.names[current.index]),
                value: in.types[current.index],
                comptime_parameter: false
            })
            current.index += 1
        },
        return: current => current.fields
    })

    const declaration = functionDeclaration({
        base:
            in.state.source.declaration_base +
            integers.narrow(in.state.declarations.tags.length),
        name: bytes.fromText(in.name),
        parameters_start: first,
        parameters_count: integers.narrow(in.names.length),
        return_type: in.result,
        body_start: in.first,
        body_count: in.count,
        exported: in.exported,
        abi_export: false,
        inlined: false
    })

    const appended = append({
        state: in.state.declarations,
        value: declaration.table,
        parameter_base: 0
    })

    return {
        ...in.state,
        fields,
        declarations: appended.state,
        valid: in.state.valid && declaration.valid && appended.valid
    }
}
