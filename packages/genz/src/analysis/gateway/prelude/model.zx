import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Constant } from "../../../ast/declarations/model"
import type { Columns as Forms } from "../../../ast/expressions/forms/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"

export type Input = {
    bases: Bases,
    declaration_base: u32,
    service_modules: string[],
    listen: string,
    max_header_bytes: u32,
    max_body_bytes: u32
}

export type State = {
    source: Input,
    context: Context,
    declarations: Constant[]
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    declarations: Constant[],
    valid: bool
}
