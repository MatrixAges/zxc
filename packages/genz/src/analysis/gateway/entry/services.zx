import service from "./service.rx"

import type { Services as Input, Output } from "./model"

export default function (in: Input): Output {
    return loop({
        state: in.state,
        index: 0
    }, {
        while: current => current.state.valid && current.index < in.services.length,
        next: current => {
            current.state = service({
                state: current.state,
                bases: in.bases,
                service: in.services[current.index],
                index: current.index
            })
            current.index += 1
        },
        return: current => current.state
    })
}
