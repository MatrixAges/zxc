import evaluation from "./evaluation"

import type { Expressions } from "core/expression_table/model"
import type { Validation } from "../model"

export type Input = {
    expressions: Expressions,
    iteration?: Validation
}

export type Output = bool

export default function (in: Input): Output {
    const iteration = in.iteration

    if (iteration == null) {
        return true
    }

    return evaluation({
        expressions: in.expressions,
        subject: iteration.initial
    }) && evaluation({
        expressions: in.expressions,
        subject: iteration.next
    })
}
