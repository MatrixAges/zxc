import integers from "std:integer"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    subject: u32
}

export type Output = bool

export default function (in: Input): Output {
    const expressions = in.expressions
    const payload = integers.widen(expressions.payloads[integers.widen(in.subject)])
    const count = integers.widen(expressions.object_evaluation_count[payload])

    if (count != integers.widen(expressions.object_count[payload])) {
        return false
    }

    return loop({
        expressions,
        first: integers.widen(expressions.object_evaluation_first[payload]),
        field_first: integers.widen(expressions.object_first[payload]),
        count,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const evaluated = current.expressions
                .object_evaluation_values[
                    current.first + current.index
                ]

            const prior = loop({
                expressions: current.expressions,
                first: current.first,
                end: current.index,
                evaluated,
                index: 0,
                duplicate: false
            }, {
                while: items => !items.duplicate && items.index < items.end,
                next: items => {
                    items.duplicate = items.expressions
                        .object_evaluation_values[
                            items.first + items.index
                        ] == items.evaluated
                    items.index += 1
                }
            })

            const fields = loop({
                expressions: current.expressions,
                first: current.field_first,
                count: current.count,
                evaluated,
                index: 0,
                matched: false
            }, {
                while: items => !items.matched && items.index < items.count,
                next: items => {
                    items.matched = items.expressions
                        .object_field_values[
                            items.first + items.index
                        ] == items.evaluated
                    items.index += 1
                }
            })

            current.valid = !prior.duplicate && fields.matched
            current.index += 1
        }
    })
        -> _.valid
}
