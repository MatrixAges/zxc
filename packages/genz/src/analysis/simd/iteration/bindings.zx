import passive from "../expression/passive"
import supported from "../expression/supported"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        expressions: in.expressions,
        candidate: in.candidate,
        index: 0,
        valid: true
    }, {
        while: current => current.valid &&
            current.index < current.candidate.context.count,
        next: current => {
            const context = {
                ...current.candidate.context,
                count: current.index
            }


            const request = current.expressions
                .scope_values[
                    context.first + current.index
                ]
                -> {
                    expressions: current.expressions,
                    context,
                    subject: _
                }

            current.valid = supported({
                ...request,
                scalar: current.candidate.scalar
            }) || passive(request)
            current.index += 1
        },
        return: state => state.valid
    })
}
