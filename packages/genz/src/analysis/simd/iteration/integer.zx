import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    subject: u32,
    expected: u64
}

export type Output = bool

export default function (in: Input): Output {
    const subject = integers.widen(in.subject)
    const expressions = in.expressions

    return expressions.kinds[subject] == ExpressionKind.Integer &&
        expressions.integers[integers.widen(expressions.payloads[subject])] == in.expected
}
