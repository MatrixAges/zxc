import type { Expressions } from "core/expression_table/model"
import type { State as Cache } from "core/integer/map/model"
import type { Table } from "core/type_table/model"

export enum Phase { Initial, AfterSimd, Fallback }

export enum Gate { None, Simd, Policy, Fallback }

export enum Branch { None, Scalar, Eligible }

export enum Action { None, Simd, Scalar, Eligible, Consume }

export type Input = {
    types: Table,
    table: Expressions,
    cache: Cache,
    symbol: u64,
    value: u32,
    result: u64,
    transaction: bool,
    capture: bool,
    phase: Phase
}

export type Output = Action
