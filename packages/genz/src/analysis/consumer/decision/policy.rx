<Module>
    <Type from="model" as="Consumer" />
    <Type from="../../iteration/result/model" as="Result" />

    <Args in={Consumer.Input} out={Consumer.Output} />

    <Call fn="branch" in={$in} />

    <Switch on={$ctx.branch}>
        <Case value={Consumer.Branch.None}>
            <Return value={Consumer.Action.None} />
        </Case>

        <Case value={Consumer.Branch.Scalar}>
            <Call
                fn="../projection"
                in={$in.pick([
                    "table",
                    "symbol",
                    "result"
                ])}
            />

            <If on={$ctx.projection}>
                <Return value={Consumer.Action.Scalar} />
            </If>

            <Return value={Consumer.Action.None} />
        </Case>

        <Case value={Consumer.Branch.Eligible}>
            <Call
                module="../../iteration/result/analyze"
                in={{
                    ...$in.pick([
                        "types",
                        "table",
                        "symbol",
                        "result",
                        "capture"
                    ]),
                    cached: $in.cache,
                    mode: Result.Mode.Eligible
                }}
            />

            <If on={$ctx.analyze.valid}>
                <Return value={Consumer.Action.Eligible} />
            </If>

            <Call module="fallback" in={$in} />

            <Return value={$ctx.fallback} />
        </Case>
    </Switch>
</Module>
