import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import independent from "./independent"

import type { Expressions } from "core/expression_table/model"

export type Input = { table: Expressions, result: u64, symbol: u64 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ table: in.table, symbol: in.symbol, id: in.result, done: false, valid: false }, {
        while: current => !current.done,
        next: current => {
            const table = current.table
            const kind = table.kinds[current.id]
            const payload = integers.widen(table.payloads[current.id])

            if (kind == ExpressionKind.Reference) {
                current.valid = integers.widen(table.references[payload]) == current.symbol
                current.done = true
            } else if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
                current.id = integers.widen(table.projection_targets[payload])
            } else if (kind == ExpressionKind.Length) {
                current.id = integers.widen(table.lengths[payload])
            } else if (kind == ExpressionKind.Index && independent({ table: table, id: integers.widen(table.index_values[payload]), symbol: current.symbol })) {
                current.id = integers.widen(table.index_targets[payload])
            } else {
                current.done = true
            }
        }
    })

    return result.valid
}
