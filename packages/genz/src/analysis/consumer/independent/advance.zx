import integers from "std:integer"

import child from "../child"

import type { Step as Input, Walk as Output } from "./model"

export default function (in: Input): Output {
    return loop({
        ...in.state,
        done: true
    }, {
        while: state => state.done && state.depth != 0,
        next: state => {
            const frame = state.depth - 1
            const nested = child({
                table: in.source.table,
                id: state.parents[frame],
                index: state.next[frame]
            })

            if (nested == null) {
                state.depth -= 1
            } else {
                state.next[frame] += 1
                state.id = integers.widen(nested)
                state.done = false
            }
        }
    })
}
