import type { Expressions } from "core/expression_table/model"

export type Input = {
    table: Expressions,
    id: u64,
    symbol: u64
}

export type Walk = {
    id: u64,
    parents: u64[],
    next: u64[],
    depth: u64,
    valid: bool,
    done: bool
}

export type Step = {
    source: Input,
    state: Walk
}
