import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = { table: Expressions, id: u64, symbol: u64 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ table: in.table, symbol: in.symbol, id: in.id, done: false, valid: false }, {
        while: current => !current.done,
        next: current => {
            const kind = current.table.kinds[current.id]
            const payload = integers.widen(current.table.payloads[current.id])

            if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
                current.id = integers.widen(current.table.projection_targets[payload])
            } else {
                current.valid = kind == ExpressionKind.Reference && integers.widen(current.table.references[payload]) == current.symbol
                current.done = true
            }
        }
    })

    return result.valid
}
