
import initialize from "../iteration/result/initialize"
import { Mode } from "../iteration/result/model"
import policy from "../iteration/result/policy"
import traverse from "../iteration/result/walk/traverse"

import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"
import type { Input as Analysis } from "../iteration/result/model"

export type Input = {
    types: Table,
    table: Expressions,
    symbol: u64,
    result: u64
}

export type Output = bool

export default function (in: Input): Output {
    const source: Analysis = {
        ...in,
        cached: null,
        capture: false,
        mode: Mode.Candidate
    }

    const decision = policy(source)

    if (!decision.traverse) {
        return decision.valid
    }

    const state = initialize(source)

    const result = traverse({
        source,
        state
    })

    return result.valid
}
