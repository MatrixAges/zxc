import step from "./independent/step"

import type { Input, Walk } from "./independent/model"

export type { Input } from "./independent/model"

export type Output = bool

export default function (in: Input): Output {
    const state: Walk = {
        id: in.id,
        parents: [],
        next: [],
        depth: 0,
        valid: true,
        done: false
    }

    return loop(state, {
        while: current => current.valid && !current.done,
        next: current => { current = step({
            source: in,
            state: current
        }) },
        return: current => current.valid
    })
}
