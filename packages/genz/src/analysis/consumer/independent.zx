import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import children from "../ir/children"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    table: Expressions,
    id: u64,
    symbol: u64
}

export type Output = bool

export default function (in: Input): Output {
    const stack: u64[] = [in.id]

    return loop({
        table: in.table,
        symbol: in.symbol,
        stack,
        valid: true
    }, {
        while: current => current.valid && current.stack.length != 0,
        next: current => {
            const id = current.stack[current.stack.length - 1]
            const table = current.table
            const kind = table.kinds[id]
            const payload = integers.widen(table.payloads[id])

            current.stack = current.stack.pop()[0]

            if (kind == ExpressionKind.Reference) {
                current.valid =
                    integers.widen(table.references[payload]) != current.symbol
            } else {
                const condition = (
                    - kind == ExpressionKind.Integer
                    - or kind == ExpressionKind.NegativeInteger
                    - or kind == ExpressionKind.Float
                    - or kind == ExpressionKind.String
                    - or kind == ExpressionKind.Boolean
                    - or kind == ExpressionKind.None
                    - or kind == ExpressionKind.Unit
                    - or kind == ExpressionKind.EnumValue
                    - or kind == ExpressionKind.ErrorValue
                )

                if (condition) {
                    current.valid = true
                } else {
                    const condition_2 = (
                        - kind == ExpressionKind.Some
                        - or kind == ExpressionKind.OptionalValue
                        - or kind == ExpressionKind.Length
                        - or kind == ExpressionKind.Field
                        - or kind == ExpressionKind.TupleField
                        - or kind == ExpressionKind.Index
                        - or kind == ExpressionKind.Unary
                        - or kind == ExpressionKind.Binary
                        - or kind == ExpressionKind.Conditional
                        - or kind == ExpressionKind.Call
                        - or kind == ExpressionKind.Object
                        - or kind == ExpressionKind.List
                        - or kind == ExpressionKind.Tuple
                        - or kind == ExpressionKind.Template
                    )

                    if (condition_2) {
                        current.stack = current.stack.concat(children({
                            table,
                            id
                        }).map(child => integers.widen(child))[0])[0]
                    } else {
                        current.valid = false
                    }
                }
            }
        },
        return: state => state.valid
    })
}
