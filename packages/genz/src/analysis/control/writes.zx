import integers from "std:integer"
import { StatementKind } from "core/control_table/model"

import type { Control } from "core/control_table/model"

export type Input = {
    control: Control,
    first: u64,
    count: u64
}

export type Output = bool

export default function writes(in: Input): Output {
    const control = in.control

    return loop({
        index: 0,
        found: false
    }, {
        while: state => !state.found && state.index < in.count,
        next: state => {
            const index = in.first + state.index
            const kind = control.statement_kinds[index]
            const payload = integers.widen(control.statement_payloads[index])

            if (kind == StatementKind.StoreSet) {
                state.found = true
            } else if (kind == StatementKind.Branch) {
                const yes = integers.widen(control.branch_yes[payload])
                const no = integers.widen(control.branch_no[payload])

                state.found = writes({
                    control,
                    first: integers.widen(control.block_first[yes]),
                    count: integers.widen(control.block_count[yes])
                }) || writes({
                    control,
                    first: integers.widen(control.block_first[no]),
                    count: integers.widen(control.block_count[no])
                })
            } else if (kind == StatementKind.Switch) {
                const first = integers.widen(control.selection_first[payload])
                const count = integers.widen(control.selection_count[payload])

                state.found = loop({
                    index: 0,
                    found: false
                }, {
                    while: cases => !cases.found && cases.index < count,
                    next: cases => {
                        const child = integers.widen(
                            control.case_bodies[first + cases.index]
                        )

                        cases.found = writes({
                            control,
                            first: integers.widen(control.block_first[child]),
                            count: integers.widen(
                                control.block_count[child]
                            )
                        })

                        cases.index += 1
                    },
                    return: cases => cases.found
                })
            }

            state.index += 1
        },
        return: state => state.found
    })
}
