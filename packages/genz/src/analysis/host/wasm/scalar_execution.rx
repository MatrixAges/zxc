<Module>
    <Type from="model" as="Wasm" />

    <Args in={Wasm.State} out={Wasm.State} />

    <Call fn="scalar_begin" in={$in} />
    <Call fn="scalar_prepare" in={$ctx.scalar_begin} />
    <Call fn="scalar_application" in={$ctx.scalar_prepare} />
    <Call fn="scalar_finish" in={$ctx.scalar_application} />

    <Return value={$ctx.scalar_finish} />
</Module>
