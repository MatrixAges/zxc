import emptyDeclarations from "../../../ast/snapshot/empty_declarations"
import emptyStatements from "../../../ast/snapshot/empty_statements"
import statements from "../../../ast/statements/builder/publish"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const body = statements(in.tree.ast.statements)

    const valid = (
        - in.tree.ast.valid
        - and in.tree.ast.context.valid
        - and body.valid
    )

    return {
        module: {
            context: in.tree.ast.context,
            extra: in.tree.extra,
            expression_forms: {
                ...in.expressions,
                optional_type: in.tree.ast.optional_type
            },
            statements: {
                ...emptyStatements({}),
                ...body.statements,
                ...body.variables,
                ...in.loops,
                ...in.scopes,
                ...in.breaks,
                ...in.tree.extra.pick([
                    "defer_expression",
                    "defer_scope_start",
                    "defer_scope_len"
                ])
            },
            declarations: {
                ...emptyDeclarations({}),
                ...in.tree.ast.declarations,
                ...in.declarations
            },
            fields: in.tree.ast.fields,
            arms: in.arms,
            first: in.first
        },
        valid
    }
}
