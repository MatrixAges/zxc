import bytes from "std:bytes"

import call from "../../../ast/context/call"
import path from "../../../ast/context/path"
import primitive from "../../../ast/context/primitive"
import text from "../../../ast/context/text"
import binding from "../../../ast/statements/builder/binding"
import result from "../../../ast/statements/builder/result"
import {
    ExpressionsPrimitive as P,
    ExpressionsKind as K
} from "../../../printer/model/expressions"
import method from "../node/task/method"
import {
    application_name,
    value_name,
    scalar_call,
    scalar_execute,
    scalar_type,
    c_convention,
    input_type,
    input_value
} from "./const"
import scalarInput from "./scalar_input"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const input_value_node = scalarInput({
        state: {
            ...in,
            tree: {
                ...in.tree,
                ast: {
                    ...in.tree.ast,
                },
                extra: in.tree.extra
            }
        },
    })

    const input_type_node = path({
        state: input_value_node.state.tree.ast.context,
        path: [
            application_name,
            input_type
        ]
    })

    const input_bound = binding({
        state: input_value_node.state.tree.ast.statements,
        name: bytes.fromText(input_value),
        value: input_value_node.id,
        mutable: false,
        type_expr: input_type_node.id
    })

    const scalar_execute_fn = path({
        state: input_type_node.state,
        path: [scalar_execute]
    })

    const input_variable = path({
        state: scalar_execute_fn.state,
        path: [input_value]
    })

    const execute = call({
        state: input_variable.state,
        callee: scalar_execute_fn.id,
        arguments: [input_variable.id],
        fallible: false
    })

    const returned = result({
        state: input_bound,
        value: execute.id
    })

    const scalar_type_fn = path({
        state: execute.state,
        path: [scalar_type]
    })

    const parameter_type = call({
        state: scalar_type_fn.state,
        callee: scalar_type_fn.id,
        arguments: [input_type_node.id],
        fallible: false
    })

    const return_type = primitive({
        state: parameter_type.state,
        value: P.U32
    })

    const convention = text({
        state: return_type.state,
        kind: K.EnumLiteral,
        value: bytes.fromText(c_convention)
    })

    const declared = method({
        state: {
            ...input_value_node.state.tree,
            ast: {
                ...input_value_node.state.tree.ast,
                context: convention.state,
                statements: returned
            },
            extra: input_value_node.state.tree.extra
        },
        name: scalar_call,
        parameters: [{
            name: value_name,
            value: parameter_type.id
        }],
        return_type: return_type.id,
        exported: false,
        abi_export: false,
        convention: convention.id
    })

    return {
        ...input_value_node.state,
        tree: declared
    }
}
