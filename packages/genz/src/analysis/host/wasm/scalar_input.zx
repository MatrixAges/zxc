import bytes from "std:bytes"
import integers from "std:integer"

import binary from "../../../ast/context/binary"
import builtin from "../../../ast/context/builtin"
import conditional from "../../../ast/context/conditional"
import integer from "../../../ast/context/integer"
import path from "../../../ast/context/path"
import text from "../../../ast/context/text"
import unreachableValue from "../../../ast/context/unreachable"
import {
    ExpressionsBinaryOperator as B,
    ExpressionsBuiltinName as Builtin,
    ExpressionsKind as K
} from "../../../printer/model/expressions"
import invoke from "../node/task/invoke"
import {
    std_name,
    application_name,
    value_name,
    scalar_invalid,
    int_tag,
    float_tag,
    bool_tag,
    input_type,
    math_name,
    cast_name
} from "./const"
import returnValue from "./return_value"
import selection from "./selection"

import type { State, Node as Output } from "./model"

export type Input = {
    state: State
}

export default function (in: Input): Output {
    const input_type_node = path({
        state: in.state.tree.ast.context,
        path: [
            application_name,
            input_type
        ]
    })

    const parameter = path({
        state: input_type_node.state,
        path: [value_name]
    })

    const invalid = invoke({
        state: {
            ...in.state.tree,
            ast: {
                ...in.state.tree.ast,
                context: parameter.state
            },
            extra: in.state.tree.extra
        },
        path: [scalar_invalid],
        arguments: [],
        fallible: false
    })

    const invalid_return = returnValue({
        state: {
            ...in.state,
            tree: {
                ...in.state.tree,
                ast: {
                    ...in.state.tree.ast,
                    context: invalid.state.ast.context
                },
                extra: in.state.tree.extra
            }
        },
        value: invalid.id
    })

    const one = integer({
        state: invalid_return.state.tree.ast.context,
        value: 1
    })

    const fits = binary({
        state: one.state,
        operator: B.LessEqual,
        left: parameter.id,
        right: one.id
    })

    const equal = binary({
        state: fits.state,
        operator: B.Equal,
        left: parameter.id,
        right: one.id
    })

    const boolean_input = conditional({
        state: equal.state,
        condition: fits.id,
        yes: equal.id,
        no: invalid_return.id
    })

    const cast = invoke({
        state: {
            ...invalid_return.state.tree,
            ast: {
                ...invalid_return.state.tree.ast,
                context: boolean_input.state
            },
            extra: invalid_return.state.tree.extra
        },
        path: [
            std_name,
            math_name,
            cast_name
        ],
        arguments: [
            input_type_node.id,
            parameter.id
        ],
        fallible: false
    })

    const integer_input = binary({
        state: cast.state.ast.context,
        operator: B.Coalesce,
        left: cast.id,
        right: invalid_return.id
    })

    const never = unreachableValue(integer_input.state)

    const input_value_node_first =
        integers.narrow(invalid_return.state.arms.value.length)

    const input_value_node_label_0 = text({
        state: never.state,
        kind: K.EnumLiteral,
        value: bytes.fromText(bool_tag)
    })

    const input_value_node_arm_0 = {
        value: invalid_return.state.arms.value.push(input_value_node_label_0.id)[0],
        capture: invalid_return.state.arms.capture.push(null)[0],
        result: invalid_return.state.arms.result.push(boolean_input.id)[0]
    }

    const input_value_node_label_1 = text({
        state: input_value_node_label_0.state,
        kind: K.EnumLiteral,
        value: bytes.fromText(int_tag)
    })

    const input_value_node_arm_1 = {
        value: input_value_node_arm_0.value.push(input_value_node_label_1.id)[0],
        capture: input_value_node_arm_0.capture.push(null)[0],
        result: input_value_node_arm_0.result.push(integer_input.id)[0]
    }

    const input_value_node_label_2 = text({
        state: input_value_node_label_1.state,
        kind: K.EnumLiteral,
        value: bytes.fromText(float_tag)
    })

    const input_value_node_arm_2 = {
        value: input_value_node_arm_1.value.push(input_value_node_label_2.id)[0],
        capture: input_value_node_arm_1.capture.push(null)[0],
        result: input_value_node_arm_1.result.push(parameter.id)[0]
    }

    const input_value_node_arm_3 = {
        value: input_value_node_arm_2.value.push(null)[0],
        capture: input_value_node_arm_2.capture.push(null)[0],
        result: input_value_node_arm_2.result.push(never.id)[0]
    }

    const input_value_node_info = builtin({
        state: input_value_node_label_2.state,
        name: Builtin.TypeInfo,
        arguments: [input_type_node.id]
    })

    const input_value_node = selection({
        state: {
            ...invalid_return.state,
            tree: {
                ...invalid_return.state.tree,
                ast: {
                    ...invalid_return.state.tree.ast,
                    context: input_value_node_info.state
                },
                extra: invalid_return.state.tree.extra
            },
            arms: input_value_node_arm_3
        },
        subject: input_value_node_info.id,
        first: input_value_node_first,
        count: 4
    })

    return {
        id: input_value_node.id,
        state: {
            ...input_value_node.state,
            tree: {
                ...input_value_node.state.tree,
                ast: {
                    ...input_value_node.state.tree.ast,
                },
                extra: input_value_node.state.tree.extra
            }
        }
    }
}
