import bytes from "std:bytes"
import integers from "std:integer"

import builtin from "../../../ast/context/builtin"
import object from "../../../ast/context/object"
import text from "../../../ast/context/text"
import field from "../../../ast/fields/append"
import evaluate from "../../../ast/statements/builder/evaluate"
import {
    ExpressionsBuiltinName as Builtin,
    ExpressionsKind as K
} from "../../../printer/model/expressions"
import { export_name } from "./const"

import type { State, State as Output } from "./model"

export type Input = {
    state: State,
    target: u32,
    name: string
}

export default function (in: Input): Output {
    const name_value = text({
        state: in.state.tree.ast.context,
        kind: K.String,
        value: bytes.fromText(in.name)
    })

    const attributes_first = integers.narrow(in.state.tree.ast.fields.name.length)

    const attributes_field_0 = field({
        table: in.state.tree.ast.fields,
        name: bytes.fromText(export_name),
        value: name_value.id,
        comptime_parameter: false
    })

    const attributes = object({
        state: name_value.state,
        type_expr: null,
        first: attributes_first,
        count: 1
    })

    const exported_value = builtin({
        state: attributes.state,
        name: Builtin.Export,
        arguments: [
            in.target,
            attributes.id
        ]
    })

    const exported = evaluate({
        state: in.state.tree.ast.statements,
        value: exported_value.id,
        discard: false
    })

    return {
        ...in.state,
        tree: {
            ...in.state.tree,
            ast: {
                ...in.state.tree.ast,
                context: exported_value.state,
                statements: exported,
                fields: attributes_field_0
            },
            extra: in.state.tree.extra
        }
    }
}
