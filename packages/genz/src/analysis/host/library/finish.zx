import bytes from "std:bytes"
import integers from "std:integer"

import builtin from "../../../ast/context/builtin"
import path from "../../../ast/context/path"
import pointer from "../../../ast/context/pointer"
import primitive from "../../../ast/context/primitive"
import defineFunction from "../../../ast/declarations/function"
import constant from "../../../ast/declarations/table/constant"
import declaration from "../../../ast/declarations/table/function"
import append from "../../../ast/fields/append"
import close from "../../../ast/statements/builder/close"
import {
    ExpressionsBuiltinName,
    ExpressionsPrimitive
} from "../../../printer/model/expressions"
import { std_name, build_name, builder_name, build_type } from "./const"
import literal from "./literal"
import { Status } from "./model"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    if (in.status != Status.Ready) {
        return in
    }

    const text = literal({
        ast: in.ast,
        value: std_name
    })

    const standard = builtin({
        state: text.ast.context,
        name: ExpressionsBuiltinName.Import,
        arguments: [text.id]
    })

    const imported = constant({
        state: in.declarations,
        value: {
            name: bytes.fromText(std_name),
            type_expr: null,
            value: standard.id,
            exported: false
        }
    })

    const builder = path({
        state: standard.state,
        path: [
            std_name,
            build_type
        ]
    })

    const parameter = pointer({
        state: builder.state,
        value: builder.id
    })

    const result = primitive({
        state: parameter.state,
        value: ExpressionsPrimitive.Void
    })

    const fields = append({
        table: in.ast.fields,
        name: bytes.fromText(builder_name),
        value: parameter.id,
        default_value: null,
        comptime_parameter: false
    })

    const body = close(in.ast.body)

    const definition = defineFunction({
        base: 0,
        name: bytes.fromText(build_name),
        parameters_start: integers.narrow(in.ast.fields.name.length),
        parameters_count: 1,
        return_type: result.id,
        body_start: body.first,
        body_count: body.count,
        exported: true,
        abi_export: false,
        inlined: false,
        calling_convention: null
    })

    const declared = declaration({
        state: imported.state,
        value: definition.table,
        parameter_base: 0
    })

    const valid = (
        - in.valid
        - and imported.valid
        - and definition.valid
        - and declared.valid
    )

    return {
        ...in,
        ast: {
            ...in.ast,
            body: body.state,
            context: result.state,
            fields
        },
        declarations: declared.state,
        valid
    }
}
