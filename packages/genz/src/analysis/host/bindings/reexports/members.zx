import bytes from "std:bytes"

import constant from "../../../../ast/declarations/builder/constant"
import declarations from "../../../../ast/declarations/builder/publish"
import field from "../../../../ast/expressions/builder/field"
import expressions from "../../../../ast/expressions/builder/publish"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const ast = loop({
        ...in.pick([
            "expressions",
            "declarations"
        ]),
        index: 0
    }, {
        while: current => current.index < in.names.length,
        next: current => {
            const name = bytes.fromText(in.names[current.index])
            const value = field({
                state: current.expressions,
                target: in.binding,
                name
            })

            current.expressions = value.state
            current.declarations = constant({
                state: current.declarations,
                name,
                value: value.id,
                type_expr: null,
                exported: true
            })
            current.index += 1
        },
        return: current => current
    })

    return {
        expressions: expressions(ast.expressions),
        declarations: declarations(ast.declarations),
        valid: ast.expressions.valid && ast.declarations.valid
    }
}
