import bytes from "std:bytes"
import integers from "std:integer"

import slice from "../../../../ast/context/const_slice"
import header from "../../../../ast/expressions/header"
import append from "../../../../ast/fields/append"
import { ExpressionsKind as K } from "../../../../printer/model/expressions"
import constant from "../constant"
import { specifier_name, path_name, source_field, module_name } from "./const"
import { namespace_name, implementation_path_name } from "./const"
import { source_name, namespace_index } from "./const"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const field_names = [
        specifier_name,
        path_name,
        source_field,
        module_name,
        namespace_name,
        implementation_path_name
    ]

    const ast = loop({
        ast: in.ast,
        index: 0
    }, {
        while: current => current.index < field_names.length,
        next: current => {
            const field_type = match {
                current.index == namespace_index => slice({
                    state: current.ast.context,
                    value: in.string_type
                }),
                _ => {
                    state: current.ast.context,
                    id: in.string_type
                }
            }

            current.ast.context = field_type.state
            current.ast.fields = append({
                table: current.ast.fields,
                name: bytes.fromText(field_names[current.index]),
                value: field_type.id,
                default_value: null,
                comptime_parameter: false
            })
            current.index += 1
        },
        return: current => current.ast
    })

    const result = header({
        ...ast.context.expressions.pick([
            "tags",
            "offsets"
        ]),
        base: 0,
        kind: K.StructType,
        offset: ast.forms.struct_type_start.length
    })

    const declared = constant({
        state: {
            ...ast,
            context: {
                ...ast.context,
                expressions: {
                    ...ast.context.expressions,
                    ...result.pick([
                        "tags",
                        "offsets"
                    ])
                }
            },
            forms: {
                struct_type_start: [0],
                struct_type_len: [integers.narrow(field_names.length)]
            },
            valid: ast.valid && result.valid
        },
        name: source_name,
        value: result.id,
        type_expr: null
    })

    return {
        ...in,
        ast: declared
    }
}
