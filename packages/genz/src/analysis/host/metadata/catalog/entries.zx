import entry from "./entry"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return loop({
        state: in,
        index: 0
    }, {
        while: current => current.index < in.source.length,
        next: current => {
            current.state = entry({
                state: current.state,
                value: in.source[current.index]
            })
            current.index += 1
        },
        return: current => current.state
    })
}
