import bytes from "std:bytes"

import conditional from "../../../../ast/context/conditional"
import path from "../../../../ast/context/path"
import binding from "../../../../ast/statements/builder/binding"
import { application_name, requires_process_name, output_name } from "../const"
import io from "./io"

import type { State as Input, State as Output } from "../model"

export default function (in: Input): Output {
    const condition = path({
        state: in.context,
        path: [
            application_name,
            requires_process_name
        ]
    })

    const yes = io({
        state: condition.state,
        stateful: in.stateful,
        process: true
    })

    const no = io({
        state: yes.state,
        stateful: in.stateful,
        process: false
    })

    const value = conditional({
        state: no.state,
        condition: condition.id,
        yes: yes.id,
        no: no.id
    })

    return {
        ...in,
        context: value.state,
        statements: binding({
            state: in.statements,
            name: bytes.fromText(output_name),
            value: value.id,
            mutable: false
        })
    }
}
