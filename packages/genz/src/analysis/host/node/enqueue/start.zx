import { task_capture } from "../context/const"
import { start_name } from "../task/const"
import evaluate from "../task/evaluate"
import invoke from "../task/invoke"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        ...in,
        tree: evaluate(invoke({
            state: in.tree,
            path: [
                task_capture,
                start_name
            ],
            arguments: [],
            fallible: true
        }))
    }
}
