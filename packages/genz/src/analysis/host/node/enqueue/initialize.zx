import initialize from "../task/initialize"

import type { Args as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        tree: initialize(in),
        loops: {
            for_loop_iterable: [],
            for_loop_capture: [],
            for_loop_body_start: [],
            for_loop_body_len: [],
            for_loop_capture_reference: [],
            for_loop_index_capture: []
        },
        cleanup: []
    }
}
