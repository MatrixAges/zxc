<Module>
    <Type from="model" as="Task" />

    <Args in={Task.Input} out={Task.Output} />

    <Call fn="initialize" in={$in} />
    <Call fn="prelude" in={$ctx.initialize} />
    <Call fn="fields" in={$ctx.prelude} />
    <Call fn="destroy" in={$ctx.fields} />
    <Call fn="start" in={$ctx.destroy} />
    <Call fn="execute" in={$ctx.start} />

    <Task name="completion" out={$ctx.build}>
        <Call module="complete/build" in={$ctx.execute} />
    </Task>

    <Call module="settle/build" in={$ctx.task.completion} />

    <Call fn="publish" in={$ctx.build} />

    <Return value={$ctx.publish} />
</Module>
