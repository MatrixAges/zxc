import initialize from "../context/initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        ast: initialize(in),
        extra: {
            error_union_payload: [],
            error_union_errors: [],
            error_union_inferred: [],
            catch_scope_value: [],
            catch_scope_capture: [],
            catch_scope_body_start: [],
            catch_scope_body_len: [],
            defer_expression: [],
            defer_scope_start: [],
            defer_scope_len: []
        }
    }
}
