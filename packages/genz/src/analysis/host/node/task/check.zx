import { api_name } from "../context/const"
import { napi_name, check_name } from "./const"
import evaluate from "./evaluate"
import invoke from "./invoke"

import type { State, State as Output } from "./model"

export type Input = {
    state: State,
    name: string,
    arguments: u32[]
}

export default function (in: Input): Output {
    const result = invoke({
        state: in.state,
        path: [
            api_name,
            in.name
        ],
        arguments: in.arguments,
        fallible: false
    })

    return evaluate(invoke({
        state: result.state,
        path: [
            napi_name,
            check_name
        ],
        arguments: [result.id],
        fallible: true
    }))
}
