import publish from "../context/publish"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const result = publish(in.ast)

    return {
        ...result,
        expressions: {
            ...result.expressions,
            ...in.extra.omit([
                "defer_expression",
                "defer_scope_start",
                "defer_scope_len"
            ])
        },
        statements: {
            ...result.statements,
            ...in.extra.pick([
                "defer_expression",
                "defer_scope_start",
                "defer_scope_len"
            ])
        }
    }
}
