import bytes from "std:bytes"
import integers from "std:integer"

import primitive from "../../../../ast/context/primitive"
import defineFunction from "../../../../ast/declarations/function"
import declaredFunction from "../../../../ast/declarations/table/function"
import field from "../../../../ast/fields/append"
import close from "../../../../ast/statements/builder/close"
import { ExpressionsPrimitive as P } from "../../../../printer/model/expressions"

import type { Method as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const state = in.state

    const fields = field({
        table: state.fields,
        name: bytes.fromText(in.parameter_name),
        value: in.parameter_type,
        comptime_parameter: false
    })

    const result = primitive({
        state: state.context,
        value: P.Void
    })

    const body = close(state.statements)

    const definition = defineFunction({
        base: integers.narrow(state.declarations.tags.length),
        name: bytes.fromText(in.name),
        parameters_start: integers.narrow(state.fields.name.length),
        parameters_count: 1,
        return_type: result.id,
        body_start: body.first,
        body_count: body.count,
        exported: true,
        abi_export: false,
        inlined: false,
        calling_convention: in.convention
    })

    const declared = declaredFunction({
        state: state.declarations,
        value: definition.table,
        parameter_base: 0
    })

    const valid = (
        - state.valid
        - and definition.valid
        - and declared.valid
    )

    return {
        ...state,
        context: result.state,
        declarations: declared.state,
        fields,
        statements: body.state,
        valid
    }
}
