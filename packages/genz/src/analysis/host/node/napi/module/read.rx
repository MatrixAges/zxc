<Module>
    <Type from="model" as="Root" />
    <Type from="../codec/model" as="Codec" />

    <Args in={Root.Member} out={Codec.State} />

    <If on={$in.reading}>
        <Call
            fn="../codec/select"
            in={{
                state: $in.state.codec,
                id: $in.id,
                reading: true
            }}
        />

        <Call module="../codec/extend" in={$ctx.select} />

        <Return value={$ctx.extend} />

        <Else><Return value={$in.state.codec} /></Else>
    </If>
</Module>
