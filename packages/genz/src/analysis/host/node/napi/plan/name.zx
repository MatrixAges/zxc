import bytes from "std:bytes"
import integers from "std:integer"

import integer from "../../../../../printer/text/integer"
import { type_prefix } from "./const"

export type Input = u32

export type Output = u8[]

export default function (in: Input): Output {
    return integer({
        output: bytes.fromText(type_prefix),
        value: integers.widen(in)
    })
}
