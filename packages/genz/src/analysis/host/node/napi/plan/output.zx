import path from "../../../../../ast/context/path"
import { application_name, output_type } from "../../task/const"
import walk from "./walk"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const source = path({
        state: in.context,
        path: [
            application_name,
            output_type
        ]
    })

    return walk({
        state: {
            ...in,
            context: source.state
        },
        id: in.source.output,
        source: source.id,
        incoming: false
    })
}
