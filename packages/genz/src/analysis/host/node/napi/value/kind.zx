import bytes from "std:bytes"

import address from "../../../../../ast/context/address"
import path from "../../../../../ast/context/path"
import undefinedValue from "../../../../../ast/context/undefined"
import binding from "../../../../../ast/statements/builder/binding"
import result from "../../../../../ast/statements/builder/result"
import { api_name, env_name, env_type } from "../../context/const"
import { typeof_name, kind_type } from "../../enqueue/const"
import { result_name, value_type, value_name } from "../../task/const"
import errorUnion from "../../task/error_union"
import method from "../../task/method"
import check from "./check_call"
import { kind_name } from "./const"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const kind_type_node = path({
        state: in.tree.ast.context,
        path: [
            api_name,
            kind_type
        ]
    })

    const missing = undefinedValue(kind_type_node.state)

    const declared = binding({
        state: in.tree.ast.statements,
        name: bytes.fromText(result_name),
        value: missing.id,
        mutable: true,
        type_expr: kind_type_node.id
    })

    const env = path({
        state: missing.state,
        path: [env_name]
    })

    const value = path({
        state: env.state,
        path: [value_name]
    })

    const result_value = path({
        state: value.state,
        path: [result_name]
    })

    const pointer = address({
        state: result_value.state,
        value: result_value.id
    })

    const checked = check({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: pointer.state,
                statements: declared
            }
        },
        name: typeof_name,
        arguments: [
            env.id,
            value.id,
            pointer.id
        ]
    })

    const returned = result({
        state: checked.ast.statements,
        value: result_value.id
    })

    const env_type_node = path({
        state: checked.ast.context,
        path: [
            api_name,
            env_type
        ]
    })

    const value_type_node = path({
        state: env_type_node.state,
        path: [
            api_name,
            value_type
        ]
    })

    const return_type = errorUnion({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: value_type_node.state,
                statements: returned
            },
            extra: checked.extra
        },
        payload: kind_type_node.id,
        inferred: false
    })

    const tree = method({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: return_type.state.ast.context,
                statements: returned
            },
            extra: return_type.state.extra
        },
        name: kind_name,
        parameters: [
            {
                name: env_name,
                value: env_type_node.id
            },
            {
                name: value_name,
                value: value_type_node.id
            }
        ],
        return_type: return_type.id,
        exported: false,
        abi_export: false
    })

    return {
        ...in,
        tree
    }
}
