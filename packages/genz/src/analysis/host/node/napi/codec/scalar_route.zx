import {
    scalar_void,
    scalar_bool,
    scalar_string,
    scalar_i64,
    scalar_u64,
    scalar_f32,
    scalar_f64
} from "core/type_table/const"

import { ScalarRoute } from "./model"

export type Input = u32

export type Output = ScalarRoute

export default function (in: Input): Output {
    return match in {
        scalar_void => ScalarRoute.Void,
        scalar_bool => ScalarRoute.Boolean,
        scalar_string => ScalarRoute.String,
        scalar_i64 => ScalarRoute.BigInteger,
        scalar_u64 => ScalarRoute.BigInteger,
        scalar_f32 => ScalarRoute.Float,
        scalar_f64 => ScalarRoute.Float,
        _ => ScalarRoute.Integer
    }
}
