import bytes from "std:bytes"
import integers from "std:integer"

import address from "../../../../../ast/context/address"
import builtin from "../../../../../ast/context/builtin"
import integer from "../../../../../ast/context/integer"
import object from "../../../../../ast/context/object"
import path from "../../../../../ast/context/path"
import text from "../../../../../ast/context/text"
import field from "../../../../../ast/fields/append"
import binding from "../../../../../ast/statements/builder/binding"
import {
    ExpressionsKind as K,
    ExpressionsBuiltinName as B
} from "../../../../../printer/model/expressions"
import { api_name, env_name } from "../../context/const"
import { result_name, value_name } from "../../task/const"
import check from "../value/check_call"
import {
    property_type,
    property_name,
    utf8_name,
    item_name,
    set_element,
    define_properties
} from "./const"

import type { State, State as Output } from "../../task/model"

export type Input = {
    state: State,
    tuple: bool,
    position: u64,
    key: u8[]
}

export default function (in: Input): Output {
    const env = path({
        state: in.state.ast.context,
        path: [env_name]
    })

    const result = path({
        state: env.state,
        path: [result_name]
    })

    const item = path({
        state: result.state,
        path: [item_name]
    })

    if (in.tuple) {
        const index = integer({
            state: item.state,
            value: in.position
        })

        return check({
            state: {
                ...in.state,
                ast: {
                    ...in.state.ast,
                    context: index.state
                }
            },
            name: set_element,
            arguments: [
                env.id,
                result.id,
                index.id,
                item.id
            ]
        })
    }

    const target = path({
        state: item.state,
        path: [
            api_name,
            property_type
        ]
    })

    const key = text({
        state: target.state,
        kind: K.String,
        value: in.key
    })

    const named = field({
        table: in.state.ast.fields,
        name: bytes.fromText(utf8_name),
        value: key.id,
        comptime_parameter: false
    })

    const valued = field({
        table: named,
        name: bytes.fromText(value_name),
        value: item.id,
        comptime_parameter: false
    })

    const property = object({
        state: key.state,
        type_expr: null,
        first:
            in.state.ast.context.source.field_base +
            integers.narrow(in.state.ast.fields.name.length),
        count: 2
    })

    const declared = binding({
        state: in.state.ast.statements,
        name: bytes.fromText(property_name),
        type_expr: target.id,
        value: property.id,
        mutable: false
    })

    const variable = path({
        state: property.state,
        path: [property_name]
    })

    const pointer = address({
        state: variable.state,
        value: variable.id
    })

    const cast = builtin({
        state: pointer.state,
        name: B.PtrCast,
        arguments: [pointer.id]
    })

    const one = integer({
        state: cast.state,
        value: 1
    })

    return check({
        state: {
            ...in.state,
            ast: {
                ...in.state.ast,
                context: one.state,
                statements: declared,
                fields: valued
            }
        },
        name: define_properties,
        arguments: [
            env.id,
            result.id,
            one.id,
            cast.id
        ]
    })
}
