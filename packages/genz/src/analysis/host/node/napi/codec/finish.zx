import bytes from "std:bytes"
import integers from "std:integer"

import identifier from "../../../../../ast/context/identifier"
import path from "../../../../../ast/context/path"
import functionDeclaration from "../../../../../ast/declarations/function"
import append from "../../../../../ast/declarations/table/function"
import field from "../../../../../ast/fields/append"
import close from "../../../../../ast/statements/builder/close"
import { api_name, env_name, env_type, std_name } from "../../context/const"
import { value_name, value_type, allocator_name } from "../../task/const"
import errorUnion from "../../task/error_union"
import {
    type_prefix,
    read_prefix,
    write_prefix,
    mem_name,
    allocator_type
} from "./const"
import name from "./name"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const names = match in.source.reading { true => [
        allocator_name,
        env_name,
        value_name
    ], _ => [
        env_name,
        value_name
    ] }

    const allocator = path({
        state: in.tree.ast.context,
        path: [
            std_name,
            mem_name,
            allocator_type
        ]
    })

    const env = path({
        state: allocator.state,
        path: [
            api_name,
            env_type
        ]
    })

    const value = path({
        state: env.state,
        path: [
            api_name,
            value_type
        ]
    })

    const target = identifier({
        state: value.state,
        name: name({
            prefix: type_prefix,
            id: in.source.id
        })
    })

    const types = match in.source.reading { true => [
        allocator.id,
        env.id,
        value.id
    ], _ => [
        env.id,
        target.id
    ] }

    const body = close(in.tree.ast.statements)

    const result = errorUnion({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: target.state,
                statements: body.state
            }
        },
        payload: in.source.reading ? target.id : value.id,
        inferred: false
    })

    const fields = loop({
        fields: in.tree.ast.fields,
        index: 0
    }, {
        while: current => current.index < names.length,
        next: current => {
            current.fields = field({
                table: current.fields,
                name: bytes.fromText(names[current.index]),
                value: types[current.index],
                comptime_parameter: false
            })
            current.index += 1
        },
        return: current => current.fields
    })

    const declaration = functionDeclaration({
        base: integers.narrow(in.tree.ast.declarations.tags.length),
        name: name({
            prefix: in.source.reading ? read_prefix : write_prefix,
            id: in.source.id
        }),
        parameters_start:
            in.source.bases.field_base +
            integers.narrow(in.tree.ast.fields.name.length),
        parameters_count: integers.narrow(names.length),
        return_type: result.id,
        body_start: body.first,
        body_count: body.count,
        exported: false,
        abi_export: false,
        inlined: false
    })

    const declared = append({
        state: in.tree.ast.declarations,
        value: declaration.table,
        parameter_base: 0
    })

    const valid = (
        - in.tree.ast.valid
        - and declaration.valid
        - and declared.valid
    )

    return {
        ...in,
        tree: {
            ...result.state,
            ast: {
                ...result.state.ast,
                fields,
                declarations: declared.state,
                valid
            }
        }
    }
}
