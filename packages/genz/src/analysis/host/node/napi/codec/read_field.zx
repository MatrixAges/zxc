import bytes from "std:bytes"
import { Kind } from "core/type_table/model"

import address from "../../../../../ast/context/address"
import call from "../../../../../ast/context/call"
import field from "../../../../../ast/context/field"
import identifier from "../../../../../ast/context/identifier"
import integer from "../../../../../ast/context/integer"
import nullValue from "../../../../../ast/context/null_value"
import path from "../../../../../ast/context/path"
import text from "../../../../../ast/context/text"
import assignment from "../../../../../ast/statements/builder/assignment"
import binding from "../../../../../ast/statements/builder/binding"
import open from "../../../../../ast/statements/builder/open"
import closeScope from "../../../../../ast/statements/builder/scope"
import { ExpressionsKind as K } from "../../../../../printer/model/expressions"
import { api_name, env_name } from "../../context/const"
import { value_name, value_type, result_name, allocator_name } from "../../task/const"
import check from "../value/check_call"
import { read_prefix, item_name, get_element, get_property } from "./const"
import member from "./member"
import typeName from "./name"

import type { Member as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const info = member(in)

    const scope = open(in.state.tree.ast.statements)

    const env = path({
        state: in.state.tree.ast.context,
        path: [env_name]
    })

    const value = path({
        state: env.state,
        path: [value_name]
    })

    const nil = nullValue(value.state)

    const value_type_node = path({
        state: nil.state,
        path: [
            api_name,
            value_type
        ]
    })

    const declared = binding({
        state: scope.state,
        name: bytes.fromText(item_name),
        value: nil.id,
        mutable: true,
        type_expr: value_type_node.id
    })

    const item = path({
        state: value_type_node.state,
        path: [item_name]
    })

    const pointer = address({
        state: item.state,
        value: item.id
    })

    const key = text({
        state: pointer.state,
        kind: K.String,
        value: info.key
    })

    const index_value = integer({
        state: key.state,
        value: in.position
    })

    const read = check({
        state: {
            ...in.state.tree,
            ast: {
                ...in.state.tree.ast,
                context: index_value.state,
                statements: declared
            }
        },
        name: in.state.kind == Kind.Tuple ? get_element : get_property,
        arguments: [
            env.id,
            value.id,
            in.state.kind == Kind.Tuple ? index_value.id : key.id,
            pointer.id
        ]
    })

    const allocator = path({
        state: read.ast.context,
        path: [allocator_name]
    })

    const converted_name = identifier({
        state: allocator.state,
        name: typeName({
            prefix: read_prefix,
            id: info.child
        })
    })

    const converted = call({
        state: converted_name.state,
        callee: converted_name.id,
        arguments: [
            allocator.id,
            env.id,
            item.id
        ],
        fallible: true
    })

    const result_value = path({
        state: converted.state,
        path: [result_name]
    })

    const target = field({
        state: result_value.state,
        target: result_value.id,
        name: info.name
    })

    const assigned = assignment({
        state: read.ast.statements,
        target: target.id,
        value: converted.id
    })

    const closed = closeScope({
        scope: {
            ...scope,
            state: assigned
        },
        columns: in.state.scopes
    })

    const result_state = {
        ...in.state,
        tree: {
            ...in.state.tree,
            ast: {
                ...in.state.tree.ast,
                context: target.state,
                statements: closed.state
            },
            extra: read.extra
        },
        scopes: closed.columns
    }

    return result_state
}
