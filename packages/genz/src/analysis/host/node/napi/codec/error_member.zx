import bytes from "std:bytes"

import field from "../../../../../ast/context/field"
import identifier from "../../../../../ast/context/identifier"
import path from "../../../../../ast/context/path"
import primitive from "../../../../../ast/context/primitive"
import text from "../../../../../ast/context/text"
import branch from "../../../../../ast/statements/builder/branch"
import open from "../../../../../ast/statements/builder/open"
import result from "../../../../../ast/statements/builder/result"
import {
    ExpressionsPrimitive as P,
    ExpressionsKind as K
} from "../../../../../printer/model/expressions"
import { std_name } from "../../context/const"
import { name_name } from "../../task/const"
import invoke from "../../task/invoke"
import { type_prefix, mem_name, equal_name } from "./const"
import typeName from "./name"

import type { State, State as Output } from "./model"

export type Input = {
    state: State,
    member_name: string
}

export default function (in: Input): Output {
    const byte = primitive({
        state: in.state.tree.ast.context,
        value: P.U8
    })

    const name_value = path({
        state: byte.state,
        path: [name_name]
    })

    const member = text({
        state: name_value.state,
        kind: K.String,
        value: bytes.fromText(in.member_name)
    })

    const equal = invoke({
        state: {
            ...in.state.tree,
            ast: {
                ...in.state.tree.ast,
                context: member.state
            }
        },
        path: [
            std_name,
            mem_name,
            equal_name
        ],
        arguments: [
            byte.id,
            name_value.id,
            member.id
        ],
        fallible: false
    })

    const scope = open(in.state.tree.ast.statements)

    const target = identifier({
        state: equal.state.ast.context,
        name: typeName({
            prefix: type_prefix,
            id: in.state.source.id
        })
    })

    const result_value = field({
        state: target.state,
        target: target.id,
        name: bytes.fromText(in.member_name)
    })

    const returned = result({
        state: scope.state,
        value: result_value.id
    })

    const branched = branch({
        scope: {
            ...scope,
            state: returned
        },
        condition: equal.id
    })

    return {
        ...in.state,
        tree: {
            ...in.state.tree,
            ast: {
                ...in.state.tree.ast,
                context: result_value.state,
                statements: branched
            }
        }
    }
}
