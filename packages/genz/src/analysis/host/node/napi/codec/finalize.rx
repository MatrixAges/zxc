<Module>
    <If on={$in.supported}>
        <Call fn="finish" in={$in} />
        <Call fn="publish" in={$ctx.finish} />

        <Return value={$ctx.publish} />

        <Else>
            <Call fn="publish" in={$in} />

            <Return value={$ctx.publish} />
        </Else>
    </If>
</Module>
