import bytes from "std:bytes"
import integers from "std:integer"
import { Kind } from "core/type_table/model"

import path from "../../../../../ast/context/path"
import binding from "../../../../../ast/statements/builder/binding"
import { env_name } from "../../context/const"
import { value_name, result_name, allocator_name } from "../../task/const"
import invoke from "../../task/invoke"
import { create_name } from "./const"
import layout from "./layout"
import recordGuard from "./record_guard"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const env = path({
        state: in.tree.ast.context,
        path: [env_name]
    })

    const value = path({
        state: env.state,
        path: [value_name]
    })

    const tuple = in.kind == Kind.Tuple

    const count =
        integers.widen(in.source.types.second[integers.widen(in.source.id)])

    const guarded = recordGuard({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: value.state
            }
        },
        tuple,
        count,
        env: env.id,
        value: value.id
    })

    const layout_type = layout({
        ...in,
        tree: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: guarded.ast.context,
                statements: guarded.ast.statements
            },
            extra: guarded.extra
        }
    })

    const allocated = invoke({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: layout_type.context,
                statements: guarded.ast.statements
            },
            extra: guarded.extra
        },
        path: [
            allocator_name,
            create_name
        ],
        arguments: [layout_type.id],
        fallible: true
    })

    const declared = binding({
        state: guarded.ast.statements,
        name: bytes.fromText(result_name),
        value: allocated.id,
        mutable: false
    })

    return {
        ...in,
        tree: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: allocated.state.ast.context,
                statements: declared
            },
            extra: guarded.extra
        }
    }
}
