import context from "../../../../../ast/context/initialize"
import statements from "../../../../../ast/statements/builder/initialize"
import initialize from "../../task/initialize"
import classify from "./classify"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const tree = initialize({
        stateful: false
    })

    return {
        source: in,
        tree: {
            ...tree,
            ast: {
                ...tree.ast,
                context: context(in.bases),
                statements: statements(in.bases.statement_base)
            }
        },
        loops: {
            for_loop_iterable: [],
            for_loop_capture: [],
            for_loop_body_start: [],
            for_loop_body_len: [],
            for_loop_capture_reference: [],
            for_loop_index_capture: []
        },
        scopes: {
            scope_start: [],
            scope_len: []
        },
        many_pointer: [],
        ...classify(in),
        supported: true
    }
}
