import address from "../../../../../ast/context/address"
import nullValue from "../../../../../ast/context/null_value"
import path from "../../../../../ast/context/path"
import { env_name } from "../../context/const"
import { value_name, result_name, ptr_name, len_name } from "../../task/const"
import check from "../value/check_call"
import { create_buffer } from "./const"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const env = path({
        state: in.tree.ast.context,
        path: [env_name]
    })

    const length = path({
        state: env.state,
        path: [
            value_name,
            len_name
        ]
    })

    const pointer = path({
        state: length.state,
        path: [
            value_name,
            ptr_name
        ]
    })

    const nil = nullValue(pointer.state)

    const result_value = path({
        state: nil.state,
        path: [result_name]
    })

    const address = address({
        state: result_value.state,
        value: result_value.id
    })

    const written = check({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: address.state
            }
        },
        name: create_buffer,
        arguments: [
            env.id,
            length.id,
            pointer.id,
            nil.id,
            address.id
        ]
    })

    return {
        ...in,
        tree: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: written.ast.context,
                statements: written.ast.statements
            },
            extra: written.extra
        }
    }
}
