import bytes from "std:bytes"

import address from "../../../../../ast/context/address"
import call from "../../../../../ast/context/call"
import identifier from "../../../../../ast/context/identifier"
import path from "../../../../../ast/context/path"
import close from "../../../../../ast/statements/builder/close"
import elseBranch from "../../../../../ast/statements/builder/else_branch"
import open from "../../../../../ast/statements/builder/open"
import result from "../../../../../ast/statements/builder/result"
import { env_name } from "../../context/const"
import { value_name, result_name } from "../../task/const"
import check from "../value/check_call"
import { write_prefix, child_name, get_null } from "./const"
import typeName from "./name"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const value = path({
        state: in.tree.ast.context,
        path: [value_name]
    })

    const scope = open(in.tree.ast.statements)

    const env = path({
        state: value.state,
        path: [env_name]
    })

    const child = path({
        state: env.state,
        path: [child_name]
    })

    const written_name = identifier({
        state: child.state,
        name: typeName({
            prefix: write_prefix,
            id: in.child
        })
    })

    const written = call({
        state: written_name.state,
        callee: written_name.id,
        arguments: [
            env.id,
            child.id
        ],
        fallible: false
    })

    const returned = result({
        state: scope.state,
        value: written.id
    })

    const yes = close(returned)

    const result_value = path({
        state: written.state,
        path: [result_name]
    })

    const address = address({
        state: result_value.state,
        value: result_value.id
    })

    const empty = check({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: address.state,
                statements: yes.state
            }
        },
        name: get_null,
        arguments: [
            env.id,
            address.id
        ]
    })

    const branched = elseBranch({
        scope: {
            ...scope,
            state: empty.ast.statements
        },
        condition: value.id,
        capture: bytes.fromText(child_name),
        yes_first: yes.first,
        yes_count: yes.count
    })

    return {
        ...in,
        tree: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: empty.ast.context,
                statements: branched
            },
            extra: empty.extra
        }
    }
}
