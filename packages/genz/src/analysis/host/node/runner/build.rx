<Module>
    <Type from="model" as="Runner" />

    <Args in={Runner.Args} out={Runner.Output} />

    <Call fn="initialize" in={$in} />
    <Call fn="prelude" in={$ctx.initialize} />
    <Call fn="capability" in={$ctx.prelude} />
    <Call fn="version" in={$ctx.capability} />
    <Call fn="entry" in={$ctx.version} />
    <Call fn="allocate" in={$ctx.entry} />

    <If on={$in.stateful}>
        <Call fn="state" in={$ctx.allocate} />

        <Call module="registered" in={$ctx.state} />

        <Return value={$ctx.registered} />

        <Else>
            <Call module="registered" in={$ctx.allocate} />

            <Return value={$ctx.registered} />
        </Else>
    </If>
</Module>
