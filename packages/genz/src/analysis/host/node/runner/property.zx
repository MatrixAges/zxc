import bytes from "std:bytes"
import integers from "std:integer"

import address from "../../../../ast/context/address"
import builtin from "../../../../ast/context/builtin"
import integer from "../../../../ast/context/integer"
import object from "../../../../ast/context/object"
import path from "../../../../ast/context/path"
import text from "../../../../ast/context/text"
import field from "../../../../ast/fields/append"
import binding from "../../../../ast/statements/builder/binding"
import {
    ExpressionsBuiltinName as Builtin,
    ExpressionsKind as K
} from "../../../../printer/model/expressions"
import { api_name, env_name } from "../context/const"
import check from "../task/check"
import { value_name } from "../task/const"
import {
    exports_name,
    define_properties,
    property_type,
    property_name,
    function_name,
    utf8_name
} from "./const"

import type { State, State as Output } from "../task/model"

export type Input = {
    state: State,
    name: string
}

export default function (in: Input): Output {
    const property_type_node = path({
        state: in.state.ast.context,
        path: [
            api_name,
            property_type
        ]
    })

    const key = text({
        state: property_type_node.state,
        kind: K.String,
        value: bytes.fromText(in.name)
    })

    const javascript_function = path({
        state: key.state,
        path: [function_name]
    })

    const name_field = field({
        table: in.state.ast.fields,
        name: bytes.fromText(utf8_name),
        value: key.id,
        comptime_parameter: false
    })

    const value_field = field({
        table: name_field,
        name: bytes.fromText(value_name),
        value: javascript_function.id,
        comptime_parameter: false
    })

    const property = object({
        state: javascript_function.state,
        type_expr: property_type_node.id,
        first: integers.narrow(in.state.ast.fields.name.length),
        count: 2
    })

    const declared = binding({
        state: in.state.ast.statements,
        name: bytes.fromText(property_name),
        value: property.id,
        mutable: false
    })

    const env = path({
        state: property.state,
        path: [env_name]
    })

    const exports = path({
        state: env.state,
        path: [exports_name]
    })

    const one = integer({
        state: exports.state,
        value: 1
    })

    const value = path({
        state: one.state,
        path: [property_name]
    })

    const pointer = address({
        state: value.state,
        value: value.id
    })

    const cast = builtin({
        state: pointer.state,
        name: Builtin.PtrCast,
        arguments: [pointer.id]
    })

    const defined = check({
        state: {
            ...in.state,
            ast: {
                ...in.state.ast,
                context: cast.state,
                statements: declared,
                fields: value_field
            }
        },
        name: define_properties,
        arguments: [
            env.id,
            exports.id,
            one.id,
            cast.id
        ]
    })

    return {
        ...in.state,
        ast: {
            ...in.state.ast,
            context: defined.ast.context,
            statements: defined.ast.statements,
            fields: value_field
        },
        extra: defined.extra
    }
}
