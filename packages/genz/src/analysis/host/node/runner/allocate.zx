import bytes from "std:bytes"
import integers from "std:integer"

import dereference from "../../../../ast/context/dereference"
import object from "../../../../ast/context/object"
import path from "../../../../ast/context/path"
import field from "../../../../ast/fields/append"
import assignment from "../../../../ast/statements/builder/assignment"
import binding from "../../../../ast/statements/builder/binding"
import {
    std_name,
    env_name,
    heap_name,
    page_allocator_name,
    arena_name,
    arena_type,
    release_name
} from "../context/const"
import { create_name } from "../enqueue/const"
import { context_name, context_type, init_name } from "../task/const"
import deferValue from "../task/defer_value"
import invoke from "../task/invoke"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const context_type_node = path({
        state: in.tree.ast.context,
        path: [context_type]
    })

    const allocated = invoke({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: context_type_node.state
            }
        },
        path: [
            std_name,
            heap_name,
            page_allocator_name,
            create_name
        ],
        arguments: [context_type_node.id],
        fallible: true
    })

    const declared = binding({
        state: in.tree.ast.statements,
        name: bytes.fromText(context_name),
        value: allocated.id,
        mutable: false
    })

    const context = path({
        state: allocated.state.ast.context,
        path: [context_name]
    })

    const target = dereference({
        state: context.state,
        value: context.id
    })

    const allocator = path({
        state: target.state,
        path: [
            std_name,
            heap_name,
            page_allocator_name
        ]
    })

    const arena = invoke({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: allocator.state,
                statements: declared
            }
        },
        path: [
            std_name,
            heap_name,
            arena_type,
            init_name
        ],
        arguments: [allocator.id],
        fallible: false
    })

    const arena_field = field({
        table: in.tree.ast.fields,
        name: bytes.fromText(arena_name),
        value: arena.id,
        comptime_parameter: false
    })

    const environment = path({
        state: arena.state.ast.context,
        path: [env_name]
    })

    const env_field = field({
        table: arena_field,
        name: bytes.fromText(env_name),
        value: environment.id,
        comptime_parameter: false
    })

    const initialized = object({
        state: environment.state,
        first: integers.narrow(in.tree.ast.fields.name.length),
        count: 2
    })

    const stored = assignment({
        state: declared,
        target: target.id,
        value: initialized.id
    })

    const release = invoke({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: initialized.state,
                statements: stored,
                fields: env_field
            }
        },
        path: [
            context_name,
            release_name
        ],
        arguments: [],
        fallible: false
    })

    const deferred = deferValue({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: release.state.ast.context,
                statements: stored,
                fields: env_field
            }
        },
        id: release.id
    })

    return {
        ...in,
        tree: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: deferred.ast.context,
                statements: deferred.ast.statements,
                fields: env_field
            },
            extra: deferred.extra
        }
    }
}
