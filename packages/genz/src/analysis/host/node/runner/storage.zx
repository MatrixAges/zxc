import bytes from "std:bytes"

import binding from "../../../../ast/statements/builder/binding"
import { arena_name, deinit_name } from "../context/const"
import { request_name } from "../task/const"
import deferValue from "../task/defer_value"
import invoke from "../task/invoke"
import storage from "./storage_value"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const stateful = in.tree.ast.stateful

    const constructed = storage(in.tree)

    const declared = binding({
        state: in.tree.ast.statements,
        name: bytes.fromText(match stateful {
            true => request_name,
            _ => arena_name
        }),
        value: constructed.id,
        mutable: true
    })

    const deinitialized = invoke({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: constructed.state.ast.context,
                statements: declared
            }
        },
        path: [
            match stateful { true => request_name, _ => arena_name },
            deinit_name
        ],
        arguments: [],
        fallible: false
    })

    const deferred = deferValue({
        state: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: deinitialized.state.ast.context,
                statements: declared
            }
        },
        id: deinitialized.id
    })

    return {
        ...in,
        tree: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: deferred.ast.context,
                statements: deferred.ast.statements
            },
            extra: deferred.extra
        }
    }
}
