import bytes from "std:bytes"
import integers from "std:integer"

import binary from "../../../../ast/context/binary"
import builtin from "../../../../ast/context/builtin"
import path from "../../../../ast/context/path"
import text from "../../../../ast/context/text"
import branch from "../../../../ast/statements/builder/branch"
import close from "../../../../ast/statements/builder/close"
import evaluate from "../../../../ast/statements/builder/evaluate"
import open from "../../../../ast/statements/builder/open"
import { DeclarationsKind as D } from "../../../../printer/model/declarations"
import {
    ExpressionsBinaryOperator as B,
    ExpressionsBuiltinName as Builtin,
    ExpressionsKind as K
} from "../../../../printer/model/expressions"
import { application_name } from "../task/const"
import { requires_io, requires_process, unsupported_capability } from "./const"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const io = path({
        state: in.tree.ast.context,
        path: [
            application_name,
            requires_io
        ]
    })

    const process = path({
        state: io.state,
        path: [
            application_name,
            requires_process
        ]
    })

    const needed = binary({
        state: process.state,
        operator: B.LogicalOr,
        left: io.id,
        right: process.id
    })

    const scope = open(in.tree.ast.statements)

    const message = text({
        state: needed.state,
        kind: K.String,
        value: bytes.fromText(unsupported_capability)
    })

    const failure = builtin({
        state: message.state,
        name: Builtin.CompileError,
        arguments: [message.id]
    })

    const failed = evaluate({
        state: scope.state,
        value: failure.id,
        discard: false
    })

    const guarded = branch({
        scope: {
            ...scope,
            state: failed
        },
        condition: needed.id
    })

    const body = close(guarded)

    return {
        ...in,
        tree: {
            ...in.tree,
            ast: {
                ...in.tree.ast,
                context: failure.state,
                statements: body.state,
                declarations: {
                    ...in.tree.ast.declarations,
                    tags: in.tree.ast.declarations.tags.push(D.ComptimeScope)[0],
                    offsets:
                        in.tree.ast.declarations.offsets.push(
                            integers.narrow(
                                in.comptime_start.length
                            )
                        )[0]
                }
            }
        },
        comptime_start: in.comptime_start.push(body.first)[0],
        comptime_len: in.comptime_len.push(body.count)[0]
    }
}
