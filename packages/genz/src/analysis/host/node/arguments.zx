import bytes from "std:bytes"

import address from "../../../ast/context/address"
import fixedArray from "../../../ast/context/fixed_array"
import integer from "../../../ast/context/integer"
import nullValue from "../../../ast/context/null_value"
import path from "../../../ast/context/path"
import primitive from "../../../ast/context/primitive"
import undefinedValue from "../../../ast/context/undefined"
import binding from "../../../ast/statements/builder/binding"
import { ExpressionsPrimitive as P } from "../../../printer/model/expressions"
import { api_name, env_name, data_name } from "./context/const"
import dataType from "./data_type"
import { arguments_name, count_name, info_name, get_cb_info } from "./enqueue/const"
import check from "./task/check"
import { value_type, len_name } from "./task/const"

import type { State as Tree } from "./task/model"

export type Input = {
    tree: Tree,
    capacity: u64
}

export type Output = Tree

export default function (in: Input): Output {
    const element = path({
        state: in.tree.ast.context,
        path: [
            api_name,
            value_type
        ]
    })

    const capacity = integer({
        state: element.state,
        value: in.capacity
    })

    const array_type = fixedArray({
        state: capacity.state,
        length: capacity.id,
        element: element.id
    })

    const missing = undefinedValue(array_type.state)

    const arguments = binding({
        state: in.tree.ast.statements,
        name: bytes.fromText(arguments_name),
        type_expr: array_type.id,
        value: missing.id,
        mutable: true
    })

    const size = primitive({
        state: missing.state,
        value: P.Usize
    })

    const length = path({
        state: size.state,
        path: [
            arguments_name,
            len_name
        ]
    })

    const counted = binding({
        state: arguments,
        name: bytes.fromText(count_name),
        type_expr: size.id,
        value: length.id,
        mutable: true
    })

    const data = dataType({
        ...in.tree.ast,
        context: length.state
    })

    const nil = nullValue(data.state.context)

    const stored = binding({
        state: counted,
        name: bytes.fromText(data_name),
        type_expr: data.id,
        value: nil.id,
        mutable: true
    })

    const env = path({
        state: nil.state,
        path: [env_name]
    })

    const info = path({
        state: env.state,
        path: [info_name]
    })

    const count = path({
        state: info.state,
        path: [count_name]
    })

    const count_pointer = address({
        state: count.state,
        value: count.id
    })

    const values = path({
        state: count_pointer.state,
        path: [arguments_name]
    })

    const values_pointer = address({
        state: values.state,
        value: values.id
    })

    const output = path({
        state: values_pointer.state,
        path: [data_name]
    })

    const output_pointer = address({
        state: output.state,
        value: output.id
    })

    const tree = check({
        state: {
            ...in.tree,
            ast: {
                ...data.state,
                context: output_pointer.state,
                statements: stored
            }
        },
        name: get_cb_info,
        arguments: [
            env.id,
            info.id,
            count_pointer.id,
            values_pointer.id,
            nil.id,
            output_pointer.id
        ]
    })

    return tree
}
