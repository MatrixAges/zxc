<Module>
    <Type from="model" as="Append" />

    <Args in={Append.Input} out={Append.Output} />

    <Call fn="initialize" in={$in} />
    <Call fn="count" in={$ctx.initialize} />

    <Call module="memory" in={$ctx.count} />
    <Call module="write" in={$ctx.memory} />
    <Call module="qualify" in={$ctx.write} />

    <Call fn="publish" in={$ctx.qualify} />

    <Return value={$ctx.publish} />
</Module>
