import binary from "../../../ast/context/binary"
import conditional from "../../../ast/context/conditional"
import integer from "../../../ast/context/integer"
import nullValue from "../../../ast/context/null_value"
import tuple from "../../../ast/context/tuple"
import { ExpressionsBinaryOperator as Op } from "../../../printer/model/expressions"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const zero = integer({
        state: in.state.context,
        value: 0
    })

    const empty = binary({
        state: zero.state,
        operator: Op.Equal,
        left: in.source.length,
        right: zero.id
    })

    const absent = nullValue(empty.state)

    const pair = tuple({
        state: absent.state,
        values: [
            in.source.value,
            absent.id
        ]
    })

    const result = conditional({
        state: pair.state,
        condition: empty.id,
        yes: pair.id,
        no: in.nonempty
    })

    const state = in.state

    return {
        expressions: result.state.expressions,
        forms: result.state.forms,
        statements: result.state.statements,
        body: {
            ...result.state.statements,
            ...state.body
        },
        storage: {
            ...result.state.statements,
            ...state.storage
        },
        borrow_storage: {
            ...result.state.statements,
            ...state.borrow_storage
        },
        variables: result.state.variables,
        fields: state.fields,
        root: result.id,
        serial: result.state.serial,
        uses_allocator: state.uses_allocator,
        valid: result.state.valid
    }
}
