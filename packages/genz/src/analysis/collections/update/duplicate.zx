import bytes from "std:bytes"

import call from "../../../ast/context/call"
import field from "../../../ast/context/field"
import identifier from "../../../ast/context/identifier"
import { allocator_name } from "../../construction/const"
import candidate from "./candidate"
import { duplicate_member } from "./const"

import type { Candidate as Output, State as Input } from "./model"

export default function (in: Input): Output {
    const allocator = identifier({
        state: in.context,
        name: bytes.fromText(allocator_name)
    })

    const method = field({
        state: allocator.state,
        target: allocator.id,
        name: bytes.fromText(duplicate_member)
    })

    const result = call({
        state: method.state,
        callee: method.id,
        arguments: [
            in.source.element,
            in.source.items
        ],
        fallible: true
    })

    return candidate(result)
}
