import type { Body, StateBody } from "../../../ast/body/model"
import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Columns as Fields } from "../../../ast/fields/model"
import type { Ast } from "../../state/list/model"

export type Input = {
    source: u32,
    header: u32,
    start: u32,
    count: u32,
    replacement: u32,
    element: u32,
    length: u32,
    selected: bool,
    layout: u32,
    retract: bool,
    removed_only: bool,
    shared: bool,
    ast: Ast,
    bases: Bases
}

export type State = {
    source: Input,
    context: Context,
    body: Body,
    fields: Fields,
    begin: u32,
    removed: u32,
    end: u32,
    inserted: u32,
    total: u32,
    buffer: u32,
    tail: u32,
    root: u32
}

export type Output = {
    state: StateBody,
    fields: Fields,
    root: u32,
    serial: u64,
    uses_allocator: bool,
    valid: bool
}
