import bytes from "std:bytes"
import integers from "std:integer"

import object from "../../../ast/context/object"
import append from "../../../ast/fields/append"
import { items_field, storage_field, list_field_count } from "../../types/state/const"

import type { State } from "./model"

export type Input = {
    state: State,
    value: u32,
    storage: u32
}

export type Output = {
    state: State,
    id: u32
}

export default function (in: Input): Output {
    const state = in.state

    if (!state.source.selected) {
        return {
            state,
            id: in.value
        }
    }

    const first = append({
        table: state.fields,
        name: bytes.fromText(items_field),
        value: in.value,
        default_value: null,
        comptime_parameter: false
    })

    const fields = append({
        table: first,
        name: bytes.fromText(storage_field),
        value: in.storage,
        default_value: null,
        comptime_parameter: false
    })

    const value = object({
        state: state.context,
        type_expr: state.source.layout,
        first:
            state.context.source.field_base + integers.narrow(state.fields.name.length),
        count: list_field_count
    })

    return {
        state: {
            ...state,
            context: value.state,
            fields
        },
        id: value.id
    }
}
