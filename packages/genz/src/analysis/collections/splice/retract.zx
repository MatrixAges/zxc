import branch from "../../../ast/body/branch"
import evaluate from "../../../ast/body/evaluate"
import binary from "../../../ast/context/binary"
import call from "../../../ast/context/call"
import integer from "../../../ast/context/integer"
import { ExpressionsBinaryOperator as Op } from "../../../printer/model/expressions"
import { Operation } from "../../growth/const"
import target from "../../growth/target"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const callee = target({
        context: in.context,
        operation: Operation.Retract,
        shared: in.source.shared
    })

    const value = call({
        state: callee.state,
        callee: callee.id,
        arguments: [
            in.source.element,
            in.source.source,
            in.end
        ],
        fallible: false
    })

    const body = evaluate({
        state: {
            context: value.state,
            body: {
                tags: [],
                offsets: []
            }
        },
        value: value.id,
        discard: false
    })

    const zero = integer({
        state: body.context,
        value: 0
    })

    const condition = binary({
        state: zero.state,
        operator: Op.NotEqual,
        left: in.source.length,
        right: zero.id
    })

    const result = branch({
        state: {
            context: condition.state,
            body: in.body
        },
        condition: condition.id,
        yes: body.body
    })

    return {
        ...in,
        ...result
    }
}
