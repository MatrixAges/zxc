import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import children from "../types/children"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const target = kind(in.types.kinds[integers.widen(in.id)])

    const condition = (
        match target {
            Kind.Optional => false,
            Kind.Object => false,
            Kind.Tuple => false,
            _ => true
        }
    )

    if (condition) {
        return (
            match target {
                Kind.List => true,
                Kind.Scalar => true,
                Kind.Enumeration => true,
                Kind.ErrorSet => true,
                Kind.NativeReference => true,
                _ => false
            }
        )
    }

    const pending: u32[] = [in.id]

    return loop({
        types: in.types,
        pending,
        valid: true
    }, {
        while: current => current.valid && current.pending.length != 0,
        next: current => {
            const id = current.pending[current.pending.length - 1]
            const target = kind(current.types.kinds[integers.widen(id)])

            current.pending = current.pending.pop()[0]

            const condition_2 = (
                match target {
                    Kind.Optional => true,
                    Kind.Object => true,
                    Kind.Tuple => true,
                    _ => false
                }
            )

            if (condition_2) {
                current.pending = current.pending.concat(children({
                    types: current.types,
                    id,
                    deep: false
                }))[0]
            } else {
                current.valid = (
                    match target {
                        Kind.List => true,
                        Kind.Scalar => true,
                        Kind.Enumeration => true,
                        Kind.ErrorSet => true,
                        Kind.NativeReference => true,
                        _ => false
                    }
                )
            }
        },
        return: state => state.valid
    })
}
