import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import children from "../types/children"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const target = kind(in.types.kinds[integers.widen(in.id)])

    const condition = (
        - target != Kind.Optional
        - and target != Kind.Object
        - and target != Kind.Tuple
    )

    if (condition) {
        return (
            - target == Kind.List
            - or target == Kind.Scalar
            - or target == Kind.Enumeration
            - or target == Kind.ErrorSet
            - or target == Kind.NativeReference
        )
    }

    const pending: u32[] = [in.id]

    return loop({
        types: in.types,
        pending,
        valid: true
    }, {
        while: current => current.valid && current.pending.length != 0,
        next: current => {
            const id = current.pending[current.pending.length - 1]
            const target = kind(current.types.kinds[integers.widen(id)])

            current.pending = current.pending.pop()[0]

            const condition_2 = (
                - target == Kind.Optional
                - or target == Kind.Object
                - or target == Kind.Tuple
            )

            if (condition_2) {
                current.pending = current.pending.concat(children({
                    types: current.types,
                    id,
                    deep: false
                }))[0]
            } else {
                current.valid = (
                    - target == Kind.List
                    - or target == Kind.Scalar
                    - or target == Kind.Enumeration
                    - or target == Kind.ErrorSet
                    - or target == Kind.NativeReference
                )
            }
        },
        return: state => state.valid
    })
}
