import bytes from "std:bytes"

import field from "../../../../ast/context/field"
import { owner_field, items_field, owned_field } from "../../types/const"

import type { State as Context } from "../../../../ast/context/model"
import type { Redirect, Redirected as Output } from "../model"

export type Input = {
    source: Redirect,
    context: Context
}

export default function (in: Input): Output {
    const owner = field({
        state: in.context,
        target: in.source.value,
        name: bytes.fromText(owner_field)
    })

    const items = field({
        state: owner.state,
        target: in.source.value,
        name: bytes.fromText(items_field)
    })

    const owned = field({
        state: items.state,
        target: in.source.value,
        name: bytes.fromText(owned_field)
    })

    return {
        source: in.source,
        limit: in.source.history.types.length,
        context: owned.state,
        owner: owner.id,
        items: items.id,
        owned: owned.id
    }
}
