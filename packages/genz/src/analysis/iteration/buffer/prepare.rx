<Module>
    <Type from="model" as="Buffer" />

    <Args in={Buffer.Prepare} out={Buffer.Preparation} />

    <Call fn="prepare/project" in={$in} />
    <Call fn="prepare/branches" in={$ctx.project} />
    <Call fn="prepare/finish" in={$ctx.branches} />

    <Return value={$ctx.finish} />
</Module>
