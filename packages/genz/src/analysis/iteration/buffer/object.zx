import integers from "std:integer"

import object from "../../../ast/context/object"
import construct from "./fields"

import type { Construct as Input, Output } from "./model"

export default function (in: Input): Output {
    const { context, layout, owner, items, owned } = in

    const fields = construct({
        owner,
        items,
        owned
    })

    const value = object({
        state: context,
        type_expr: layout,
        first: context.source.field_base,
        count: integers.narrow(fields.length)
    })

    return {
        expressions: value.state.expressions,
        forms: value.state.forms,
        fields,
        root: value.id,
        valid: value.state.valid
    }
}
