import bytes from "std:bytes"
import integers from "std:integer"

import object from "../../../ast/context/object"
import { owner_field, items_field, owned_field } from "../types/const"

import type { Field } from "../../types/definitions/model"
import type { Construct as Input, Output } from "./model"

export default function (in: Input): Output {
    const { context, layout, owner, items, owned } = in

    const fields: Field[] = [
        {
            name: bytes.fromText(owner_field),
            value: owner,
            default_value: null,
            comptime_parameter: false
        },
        {
            name: bytes.fromText(items_field),
            value: items,
            default_value: null,
            comptime_parameter: false
        },
        {
            name: bytes.fromText(owned_field),
            value: owned,
            default_value: null,
            comptime_parameter: false
        }
    ]

    const value = object({
        state: context,
        type_expr: layout,
        first: context.source.field_base,
        count: integers.narrow(fields.length)
    })

    return {
        expressions: value.state.expressions,
        forms: value.state.forms,
        fields,
        root: value.id,
        valid: value.state.valid
    }
}
