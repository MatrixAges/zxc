import integers from "std:integer"

import all from "./all"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    table: Expressions,
    safe: bool[],
    payload: u64
}

export type Output = bool

export default function (in: Input): Output {
    const payload = in.payload
    const subject = in.table.match_subjects[payload]
    const first = integers.widen(in.table.match_first[payload])
    const count = integers.widen(in.table.match_count[payload])

    if (subject != null && !in.safe[integers.widen(subject)]) {
        return false
    }

    if (!all({
        safe: in.safe,
        values: in.table.match_conditions,
        first,
        count
    })) {
        return false
    }

    if (!all({
        safe: in.safe,
        values: in.table.match_results,
        first,
        count
    })) {
        return false
    }

    return in.safe[integers.widen(in.table.match_fallbacks[payload])]
}
