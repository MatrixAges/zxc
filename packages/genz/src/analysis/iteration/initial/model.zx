import type { Action, Mode } from "../layout/model"
import type { Layout } from "../parameters/model"

export enum Evaluation {
    Reference,
    Value,
    Deep
}

export enum Storage {
    Keep,
    Dereference,
    Deep,
    State,
    StateValue,
    Clip
}

export enum Guard {
    None,
    Unit,
    Consumer
}

export type Input = {
    representation: Action,
    mode: Mode,
    state_active: bool,
    direct_initial: bool,
    postcondition: bool,
    consumer: bool,
    pure: bool,
    forwarded: bool
}

export type Shape =
    Output.Pick("parameters", "layout", "selected_state", "deep", "buffered")

export type BindingInput = {
    layout: bool,
    selected_state: bool,
    deep: bool,
    mode: Mode,
    direct_initial: bool,
    pure: bool,
    forwarded: bool
}

export type Binding =
    Output.Pick("evaluation", "local", "by_value", "project_fields", "track")

export type StorageInput = {
    layout: bool,
    selected_state: bool,
    state_active: bool,
    deep: bool,
    direct_initial: bool,
    by_value: bool
}

export type Output = {
    parameters: Layout,
    layout: bool,
    selected_state: bool,
    deep: bool,
    buffered: bool,
    evaluation: Evaluation,
    local: bool,
    by_value: bool,
    project_fields: bool,
    track: bool,
    guard: Guard,
    state_scope: bool,
    storage: Storage
}
