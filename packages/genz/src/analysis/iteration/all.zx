import integers from "std:integer"

export type Input = {
    safe: bool[],
    values: u32[],
    first: u64,
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        safe: in.safe,
        values: in.values,
        position: in.first,
        end: in.first + in.count,
        valid: true
    }, {
        while: current => current.valid && current.position < current.end,
        next: current => {
            current.valid =
                current.safe[integers.widen(current.values[current.position])]
            current.position += 1
        }
    }).valid
}
