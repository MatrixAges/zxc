import get from "core/integer/index/get"

import type { Pair as Input, Missing as Output } from "./model"

export default function (in: Input): Output {
    const index = in.index

    const condition = get({
        index,
        key: in.condition
    }) == null

    const step = in.step != in.condition && get({
        index,
        key: in.step
    }) == null

    return {
        condition,
        step
    }
}
