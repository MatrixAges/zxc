import { StatementsKind } from "../../../printer/model/statements"

import type { Branch as Output } from "./model"

export type Input = {
    condition: u32,
    start: u32,
    count: u32
}

export default function (in: Input): Output {
    return {
        tags: [StatementsKind.Branch],
        offsets: [0],
        branch_condition: [in.condition],
        branch_yes_start: [in.start],
        branch_yes_len: [in.count],
        branch_no_start: [0],
        branch_no_len: [0],
        branch_capture: [null],
        branch_capture_reference: [false],
        branch_error_capture: [null]
    }
}
