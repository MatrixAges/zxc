import observes from "./observes"
import operation from "./operation"
import supported from "./supported"
import value from "./value"

import type { Input as Layout } from "./model"

export type Input = {
    input: Layout,
    allowed: bool[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const empty: bool[] = []

    return loop({
        input: in.input,
        allowed: in.allowed,
        safe: empty,
        index: 0
    }, {
        while: current => current.index < current.input.expressions.kinds.length,
        next: current => {
            const index = current.index
            const allowed = !current.input.deep || (supported({
                types: current.input.types,
                id: current.input.expressions.types[index]
            }) && operation({
                input: current.input,
                index
            }))
            const observed = current.input.boundary != null && observes({
                types: current.input.types,
                table: current.input.expressions,
                index,
                root: current.input.boundary.type_id
            })

            current.safe = current.safe.push(allowed && !observed && value({
                table: current.input.expressions,
                allowed: current.allowed,
                safe: current.safe,
                index
            }))[0]
            current.index += 1
        }
    }).safe
}
