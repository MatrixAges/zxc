import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import scalar from "core/type_table/scalar"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const types = in.source.types
    const id = integers.widen(in.type_id)
    const target = kind(types.kinds[id])

    if (target != Kind.Object && target != Kind.Tuple) {
        return false
    }

    const children = target == Kind.Object ? types.field_types : types.children
    const first = integers.widen(types.first[id])
    const end = first + integers.widen(types.second[id])

    return loop({
        index: first,
        valid: true
    }, {
        while: state => state.valid && state.index < end,
        next: state => {
            state.valid = scalar({
                kinds: types.kinds,
                first: types.first,
                type_id: children[state.index]
            })

            state.index += 1
        },
        return: state => state.valid
    })
}
