import type { Walk } from "../model"

export type Input = {
    state: Walk,
    value: u32
}

export type Output = Walk

export default function (in: Input): Output {
    const state = in.state

    const results = match {
        state.result_count < state.results.length =>
            state.results.with(state.result_count, in.value),
        _ => state.results.push(in.value)[0]
    }

    return {
        ...state,
        results,
        result_count: state.result_count + 1,
        depth: state.depth - 1
    }
}
