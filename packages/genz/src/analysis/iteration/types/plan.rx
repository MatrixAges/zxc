<Module>
    <Type from="model" as="Types" />

    <Args in={Types.Input} out={Types.Plan} />

    <Call fn="walk/initialize" in={$in} />

    <Call
        fn="walk/traverse"
        in={{
            source: $in,
            state: $ctx.initialize
        }}
    />

    <Return value={$ctx.traverse} />
</Module>
