import type { Body } from "../../../ast/body/model"
import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Columns as Forms } from "../../../ast/expressions/forms/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Columns as Statements } from "../../../ast/statements/model"
import type { Field } from "../../types/definitions/model"

export enum Mode {
    Push,
    Pop,
    Update
}

export type Binding = {
    name: u8[],
    value: u32,
    reference: u32
}

export type Input = {
    mode: Mode,
    target: Binding,
    index: Binding,
    value: Binding,
    list_layout: u32,
    result_layout: u32,
    bases: Bases
}

export type State = {
    source: Input,
    context: Context,
    body: Body,
    fields: Field[],
    owner: u32,
    items: u32,
    length: u32,
    root: u32
}

export type View = {
    state: State,
    owner: u32,
    items: u32,
    owned: u32
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    statements: Statements,
    fields: Field[],
    root: u32,
    serial: u64,
    uses_allocator: bool,
    valid: bool
}
