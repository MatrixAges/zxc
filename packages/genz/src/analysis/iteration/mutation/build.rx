<Module>
    <Type from="model" as="Mutation" />

    <Args in={Mutation.Input} out={Mutation.Output} />

    <Call module="operation" in={$in} />

    <Call
        fn="../../../ast/body/block"
        in={{
            state: $ctx.operation.pick([
                "context",
                "body"
            ]),
            value: $ctx.operation.root
        }}
    />

    <Return
        value={{
            ...$ctx.block.state.pick([
                "expressions",
                "forms",
                "statements",
                "serial",
                "valid"
            ]),
            fields: $ctx.operation.fields,
            root: $ctx.block.id,
            uses_allocator: $in.mode != Mutation.Mode.Pop
        }}
    />
</Module>
