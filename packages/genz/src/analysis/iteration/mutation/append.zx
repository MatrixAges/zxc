import bytes from "std:bytes"

import evaluate from "../../../ast/body/evaluate"
import boolean from "../../../ast/context/boolean"
import call from "../../../ast/context/call"
import field from "../../../ast/context/field"
import identifier from "../../../ast/context/identifier"
import tuple from "../../../ast/context/tuple"
import unit from "../../../ast/context/unit"
import { allocator_name } from "../buffer/const"
import { items_field } from "../types/const"
import { append_member } from "./const"
import view from "./view"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const target = field({
        state: in.context,
        target: in.owner,
        name: bytes.fromText(append_member)
    })

    const allocator = identifier({
        state: target.state,
        name: bytes.fromText(allocator_name)
    })

    const appended = call({
        state: allocator.state,
        callee: target.id,
        arguments: [
            allocator.id,
            in.source.value.reference
        ],
        fallible: true
    })

    const executed = evaluate({
        state: {
            context: appended.state,
            body: in.body
        },
        value: appended.id,
        discard: false
    })

    const items = field({
        state: executed.context,
        target: in.owner,
        name: bytes.fromText(items_field)
    })

    const owned = boolean({
        state: items.state,
        value: true
    })

    const list = view({
        state: {
            ...in,
            context: owned.state,
            body: executed.body
        },
        owner: in.owner,
        items: items.id,
        owned: owned.id
    })

    const empty = unit(list.context)

    const result = tuple({
        state: empty.state,
        values: [
            list.root,
            empty.id
        ]
    })

    return {
        ...list,
        context: result.state,
        root: result.id
    }
}
