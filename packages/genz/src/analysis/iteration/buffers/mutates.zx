import integers from "std:integer"
import child from "core/expression_table/child"

import mutation from "./mutation"

import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    expressions: Expressions,
    roots: u32[]
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        source: in,
        pending: in.roots,
        seen: in.expressions.kinds.map(kind => false)[0],
        found: false
    }, {
        while: current => !current.found && current.pending.length != 0,
        next: current => {
            const index = integers.widen(current.pending[current.pending.length - 1])

            current.pending = current.pending.pop()[0]

            if (!current.seen[index]) {
                current.seen[index] = true
                current.found = mutation({
                    types: current.source.types,
                    expressions: current.source.expressions,
                    index
                })

                const nested = loop({
                    table: current.source.expressions,
                    id: index,
                    index: 0,
                    pending: current.pending,
                    active: !current.found
                }, {
                    while: entry => entry.active,
                    next: entry => {
                        const value = child({
                            table: entry.table,
                            id: entry.id,
                            index: entry.index
                        })

                        if (value == null) {
                            entry.active = false
                        } else {
                            entry.pending = entry.pending.push(value)[0]
                            entry.index += 1
                        }
                    }
                })

                current.pending = nested.pending
            }
        },
        return: state => state.found
    })
}
