import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import supported from "../../types/list_supported"
import contains from "./contains"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const target = kind(in.types.kinds[integers.widen(in.id)])

    return (target == Kind.Object || target == Kind.Tuple) && supported({
        types: in.types,
        id: in.id
    }) && contains({
        types: in.types,
        id: in.id,
        products: true
    })
}
