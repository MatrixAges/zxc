import mutation from "./mutation"

import type { Input as Request } from "./model"

export type Input = {
    source: Request,
    seen: bool[]
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        source: in.source.source,
        seen: in.seen,
        index: 0,
        found: false
    }, {
        while: current => !current.found && current.index < current.seen.length,
        next: current => {
            current.found = current.seen[current.index] && mutation({
                types: current.source.types,
                expressions: current.source.expressions,
                index: current.index
            })
            current.index += 1
        }
    }).found
}
