export enum Route {
    BufferedConsumer,
    DeepConsumer,
    ConvertedConsumer,
    Consumer,
    Discard,
    Value,
    Reference,
    ConvertedGuard,
    SelectedGuard,
    DeepGuard,
    ConstructGuard
}

export type Input = {
    consumer: bool,
    deep: bool,
    inline_lists: bool,
    converted: bool,
    discard: bool,
    by_value: bool,
    local: bool,
    selected: bool
}

export type Output = Route

export default function (in: Input): Output {
    if (in.consumer) {
        if (in.deep) {
            return in.inline_lists ? Route.BufferedConsumer : Route.DeepConsumer
        }

        return in.converted ? Route.ConvertedConsumer : Route.Consumer
    }

    if (in.discard) {
        return Route.Discard
    }

    if (in.by_value) {
        return Route.Value
    }

    if (!in.local) {
        return Route.Reference
    }

    return match {
        in.converted => Route.ConvertedGuard,
        in.selected => Route.SelectedGuard,
        in.deep => Route.DeepGuard,
        _ => Route.ConstructGuard
    }
}
