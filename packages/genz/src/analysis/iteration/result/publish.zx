import type { Walk, Output } from "./model"

export type Input = {
    state: Walk,
    primitive: bool
}

export default function (in: Input): Output {
    return {
        primitive: in.primitive,
        valid: in.state.valid,
        projections: in.state.projections,
        transfers: [],
        reuses: [],
        reads: [],
        transfer_count: 0
    }
}
