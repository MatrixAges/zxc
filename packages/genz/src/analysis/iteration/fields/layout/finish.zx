import integers from "std:integer"

import header from "../../../../ast/expressions/header"
import fresh from "../../../../ast/fresh"
import { ExpressionsKind } from "../../../../printer/model/expressions"
import { StatementsKind } from "../../../../printer/model/statements"
import { layout_prefix } from "./const"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const name = fresh({
        serial: in.source.serial,
        prefix: layout_prefix
    })

    const layout = header({
        ...in.expressions.pick([
            "tags",
            "offsets"
        ]),
        base: in.source.expression_base,
        kind: ExpressionsKind.StructType,
        offset: in.expressions.struct_type_start.length
    })

    const reference = header({
        tags: layout.tags,
        offsets: layout.offsets,
        base: in.source.expression_base,
        kind: ExpressionsKind.Identifier,
        offset: in.expressions.identifier.length
    })

    const valid = (
        - in.valid
        - and layout.valid
        - and reference.valid
    )

    return {
        expressions: {
            ...in.expressions,
            tags: reference.tags,
            offsets: reference.offsets,
            struct_type_start:
                in.expressions.struct_type_start.push(in.source.field_base)[0],
            struct_type_len:
                in.expressions.struct_type_len.push(
                    integers.narrow(
                        in.fields.name.length
                    )
                )[0],
            identifier: in.expressions.identifier.push(name.name)[0]
        },
        fields: in.fields,
        statements: {
            tags: [StatementsKind.Constant],
            offsets: [0],
            constant_name: [name.name],
            constant_type_expr: [null],
            constant_value: [layout.id],
            constant_exported: [false]
        },
        origin_owned: in.origin_owned,
        serial: name.serial,
        root: reference.id,
        valid
    }
}
