import integers from "std:integer"
import { max_u32 } from "core/const"

import needed from "../../../state/ownership/needed"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { facts, type_id, borrowed } = in

    const first = integers.widen(facts.types.first[integers.widen(type_id)])

    return loop({
        index: 0,
        required: false
    }, {
        while: state => !state.required && state.index < borrowed.length,
        next: state => {
            if (borrowed[state.index]) {
                state.required = needed({
                    facts,
                    node: max_u32,
                    type_id: facts.types.field_types[first + state.index],
                    slot: 0
                })
            }

            state.index += 1
        },
        return: state => state.required
    })
}
