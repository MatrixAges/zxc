import bytes from "std:bytes"
import integers from "std:integer"
import { max_u32 } from "core/const"

import header from "../../../../ast/expressions/header"
import { ExpressionsKind } from "../../../../printer/model/expressions"

import type { Read as Input, Prepared as Output, Expressions } from "./model"

export default function (in: Input): Output {
    const source = in.source
    const types = source.facts.types
    const first = integers.widen(types.first[integers.widen(source.type_id)])
    const origin = source.origin
    const values: u32[] = []

    const expressions: Expressions = {
        tags: [],
        offsets: [],
        field_target: [],
        field_name: []
    }

    return loop({
        expressions,
        values,
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.slots.length,
        next: state => {
            const name = bytes.fromText(types.field_names[first + state.index])

            const value = header({
                ...state.expressions.pick([
                    "tags",
                    "offsets"
                ]),
                base: source.expression_base,
                kind: ExpressionsKind.Field,
                offset: state.index
            })

            state.expressions = {
                tags: value.tags,
                offsets: value.offsets,
                field_target: state.expressions.field_target.push(source.value)[0],
                field_name: state.expressions.field_name.push(name)[0]
            }
            state.values = state.values.push(value.id)[0]
            state.valid = value.valid
            state.index += 1
        },
        return: state => ({
            ...state.omit(["index"]),
            slots: in.slots,
            origin: origin == null ? max_u32 : origin
        })
    })
}
