import bytes from "std:bytes"
import integers from "std:integer"

import append from "../../../../ast/fields/append"
import field from "./field"
import { Mode } from "./model"
import wrap from "./wrap"

import type { State as Input, State as Output, Node } from "./model"

export default function (in: Input): Output {
    const source = in.source
    const index = integers.widen(source.type_id)
    const first = integers.widen(source.types.first[index])
    const count = integers.widen(source.types.second[index])

    return loop({
        state: in,
        index: 0
    }, {
        while: current => current.index < count,
        next: current => {
            const name =
                bytes.fromText(source.types.field_names[first + current.index])

            const value: Node = match {
                source.mode == Mode.Rebuild => {
                    state: current.state,
                    id: source.values[current.index]
                },
                _ => wrap({
                    node: field({
                        state: current.state,
                        target: source.value,
                        name
                    }),
                    borrowed: source.borrowed[current.index]
                })
            }

            current.state = {
                ...value.state,
                fields: append({
                    table: value.state.fields,
                    name,
                    value: value.id,
                    default_value: null,
                    comptime_parameter: false
                })
            }

            current.index += 1
        },
        return: current => current.state
    })
}
