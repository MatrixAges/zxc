import integers from "std:integer"
import decode from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Facts as Source } from "./model"

export type Input = {
    source: Source,
    path: u32[]
}

export type Output = bool

export default function (in: Input): Output {
    const selected = in.source.selected
    const referenced = in.source.referenced

    return loop({
        type_id: integers.widen(in.source.state_type),
        index: 0,
        valid: true,
        active: true
    }, {
        while: state => state.valid && state.active,
        next: state => {
            const types = in.source.types
            const kind = decode(types.kinds[state.type_id])

            if (kind == Kind.Optional) {
                state.type_id = integers.widen(types.first[state.type_id])
            } else if (state.index == in.path.length) {
                state.valid = kind == Kind.List && in.source
                    .selected[state.type_id]
                state.active = false
            } else {
                const condition = (
                    - kind == Kind.Object
                    - or kind == Kind.Tuple
                    - and selected[state.type_id]
                    - and !referenced[state.type_id]
                )

                if (condition) {
                    const step = integers.widen(in.path[state.index])
                    const first = integers.widen(types.first[state.type_id])

                    state.valid = step < integers.widen(types.second[state.type_id])

                    if (state.valid) {
                        state.type_id = integers.widen(
                            match {
                                kind == Kind.Object => types.field_types[first + step],
                                _ => types.children[first + step]
                            }
                        )
                        state.index += 1
                    }
                } else {
                    state.valid = false
                }
            }
        },
        return: state => state.valid
    })
}
