import integers from "std:integer"
import decode from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Input as Source } from "./model"

export type Input = {
    source: Source,
    path: u32[]
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        type_id: integers.widen(in.source.state_type),
        index: 0,
        valid: true,
        active: true
    }, {
        while: state => state.valid && state.active,
        next: (state, source) => {
            const types = source.source.types
            const kind = decode(types.kinds[state.type_id])

            if (kind == Kind.Optional) {
                state.type_id = integers.widen(types.first[state.type_id])
            } else if (state.index == source.path.length) {
                state.valid = kind == Kind.List && source.source
                    .selected[state.type_id]
                state.active = false
            } else if (
                (kind == Kind.Object || kind == Kind.Tuple) &&
                    source.source.selected[state.type_id] &&
                    !source.source.referenced[state.type_id]
            ) {
                const step = integers.widen(source.path[state.index])
                const first = integers.widen(types.first[state.type_id])

                state.valid = step < integers.widen(types.second[state.type_id])

                if (state.valid) {
                    state.type_id = integers.widen(
                        kind == Kind.Object ?
                            types.field_types[first + step] :
                            types.children[first + step]
                    )
                    state.index += 1
                }
            } else {
                state.valid = false
            }
        },
        return: state => state.valid
    }, in)
}
