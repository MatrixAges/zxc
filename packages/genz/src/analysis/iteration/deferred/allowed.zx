import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Input as Source } from "./model"

export type Input = {
    source: Source,
    id: u64
}

export type Output = bool

export default function (in: Input): Output {
    const kind = in.source.expressions.kinds[in.id]

    if (kind == ExpressionKind.ListUpdate) {
        const target = integers.widen(in.source.expressions.payloads[in.id])
            -> integers.widen(in.source.expressions.update_targets[_])

        return integers.widen(in.source.expressions.types[target])
            -> in.source.selected[_]
    }

    return match kind {
        ExpressionKind.Integer => true,
        ExpressionKind.NegativeInteger => true,
        ExpressionKind.Float => true,
        ExpressionKind.String => true,
        ExpressionKind.Boolean => true,
        ExpressionKind.None => true,
        ExpressionKind.Unit => true,
        ExpressionKind.Some => true,
        ExpressionKind.OptionalValue => true,
        ExpressionKind.EnumValue => true,
        ExpressionKind.ErrorValue => true,
        ExpressionKind.Reference => true,
        ExpressionKind.Field => true,
        ExpressionKind.Index => true,
        ExpressionKind.Length => true,
        ExpressionKind.List => true,
        ExpressionKind.Tuple => true,
        ExpressionKind.TupleField => true,
        ExpressionKind.Template => true,
        ExpressionKind.Scope => true,
        ExpressionKind.Unary => true,
        ExpressionKind.Binary => true,
        ExpressionKind.Conditional => true,
        ExpressionKind.Match => true,
        ExpressionKind.Object => true,
        _ => false
    }
}
