import buffered from "../../growth/renew/buffered"
import path from "./path"

import type { Schedule as Input, Output } from "./model"

export default function (in: Input): Output {
    const skipped: u64[] = []

    return loop({
        index: in.range.first,
        delayed: false,
        skipped
    }, {
        while: state => state.index < in.range.end,
        next: state => {
            const selected = in.paths[state.index]
            const delay = in.classify && path({
                source: in.facts,
                path: selected
            })

            const skip = delay || buffered({
                types: in.facts.types,
                type_id: in.facts.state_type,
                path: selected,
                inline_lists: in.inline_lists
            })

            if (skip) {
                state.skipped = state.skipped.push(state.index - in.range.first)[0]
            }

            state.delayed = state.delayed || delay
            state.index += 1
        },
        return: state => ({
            ...in.range,
            delayed: state.delayed,
            skipped: state.skipped
        })
    })
}
