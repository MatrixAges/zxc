import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"
import type { Renewals } from "../../uniqueness/renewals/model"
import type { Output as Range } from "../../uniqueness/renewals/range"

export type Facts = {
    expressions: Expressions,
    types: Table,
    selected: bool[],
    referenced: bool[],
    roots: u32[],
    state_type: u32,
}

export type Input = {
    facts: Facts,
    records: Renewals,
    owner: u32,
    classify: bool,
    inline_lists: bool
}

export type Schedule = {
    facts: Facts,
    paths: u32[][],
    range: Range,
    classify: bool,
    inline_lists: bool
}

export type Output = {
    first: u64,
    end: u64,
    delayed: bool,
    skipped: u64[]
}
