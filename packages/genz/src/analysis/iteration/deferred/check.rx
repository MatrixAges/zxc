<Module>
    <Type from="model" as="Deferred" />

    <Args in={Deferred.Input} out={Deferred.Output} />

    <Call
        fn="select"
        in={$in.pick([
            "records",
            "owner"
        ])}
    />

    <If on={$ctx.select.length == 0}>
        <Return
            value={{
                entries: false,
                delayed: false,
                immediate: []
            }}
        />
    </If>

    <If on={$in.classify}>
        <Call fn="eligible" in={$in.facts} />

        <Call
            fn="schedule"
            in={{
                facts: $in.facts,
                paths: $ctx.select,
                classify: $ctx.eligible,
                inline_lists: $in.inline_lists
            }}
        />

        <Return value={$ctx.schedule} />
    </If>

    <Call
        fn="schedule"
        in={{
            facts: $in.facts,
            paths: $ctx.select,
            classify: false,
            inline_lists: $in.inline_lists
        }}
    />

    <Return value={$ctx.schedule} />
</Module>
