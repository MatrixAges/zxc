<Module>
    <Type from="model" as="Deferred" />

    <Args in={Deferred.Input} out={Deferred.Output} />

    <Call
        fn="../../uniqueness/renewals/range"
        in={{
            keys: $in.records.keys,
            owner: $in.owner,
            value: false
        }}
    />

    <If
        on={$ctx.range.first == $ctx.range.end ||
            (!$in.classify && !$in.inline_lists)}
    >
        <Return
            value={{
                ...$ctx.range,
                delayed: false,
                skipped: []
            }}
        />
    </If>

    <If on={$in.classify}>
        <Call fn="eligible" in={$in.facts} />

        <Call
            fn="schedule"
            in={{
                facts: $in.facts,
                paths: $in.records.paths,
                range: $ctx.range,
                classify: $ctx.eligible,
                inline_lists: $in.inline_lists
            }}
        />

        <Return value={$ctx.schedule} />
    </If>

    <Call
        fn="schedule"
        in={{
            facts: $in.facts,
            paths: $in.records.paths,
            range: $ctx.range,
            classify: false,
            inline_lists: $in.inline_lists
        }}
    />

    <Return value={$ctx.schedule} />
</Module>
