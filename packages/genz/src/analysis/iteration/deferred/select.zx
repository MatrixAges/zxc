import type { Selection as Input } from "./model"

export type Output = u32[][]

export default function (in: Input): Output {
    const paths: Output = []

    return loop({
        paths,
        index: 0
    }, {
        while: state => state.index < in.records.length,
        next: state => {
            const record = in.records[state.index]

            if (record.owner == in.owner && !record.value) {
                state.paths = state.paths.push(record.path)[0]
            }

            state.index += 1
        },
        return: state => state.paths
    })
}
