import type { Table } from "core/type_table/model"
import type { ExpressionsKind } from "../../../printer/model/expressions"
import type { StatementsKind } from "../../../printer/model/statements"
import type { Output as Name } from "../../types/state/origin"

export type Facts = {
    types: Table,
    selected: bool[]
}

export type Input = {
    facts: Facts,
    active: bool,
    type_id: u32,
    target: u32,
    value: u32,
    base: u32,
    serial: u64
}

export type Expressions = {
    tags: ExpressionsKind[],
    offsets: u32[],
    identifier: u8[][],
    field_target: u32[],
    field_name: u8[][]
}

export type Snapshots = {
    tags: StatementsKind[],
    offsets: u32[],
    constant_name: u8[][],
    constant_type_expr: u32?[],
    constant_value: u32[],
    constant_exported: bool[]
}

export type Assignments = {
    tags: StatementsKind[],
    offsets: u32[],
    assignment_target: u32[],
    assignment_value: u32[]
}

export type State = {
    expressions: Expressions,
    snapshots: Snapshots,
    assignments: Assignments,
    field_name_source: u64?[],
    serial: u64,
    base: u32,
    valid: bool
}

export type Prepared = {
    source: Input,
    state: State,
    split: bool
}

export type Step = {
    source: Facts,
    state: State,
    type_id: u32,
    target: u32,
    value: u32
}

export type Field = {
    state: State,
    target: u32,
    value: u32,
    name: Name
}

export type Pair = {
    state: State,
    target: u32,
    value: u32
}

export type Snapshot = {
    state: State,
    value: u32
}

export type Bound = {
    state: State,
    id: u32
}

export type Output = State
