import { StatementsKind } from "../../../printer/model/statements"

import type { Prepared as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        ...in.state,
        assignments: {
            tags: [StatementsKind.Assignment],
            offsets: [0],
            assignment_target: [in.source.target],
            assignment_value: [in.source.value]
        }
    }
}
