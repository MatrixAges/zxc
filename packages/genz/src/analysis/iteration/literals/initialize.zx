import initialize from "../../../ast/context/initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        source: in,
        context: initialize(in.bases),
        statements: {
            tags: [],
            offsets: [],
            constant_name: [],
            constant_type_expr: [],
            constant_value: [],
            constant_exported: [],
            discard: []
        },
        fields: {
            name: [],
            value: []
        },
        root: 0
    }
}
