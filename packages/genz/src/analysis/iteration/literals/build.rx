<Module>
    <Type from="model" as="Literal" />

    <Args in={Literal.Input} out={Literal.Output} />

    <Call module="emit" in={$in} />

    <If on={!$ctx.emit.valid}>
        <Return
            value={{
                literal: $ctx.emit,
                block: null
            }}
        />
    </If>

    <Call
        fn="block_input"
        in={{
            bases: $in.bases,
            literal: $ctx.emit
        }}
    />

    <Call fn="../../aggregate/binding/finish" in={$ctx.block_input} />

    <Return
        value={{
            literal: $ctx.emit,
            block: $ctx.finish
        }}
    />
</Module>
