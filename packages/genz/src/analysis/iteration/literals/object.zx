import bytes from "std:bytes"
import integers from "std:integer"

import object from "../../../ast/context/object"
import append from "../../../ast/fields/append"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const source = in.source
    const first = integers.widen(source.types.first[integers.widen(source.type_id)])

    const fields = loop({
        fields: in.fields,
        index: 0
    }, {
        while: current => current.index < source.field_values.length,
        next: current => {
            const index = current.index
            const position = first + integers.widen(source.field_indices[index])

            current.fields = append({
                table: current.fields,
                name: bytes.fromText(source.types.field_names[position]),
                value: source.field_values[index],
                default_value: null,
                comptime_parameter: false
            })

            current.index += 1
        },
        return: current => current.fields
    })

    const value = object({
        state: in.context,
        type_expr: source.layout,
        first: source.bases.field_base,
        count: integers.narrow(fields.name.length)
    })

    return {
        ...in,
        context: value.state,
        fields,
        root: value.id
    }
}
