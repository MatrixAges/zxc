import integers from "std:integer"

import object from "../../../ast/context/object"
import select from "../../aggregate/object/fields"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const source = in.source

    const fields = select({
        names: source.types.field_names,
        first: source.types.first[integers.widen(source.type_id)],
        indices: source.field_indices,
        values: source.field_values
    })

    const value = object({
        state: in.context,
        type_expr: source.layout,
        first: source.bases.field_base,
        count: integers.narrow(fields.name.length)
    })

    return {
        ...in,
        context: value.state,
        fields,
        root: value.id
    }
}
