import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import allowed from "./boundary/allowed"
import fresh from "./fresh"

import type { Input } from "./model"

export type Output = {
    valid: bool,
    allowed: bool[]
}

export default function (in: Input): Output {
    if (in.boundary == null) {
        return {
            valid: true,
            allowed: in.allowed
        }
    }

    const boundary = in.boundary
    const target = kind(in.types.kinds[integers.widen(boundary.type_id)])

    const product = target == Kind.Object || target == Kind.Tuple

    if (!product || !fresh({
        table: in.expressions,
        id: boundary.result
    })) {
        return {
            valid: false,
            allowed: []
        }
    }

    const functions = in.function_inputs.map((input, index) => allowed({
        source: in,
        boundary: boundary.type_id,
        input,
        index
    }))[0]

    return {
        valid: true,
        allowed: functions
    }
}
