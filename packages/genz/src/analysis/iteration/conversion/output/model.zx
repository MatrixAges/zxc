import type { Columns as Statements } from "../../../../ast/statements/model"
import type { Ast } from "../../../construction/model"
import type {
    Input as Conversion,
    State as Emission,
    Output as Result
} from "../emit/model"
import type { Input as PlanInput, Plan } from "../model"

export enum Requirement {
    Layout,
    OptionalType,
    HeapType,
    ReferenceLayout,
    Value,
    Unsupported
}

export type Facts = {
    active: bool,
    selected: bool[],
    borrowed: bool[]
}

export type Prepare = {
    source: PlanInput,
    facts: Facts
}

export type Prepared = {
    plan: Plan,
    requirements: Requirement[]
}

export type Input = {
    source: Conversion,
    requirements: Requirement[],
    ast: Ast,
    operands: u32[]
}

export type State = {
    emitted: Emission,
    storage: Statements
}

export type Step = {
    source: Input,
    state: State,
    node: u64
}

export type Output = {
    result: Result,
    storage: Statements
}
