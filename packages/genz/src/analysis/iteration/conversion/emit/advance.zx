import integers from "std:integer"

import { Operation } from "../model"
import aggregate from "./aggregate"
import buffer from "./buffer/finish"
import enter from "./enter"
import optional from "./optional"

import type { Input as Source, State } from "./model"

export type Input = {
    source: Source,
    state: State
}

export type Output = State

export default function (in: Input): Output {
    const node = integers.widen(in.source.plan.events[in.state.index])

    const step = {
        ...in,
        node
    }

    const state = match {
        in.source.plan.entering[in.state.index] => enter(step),
        _ => match in.source.plan.kinds[node] {
            Operation.Optional => optional(step),
            Operation.Object => aggregate(step),
            Operation.Tuple => aggregate(step),
            Operation.Buffer => buffer(step),
            _ => in.state
        }
    }

    return {
        ...state,
        index: state.index + 1
    }
}
