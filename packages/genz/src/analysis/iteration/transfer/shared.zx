import binary from "../../../ast/context/binary"
import boolean from "../../../ast/context/boolean"
import conditional from "../../../ast/context/conditional"
import { ExpressionsBinaryOperator } from "../../../printer/model/expressions"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const initial = boolean({
        state: in.context,
        value: false
    })

    return loop({
        state: {
            ...in,
            context: initial.state,
            values: {
                ...in.values,
                shared: initial.id
            }
        },
        index: 0
    }, {
        while: current => current.index < in.source.history.types.length,
        next: current => {
            const index = current.index

            if (in.source.history.types[index] == in.source.type_id) {
                const state = current.state
                const equal = binary({
                    state: state.context,
                    operator: ExpressionsBinaryOperator.Equal,
                    left: state.values.owner,
                    right: in.source.history.owners[index]
                })
                const same = binary({
                    state: equal.state,
                    operator: ExpressionsBinaryOperator.LogicalAnd,
                    left: in.source.history.ready[index],
                    right: equal.id
                })
                const shared = binary({
                    state: same.state,
                    operator: ExpressionsBinaryOperator.LogicalOr,
                    left: state.values.shared,
                    right: same.id
                })
                const chosen = conditional({
                    state: shared.state,
                    condition: same.id,
                    yes: in.source.history.values[index],
                    no: state.values.chosen
                })

                current.state = {
                    ...state,
                    context: chosen.state,
                    values: {
                        ...state.values,
                        shared: shared.id,
                        chosen: chosen.id
                    }
                }
            }

            current.index += 1
        },
        return: current => current.state
    })
}
