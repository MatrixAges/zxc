import type { Append as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const { state, type_id, owner, value, ready } = in

    return {
        types: state.types.push(type_id)[0],
        owners: state.owners.push(owner)[0],
        values: state.values.push(value)[0],
        ready: state.ready.push(ready)[0]
    }
}
