import initialize from "../../../ast/context/initialize"

import type { Input, Compare as Output } from "./model"

export default function (in: Input): Output {
    return {
        ...in.pick([
            "types",
            "type_id",
            "left",
            "right"
        ]),
        context: initialize({
            ...in.pick([
                "expression_base",
                "statement_base",
                "serial"
            ]),
            field_base: 0
        })
    }
}
