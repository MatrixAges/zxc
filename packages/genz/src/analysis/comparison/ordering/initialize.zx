import bytes from "std:bytes"
import { scalar_f32, scalar_f64 } from "core/type_table/const"

import identifier from "../../../ast/context/identifier"
import initialize from "../../../ast/context/initialize"
import { StatementsKind } from "../../../printer/model/statements"
import { context_name, left_name, right_name } from "../const"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const context = initialize({
        ...in.pick([
            "expression_base",
            "statement_base"
        ]),
        field_base: 0,
        serial: 0
    })

    const left = identifier({
        state: context,
        name: bytes.fromText(left_name)
    })

    const right = identifier({
        state: left.state,
        name: bytes.fromText(right_name)
    })

    const discarded = identifier({
        state: right.state,
        name: bytes.fromText(context_name)
    })

    const scalar = in.naming.scalar

    return {
        source: in,
        context: discarded.state,
        body: {
            tags: [StatementsKind.Discard],
            offsets: [0]
        },
        left: left.id,
        right: right.id,
        discard: [discarded.id],
        floating: scalar == scalar_f32 || scalar == scalar_f64
    }
}
