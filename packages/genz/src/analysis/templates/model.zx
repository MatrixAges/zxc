import type { Table } from "core/type_table/model"
import type { State as Context, Variables } from "../../ast/context/model"
import type { Capture } from "../../ast/expressions/fallible"
import type { Columns as Forms } from "../../ast/expressions/forms/model"
import type { Columns as Expressions } from "../../ast/expressions/model"
import type { Columns as Statements } from "../../ast/statements/model"

export type Input = {
    types: Table,
    expression_types: u32[],
    items: u32[],
    values: u32[],
    capture?: Capture,
    expression_base: u32,
    statement_base: u32,
    field_base: u32,
    serial: u64
}

export type State = {
    source: Input,
    context: Context,
    strings: u32[]
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    statements: Statements,
    variables: Variables,
    root: u32,
    serial: u64,
    valid: bool,
    uses_allocator: bool
}
