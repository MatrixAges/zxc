import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import lookup from "core/integer/map/lookup"

import { Property } from "../../state/queries/model"
import query from "../../state/queries/read"
import {
    no_flags,
    normalize_flag,
    renew_flag
} from "../../uniqueness/function/plan/const"
import { Route } from "./model"

import type { Input as Source } from "./model"

export type Input = {
    source: Source,
    id: u32
}

export type Output = Route

export default function (in: Input): Output {
    const { source, id } = in

    const row = integers.widen(id)

    const flags = match {
        row < source.flags.length => integers.widenByte(source.flags[row]),
        _ => no_flags
    }

    if (integers.andBits(flags, normalize_flag + renew_flag) != 0) {
        return Route.None
    }

    if (!query({
        value: source.queries[integers.widen(source.types[row])],
        property: Property.Represented
    })) {
        return Route.Anchor
    }

    const selected = match source.kinds[row] {
        ExpressionKind.Field => Route.Field,
        ExpressionKind.Index => Route.Index,
        _ => Route.None
    }

    if (selected == Route.None) {
        return Route.None
    }

    const cached = lookup({
        ...source.cache.omit(["values"]),
        key: id
    })

    return cached == null ? selected : Route.None
}
