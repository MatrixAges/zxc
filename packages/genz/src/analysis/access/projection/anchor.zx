import { ExpressionKind } from "core/expression_table/kinds"

export type Input = {
    kind: ExpressionKind,
    value_function: bool
}

export type Output = bool

export default function (in: Input): Output {
    return match in.kind {
        ExpressionKind.Scope => true,
        ExpressionKind.Iteration => true,
        ExpressionKind.ListOperation => true,
        ExpressionKind.Call => in.value_function,
        _ => false
    }
}
