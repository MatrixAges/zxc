import { map } from "std:utils"

import uses from "./uses"

import type { Functions } from "../model"

export type Input = Functions

export type Output = bool[]

export default function (in: Input): Output {
    const required = map(in.output_types, id => false)

    const result = loop({
        functions: in,
        required,
        index: 0
    }, {
        while: current => current.index < current.functions.output_types.length,
        next: current => {
            const index = current.index

            current.required[index] =
                current.functions.native_modules[index] !=
                null ? current.functions.native_process[index] : uses({
                    expressions: current.functions.expressions[index],
                    contracts: current.functions.contracts[index],
                    required: current.required,
                    self_function: index,
                    limit: index,
                    tasks: false
                })
            current.index += 1
        }
    })

    return result.required
}
