import uses from "./uses"

import type { Program } from "../model"

export type Input = Program

export type Output = bool[]

export default function (in: Input): Output {
    const required = in.functions.output_types.map(id => false)

    const result = loop({ functions: in.functions, required: required, index: 0 }, {
        while: current => current.index < current.functions.output_types.length,
        next: current => {
            const index = current.index

            current.required[index] = current.functions.native_modules[index] != null ? current.functions.native_io[index] : uses({ expressions: current.functions.expressions[index], contracts: current.functions.contracts[index], required: current.required, limit: index, tasks: true })
            current.index += 1
        }
    })

    return result.required
}
