import expressions from "../calls/expressions"

import type { Program } from "../model"

export type Input = Program

export type Output = bool[]

export default function (in: Input): Output {
    const required = in.functions.output_types.map(id => false)[0]

    return loop({
        functions: in.functions,
        required,
        index: 0
    }, {
        while: current => current.index < current.functions.output_types.length,
        next: current => {
            const index = current.index

            current.required[index] = !expressions({
                expressions: current.functions.expressions[index],
                allowed: current.required,
                expected: false,
                self_function: index,
                limit: index,
                tasks: true
            })
            current.index += 1
        },
        return: state => state.required
    })
}
