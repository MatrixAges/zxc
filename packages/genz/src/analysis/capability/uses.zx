import expressions from "../calls/expressions"

import type { Contracts } from "core/contract_table/model"
import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    contracts: Contracts,
    required: bool[],
    self_function?: u64,
    limit: u64,
    tasks: bool
}

export type Output = bool

export default function (in: Input): Output {
    if (!expressions({
        expressions: in.expressions,
        allowed: in.required,
        expected: false,
        self_function: in.self_function,
        limit: in.limit,
        tasks: in.tasks
    })) {
        return true
    }

    const result = loop({
        contracts: in.contracts,
        required: in.required,
        self_function: in.self_function,
        limit: in.limit,
        index: 0,
        found: false
    }, {
        while: current =>
            !current.found && current.index < current.contracts.expressions.length,
        next: current => {
            current.found = !expressions({
                expressions: current.contracts.expressions[current.index],
                allowed: current.required,
                expected: false,
                self_function: current.self_function,
                limit: current.limit,
                tasks: false
            })
            current.index += 1
        }
    })

    return result.found
}
