import body from "./body"

import type { Functions } from "../../model"

export type Input = Functions

export type Output = bool[]

export default function (in: Input): Output {
    const grows: bool[] = []

    return loop({
        grows,
        index: 0
    }, {
        while: (state, source) => state.index < source.output_types.length,
        next: (state, source) => {
            state.grows = state.grows.push(
                source.native_modules[state.index] != null ||
                    source.roots[state.index] == null || body({
                    expressions: source.expressions[state.index],
                    grows: state.grows
                })
            )[0]
            state.index += 1
        }
    }, in).grows
}
