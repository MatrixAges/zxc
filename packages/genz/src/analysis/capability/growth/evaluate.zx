import body from "./body"

import type { Functions } from "../../model"

export type Input = Functions

export type Output = bool[]

export default function (in: Input): Output {
    const grows: bool[] = []

    return loop({
        grows,
        index: 0
    }, {
        while: state => state.index < in.output_types.length,
        next: state => {
            state.grows = state.grows.push(
                in.native_modules[state.index] != null ||
                    in.roots[state.index] == null || body({
                        expressions: in.expressions[state.index],
                        grows: state.grows
                    })
            )[0]
            state.index += 1
        },
        return: state => state.grows
    })
}
