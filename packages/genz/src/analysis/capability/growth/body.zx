import integers from "std:integer"
import { CollectionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    grows: bool[]
}

export type Output = bool

export default function (in: Input): Output {
    const condition = in.expressions.collection_kinds.some(
        operation =>
            operation == CollectionKind.Push || operation == CollectionKind.Concat ||
            operation == CollectionKind.Splice
    )

    const condition_2 = in.expressions.call_functions.some(
        callee =>
            integers.widen(callee) >= in.grows.length ||
            in.grows[integers.widen(callee)]
    )

    const different_task_bodies = in.expressions.task_bodies.length != 0
    const different_parallel_count = in.expressions.parallel_count.length != 0

    return (
        - condition
        - or condition_2
        - or different_task_bodies
        - or different_parallel_count
    )
}
