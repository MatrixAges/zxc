import integers from "std:integer"
import { CollectionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    grows: bool[]
}

export type Output = bool

export default function (in: Input): Output {
    return in.expressions.collection_kinds.some(
        operation =>
            operation == CollectionKind.Push || operation == CollectionKind.Concat ||
            operation == CollectionKind.Splice
    ) || in.expressions.call_functions.some(
        callee =>
            integers.widen(callee) >= in.grows.length ||
            in.grows[integers.widen(callee)]
    ) || in.expressions.task_bodies.length != 0 ||
        in.expressions.parallel_count.length != 0
}
