import bytes from "std:bytes"
import integers from "std:integer"

import builtin from "../../ast/context/builtin"
import pointer from "../../ast/context/pointer"
import result from "../../ast/context/result"
import standardField from "../../ast/context/standard_field"
import appendFunction from "../../ast/declarations/append_function"
import appendField from "../../ast/fields/append"
import { ExpressionsBuiltinName } from "../../printer/model/expressions"
import { allocator_name } from "../construction/const"
import { memory_name, allocator_type_name } from "../functions/signature/const"
import { self_name } from "../store/adapter/const"

import type { Node as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const this_type = builtin({
        state: in.state.context,
        name: ExpressionsBuiltinName.This,
        arguments: []
    })

    const self = pointer({
        state: this_type.state,
        value: this_type.id
    })

    const fields = appendField({
        table: in.state.fields,
        name: bytes.fromText(self_name),
        value: self.id,
        default_value: null,
        comptime_parameter: false
    })

    const type_node = standardField({
        state: self.state,
        path: [
            memory_name,
            allocator_type_name
        ]
    })

    const body = integers.narrow(
        integers.widen(in.state.source.bases.statement_base) +
            type_node.state.statements.tags.length
    )

    const context = result({
        state: type_node.state,
        value: in.id
    })

    const declaration = appendFunction({
        table: in.state.declarations,
        value: {
            base: integers.narrow(
                integers.widen(in.state.source.declaration_base) +
                    in.state.declarations.tags.length
            ),
            name: bytes.fromText(allocator_name),
            parameters_start: integers.narrow(
                integers.widen(in.state.source.bases.field_base) +
                    in.state.fields.name.length
            ),
            parameters_count: 1,
            return_type: type_node.id,
            body_start: body,
            body_count: 1,
            exported: false,
            abi_export: false,
            inlined: false,
            calling_convention: null
        }
    })

    return {
        ...in.state,
        context: {
            ...context,
            valid: context.valid && declaration.valid
        },
        fields,
        declarations: declaration.table
    }
}
