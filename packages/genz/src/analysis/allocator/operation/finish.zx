import bytes from "std:bytes"
import integers from "std:integer"

import append from "../../../ast/declarations/append_function"
import returnType from "./return_type"

import type { State as Output } from "../model"
import type { Called as Input } from "./model"

export default function (in: Input): Output {
    const result = returnType(in)
    const state = result.state

    const declaration = append({
        table: state.declarations,
        value: {
            base: integers.narrow(
                integers.widen(state.source.declaration_base) +
                    state.declarations.tags.length
            ),
            name: bytes.fromText(in.prepared.spec.name),
            parameters_start: in.prepared.first,
            parameters_count: in.prepared.count,
            return_type: result.id,
            body_start: integers.narrow(
                integers.widen(
                    state.source.bases.statement_base
                ) + in.body_first
            ),
            body_count: integers.narrow(
                state.context.statements.tags.length - in.body_first
            ),
            exported: false,
            abi_export: false,
            inlined: false,
            calling_convention: null
        }
    })

    return {
        ...state,
        context: {
            ...state.context,
            valid: state.context.valid && declaration.valid
        },
        declarations: declaration.table
    }
}
