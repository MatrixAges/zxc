<Module>
    <Type from="model" as="Operation" />
    <Type from="../model" as="Allocator" />

    <Args in={Operation.Input} out={Allocator.State} />

    <Call fn="parameters" in={$in} />
    <Call fn="call" in={$ctx.parameters} />
    <Call fn="cast" in={$ctx.call} />
    <Call fn="locks" in={$ctx.cast} />
    <Call fn="body" in={$ctx.locks} />
    <Call fn="finish" in={$ctx.body} />

    <Return value={$ctx.finish} />
</Module>
