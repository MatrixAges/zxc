import bytes from "std:bytes"
import integers from "std:integer"

import call from "../../../ast/context/call"
import field from "../../../ast/context/field"
import identifier from "../../../ast/context/identifier"
import { child_name, mutex_name } from "../../functions/prelude/const"
import { io_name } from "../../functions/signature/const"
import { self_name } from "../../store/adapter/const"

import type { Prepared as Input, Called as Output } from "./model"

export default function (in: Input): Output {
    const arguments: u32[] = []
    const first = integers.widen(in.first - in.state.source.bases.field_base)

    const parameters = loop({
        context: in.state.context,
        arguments,
        index: 1
    }, {
        while: current => current.index < integers.widen(in.count),
        next: current => {
            const value = identifier({
                state: current.context,
                name: in.state.fields.name[first + current.index]
            })

            current.context = value.state
            current.arguments = current.arguments.push(value.id)[0]
            current.index += 1
        }
    })

    const self = identifier({
        state: parameters.context,
        name: bytes.fromText(self_name)
    })

    const io = field({
        state: self.state,
        target: self.id,
        name: bytes.fromText(io_name)
    })

    const mutex = field({
        state: io.state,
        target: self.id,
        name: bytes.fromText(mutex_name)
    })

    const child = field({
        state: mutex.state,
        target: self.id,
        name: bytes.fromText(child_name)
    })

    const callee = field({
        state: child.state,
        target: child.id,
        name: bytes.fromText(in.spec.raw_name)
    })

    const raw = call({
        state: callee.state,
        callee: callee.id,
        arguments: parameters.arguments,
        fallible: false
    })

    return {
        prepared: {
            ...in,
            state: {
                ...in.state,
                context: raw.state
            }
        },
        raw: raw.id,
        io: io.id,
        mutex: mutex.id,
        body_first: raw.state.statements.tags.length
    }
}
