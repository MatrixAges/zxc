import bytes from "std:bytes"
import integers from "std:integer"

import initialize from "../../ast/context/initialize"
import standardField from "../../ast/context/standard_field"
import text from "../../ast/context/text"
import emptyFunctions from "../../ast/declarations/empty_functions"
import append from "../../ast/fields/append"
import emptyFields from "../../ast/fields/empty"
import { ExpressionsKind } from "../../printer/model/expressions"
import { child_name, mutex_name, init_name } from "../functions/prelude/const"
import {
    memory_name,
    allocator_type_name,
    io_name,
    io_type_name
} from "../functions/signature/const"
import parameter from "../functions/signature/parameter"
import { mutex_type_name } from "./const"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const child = parameter({
        state: {
            context: initialize(in.bases),
            fields: emptyFields({})
        },
        name: bytes.fromText(child_name),
        path: [
            memory_name,
            allocator_type_name
        ]
    })

    const io = match {
        in.with_io => parameter({
            state: child,
            name: bytes.fromText(io_name),
            path: [io_type_name]
        }),
        _ => child
    }

    const mutex = standardField({
        state: io.context,
        path: [
            io_type_name,
            mutex_type_name
        ]
    })

    const initial = text({
        state: mutex.state,
        kind: ExpressionsKind.EnumLiteral,
        value: bytes.fromText(init_name)
    })

    const fields = append({
        table: io.fields,
        name: bytes.fromText(mutex_name),
        value: mutex.id,
        default_value: initial.id,
        comptime_parameter: false
    })

    return {
        source: in,
        context: initial.state,
        fields,
        declarations: emptyFunctions({}),
        root_count: integers.narrow(fields.name.length),
        vtable_names: [],
        vtable_values: [],
        extra: {
            mutable_slice: [],
            many_pointer: [],
            optional_type: [],
            container_type_fields_start: [],
            container_type_fields_len: [],
            container_type_declarations_start: [],
            container_type_declarations_len: []
        }
    }
}
