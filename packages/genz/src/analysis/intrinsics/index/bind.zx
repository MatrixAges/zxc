import initialize from "../../../ast/context/initialize"
import operands from "./operands"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const context = initialize({
        capture: in.capture,
        expression_base: in.expression_base,
        statement_base: in.statement_base,
        field_base: 0,
        serial: in.serial
    })

    return operands({
        context,
        values: in.values,
        position: in.position
    })
}
