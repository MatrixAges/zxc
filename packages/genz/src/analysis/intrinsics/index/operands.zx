import bytes from "std:bytes"

import { operand_prefix } from "../../../ast/context/const"
import identifier from "../../../ast/context/identifier"
import fresh from "../../../ast/fresh"
import { bounds_error } from "./const"

import type { State as Context } from "../../../ast/context/model"
import type { State as Output } from "./model"

export type Input = {
    context: Context,
    values: u32,
    position: u32
}

export default function (in: Input): Output {
    const values_name = fresh({
        serial: in.context.serial,
        prefix: operand_prefix
    })

    const values = identifier({
        state: in.context,
        name: values_name.name
    })

    const position_name = fresh({
        serial: values_name.serial,
        prefix: operand_prefix
    })

    const position = identifier({
        state: values.state,
        name: position_name.name
    })

    return {
        source: {
            values: in.values,
            position: in.position,
            capture: in.context.source.capture,
            expression_base: in.context.source.expression_base,
            statement_base: in.context.source.statement_base,
            serial: in.context.serial
        },
        context: {
            ...position.state,
            serial: position_name.serial
        },
        values: values.id,
        position: position.id,
        values_name: values_name.name,
        position_name: position_name.name,
        condition: 0,
        error_name: bytes.fromText(bounds_error),
        failure_first: 0,
        failure_count: 0,
        root: 0
    }
}
