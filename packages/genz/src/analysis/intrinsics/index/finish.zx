import complete from "./complete"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const value = complete(in)

    return {
        expressions: value.state.expressions,
        forms: value.state.forms,
        statements: value.state.statements,
        root: value.id,
        serial: value.state.serial,
        valid: value.state.valid
    }
}
