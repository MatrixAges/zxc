export type Input = { items: u64[], length: u64 }

export type Output = u64[]

export default function (in: Input): Output {
    const result = loop({ items: in.items, length: in.length }, {
        while: current => current.items.length > current.length,
        next: current => { current.items = current.items.pop()[0] }
    })

    return result.items
}
