import { InlineOp } from "../model"

import type { Inline, Step } from "../model"

export type Input = Step

export type Output = Inline

export default function (in: Input): Output {
    const state = in.state

    return state.stack[state.stack.length - 1]
        -> {
            ...state,
            stack: state.stack.pop()[0],
            frames: state.frames.push({
                ...in.frame,
                op: InlineOp.LowerStep,
                b: _ + 1
            })[0]
        }
}
