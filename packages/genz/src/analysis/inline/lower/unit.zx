import empty from "core/expression_table/append/empty"

import append from "../append"

import type { Inline } from "../model"

export type Input = { state: Inline, type_id: u32, span_start: u64, span_end: u64 }

export type Output = { state: Inline, id: u32 }

export default function (in: Input): Output {
    const made = empty({ table: in.state.tables.expressions, metadata: { type_id: in.type_id, span_start: in.span_start, span_end: in.span_end }, optional: false })

    return { state: append({ state: { ...in.state, tables: { ...in.state.tables, expressions: made.table } }, id: made.id }), id: made.id }
}
