import integers from "std:integer"

import { InlineOp } from "../model"

import type { Inline, Step } from "../model"

export type Input = Step

export type Output = Inline

export default function (in: Input): Output {
    const state = in.state

    return state.units[state.mappings.units[in.frame.mapping]].control
        -> _.branch_no[in.frame.f]
        -> {
            ...in.frame,
            op: InlineOp.LowerStart,
            id: integers.widen(_) + 1,
            b: in.frame.i,
            c: in.frame.h
        }
        -> {
            ...state,
            frames: state.frames.concat([
                {
                    ...in.frame,
                    op: InlineOp.LowerNo
                },
                _
            ])[0]
        }
}
