import integers from "std:integer"

import returns from "../../control/returns"
import { InlineOp } from "../model"

import type { Inline, Step } from "../model"

export type Input = Step

export type Output = Inline

export default function (in: Input): Output {
    const state = in.state
    const control = state.units[state.mappings.units[in.frame.mapping]].control
    const payload = in.frame.f
    const yes = control.branch_yes[payload]
    const no = control.branch_no[payload]
    const continuing = !returns({ control: control, block: yes }) && !returns({ control: control, block: no })
    const branch_type = continuing ? integers.widen(state.void_type) : in.frame.c
    const tail = continuing ? 0 : in.frame.b
    const start = { ...in.frame, op: InlineOp.LowerStart, id: integers.widen(yes) + 1, b: tail, c: branch_type }

    return { ...state, frames: state.frames.concat([{ ...in.frame, op: InlineOp.LowerYes, g: continuing ? 1 : 0, h: branch_type, i: tail }, start])[0] }
}
