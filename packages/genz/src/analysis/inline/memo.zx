import type { Inline } from "./model"

export type Input = {
    state: Inline,
    mapping: u64,
    id: u64,
    value: u64
}

export type Output = Inline

export default function (in: Input): Output {
    return in.state.mappings.bases[in.mapping] + in.id
        -> {
            ...in.state,
            ids: in.state.ids.with(_, in.value + 1),
            stack: in.state.stack.push(in.value)[0]
        }
}
