import cost from "./selection/cost"
import find from "./selection/find"
import mark from "./selection/mark"
import walk from "./selection/walk"

import type { Table } from "core/type_table/model"
import type { Unit } from "../unit"

export type Input = {
    types: Table,
    unit: Unit,
    costs: u64[],
    limit: u64
}

export type Output = {
    selected: bool,
    marked: bool[]
}

export default function (in: Input): Output {
    const table = in.unit.expressions

    const walked = walk({
        types: in.types,
        table,
        control: in.unit.control,
        root: in.unit.root
    })

    const found = find({
        types: in.types,
        table,
        ...walked
    })

    const marked = mark({
        table,
        marks: found
    })

    const total = cost({
        table,
        marked,
        costs: in.costs,
        limit: in.limit
    })

    return {
        selected: total != 0 && total <= in.limit,
        marked
    }
}
