import type { InlineFrame, InlineOp } from "./model"

export type Input = { op: InlineOp, mapping: u64, id: u64 }

export type Output = InlineFrame

export default function (in: Input): Output {
    return { op: in.op, mapping: in.mapping, id: in.id, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0, i: 0, j: 0, k: 0, l: 0, m: 0, n: 0, start: 0 }
}
