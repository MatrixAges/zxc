import integers from "std:integer"

import children from "../../ir/children"
import append from "../append"
import memo from "../memo"
import truncate from "../truncate"
import copy from "./copy"
import mapped from "./mapped"

import type { Inline, Step } from "../model"

export type Input = Step

export type Output = Inline

export default function (in: Input): Output {
    const state = in.state
    const mapping = in.frame.mapping
    const source = state.units[state.mappings.units[mapping]].expressions

    const start = children({
        table: source,
        id: in.frame.id
    }).length
        -> state.stack.length - _

    const made = mapped({
        stack: state.stack,
        start
    })
        -> copy({
            target: state.tables.expressions,
            source,
            id: in.frame.id,
            mapped: _,
            offset: state.mappings.offsets[mapping]
        })

    return {
        ...state,
        tables: {
            ...state.tables,
            expressions: made.table
        },
        stack: truncate({
            items: state.stack,
            length: start
        }),
        depth: state.depth - 1
    }
        -> memo({
            state: append({
                state: _,
                id: made.id
            }),
            mapping,
            id: in.frame.id,
            value: integers.widen(made.id)
        })
}
