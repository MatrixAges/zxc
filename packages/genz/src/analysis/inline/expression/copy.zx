import integers from "std:integer"
import binary from "core/expression_table/append/binary"
import call from "core/expression_table/append/call"
import collection from "core/expression_table/append/collection"
import conditional from "core/expression_table/append/conditional"
import index from "core/expression_table/append/index"
import matched from "core/expression_table/append/match"
import { SequenceKind } from "core/expression_table/append/model"
import object from "core/expression_table/append/object"
import parallel from "core/expression_table/append/parallel"
import projection from "core/expression_table/append/projection"
import sequence from "core/expression_table/append/sequence"
import task from "core/expression_table/append/task"
import transform from "core/expression_table/append/transform"
import unary from "core/expression_table/append/unary"
import update from "core/expression_table/append/update"
import value from "core/expression_table/append/value"
import { ExpressionKind } from "core/expression_table/kinds"

import range from "../../ir/range"
import copyBindings from "./copy/bindings"
import copyLiteral from "./copy/literal"
import matchPayload from "./copy/match"
import objectPayload from "./copy/object"
import valuePayload from "./copy/value"
import optionalRange from "./optional_range"
import shiftedRange from "./shift_range"
import split from "./split"

import type { Result } from "core/expression_table/append/model"
import type { Expressions } from "core/expression_table/model"

export type Input = {
    target: Expressions,
    source: Expressions,
    id: u64,
    mapped: u32[],
    offset: u64
}

export type Output = Result

export default function (in: Input): Output {
    const source = in.source
    const id = in.id
    const kind = source.kinds[id]
    const payload = integers.widen(source.payloads[id])
    const mapped = in.mapped

    const metadata = {
        type_id: source.types[id],
        span_start: source.span_start[id],
        span_end: source.span_end[id]
    }

    const base = {
        table: in.target,
        metadata
    }

    const offset = in.offset
    const none: u32[] = []

    const literal = match kind {
        ExpressionKind.Integer => true,
        ExpressionKind.NegativeInteger => true,
        ExpressionKind.Float => true,
        ExpressionKind.String => true,
        ExpressionKind.Boolean => true,
        ExpressionKind.None => true,
        ExpressionKind.Unit => true,
        _ => false
    }

    if (literal) {
        return copyLiteral({
            ...base,
            kind,
            payload,
            integers: source.integers,
            negative_integers: source.negative_integers,
            floats: source.floats,
            strings: source.strings,
            booleans: source.booleans
        })
    }

    const selected = valuePayload({
        kind,
        payload,
        mapped,
        offset,
        enumerations: source.enumerations,
        errors: source.errors,
        references: source.references,
        stores: source.stores
    })

    if (selected.kind != null) {
        return value({
            ...base,
            ...selected,
            kind: selected.kind
        })
    }

    if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
        return projection({
            ...base,
            target: mapped[0],
            index: source.projection_indices[payload],
            tuple: kind == ExpressionKind.TupleField
        })
    }

    const sequence_kind: SequenceKind? = match kind {
        ExpressionKind.List => SequenceKind.List,
        ExpressionKind.Tuple => SequenceKind.Tuple,
        ExpressionKind.Template => SequenceKind.Template,
        _ => null
    }

    if (sequence_kind != null) {
        return sequence({
            ...base,
            kind: sequence_kind,
            values: mapped
        })
    }

    if (kind == ExpressionKind.Scope || kind == ExpressionKind.Iteration) {
        return copyBindings({
            ...base,
            source,
            kind,
            payload,
            mapped,
            offset
        })
    }

    return match kind {
        ExpressionKind.Task => task({
            ...base,
            body: mapped[0],
            captures: shiftedRange({
                items: source.task_captures,
                first: integers.widen(source.task_capture_first[payload]),
                count: integers.widen(source.task_capture_count[payload]),
                offset
            })
        }),
        ExpressionKind.Parallel => parallel({
            ...base,
            tasks: mapped,
            fields: optionalRange({
                items: source.parallel_fields,
                first: integers.widen(source.parallel_first[payload]),
                count: integers.widen(source.parallel_count[payload])
            })
        }),
        ExpressionKind.Index => index({
            ...base,
            target: mapped[0],
            index: mapped[1]
        }),
        ExpressionKind.ListOperation => collection({
            ...base,
            kind: source.collection_kinds[payload],
            target: mapped[0],
            arguments: split({
                items: mapped,
                from: 1
            })
        }),
        ExpressionKind.Transform => transform({
            ...base,
            kind: source.transform_kinds[payload],
            target: mapped[0],
            body: mapped[1],
            initial: mapped.length > 2 ? mapped[2] : null,
            parameters: shiftedRange({
                items: source.transform_parameters,
                first: integers.widen(source.transform_first[payload]),
                count: integers.widen(source.transform_count[payload]),
                offset
            })
        }),
        ExpressionKind.ListUpdate => update({
            ...base,
            target: mapped[0],
            index: mapped[1],
            value: mapped[2]
        }),
        ExpressionKind.Call => call({
            ...base,
            function_id: source.call_functions[payload],
            argument: mapped[0],
            stores: range({
                items: source.call_stores,
                first: integers.widen(source.call_store_first[payload]),
                count: integers.widen(source.call_store_count[payload]),
                prefix: none
            })
        }),
        ExpressionKind.Unary => unary({
            ...base,
            operator: source.unary_operators[payload],
            operand: mapped[0]
        }),
        ExpressionKind.Binary => binary({
            ...base,
            operator: source.binary_operators[payload],
            left: mapped[0],
            right: mapped[1]
        }),
        ExpressionKind.Conditional => conditional({
            ...base,
            condition: mapped[0],
            yes: mapped[1],
            no: mapped[2]
        }),
        ExpressionKind.Match => matched({
            ...base,
            ...matchPayload({
                mapped,
                has_subject: source.match_subjects[payload] != null
            })
        }),
        _ => object({
            ...base,
            ...objectPayload({
                count: integers.widen(source.object_count[payload]),
                indices: source.object_field_indices,
                first: integers.widen(source.object_first[payload]),
                mapped
            })
        })
    }
}
