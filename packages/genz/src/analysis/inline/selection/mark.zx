import integers from "std:integer"

import children from "../../ir/children"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    table: Expressions,
    marks: u32[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const table = in.table

    return loop({
        marks: in.marks,
        marked: table.kinds.map(kind => false)[0]
    }, {
        while: current => current.marks.length != 0,
        next: current => {
            const id = integers.widen(current.marks[current.marks.length - 1])

            current.marks = current.marks.pop()[0]

            if (!current.marked[id]) {
                current.marked[id] = true
                current.marks = current.marks.concat(children({
                    table,
                    id
                }))[0]
            }
        },
        return: state => state.marked
    })
}
