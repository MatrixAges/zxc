<Module>
    <Type from="model" as="Construction" />

    <Args in={Construction.Input} out={Construction.Output} />

    <Call fn="initialize" in={$in} />

    <If on={$in.mode == Construction.Mode.Heap}>
        <Call fn="heap" in={$ctx.initialize} />
        <Call fn="publish" in={$ctx.heap} />

        <Return value={$ctx.publish} />
    </If>

    <Call fn="value" in={$ctx.initialize} />

    <If on={$in.mode == Construction.Mode.Reference}>
        <Call fn="reference" in={$ctx.value} />
        <Call fn="publish" in={$ctx.reference} />

        <Return value={$ctx.publish} />
    </If>

    <Call fn="publish" in={$ctx.value} />

    <Return value={$ctx.publish} />
</Module>
