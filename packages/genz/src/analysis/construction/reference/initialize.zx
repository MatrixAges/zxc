import initialize from "../../../ast/context/initialize"
import empty from "../../../ast/statements/empty"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        source: in,
        context: initialize({
            capture: null,
            expression_base: in.expression_base,
            statement_base: 0,
            field_base: 0,
            serial: in.serial
        }),
        storage: empty({}),
        root: in.value
    }
}
