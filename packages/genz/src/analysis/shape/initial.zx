import { map } from "std:utils"
import { max_u32 } from "core/const"

import type { Request, State } from "./model"

export type Input = Request

export type Output = State

export default function (in: Input): Output {
    return {
        request: in,
        numbers: map(in.kinds, kind => max_u32),
        type_ids: [],
        nodes: [],
        cursors: [],
        root: 0
    }
}
