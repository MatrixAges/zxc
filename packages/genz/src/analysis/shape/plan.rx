<Module>
    <Input>
        <Field name="kinds" type="u8[]" />
        <Field name="first" type="u32[]" />
        <Field name="second" type="u32[]" />
        <Field name="children" type="u32[]" />
        <Field name="field_types" type="u32[]" />
        <Field name="input" type="u32" />
        <Field name="output" type="u32" />
    </Input>

    <Call fn="initial" in={$in} />
    <Call fn="walk" in={$ctx.initial} />

    <Return value={$ctx.walk} />

    <Output>
        <Field name="type_ids" type="u32[]" />
        <Field name="numbers" type="u32[]" />
    </Output>
</Module>
