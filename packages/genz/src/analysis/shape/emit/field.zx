import integers from "std:integer"
import { max_u32 } from "core/const"

import type { State } from "./model"

export type Input = {
    state: State,
    name: u8[],
    value: u32
}

export type Output = State

export default function (in: Input): Output {
    const count = integers.widen(in.state.source.field_base) +
        in.state.fields.name.length

    if (count >= integers.widen(max_u32)) {
        return {
            ...in.state,
            valid: false
        }
    }

    return {
        ...in.state,
        fields: {
            name: in.state.fields.name.push(in.name)[0],
            value: in.state.fields.value.push(in.value)[0],
            default_value: in.state.fields.default_value.push(null)[0],
            comptime_parameter: in.state.fields.comptime_parameter.push(false)[0]
        }
    }
}
