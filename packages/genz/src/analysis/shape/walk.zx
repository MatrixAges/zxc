import integers from "std:integer"
import { max_u32 } from "core/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Plan, State } from "./model"

export type Input = State

export type Output = Plan

export default function (in: Input): Output {
    const result = loop(in, {
        while: current => current.root < 2 || current.nodes.length != 0,
        next: current => {
            if (current.nodes.length == 0) {
                const root = match {
                    current.root == 0 => current.request.input,
                    _ => current.request.output
                }

                current.root += 1

                if (current.numbers[integers.widen(root)] == max_u32) {
                    current.nodes = current.nodes.push(root)[0]
                    current.cursors = current.cursors.push(0)[0]
                }
            } else {
                const top = current.nodes.length - 1
                const node = current.nodes[top]
                const index = integers.widen(node)
                const target = kind(current.request.kinds[index])
                const single = target == Kind.List || target == Kind.Optional
                const count = match {
                    single => 1,
                    target == Kind.Object || target == Kind.Tuple =>
                        integers.widen(
                            current.request.second[index]
                        ),
                    _ => 0,
                }

                const position = current.cursors[top]

                if (position < count) {
                    const first = current.request.first[index]
                    const child = match {
                        single => first,
                        target == Kind.Object =>
                            current.request
                            .field_types[integers.widen(
                                first
                            ) + position],
                        _ =>
                            current.request
                            .children[integers.widen(first) +
                                position],
                    }

                    current.cursors[top] += 1

                    if (current.numbers[integers.widen(child)] == max_u32) {
                        current.nodes = current.nodes.push(child)[0]
                        current.cursors = current.cursors.push(0)[0]
                    }
                } else {
                    current.numbers[index] =
                        integers.narrow(
                            current.type_ids.length
                        )
                    current.type_ids = current.type_ids.push(node)[0]
                    current.nodes = current.nodes.pop()[0]
                    current.cursors = current.cursors.pop()[0]
                }
            }
        }
    })

    return {
        type_ids: result.type_ids,
        numbers: result.numbers
    }
}
