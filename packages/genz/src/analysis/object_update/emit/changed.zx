import integers from "std:integer"

import unchanged from "../match/field_unchanged"

import type { Write } from "./model"

export type Input = {
    source: Write,
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const changes = in.source.changes

    if (changes == null) {
        return false
    }

    const expressions = changes.expressions
    const node = integers.widen(changes.object)
    const payload = integers.widen(expressions.payloads[node])
    const first = integers.widen(expressions.object_first[payload])
    const field = first + in.index

    return !unchanged({
        expressions,
        flags: changes.flags,
        reference: changes.reference,
        field_index: expressions.object_field_indices[field],
        value: expressions.object_field_values[field]
    })
}
