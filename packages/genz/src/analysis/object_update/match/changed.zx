import integers from "std:integer"

import result from "./result"
import unchanged from "./unchanged"

import type { Candidate as Input, Output } from "./model"

export default function (in: Input): Output {
    const empty: u32? = null
    const initial: u32 = 0
    const positions: u32[] = []

    return loop({
        index: 0,
        first_position: 0,
        field_index: empty,
        field_value: initial,
        positions,
        valid: true
    }, {
        while: state => state.valid && state.index < in.root.count,
        next: state => {
            if (!unchanged({
                candidate: in,
                index: state.index
            })) {
                if (state.field_index == null) {
                    const expressions = in.root.source.expressions
                    const field = in.root.first + state.index

                    state.first_position = state.index
                    state.field_index = expressions.object_field_indices[field]
                    state.field_value = expressions.object_field_values[field]
                } else if (in.root.source.evaluated) {
                    if (state.positions.length == 0) {
                        const first = integers.narrow(state.first_position)

                        state.positions = state.positions.push(first)[0]
                    }

                    state.positions =
                        state.positions.push(integers.narrow(state.index))[0]
                } else {
                    state.valid = false
                }
            }

            state.index += 1
        },
        return: state => result({
            candidate: in,
            ...state.pick([
                "field_index",
                "field_value",
                "positions",
                "valid"
            ])
        })
    })
}
