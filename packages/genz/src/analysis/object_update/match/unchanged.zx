import fieldUnchanged from "./field_unchanged"

import type { Candidate } from "./model"

export type Input = {
    candidate: Candidate,
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const expressions = in.candidate.root.source.expressions
    const field = in.candidate.root.first + in.index

    return fieldUnchanged({
        expressions,
        flags: in.candidate.root.source.flags,
        reference: in.candidate.reference,
        field_index: expressions.object_field_indices[field],
        value: expressions.object_field_values[field]
    })
}
