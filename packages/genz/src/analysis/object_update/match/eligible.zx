import get from "core/integer/index/get"

import type { Candidate as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const member = get({
        index: in.root.source.state_members,
        key: in.previous
    })

    if (member == null) {
        return false
    }

    return get({
        index: in.root.source.stack_members,
        key: in.previous
    }) == null
}
