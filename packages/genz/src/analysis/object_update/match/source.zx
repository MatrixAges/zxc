import owner from "./owner"
import reference from "./reference"

import type { Root as Input, Candidate } from "./model"

export type Output = Candidate?

export default function (in: Input): Output {
    const empty: u32? = null

    const found = loop({
        index: 0,
        reference: empty
    }, {
        while: state => state.index < in.count && state.reference == null,
        next: state => {
            state.reference = reference({
                root: in,
                index: state.index
            })
            state.index += 1
        },
        return: state => state.reference
    })

    if (found == null) {
        return null
    }

    const previous = owner({
        expressions: in.source.expressions,
        flags: in.source.flags,
        id: found
    })

    if (previous == null) {
        return null
    }

    return {
        root: in,
        previous,
        reference: found
    }
}
