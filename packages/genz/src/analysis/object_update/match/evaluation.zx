import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import plain from "./plain"

import type { Candidate as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    if (in.root.source.evaluated) {
        return true
    }

    const expressions = in.root.source.expressions
    const first = integers.widen(expressions.object_evaluation_first[in.root.payload])
    const count = integers.widen(expressions.object_evaluation_count[in.root.payload])

    return loop({
        index: first,
        valid: true
    }, {
        while: state => state.valid && state.index < first + count,
        next: state => {
            const id = expressions.object_evaluation_values[state.index]
            const node = integers.widen(id)

            if (expressions.kinds[node] != ExpressionKind.Reference) {
                state.valid = false
            } else {
                const payload = integers.widen(expressions.payloads[node])

                state.valid = expressions.references[payload] == in.previous && plain({
                    flags: in.root.source.flags,
                    id
                })
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
