import expressions from "./expressions"

import type { Contracts } from "core/contract_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    expressions: Expressions,
    contracts: Contracts,
    allowed: bool[],
    limit: u64
}

export type Output = bool

export default function (in: Input): Output {
    if (!expressions({
        types: in.types,
        expressions: in.expressions,
        allowed: in.allowed,
        limit: in.limit
    })) {
        return false
    }

    const result = loop({
        types: in.types,
        tables: in.contracts.expressions,
        allowed: in.allowed,
        limit: in.limit,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.tables.length,
        next: current => {
            current.valid = expressions({
                types: current.types,
                expressions: current.tables[current.index],
                allowed: current.allowed,
                limit: current.limit
            })
            current.index += 1
        }
    })

    return result.valid
}
