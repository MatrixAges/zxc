import allocator from "./allocator"
import nodes from "./nodes"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const uses_allocator = allocator(in)

    const call = nodes({
        callee: in.callee,
        arguments: in.arguments,
        expression_base: in.expression_base,
        fallible: in.fallible,
        capture: in.capture
    })

    return {
        ...call,
        uses_allocator
    }
}
