import bytes from "std:bytes"
import integers from "std:integer"

import { ExpressionsKind } from "../../printer/model/expressions"
import { allocator_name } from "../construction/const"

import type { Expressions } from "./model"

export type Input = {
    expressions: Expressions,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const row = integers.widen(in.id)

    if (in.expressions.tags[row] != ExpressionsKind.Identifier) {
        return false
    }

    const offset = integers.widen(in.expressions.offsets[row])
    const name = in.expressions.identifier[offset]

    return bytes.equals(name, bytes.fromText(allocator_name))
}
