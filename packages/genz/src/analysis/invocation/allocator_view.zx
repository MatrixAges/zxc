import integers from "std:integer"

import { ExpressionsKind } from "../../printer/model/expressions"
import identifier from "./identifier"

import type { Expressions } from "./model"

export type Input = {
    expressions: Expressions,
    base: u32,
    callee: u32,
    arguments: u32[]
}

export type Output = bool

export default function (in: Input): Output {
    const expressions = in.expressions
    const row = integers.widen(in.callee - in.base)

    if (expressions.tags[row] == ExpressionsKind.Field) {
        const offset = integers.widen(expressions.offsets[row])
        const owner = expressions.field_target[offset]

        if (identifier({
            expressions,
            base: in.base,
            id: owner
        })) {
            return true
        }
    }

    return loop({
        index: 0,
        found: false
    }, {
        while: state => !state.found && state.index < in.arguments.length,
        next: state => {
            state.found = identifier({
                expressions,
                base: in.base,
                id: in.arguments[state.index]
            })
            state.index += 1
        },
        return: state => state.found
    })
}
