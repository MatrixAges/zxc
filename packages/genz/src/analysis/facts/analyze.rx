<Module>
    <Type from="../model" as="Model" />
    <Type from="../types/layout" as="Layout" />

    <Args
        in={{
            errors: {
                callees: u32[][],
                names: string[][],
                unknown: bool[]
            },
            program: Model.Program
        }}
        out={{
            errors: {
                components: u32[],
                names: string[][],
                unknown: bool[]
            },
            fresh_outputs: bool[],
            identity_free: bool[],
            io: bool[],
            keys: u8[],
            local: bool[],
            layout_types: Layout.Output,
            process: bool[],
            pure: bool[],
            selected: bool[],
            tasks: bool[],
            values: bool[]
        }}
    />

    <Call module="../state/select" in={$in.program} />

    <Call fn="../types/layout" in={$in.program.types} />

    <Call
        fn="../value/summary"
        in={{
            program: $in.program,
            selected: $ctx.select.selected
        }}
    />

    <Call fn="../capability/io" in={$in.program.functions} />
    <Call fn="../capability/process" in={$in.program.functions} />
    <Call fn="../capability/tasks" in={$in.program} />
    <Call fn="../types/fresh_outputs" in={$in.program} />

    <Call
        fn="../identity/free"
        in={{
            types: $in.program.types,
            functions: $in.program.functions,
            pure: $ctx.summary.pure
        }}
    />

    <Call module="core/error_effects/functions" in={$in.errors} />

    <Return
        value={{
            ...$ctx.summary,
            ...$ctx.select,
            layout_types: $ctx.layout,
            io: $ctx.io,
            process: $ctx.process,
            tasks: $ctx.tasks,
            fresh_outputs: $ctx.fresh_outputs,
            identity_free: $ctx.free,
            errors: $ctx.functions
        }}
    />
</Module>
