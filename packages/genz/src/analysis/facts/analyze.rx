<Module>
    <Call module="../state/select" in={$in.program} />

    <Call fn="../value/summary" in={{ program: $in.program, selected: $ctx.select.selected }} />
    <Call fn="../capability/io" in={$in.program} />
    <Call fn="../capability/process" in={$in.program} />
    <Call fn="../capability/tasks" in={$in.program} />
    <Call fn="../types/fresh_outputs" in={$in.program} />
    <Call fn="../identity/free" in={{ types: $in.program.types, functions: $in.program.functions, pure: $ctx.summary.pure }} />

    <Return value={{ pure: $ctx.summary.pure, local: $ctx.summary.local, values: $ctx.summary.values, selected: $ctx.select.selected, keys: $ctx.select.keys, io: $ctx.io, process: $ctx.process, tasks: $ctx.tasks, fresh_outputs: $ctx.fresh_outputs, identity_free: $ctx.free }} />
</Module>
