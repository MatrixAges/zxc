import type { Modules, Functions } from "core/native_module_table/model"
import type { Columns as Declarations, Constant } from "../../../ast/declarations/model"
import type { Columns as Expressions } from "../../../ast/expressions/namespace"
import type { Output as Plan } from "../model"

export type Input = {
    plan: Plan,
    modules: Modules,
    functions: Functions,
    types: u32[],
    layouts: u32[],
    expression_base: u32,
    declaration_base: u32,
    prefix_count: u32
}

export type State = {
    source: Input,
    expressions: Expressions,
    declarations: Constant[],
    signatures: u32[][],
    members: u32[],
    layouts: u32[],
    valid: bool
}

export type Output = {
    expressions: Expressions,
    declarations: Declarations,
    roots: Declarations,
    valid: bool
}
