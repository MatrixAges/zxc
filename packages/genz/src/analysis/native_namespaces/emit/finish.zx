import bytes from "std:bytes"
import integers from "std:integer"

import constants from "../../../ast/declarations/constants"

import type { Constant } from "../../../ast/declarations/model"
import type { State, Output } from "./model"

export type Input = {
    state: State,
    native_value: u32,
    layouts_value: u32
}

export default function (in: Input): Output {
    const declarations = constants({
        values: in.state.declarations,
        base: in.state.source.declaration_base
    })

    const base = integers.narrow(
        integers.widen(in.state.source.declaration_base) +
            in.state.declarations.length +
            integers.widen(in.state.source.prefix_count)
    )

    const values: Constant[] = [{
        name: bytes.fromText(in.state.source.plan.native_name),
        type_expr: null,
        value: in.native_value,
        exported: true
    }, {
        name: bytes.fromText(in.state.source.plan.layouts_name),
        type_expr: null,
        value: in.layouts_value,
        exported: true
    }]

    const roots = constants({
        values,
        base
    })

    return {
        expressions: in.state.expressions,
        declarations: declarations.table,
        roots: roots.table,
        valid: in.state.valid && declarations.valid && roots.valid
    }
}
