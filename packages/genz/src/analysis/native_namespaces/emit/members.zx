import bytes from "std:bytes"
import integers from "std:integer"

import namespace from "../../../ast/expressions/namespace"
import resolve from "./member"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const result = loop({
        source: in.source,
        signatures: in.signatures,
        expressions: in.expressions,
        declarations: in.declarations,
        members: in.members,
        valid: in.valid,
        index: 0
    }, {
        while: current =>
            current.valid && current.index < current.source.plan.groups.length,
        next: current => {
            const group = current.source.plan.groups[current.index]
            const start = current.declarations.length
            const selected = loop({
                source: current.source,
                group,
                signatures: current.signatures[current.index],
                declarations: current.declarations,
                valid: current.valid,
                index: 0
            }, {
                while: item => item.valid &&
                    item.index < item.group.types.length + item.group.functions.length,
                next: item => {
                    const member =
                        resolve(
                            item.pick(
                                [
                                    "source",
                                    "group",
                                    "signatures",
                                    "index"
                                ]
                            )
                        )

                    item.declarations = item.declarations.push({
                        name: bytes.fromText(member.name),
                        type_expr: null,
                        value: member.value,
                        exported: true
                    })[0]
                    item.index += 1
                }
            })

            const expression = namespace({
                table: current.expressions,
                base: current.source.expression_base,
                start:
                    integers.narrow(
                        integers.widen(
                            current.source.declaration_base
                        ) + start
                    ),
                count: integers.narrow(selected.declarations.length - start)
            })

            current.declarations = selected.declarations
            current.expressions = expression.table
            current.members = current.members.push(expression.id)[0]
            current.valid = selected.valid && expression.valid
            current.index += 1
        }
    })

    return {
        ...in,
        ...result.pick(["expressions", "declarations", "members", "valid"])
    }
}
