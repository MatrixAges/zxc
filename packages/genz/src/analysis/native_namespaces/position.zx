export type Input = {
    names: string[],
    name: string
}

export type Output = u64

export default function (in: Input): Output {
    const result = loop({
        ...in,
        first: 0,
        end: in.names.length
    }, {
        while: current => current.first < current.end,
        next: current => {
            const middle = current.first + (current.end - current.first) / 2
            const left = current.names[middle]

            const common = loop({
                left,
                right: current.name,
                index: 0
            }, {
                while: bytes => bytes.index < bytes.left.length &&
                    bytes.index < bytes.right.length &&
                    bytes.left[bytes.index] == bytes.right[bytes.index],
                next: bytes => { bytes.index += 1 }
            }).index

            const less = common < left.length && common < current.name.length ?
                left[common] < current.name[common] :
                left.length < current.name.length

            if (less) {
                current.first = middle + 1
            } else {
                current.end = middle
            }
        }
    })

    return result.first
}
