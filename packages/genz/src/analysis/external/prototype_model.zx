import type { Input as Bases } from "../../ast/context/model"
import type { Output as Signature } from "../functions/signature/model"

export type Input = {
    index: u32,
    input_type: u32,
    output_type: u32,
    io_argument: bool,
    process_argument: bool,
    fallible: bool,
    errors?: u8[][],
    bases: Bases
}

export type Output = Signature
