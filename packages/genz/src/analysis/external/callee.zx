import bytes from "std:bytes"
import { scalar_void } from "core/type_table/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import field from "../../ast/context/field"
import identifier from "../../ast/context/identifier"
import initialize from "../../ast/context/initialize"
import { allocator_name } from "../construction/const"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const root = identifier({
        state: initialize(in.bases),
        name: in.native
    })

    const target = loop({
        node: root,
        index: 0
    }, {
        while: current => current.node.state.valid && current.index < in.member.length,
        next: current => {
            current.node = field({
                state: current.node.state,
                target: current.node.id,
                name: in.member[current.index]
            })
            current.index += 1
        },
        return: current => current.node
    })

    const allocator = identifier({
        state: target.state,
        name: bytes.fromText(allocator_name)
    })

    const scalar = kind(in.input_kind) == Kind.Scalar
    const empty_tuple = in.expand_tuple && in.input_count == 0
    const void_input = scalar && in.input_scalar == scalar_void

    return {
        source: in,
        context: allocator.state,
        callee: target.id,
        allocator: allocator.id,
        arguments: [],
        no_input: empty_tuple || void_input
    }
}
