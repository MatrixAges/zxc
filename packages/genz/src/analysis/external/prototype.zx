import { Variant } from "../functions/requests/model"
import name from "../functions/requests/name"
import build from "../functions/signature/build.rx"

import type { Input, Output } from "./prototype_model"

export default function (in: Input): Output {
    const errors: u8[][]? = match {
        in.fallible => in.errors,
        _ => []
    }

    return build({
        name: name({
            id: in.index,
            variant: Variant.Regular
        }),
        input_type: in.input_type,
        output_type: in.output_type,
        store_count: 0,
        io: in.io_argument,
        process: in.process_argument,
        errors,
        exported: false,
        inlined: false,
        bases: in.bases
    })
}
