import integers from "std:integer"

import bindings from "./bindings"
import check from "./check"

import type { Table } from "core/type_table/model"
import type { Unit } from "../unit"

export type Input = { types: Table, units: Unit[], pure: bool[] }

export type Output = bool[]

export default function (in: Input): Output {
    const result = loop({ types: in.types, units: in.units, pure: in.pure, allocated: in.pure.map(value => false), index: 0 }, {
        while: current => current.index < current.pure.length,
        next: current => {
            const unit = current.units[current.index]

            if (!unit.external && current.pure[current.index] && current.types.kinds[integers.widen(unit.output_type)] == 3) {
                const bound = bindings(unit)

                current.allocated[current.index] = unit.control.results.length != 0 && loop({ unit: unit, bindings: bound, functions: current.allocated, limit: current.index, position: 0, valid: true }, {
                    while: returns => returns.position < returns.unit.control.results.length,
                    next: returns => {
                        const returned = returns.unit.control.results[returns.position]

                        if (returned == null) {
                            returns.valid = false
                        } else if (!check({ unit: returns.unit, bindings: returns.bindings, functions: returns.functions, limit: returns.limit, id: integers.widen(returned) }).valid) {
                            returns.valid = false
                        }

                        returns.position += 1
                    }
                }).valid
            }

            current.index += 1
        }
    })

    return result.allocated
}
