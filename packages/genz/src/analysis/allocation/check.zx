import integers from "std:integer"
import { CollectionKind, ExpressionKind, TransformKind } from "core/expression_table/kinds"

import field from "../lanes/trace/field"
import prepend from "../lanes/trace/prepend"
import same from "../lanes/trace/same"

import type { Unit } from "../unit"

export enum CheckOp { Check, Continue, Iteration, Release }

export type CheckFrame = { op: CheckOp, id: u64, first: u64, count: u64, depth: u64 }

export type Assumption = { symbol: u64, first: u64, count: u64 }

export type Input = { unit: Unit, bindings: u64[], functions: bool[], limit: u64, id: u64 }

export type Output = { valid: bool, allocations: u64[] }

export default function (in: Input): Output {
    const empty: u32[] = []
    const frames: CheckFrame[] = [{ op: CheckOp.Check, id: in.id, first: 0, count: 0, depth: 0 }]
    const results: bool[] = []
    const assumptions: Assumption[] = []
    const allocations: u64[] = []

    const state = loop({ table: in.unit.expressions, bindings: in.bindings, functions: in.functions, limit: in.limit, frames: frames, results: results, assumptions: assumptions, allocations: allocations, pool: empty }, {
        while: current => current.frames.length != 0,
        next: current => {
            const frame = current.frames[current.frames.length - 1]
            const table = current.table

            current.frames = current.frames.pop()[0]

            if (frame.op == CheckOp.Continue || frame.op == CheckOp.Iteration) {
                const previous = current.results[current.results.length - 1]

                if (previous) {
                    current.results = current.results.pop()[0]

                    if (frame.op == CheckOp.Iteration) {
                        const payload = integers.widen(table.payloads[frame.id])

                        current.assumptions = current.assumptions.push({ symbol: integers.widen(table.iteration_parameters[payload]), first: frame.first, count: frame.count })[0]
                        current.frames = current.frames.concat([{ ...frame, op: CheckOp.Release }, { ...frame, op: CheckOp.Check, id: integers.widen(table.iteration_bodies[payload]), depth: frame.depth + 1 }])[0]
                    } else {
                        current.frames = current.frames.push({ ...frame, op: CheckOp.Check })[0]
                    }
                }
            } else if (frame.op == CheckOp.Release) {
                current.assumptions = current.assumptions.pop()[0]
            } else if (frame.depth > table.kinds.length) {
                current.results = current.results.push(false)[0]
            } else {
                const id = frame.id
                const count = frame.count
                const kind = table.kinds[id]
                const payload = integers.widen(table.payloads[id])
                const next = frame.depth + 1

                if (kind == ExpressionKind.List) {
                    if (count == 0) {
                        current.allocations = current.allocations.push(id)[0]
                    }

                    current.results = current.results.push(count == 0)[0]
                } else if (kind == ExpressionKind.Reference) {
                    const symbol = integers.widen(table.references[payload])

                    const assumed = loop({ assumptions: current.assumptions, symbol: symbol, position: 0, found: current.assumptions.length }, {
                        while: search => search.found == search.assumptions.length && search.position < search.assumptions.length,
                        next: search => {
                            if (search.assumptions[search.position].symbol == search.symbol) {
                                search.found = search.position
                            }

                            search.position += 1
                        }
                    }).found

                    if (assumed != current.assumptions.length) {
                        current.results = current.results.push(same({ left: current.pool, left_first: current.assumptions[assumed].first, left_count: current.assumptions[assumed].count, right: current.pool, right_first: frame.first, right_count: frame.count }))[0]
                    } else if (current.bindings[symbol] != 0) {
                        current.frames = current.frames.push({ ...frame, id: current.bindings[symbol] - 1, depth: next })[0]
                    } else {
                        current.results = current.results.push(false)[0]
                    }
                } else if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
                    const first = current.pool.length

                    current.pool = prepend({ pool: current.pool, index: table.projection_indices[payload], first: frame.first, count: frame.count })
                    current.frames = current.frames.push({ ...frame, id: integers.widen(table.projection_targets[payload]), first: first, count: frame.count + 1, depth: next })[0]
                } else if (kind == ExpressionKind.Object) {
                    const first = integers.widen(table.object_first[payload])
                    const total = integers.widen(table.object_count[payload])
                    const found = count == 0 ? total : field({ table: table, first: first, count: total, wanted: current.pool[frame.first] })

                    if (found == total) {
                        current.results = current.results.push(false)[0]
                    } else {
                        current.frames = current.frames.push({ ...frame, id: integers.widen(table.object_field_values[first + found]), first: frame.first + 1, count: frame.count - 1, depth: next })[0]
                    }
                } else if (kind == ExpressionKind.Tuple) {
                    if (count != 0 && integers.widen(current.pool[frame.first]) < integers.widen(table.sequence_count[payload])) {
                        current.frames = current.frames.push({ ...frame, id: integers.widen(table.sequence_items[integers.widen(table.sequence_first[payload]) + integers.widen(current.pool[frame.first])]), first: frame.first + 1, count: frame.count - 1, depth: next })[0]
                    } else {
                        current.results = current.results.push(false)[0]
                    }
                } else if (kind == ExpressionKind.Scope) {
                    current.frames = current.frames.push({ ...frame, id: integers.widen(table.scope_results[payload]), depth: next })[0]
                } else if (kind == ExpressionKind.Conditional) {
                    current.frames = current.frames.concat([{ ...frame, op: CheckOp.Continue, id: integers.widen(table.conditional_no[payload]), depth: next }, { ...frame, id: integers.widen(table.conditional_yes[payload]), depth: next }])[0]
                } else if (kind == ExpressionKind.Match) {
                    const arms = loop({ table: table, frames: current.frames, frame: frame, first: integers.widen(table.match_first[payload]), remaining: integers.widen(table.match_count[payload]), depth: next }, {
                        while: pending => pending.remaining != 0,
                        next: pending => {
                            pending.remaining -= 1
                            pending.frames = pending.frames.push({ ...pending.frame, op: CheckOp.Continue, id: integers.widen(pending.table.match_results[pending.first + pending.remaining]), depth: pending.depth })[0]
                        }
                    }).frames

                    current.frames = arms.push({ ...frame, id: integers.widen(table.match_fallbacks[payload]), depth: next })[0]
                } else if (kind == ExpressionKind.Transform) {
                    const transform = table.transform_kinds[payload]
                    const allocated = count == 0 && (transform == TransformKind.Map || transform == TransformKind.Filter)

                    if (allocated) {
                        current.allocations = current.allocations.push(id)[0]
                    }

                    current.results = current.results.push(allocated)[0]
                } else if (kind == ExpressionKind.ListUpdate) {
                    if (count == 0) {
                        current.frames = current.frames.push({ ...frame, id: integers.widen(table.update_targets[payload]), depth: next })[0]
                    } else {
                        current.results = current.results.push(false)[0]
                    }
                } else if (kind == ExpressionKind.ListOperation) {
                    const operation = table.collection_kinds[payload]

                    if (count == 1 && current.pool[frame.first] == 0 && (operation == CollectionKind.Push || operation == CollectionKind.Concat)) {
                        current.frames = current.frames.push({ ...frame, id: integers.widen(table.collection_targets[payload]), first: 0, count: 0, depth: next })[0]
                    } else {
                        current.results = current.results.push(false)[0]
                    }
                } else if (kind == ExpressionKind.Call) {
                    const callee = integers.widen(table.call_functions[payload])
                    const allocated = count == 0 && callee < current.limit && current.functions[callee]

                    if (allocated) {
                        current.allocations = current.allocations.push(id)[0]
                    }

                    current.results = current.results.push(allocated)[0]
                } else if (kind == ExpressionKind.Iteration) {
                    current.frames = current.frames.concat([{ ...frame, op: CheckOp.Iteration, depth: next }, { ...frame, id: integers.widen(table.iteration_initials[payload]), depth: next }])[0]
                } else {
                    current.results = current.results.push(false)[0]
                }
            }
        }
    })

    return { valid: state.results[state.results.length - 1], allocations: state.allocations }
}
