import integers from "std:integer"

import product from "../types/product"

import type { Table } from "core/type_table/model"
import type { Lanes, Unit } from "../unit"

export type Capability = { index_only: bool, writable: bool, forwardable: bool }

export type Input = { types: Table, units: Unit[], lanes: Lanes[], pure: bool[] }

export type Output = Capability[][]

export default function (in: Input): Output {
    const result: Capability[][] = []

    const computed = loop({ types: in.types, units: in.units, lanes: in.lanes, pure: in.pure, result: result, index: 0 }, {
        while: current => current.index < current.lanes.length,
        next: current => {
            const index = current.index
            const unit = current.units[index]
            const producer = current.pure[index] && !unit.external && unit.contracts.kinds.length == 0 && unit.stores.paths.length == 0 && product({ types: current.types, id: unit.output_type })
            const selected: Capability[] = []

            current.result = current.result.push(loop({ table: unit.expressions, lanes: current.lanes[index], result: current.result, index: index, producer: producer, selected: selected, position: 0 }, {
                while: lanes => lanes.position < lanes.lanes.length,
                next: lanes => {
                    const lane = lanes.lanes[lanes.position]

                    if (lane.rejected || lane.appends.length != 0 || lane.pops.length != 0) {
                        lanes.selected = lanes.selected.push({ index_only: false, writable: false, forwardable: false })[0]
                    } else {
                        const nested = loop({ table: lanes.table, calls: lane.calls, result: lanes.result, index: lanes.index, writable: lane.updates.length != 0, position: 0, index_only: true }, {
                            while: calls => calls.index_only && calls.position < calls.calls.length,
                            next: calls => {
                                const saved = calls.calls[calls.position]
                                const payload = integers.widen(calls.table.payloads[integers.widen(saved.expression)])
                                const callee = integers.widen(calls.table.call_functions[payload])

                                if (callee >= calls.index || calls.table.call_store_count[payload] != 0) {
                                    calls.index_only = false
                                } else {
                                    const capability = calls.result[callee][saved.lane]

                                    calls.index_only = capability.index_only
                                    calls.writable = calls.writable || capability.writable
                                }

                                calls.position += 1
                            }
                        })

                        lanes.selected = lanes.selected.push({ index_only: nested.index_only, writable: nested.index_only && nested.writable, forwardable: nested.index_only && lanes.producer })[0]
                    }

                    lanes.position += 1
                }
            }).selected)[0]
            current.index += 1
        }
    })

    return computed.result
}
