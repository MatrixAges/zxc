import bytes from "std:bytes"
import integers from "std:integer"

export type Input = {
    source: string[],
    buckets: u32?[],
    name: u8[],
    slot: u64
}

export type Output = u64

export default function (in: Input): Output {
    return loop({
        ...in,
        done: false
    }, {
        while: current => !current.done,
        next: current => {
            const previous = current.buckets[current.slot]

            if (previous == null) {
                current.done = true
            } else if (
                bytes.equals(
                    bytes.fromText(
                        current.source[integers.widen(
                            previous
                        )]
                    ),
                    current.name
                )
            ) {
                current.done = true
            } else {
                current.slot = (current.slot + 1) % current.buckets.length
            }
        },
        return: state => state.slot
    })
}
