import type { Constant, Columns as Declarations } from "../../../ast/declarations/model"
import type {
    ExpressionsKind,
    ExpressionsBuiltinName
} from "../../../printer/model/expressions"

export type Alias = {
    name: string,
    identity: string
}

export type Input = {
    names: string[],
    aliases: Alias[],
    imported: bool
}

export type Expressions = {
    tags: ExpressionsKind[],
    offsets: u32[],
    identifier: u8[][],
    string: u8[][],
    builtin_name: ExpressionsBuiltinName[],
    builtin_arguments: u32[][],
    field_target: u32[],
    field_name: u8[][],
    namespace_type_start: u32[],
    namespace_type_len: u32[]
}

export type State = {
    source: Input,
    expressions: Expressions,
    members: Constant[],
    roots: Constant[],
    valid: bool
}

export type Output = {
    expressions: Expressions,
    members: Declarations,
    roots: Declarations,
    valid: bool
}
