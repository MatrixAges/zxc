import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Table as Declarations } from "../../../ast/declarations/table/model"
import type { Columns as Fields } from "../../../ast/fields/model"
import type { Module as Snapshot } from "../../../ast/snapshot/model"
import type { State as Statements } from "../../../ast/statements/builder/model"
import type { Object, Policy } from "../lifecycle/model"

export type Input = {
    objects: Object[],
    bases: Bases,
    declaration_base: u32,
    execute: bool,
    io: bool,
    process: bool
}

export type Extra = {
    optional_type: u32[],
    error_union_payload: u32[],
    error_union_errors: u8[][]?[],
    error_union_inferred: bool[],
    container_type_fields_start: u32[],
    container_type_fields_len: u32[],
    container_type_declarations_start: u32[],
    container_type_declarations_len: u32[]
}

export type State = {
    source: Input,
    policy: Policy,
    context: Context,
    statements: Statements,
    fields: Fields,
    initial: Fields,
    members: Fields,
    declarations: Declarations,
    extra: Extra,
    roots: u32[],
    methods_first: u32,
    self: u32,
    self_namespace: u32,
    parent_pointer: u32,
    request_type: u32,
    request_pointer: u32,
    arena_type: u32,
    unit: u32,
    valid: bool
}

export type Node = {
    state: State,
    id: u32
}

export type Execution = {
    state: State,
    names: u8[][],
    types: u32[],
    arguments: u32[]
}

export type Commit = {
    state: State,
    changes: u32,
    parent: u32,
    retained: u32,
    region: u32,
    child_allocator: u32
}

export type Output = Snapshot
