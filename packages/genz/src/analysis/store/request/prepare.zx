import bytes from "std:bytes"

import identifier from "../../../ast/context/identifier"
import initialize from "../../../ast/context/initialize"
import pointer from "../../../ast/context/pointer"
import primitive from "../../../ast/context/primitive"
import standardField from "../../../ast/context/standard_field"
import declarations from "../../../ast/declarations/table/create"
import fields from "../../../ast/fields/empty"
import statements from "../../../ast/statements/builder/initialize"
import { ExpressionsPrimitive } from "../../../printer/model/expressions"
import { self_name, self_type_name } from "../lifecycle/const"
import { arena_allocator_name, heap_name } from "../storage/const"
import { request_type_name } from "./const"

import type { Policy } from "../lifecycle/model"
import type { Input as Source, State as Output } from "./model"

export type Input = {
    source: Source,
    policy: Policy
}

export default function (in: Input): Output {
    const self = identifier({
        state: initialize(in.source.bases),
        name: bytes.fromText(self_name)
    })

    const arena = standardField({
        state: self.state,
        path: [
            heap_name,
            arena_allocator_name
        ]
    })

    const parent = identifier({
        state: arena.state,
        name: bytes.fromText(self_type_name)
    })

    const parent_pointer = pointer({
        state: parent.state,
        value: parent.id
    })

    const request = identifier({
        state: parent_pointer.state,
        name: bytes.fromText(request_type_name)
    })

    const request_pointer = pointer({
        state: request.state,
        value: request.id
    })

    const unit = primitive({
        state: request_pointer.state,
        value: ExpressionsPrimitive.Void
    })

    return {
        source: in.source,
        policy: in.policy,
        context: unit.state,
        statements: statements(in.source.bases.statement_base),
        fields: fields({}),
        initial: fields({}),
        members: fields({}),
        declarations: declarations({}),
        extra: {
            optional_type: [],
            error_union_payload: [],
            error_union_errors: [],
            error_union_inferred: [],
            container_type_fields_start: [],
            container_type_fields_len: [],
            container_type_declarations_start: [],
            container_type_declarations_len: []
        },
        roots: [],
        methods_first: in.source.declaration_base,
        self: self.id,
        self_namespace: parent.id,
        parent_pointer: parent_pointer.id,
        request_type: request.id,
        request_pointer: request_pointer.id,
        arena_type: arena.id,
        unit: unit.id,
        valid: true
    }
}
