import advance from "../../../ast/context/advance"
import declarations from "../../../ast/declarations/builder/publish"
import emptyFields from "../../../ast/fields/empty"
import emptyDeclarations from "../../../ast/snapshot/empty_declarations"
import emptyStatements from "../../../ast/snapshot/empty_statements"
import expressions from "../../../ast/snapshot/expressions"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    return {
        expressions: {
            ...expressions(in.context),
            ...in.extra
        },
        statements: emptyStatements({}),
        declarations: {
            ...emptyDeclarations({}),
            ...declarations(in.declarations)
        },
        fields: emptyFields({}),
        next: advance({
            context: in.context,
            statement_count: 0,
            field_count: 0
        }),
        roots: [],
        valid: in.context.valid && in.declarations.valid
    }
}
