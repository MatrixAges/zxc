import bytes from "std:bytes"
import integers from "std:integer"

import comptimeValue from "../../../ast/context/comptime"
import field from "../../../ast/context/field"
import identifier from "../../../ast/context/identifier"
import declaration from "../../../ast/declarations/append_function"
import { self_name, parent_name, slots_name, begin_name } from "./const"
import invokeBegin from "./invoke_begin"
import mappedSlots from "./mapped_slots"
import parameters from "./parameters"
import returnType from "./return_type"

import type { Readable as Input, Readable as Output } from "./model"

export default function (in: Input): Output {
    const mapped = mappedSlots({
        state: in.state.context,
        mapping: in.state.source.mapping
    })

    const self = identifier({
        state: mapped.state,
        name: bytes.fromText(self_name)
    })

    const parent = field({
        state: self.state,
        target: self.id,
        name: bytes.fromText(parent_name)
    })

    const args = parameters({
        state: {
            ...in.state,
            context: parent.state
        },
        name: bytes.fromText(slots_name),
        comptime_parameter: true
    })

    const type_node = returnType(args.state)

    const slots = comptimeValue({
        state: type_node.state.context,
        value: mapped.id
    })

    const invoke = invokeBegin({
        state: slots.state,
        parent: parent.id,
        slots: slots.id
    })

    const declared = declaration({
        table: type_node.state.declarations,
        value: {
            base: integers.narrow(
                integers.widen(in.state.source.declaration_base) +
                    in.state.declarations.tags.length
            ),
            name: bytes.fromText(begin_name),
            parameters_start: args.first,
            parameters_count: 2,
            return_type: type_node.id,
            body_start: invoke.body,
            body_count: 1,
            exported: true,
            abi_export: false,
            inlined: false,
            calling_convention: null
        }
    })

    return {
        ...in,
        state: {
            ...type_node.state,
            context: {
                ...invoke.state,
                valid: invoke.state.valid && declared.valid
            },
            declarations: declared.table
        }
    }
}
