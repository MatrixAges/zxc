import type { State as Context, Input as Bases } from "../../../ast/context/model"
import type { Variables } from "../../../ast/context/model"
import type { Columns as Functions } from "../../../ast/declarations/function"
import type { Columns as Forms } from "../../../ast/expressions/forms/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Columns as Fields } from "../../../ast/fields/model"
import type { Columns as Statements } from "../../../ast/statements/model"

export type Input = {
    mapping: u32[],
    readable: bool[],
    store_count: u64,
    pending_name: u8[],
    bases: Bases,
    declaration_base: u32
}

export type Extra = {
    error_union_payload: u32[],
    error_union_errors: u8[][]?[],
    error_union_inferred: bool[],
    container_type_fields_start: u32[],
    container_type_fields_len: u32[],
    container_type_declarations_start: u32[],
    container_type_declarations_len: u32[]
}

export type State = {
    source: Input,
    context: Context,
    extra: Extra,
    fields: Fields,
    declarations: Functions
}

export type Readable = {
    state: State,
    names: u8[][],
    types: u32[],
    values: u32[]
}

export type Patched = {
    readable: Readable,
    patch: u32
}

export type Node = {
    state: State,
    id: u32
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    extra: Extra,
    statements: Statements,
    variables: Variables,
    fields: Fields,
    declarations: Functions,
    root: u32,
    serial: u64,
    undefined_count: u64,
    null_count: u64,
    valid: bool
}
