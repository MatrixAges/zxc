import bytes from "std:bytes"
import integers from "std:integer"

import address from "../../../ast/context/address"
import assignment from "../../../ast/context/assignment"
import block from "../../../ast/context/block"
import dereference from "../../../ast/context/dereference"
import identifier from "../../../ast/context/identifier"
import index from "../../../ast/context/index"
import variable from "../../../ast/context/variable"
import forLoop from "../../../ast/statements/for_loop"
import mappingArray from "../begin/array"
import { selected_name, slot_name, slots_name, mapped_label } from "./const"

import type { State, Node as Output } from "../../../ast/context/model"

export type Input = {
    state: State,
    mapping: u32[]
}

export default function (in: Input): Output {
    const selected = identifier({
        state: in.state,
        name: bytes.fromText(selected_name)
    })

    const pointer = identifier({
        state: selected.state,
        name: bytes.fromText(slot_name)
    })

    const slot = dereference({
        state: pointer.state,
        value: pointer.id
    })

    const slots = identifier({
        state: slot.state,
        name: bytes.fromText(slots_name)
    })

    const iterable = address({
        state: slots.state,
        value: selected.id
    })

    const mapping = mappingArray({
        state: iterable.state,
        slots: in.mapping
    })

    const value = index({
        state: mapping.state,
        target: mapping.id,
        index: slot.id
    })

    const body_first = integers.narrow(
        integers.widen(in.state.source.statement_base) +
            value.state.statements.tags.length
    )

    const assigned = assignment({
        state: value.state,
        target: slot.id,
        value: value.id
    })

    const first = assigned.statements.tags.length

    const initialized = variable({
        state: assigned,
        name: bytes.fromText(selected_name),
        type_expr: null,
        value: slots.id
    })

    const traversal = forLoop({
        table: initialized.statements,
        base: in.state.source.statement_base,
        iterable: iterable.id,
        capture: bytes.fromText(slot_name),
        start: body_first,
        count: 1,
        index: null,
        capture_reference: true
    })

    return block({
        state: {
            ...initialized,
            statements: traversal.table,
            valid: initialized.valid && traversal.valid
        },
        label: bytes.fromText(mapped_label),
        first,
        value: selected.id
    })
}
