<Module>
    <Type from="model" as="Adapter" />

    <Args in={Adapter.Input} out={Adapter.Output} />

    <Call fn="initialize" in={$in} />
    <Call fn="context" in={$ctx.initialize} />
    <Call fn="patch" in={$ctx.context} />
    <Call fn="commit" in={$ctx.patch} />
    <Call fn="begin" in={$ctx.commit} />
    <Call fn="finish" in={$ctx.begin} />

    <Return value={$ctx.finish} />
</Module>
