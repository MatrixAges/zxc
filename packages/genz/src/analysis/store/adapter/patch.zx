import bytes from "std:bytes"
import integers from "std:integer"

import field from "../../../ast/context/field"
import identifier from "../../../ast/context/identifier"
import nullValue from "../../../ast/context/null_value"
import object from "../../../ast/context/object"
import append from "../../../ast/fields/append"
import { changes_name } from "./const"
import slotName from "./slot_name"

import type { Readable as Input, Patched as Output } from "./model"

export default function (in: Input): Output {
    const pending = identifier({
        state: in.state.context,
        name: bytes.fromText(changes_name)
    })

    const first = in.state.fields.name.length

    const initialized = loop({
        context: pending.state,
        fields: in.state.fields,
        index: 0
    }, {
        while: current => current.index < in.state.source.store_count,
        next: current => {
            const value = nullValue(current.context)

            current.context = value.state
            current.fields = append({
                table: current.fields,
                name: slotName(current.index),
                value: value.id,
                default_value: null,
                comptime_parameter: false
            })

            current.index += 1
        }
    })

    const mapped = loop({
        context: initialized.context,
        fields: initialized.fields,
        index: 0
    }, {
        while: current => current.index < in.state.source.mapping.length,
        next: current => {
            const value = field({
                state: current.context,
                target: pending.id,
                name: slotName(current.index)
            })

            const slot = first + integers.widen(
                in.state.source.mapping[current.index]
            )

            current.context = value.state
            current.fields.value[slot] = value.id
            current.index += 1
        }
    })

    const type_node = identifier({
        state: mapped.context,
        name: in.state.source.pending_name
    })

    const patch = object({
        state: type_node.state,
        type_expr: type_node.id,
        first: integers.narrow(
            integers.widen(in.state.source.bases.field_base) + first
        ),
        count: integers.narrow(in.state.source.store_count)
    })

    return {
        readable: {
            ...in,
            state: {
                ...in.state,
                context: patch.state,
                fields: mapped.fields
            }
        },
        patch: patch.id
    }
}
