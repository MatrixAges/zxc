import integers from "std:integer"

import type { Output as Regions } from "../regions/model"
import type { Input as Output } from "../request/model"
import type { Input as Source } from "./model"

export type Input = {
    source: Source,
    storage_count: u64,
    lifecycle_count: u64,
    regions: Regions
}

export default function (in: Input): Output {
    const regions = in.regions

    return {
        objects: in.source.objects,
        bases: regions.next,
        declaration_base: integers.narrow(
            in.storage_count + in.lifecycle_count + regions.declarations.tags.length
        ),
        execute: in.source.execute,
        io: in.source.io,
        process: in.source.process
    }
}
