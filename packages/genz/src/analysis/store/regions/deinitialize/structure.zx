import bytes from "std:bytes"
import integers from "std:integer"

import identifier from "../../../../ast/context/identifier"
import pointer from "../../../../ast/context/pointer"
import standardField from "../../../../ast/context/standard_field"
import constant from "../../../../ast/declarations/table/constant"
import header from "../../../../ast/expressions/header"
import optionalType from "../../../../ast/expressions/optional_type"
import appendFields from "../../../../ast/fields/append_values"
import { ExpressionsKind } from "../../../../printer/model/expressions"
import { arena_name } from "../../lifecycle/const"
import { arena_allocator_name, heap_name, region_name } from "../../storage/const"
import { next_name } from "../const"

import type { State as Input, State as Output } from "../model"

export default function (in: Input): Output {
    const arena = standardField({
        state: in.context,
        path: [
            heap_name,
            arena_allocator_name
        ]
    })

    const region = identifier({
        state: arena.state,
        name: bytes.fromText(region_name)
    })

    const address = pointer({
        state: region.state,
        value: region.id
    })

    const optional = optionalType({
        table: {
            ...address.state.expressions.pick([
                "tags",
                "offsets"
            ]),
            optional_type: in.extra.optional_type
        },
        base: in.source.bases.expression_base,
        value: address.id
    })

    const names = [
        bytes.fromText(arena_name),
        bytes.fromText(next_name)
    ]

    const fields = appendFields({
        table: in.fields,
        names,
        values: [
            arena.id,
            optional.id
        ]
    })

    const structure = header({
        ...optional.table.pick([
            "tags",
            "offsets"
        ]),
        base: in.source.bases.expression_base,
        kind: ExpressionsKind.StructType,
        offset: in.extra.struct_type_start.length
    })

    const declared = constant({
        state: in.declarations,
        value: {
            name: bytes.fromText(region_name),
            value: structure.id,
            type_expr: null,
            exported: false
        }
    })

    return {
        ...in,
        context: {
            ...address.state,
            expressions: {
                ...address.state.expressions,
                ...structure.pick([
                    "tags",
                    "offsets"
                ])
            },
            valid: address.state.valid && optional.valid && structure.valid
        },
        fields,
        declarations: declared.state,
        extra: {
            optional_type: optional.table.optional_type,
            struct_type_start: in.extra.struct_type_start.push(
                in.source.bases.field_base + integers.narrow(in.fields.name.length)
            )[0],
            struct_type_len:
                in.extra.struct_type_len.push(integers.narrow(names.length))[0]
        },
        valid: in.valid && declared.valid
    }
}
