import initialize from "../../../ast/context/initialize"
import invoke from "./invoke"
import target from "./target"

import type { Input as Bases } from "../../../ast/context/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Method } from "./invoke"

export type Input = {
    value?: u32,
    name?: u8[],
    method: Method,
    fallible: bool,
    bases: Bases
}

export type Output = {
    expressions: Expressions,
    root: u32,
    valid: bool
}

export default function (in: Input): Output {
    const future = target({
        state: initialize(in.bases),
        value: in.value,
        name: in.name
    })

    const result = invoke({
        state: future.state,
        future: future.id,
        method: in.method,
        fallible: in.fallible
    })

    return {
        expressions: result.state.expressions,
        root: result.id,
        valid: result.state.valid
    }
}
