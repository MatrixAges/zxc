import initialize from "../../../ast/context/initialize"
import result from "../../../ast/context/result"
import emptyFunctions from "../../../ast/declarations/empty_functions"
import errorUnion from "../../../ast/expressions/error_union"

import type { Input, State as Output } from "./finish_model"

export default function (in: Input): Output {
    const context = result({
        state: initialize(in.bases),
        value: in.value
    })

    const type_node = errorUnion({
        table: {
            ...context.expressions.pick([
                "tags",
                "offsets"
            ]),
            error_union_payload: [],
            error_union_errors: [],
            error_union_inferred: []
        },
        base: in.bases.expression_base,
        payload: in.output_type,
        errors: in.errors,
        inferred: false
    })

    return {
        source: in,
        context: {
            ...context,
            expressions: {
                ...context.expressions,
                ...type_node.table.pick([
                    "tags",
                    "offsets"
                ])
            },
            valid: context.valid && type_node.valid
        },
        extra: {
            ...type_node.table.omit([
                "tags",
                "offsets"
            ]),
            namespace_type_start: [],
            namespace_type_len: []
        },
        declarations: emptyFunctions({}),
        return_type: type_node.id
    }
}
