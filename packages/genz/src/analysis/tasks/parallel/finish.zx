import integers from "std:integer"

import object from "../../../ast/context/object"
import unit from "../../../ast/context/unit"
import fields from "../../../ast/fields/append_values"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const result = match {
        in.source.object => object({
            state: in.context,
            first: in.source.bases.field_base,
            count: integers.narrow(in.names.length)
        }),
        _ => unit(in.context)
    }

    return {
        expressions: result.state.expressions,
        forms: result.state.forms,
        statements: result.state.statements,
        fields: fields({
            table: {
                name: [],
                value: [],
                default_value: [],
                comptime_parameter: []
            },
            names: in.names,
            values: in.values
        }),
        root: result.id,
        valid: result.state.valid
    }
}
