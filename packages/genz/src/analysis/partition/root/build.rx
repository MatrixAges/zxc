<Module>
    <Type from="model" as="Root" />

    <Args in={Root.Input} out={Root.Output} />

    <Call fn="initialize" in={$in} />
    <Call fn="modules" in={$ctx.initialize} />
    <Call fn="assemble" in={$ctx.modules} />

    <If on={$in.panic_handler}>
        <Call fn="panic" in={$ctx.assemble} />
        <Call fn="publish" in={$ctx.panic} />

        <Return value={$ctx.publish} />
    </If>

    <Call fn="publish" in={$ctx.assemble} />

    <Return value={$ctx.publish} />
</Module>
