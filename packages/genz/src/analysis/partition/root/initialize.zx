import context from "../../../ast/context/initialize"
import declarations from "../../../ast/declarations/builder/initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        source: in,
        context: context({
            capture: null,
            expression_base: 0,
            statement_base: 0,
            field_base: 0,
            serial: 0
        }),
        declarations: declarations(0),
        expressions: {
            tags: [],
            offsets: [],
            builtin_name: [],
            builtin_arguments: []
        },
        strings: [],
        valid: true
    }
}
