import item from "./item"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return loop({
        state: in,
        index: 0
    }, {
        while: current => current.state.valid &&
            current.state.declarations.valid &&
            current.index < in.source.modules.length,
        next: current => {
            current.state = item(current)
            current.index += 1
        },
        return: current => current.state
    })
}
