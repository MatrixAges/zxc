import bytes from "std:bytes"
import { ascii_line_feed, ascii_space } from "core/ascii/const"

import type { Publish as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { out, prefixes, digests, valid } = in

    const position = loop({
        index: 0
    }, {
        while: state => state.index < valid.length,
        next: state => {
            const index = state.index

            if (valid[index]) {
                bytes.write(out, bytes.fromText(prefixes[index]))
                bytes.writeByte(out, ascii_space)
                bytes.write(out, digests[index])
                bytes.writeByte(out, ascii_line_feed)
            }

            state.index += 1
        }
    })
}
