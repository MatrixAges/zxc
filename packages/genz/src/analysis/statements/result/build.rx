<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Input} out={Result.Output} />

    <If on={!$in.transaction}>
        <Call fn="ordinary" in={$in} />

        <Return value={$ctx.ordinary} />
    </If>

    <Call fn="initialize" in={$in} />

    <If on={$in.value != null}>
        <Call fn="save" in={$ctx.initialize} />
        <Call fn="commit" in={$ctx.save} />
        <Call fn="finish" in={$ctx.commit} />

        <Return value={$ctx.finish} />
    </If>

    <Call fn="commit" in={$ctx.initialize} />
    <Call fn="finish" in={$ctx.commit} />

    <Return value={$ctx.finish} />
</Module>
