import header from "../../../ast/statements/header"
import { StatementsKind } from "../../../printer/model/statements"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const result = header({
        tags: in.statement_tags,
        offsets: in.statement_offsets,
        base: 0,
        kind: StatementsKind.Discard,
        offset: 0
    })

    return {
        ...in,
        statement_tags: result.tags,
        statement_offsets: result.offsets,
        discard: [in.reference],
        valid: in.valid && result.valid
    }
}
