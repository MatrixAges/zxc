import bytes from "std:bytes"
import integers from "std:integer"
import { max_u32 } from "core/const"

import { ExpressionsKind } from "../../../printer/model/expressions"
import integer from "../../../printer/text/integer"
import { pending_name, store_prefix } from "../../store/const"

export type Input = {
    slot: u32,
    base: u32
}

export type Nodes = {
    tags: ExpressionsKind[],
    offsets: u32[],
    identifier: u8[][],
    field_target: u32[],
    field_name: u8[][]
}

export type Output = {
    nodes: Nodes,
    root: u32,
    valid: bool
}

export default function (in: Input): Output {
    if (in.base > max_u32 - 2) {
        return {
            nodes: {
                tags: [],
                offsets: [],
                identifier: [],
                field_target: [],
                field_name: []
            },
            root: 0,
            valid: false
        }
    }

    const name = integer({
        output: bytes.fromText(store_prefix),
        value: integers.widen(in.slot)
    })

    return {
        nodes: {
            tags: [
                ExpressionsKind.Identifier,
                ExpressionsKind.Field
            ],
            offsets: [
                0,
                0
            ],
            identifier: [bytes.fromText(pending_name)],
            field_target: [in.base],
            field_name: [name]
        },
        root: in.base + 1,
        valid: true
    }
}
