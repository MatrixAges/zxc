import discard from "../../../ast/context/discard"

import type { State } from "./model"

export type Input = {
    state: State,
    name: u8[]
}

export type Output = State

export default function (in: Input): Output {
    const result = discard({
        state: in.state.context,
        values: in.state.discard,
        name: in.name
    })

    return {
        ...in.state,
        context: result.state,
        discard: result.values
    }
}
