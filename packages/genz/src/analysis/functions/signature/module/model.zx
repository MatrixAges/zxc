import type { Columns as Functions } from "../../../../ast/declarations/function"
import type { Columns as Constants } from "../../../../ast/declarations/model"
import type {
    ExpressionsKind,
    ExpressionsBuiltinName
} from "../../../../printer/model/expressions"
import type { StatementsKind } from "../../../../printer/model/statements"

export type Prototype = {
    parameters_start: u32,
    parameters_count: u32,
    return_type: u32,
    abi_export: bool,
    calling_convention?: u32
}

export type Input = {
    name: u8[],
    regular?: Prototype,
    value?: Prototype,
    expression_base: u32,
    declaration_base: u32,
    statement_base: u32
}

export type Expressions = {
    tags: ExpressionsKind[],
    offsets: u32[],
    namespace_type_start: u32[],
    namespace_type_len: u32[],
    field_target: u32[],
    field_name: u8[][],
    builtin_name: ExpressionsBuiltinName[],
    builtin_arguments: u32[][]
}

export type State = {
    source: Input,
    expressions: Expressions,
    functions: Functions,
    aliases: Constants,
    valid: bool
}

export type Statements = {
    tags: StatementsKind[],
    offsets: u32[]
}

export type Output = {
    expressions: Expressions,
    functions: Functions,
    aliases: Constants,
    roots: Constants,
    statements: Statements,
    valid: bool
}
