import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Columns as Fields } from "../../../ast/fields/model"
import type { ExpressionsPrimitive } from "../../../printer/model/expressions"

export type Input = {
    name: u8[],
    input_type: u32,
    output_type: u32,
    store_count: u64,
    io: bool,
    process: bool,
    errors?: u8[][],
    exported: bool,
    inlined: bool,
    bases: Bases
}

export type State = {
    context: Context,
    fields: Fields
}

export type Prepared = {
    source: Input,
    state: State
}

export type Forms = {
    pointer: u32[],
    primitive: ExpressionsPrimitive[]
}

export type Extra = {
    error_union_payload: u32[],
    error_union_errors: u8[][]?[],
    error_union_inferred: bool[]
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    extra: Extra,
    parameters: Fields,
    name: u8[],
    return_type: u32,
    exported: bool,
    inlined: bool,
    valid: bool
}
