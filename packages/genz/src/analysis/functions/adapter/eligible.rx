<Module>
    <Type from="model" as="Adapter" />

    <Args in={Adapter.Eligibility} out={Adapter.Eligible} />

    <Call fn="available" in={$in} />

    <If on={$ctx.available}>
        <Call
            fn="../../state/queries/function_layout"
            in={{
                input: $in.input,
                output: $in.output
            }}
        />

        <Return value={$ctx.function_layout.enter} />
    </If>

    <Return value={false} />
</Module>
