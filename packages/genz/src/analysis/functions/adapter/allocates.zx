import bytes from "std:bytes"

import { out_of_memory_name } from "../../growth/declarations/const"

export type Input = string[]

export type Output = bool

export default function (in: Input): Output {
    const name = bytes.fromText(out_of_memory_name)
    const index: u64 = 0

    return loop({
        index,
        found: false
    }, {
        while: state => state.index < in.length && !state.found,
        next: state => {
            state.found = bytes.equals(bytes.fromText(in[state.index]), name)
            state.index += 1
        },
        return: state => state.found
    })
}
