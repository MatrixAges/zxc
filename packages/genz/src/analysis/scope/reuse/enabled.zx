import { minimum_bindings } from "./const"

export type Input = {
    state_active: bool,
    bindings: u64,
    iteration: bool,
    loop_fields: bool
}

export type Output = bool

export default function (in: Input): Output {
    const blocked = (
        - !in.state_active
        - or in.bindings < minimum_bindings
        - or in.iteration
        - or in.loop_fields
    )

    return !blocked
}
