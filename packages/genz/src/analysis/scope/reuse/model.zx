import type { Expressions } from "core/expression_table/model"
import type { Last } from "../reads/model"

export type Candidates = {
    bindings: u32[],
    previous: u32[],
    types: u32[]
}

export type Input = {
    expressions: Expressions,
    bindings: u32[],
    symbols: u32?[],
    symbol_types: u32[],
    result: u32,
    candidates: Candidates
}

export type Plan = {
    changes: u32?[],
    variables: bool[]
}

export type Output = Plan?

export type Preparation = {
    source: Input,
    last: Last
}

export type Work = {
    source: Input,
    last: Last,
    bound: Last,
    changes: u32?[],
    variables: bool[],
    binding: u64,
    candidate: u64
}
