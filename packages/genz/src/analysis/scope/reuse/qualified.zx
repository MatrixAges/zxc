import integers from "std:integer"

import type { Input as Source } from "./model"

export type Input = {
    source: Source,
    row: u64
}

export type Output = bool

export default function (in: Input): Output {
    const binding = integers.widen(in.source.candidates.bindings[in.row])
    const symbol = in.source.symbols[binding]

    if (symbol == null || symbol == in.source.candidates.previous[in.row]) {
        return false
    }

    return in.source.symbol_types[integers.widen(symbol)] ==
        in.source.candidates.types[in.row]
}
