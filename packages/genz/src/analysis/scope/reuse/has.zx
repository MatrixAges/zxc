import qualified from "./qualified"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        row: 0,
        found: false
    }, {
        while: state => state.row < in.candidates.bindings.length && !state.found,
        next: state => {
            state.found = qualified({
                source: in,
                row: state.row
            })
            state.row += 1
        },
        return: state => state.found
    })
}
