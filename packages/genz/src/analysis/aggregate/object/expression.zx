import integers from "std:integer"

import { ExpressionsKind } from "../../../printer/model/expressions"

import type { Columns as Output } from "../../../ast/expressions/object"

export type Input = {
    type_expr: u32,
    first: u32,
    count: u64
}

export default function (in: Input): Output {
    return {
        tags: [ExpressionsKind.Object],
        offsets: [0],
        object_type_expr: [in.type_expr],
        object_fields_start: [in.first],
        object_fields_len: [integers.narrow(in.count)]
    }
}
