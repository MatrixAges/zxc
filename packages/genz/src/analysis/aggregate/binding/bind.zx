import { StatementsKind } from "../../../printer/model/statements"
import reference from "./reference"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const value = reference(in.pick([
        "expression_base",
        "serial"
    ]))

    return {
        ...value,
        statements: {
            tags: [StatementsKind.Constant],
            offsets: [0],
            constant_name: [value.name],
            constant_type_expr: [null],
            constant_value: [in.value],
            constant_exported: [false],
            break_value_label: [],
            break_value_value: []
        }
    }
}
