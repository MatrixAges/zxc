import { max_u32 } from "core/const"

import { operand_prefix } from "../../../ast/context/const"
import fresh from "../../../ast/fresh"
import { ExpressionsKind } from "../../../printer/model/expressions"
import { StatementsKind } from "../../../printer/model/statements"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const name = fresh({
        serial: in.serial,
        prefix: operand_prefix
    })

    return {
        expressions: {
            tags: [ExpressionsKind.Identifier],
            offsets: [0],
            identifier: [name.name],
            block_label: [],
            block_statements_start: [],
            block_statements_len: []
        },
        statements: {
            tags: [StatementsKind.Constant],
            offsets: [0],
            constant_name: [name.name],
            constant_type_expr: [null],
            constant_value: [in.value],
            constant_exported: [false],
            break_value_label: [],
            break_value_value: []
        },
        name: name.name,
        serial: name.serial,
        root: in.expression_base,
        valid: in.expression_base < max_u32
    }
}
