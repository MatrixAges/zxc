import { max_u32 } from "core/const"

import { operand_prefix } from "../../../ast/context/const"
import fresh from "../../../ast/fresh"
import { ExpressionsKind } from "../../../printer/model/expressions"

import type { Expressions } from "./model"

export type Input = {
    expression_base: u32,
    serial: u64
}

export type Output = {
    expressions: Expressions,
    name: u8[],
    serial: u64,
    root: u32,
    valid: bool
}

export default function (in: Input): Output {
    const name = fresh({
        serial: in.serial,
        prefix: operand_prefix
    })

    return {
        expressions: {
            tags: [ExpressionsKind.Identifier],
            offsets: [0],
            identifier: [name.name],
            block_label: [],
            block_statements_start: [],
            block_statements_len: []
        },
        name: name.name,
        serial: name.serial,
        root: in.expression_base,
        valid: in.expression_base < max_u32
    }
}
