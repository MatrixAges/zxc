import initialize from "../../ast/context/initialize"

import type { Input as Source, Policy, State as Output } from "./model"

export type Input = {
    source: Source,
    policy: Policy
}

export default function (in: Input): Output {
    return {
        ...in,
        context: initialize({
            ...in.source.pick([
                "expression_base",
                "statement_base",
                "serial"
            ]),
            field_base: 0
        })
    }
}
