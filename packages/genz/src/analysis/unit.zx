import type { Contracts } from "core/contract_table/model"
import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Stores } from "core/store_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { Table } from "core/type_table/model"

export type Unit = {
    input_type: u32
    output_type: u32
    symbols: Symbols
    expressions: Expressions
    control: Control
    root: u32?
        stores: Stores
    contracts: Contracts
    external: bool
}

export type Call = { expression: u32, lane: u64 }

export type Iteration = { expression: u32, path: u32[] }

export type Lane = {
    input: u32[]
    output: u32[]
    appends: u32[]
    pops: u32[]
    updates: u32[]
    iterations: Iteration[]
    calls: Call[]
    rejected: bool
}

export type Lanes = Lane[]

export type Units = { types: Table, units: Unit[], entry: u64 }
