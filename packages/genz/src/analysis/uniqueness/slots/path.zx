import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import locate from "./locate"

import type { Query as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const steps: u32[] = []

    return loop({
        current: in.layout.unwrapped[integers.widen(in.type_id)],
        remaining: in.slot,
        steps
    }, {
        while: (state, context) =>
            kind(context.kinds[integers.widen(state.current)]) != Kind.List,
        next: (state, context) => {
            const owner = integers.widen(state.current)
            const step = locate({
                offsets: context.layout.offsets[owner],
                slot: state.remaining
            })

            state.steps = state.steps.push(step)[0]
            state.remaining -= context.layout.offsets[owner][integers.widen(step)]
            const selected = context.layout.members[owner][integers.widen(step)]
            state.current = context.layout.unwrapped[integers.widen(selected)]
        }
    }, in)
        -> _.steps
}
