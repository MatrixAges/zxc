import integers from "std:integer"
import { type_id_string } from "core/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import sum from "./sum"

import type { Facts, Types } from "./model"

export type Input = Types

export type Output = Facts

export default function (in: Input): Output {
    const counts: u32[] = in.kinds.map(code => 0)
    const texts: bool[] = in.kinds.map(code => false)

    const result = loop({
        types: in,
        counts: counts,
        texts: texts,
        index: 0
    }, {
        while: current => current.index < current.types.kinds.length,
        next: current => {
            const target = kind(current.types.kinds[current.index])
            const first = integers.widen(current.types.first[current.index])

            if (target == Kind.Scalar) {
                current.texts[current.index] = first == integers.widen(type_id_string)
            } else if (target == Kind.Task) {
                current.texts[current.index] = current.texts[first]
            } else if (target == Kind.List) {
                current.texts[current.index] = current.texts[first]
                current.counts[current.index] = 1
            } else if (target == Kind.Optional) {
                current.counts[current.index] = current.counts[first]
                current.texts[current.index] = current.texts[first]
            } else if (target == Kind.Object || target == Kind.Tuple) {
                const total = sum({
                    counts: current.counts,
                    texts: current.texts,
                    members: target == Kind.Object ? current.types.field_types :
                        current.types.children,
                    first: first,
                    count: integers.widen(
                        current.types.second[current.index]
                    )
                })

                current.counts[current.index] = total.count
                current.texts[current.index] = total.text
            }

            current.index += 1
        }
    })

    return {
        counts: result.counts,
        texts: result.texts
    }
}
