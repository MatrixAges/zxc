import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Layout, Types } from "./model"

export type Input = {
    types: Types,
    counts: u32[]
}

export type Output = Layout

export default function (in: Input): Output {
    const empty: u32[] = []
    const offsets: u32[][] = []
    const members: u32[][] = []
    const unwrapped: u32[] = in.types.kinds.map(code => 0)

    const result = loop({
        types: in.types,
        counts: in.counts,
        empty: empty,
        offsets: offsets,
        members: members,
        unwrapped: unwrapped,
        index: 0
    }, {
        while: current => current.index < current.types.kinds.length,
        next: current => {
            const target = kind(current.types.kinds[current.index])
            const first = integers.widen(current.types.first[current.index])
            const product = target == Kind.Object || target == Kind.Tuple

            const values = loop({
                types: current.types,
                counts: current.counts,
                object: target == Kind.Object,
                first: first,
                count:
                    product ? integers.widen(
                        current.types.second[current.index]
                    ) : 0,
                index: 0,
                total: integers.narrow(0),
                offsets: current.empty,
                members: current.empty
            }, {
                while: member => member.index < member.count,
                next: member => {
                    const position = member.first + member.index
                    const child =
                        member.object ? member.types.field_types[position] :
                        member.types.children[position]

                    member.offsets = member.offsets.push(member.total)[0]
                    member.members = member.members.push(child)[0]
                    member.total += member.counts[integers.widen(child)]
                    member.index += 1
                }
            })

            current.offsets = current.offsets.push(values.offsets)[0]
            current.members = current.members.push(values.members)[0]
            current.unwrapped[current.index] =
                target == Kind.Optional ? current.unwrapped[first] :
                integers.narrow(
                    current.index
                )
            current.index += 1
        }
    })

    return {
        offsets: result.offsets,
        members: result.members,
        unwrapped: result.unwrapped
    }
}
