<Module>
    <Type from="model" as="Slots" />

    <Args in={Slots.Types} out={Slots.Plan} />

    <Call fn="facts" in={$in} />

    <Call
        fn="layout"
        in={{
            types: $in,
            counts: $ctx.facts.counts
        }}
    />

    <Return
        value={{
            counts: $ctx.facts.counts,
            texts: $ctx.facts.texts,
            offsets: $ctx.layout.offsets,
            members: $ctx.layout.members,
            unwrapped: $ctx.layout.unwrapped
        }}
    />
</Module>
