export type Types = {
    kinds: u8[],
    first: u32[],
    second: u32[],
    children: u32[],
    field_types: u32[]
}

export type Layout = {
    offsets: u32[][],
    members: u32[][],
    unwrapped: u32[]
}

export type Plan = {
    counts: u32[],
    texts: bool[],
    offsets: u32[][],
    members: u32[][],
    unwrapped: u32[]
}

export type Facts = {
    counts: u32[],
    texts: bool[]
}

export type Query = {
    layout: Layout,
    kinds: u8[],
    type_id: u32,
    slot: u32
}
