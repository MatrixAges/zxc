import { ExpressionKind } from "core/expression_table/kinds"

import {
    integer_tag,
    negative_integer_tag,
    float_tag,
    string_tag,
    boolean_tag,
    none_tag,
    unit_tag,
    some_tag,
    capture_tag,
    task_tag,
    await_task_tag,
    cancel_task_tag,
    parallel_tag,
    optional_value_tag,
    enum_value_tag,
    error_value_tag,
    reference_tag,
    store_get_tag,
    field_tag,
    index_tag,
    length_tag,
    list_tag,
    tuple_tag,
    tuple_field_tag,
    template_tag,
    list_operation_tag,
    transform_tag,
    scope_tag,
    iteration_tag,
    list_update_tag,
    call_tag,
    unary_tag,
    binary_tag,
    conditional_tag,
    match_expr_tag,
    object_tag
} from "./const"

export type Input = ExpressionKind

export type Output = string

export default function (in: Input): Output {
    return match in {
        ExpressionKind.Integer => integer_tag,
        ExpressionKind.NegativeInteger => negative_integer_tag,
        ExpressionKind.Float => float_tag,
        ExpressionKind.String => string_tag,
        ExpressionKind.Boolean => boolean_tag,
        ExpressionKind.None => none_tag,
        ExpressionKind.Unit => unit_tag,
        ExpressionKind.Some => some_tag,
        ExpressionKind.Capture => capture_tag,
        ExpressionKind.Task => task_tag,
        ExpressionKind.AwaitTask => await_task_tag,
        ExpressionKind.CancelTask => cancel_task_tag,
        ExpressionKind.Parallel => parallel_tag,
        ExpressionKind.OptionalValue => optional_value_tag,
        ExpressionKind.EnumValue => enum_value_tag,
        ExpressionKind.ErrorValue => error_value_tag,
        ExpressionKind.Reference => reference_tag,
        ExpressionKind.StoreGet => store_get_tag,
        ExpressionKind.Field => field_tag,
        ExpressionKind.Index => index_tag,
        ExpressionKind.Length => length_tag,
        ExpressionKind.List => list_tag,
        ExpressionKind.Tuple => tuple_tag,
        ExpressionKind.TupleField => tuple_field_tag,
        ExpressionKind.Template => template_tag,
        ExpressionKind.ListOperation => list_operation_tag,
        ExpressionKind.Transform => transform_tag,
        ExpressionKind.Scope => scope_tag,
        ExpressionKind.Iteration => iteration_tag,
        ExpressionKind.ListUpdate => list_update_tag,
        ExpressionKind.Call => call_tag,
        ExpressionKind.Unary => unary_tag,
        ExpressionKind.Binary => binary_tag,
        ExpressionKind.Conditional => conditional_tag,
        ExpressionKind.Match => match_expr_tag,
        _ => object_tag
    }
}
