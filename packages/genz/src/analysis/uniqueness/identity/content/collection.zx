import crypto from "std:crypto"
import integers from "std:integer"

import ids from "../types/ids"
import collectionKind from "./collection_kind"

import type { Row as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(
        in.hash,
        collectionKind(in.expressions.collection_kinds[in.payload])
    )

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.collection_targets[in.payload])
    )

    ids({
        hash: in.hash,
        values: in.expressions.collection_arguments,
        first: integers.widen(in.expressions.collection_first[in.payload]),
        count: integers.widen(in.expressions.collection_count[in.payload])
    })
}
