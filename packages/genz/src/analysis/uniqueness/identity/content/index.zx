import crypto from "std:crypto"
import integers from "std:integer"

import type { Row as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.index_targets[in.payload])
    )

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.index_values[in.payload])
    )
}
