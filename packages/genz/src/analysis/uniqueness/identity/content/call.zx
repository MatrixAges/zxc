import crypto from "std:crypto"
import integers from "std:integer"

import ids from "../types/ids"

import type { Row as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.call_functions[in.payload])
    )

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.call_arguments[in.payload])
    )

    ids({
        hash: in.hash,
        values: in.expressions.call_stores,
        first: integers.widen(in.expressions.call_store_first[in.payload]),
        count: integers.widen(in.expressions.call_store_count[in.payload])
    })
}
