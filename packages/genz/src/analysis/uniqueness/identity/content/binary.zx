import crypto from "std:crypto"
import integers from "std:integer"

import binaryOperator from "./binary_operator"

import type { Row as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(
        in.hash,
        binaryOperator(in.expressions.binary_operators[in.payload])
    )

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.binary_left[in.payload])
    )

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.binary_right[in.payload])
    )
}
