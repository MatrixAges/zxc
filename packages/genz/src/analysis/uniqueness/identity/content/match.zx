import crypto from "std:crypto"
import integers from "std:integer"

import ids from "../types/ids"
import optional from "./optional"

import type { Row as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    optional({
        hash: in.hash,
        value: in.expressions.match_subjects[in.payload]
    })

    ids({
        hash: in.hash,
        values: in.expressions.match_conditions,
        first: integers.widen(in.expressions.match_first[in.payload]),
        count: integers.widen(in.expressions.match_count[in.payload])
    })

    ids({
        hash: in.hash,
        values: in.expressions.match_results,
        first: integers.widen(in.expressions.match_first[in.payload]),
        count: integers.widen(in.expressions.match_count[in.payload])
    })

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.match_count[in.payload])
    )

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.match_fallbacks[in.payload])
    )
}
