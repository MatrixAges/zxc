import crypto from "std:crypto"
import integers from "std:integer"

import unaryOperator from "./unary_operator"

import type { Row as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(
        in.hash,
        unaryOperator(in.expressions.unary_operators[in.payload])
    )

    crypto.updateSha256U64Le(
        in.hash,
        integers.widen(in.expressions.unary_operands[in.payload])
    )
}
