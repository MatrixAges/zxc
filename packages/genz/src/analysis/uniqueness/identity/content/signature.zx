import crypto from "std:crypto"
import integers from "std:integer"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(in.hash, integers.widen(in.input_type))
    crypto.updateSha256U64Le(in.hash, integers.widen(in.output_type))
}
