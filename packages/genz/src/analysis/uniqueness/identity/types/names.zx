import bytes from "std:bytes"
import crypto from "std:crypto"

import frame from "../bytes"

import type { Names as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(in.hash, in.count)

    const result = loop({
        index: 0
    }, {
        while: state => state.index < in.count,
        next: state => {
            frame({
                hash: in.hash,
                bytes: bytes.fromText(in.values[in.first + state.index])
            })

            state.index += 1
        }
    })
}
