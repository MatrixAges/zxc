import bytes from "std:bytes"
import crypto from "std:crypto"

import frame from "../bytes"
import { identity_domain } from "./const"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.resetSha256(in.hash)

    frame({
        hash: in.hash,
        bytes: bytes.fromText(identity_domain)
    })

    crypto.updateSha256U64Le(in.hash, in.types.kinds.length)
}
