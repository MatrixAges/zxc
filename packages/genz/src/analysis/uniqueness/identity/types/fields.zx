import crypto from "std:crypto"
import integers from "std:integer"

import ids from "./ids"
import names from "./names"

import type { Row as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const first = integers.widen(in.types.first[in.index])
    const count = integers.widen(in.types.second[in.index])

    names({
        hash: in.hash,
        values: in.types.field_names,
        first,
        count
    })

    ids({
        hash: in.hash,
        values: in.types.field_types,
        first,
        count
    })

    crypto.updateSha256U64Le(in.hash, count)
}
