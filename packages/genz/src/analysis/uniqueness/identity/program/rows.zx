import crypto from "std:crypto"

import frame from "./bytes"

import type { Rows as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    crypto.updateSha256U64Le(in.hash, in.rows.length)

    const result = loop({
        index: 0
    }, {
        while: state => state.index < in.rows.length,
        next: state => {
            frame({
                hash: in.hash,
                bytes: in.rows[state.index]
            })

            state.index += 1
        }
    })
}
