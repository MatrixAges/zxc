export type Input = {
    return_only: bool,
    held: bool[],
    written: bool[]
}

export type Output = bool

export default function (in: Input): Output {
    if (!in.return_only || in.held.length != in.written.length) {
        return false
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.written.length,
        next: state => {
            state.valid = !in.written[state.index]
            state.index += 1
        },
        return: state => state.valid
    })
}
