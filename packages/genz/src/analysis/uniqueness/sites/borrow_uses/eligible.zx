import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"

import { Role } from "../../order/model"

import type { Selected as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const input = in.source
    const site = input.rows[in.site]

    if (site.role != Role.argument || site.parent == max_u32) {
        return false
    }

    const parent = integers.widen(site.parent)
    const expressions = input.source.expressions

    if (expressions.kinds[parent] != ExpressionKind.Call) {
        return false
    }

    const payload = integers.widen(expressions.payloads[parent])
    const callee = integers.widen(expressions.call_functions[payload])

    if (!input.source.effects.borrow_only[callee]) {
        return false
    }

    const first = integers.widenSigned(site.lo) + site.delta
    const end = integers.widenSigned(site.hi) + site.delta
    const held = input.source.held[callee]

    if (first < 0 || end > integers.widenSigned(integers.narrow(held.length))) {
        return false
    }

    const retained = loop({
        slot: integers.narrowSigned(first),
        found: false
    }, {
        while: state => !state.found && integers.widenSigned(state.slot) < end,
        next: state => {
            state.found = held[integers.widen(state.slot)]
            state.slot += 1
        },
        return: state => state.found
    })

    if (!retained) {
        return false
    }

    const root = input.source.symbols.length + parent

    return loop({
        index: integers.widen(input.plan.first[root]),
        valid: true
    }, {
        while: state => state.valid &&
            state.index < integers.widen(input.plan.first[root + 1]),
        next: state => {
            state.valid = input.plan.sites.role[state.index] == Role.observe

            const parent = input.plan.sites.parent[state.index]

            if (state.valid && parent != max_u32) {
                state.valid = expressions.kinds[integers.widen(parent)] !=
                    ExpressionKind.Call
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
