import integers from "std:integer"

import { Role } from "../order/model"

import type { Query } from "./model"

export type Input = {
    query: Query,
    site: u64
}

export type Output = Role

export default function (in: Input): Output {
    const query = in.query
    const sites = query.plan.sites
    const role = sites.role[in.site]

    if (role != Role.argument) {
        return role
    }

    const callee = integers.widen(sites.parent[in.site])
        -> integers.widen(query.expressions.payloads[_])
        -> integers.widen(query.expressions.call_functions[_])

    const slot = integers.widen(
        integers.narrowSigned(
            integers.widenSigned(query.slot) + sites.delta[in.site]
        )
    )

    const held = query.held[callee]
    const written = query.written[callee]

    return (
        - slot >= held.length
        - or held[slot]
        - or slot >= written.length
        - or written[slot]
    )
        -> (_ ? Role.use : Role.observe)
}
