import integers from "std:integer"

import { Role } from "../order/model"
import before from "./before"
import exclusive from "./exclusive"
import role from "./role"

import type { Query as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const root = integers.widen(in.root)
    const first = integers.widen(in.plan.first[root])
    const end = integers.widen(in.plan.first[root + 1])

    const home = root < in.symbols ? in.def_loop[root] :
        in.nodes.repeated[root - in.symbols]

    return loop({
        query: in,
        first,
        end,
        home,
        index: first,
        valid: true
    }, {
        while: current => current.valid && current.index < current.end,
        next: current => {
            const query = current.query
            const sites = query.plan.sites
            const index = current.index
            const contains =
                query.slot >= sites.lo[index] && query.slot < sites.hi[index]

            if (contains) {
                const observation = role({
                    query,
                    site: index
                }) == Role.observe

                if (query.observe) {
                    current.valid = observation
                } else if (!observation) {
                    current.valid =
                        query.nodes.repeated[integers.widen(
                            sites.top[index]
                        )] == current.home

                    if (current.valid) {
                        current.valid = loop({
                            query,
                            site: index,
                            index: current.first,
                            end: current.end,
                            valid: true
                        }, {
                            while: pair => pair.valid && pair.index < pair.end,
                            next: pair => {
                                const sites = pair.query.plan.sites
                                const index = pair.index
                                const site = pair.site
                                const overlaps = pair.query.slot >= sites.lo[index] &&
                                    pair.query.slot < sites.hi[index]
                                const same = sites.edge[index] == sites.edge[site] &&
                                    sites.delta[index] == sites.delta[site]

                                if (index != site && overlaps && !same && !exclusive({
                                    query: pair.query,
                                    left: site,
                                    right: index
                                })) {
                                    pair.valid = role({
                                        query: pair.query,
                                        site: index
                                    }) == Role.observe && before({
                                        query: pair.query,
                                        observation: index,
                                        consumer: site
                                    })
                                }

                                pair.index += 1
                            },
                            return: state => state.valid
                        })
                    }
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
