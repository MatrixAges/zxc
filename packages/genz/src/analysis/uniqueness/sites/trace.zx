import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"

import { Role } from "../order/model"
import enter from "./enter"
import projectedRange from "./projection_range"
import push from "./push"

import type { Frame, Site, Walk } from "./model"

export type Input = {
    walk: Walk,
    node: u32,
    size: u32,
    sites: Site[]
}

export type Output = Site[]

export default function (in: Input): Output {
    const frames: Frame[] = []
    const cursors: u64[] = []

    const stack = push({
        stack: {
            top: max_u32,
            frames,
            cursors
        },
        consumers: in.walk.consumers,
        node: in.node,
        frame: {
            parent: max_u32,
            node: in.node,
            end: 0,
            region: 0,
            a: 0,
            b: 0,
            c: 0,
            d: 0,
            arms: 0,
            delta: 0,
            lo: 0,
            hi: in.size
        }
    })

    const readonly_loop_initial = {
        stack,
        sites: in.sites
    }

    const readonly_walk = in.walk

    return loop(readonly_loop_initial, {
        while: current => current.stack.top != max_u32,
        next: current => {
            const top = integers.widen(current.stack.top)
            const frame = current.stack.frames[top]
            const cursor = current.stack.cursors[top]

            if (cursor == frame.end) {
                current.stack.top = frame.parent
            } else {
                const source = readonly_walk.source
                const edges = source.edges
                const edge = integers.widen(readonly_walk.consumers.items[cursor])
                const role = edges.role[edge]
                const region = edges.region[edge]
                const parent = edges.parent[edge]
                const anchor = match {
                    source.regions.depth[integers.widen(region)] >
                        source.regions.depth[integers.widen(frame.region)] => region,
                    _ => frame.region
                }

                current.stack.cursors[top] += 1

                if (role != Role.evaluation) {
                    const arms = enter({
                        regions: source.regions,
                        arms: {
                            a: frame.a,
                            b: frame.b,
                            c: frame.c,
                            d: frame.d,
                            count: frame.arms
                        },
                        region
                    })

                    const path = {
                        ...frame,
                        region: anchor,
                        a: arms.a,
                        b: arms.b,
                        c: arms.c,
                        d: arms.d,
                        arms: arms.count
                    }

                    if (role == Role.flow || role == Role.member) {
                        const type_id = integers.widen(
                            source.expressions.types[integers.widen(
                                parent
                            )]
                        )

                        const owner = integers.widen(source.layout.unwrapped[type_id])

                        const offset = match {
                            role == Role.member =>
                                source.layout.offsets[owner][integers.widen(
                                    edges.index[edge]
                                )],
                            _ => 0
                        }

                        current.stack = push({
                            stack: current.stack,
                            consumers: readonly_walk.consumers,
                            node: parent,
                            frame: {
                                ...path,
                                delta: frame.delta + integers.widenSigned(
                                    offset
                                )
                            }
                        })
                    } else if (role == Role.bind) {
                        const symbol = integers.widen(edges.index[edge])

                        const first =
                            integers.widen(readonly_walk.references.first[symbol])
                        const references = readonly_walk.references.items

                        const loop_initial = {
                            stack: current.stack,
                            end: integers.widen(
                                readonly_walk.references.first[symbol + 1]
                            )
                        }

                        const loop_scope = {
                            first,
                            references,
                            path,
                            consumers: readonly_walk.consumers
                        }

                        current.stack = loop(loop_initial, {
                            while: bind => bind.end > loop_scope.first,
                            next: bind => {
                                bind.end -= 1
                                bind.stack = push({
                                    stack: bind.stack,
                                    consumers: loop_scope.consumers,
                                    node: loop_scope.references[bind.end],
                                    frame: loop_scope.path
                                })
                            },
                            return: state => state.stack
                        })
                    } else {
                        const parent_index = integers.widen(parent)
                        const target = match {
                            parent == max_u32 => ExpressionKind.Unit,
                            _ => source.expressions.kinds[parent_index]
                        }
                        const projected = target == ExpressionKind.Field ||
                            target == ExpressionKind.TupleField
                        const payload = match {
                            parent == max_u32 => 0,
                            _ =>
                                integers.widen(
                                    source.expressions.payloads[parent_index]
                                )
                        }
                        const projection_target = match {
                            projected => source.expressions.projection_targets[payload],
                            _ => max_u32
                        }

                        if (projected && projection_target == frame.node) {
                            const window = projectedRange({
                                source,
                                frame,
                                payload
                            })

                            if (window.first < window.last) {
                                current.stack = push({
                                    stack: current.stack,
                                    consumers: readonly_walk.consumers,
                                    node: parent,
                                    frame: {
                                        ...path,
                                        delta:
                                            frame.delta -
                                            integers.widenSigned(window.offset),
                                        lo: integers.narrowSigned(window.first),
                                        hi: integers.narrowSigned(
                                            window.last
                                        )
                                    }
                                })
                            }
                        } else if (target == ExpressionKind.OptionalValue) {
                            current.stack = push({
                                stack: current.stack,
                                consumers: readonly_walk.consumers,
                                node: parent,
                                frame: path
                            })
                        } else if (target != ExpressionKind.Length) {
                            current.sites = current.sites.push({
                                lo: frame.lo,
                                hi: frame.hi,
                                delta: frame.delta,
                                top: frame.node,
                                region: anchor,
                                a: arms.a,
                                b: arms.b,
                                c: arms.c,
                                d: arms.d,
                                arms: arms.count,
                                edge: readonly_walk.consumers.items[cursor],
                                parent,
                                role
                            })[0]
                        }
                    }
                }
            }
        },
        return: state => state.sites
    })
}
