import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"

import trace from "./trace"

import type { Site, Trace as Output, Walk as Input } from "./model"

export default function (in: Input): Output {
    const first: u32[] = []
    const sites: Site[] = []

    const result = loop({
        first,
        sites,
        root: 0
    }, {
        while: current => current.root < in.source.symbols.length +
            in.source.expressions.kinds.length,
        next: current => {
            const source = in.source
            const symbol = current.root < source.symbols.length
            const node = symbol ? 0 : current.root - source.symbols.length
            const type_id = match {
                symbol => source.symbols[current.root],
                _ => source.expressions.types[node]
            }

            const size = source.counts[integers.widen(type_id)]
            const kind = match {
                symbol => ExpressionKind.Reference,
                _ => source.expressions.kinds[node]
            }
            const reached = symbol || source.nodes.time[node] != max_u32
            const projected = kind == ExpressionKind.Field ||
                kind == ExpressionKind.TupleField || kind == ExpressionKind.OptionalValue

            current.first =
                current.first.push(integers.narrow(current.sites.length))[0]

            const condition = (
                - symbol
                - or size != 0
                - and reached
                - and !projected
            )

            if (condition) {
                if (symbol) {
                    current.sites = loop({
                        sites: current.sites,
                        index: integers.widen(in.references.first[current.root]),
                        end: integers.widen(
                            in.references.first[current.root + 1]
                        )
                    }, {
                        while: references => references.index < references.end,
                        next: references => {
                            const source = in.source
                            const node =
                                in.references.items[references.index]
                            const type_id = source.expressions
                                .types[integers.widen(
                                    node
                                )]

                            const size = source.counts[integers.widen(type_id)]

                            if (size != 0) {
                                references.sites = trace({
                                    walk: in,
                                    node,
                                    size,
                                    sites: references.sites
                                })
                            }

                            references.index += 1
                        },
                        return: state => state.sites
                    })
                } else if (kind != ExpressionKind.Reference) {
                    current.sites = trace({
                        walk: in,
                        node: integers.narrow(node),
                        size,
                        sites: current.sites
                    })
                }
            }

            current.root += 1
        }
    })

    return {
        first: result.first.push(integers.narrow(result.sites.length))[0],
        sites: result.sites
    }
}
