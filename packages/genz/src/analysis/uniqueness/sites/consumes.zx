import integers from "std:integer"

import { Role } from "../order/model"
import role from "./role"

import type { Query } from "./model"

export type Input = {
    query: Query,
    site: u64,
    slot: u64,
    kind: Role
}

export type Output = bool

export default function (in: Input): Output {
    if (in.kind != Role.argument) {
        return true
    }

    return role({
        query: {
            ...in.query,
            slot: integers.narrow(in.slot)
        },
        site: in.site
    }) != Role.observe
}
