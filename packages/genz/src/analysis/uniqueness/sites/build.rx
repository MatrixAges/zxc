<Module>
    <Type from="model" as="Sites" />

    <Args in={Sites.Input} out={Sites.Facts} />

    <Task
        name="plan"
        out={$ctx.build}
    >
        <Call fn="consumers" in={$in} />
        <Call fn="references" in={$in} />
        <Call fn="slots" in={$in} />

        <Call
            fn="walk"
            in={{
                source: $in,
                consumers: $ctx.consumers,
                references: $ctx.references
            }}
        />

        <Call fn="publish" in={$ctx.walk.sites} />

        <Call
            fn="resolve_roles"
            in={{
                source: $in,
                first: $ctx.walk.first,
                sites: $ctx.publish
            }}
        />

        <Call
            module="borrow_uses/build"
            in={{
                source: $in,
                rows: $ctx.walk.sites,
                plan: {
                    edge_count: $in.edges.parent.length,
                    first: $ctx.walk.first,
                    slot_first: $ctx.slots,
                    sites: {
                        ...$ctx.publish,
                        role: $ctx.resolve_roles
                    }
                }
            }}
        />
    </Task>

    <Call
        fn="classify"
        in={{
            source: $in,
            plan: $ctx.task.plan
        }}
    />

    <Return
        value={{
            plan: $ctx.task.plan,
            states: $ctx.classify
        }}
    />
</Module>
