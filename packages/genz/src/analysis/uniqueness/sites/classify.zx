import integers from "std:integer"

import { Role } from "../order/model"
import before from "./before"
import consumes from "./consumes"
import exclusive from "./exclusive"
import { Usage } from "./model"
import observe from "./observed"

import type { Input as Source, Plan, Query } from "./model"

export type Input = {
    source: Source,
    plan: Plan
}

export type Output = Usage[]

export default function (in: Input): Output {
    const empty: Usage[] = []

    const states = loop({
        states: empty,
        count: integers.widen(in.plan.slot_first[in.plan.slot_first.length - 1])
    }, {
        while: current => current.states.length < current.count,
        next: current => {
            current.states = current.states.push(Usage.Observed)[0]
        },
        return: state => state.states
    })

    const shared_query: Query = {
        plan: in.plan,
        nodes: in.source.nodes,
        regions: in.source.regions,
        expressions: in.source.expressions,
        def_loop: in.source.def_loop,
        symbols: in.source.symbols.length,
        held: in.source.held,
        written: in.source.written,
        root: 0,
        slot: 0,
        observe: false
    }

    const loop_initial = {
        states,
        root: 0
    }

    return loop(loop_initial, {
        while: current => current.root + 1 < shared_query.plan.first.length,
        next: current => {
            const query = {
                ...shared_query,
                root: integers.narrow(current.root)
            }
            const base = integers.widen(query.plan.slot_first[current.root])
            const first = integers.widen(query.plan.first[current.root])
            const end = integers.widen(query.plan.first[current.root + 1])
            const home = match {
                current.root < query.symbols => query.def_loop[current.root],
                _ => query.nodes.repeated[current.root - query.symbols]
            }

            const loop_initial_1 = {
                states: current.states,
                index: first
            }

            const loop_scope_1 = {
                query,
                base,
                home,
                first,
                end,
                count: query.plan.slot_first[current.root + 1] -
                    query.plan.slot_first[current.root]
            }

            current.states = loop(loop_initial_1, {
                while: site => site.index < loop_scope_1.end,
                next: site => {
                    const sites = loop_scope_1.query.plan.sites
                    const index = site.index

                    if (sites.role[index] != Role.observe) {
                        const first_slot = integers.widen(sites.lo[index])
                        const observed = observe({
                            states: site.states,
                            query: loop_scope_1.query,
                            base: loop_scope_1.base,
                            site: index,
                            repeated: loop_scope_1.query.nodes
                                .repeated[
                                    integers.widen(
                                        sites.top[index]
                                    )
                                ] != loop_scope_1.home,
                            first: first_slot,
                            end: integers.widen(
                                match {
                                    sites.hi[index] < loop_scope_1.count =>
                                        sites.hi[index],
                                    _ => loop_scope_1.count
                                }
                            )
                        })

                        const loop_initial_2 = {
                            states: observed.states,
                            active: observed.active,
                            index: loop_scope_1.first
                        }

                        const loop_scope_2 = {
                            query: loop_scope_1.query,
                            base: loop_scope_1.base,
                            count: loop_scope_1.count,
                            site: index,
                            end: loop_scope_1.end
                        }

                        site.states = loop(loop_initial_2, {
                            while: pair =>
                                pair.active != 0 && pair.index < loop_scope_2.end,
                            next: pair => {
                                const sites = loop_scope_2.query.plan.sites
                                const left = loop_scope_2.site
                                const right = pair.index
                                const first = match {
                                    sites.lo[left] > sites.lo[right] => sites.lo[left],
                                    _ => sites.lo[right]
                                }
                                const last = match {
                                    sites.hi[left] < sites.hi[right] => sites.hi[left],
                                    _ => sites.hi[right]
                                }
                                const end = match {
                                    last < loop_scope_2.count => last,
                                    _ => loop_scope_2.count
                                }
                                const same = sites.edge[left] == sites.edge[right] &&
                                    sites.delta[left] == sites.delta[right]

                                const competing = (
                                    - left != right
                                    - and first < end
                                    - and !same
                                )

                                if (competing && !exclusive({
                                    query: loop_scope_2.query,
                                    left,
                                    right
                                })) {
                                    const ordered = before({
                                        query: loop_scope_2.query,
                                        observation: right,
                                        consumer: left
                                    })

                                    const result_initial = {
                                        states: pair.states,
                                        active: pair.active,
                                        slot: integers.widen(first)
                                    }

                                    const result_scope = {
                                        query: loop_scope_2.query,
                                        base: loop_scope_2.base,
                                        left,
                                        right,
                                        ordered,
                                        end: integers.widen(end)
                                    }

                                    const result = loop(result_initial, {
                                        while: slot =>
                                            slot.active != 0 &&
                                            slot.slot < result_scope.end,
                                        next: slot => {
                                            const position = result_scope.base + slot.slot
                                            const left_role =
                                                result_scope.query.plan.sites
                                                .role[result_scope.left]
                                            const right_role =
                                                result_scope.query.plan.sites
                                                .role[result_scope.right]

                                            const used =
                                                slot.states[position] != Usage.Shared &&
                                                consumes({
                                                    query: result_scope.query,
                                                    site: result_scope.left,
                                                    slot: slot.slot,
                                                    kind: left_role
                                                })
                                            const contested = match {
                                                !used => false,
                                                !result_scope.ordered => true,
                                                _ =>
                                                    right_role != Role.observe &&
                                                    consumes({
                                                        query: result_scope.query,
                                                        site: result_scope.right,
                                                        slot: slot.slot,
                                                        kind: right_role
                                                    })
                                            }

                                            if (contested) {
                                                slot.states[position] = Usage.Shared
                                                slot.active -= 1
                                            }

                                            slot.slot += 1
                                        }
                                    })

                                    pair.states = result.states
                                    pair.active = result.active
                                }

                                pair.index += 1
                            },
                            return: state => state.states
                        })
                    }

                    site.index += 1
                },
                return: state => state.states
            })
            current.root += 1
        },
        return: state => state.states
    })
}
