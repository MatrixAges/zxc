import integers from "std:integer"
import { max_u32 } from "core/const"

import alternatives from "./alternatives"
import expression from "./expression"
import { Action, Definition, Role } from "./model"
import push from "./push"
import statement from "./statement"
import parts from "./walk/parts"
import repetition from "./walk/repetition"
import scope from "./walk/scope"

import type { Walk as Input, Node, Trace as Output } from "./model"

export default function (in: Input): Output {
    const source = in.source
    const returns = in.returns
    const completed: Node[] = []

    const result = loop({
        ...in.state.graph,
        seen: in.source.expressions.kinds.map(kind => false)[0],
        completed,
        stack: in.state.stack,
        clock: in.state.clock,
        forks: in.state.forks,
        active_region: in.state.region,
        active_loop: in.state.repeated
    }, {
        while: current => current.stack.top != max_u32,
        next: current => {
            const last = integers.widen(current.stack.top)

            const event = current.stack.nodes[last]
            const action = event.action
            const first = event.first
            const second = event.second
            const third = event.third
            const fourth = event.fourth
            const role = event.role
            const table = source.expressions
            const control = source.control
            const index = integers.widen(first)

            current.stack.top = event.parent

            const dispatch = match action {
                Action.ValueArm => Action.BlockArm,
                Action.Switch => Action.Branch,
                Action.Conditional => Action.Branch,
                Action.Match => Action.Branch,
                Action.Transform => Action.Repeat,
                Action.Iteration => Action.Repeat,
                _ => action
            }

            switch (dispatch) {
                case Action.Block:
                    if (second != 0) {
                        const pending = push({
                            stack: current.stack,
                            event: {
                                action: Action.Block,
                                first: first + 1,
                                second: second - 1
                            }
                        })

                        current.stack = statement({
                            table: control,
                            stack: pending,
                            index: first
                        })
                    }

                case Action.Operand:
                    const child = integers.widen(second)

                    current.edges = current.edges.push({
                        parent: first,
                        child: second,
                        role,
                        index: third,
                        region: current.active_region
                    })[0]

                    if (!current.seen[child]) {
                        const time = current.clock

                        current.seen[child] = true
                        current.clock += 1

                        const pending = push({
                            stack: current.stack,
                            event: {
                                action: Action.Finish,
                                first: second,
                                second: time,
                                third: current.active_region,
                                fourth: current.active_loop
                            }
                        })

                        current.stack = expression({
                            table,
                            stack: pending,
                            id: second
                        })
                    }

                case Action.Finish:
                    current.completed = current.completed.push({
                        id: first,
                        time: second,
                        finish: current.clock,
                        region: third,
                        repeated: fourth
                    })[0]

                case Action.RestoreRegion:
                    current.active_region = first

                case Action.RestoreLoop:
                    current.active_loop = first

                case Action.Define:
                    current.definitions[index] = {
                        ...current.definitions[index],
                        kind: Definition.Value,
                        value: second,
                        repeated: current.active_loop
                    }

                case Action.Parts:
                    current.definitions = parts({
                        control,
                        definitions: current.definitions,
                        statement: index,
                        repeated: current.active_loop
                    })

                case Action.Result:
                    current.results = current.results.push(first)[0]

                case Action.Scope:
                    current.stack = scope({
                        table,
                        stack: current.stack,
                        event
                    })

                case Action.BlockArm:
                    const region =
                        integers.narrow(current.regions.length)
                    const parent = current.active_region
                    const repeated = push({
                        stack: current.stack,
                        event: {
                            action: Action.RestoreRegion,
                            first: parent
                        }
                    })
                    const block = action == Action.BlockArm
                    const target = integers.widen(fourth)

                    current.regions = current.regions.push({
                        parent,
                        fork: second,
                        arm: third,
                        depth: current.regions[integers.widen(parent)].depth + 1,
                        returns: block && returns[target]
                    })[0]
                    current.active_region = region
                    current.stack = match {
                        block => push({
                            stack: repeated,
                            event: {
                                action: Action.Block,
                                first: control.block_first[target],
                                second: control.block_count[target]
                            }
                        }),
                        _ => push({
                            stack: repeated,
                            event: {
                                action: Action.Operand,
                                first,
                                second: fourth,
                                role: Role.flow
                            }
                        })
                    }

                case Action.Branch:
                    current.forks += 1
                    current.stack = alternatives({
                        source,
                        stack: current.stack,
                        action,
                        index: first,
                        fork: current.forks
                    })

                case Action.Repeat:
                    const repeated = repetition({
                        table,
                        stack: current.stack,
                        definitions: current.definitions,
                        repetitions: current.repeated,
                        parent: current.active_loop,
                        event
                    })

                    current.repeated = repeated.repetitions
                    current.active_loop = repeated.active
                    current.definitions = repeated.definitions
                    current.stack = repeated.stack

                default:
            }
        }
    })

    return {
        completed: result.completed,
        graph: {
            regions: result.regions,
            edges: result.edges,
            definitions: result.definitions,
            results: result.results,
            repeated: result.repeated
        }
    }
}
