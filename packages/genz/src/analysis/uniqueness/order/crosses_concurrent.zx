import integers from "std:integer"
import { max_u32 } from "core/const"

export type Input = {
    parents: u32[],
    concurrent: bool[],
    inner: u32,
    outer: u32
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        source: in,
        repeated: in.inner,
        found: false
    }, {
        while: current => !current.found && current.repeated != max_u32 &&
            current.repeated != current.source.outer,
        next: current => {
            const index = integers.widen(current.repeated)

            current.found = current.source.concurrent[index]
            current.repeated = current.source.parents[index]
        },
        return: state => state.found
    })
}
