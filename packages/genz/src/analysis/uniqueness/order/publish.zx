import type { Graph as Input } from "./model"
import type { Graph as Output } from "./plan"

export default function (in: Input): Output {
    return {
        regions: {
            parent: in.regions.map(row => row.parent)[0],
            fork: in.regions.map(row => row.fork)[0],
            arm: in.regions.map(row => row.arm)[0],
            depth: in.regions.map(row => row.depth)[0],
            returns: in.regions.map(row => row.returns)[0]
        },
        edges: {
            parent: in.edges.map(row => row.parent)[0],
            child: in.edges.map(row => row.child)[0],
            role: in.edges.map(row => row.role)[0],
            index: in.edges.map(row => row.index)[0],
            region: in.edges.map(row => row.region)[0]
        },
        definitions: {
            kind: in.definitions.map(row => row.kind)[0],
            value: in.definitions.map(row => row.value)[0],
            index: in.definitions.map(row => row.index)[0],
            repeated: in.definitions.map(row => row.repeated)[0]
        },
        results: in.results,
        repeated: {
            owner: in.repeated.map(row => row.owner)[0],
            parent: in.repeated.map(row => row.parent)[0],
            concurrent: in.repeated.map(row => row.concurrent)[0]
        }
    }
}
