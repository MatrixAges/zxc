import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import collections from "./expression/collections"
import control from "./expression/control"
import { Action, Role } from "./model"
import push from "./push"

import type { Input as Request } from "./expression/model"
import type { Stack } from "./model"

export type Input = Request

export type Output = Stack

export default function (in: Input): Output {
    const table = in.table
    const kind = table.kinds[integers.widen(in.id)]
    const payload = integers.widen(table.payloads[integers.widen(in.id)])

    const operand: u32? = match kind {
        ExpressionKind.Some => table.some[payload],
        ExpressionKind.OptionalValue => table.optional_values[payload],
        ExpressionKind.Capture => table.captures[payload],
        ExpressionKind.AwaitTask => table.awaits[payload],
        ExpressionKind.CancelTask => table.cancellations[payload],
        ExpressionKind.Length => table.lengths[payload],
        ExpressionKind.Field => table.projection_targets[payload],
        ExpressionKind.TupleField => table.projection_targets[payload],
        ExpressionKind.Call => table.call_arguments[payload],
        ExpressionKind.Unary => table.unary_operands[payload],
        _ => null
    }

    if (operand != null) {
        return push({
            stack: in.stack,
            event: {
                action: Action.Operand,
                first: in.id,
                second: operand,
                role: match kind {
                    ExpressionKind.Some => Role.flow,
                    ExpressionKind.Length => Role.observe,
                    ExpressionKind.Unary => Role.observe,
                    ExpressionKind.Call => Role.argument,
                    _ => Role.use
                }
            }
        })
    }

    if (kind == ExpressionKind.Index) {
        const pending = push({
            stack: in.stack,
            event: {
                action: Action.Operand,
                first: in.id,
                second: table.index_values[payload],
                role: Role.observe
            }
        })

        return push({
            stack: pending,
            event: {
                action: Action.Operand,
                first: in.id,
                second: table.index_targets[payload],
                role: Role.observe
            }
        })
    }

    if (kind == ExpressionKind.Binary) {
        const pending = push({
            stack: in.stack,
            event: {
                action: Action.Operand,
                first: in.id,
                second: table.binary_right[payload],
                role: Role.observe
            }
        })

        return push({
            stack: pending,
            event: {
                action: Action.Operand,
                first: in.id,
                second: table.binary_left[payload],
                role: Role.observe
            }
        })
    }

    if (kind == ExpressionKind.ListUpdate) {
        const pending = push({
            stack: in.stack,
            event: {
                action: Action.Operand,
                first: in.id,
                second: table.update_values[payload],
                role: Role.use
            }
        })

        const scheduled = push({
            stack: pending,
            event: {
                action: Action.Operand,
                first: in.id,
                second: table.update_indices[payload],
                role: Role.observe
            }
        })

        return push({
            stack: scheduled,
            event: {
                action: Action.Operand,
                first: in.id,
                second: table.update_targets[payload],
                role: Role.use
            }
        })
    }

    const resolved = {
        ...in,
        kind,
        payload
    }

    return match kind {
        ExpressionKind.List => collections(resolved),
        ExpressionKind.Tuple => collections(resolved),
        ExpressionKind.Template => collections(resolved),
        ExpressionKind.Parallel => collections(resolved),
        ExpressionKind.Object => collections(resolved),
        ExpressionKind.ListOperation => collections(resolved),
        ExpressionKind.Task => control(resolved),
        ExpressionKind.Scope => control(resolved),
        ExpressionKind.Iteration => control(resolved),
        ExpressionKind.Transform => control(resolved),
        ExpressionKind.Conditional => control(resolved),
        ExpressionKind.Match => control(resolved),
        _ => in.stack
    }
}
