import integers from "std:integer"

export type Input = {
    count: u64,
    owners: u32[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    const first: u32[] = loop({
        count: in.count + 1,
        values: empty
    }, {
        while: current => current.values.length < current.count,
        next: current => {
            current.values = current.values.push(0)[0]
        },
        return: state => state.values
    })

    const counts = loop({
        owners: in.owners,
        first,
        index: 0
    }, {
        while: current => current.index < current.owners.length,
        next: current => {
            const owner = integers.widen(current.owners[current.index])

            current.first[owner] += 1
            current.index += 1
        },
        return: state => state.first
    })

    return loop({
        first: counts,
        index: 1
    }, {
        while: current => current.index < current.first.length,
        next: current => {
            current.first[current.index] += current.first[current.index - 1]
            current.index += 1
        },
        return: state => state.first
    })
}
