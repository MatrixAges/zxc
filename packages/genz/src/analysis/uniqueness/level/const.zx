import { Operation } from "./model"

import type { Level as Output } from "./model"

export type Input = Operation

export default function (in: Input): Output {
    return match in {
        Operation.None => {
            headered: false,
            unique: false,
            deferred: false
        },
        Operation.All => {
            headered: true,
            unique: true,
            deferred: false
        },
        _ => {
            headered: false,
            unique: true,
            deferred: false
        }
    }
}
