import type { Level as Output, Pair as Input } from "./model"

export default function (in: Input): Output {
    const headered = in.left.headered && in.right.headered

    const may_defer = (
        - in.left.deferred
        - or in.right.deferred
        - or in.left.headered
        - or in.right.headered
    )

    return {
        headered,
        unique: in.left.unique && in.right.unique,
        deferred: !headered && may_defer
    }
}
