import constant from "./const"
import join from "./join"
import meet from "./meet"
import { Operation } from "./model"

import type { Input, Level as Output } from "./model"

export default function (in: Input): Output {
    return match in.operation {
        Operation.None => constant(in.operation),
        Operation.All => constant(in.operation),
        Operation.Fresh => constant(in.operation),
        Operation.Join => join(in.pick([
            "left",
            "right"
        ])),
        Operation.Meet => meet(in.pick([
            "left",
            "right"
        ])),
        Operation.Materialized => match {
            in.right.unique => {
                headered: true,
                unique: in.linear,
                deferred: false
            },
            _ => {
                ...in.left,
                deferred: true
            }
        },
        _ => match {
            in.left.unique => in.left,
            _ => {
                headered: in.left.headered,
                unique: true,
                deferred: false
            }
        }
    }
}
