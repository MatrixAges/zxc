import integers from "std:integer"

import type { Input, Rows as Output } from "./model"

export default function (in: Input): Output {
    const sizes: u32[] = []
    const texts: bool[] = []
    const external: bool[] = []

    return loop({
        index: 0,
        sizes,
        texts,
        external
    }, {
        while: state => state.index < in.input_types.length,
        next: state => {
            const input = integers.widen(in.input_types[state.index])
            const output = integers.widen(in.output_types[state.index])

            state.sizes = state.sizes.push(in.counts[input])[0]
            state.texts = state.texts.push(in.texts[output])[0]
            state.external = state.external.push(
                in.native_modules[state.index] != null
            )[0]
            state.index += 1
        },
        return: state => state.pick([
            "sizes",
            "texts",
            "external"
        ])
    })
}
