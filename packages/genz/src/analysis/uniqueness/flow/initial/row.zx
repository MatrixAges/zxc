import integers from "std:integer"

import listType from "../../slots/list_type"

import type { Input as Program, Row as Output } from "./model"

export type Input = {
    program: Program,
    index: u64,
    size: u32,
    text: bool,
    external: bool
}

export default function (in: Input): Output {
    const outputs: u32[] = []

    const lists = loop({
        outputs,
        index: 0
    }, {
        while: state => in.external && !in.text &&
            state.index < integers.widen(
                in.program
                    .counts[
                        integers.widen(
                            in.program.output_types[in.index]
                        )
                    ]
            ),
        next: state => {
            state.outputs = state.outputs.push(listType({
                layout: in.program.layout,
                kinds: in.program.kinds,
                type_id: in.program.output_types[in.index],
                slot: integers.narrow(state.index)
            }))[0]
            state.index += 1
        },
        return: state => state.outputs
    })

    const held: bool[] = []
    const text_held: bool[] = []
    const written: bool[] = []

    const loop_initial = {
        held,
        text_held,
        written,
        index: 0
    }

    const loop_scope = {
        row: in,
        lists
    }

    return loop(loop_initial, {
        while: state => state.index < integers.widen(loop_scope.row.size),
        next: state => {
            const text = loop_scope.row.external && loop_scope.row.text
            const input_type = loop_scope.row.program.input_types[loop_scope.row.index]
            const target = match {
                loop_scope.row.external && !text => listType({
                    layout: loop_scope.row.program.layout,
                    kinds: loop_scope.row.program.kinds,
                    type_id: input_type,
                    slot: integers.narrow(state.index)
                }),
                _ => input_type
            }

            const inner_lists = loop_scope.lists

            const holds = text || (loop_scope.row.external && loop({
                index: 0,
                found: false
            }, {
                while: scan => !scan.found && scan.index < inner_lists.length,
                next: scan => {
                    scan.found = inner_lists[scan.index] == target
                    scan.index += 1
                },
                return: state => state.found
            }))

            state.held = state.held.push(holds)[0]
            state.written = state.written.push(false)[0]

            if (loop_scope.row.text) {
                state.text_held = state.text_held.push(text)[0]
            }

            state.index += 1
        },
        return: state => state.pick([
            "held",
            "text_held",
            "written"
        ])
    })
}
