import integers from "std:integer"

import listType from "../../slots/list_type"

import type { Input as Program, Row as Output } from "./model"

export type Input = {
    program: Program,
    index: u64,
    size: u32,
    text: bool,
    external: bool
}

export default function (in: Input): Output {
    const outputs: u32[] = []

    const lists = loop({
        outputs,
        index: 0
    }, {
        while: (state, context) => context.external && !context.text &&
            state.index < integers.widen(
                context.program
                    .counts[
                        integers.widen(
                            context.program.output_types[context.index]
                        )
                    ]
            ),
        next: (state, context) => {
            state.outputs = state.outputs.push(listType({
                layout: context.program.layout,
                kinds: context.program.kinds,
                type_id: context.program.output_types[context.index],
                slot: integers.narrow(state.index)
            }))[0]
            state.index += 1
        }
    }, in).outputs

    const held: bool[] = []
    const text_held: bool[] = []
    const written: bool[] = []

    return loop({
        held,
        text_held,
        written,
        index: 0
    }, {
        while: (state, context) => state.index < integers.widen(context.row.size),
        next: (state, context) => {
            const text = context.row.external && context.row.text
            const input_type = context.row.program.input_types[context.row.index]
            const target = context.row.external && !text ? listType({
                layout: context.row.program.layout,
                kinds: context.row.program.kinds,
                type_id: input_type,
                slot: integers.narrow(state.index)
            }) : input_type

            const holds = text || (context.row.external && loop({
                index: 0,
                found: false
            }, {
                while: (scan, values) => !scan.found && scan.index < values.lists.length,
                next: (scan, values) => {
                    scan.found = values.lists[scan.index] == values.target
                    scan.index += 1
                }
            }, {
                lists: context.lists,
                target
            }).found)

            state.held = state.held.push(holds)[0]
            state.written = state.written.push(false)[0]

            if (context.row.text) {
                state.text_held = state.text_held.push(text)[0]
            }

            state.index += 1
        }
    }, {
        row: in,
        lists
    }).pick(["held", "text_held", "written"])
}
