import integers from "std:integer"

import { bits_per_word } from "./const"

import type { Point, Queue } from "./model"

export type Input = {
    queue: Queue,
    first: u32[],
    point: Point
}

export type Output = Queue

export default function (in: Input): Output {
    const node = integers.widen(in.point.node)
    const bit = integers.widen(in.first[node] + in.point.slot)

    if (bit >= integers.widen(in.first[node + 1])) {
        return in.queue
    }

    const word = bit / bits_per_word
    const mask = integers.bitMask(bit % bits_per_word)
    const previous = in.queue.visited[word]

    if (integers.andBits(previous, mask) != 0) {
        return in.queue
    }

    return (in.queue.count < in.queue.pending.length ?
        in.queue.pending.with(in.queue.count, {
            ...in.point
        }) : in.queue.pending.push({
            ...in.point
        })[0])
        -> {
            count: in.queue.count + 1,
            pending: _,
            visited: in.queue.visited.with(word, integers.orBits(previous, mask))
        }
}
