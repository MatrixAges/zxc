import integers from "std:integer"

import type { Input, Point } from "./model"

export type Output = Point[]

export default function (in: Input): Output {
    const roots: Point[] = []

    return loop({
        roots,
        index: 0
    }, {
        while: state =>
            state.index < in.body.expressions.call_functions.length,
        next: state => {
            const expressions = in.body.expressions
            const callee = expressions.call_functions[state.index]

            const values = in.text_held[integers.widen(callee)]

            const loop_initial = {
                roots: state.roots,
                slot: 0
            }

            const loop_scope = {
                values,
                argument: expressions.call_arguments[state.index]
            }

            state.roots = loop(loop_initial, {
                while: slot => slot.slot < loop_scope.values.length,
                next: slot => {
                    if (loop_scope.values[slot.slot]) {
                        slot.roots = slot.roots.push({
                            node: loop_scope.argument,
                            slot: integers.narrow(slot.slot)
                        })[0]
                    }

                    slot.slot += 1
                },
                return: state => state.roots
            })
            state.index += 1
        },
        return: state => state.roots
    })
}
