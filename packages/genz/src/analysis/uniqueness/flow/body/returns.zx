import whole from "./seed_whole"

import type { Body as Input, Point } from "./model"

export type Output = Point[]

export default function (in: Input): Output {
    const roots: Point[] = []

    return loop({
        roots,
        index: 0
    }, {
        while: state => state.index < in.results.length,
        next: state => {
            state.roots = whole({
                roots: state.roots,
                first: in.prepared.first,
                node: in.results[state.index]
            })
            state.index += 1
        },
        return: state => state.roots
    })
}
