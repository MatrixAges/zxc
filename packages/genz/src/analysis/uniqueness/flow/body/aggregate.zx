import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import push from "./push"

import type { State as Output, Step as Input } from "./model"

export default function (in: Input): Output {
    const body = in.context.body
    const expressions = body.expressions
    const node = integers.widen(in.point.node)
    const payload = integers.widen(expressions.payloads[node])

    const owner = integers.widen(
        body.layout.unwrapped[integers.widen(
            expressions.types[node]
        )]
    )

    const offsets = body.layout.offsets[owner]

    const slot = in.point.slot
    const candidate = integers.widen(slot)
    const next = candidate + 1
    const in_range = candidate < offsets.length

    const at_floor = match {
        in_range => offsets[candidate] <= slot,
        _ => false
    }

    const at_ceiling = match {
        at_floor => next == offsets.length || offsets[next] > slot,
        _ => false
    }

    const direct = (
        - in_range
        - and at_floor
        - and at_ceiling
    )

    const position = match {
        direct => next,
        _ => loop({
            first: 0,
            last: offsets.length
        }, {
            while: state => state.first < state.last,
            next: state => {
                const middle = state.first + (state.last - state.first) / 2

                if (offsets[middle] <= slot) {
                    state.first = middle + 1
                } else {
                    state.last = middle
                }
            },
            return: state => state.first
        })
    }

    if (position == 0) {
        return in.state
    }

    const member = position - 1
    const offset = offsets[member]
    const type_id = body.layout.members[owner][member]

    if (in.point.slot >= offset + body.counts[integers.widen(type_id)]) {
        return in.state
    }

    const object = expressions.kinds[node] == ExpressionKind.Object

    const first = match object {
        true => body.prepared.object_first[payload],
        _ => integers.widen(expressions.sequence_first[payload])
    }

    return {
        ...in.state,
        queue: push({
            queue: in.state.queue,
            first: body.prepared.first,
            point: {
                node: match object {
                    true => body.prepared.objects[first + member],
                    _ => expressions.sequence_items[first + member]
                },
                slot: in.point.slot - offset
            }
        })
    }
}
