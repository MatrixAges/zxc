export type Input = bool[]

export type Output = u64

export default function (in: Input): Output {
    return loop({
        count: 0,
        index: 0
    }, {
        while: state => state.index < in.length,
        next: state => {
            if (!in[state.index]) {
                state.count += 1
            }

            state.index += 1
        },
        return: state => state.count
    })
}
