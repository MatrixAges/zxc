import integers from "std:integer"

import push from "./push"
import remaining from "./remaining"
import step from "./step"
import visited from "./visited"

import type { Point, Result as Output, State, Trace as Input } from "./model"

export default function (in: Input): Output {
    if (in.roots.length == 0) {
        return {
            reached: in.reached,
            changed: false
        }
    }

    const count = remaining(in.reached)

    if (count == 0) {
        return {
            reached: in.reached,
            changed: false
        }
    }

    const first = in.context.body.prepared.first
    const pending: Point[] = []
    const seen = visited(integers.widen(first[first.length - 1]))

    const queue = loop({
        queue: {
            count: 0,
            pending,
            visited: seen
        },
        index: 0
    }, {
        while: (state, context) => state.index < context.roots.length,
        next: (state, context) => {
            state.queue = push({
                queue: state.queue,
                first: context.first,
                point: context.roots[state.index]
            })
            state.index += 1
        }
    }, {
        roots: in.roots,
        first
    }).queue

    const expanded =
        in.context.body.expressions.call_functions.map(callee => false)[0]

    const initial: State = {
        remaining: count,
        queue,
        expanded,
        reached: in.reached,
        changed: false,
        every: false
    }

    const result = loop(initial, {
        while: state => state.queue.count != 0 && state.remaining != 0 && !state.every,
        next: (state, context) => {
            state.queue.count -= 1
            const point = state.queue.pending[state.queue.count]

            state = step({
                state,
                context,
                point
            })

        }
    }, in.context)

    if (!result.every) {
        return result.pick([
            "reached",
            "changed"
        ])
    }

    return loop({
        reached: result.reached,
        changed: result.changed,
        index: 0
    }, {
        while: state => state.index < state.reached.length,
        next: state => {
            if (!state.reached[state.index]) {
                state.reached[state.index] = true
                state.changed = true
            }

            state.index += 1
        }
    }).pick([
        "reached",
        "changed"
    ])
}
