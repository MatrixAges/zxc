import integers from "std:integer"

import type { Preparation as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    const result = loop({
        first: empty,
        total: integers.narrow(0),
        index: 0
    }, {
        while: (state, source) => state.index < source.expressions.types.length,
        next: (state, source) => {
            state.first = state.first.push(state.total)[0]
            state.total += source
                .counts[integers.widen(
                    source.expressions.types[state.index]
                )]
            state.index += 1
        }
    }, in)

    return result.first.push(result.total)[0]
}
