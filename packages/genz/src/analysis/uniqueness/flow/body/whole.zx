import integers from "std:integer"

import push from "./push"

import type { Queue } from "./model"

export type Input = {
    queue: Queue,
    first: u32[],
    node: u32
}

export type Output = Queue

export default function (in: Input): Output {
    const node = integers.widen(in.node)

    const loop_initial = {
        queue: in.queue,
        slot: integers.narrow(0)
    }

    const loop_scope = {
        first: in.first,
        node: in.node,
        count: in.first[node + 1] - in.first[node]
    }

    return loop(loop_initial, {
        while: state => state.slot < loop_scope.count,
        next: state => {
            state.queue = push({
                queue: state.queue,
                first: loop_scope.first,
                point: {
                    node: loop_scope.node,
                    slot: state.slot
                }
            })
            state.slot += 1
        },
        return: state => state.queue
    })
}
