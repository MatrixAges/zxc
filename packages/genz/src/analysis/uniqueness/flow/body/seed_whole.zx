import integers from "std:integer"

import type { Point } from "./model"

export type Input = {
    roots: Point[],
    first: u32[],
    node: u32
}

export type Output = Point[]

export default function (in: Input): Output {
    const node = integers.widen(in.node)

    const loop_initial = {
        roots: in.roots,
        slot: integers.narrow(0)
    }

    const loop_scope = {
        node: in.node,
        count: in.first[node + 1] - in.first[node]
    }

    return loop(loop_initial, {
        while: state => state.slot < loop_scope.count,
        next: state => {
            state.roots = state.roots.push({
                node: loop_scope.node,
                slot: state.slot
            })[0]
            state.slot += 1
        },
        return: state => state.roots
    })
}
