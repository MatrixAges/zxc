import integers from "std:integer"

import type { Point } from "./model"

export type Input = {
    roots: Point[],
    first: u32[],
    node: u32
}

export type Output = Point[]

export default function (in: Input): Output {
    const node = integers.widen(in.node)

    return loop({
        roots: in.roots,
        slot: integers.narrow(0)
    }, {
        while: (state, context) => state.slot < context.count,
        next: (state, context) => {
            state.roots = state.roots.push({
                node: context.node,
                slot: state.slot
            })[0]
            state.slot += 1
        },
        return: state => state.roots
    }, {
        node: in.node,
        count: in.first[node + 1] - in.first[node]
    })
}
