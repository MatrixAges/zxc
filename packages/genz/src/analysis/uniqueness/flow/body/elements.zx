import integers from "std:integer"
import { max_u32 } from "core/const"
import { TransformKind } from "core/expression_table/kinds"

import type { Preparation as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    if (in.expressions.transform_parameters.length == 0) {
        return empty
    }

    const values = loop({
        values: empty,
        count: in.symbols
    }, {
        while: state => state.values.length < state.count,
        next: state => {
            state.values = state.values.push(max_u32)[0]
        },
        return: state => state.values
    })

    const readonly_loop_initial = {
        values,
        index: 0
    }

    const readonly_expressions = in.expressions

    return loop(readonly_loop_initial, {
        while: state => state.index < readonly_expressions.transform_kinds.length,
        next: state => {
            const index = state.index
            const first = integers.widen(readonly_expressions.transform_first[index])
            const begin =
                match {
                    readonly_expressions.transform_kinds[index] == TransformKind.Reduce =>
                        first + 1,
                    _ => first
                }

            const loop_initial = {
                values: state.values,
                position: begin
            }

            const loop_scope = {
                parameters: readonly_expressions.transform_parameters,
                target: readonly_expressions.transform_targets[index],
                end: first + (
                    match {
                        readonly_expressions.transform_kinds[index] ==
                            TransformKind.Sort => 2,
                        _ => integers.widen(
                            readonly_expressions.transform_count[index]
                        )
                    }
                )
            }

            state.values = loop(loop_initial, {
                while: parameter => parameter.position < loop_scope.end,
                next: parameter => {
                    const symbol = loop_scope.parameters[parameter.position]
                    parameter.values[integers.widen(symbol)] = loop_scope.target
                    parameter.position += 1
                },
                return: state => state.values
            })
            state.index += 1
        },
        return: state => state.values
    })
}
