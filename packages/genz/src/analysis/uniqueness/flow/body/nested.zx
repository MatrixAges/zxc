import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Body } from "./model"

export type Input = {
    body: Body,
    node: u32
}

export type Output = bool

export default function (in: Input): Output {
    const type_id = in.body.expressions.types[integers.widen(in.node)]

    const owner = integers.widen(in.body.layout.unwrapped[integers.widen(type_id)])

    return kind(in.body.type_kinds[owner]) == Kind.List &&
        in.body.counts[integers.widen(in.body.type_first[owner])] != 0
}
