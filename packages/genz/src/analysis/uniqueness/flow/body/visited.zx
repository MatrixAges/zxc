export type Input = u64

export type Output = bool[]

export default function (in: Input): Output {
    if (in == 0) {
        return []
    }

    return loop({
        values: [false],
        count: in
    }, {
        while: state => state.values.length < state.count,
        next: state => {
            state.values = state.values.concat(state.values)[0]
        }
    }).values
}
