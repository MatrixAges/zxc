import { bits_per_word } from "./const"

export type Input = u64

export type Output = u64[]

export default function (in: Input): Output {
    if (in == 0) {
        return []
    }

    return loop({
        values: [0],
        count: (in + bits_per_word - 1) / bits_per_word
    }, {
        while: state => state.values.length < state.count,
        next: state => {
            state.values = state.values.concat(state.values)[0]
        },
        return: state => state.values
    })
}
