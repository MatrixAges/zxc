import integers from "std:integer"

import type { Expressions as Input } from "core/expression_table/model"

export type Output = {
    first: u64[],
    values: u32[]
}

export default function (in: Input): Output {
    const empty: u32[] = []
    const first: u64[] = []

    return loop({
        first,
        values: empty,
        index: 0
    }, {
        while: state => state.index < in.object_first.length,
        next: state => {
            const first = integers.widen(in.object_first[state.index])
            const count = integers.widen(in.object_count[state.index])
            const target = state.values.length
            state.first = state.first.push(target)[0]

            const values_initial = {
                values: state.values,
                position: first
            }

            const values_scope = {
                source: in,
                first,
                count
            }

            const values = loop(values_initial, {
                while: field => field.position < values_scope.first + values_scope.count,
                next: field => {
                    field.values = field.values.push(
                        values_scope.source.object_field_values[field.position]
                    )[0]
                    field.position += 1
                },
                return: state => state.values
            })

            const loop_initial = {
                values,
                position: first
            }

            const loop_scope = {
                source: in,
                first,
                count,
                target
            }

            state.values = loop(loop_initial, {
                while: field => field.position < loop_scope.first + loop_scope.count,
                next: field => {
                    const index = integers.widen(
                        loop_scope.source.object_field_indices[field.position]
                    )
                    field.values[loop_scope.target + index] =
                        loop_scope.source.object_field_values[field.position]
                    field.position += 1
                },
                return: state => state.values
            })
            state.index += 1
        },
        return: state => state.pick([
            "first",
            "values"
        ])
    })
}
