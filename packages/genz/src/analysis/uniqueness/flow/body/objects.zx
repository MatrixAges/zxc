import integers from "std:integer"

import type { Expressions as Input } from "core/expression_table/model"

export type Output = {
    first: u64[],
    values: u32[]
}

export default function (in: Input): Output {
    const empty: u32[] = []
    const first: u64[] = []

    return loop({
        first,
        values: empty,
        index: 0
    }, {
        while: (state, source) => state.index < source.object_first.length,
        next: (state, source) => {
            const first = integers.widen(source.object_first[state.index])
            const count = integers.widen(source.object_count[state.index])
            const target = state.values.length
            state.first = state.first.push(target)[0]

            const values = loop({
                values: state.values,
                position: first
            }, {
                while: (field, context) => field.position < context.first + context.count,
                next: (field, context) => {
                    field.values = field.values.push(
                        context.source.object_field_values[field.position]
                    )[0]
                    field.position += 1
                },
                return: state => state.values
            }, {
                source,
                first,
                count
            })

            state.values = loop({
                values,
                position: first
            }, {
                while: (field, context) => field.position < context.first + context.count,
                next: (field, context) => {
                    const index = integers.widen(
                        context.source.object_field_indices[field.position]
                    )
                    field.values[context.target + index] =
                        context.source.object_field_values[field.position]
                    field.position += 1
                },
                return: state => state.values
            }, {
                source,
                first,
                count,
                target
            })
            state.index += 1
        }
    }, in).pick([
        "first",
        "values"
    ])
}
