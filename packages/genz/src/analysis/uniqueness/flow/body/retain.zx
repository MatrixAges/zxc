import type { Result } from "./model"

export type Input = {
    held: Result,
    text: Result
}

export type Output = Result

export default function (in: Input): Output {
    const loop_initial = {
        reached: in.held.reached,
        changed: in.held.changed || in.text.changed,
        index: 0
    }

    const readonly_reached = in.text.reached

    return loop(loop_initial, {
        while: state => state.index < readonly_reached.length,
        next: state => {
            if (readonly_reached[state.index] && !state.reached[state.index]) {
                state.reached[state.index] = true
                state.changed = true
            }

            state.index += 1
        },
        return: state => state.pick([
            "reached",
            "changed"
        ])
    })
}
