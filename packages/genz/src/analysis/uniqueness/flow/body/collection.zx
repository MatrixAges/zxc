import integers from "std:integer"
import {
    CollectionKind,
    ExpressionKind,
    TransformKind
} from "core/expression_table/kinds"

import transform from "./collection/transform"
import { buffer_slot, splice_retained_slot, splice_replacement_argument } from "./const"
import nested from "./nested"
import push from "./push"
import whole from "./whole"

import type { State as Output, Step as Input } from "./model"

export default function (in: Input): Output {
    const body = in.context.body
    const expressions = body.expressions
    const node = integers.widen(in.point.node)
    const payload = integers.widen(expressions.payloads[node])
    const kind = expressions.kinds[node]
    const contents = in.context.contents

    if (kind == ExpressionKind.ListOperation) {
        const operation = expressions.collection_kinds[payload]
        const target = expressions.collection_targets[payload]

        const aliased = in.point.slot ==
            (
                match {
                    operation == CollectionKind.Splice => splice_retained_slot,
                    _ => buffer_slot
                }
            )

        const queue = match {
            aliased || (contents && nested({
                body,
                node: target
            })) => push({
                queue: in.state.queue,
                first: body.prepared.first,
                point: {
                    node: target,
                    slot: buffer_slot
                }
            }),
            _ => in.state.queue
        }

        if (!contents) {
            return {
                ...in.state,
                queue
            }
        }

        const first = integers.widen(expressions.collection_first[payload])
        const count = integers.widen(expressions.collection_count[payload])

        const result_initial = {
            queue,
            index: first
        }

        const result_scope = {
            body,
            operation,
            first,
            count
        }

        const result = loop(result_initial, {
            while: state => state.index < result_scope.first + result_scope.count,
            next: state => {
                const node =
                    result_scope.body.expressions.collection_arguments[state.index]
                const used = match result_scope.operation {
                    CollectionKind.Push => true,
                    CollectionKind.Concat => nested({
                        body: result_scope.body,
                        node
                    }),
                    CollectionKind.Splice =>
                        state.index == result_scope.first + splice_replacement_argument &&
                        nested({
                            body: result_scope.body,
                            node
                        }),
                    _ => false
                }

                if (used) {
                    state.queue = whole({
                        queue: state.queue,
                        first: result_scope.body.prepared.first,
                        node
                    })
                }

                state.index += 1
            },
            return: state => state.queue
        })

        return {
            ...in.state,
            queue: result
        }
    }

    if (kind == ExpressionKind.ListUpdate) {
        const queue = push({
            queue: in.state.queue,
            first: body.prepared.first,
            point: {
                node: expressions.update_targets[payload],
                slot: buffer_slot
            }
        })

        return {
            ...in.state,
            queue: match {
                contents => whole({
                    queue,
                    first: body.prepared.first,
                    node: expressions.update_values[payload]
                }),
                _ => queue
            }
        }
    }

    if (kind == ExpressionKind.Transform) {
        return transform(in)
    }

    if (!contents) {
        return in.state
    }

    if (kind == ExpressionKind.Index) {
        return {
            ...in.state,
            queue: push({
                queue: in.state.queue,
                first: body.prepared.first,
                point: {
                    node: expressions.index_targets[payload],
                    slot: buffer_slot
                }
            })
        }
    }

    const first = integers.widen(expressions.sequence_first[payload])
    const count = integers.widen(expressions.sequence_count[payload])
    const end = first + count

    return {
        ...in.state,
        queue: loop({
            queue: in.state.queue,
            index: first
        }, {
            while: state => state.index < end,
            next: state => {
                state.queue = whole({
                    queue: state.queue,
                    first: body.prepared.first,
                    node: body.expressions.sequence_items[state.index]
                })
                state.index += 1
            },
            return: state => state.queue
        })
    }
}
