import type { Sha256State } from "std:crypto"
import type { ExpressionKind } from "core/expression_table/kinds"

export type Input = {
    hash: Sha256State,
    types: u8[],
    content: u8[],
    kinds: ExpressionKind[],
    payloads: u32[],
    call_functions: u32[],
    held: u8[][],
    text_held: u8[][],
    written: u8[][],
    little_endian: bool
}

export type Word = {
    hash: Sha256State,
    value: u32,
    little_endian: bool
}
