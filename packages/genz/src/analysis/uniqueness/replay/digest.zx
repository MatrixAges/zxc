export type Input = {
    previous: u8[],
    current: u8[],
    start: u64,
    width: u64
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        equal: true
    }, {
        while: (state, source) => state.equal && state.index < source.width,
        next: (state, source) => {
            const offset = source.start + state.index

            state.equal = source.previous[offset] == source.current[offset]
            state.index += 1
        },
        return: state => state.equal
    }, in)
}
