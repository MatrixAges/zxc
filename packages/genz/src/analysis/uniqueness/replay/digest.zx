export type Input = {
    previous: u8[],
    current: u8[],
    start: u64,
    width: u64
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.width,
        next: state => {
            const offset = in.start + state.index

            state.equal = in.previous[offset] == in.current[offset]
            state.index += 1
        },
        return: state => state.equal
    })
}
