import advance from "./advance"

import type { Confirmation as Input, State as Output } from "./model"

export default function (in: Input): Output {
    if (!in.state.following || !in.state.changed[in.index]) {
        return in.state
    }

    return match {
        in.matched => advance(in),
        _ => {
            ...in.state,
            following: false
        }
    }
}
