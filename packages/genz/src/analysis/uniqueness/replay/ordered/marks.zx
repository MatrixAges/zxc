import { level_modulus } from "./const"

import type { Mark } from "./model"

export type Input = {
    left: Mark[],
    right: Mark[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.left.length,
        next: state => {
            const left = in.left[state.index]
            const right = in.right[state.index]
            const same_function = left.function == right.function
            const left_level = left.want % level_modulus
            const right_level = right.want % level_modulus

            const condition = (
                - left.output == right.output
                - and same_function
                - and left.slot == right.slot
                - and left_level == right_level
            )

            state.equal = condition
            state.index += 1
        },
        return: state => state.equal
    })
}
