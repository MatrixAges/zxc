import { level_modulus } from "./const"

import type { Mark } from "./model"

export type Input = {
    left: Mark[],
    right: Mark[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: (state, source) => state.equal && state.index < source.left.length,
        next: (state, source) => {
            const left = source.left[state.index]
            const right = source.right[state.index]
            const condition = (
                - left.output == right.output
                - and left.function == right.function
                - and left.slot == right.slot
                - and left.want % level_modulus == right.want % level_modulus
            )

            state.equal = condition
            state.index += 1
        },
        return: state => state.equal
    }, in)
}
