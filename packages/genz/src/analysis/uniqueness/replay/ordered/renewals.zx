import { slot_stride } from "../../renewals/const"
import integers from "./integers"

import type { Renewals } from "../../renewals/model"

export type Input = {
    left: Renewals,
    right: Renewals
}

export type Output = bool

export default function (in: Input): Output {
    if (in.left.keys.length != in.right.keys.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.left.keys.length,
        next: state => {
            const index = state.index
            const left = in.left.keys[index] / slot_stride
            const right = in.right.keys[index] / slot_stride

            state.equal = left == right && integers({
                left: in.left.paths[index],
                right: in.right.paths[index]
            })
            state.index += 1
        },
        return: state => state.equal
    })
}
