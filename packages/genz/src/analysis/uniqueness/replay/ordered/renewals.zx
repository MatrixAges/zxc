import integers from "./integers"

import type { Renewal } from "./model"

export type Input = {
    left: Renewal[],
    right: Renewal[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.left.length,
        next: state => {
            const left = in.left[state.index]
            const right = in.right[state.index]

            state.equal = left.owner == right.owner && integers({
                left: left.path,
                right: right.path
            }) && left.value == right.value
            state.index += 1
        },
        return: state => state.equal
    })
}
