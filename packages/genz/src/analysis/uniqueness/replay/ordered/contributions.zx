import levels from "./levels"

import type { Contribution } from "./model"

export type Input = {
    left: Contribution[],
    right: Contribution[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.left.length,
        next: state => {
            const left = in.left[state.index]
            const right = in.right[state.index]

            state.equal = left.callee == right.callee && levels({
                left: left.levels,
                right: right.levels
            })
            state.index += 1
        },
        return: state => state.equal
    })
}
