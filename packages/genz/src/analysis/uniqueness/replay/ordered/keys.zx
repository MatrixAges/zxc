export type Input = {
    left: u64[],
    right: u64[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: (state, source) => state.equal && state.index < source.left.length,
        next: (state, source) => {
            state.equal = source.left[state.index] == source.right[state.index]
            state.index += 1
        },
        return: state => state.equal
    }, in)
}
