export type Contribution = {
    callee: u32,
    levels: u8[]
}

export type Settled = {
    passed: Contribution[],
    output: u8[]
}

export type Renewal = {
    owner: u32,
    path: u32[],
    value: bool
}

export type Planned = {
    flags: u8[],
    renewals: Renewal[],
    transfers: u64[],
    slot_first: u32[]
}

export type Settlement = {
    left: Settled,
    right: Settled
}

export type Plan = {
    left: Planned,
    right: Planned
}

export type Mark = {
    output: bool,
    function: u32,
    slot: u32,
    want: u8
}

export type Normalized = {
    id: u32,
    want: u8
}

export type Renewed = {
    key: u64,
    want: u8
}

export type Demanded = {
    marks: Mark[],
    normalized: Normalized[],
    renewed: Renewed[],
    grew: bool
}

export type Demand = {
    left: Demanded,
    right: Demanded
}
