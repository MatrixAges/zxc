export type Input = {
    left: u32[],
    right: u32[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.left.length,
        next: state => {
            state.equal = in.left[state.index] == in.right[state.index]
            state.index += 1
        },
        return: state => state.equal
    })
}
