import integers from "std:integer"

export type Input = u32[][]

export type Output = u64[][]

export default function (in: Input): Output {
    const empty: u64[] = []
    const callers: u64[][] = in.map(row => empty)[0]

    const result = loop({
        callers,
        index: 0
    }, {
        while: state => state.index < in.length,
        next: state => {
            const row = in[state.index]
            const changed_initial = {
                callers: state.callers,
                child: 0
            }

            const changed_scope = {
                row,
                index: state.index
            }

            const changed = loop(changed_initial, {
                while: current => current.child < changed_scope.row.length,
                next: current => {
                    const target = integers.widen(changed_scope.row[current.child])

                    current.callers[target] =
                        current.callers[target].push(changed_scope.index)[0]
                    current.child += 1
                }
            })

            state.callers = changed.callers
            state.index += 1
        }
    })

    return result.callers
}
