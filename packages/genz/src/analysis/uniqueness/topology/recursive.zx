import integers from "std:integer"

export type Input = u32[][]

export type Output = bool[]

export default function (in: Input): Output {
    const values = in.map(row => false)[0]

    return loop({
        values,
        index: 0
    }, {
        while: state => state.index < in.length,
        next: state => {
            const updated_value_input = state.index

            state.values[state.index] =
                in[updated_value_input].some(
                    value => integers.widen(value) == updated_value_input
                )
            state.index += 1
        },
        return: state => state.values
    })
}
