import integers from "std:integer"

export type Input = u32[][]

export type Output = bool[]

export default function (in: Input): Output {
    const values = in.map(row => false)[0]

    return loop({
        values,
        index: 0
    }, {
        while: (state, source) => state.index < source.length,
        next: (state, source) => {
            state.values[state.index] = state.index
                -> source[_].some(value => integers.widen(value) == _)
            state.index += 1
        },
        return: state => state.values
    }, in)
}
