import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions as Input } from "core/expression_table/model"

export type Output = u32[]

export default function (in: Input): Output {
    const values: u32[] = []

    return loop({
        values,
        index: 0
    }, {
        while: state => state.index < in.kinds.length,
        next: state => {
            if (in.kinds[state.index] == ExpressionKind.Call) {
                const callee = in
                    .call_functions[integers.widen(
                        in.payloads[state.index]
                    )]

                if (!state.values.some(value => value == callee)) {
                    state.values = state.values.push(callee)[0]
                }
            }

            state.index += 1
        },
        return: state => state.values
    })
}
