import integers from "std:integer"

export type Input = {
    callers: u64[][],
    exported: u32[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const values = in.callers.map(row => row.length != 0)[0]

    return loop({
        values,
        index: 0
    }, {
        while: (state, source) => state.index < source.exported.length,
        next: (state, source) => {
            state.values[integers.widen(source.exported[state.index])] = false
            state.index += 1
        },
        return: state => state.values
    }, in)
}
