import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind, TransformKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    time: u32[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const operations: u32[] = []

    return loop({
        operations,
        index: 0
    }, {
        while: state => state.index < in.expressions.kinds.length,
        next: state => {
            if (in.time[state.index] != max_u32) {
                const kind = in.expressions.kinds[state.index]

                const selected = match kind {
                    ExpressionKind.Call => true,
                    ExpressionKind.ListOperation => true,
                    ExpressionKind.ListUpdate => true,
                    ExpressionKind.Transform => in.expressions
                        .transform_kinds[
                            integers.widen(
                                in.expressions.payloads[state.index]
                            )
                        ] == TransformKind.Sort,
                    _ => false
                }

                if (selected) {
                    state.operations = state.operations.push(
                        integers.narrow(state.index)
                    )[0]
                }
            }

            state.index += 1
        },
        return: state => state.operations
    })
}
