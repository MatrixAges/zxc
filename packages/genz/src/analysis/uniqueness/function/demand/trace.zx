import integers from "std:integer"
import { ExpressionKind, BinaryOperator } from "core/expression_table/kinds"
import typeKind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import projection from "../levels/projection"
import aggregateChild from "./trace/aggregate_child"
import prepare from "./trace/prepare"
import reference from "./trace/reference"
import terminal from "./trace/terminal"

import type { Trace as Input, Working as Output } from "./model"

export default function trace(in: Input): Output {
    const prepared = prepare(in)
    const active = prepared.request

    if (active == null) {
        return prepared.working
    }

    const working = prepared.working
    const request = in.request
    const context = working.context
    const expressions = context.metadata.expressions
    const node = integers.widen(request.node)
    const payload = integers.widen(expressions.payloads[node])
    const kind = expressions.kinds[node]

    const leaf: u32? = match {
        request.slot == 0 &&
            typeKind(in.source.kinds[integers.widen(
                expressions.types[node]
            )]) == Kind.List => request.node,
        _ => request.outer
    }

    const nested = {
        ...active,
        outer: leaf
    }

    if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
        const selected = projection({
            metadata: context.metadata,
            slot: request.slot,
            target: expressions.projection_targets[payload],
            index: expressions.projection_indices[payload]
        })

        return trace({
            source: in.source,
            working,
            request: {
                ...nested,
                ...selected.pick([
                    "node",
                    "slot"
                ])
            }
        })
    }

    if (kind == ExpressionKind.OptionalValue || kind == ExpressionKind.Scope) {
        return trace({
            source: in.source,
            working,
            request: {
                ...nested,
                node: match kind {
                    ExpressionKind.Scope => expressions.scope_results[payload],
                    _ => expressions.optional_values[payload]
                }
            }
        })
    }

    if (kind == ExpressionKind.Reference) {
        const carried = reference({
            source: in.source,
            working,
            request: nested
        })

        const child = carried.request

        return match {
            child == null => carried.working,
            _ => trace({
                source: in.source,
                working: carried.working,
                request: child
            })
        }
    }

    if (kind == ExpressionKind.Object || kind == ExpressionKind.Tuple) {
        const object = kind == ExpressionKind.Object

        const first = match {
            object => expressions.object_first[payload],
            _ => expressions.sequence_first[payload]
        }

        const count = match {
            object => expressions.object_count[payload],
            _ => expressions.sequence_count[payload]
        }

        const type_id = expressions.types[node]

        return loop({
            working,
            index: 0
        }, {
            while: state => state.index < integers.widen(count),
            next: state => {
                const selected = aggregateChild({
                    metadata: state.working.context.metadata,
                    type_id,
                    object,
                    first,
                    index: state.index,
                    slot: active.slot
                })

                if (selected != null) {
                    state.working = trace({
                        source: in.source,
                        working: state.working,
                        request: {
                            ...active,
                            node: selected.node,
                            slot: selected.slot,
                            outer: null
                        }
                    })
                }

                state.index += 1
            },
            return: state => state.working
        })
    }

    if (kind == ExpressionKind.Some) {
        return trace({
            source: in.source,
            working,
            request: {
                ...active,
                node: expressions.some[payload],
                outer: null
            }
        })
    }

    const paired = match kind {
        ExpressionKind.Conditional => true,
        ExpressionKind.Binary =>
            expressions.binary_operators[payload] == BinaryOperator.Coalesce,
        _ => false
    }

    if (paired || kind == ExpressionKind.Match) {
        const conditional = kind == ExpressionKind.Conditional
        const first = paired ? 0 : expressions.match_first[payload]
        const count = paired ? 2 : integers.widen(expressions.match_count[payload])

        const arms = loop({
            working,
            index: 0
        }, {
            while: state => state.index < count,
            next: state => {
                const child = match {
                    paired && state.index == 0 => match {
                        conditional => expressions.conditional_yes[payload],
                        _ => expressions.binary_left[payload]
                    },
                    paired => match {
                        conditional => expressions.conditional_no[payload],
                        _ => expressions.binary_right[payload]
                    },
                    _ => state.working.context.metadata.expressions
                        .match_results[
                            integers.widen(
                                first
                            ) + state.index
                        ]
                }

                state.working = trace({
                    source: in.source,
                    working: state.working,
                    request: {
                        ...active,
                        node: child,
                        outer: null
                    }
                })
                state.index += 1
            },
            return: state => state.working
        })

        if (paired) {
            return arms
        }

        return trace({
            source: in.source,
            working: arms,
            request: {
                ...active,
                node: expressions.match_fallbacks[payload],
                outer: null
            }
        })
    }

    const final = terminal({
        source: in.source,
        working,
        request: nested
    })

    const child = final.request

    return match {
        child == null => final.working,
        _ => trace({
            source: in.source,
            working: final.working,
            request: child
        })
    }
}
