import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import usage from "../levels/usage"

import type { Context } from "../levels/model"

export type Input = {
    context: Context,
    node: u32,
    slot: u32
}

export type Output = bool

export default function (in: Input): Output {
    const expressions = in.context.metadata.expressions
    const node = integers.widen(in.node)
    const kind = expressions.kinds[node]

    if (
        kind == ExpressionKind.Field || kind == ExpressionKind.TupleField ||
            kind == ExpressionKind.OptionalValue
    ) {
        return true
    }

    const root = kind == ExpressionKind.Reference ?
        expressions.references[integers.widen(expressions.payloads[node])] :
        integers.narrow(in.context.metadata.usage.symbols + node)

    return usage({
        context: in.context,
        root,
        slot: in.slot,
        observe: false
    })
}
