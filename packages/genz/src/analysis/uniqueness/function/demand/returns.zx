import bytes from "std:bytes"
import integers from "std:integer"

import { Knowledge } from "../levels/model"
import read from "./read"
import trace from "./trace"

import type { Source, Working } from "./model"

export type Input = {
    source: Source,
    working: Working,
    function_index: u32
}

export type Output = Working

export default function (in: Input): Output {
    const count = bytes.atomicRowLength(
        in.source.outputs,
        integers.widen(in.function_index)
    )

    return loop({
        working: in.working,
        slot: 0
    }, {
        while: (state, source) => state.slot < source.count,
        next: (state, source) => {
            const slot = integers.narrow(state.slot)
            const wanted = read({
                stage: {
                    source: source.input.source,
                    working: state.working
                },
                output: true,
                function_index: source.input.function_index,
                slot
            })

            state.working = wanted.working

            if (wanted.value != Knowledge.None) {
                state.working = loop({
                    working: state.working,
                    index: 0
                }, {
                    while: (current, context) =>
                        current.index < context.source.results.length,
                    next: (current, context) => {
                        current.working = trace({
                            source: context.source,
                            working: current.working,
                            request: {
                                node: context.source.results[current.index],
                                slot: context.slot,
                                outer: null,
                                repeated: true,
                                wanted: context.wanted
                            }
                        })

                        current.index += 1
                    }
                }, {
                    source: source.input.source,
                    slot,
                    wanted: wanted.value
                }).working
            }

            state.slot += 1
        }
    }, {
        input: in,
        count
    }).working
}
