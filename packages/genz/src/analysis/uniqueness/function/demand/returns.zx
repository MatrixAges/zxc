import bytes from "std:bytes"
import integers from "std:integer"

import { Knowledge } from "../levels/model"
import read from "./read"
import trace from "./trace"

import type { Source, Working } from "./model"

export type Input = {
    source: Source,
    working: Working,
    function_index: u32
}

export type Output = Working

export default function (in: Input): Output {
    const count = bytes.atomicRowLength(
        in.source.outputs,
        integers.widen(in.function_index)
    )

    const loop_initial = {
        working: in.working,
        slot: 0
    }

    const loop_scope = {
        input: in,
        count
    }

    return loop(loop_initial, {
        while: state => state.slot < loop_scope.count,
        next: state => {
            const slot = integers.narrow(state.slot)
            const wanted = read({
                stage: {
                    source: loop_scope.input.source,
                    working: state.working
                },
                output: true,
                function_index: loop_scope.input.function_index,
                slot
            })

            state.working = wanted.working

            if (wanted.value != Knowledge.None) {
                const loop_initial_1 = {
                    working: state.working,
                    index: 0
                }

                const loop_scope_1 = {
                    source: loop_scope.input.source,
                    slot,
                    wanted: wanted.value
                }

                state.working = loop(loop_initial_1, {
                    while: current =>
                        current.index < loop_scope_1.source.results.length,
                    next: current => {
                        current.working = trace({
                            source: loop_scope_1.source,
                            working: current.working,
                            request: {
                                node: loop_scope_1.source.results[current.index],
                                slot: loop_scope_1.slot,
                                outer: null,
                                repeated: true,
                                wanted: loop_scope_1.wanted
                            }
                        })

                        current.index += 1
                    },
                    return: state => state.working
                })
            }

            state.slot += 1
        },
        return: state => state.working
    })
}
