import integers from "std:integer"

import { empty_key } from "./const"

import type { Query as Input, Position as Output } from "./model"

export default function (in: Input): Output {
    const index = integers.hash(in.key) % in.keys.length

    const result = loop({
        index
    }, {
        while: state => in.keys[state.index] != empty_key &&
            in.keys[state.index] != in.key,
        next: state => {
            state.index = (state.index + 1) % in.keys.length
        }
    })

    return {
        index: result.index,
        found: in.keys[result.index] == in.key
    }
}
