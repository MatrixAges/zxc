import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind, CollectionKind } from "core/expression_table/kinds"

import { Knowledge } from "../levels/model"
import read from "./read"
import trace from "./trace"

import type { Stage as Input, Working as Output } from "./model"

export default function (in: Input): Output {
    const readonly_loop_initial = {
        working: in.working,
        index: 0
    }

    const readonly_source = in.source

    return loop(readonly_loop_initial, {
        while: state => state.index < readonly_source.operations.length,
        next: state => {
            const expressions = state.working.context.metadata.expressions
            const owner = readonly_source.operations[state.index]

            const node = integers.widen(owner)
            const payload = integers.widen(expressions.payloads[node])
            const kind = expressions.kinds[node]

            if (kind == ExpressionKind.Call) {
                const function_index = expressions.call_functions[payload]
                const count = bytes.atomicRowLength(
                    readonly_source.inputs,
                    integers.widen(function_index)
                )

                const loop_initial = {
                    working: state.working,
                    slot: 0
                }

                const loop_scope = {
                    source: readonly_source,
                    count,
                    function_index,
                    argument: expressions.call_arguments[payload]
                }

                state.working = loop(loop_initial, {
                    while: current => current.slot < loop_scope.count,
                    next: current => {
                        const slot = integers.narrow(current.slot)
                        const wanted = read({
                            stage: {
                                source: loop_scope.source,
                                working: current.working
                            },
                            output: false,
                            function_index: loop_scope.function_index,
                            slot
                        })

                        current.working = wanted.working

                        if (wanted.value != Knowledge.None) {
                            current.working = trace({
                                source: loop_scope.source,
                                working: current.working,
                                request: {
                                    node: loop_scope.argument,
                                    slot,
                                    outer: null,
                                    repeated: true,
                                    wanted: wanted.value
                                }
                            })
                        }

                        current.slot += 1
                    },
                    return: state => state.working
                })
            } else {
                const operation = match {
                    kind == ExpressionKind.ListOperation =>
                        expressions.collection_kinds[payload],
                    _ => CollectionKind.Pop
                }
                const append = kind == ExpressionKind.ListOperation &&
                    (
                        operation == CollectionKind.Push ||
                            operation == CollectionKind.Concat
                    )
                const is_list_update = kind == ExpressionKind.ListUpdate

                const valid_kind = kind == ExpressionKind.ListOperation &&
                    (
                        operation == CollectionKind.Sort ||
                            operation == CollectionKind.Reverse
                    )

                const write = (
                    - is_list_update
                    - or (
                        valid_kind
                    )
                )

                if (append || write) {
                    const target = match {
                        kind == ExpressionKind.ListUpdate =>
                            expressions.update_targets[payload],
                        _ => expressions.collection_targets[payload]
                    }

                    state.working = trace({
                        source: readonly_source,
                        working: state.working,
                        request: {
                            node: target,
                            slot: 0,
                            outer: null,
                            repeated: false,
                            wanted: append ? Knowledge.Headered : Knowledge.Unique
                        }
                    })
                }
            }

            state.index += 1
        },
        return: state => state.working
    })
}
