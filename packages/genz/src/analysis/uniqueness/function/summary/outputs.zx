import integers from "std:integer"

import meet from "../levels/meet"
import { Knowledge } from "../levels/model"
import query from "../levels/query"

import type { ReturnStage as Input, Returned as Output } from "./model"

export default function (in: Input): Output {
    const levels: Knowledge[] = []
    const initial = in.source.results.length == 0 ? Knowledge.None : Knowledge.All

    const values_scope = {
        count: in.source.count,
        value: initial
    }

    const values = loop(levels, {
        while: state => state.length < values_scope.count,
        next: state => {
            state = state.push(values_scope.value)[0]
        }
    })

    const loop_initial = {
        known: in.working.known,
        reads: in.working.reads,
        levels: values,
        index: 0
    }

    const readonly_source = in.source

    return loop(loop_initial, {
        while: state => state.index < readonly_source.results.length,
        next: state => {
            const node = readonly_source.results[state.index]

            const row_initial = {
                known: state.known,
                reads: state.reads,
                levels: state.levels,
                slot: 0
            }

            const row_scope = {
                source: readonly_source,
                node
            }

            const row = loop(row_initial, {
                while: current => current.slot < row_scope.source.count,
                next: current => {
                    const result = query({
                        context: row_scope.source.context,
                        state: {
                            known: current.known,
                            carried: row_scope.source.carried,
                            reads: current.reads
                        },
                        request: {
                            node: row_scope.node,
                            slot: integers.narrow(current.slot),
                            raw: false
                        }
                    })

                    current.known = result.known
                    current.reads = result.reads
                    current.levels = current.levels.with(current.slot, meet({
                        left: current.levels[current.slot],
                        right: result.value
                    }))
                    current.slot += 1
                }
            })

            state.known = row.known
            state.reads = row.reads
            state.levels = row.levels
            state.index += 1
        },
        return: state => state.pick([
            "known",
            "reads",
            "levels"
        ])
    })
}
