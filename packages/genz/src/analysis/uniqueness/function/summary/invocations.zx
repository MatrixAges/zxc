import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    operations: u32[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const values: u32[] = []

    return loop({
        values,
        index: 0
    }, {
        while: state => state.index < in.operations.length,
        next: state => {
            const node = in.operations[state.index]

            if (
                in.expressions.kinds[integers.widen(node)] == ExpressionKind.Call
            ) {
                state.values = state.values.push(node)[0]
            }

            state.index += 1
        },
        return: state => state.values
    })
}
