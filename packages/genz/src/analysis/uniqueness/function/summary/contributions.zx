import bytes from "std:bytes"
import integers from "std:integer"

import query from "../levels/query"
import publish from "./publish"

import type { Knowledge } from "../levels/model"
import type {
    ArgumentStage as Input,
    Contributed as Output,
    Contribution
} from "./model"

export default function (in: Input): Output {
    const passed: Contribution[] = []
    const changed: u32[] = []

    const loop_initial = {
        known: in.working.known,
        reads: in.working.reads,
        index: 0,
        passed,
        changed
    }

    const readonly_source = in.source

    return loop(loop_initial, {
        while: state => state.index < readonly_source.operations.length,
        next: state => {
            const expressions = readonly_source.context.metadata.expressions

            const node = integers.widen(readonly_source.operations[state.index])

            const payload = integers.widen(expressions.payloads[node])
            const callee = expressions.call_functions[payload]
            const count =
                bytes.atomicRowLength(readonly_source.inputs, integers.widen(callee))
            const levels: Knowledge[] = []

            const row_initial = {
                known: state.known,
                reads: state.reads,
                changed: state.changed,
                levels,
                slot: 0
            }

            const row_scope = {
                source: readonly_source,
                callee,
                count,
                argument: expressions.call_arguments[payload]
            }

            const row = loop(row_initial, {
                while: current => current.slot < row_scope.count,
                next: current => {
                    const result = query({
                        context: row_scope.source.context,
                        state: {
                            known: current.known,
                            carried: row_scope.source.carried,
                            reads: current.reads
                        },
                        request: {
                            node: row_scope.argument,
                            slot: integers.narrow(current.slot),
                            raw: false
                        }
                    })

                    current.known = result.known
                    current.reads = result.reads
                    current.levels = current.levels.push(result.value)[0]

                    if (!row_scope.source.deferred) {
                        current.changed = publish({
                            inputs: row_scope.source.inputs,
                            callee: row_scope.callee,
                            slot: current.slot,
                            value: result.value,
                            changed: current.changed
                        })
                    }

                    current.slot += 1
                }
            })

            state.known = row.known
            state.reads = row.reads
            state.changed = row.changed
            state.passed = state.passed.push({
                callee,
                levels: row.levels
            })[0]

            state.index += 1
        },
        return: state => state.pick([
            "known",
            "reads",
            "passed",
            "changed"
        ])
    })
}
