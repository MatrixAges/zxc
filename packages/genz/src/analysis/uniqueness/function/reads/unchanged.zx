import bytes from "std:bytes"
import integers from "std:integer"

import decode from "../levels/decode"

import type { AtomicRows } from "std:bytes"

export type Layout = {
    stride: u64,
    table_offset: u64,
    function_offset: u64,
    slot_offset: u64,
    value_offset: u64,
    little_endian: bool
}

export type Input = {
    reads: u8[],
    tables: AtomicRows[],
    layout: Layout
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        offset: 0,
        same: true
    }, {
        while: (state, source) => state.same && state.offset < source.reads.length,
        next: (state, source) => {
            const layout = source.layout
            const table = source.reads[state.offset + layout.table_offset]
            const function_index = bytes.readU32(
                source.reads,
                state.offset + layout.function_offset,
                layout.little_endian
            )
            const slot = bytes.readU32(
                source.reads,
                state.offset + layout.slot_offset,
                layout.little_endian
            )
            const previous = source.reads[state.offset + layout.value_offset]
            const current = bytes.loadAtomicCell(
                source.tables[integers.widenByte(
                    table
                )],
                integers.widen(function_index),
                integers.widen(slot)
            )

            state.same = decode(current) == decode(previous)
            state.offset += layout.stride
        },
        return: state => state.same
    }, in)
}
