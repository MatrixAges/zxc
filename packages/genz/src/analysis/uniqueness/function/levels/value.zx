import { Knowledge } from "./model"

import type { Level as Output } from "../../level/model"

export type Input = Knowledge

export default function (in: Input): Output {
    return {
        headered: (
            match in {
                Knowledge.Headered => true,
                Knowledge.All => true,
                Knowledge.HeaderedDeferred => true,
                Knowledge.AllDeferred => true,
                _ => false
            }
        ),
        unique: (
            match in {
                Knowledge.Unique => true,
                Knowledge.All => true,
                Knowledge.UniqueDeferred => true,
                Knowledge.AllDeferred => true,
                _ => false
            }
        ),
        deferred: (
            match in {
                Knowledge.Deferred => true,
                Knowledge.HeaderedDeferred => true,
                Knowledge.UniqueDeferred => true,
                Knowledge.AllDeferred => true,
                _ => false
            }
        )
    }
}
