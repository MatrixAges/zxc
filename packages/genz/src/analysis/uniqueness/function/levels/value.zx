import { Knowledge } from "./model"

import type { Level as Output } from "../../level/model"

export type Input = Knowledge

export default function (in: Input): Output {
    return {
        headered: (
            - in == Knowledge.Headered
            - or in == Knowledge.All
            - or in == Knowledge.HeaderedDeferred
            - or in == Knowledge.AllDeferred
        ),
        unique: (
            - in == Knowledge.Unique
            - or in == Knowledge.All
            - or in == Knowledge.UniqueDeferred
            - or in == Knowledge.AllDeferred
        ),
        deferred: (
            - in == Knowledge.Deferred
            - or in == Knowledge.HeaderedDeferred
            - or in == Knowledge.UniqueDeferred
            - or in == Knowledge.AllDeferred
        )
    }
}
