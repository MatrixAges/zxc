import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import evaluate from "../../level/evaluate"
import lacks from "../../level/lacks"
import { Operation } from "../../level/model"
import knowledge from "./knowledge"
import { GrowthKind } from "./model"
import usage from "./usage"
import value from "./value"
import want from "./want"

import type { Context, Knowledge } from "./model"

export type Input = {
    context: Context,
    node: u32,
    slot: u32,
    value: Knowledge
}

export type Output = Knowledge

export default function (in: Input): Output {
    const normalized = in.slot == 0 ? want({
        values: in.context.normalized,
        kind: GrowthKind.Normalized,
        owner: in.node,
        slot: 0
    }) : null

    const wanted = normalized != null ? normalized : want({
        values: in.context.renewed,
        kind: GrowthKind.Value,
        owner: in.node,
        slot: in.slot
    })

    if (wanted == null) {
        return in.value
    }

    const left = value(in.value)
    const right = value(wanted)

    if (!lacks({
        left,
        right
    })) {
        return in.value
    }

    const node = integers.widen(in.node)

    return in.context.metadata.expressions.kinds[node] != ExpressionKind.Reference &&
        usage({
            context: in.context,
            root: integers.narrow(in.context.metadata.usage.symbols + node),
            slot: in.slot,
            observe: false
        })
        -> knowledge(evaluate({
            operation: Operation.Materialized,
            left,
            right,
            linear: _
        }))
}
