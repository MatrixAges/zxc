import integers from "std:integer"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    first: u32,
    count: u32,
    index: u32
}

export type Output = u32?

export default function (in: Input): Output {
    if (in.index < in.count) {
        const position = integers.widen(in.first) + integers.widen(in.index)

        if (in.expressions.object_field_indices[position] == in.index) {
            return in.expressions.object_field_values[position]
        }
    }

    const value: u32? = null

    return loop({
        position: 0,
        value
    }, {
        while: state => state.value == null &&
            state.position < integers.widen(in.count),
        next: state => {
            const position = integers.widen(in.first) + state.position

            if (
                in.expressions.object_field_indices[position] ==
                    in.index
            ) {
                state.value = in.expressions.object_field_values[position]
            }

            state.position += 1
        },
        return: state => state.value
    })
}
