import { Knowledge } from "./model"
import unique from "./unique"

export type Input = {
    left: Knowledge,
    right: Knowledge
}

export type Output = Knowledge

export default function (in: Input): Output {
    const left_headered = (
        - in.left == Knowledge.Headered
        - or in.left == Knowledge.All
        - or in.left == Knowledge.HeaderedDeferred
        - or in.left == Knowledge.AllDeferred
    )

    const right_headered = (
        - in.right == Knowledge.Headered
        - or in.right == Knowledge.All
        - or in.right == Knowledge.HeaderedDeferred
        - or in.right == Knowledge.AllDeferred
    )

    const retained = unique(in.left) && unique(in.right)

    if (left_headered && right_headered) {
        return retained ? Knowledge.All : Knowledge.Headered
    }

    const deferred = (
        - in.left != Knowledge.None
        - and in.left != Knowledge.Unique
        - and in.left != Knowledge.Unknown
        - or (
            in.right != Knowledge.None && in.right != Knowledge.Unique &&
                in.right != Knowledge.Unknown
        )
    )

    return match {
        retained && deferred => Knowledge.UniqueDeferred,
        retained => Knowledge.Unique,
        deferred => Knowledge.Deferred,
        _ => Knowledge.None
    }
}
