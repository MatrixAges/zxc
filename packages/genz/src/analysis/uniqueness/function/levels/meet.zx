import { Knowledge } from "./model"
import unique from "./unique"

export type Input = {
    left: Knowledge,
    right: Knowledge
}

export type Output = Knowledge

export default function (in: Input): Output {
    const left_headered = (
        match in.left {
            Knowledge.Headered => true,
            Knowledge.All => true,
            Knowledge.HeaderedDeferred => true,
            Knowledge.AllDeferred => true,
            _ => false
        }
    )

    const right_headered = (
        match in.right {
            Knowledge.Headered => true,
            Knowledge.All => true,
            Knowledge.HeaderedDeferred => true,
            Knowledge.AllDeferred => true,
            _ => false
        }
    )

    const retained = unique(in.left) && unique(in.right)

    if (left_headered && right_headered) {
        return retained ? Knowledge.All : Knowledge.Headered
    }

    const valid_right = in.right != Knowledge.None && in.right != Knowledge.Unique &&
        in.right != Knowledge.Unknown

    const deferred = (
        - in.left != Knowledge.None
        - and in.left != Knowledge.Unique
        - and in.left != Knowledge.Unknown
        - or (
            valid_right
        )
    )

    return match {
        retained && deferred => Knowledge.UniqueDeferred,
        retained => Knowledge.Unique,
        deferred => Knowledge.Deferred,
        _ => Knowledge.None
    }
}
