import integers from "std:integer"

import complete from "./complete"
import index from "./index"
import meet from "./meet"
import { Knowledge } from "./model"
import read from "./read"
import resolve from "./visit/resolve"
import rightNode from "./visit/right_node"

import type { Environment, Output, Read, Request } from "./model"

export type Input = {
    environment: Environment,
    known: Knowledge[],
    reads: Read[],
    request: Request
}

export default function visit(in: Input): Output {
    const context = in.environment.context
    const request = in.request

    const destination = match {
        request.raw => null,
        _ => index({
            first: context.metadata.usage.plan.slot_first,
            symbols: context.metadata.usage.symbols,
            node: request.node,
            slot: request.slot
        })
    }

    const cached = destination == null ? Knowledge.Unknown : in.known[destination]

    if (cached != Knowledge.Unknown) {
        return {
            known: in.known,
            reads: in.reads,
            value: cached
        }
    }

    const dependency = resolve({
        metadata: context.metadata,
        request
    })

    const base = match {
        dependency.carried_node == null => dependency.value,
        _ => in.environment.carried[integers.widen(dependency.carried_node)][
            integers.widen(
                request.slot
            )
        ]
    }

    const expressions = context.metadata.expressions

    const child = match {
        dependency.iteration_owner == null => dependency.child_node,
        expressions
            .iteration_postconditions[integers.widen(
                dependency.iteration_owner
            )] => null,
        _ =>
            expressions
            .iteration_initials[integers.widen(
                dependency.iteration_owner
            )]
    }

    const first: Output = match {
        child != null => visit({
            ...in,
            request: {
                node: child,
                slot: dependency.child_slot,
                raw: false
            }
        }),
        dependency.read_table != null => {
            known: in.known,
            ...read({
                context,
                reads: in.reads,
                table: dependency.read_table,
                function_index: dependency.read_function,
                slot: request.slot
            })
        },
        _ => {
            known: in.known,
            reads: in.reads,
            value: base
        }
    }

    const initial = match {
        dependency.carried_node != null && child != null => {
            ...first,
            value: meet({
                left: base,
                right: first.value
            })
        },
        _ => first
    }

    const right_node: u32? = match {
        !dependency.paired => null,
        _ => rightNode({
            table: expressions,
            node: request.node
        })
    }

    const right = match {
        right_node == null => initial,
        _ => visit({
            environment: in.environment,
            ...initial.pick([
                "known",
                "reads"
            ]),
            request: {
                node: right_node,
                slot: request.slot,
                raw: false
            }
        })
    }

    const paired = match {
        dependency.paired => {
            ...right,
            value: meet({
                left: initial.value,
                right: right.value
            })
        },
        _ => right
    }

    const environment = in.environment
    const results = expressions.match_results
    const first_arm = dependency.arms_first
    const arm_count = dependency.arms_count
    const slot = request.slot

    const result = loop({
        ...paired,
        cursor: 0
    }, {
        while: state => state.cursor < arm_count,
        next: state => {
            const child = visit({
                environment,
                ...state.pick([
                    "known",
                    "reads"
                ]),
                request: {
                    node:
                        results[first_arm + state.cursor],
                    slot,
                    raw: false
                }
            })

            state = {
                ...child,
                value: meet({
                    left: state.value,
                    right: child.value
                }),
                cursor: state.cursor + 1
            }
        },
        return: state => state.pick([
            "known",
            "reads",
            "value"
        ])
    })

    return complete({
        context,
        request,
        destination,
        ...dependency.pick([
            "operation",
            "linear_root",
            "empty"
        ]),
        result
    })
}
