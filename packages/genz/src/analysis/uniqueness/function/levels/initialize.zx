import integers from "std:integer"

import { Knowledge } from "./model"
import unknowns from "./unknowns"
import usage from "./usage"

import type { Repetition } from "./closure_model"
import type { Context, Read, State as Output } from "./model"

export type Input = {
    context: Context,
    repetitions: Repetition[]
}

export default function (in: Input): Output {
    const empty: Knowledge[] = []
    const reads: Read[] = []
    const first = in.context.metadata.usage.plan.slot_first

    const total = first[first.length - 1] - first[in.context.metadata.usage.symbols]

    const known = unknowns(integers.widen(total))

    const carried = in.context.metadata.expressions.kinds.map(kind => empty)[0]

    return loop({
        index: 0,
        known,
        carried,
        reads
    }, {
        while: state => state.index < in.repetitions.length,
        next: state => {
            const repetition = in.repetitions[state.index]
            const owner = integers.widen(repetition.owner)
            const type_id = in.context.metadata.expressions.types[owner]

            const size = in.context.metadata.counts[integers.widen(type_id)]

            const values: Knowledge[] = []

            const row_initial = {
                values,
                slot: 0
            }

            const row_scope = {
                context: in.context,
                repetition,
                size
            }

            const row = loop(row_initial, {
                while: current => current.slot < integers.widen(row_scope.size),
                next: current => {
                    const slot = integers.narrow(current.slot)
                    const condition = row_scope.repetition.condition
                    const linear = usage({
                        context: row_scope.context,
                        root: row_scope.repetition.parameter,
                        slot,
                        observe: false
                    }) && (condition == null || usage({
                        context: row_scope.context,
                        root: condition,
                        slot,
                        observe: true
                    }))

                    current.values = current.values.push(
                        linear ? Knowledge.All : Knowledge.Headered
                    )[0]
                    current.slot += 1
                },
                return: state => state.values
            })

            state.carried = state.carried.with(owner, row)
            state.index += 1
        },
        return: state => state.pick([
            "known",
            "carried",
            "reads"
        ])
    })
}
