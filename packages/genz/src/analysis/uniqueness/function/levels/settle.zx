import integers from "std:integer"

import entering from "./entering"
import invalidate from "./invalidate"
import meet from "./meet"
import query from "./query"

import type { Settlement as Input } from "./closure_model"
import type { State as Output } from "./model"

export default function (in: Input): Output {
    const result = loop({
        state: in.state,
        changed: true
    }, {
        while: current => current.changed,
        next: current => {
            const round = loop({
                state: current.state,
                index: 0,
                changed: false
            }, {
                while: scan => scan.index < in.repetitions.length,
                next: scan => {
                    const repetition = in.repetitions[scan.index]
                    const computed_owner = integers.widen(repetition.owner)

                    const row = scan.state.carried[computed_owner]

                    const slots_initial = {
                        state: scan.state,
                        slot: 0,
                        changed: false
                    }

                    const slots_scope = {
                        context: in.context,
                        repetition,
                        size: row.length
                    }

                    const slots = loop(slots_initial, {
                        while: item => item.slot < slots_scope.size,
                        next: item => {
                            const slot = integers.narrow(item.slot)
                            const before = query({
                                context: slots_scope.context,
                                state: item.state,
                                request: {
                                    node: slots_scope.repetition.initial,
                                    slot,
                                    raw: false
                                }
                            })

                            const before_state = {
                                known: before.known,
                                carried: item.state.carried,
                                reads: before.reads
                            }

                            const start = entering({
                                context: slots_scope.context,
                                owner: slots_scope.repetition.owner,
                                slot,
                                value: before.value
                            })

                            const body = query({
                                context: slots_scope.context,
                                state: before_state,
                                request: {
                                    node: slots_scope.repetition.body,
                                    slot,
                                    raw: false
                                }
                            })

                            const owner = integers.widen(slots_scope.repetition.owner)
                            const previous = item.state.carried[owner][item.slot]
                            const next = meet({
                                left: meet({
                                    left: previous,
                                    right: start
                                }),
                                right: body.value
                            })

                            item.state = {
                                known: body.known,
                                carried: before_state.carried,
                                reads: body.reads
                            }

                            if (next != previous) {
                                item.state = {
                                    ...item.state,
                                    carried: item.state.carried.with(
                                        owner,
                                        item.state.carried[owner].with(
                                            item.slot,
                                            next
                                        )
                                    )
                                }
                                item.changed = true
                            }

                            item.slot += 1
                        }
                    })

                    scan.state = slots.state
                    scan.changed = scan.changed || slots.changed
                    scan.index += 1
                }
            })

            current.state = match {
                round.changed => {
                    ...round.state,
                    known: invalidate(round.state.known)
                },
                _ => round.state
            }
            current.changed = round.changed
        }
    })

    return result.state
}
