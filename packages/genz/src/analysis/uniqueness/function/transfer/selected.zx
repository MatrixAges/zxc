import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import { normalize_flag, renew_flag } from "../plan/const"

import type { Input as Source } from "../plan/model"

export type Input = {
    source: Source,
    flags: u64[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const selected = in.flags.map(
        flag =>
            integers.andBits(flag, normalize_flag + renew_flag) != 0
    )[0]

    const operations = loop({
        selected,
        index: 0
    }, {
        while: state => state.index < in.source.operations.length,
        next: state => {
            const source = in.source
            const node = integers.widen(source.operations[state.index])
            const expressions = source.context.metadata.expressions
            const payload = integers.widen(expressions.payloads[node])

            const target = match expressions.kinds[node] {
                ExpressionKind.Call => expressions.call_arguments[payload],
                ExpressionKind.ListUpdate => expressions.update_targets[payload],
                ExpressionKind.Transform => expressions.transform_targets[payload],
                _ => expressions.collection_targets[payload]
            }

            if (expressions.kinds[node] == ExpressionKind.Call) {
                const owner = source.context.metadata.layout
                    .unwrapped[
                        integers.widen(
                            expressions.types[node]
                        )
                    ]

                const output = kind(source.types.kinds[integers.widen(owner)])
                const scalar = output == Kind.Scalar || output == Kind.Enumeration ||
                    output == Kind.ErrorSet
                const renewed = integers.andBits(
                    in.flags[integers.widen(target)],
                    renew_flag
                ) != 0

                if (!scalar || renewed) {
                    state.selected[integers.widen(target)] = true
                }
            } else {
                state.selected[integers.widen(target)] = true
            }

            state.index += 1
        },
        return: state => state.selected
    })

    const repeated_initial = {
        selected: operations,
        index: 0
    }

    const readonly_source = in.source

    const repeated = loop(repeated_initial, {
        while: state => state.index < readonly_source.repeated.length,
        next: state => {
            const expressions = readonly_source.context.metadata.expressions
            const node = integers.widen(readonly_source.repeated[state.index])

            if (expressions.kinds[node] == ExpressionKind.Iteration) {
                const payload = integers.widen(expressions.payloads[node])

                state
                    .selected[integers.widen(
                        expressions.iteration_initials[payload]
                    )] = true
                state
                    .selected[integers.widen(
                        expressions.iteration_bodies[payload]
                    )] = true
            }

            state.index += 1
        },
        return: state => state.selected
    })

    const loop_initial = {
        selected: repeated,
        index: 0
    }

    const readonly_source_2 = in.source

    return loop(loop_initial, {
        while: state => state.index < readonly_source_2.results.length,
        next: state => {
            state.selected[integers.widen(
                readonly_source_2.results[state.index]
            )] = true
            state.index += 1
        },
        return: state => state.selected
    })
}
