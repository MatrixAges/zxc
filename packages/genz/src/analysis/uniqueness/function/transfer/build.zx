import integers from "std:integer"

import { bits_per_word } from "../../flow/body/const"
import empty from "../../flow/body/visited"
import qualify from "./qualify"
import selected from "./selected"

import type { Input } from "./selected"

export type Output = u64[]

export default function (in: Input): Output {
    const needed = selected(in)
    const transfers = empty(in.source.state.known.length)
    const first = in.source.context.metadata.usage.plan.slot_first
    const symbols = in.source.context.metadata.usage.symbols

    const loop_initial = {
        transfers,
        node: 0,
        slot: 0
    }

    const loop_scope = {
        input: in.source,
        needed,
        first,
        symbols
    }

    return loop(loop_initial, {
        while: state => state.node < loop_scope.needed.length,
        next: state => {
            const base = loop_scope.first[loop_scope.symbols + state.node]
            const end = loop_scope.first[loop_scope.symbols + state.node + 1]

            if (
                !loop_scope.needed[state.node] ||
                    state.slot >= integers.widen(end - base)
            ) {
                state.node += 1
                state.slot = 0
            } else {
                if (qualify({
                    context: loop_scope.input.context,
                    node: integers.narrow(state.node),
                    slot: integers.narrow(state.slot)
                })) {
                    const bit = integers.widen(
                        base - loop_scope.first[loop_scope.symbols]
                    ) + state.slot
                    const word = bit / bits_per_word

                    state.transfers[word] = integers.orBits(
                        state.transfers[word],
                        integers.bitMask(bit % bits_per_word)
                    )
                }

                state.slot += 1
            }
        },
        return: state => state.transfers
    })
}
