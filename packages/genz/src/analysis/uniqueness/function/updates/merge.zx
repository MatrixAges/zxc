import bytes from "std:bytes"
import integers from "std:integer"

import join from "../../level/join"
import decode from "../levels/decode"
import encode from "../levels/encode"
import knowledge from "../levels/knowledge"
import meet from "../levels/meet"
import value from "../levels/value"

import type { AtomicRows } from "std:bytes"

export type Input = {
    rows: AtomicRows,
    row: u32,
    first: u32,
    levels: u8[],
    joining: bool
}

export type Output = u64

export default function (in: Input): Output {
    return loop({
        index: 0,
        changed: 0
    }, {
        while: state => state.index < in.levels.length,
        next: state => {
            const row = integers.widen(in.row)
            const slot = integers.widen(in.first) + state.index
            const before = decode(bytes.loadAtomicCell(in.rows, row, slot))
            const incoming = decode(in.levels[state.index])
            const next = match {
                in.joining => knowledge(join({
                    left: value(before),
                    right: value(incoming)
                })),
                _ => meet({
                    left: before,
                    right: incoming
                })
            }

            if (next != before) {
                bytes.storeAtomicCell(in.rows, row, slot, encode(next))

                state.changed += 1
            }

            state.index += 1
        },
        return: state => state.changed
    })
}
