import integers from "std:integer"

import { slot_stride } from "../levels/const"
import { Knowledge } from "../levels/model"

import type { Context, Growth } from "../levels/model"

export type Input = {
    context: Context,
    owners: u32[]
}

export type Output = Context

export default function (in: Input): Output {
    const renewed: Growth[] = []

    const values = loop({
        index: 0,
        renewed
    }, {
        while: state => state.index < in.owners.length,
        next: state => {
            const owner = in.owners[state.index]
            const type_id =
                in.context.metadata.expressions.types[integers.widen(owner)]

            const loop_initial = {
                slot: 0,
                renewed: state.renewed
            }

            const loop_scope = {
                context: in.context,
                owner,
                type_id
            }

            state.renewed = loop(loop_initial, {
                while: slot => slot.slot <
                    integers.widen(
                        loop_scope.context.metadata
                            .counts[integers.widen(
                                loop_scope.type_id
                            )]
                    ),
                next: slot => {
                    slot.renewed = slot.renewed.push({
                        key: integers.widen(loop_scope.owner) * slot_stride + slot.slot,
                        value: Knowledge.All
                    })[0]
                    slot.slot += 1
                },
                return: state => state.renewed
            })
            state.index += 1
        },
        return: state => state.renewed
    })

    return {
        ...in.context,
        normalized: [],
        renewed: values
    }
}
