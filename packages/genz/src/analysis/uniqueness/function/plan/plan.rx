<Module>
    <Type from="model" as="Plan" />

    <Args in={Plan.Input} out={Plan.Output} />

    <Call fn="initialize" in={$in} />

    <Task name="normalized" out={$ctx.growth_flags}>
        <Call
            fn="growth_flags"
            in={{
                source: $in,
                working: $ctx.initialize,
                entries: $in.context.normalized,
                normalized: true
            }}
        />
    </Task>

    <Task name="renewed" out={$ctx.growth_flags}>
        <Call
            fn="growth_flags"
            in={{
                source: $in,
                working: $ctx.task.normalized,
                entries: $in.context.renewed,
                normalized: false
            }}
        />
    </Task>

    <Call
        fn="flags"
        in={{
            source: $in,
            working: $ctx.task.renewed
        }}
    />

    <Call
        module="buffers"
        in={{
            source: $in,
            working: $ctx.flags
        }}
    />

    <Call
        fn="renewal_keys"
        in={{
            source: $in,
            working: $ctx.buffers
        }}
    />

    <Call
        fn="renewal_paths"
        in={{
            source: $in,
            keys: $ctx.renewal_keys.keys
        }}
    />

    <Call
        fn="../transfer/build"
        in={{
            source: $in,
            flags: $ctx.renewal_keys.working.flags
        }}
    />

    <Return
        value={{
            ...$ctx.renewal_keys.working,
            renewals: {
                keys: $ctx.renewal_keys.keys,
                paths: $ctx.renewal_paths
            },
            transfers: $ctx.build
        }}
    />
</Module>
