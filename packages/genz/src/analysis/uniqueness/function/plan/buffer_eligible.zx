import integers from "std:integer"

import mutation from "../../../iteration/buffers/mutation"
import bufferLoop from "./buffer_loop"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const writes = loop({
        index: 0,
        found: false
    }, {
        while: state => !state.found &&
            state.index < in.operations.length,
        next: state => {
            state.found = mutation({
                types: in.types,
                expressions: in.context.metadata.expressions,
                index: integers.widen(in.operations[state.index])
            })
            state.index += 1
        },
        return: state => state.found
    })

    if (!writes) {
        return false
    }

    return loop({
        index: 0,
        found: false
    }, {
        while: state => !state.found && state.index < in.repeated.length,
        next: state => {
            state.found = bufferLoop({
                source: in,
                node: in.repeated[state.index]
            })
            state.index += 1
        },
        return: state => state.found
    })
}
