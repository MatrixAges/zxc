import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import listType from "../../slots/list_type"

import type { Input as Source } from "./model"

export type Input = {
    source: Source,
    node: u32
}

export type Output = bool

export default function (in: Input): Output {
    const expressions = in.source.context.metadata.expressions
    const node = integers.widen(in.node)
    const type_id = expressions.types[node]
    const target = kind(in.source.types.kinds[integers.widen(type_id)])

    const valid_target = target != Kind.Object && target != Kind.Tuple

    const iteration = expressions.kinds[node] == ExpressionKind.Iteration

    if (!iteration || valid_target) {
        return false
    }

    const result_initial = {
        slot: 0,
        valid: true,
        product: false
    }

    const result_scope = {
        source: in.source,
        type_id
    }

    return loop(result_initial, {
        while: state => state.valid &&
            state.slot < integers.widen(
                result_scope.source.context.metadata
                    .counts[integers.widen(
                        result_scope.type_id
                    )]
            ),
        next: state => {

            const list = listType({
                layout: result_scope.source.context.metadata.layout,
                kinds: result_scope.source.types.kinds,
                type_id: result_scope.type_id,
                slot: integers.narrow(state.slot)
            })

            const child = result_scope.source.types.first[integers.widen(list)]
            const bare = result_scope.source.context.metadata.layout
                .unwrapped[integers.widen(
                    child
                )]

            const target =
                kind(result_scope.source.types.kinds[integers.widen(bare)])

            state.valid =
                result_scope.source.context.metadata.counts[integers.widen(
                    child
                )] == 0
            state.product = state.product || target == Kind.Object || target == Kind.Tuple
            state.slot += 1
        },
        return: state => state.valid && state.product
    })
}
