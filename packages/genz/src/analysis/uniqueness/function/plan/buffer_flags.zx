import integers from "std:integer"
import { ExpressionKind, CollectionKind } from "core/expression_table/kinds"

import query from "../levels/query"
import value from "../levels/value"
import { buffered_flag } from "./const"

import type { Context, State } from "../levels/model"
import type { Stage, Working as Output } from "./model"

export type Input = {
    stage: Stage,
    context: Context,
    state: State,
    owners: u32[]
}

export default function (in: Input): Output {
    const flags = loop({
        index: 0,
        flags: in.stage.working.flags
    }, {
        while: (state, context) => state.index < context.owners.length,
        next: (state, context) => {
            const owner = integers.widen(context.owners[state.index])

            state.flags = state.flags.with(
                owner,
                integers.orBits(state.flags[owner], buffered_flag)
            )
            state.index += 1
        },
        return: state => state.flags
    }, in)

    const result = loop({
        index: 0,
        known: in.state.known,
        reads: in.state.reads,
        flags
    }, {
        while: (state, context) => state.index < context.stage.source.operations.length,
        next: (state, context) => {
            const expressions = context.context.metadata.expressions
            const node = integers.widen(context.stage.source.operations[state.index])
            const kind = expressions.kinds[node]
            const payload = integers.widen(expressions.payloads[node])
            const collection = kind == ExpressionKind.ListOperation

            if (
                kind == ExpressionKind.ListUpdate || (
                    collection &&
                        (
                            expressions.collection_kinds[payload] ==
                                CollectionKind.Push ||
                                expressions.collection_kinds[payload] ==
                                CollectionKind.Pop
                        )
                )
            ) {
                const target = collection ? expressions.collection_targets[payload] :
                    expressions.update_targets[payload]

                const result = query({
                    context: context.context,
                    state: {
                        known: state.known,
                        carried: context.state.carried,
                        reads: state.reads
                    },
                    request: {
                        node: target,
                        slot: 0,
                        raw: false
                    }
                })

                state.known = result.known
                state.reads = result.reads

                if (value(result.value).unique) {
                    state.flags = state.flags.with(
                        node,
                        integers.orBits(state.flags[node], buffered_flag)
                    )
                }
            }

            state.index += 1
        }
    }, in)

    const reads = loop({
        reads: in.stage.working.reads,
        index: 0
    }, {
        while: (state, entries) => state.index < entries.length,
        next: (state, entries) => {
            state.reads = state.reads.push({
                ...entries[state.index]
            })[0]
            state.index += 1
        },
        return: state => state.reads
    }, result.reads)

    return {
        known: in.stage.working.known,
        reads,
        flags: result.flags
    }
}
