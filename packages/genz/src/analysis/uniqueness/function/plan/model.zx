import type { Table } from "core/type_table/model"
import type { Renewals } from "../../renewals/model"
import type { Context, Knowledge, Read } from "../levels/model"

export type Snapshot = {
    known: Knowledge[],
    carried: Knowledge[][]
}

export type Input = {
    context: Context,
    state: Snapshot,
    types: Table,
    time: u32[],
    operations: u32[],
    repeated: u32[]
    results: u32[]
}

export type Working = Output.Omit("needed", "keys")

export type Stage = {
    source: Input,
    working: Working
}

export type Selected = {
    working: Working,
    keys: u64[]
}

export type Output = {
    known: Knowledge[],
    reads: Read[],
    flags: u64[],
    keys: u64[],
    needed: bool[]
}

export type Finish = {
    source: Input,
    flags: u64[],
    keys: u64[],
    needed: bool[]
}

export type Published = {
    flags: u8[],
    renewals: Renewals
    transfers: u64[]
}
