import integers from "std:integer"
import { max_u32 } from "core/const"

import lacks from "../../level/lacks"
import { slot_stride } from "../../renewals/const"
import { value_renewal } from "../levels/const"
import query from "../levels/query"
import value from "../levels/value"
import { normalize_flag, renew_flag } from "./const"

import type { Growth } from "../levels/model"
import type { Input as Source, Working } from "./model"

export type Input = {
    source: Source,
    working: Working,
    entries: Growth[],
    normalized: bool
}

export type Output = Working

export default function (in: Input): Output {
    return loop({
        index: 0,
        working: in.working
    }, {
        while: state => state.index < in.entries.length,
        next: state => {
            const entry = in.entries[state.index]
            const own_value = entry.key >= value_renewal

            if (in.normalized || own_value) {
                const packed = own_value ? entry.key - value_renewal : entry.key
                const node = in.normalized ? entry.key : packed / slot_stride
                const slot = in.normalized ? 0 : packed % slot_stride

                if (in.source.time[node] != max_u32) {
                    const want = value(entry.value)

                    if (in.normalized || want.unique) {
                        const result = query({
                            context: in.source.context,
                            state: {
                                known: state.working.known,
                                carried: in.source.state.carried,
                                reads: state.working.reads
                            },
                            request: {
                                node: integers.narrow(node),
                                slot: integers.narrow(slot),
                                raw: true
                            }
                        })

                        const active = want.unique && lacks({
                            left: value(result.value),
                            right: want
                        })

                        const flag = in.normalized ? normalize_flag : renew_flag
                        const previous = state.working.flags[node]

                        state.working = {
                            known: result.known,
                            reads: result.reads,
                            flags: match {
                                active => state.working.flags.with(
                                    node,
                                    integers.orBits(previous, flag)
                                ),
                                _ => state.working.flags
                            }
                        }
                    }
                }
            }

            state.index += 1
        },
        return: state => state.working
    })
}
