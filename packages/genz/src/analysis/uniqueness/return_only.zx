import body from "../calls/body"
import noParallel from "../control/no_parallel"

import type { Table as Input } from "core/function_table/model"

export type Output = bool[]

export default function (in: Input): Output {
    const allowed = in.native_modules.map(value => false)[0]

    return loop({
        allowed,
        index: 0
    }, {
        while: state => state.index < state.allowed.length,
        next: state => {
            const index = state.index

            if (
                in.native_modules[index] == null &&
                    in.stores[index].paths.length == 0
            ) {
                state.allowed[index] = noParallel(
                    in.control[index].statement_kinds
                ) && body({
                    expressions: in.expressions[index],
                    contracts: in.contracts[index],
                    allowed: state.allowed,
                    self_function: null,
                    limit: index
                })
            }

            state.index += 1
        },
        return: state => state.allowed
    })
}
