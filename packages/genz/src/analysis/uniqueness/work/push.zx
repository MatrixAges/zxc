import type { Push as Input, State as Output } from "./model"

export default function (in: Input): Output {
    if (in.state.queued[in.index]) {
        return in.state
    }

    return {
        ...in.state,
        buffer: in.state.tail < in.state.buffer.length
            ? in.state.buffer.with(in.state.tail, in.index)
            : in.state.buffer.push(in.index)[0],
        queued: in.state.queued.with(in.index, true),
        tail: in.state.tail + 1
    }
}
