import push from "./push"

import type { Fill as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return loop({
        state: in.state,
        index: 0
    }, {
        while: current => current.index < in.native_modules.length + 1,
        next: current => {
            const active = match {
                current.index < in.native_modules.length =>
                    in.native_modules[current.index] == null,
                _ => !in.type_only
            }

            if (active) {
                current.state = push({
                    state: current.state,
                    index: current.index
                })
            }

            current.index += 1
        },
        return: current => current.state
    })
}
