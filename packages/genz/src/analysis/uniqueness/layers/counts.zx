import integers from "std:integer"

import type { Depths } from "./model"

export type Input = Depths

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    const initial = loop({
        values: empty,
        index: 0,
        maximum: integers.widen(in.maximum)
    }, {
        while: current => current.index <= current.maximum,
        next: current => {
            current.values = current.values.push(0)[0]
            current.index += 1
        }
    })

    const result = loop({
        depths: in.values,
        counts: initial.values,
        index: 0
    }, {
        while: current => current.index < current.depths.length,
        next: current => {
            const depth = integers.widen(current.depths[current.index])

            current.counts[depth] += 1
            current.index += 1
        }
    })

    return result.counts
}
