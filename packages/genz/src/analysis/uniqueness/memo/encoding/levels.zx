import integers from "std:integer"

import { level_modulus } from "../../replay/ordered/const"
import { level_pair_radix } from "./const"
import word from "./word"

import type { Levels as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const state = word({
        state: in.state,
        value: in.values.length
    })

    const loop_initial = {
        state,
        index: 0
    }

    const readonly_values = in.values

    return loop(loop_initial, {
        while: current => current.index < readonly_values.length,
        next: current => {
            const lower_input = readonly_values[current.index] % level_modulus

            const lower = integers.widenByte(lower_input)
            const upper = match {
                current.index + 1 < readonly_values.length =>
                    integers.widenByte(
                        readonly_values[current.index + 1] % level_modulus
                    ),
                _ => 0
            }
            const byte = integers.narrowByte(lower + upper * level_pair_radix)

            current.state.buffer = match {
                current.state.end < current.state.buffer.length =>
                    current.state.buffer.with(current.state.end, byte),
                _ => current.state.buffer.push(byte)[0]
            }
            current.state.end += 1
            current.index += 2
        },
        return: current => current.state
    })
}
