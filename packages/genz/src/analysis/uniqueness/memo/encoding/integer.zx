import integers from "std:integer"

import { byte_radix } from "./const"

import type { Integer as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const loop_initial = {
        state: in.state,
        value: in.value,
        index: 0
    }

    const readonly_width = in.width

    return loop(loop_initial, {
        while: current => current.index < readonly_width,
        next: current => {
            const byte = integers.narrowByte(current.value % byte_radix)

            current.state.buffer = match {
                current.state.end < current.state.buffer.length =>
                    current.state.buffer.with(current.state.end, byte),
                _ => current.state.buffer.push(byte)[0]
            }
            current.state.end += 1
            current.value /= byte_radix
            current.index += 1
        },
        return: current => current.state
    })
}
