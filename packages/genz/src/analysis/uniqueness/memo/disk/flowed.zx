import { boolean_limit, byte_width } from "./const"
import boolean from "./fields/boolean"
import checked from "./fields/checked"

import type { Flowed, Record as Input } from "./model"

export type Output = Flowed?

export default function (in: Input): Output {
    const { source, trusted } = in

    const held = checked({
        source,
        start: in.start,
        stride: byte_width,
        limit: boolean_limit,
        mark: false,
        trusted
    })

    const text_held = checked({
        source,
        start: held.end,
        stride: byte_width,
        limit: boolean_limit,
        mark: false,
        trusted
    })

    const written = checked({
        source,
        start: text_held.end,
        stride: byte_width,
        limit: boolean_limit,
        mark: false,
        trusted
    })

    const end = boolean({
        source,
        start: written.end
    })

    if (end == 0) {
        return null
    }

    return {
        end,
        held_start: held.start,
        held_end: held.end,
        text_held_start: text_held.start,
        text_held_end: text_held.end,
        written_start: written.start,
        written_end: written.end
    }
}
