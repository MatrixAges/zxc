import { boolean_limit, byte_width } from "../const"
import vector from "./vector"

export type Input = {
    source: u8[],
    start: u64,
    stride: u64,
    limit: u8,
    mark: bool
}

export type Output = u64

export default function (in: Input): Output {
    if (in.start == 0) {
        return 0
    }

    const span = vector({
        source: in.source,
        start: in.start,
        width: in.stride
    })

    return loop({
        offset: span.start,
        valid: true
    }, {
        while: state => state.valid && state.offset < span.end,
        next: state => {
            const end = state.offset + in.stride
            const valid_level = in.source[end - byte_width] < in.limit
            const valid_mark = !in.mark || in.source[state.offset] < boolean_limit

            state.valid = valid_level && valid_mark
            state.offset = end
        },
        return: state => state.valid ? span.end : 0
    })
}
