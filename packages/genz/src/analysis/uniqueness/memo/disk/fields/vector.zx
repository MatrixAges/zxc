import bytes from "std:bytes"
import integers from "std:integer"

import { word_width } from "../../encoding/const"

import type { Span as Output } from "../model"

export type Input = {
    source: u8[],
    start: u64,
    width: u64
}

export default function (in: Input): Output {
    const count = bytes.readU32(in.source, in.start, true)
    const start = in.start + word_width
    const end = start + integers.widen(count) * in.width

    return {
        start,
        end: end <= in.source.length ? end : 0,
        count
    }
}
