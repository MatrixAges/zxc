import bytes from "std:bytes"
import integers from "std:integer"

import { word_radix, word_width } from "../encoding/const"
import { byte_width, wide_width } from "./const"
import boolean from "./fields/boolean"
import vector from "./fields/vector"

import type { Planned, Record as Input } from "./model"

export type Output = Planned?

export default function (in: Input): Output {
    const { source, start, trusted } = in

    const flags = vector({
        source,
        start,
        width: byte_width
    })

    if (flags.end == 0) {
        return null
    }

    const keys = vector({
        source,
        start: flags.end,
        width: wide_width
    })

    if (keys.end == 0) {
        return null
    }

    const paths = vector({
        source,
        start: keys.end,
        width: word_width
    })

    if (paths.end == 0 || paths.count != keys.count) {
        return null
    }

    const transfers_start = loop({
        key_offset: keys.start,
        path_offset: paths.start,
        previous: 0
    }, {
        while: state => state.path_offset != 0 && state.key_offset < keys.end,
        next: state => {
            const key = match trusted {
                true => state.previous,
                _ => integers.widen(
                    bytes.readU32(
                        source,
                        state.key_offset + word_width,
                        true
                    )
                ) * word_radix + integers.widen(
                    bytes.readU32(
                        source,
                        state.key_offset,
                        true
                    )
                )
            }

            if (key < state.previous) {
                state.path_offset = 0
            } else {
                state.path_offset = vector({
                    source,
                    start: state.path_offset,
                    width: word_width
                }).end
                state.previous = key
                state.key_offset += wide_width
            }
        },
        return: state => state.path_offset
    })

    if (transfers_start == 0) {
        return null
    }

    const transfers = vector({
        source,
        start: transfers_start,
        width: wide_width
    })

    if (transfers.end == 0) {
        return null
    }

    const slot_first = vector({
        source,
        start: transfers.end,
        width: word_width
    })

    const end = boolean({
        source,
        start: slot_first.end
    })

    if (end == 0) {
        return null
    }

    return {
        end,
        flags_start: flags.start,
        flags_end: flags.end,
        keys_start: keys.start,
        keys_end: keys.end,
        paths_start: paths.start,
        paths_count: paths.count,
        transfers_start: transfers.start,
        transfers_end: transfers.end,
        slot_first_start: slot_first.start,
        slot_first_end: slot_first.end
    }
}
