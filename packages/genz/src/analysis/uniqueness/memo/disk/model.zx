export enum Kind {
    Settled,
    Demanded,
    Planned,
    Flowed
}

export type Input = {
    source: u8[]
}

export type Scan = {
    source: u8[],
    start: u64,
    kind: Kind
}

export type Span = {
    start: u64,
    end: u64,
    count: u32
}

export type Layout = {
    settled_start: u64,
    settled_count: u32,
    demanded_start: u64,
    demanded_count: u32,
    planned_start: u64,
    planned_count: u32,
    flowed_start: u64,
    flowed_count: u32
}

export type Output = Layout?

export type Record = {
    source: u8[],
    start: u64,
    trusted: bool
}

export type Settled = {
    end: u64,
    passed_start: u64,
    passed_count: u32,
    output_start: u64,
    output_end: u64
}

export type Demanded = {
    end: u64,
    marks_start: u64,
    marks_count: u32,
    normalized_start: u64,
    normalized_count: u32,
    renewed_start: u64,
    renewed_count: u32,
    grew: bool
}

export type Planned = {
    end: u64,
    flags_start: u64,
    flags_end: u64,
    keys_start: u64,
    keys_end: u64,
    paths_start: u64,
    paths_count: u32,
    transfers_start: u64,
    transfers_end: u64,
    slot_first_start: u64,
    slot_first_end: u64
}

export type Flowed = {
    end: u64,
    held_start: u64,
    held_end: u64,
    text_held_start: u64,
    text_held_end: u64,
    written_start: u64,
    written_end: u64
}
