import { level_modulus } from "../../replay/ordered/const"
import { word_width } from "../encoding/const"
import { byte_width, wide_width } from "./const"
import boolean from "./fields/boolean"
import checked from "./fields/checked"
import vector from "./fields/vector"

import type { Record as Input, Settled } from "./model"

export type Output = Settled?

export default function (in: Input): Output {
    const { source, start, trusted } = in

    const passed = vector({
        source,
        start,
        width: wide_width
    })

    if (passed.end == 0) {
        return null
    }

    const output_start = loop({
        offset: passed.start,
        remaining: passed.count
    }, {
        while: state => state.offset != 0 && state.remaining != 0,
        next: state => {
            state.offset = checked({
                source,
                start: state.offset + word_width,
                stride: byte_width,
                limit: level_modulus,
                mark: false,
                trusted
            }).end
            state.remaining -= 1
        },
        return: state => state.offset
    })

    const output = checked({
        source,
        start: output_start,
        stride: byte_width,
        limit: level_modulus,
        mark: false,
        trusted
    })

    const end = boolean({
        source,
        start: output.end
    })

    if (end == 0) {
        return null
    }

    return {
        end,
        passed_start: passed.start,
        passed_count: passed.count,
        output_start: output.start,
        output_end: output.end
    }
}
