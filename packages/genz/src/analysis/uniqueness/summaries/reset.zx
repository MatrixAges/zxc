import bytes from "std:bytes"

import encode from "../function/levels/encode"
import { Knowledge } from "../function/levels/model"
import { Mode } from "./model"

import type { Lifecycle as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const count = bytes.atomicRowsCount(in.input)
    const all = encode(Knowledge.All)
    const none = encode(Knowledge.None)

    const result_initial = {
        index: 0
    }

    const result_scope = {
        input: in,
        count,
        all,
        none
    }

    const result = loop(result_initial, {
        while: state => state.index < result_scope.count,
        next: state => {
            const internal = result_scope.input.native_modules[state.index] == null
            const reached = result_scope.input.mode == Mode.Initialize ||
                result_scope.input.known[state.index]

            bytes.fillAtomicRow(
                result_scope.input.input,
                state.index,
                internal && reached ? result_scope.all : result_scope.none
            )
            bytes.fillAtomicRow(
                result_scope.input.output,
                state.index,
                internal ? result_scope.all : result_scope.none
            )

            state.index += 1
        }
    })
}
