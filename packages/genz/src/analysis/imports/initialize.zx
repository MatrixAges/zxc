import integers from "std:integer"
import initialize from "core/bytes/index/initialize"

import context from "../../ast/context/initialize"

import type { Input, State } from "./model"

export type Output = State

export default function (in: Input): Output {
    return {
        source: in,
        index: initialize(integers.widen(in.count) + in.modules.length),
        context: context({
            capture: null,
            expression_base: in.expression_base,
            statement_base: 0,
            field_base: 0,
            serial: 0
        }),
        declarations: [],
        aliases: []
    }
}
