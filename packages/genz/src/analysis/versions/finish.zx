import calls from "./inferred"

import type { Call } from "../unit"
import type { Machine } from "./model"

export type Input = Machine

export type Output = { found: bool, updates: u32[], calls: Call[] }

export default function (in: Input): Output {
    return { found: in.stack[in.stack.length - 1] == 1, updates: in.updates, calls: calls(in.inferred) }
}
