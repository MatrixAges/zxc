import retains from "./value/retains"

import type { Arena } from "./value/model"

export type Input = { arena: Arena, values: u64[], versions: u64[], output: u32[] }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ arena: in.arena, values: in.values, versions: in.versions, output: in.output, position: 0, valid: true }, {
        while: current => current.valid && current.position < current.values.length,
        next: current => {
            current.valid = retains({ arena: current.arena, value: current.values[current.position], paths: current.output, first: 0, count: current.output.length, current: current.versions[current.position] })
            current.position += 1
        }
    })

    return result.valid
}
