import frame from "./frame"
import { Op } from "./model"

import type { Machine } from "./model"

export type Input = { machine: Machine, iteration: u64, condition: u64, value: u64, count: u64 }

export type Output = Machine

export default function (in: Input): Output {
    const discover = { ...frame({ op: Op.DiscoverCondition, id: in.iteration, a: 0, b: in.value }), first: 0, count: in.count }
    const condition = frame({ op: Op.Expression, id: in.condition, a: 0, b: 0 })

    return { ...in.machine, frames: in.machine.frames.concat([discover, condition])[0] }
}
