import integers from "std:integer"

import frame from "./frame"
import bind from "./machine/bind"
import create from "./machine/create"
import { Op } from "./model"
import retained from "./retained"
import run from "./run"
import seed from "./value/seed"

import type { Table } from "core/type_table/model"
import type { Lane, Lanes, Unit } from "../unit"

export type Input = { types: Table, units: Unit[], summaries: Lanes[], readers: bool[], unit: u64, limit: u64, lane: Lane }

export type Output = bool

export default function (in: Input): Output {
    const settings = { enabled: true, summaries: in.limit, readers: in.limit, discover: false, selecting: true, looping: true }
    const created = create({ types: in.types, units: in.units, summaries: in.summaries, readers: in.readers, selected: in.lane.calls, loops: in.lane.iterations, unit: in.unit, limit: in.units.length - 1, settings: settings })
    const unit = in.units[in.unit]
    const seeded = seed({ types: created.types, arena: created.arena, type_id: unit.input_type, path: in.lane.input, current: 0 })
    const machine = bind({ machine: { ...created, arena: seeded.arena }, symbol: 0, value: seeded.value })
    const root = unit.root

    if (root == null) {
        return false
    }

    const finished = run({ ...machine, frames: machine.frames.push(frame({ op: Op.Block, id: integers.widen(root), a: 0, b: 0 }))[0] })

    if (finished.stack[finished.stack.length - 1] != 1 || !finished.context.valid || finished.results.values.length == 0) {
        return false
    }

    return retained({ arena: finished.arena, values: finished.results.values, versions: finished.results.versions, output: in.lane.output })
}
