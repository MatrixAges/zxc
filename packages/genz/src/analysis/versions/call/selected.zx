import integers from "std:integer"

import type { Call } from "../../unit"

export type Input = { calls: Call[], id: u64 }

export type Output = u64

export default function (in: Input): Output {
    const result = loop({ calls: in.calls, id: in.id, position: 0, found: in.calls.length }, {
        while: current => current.found == current.calls.length && current.position < current.calls.length,
        next: current => {
            if (integers.widen(current.calls[current.position].expression) == current.id) {
                current.found = current.position
            }

            current.position += 1
        }
    })

    return result.found
}
