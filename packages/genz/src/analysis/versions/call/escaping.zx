import contains from "../value/contains"
import select from "../value/select"

import type { Lane } from "../../unit"
import type { Arena } from "../value/model"

export type Input = { arena: Arena, lanes: Lane[], argument: u64 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ arena: in.arena, lanes: in.lanes, argument: in.argument, position: 0, found: false }, {
        while: current => !current.found && current.position < current.lanes.length,
        next: current => {
            const lane = current.lanes[current.position]
            const active = lane.appends.length != 0 || lane.pops.length != 0 || lane.updates.length != 0 || lane.calls.length != 0

            if (!lane.rejected && active) {
                current.found = contains({ arena: current.arena, value: select({ arena: current.arena, value: current.argument, path: lane.input }) })
            }

            current.position += 1
        }
    })

    return result.found
}
