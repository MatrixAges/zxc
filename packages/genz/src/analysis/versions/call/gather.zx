import merge from "../value/merge"

import type { Arena } from "../value/model"

export type Input = { arena: Arena, values: u64[], versions: u64[], base: u64, current: u64 }

export type Output = { arena: Arena, value: u64, valid: bool }

export default function (in: Input): Output {
    const result = loop({ arena: in.arena, values: in.values, versions: in.versions, base: in.base, current: in.current, value: in.values[in.base], valid: true, position: in.base }, {
        while: state => state.position < state.values.length,
        next: state => {
            if (state.versions[state.position] != state.current) {
                state.valid = false
            }

            if (state.position != state.base) {
                const made = merge({ arena: state.arena, left: state.value, right: state.values[state.position], left_version: state.current, right_version: state.current, joined: state.current })

                state.arena = made.arena
                state.value = made.value
            }

            state.position += 1
        }
    })

    return { arena: result.arena, value: result.value, valid: result.valid }
}
