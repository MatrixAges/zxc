import integers from "std:integer"

import frame from "../frame"
import enter from "../machine/enter"
import expressions from "../machine/expressions"
import invalid from "../machine/invalid"
import observe from "../machine/observe"
import push from "../machine/push"
import { Op } from "../model"
import contains from "../value/contains"
import select from "../value/select"
import escaping from "./escaping"

import type { Machine } from "../model"

export type Input = { machine: Machine, id: u64, argument: u64 }

export type Output = Machine

export default function (in: Input): Output {
    if (!contains({ arena: in.machine.arena, value: in.argument })) {
        return push({ machine: in.machine, value: 0 })
    }

    const machine = observe({ machine: in.machine, value: in.argument })
    const table = expressions(machine)
    const payload = integers.widen(table.payloads[in.id])
    const callee = integers.widen(table.call_functions[payload])

    if (!machine.context.valid || callee >= machine.context.limit || table.call_store_count[payload] != 0) {
        return push({ machine: invalid({ machine: machine, valid: false }), value: 0 })
    }

    const unit = machine.units[callee]

    if (unit.external || unit.stores.paths.length != 0 || unit.contracts.kinds.length != 0) {
        return push({ machine: invalid({ machine: machine, valid: false }), value: 0 })
    }

    if (machine.context.enabled) {
        if (callee >= machine.context.summaries) {
            return push({ machine: invalid({ machine: machine, valid: false }), value: 0 })
        }

        if (callee < machine.context.readers && machine.readers[callee]) {
            return push({ machine: machine, value: 0 })
        }

        const escapes = escaping({ arena: machine.arena, lanes: machine.summaries[callee], argument: in.argument })

        if (escapes) {
            return push({ machine: invalid({ machine: machine, valid: false }), value: 0 })
        }
    }

    const root = unit.root
    const child = enter({ machine: machine, unit: callee, argument: in.argument })

    const returned = frame({ op: Op.ChildReturn, id: in.id, a: 0, b: 0 })

    if (root == null) {
        return push({ machine: { ...child, frames: child.frames.push(returned)[0] }, value: 0 })
    }

    return { ...child, frames: child.frames.concat([returned, frame({ op: Op.Block, id: integers.widen(root), a: 0, b: 0 })])[0] }
}
