import contains from "../value/contains"
import select from "../value/select"

import type { Lane } from "../../unit"
import type { Arena } from "../value/model"

export type Input = { arena: Arena, lanes: Lane[], argument: u64 }

export type Output = u64

export default function (in: Input): Output {
    const result = loop({ arena: in.arena, lanes: in.lanes, argument: in.argument, position: 0, found: in.lanes.length }, {
        while: current => current.found == current.lanes.length && current.position < current.lanes.length,
        next: current => {
            const lane = current.lanes[current.position]

            if (!lane.rejected && contains({ arena: current.arena, value: select({ arena: current.arena, value: current.argument, path: lane.input }) })) {
                current.found = current.position
            }

            current.position += 1
        }
    })

    return result.found
}
