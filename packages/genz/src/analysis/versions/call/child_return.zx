import invalid from "../machine/invalid"
import leave from "../machine/leave"
import pop from "../machine/pop"
import push from "../machine/push"
import gather from "./gather"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const returned = pop(in.machine)
    const child = returned.machine
    const base = child.context.result_base
    const results = child.results
    const parent_serial = child.parents.serials[child.parents.serials.length - 1]
    const parent_current = child.parents.currents[child.parents.currents.length - 1]
    const failed = returned.value == 0 || !child.context.valid || child.context.serial != parent_serial || results.values.length == base
    const merged = failed ? { arena: child.arena, value: 0, valid: false } : gather({ arena: child.arena, values: results.values, versions: results.versions, base: base, current: parent_current })
    const restored = leave({ ...child, arena: merged.arena })

    if (failed) {
        return push({ machine: invalid({ machine: restored, valid: false }), value: 0 })
    }

    return push({ machine: invalid({ machine: restored, valid: merged.valid }), value: merged.value })
}
