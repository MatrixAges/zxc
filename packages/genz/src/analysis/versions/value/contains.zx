import { ValueKind } from "./model"

import type { Arena } from "./model"

export type Input = { arena: Arena, value: u64 }

export type Output = bool

export default function (in: Input): Output {
    const stack: u64[] = [in.value]

    const result = loop({ arena: in.arena, stack: stack, found: false }, {
        while: current => !current.found && current.stack.length != 0,
        next: current => {
            const value = current.stack[current.stack.length - 1]
            const kind = current.arena.kinds[value]

            current.stack = current.stack.pop()[0]

            if (kind == ValueKind.Aggregate) {
                current.stack = loop({ arena: current.arena, stack: current.stack, position: current.arena.first[value], end: current.arena.first[value] + current.arena.count[value] }, {
                    while: children => children.position < children.end,
                    next: children => {
                        children.stack = children.stack.push(children.arena.items[children.position])[0]
                        children.position += 1
                    }
                }).stack
            } else if (kind != ValueKind.None) {
                current.found = true
            }
        }
    })

    return result.found
}
