import type { Arena, Made, ValueKind } from "./model"

export type Input = { arena: Arena, kind: ValueKind, number: u64 }

export type Output = Made

export default function (in: Input): Output {
    const arena = in.arena

    return {
        arena: { kinds: arena.kinds.push(in.kind)[0], numbers: arena.numbers.push(in.number)[0], first: arena.first.push(0)[0], count: arena.count.push(0)[0], items: arena.items },
        value: arena.kinds.length
    }
}
