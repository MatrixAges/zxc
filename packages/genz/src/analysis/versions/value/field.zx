import contains from "./contains"
import { ValueKind } from "./model"

import type { Arena } from "./model"

export type Input = { arena: Arena, value: u64, index: u64 }

export type Output = u64

export default function (in: Input): Output {
    if (in.arena.kinds[in.value] == ValueKind.Aggregate && in.index < in.arena.count[in.value]) {
        return in.arena.items[in.arena.first[in.value] + in.index]
    }

    return contains({ arena: in.arena, value: in.value }) ? 1 : 0
}
