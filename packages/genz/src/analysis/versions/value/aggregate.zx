import { ValueKind } from "./model"

import type { Arena, Made } from "./model"

export type Input = { arena: Arena, children: u64[] }

export type Output = Made

export default function (in: Input): Output {
    const arena = in.arena

    return {
        arena: { kinds: arena.kinds.push(ValueKind.Aggregate)[0], numbers: arena.numbers.push(0)[0], first: arena.first.push(arena.items.length)[0], count: arena.count.push(in.children.length)[0], items: arena.items.concat(in.children)[0] },
        value: arena.kinds.length
    }
}
