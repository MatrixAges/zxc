import children from "./children"
import contains from "./contains"
import { ValueKind } from "./model"

import type { Arena, Pair } from "./model"

export type Input = { arena: Arena, left: u64, right: u64 }

export type Output = bool

export default function (in: Input): Output {
    const pairs: Pair[] = [{ left: in.left, right: in.right }]

    const result = loop({ arena: in.arena, pairs: pairs, equal: true }, {
        while: current => current.equal && current.pairs.length != 0,
        next: current => {
            const pair = current.pairs[current.pairs.length - 1]
            const left = current.arena.kinds[pair.left]
            const right = current.arena.kinds[pair.right]

            current.pairs = current.pairs.pop()[0]

            if (contains({ arena: current.arena, value: pair.left }) || contains({ arena: current.arena, value: pair.right })) {
                if (left != right) {
                    current.equal = false
                } else if (left == ValueKind.Version || left == ValueKind.Borrowed) {
                    current.equal = current.arena.numbers[pair.left] == current.arena.numbers[pair.right]
                } else if (left == ValueKind.Aggregate) {
                    const lefts = children({ arena: current.arena, value: pair.left })
                    const rights = children({ arena: current.arena, value: pair.right })

                    if (lefts.length != rights.length) {
                        current.equal = false
                    } else {
                        current.pairs = loop({ pairs: current.pairs, lefts: lefts, rights: rights, remaining: lefts.length }, {
                            while: pending => pending.remaining != 0,
                            next: pending => {
                                pending.remaining -= 1
                                pending.pairs = pending.pairs.push({ left: pending.lefts[pending.remaining], right: pending.rights[pending.remaining] })[0]
                            }
                        }).pairs
                    }
                }
            }
        }
    })

    return result.equal
}
