import pop from "../machine/pop"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const head = pop(in.machine)
    const saved = snapshot(head.machine)

    return { ...saved, frames: saved.frames.push({ ...in.frame, op: Op.BorrowRound, b: head.value, c: saved.context.serial })[0] }
}
