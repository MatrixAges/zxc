import bind from "../machine/bind"
import invalid from "../machine/invalid"
import iteration from "../machine/iteration"
import join from "../machine/join"
import pop from "../machine/pop"
import push from "../machine/push"
import release from "../machine/release"
import saved from "../machine/saved"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const machine = pop(in.machine).machine

    if (!machine.context.valid || machine.context.current != in.frame.d) {
        return push({ machine: release({ machine: invalid({ machine: machine, valid: false }), count: 1 }), value: 0 })
    }

    const parts = iteration({ machine: machine, id: in.frame.id })
    const condition = saved({ machine: machine, depth: 0, symbol: parts.condition_parameter })
    const parameter = saved({ machine: machine, depth: 0, symbol: parts.parameter })
    const bound = bind({ machine: bind({ machine: machine, symbol: parts.condition_parameter, value: condition }), symbol: parts.parameter, value: parameter })
    const joined = join({ machine: bound, depth: 0, left: in.frame.b, right: in.frame.c })

    return push({ machine: release({ machine: joined.machine, count: 1 }), value: joined.value })
}
