import frame from "../frame"
import bind from "../machine/bind"
import invalid from "../machine/invalid"
import iteration from "../machine/iteration"
import pop from "../machine/pop"
import push from "../machine/push"
import release from "../machine/release"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const machine = pop(in.machine).machine

    if (!machine.context.valid || machine.context.current != in.frame.d) {
        return push({ machine: release({ machine: invalid({ machine: machine, valid: false }), count: 1 }), value: 0 })
    }

    const parts = iteration({ machine: machine, id: in.frame.id })
    const bound = bind({ machine: machine, symbol: parts.parameter, value: in.frame.c })

    return { ...bound, frames: bound.frames.concat([{ ...in.frame, op: Op.UpdatingBody }, frame({ op: Op.Expression, id: parts.body, a: 0, b: 0 })])[0] }
}
