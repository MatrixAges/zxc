import frame from "../frame"
import bind from "../machine/bind"
import iteration from "../machine/iteration"
import observe from "../machine/observe"
import pop from "../machine/pop"
import restore from "../machine/restore"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const condition = pop(in.machine)
    const restored = restore({ machine: observe({ machine: condition.machine, value: condition.value }), depth: 0 })
    const parts = iteration({ machine: restored, id: in.frame.id })
    const machine = bind({ machine: restored, symbol: parts.parameter, value: in.frame.b })

    return { ...machine, frames: machine.frames.concat([{ ...in.frame, op: Op.BorrowBody }, frame({ op: Op.Expression, id: parts.body, a: 0, b: 0 })])[0] }
}
