import frame from "../frame"
import bind from "../machine/bind"
import iteration from "../machine/iteration"
import push from "../machine/push"
import release from "../machine/release"
import restore from "../machine/restore"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const restored = restore({ machine: in.machine, depth: 0 })

    if (!in.machine.context.valid) {
        return push({ machine: release({ machine: restored, count: 1 }), value: 0 })
    }

    const parts = iteration({ machine: restored, id: in.frame.id })
    const machine = bind({ machine: restored, symbol: parts.condition_parameter, value: in.frame.b })

    return { ...machine, frames: machine.frames.concat([{ ...in.frame, op: Op.BorrowCondition }, frame({ op: Op.Expression, id: parts.condition, a: 0, b: 0 })])[0] }
}
