import frame from "../frame"
import bind from "../machine/bind"
import iteration from "../machine/iteration"
import pop from "../machine/pop"
import reject from "../machine/reject"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const initial = pop(in.machine)
    const saved = snapshot(reject({ machine: initial.machine, value: initial.value }))
    const parts = iteration({ machine: saved, id: in.frame.id })
    const machine = bind({ machine: saved, symbol: parts.condition_parameter, value: 0 })

    return { ...machine, frames: machine.frames.concat([{ ...in.frame, op: Op.IndependentCondition, c: saved.context.serial }, frame({ op: Op.Expression, id: parts.condition, a: 0, b: 0 })])[0] }
}
