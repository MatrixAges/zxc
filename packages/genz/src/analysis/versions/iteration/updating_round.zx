import frame from "../frame"
import bind from "../machine/bind"
import iteration from "../machine/iteration"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const parts = iteration({ machine: in.machine, id: in.frame.id })
    const machine = bind({ machine: in.machine, symbol: parts.condition_parameter, value: in.frame.c })
    const next = in.frame.a < 2 ? Op.UpdatingCondition : Op.UpdatingFinal

    return { ...machine, frames: machine.frames.concat([{ ...in.frame, op: next, d: machine.context.current }, frame({ op: Op.Expression, id: parts.condition, a: 0, b: 0 })])[0] }
}
