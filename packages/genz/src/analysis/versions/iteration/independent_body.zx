import invalid from "../machine/invalid"
import pop from "../machine/pop"
import push from "../machine/push"
import reject from "../machine/reject"
import release from "../machine/release"
import restore from "../machine/restore"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const body = pop(in.machine)
    const rejected = reject({ machine: body.machine, value: body.value })
    const machine = invalid({ machine: rejected, valid: rejected.context.serial == in.frame.c })

    return push({ machine: release({ machine: restore({ machine: machine, depth: 0 }), count: 1 }), value: 0 })
}
