import invalid from "../machine/invalid"
import pop from "../machine/pop"
import push from "../machine/push"
import release from "../machine/release"
import { Op } from "../model"
import retains from "../value/retains"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const result = pop(in.machine)
    const machine = result.machine

    if (!machine.context.valid || !retains({ arena: machine.arena, value: result.value, paths: machine.paths, first: in.frame.first, count: in.frame.count, current: machine.context.current })) {
        return push({ machine: release({ machine: invalid({ machine: machine, valid: false }), count: 1 }), value: 0 })
    }

    return { ...machine, frames: machine.frames.push({ ...in.frame, op: Op.UpdatingRound, a: in.frame.a + 1, c: result.value })[0] }
}
