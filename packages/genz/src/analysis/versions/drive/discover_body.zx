import frame from "../frame"
import bind from "../machine/bind"
import iteration from "../machine/iteration"
import pop from "../machine/pop"
import push from "../machine/push"
import { Op } from "../model"
import retains from "../value/retains"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const result = pop(in.machine)
    const machine = result.machine

    if (!machine.context.valid || (machine.updates.length == 0 && machine.inferred.expressions.length == 0) || !retains({ arena: machine.arena, value: result.value, paths: machine.paths, first: in.frame.first, count: in.frame.count, current: machine.context.current })) {
        return push({ machine: machine, value: 0 })
    }

    const parts = iteration({ machine: machine, id: in.frame.id })
    const bound = bind({ machine: machine, symbol: parts.condition_parameter, value: result.value })

    return { ...bound, frames: bound.frames.concat([{ ...in.frame, op: Op.DiscoverFinal, d: bound.context.current }, frame({ op: Op.Expression, id: parts.condition, a: 0, b: 0 })])[0] }
}
