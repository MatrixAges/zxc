import type { Table } from "core/type_table/model"
import type { Call, Iteration, Lanes, Unit } from "../unit"
import type { Arena } from "./value/model"

export enum Op { Expression, Discard, Field, Replace, IndexTarget, IndexDone, UpdateTarget, UpdateIndex, UpdateValue, ScopeBind, ScopeEnd, ObjectCache, ObjectField, TupleItem, ConditionalCondition, ConditionalYes, ConditionalNo, MatchSubject, MatchCondition, MatchArm, MatchJoin, CallArgument, ChildReturn, Reject, OperationTarget, OperationArgument, OperationFinish, Observe, BinaryLeft, BinaryRight, UpdatingInitial, UpdatingRound, UpdatingCondition, UpdatingBody, UpdatingFinal, BorrowInitial, BorrowRound, BorrowCondition, BorrowBody, IndependentInitial, IndependentCondition, IndependentBody, CollectionTarget, CollectionIndex, CollectionValue, CollectionArgument, CollectionFinish, Block, Bind, Destructure, StatementResult, BranchCondition, BranchYes, BranchNo, SwitchSubject, SwitchCase, SwitchCaseDone, DiscoverCondition, DiscoverBody, DiscoverFinal }

export type Frame = { op: Op, id: u64, a: u64, b: u64, c: u64, d: u64, first: u64, count: u64 }

export type Context = { unit: u64, limit: u64, current: u64, serial: u64, valid: bool, borrowing: bool, enabled: bool, summaries: u64, readers: u64, discover: bool, selecting: bool, looping: bool, symbol_base: u64, cached_base: u64, result_base: u64 }

export type Contexts = { units: u64[], limits: u64[], currents: u64[], serials: u64[], valid: bool[], borrowing: bool[], enabled: bool[], summaries: u64[], readers: u64[], discover: bool[], selecting: bool[], looping: bool[], symbol_bases: u64[], cached_bases: u64[], result_bases: u64[] }

export type Snapshots = { firsts: u64[], currents: u64[] }

export type Results = { values: u64[], versions: u64[] }

export type Inferred = { expressions: u32[], lanes: u64[] }

export type Machine = {
    types: Table
    units: Unit[]
    summaries: Lanes[]
    readers: bool[]
    selected: Call[]
    loops: Iteration[]
    arena: Arena
    context: Context
    parents: Contexts
    symbols: u64[]
    cached: u64[]
    saved: u64[]
    snapshots: Snapshots
    results: Results
    updates: u32[]
    inferred: Inferred
    frames: Frame[]
    paths: u32[]
    stack: u64[]
}

export type Step = { machine: Machine, frame: Frame }
