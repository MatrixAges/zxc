import integers from "std:integer"
import { CollectionKind } from "core/expression_table/kinds"

import frame from "../frame"
import expressions from "../machine/expressions"
import invalid from "../machine/invalid"
import observe from "../machine/observe"
import pop from "../machine/pop"
import schedule from "../machine/schedule"
import { Op } from "../model"
import contains from "../value/contains"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const value = pop(in.machine)
    const observed = observe({ machine: value.machine, value: value.value })
    const table = expressions(observed)
    const payload = integers.widen(table.payloads[in.frame.id])
    const aliased = contains({ arena: observed.arena, value: value.value })
    const machine = invalid({ machine: observed, valid: !(aliased && table.collection_kinds[payload] == CollectionKind.Push) })
    const copied = aliased ? 1 : in.frame.a
    const next = in.frame.b + 1

    if (next < integers.widen(table.collection_count[payload])) {
        return schedule({ machine: machine, next: frame({ op: Op.CollectionArgument, id: in.frame.id, a: copied, b: next }), id: table.collection_arguments[integers.widen(table.collection_first[payload]) + next] })
    }

    return { ...machine, frames: machine.frames.push(frame({ op: Op.CollectionFinish, id: in.frame.id, a: copied, b: 0 }))[0] }
}
