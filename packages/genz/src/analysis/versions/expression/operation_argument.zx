import integers from "std:integer"

import frame from "../frame"
import expressions from "../machine/expressions"
import pop from "../machine/pop"
import reject from "../machine/reject"
import schedule from "../machine/schedule"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const value = pop(in.machine)
    const machine = reject({ machine: value.machine, value: value.value })
    const table = expressions(machine)
    const payload = integers.widen(table.payloads[in.frame.id])
    const next = in.frame.b + 1

    if (next < integers.widen(table.collection_count[payload])) {
        return schedule({ machine: machine, next: frame({ op: Op.OperationArgument, id: in.frame.id, a: in.frame.a, b: next }), id: table.collection_arguments[integers.widen(table.collection_first[payload]) + next] })
    }

    return { ...machine, frames: machine.frames.push(frame({ op: Op.OperationFinish, id: in.frame.id, a: 0, b: 0 }))[0] }
}
