import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import frame from "../frame"
import expressions from "../machine/expressions"
import schedule from "../machine/schedule"
import { Op } from "../model"
import contains from "../value/contains"
import scheduleArguments from "./operation_target"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const table = expressions(in.machine)
    const payload = integers.widen(table.payloads[in.frame.id])
    const copied = contains({ arena: in.machine.arena, value: in.machine.stack[in.machine.stack.length - 1] }) ? 1 : 0

    if (table.kinds[in.frame.id] == ExpressionKind.ListUpdate) {
        return schedule({ machine: in.machine, next: frame({ op: Op.CollectionIndex, id: in.frame.id, a: copied, b: 0 }), id: table.update_indices[payload] })
    }

    return scheduleArguments({ machine: in.machine, frame: { ...in.frame, a: copied } })
}
