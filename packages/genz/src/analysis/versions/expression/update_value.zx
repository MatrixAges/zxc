import advance from "../machine/advance"
import pop from "../machine/pop"
import push from "../machine/push"
import reject from "../machine/reject"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const value = pop(in.machine)
    const target = pop(reject({ machine: value.machine, value: value.value }))
    const advanced = advance({ machine: target.machine, id: in.frame.id, target: target.value })

    return push({ machine: advanced.machine, value: advanced.value })
}
