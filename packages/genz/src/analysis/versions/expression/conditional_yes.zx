import integers from "std:integer"

import frame from "../frame"
import expressions from "../machine/expressions"
import restore from "../machine/restore"
import schedule from "../machine/schedule"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const machine = restore({ machine: snapshot(in.machine), depth: 1 })
    const table = expressions(machine)

    return schedule({ machine: machine, next: frame({ op: Op.ConditionalNo, id: in.frame.id, a: 0, b: 0 }), id: table.conditional_no[integers.widen(table.payloads[in.frame.id])] })
}
