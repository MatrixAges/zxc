import integers from "std:integer"

import frame from "../frame"
import expressions from "../machine/expressions"
import schedule from "../machine/schedule"
import { Op } from "../model"
import arms from "./match_arms"
import observed from "./observed"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const subject = in.frame.a == 1 ? in.machine : observed(in.machine)
    const table = expressions(subject)
    const payload = integers.widen(table.payloads[in.frame.id])

    if (table.match_count[payload] == 0) {
        return arms({ machine: subject, id: in.frame.id, version: subject.context.current })
    }

    return schedule({ machine: subject, next: frame({ op: Op.MatchCondition, id: in.frame.id, a: 0, b: subject.context.current }), id: table.match_conditions[integers.widen(table.match_first[payload])] })
}
