import integers from "std:integer"
import { CollectionKind, ExpressionKind } from "core/expression_table/kinds"

import detached from "../../types/detached"
import expressions from "../machine/expressions"
import invalid from "../machine/invalid"
import observe from "../machine/observe"
import pop from "../machine/pop"
import push from "../machine/push"
import aggregate from "../value/aggregate"
import make from "../value/make"
import { ValueKind } from "../value/model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const target = pop(in.machine)
    const table = expressions(target.machine)
    const payload = integers.widen(table.payloads[in.frame.id])
    const update = table.kinds[in.frame.id] == ExpressionKind.ListUpdate
    const target_id = integers.widen(update ? table.update_targets[payload] : table.collection_targets[payload])
    const list = integers.widen(table.types[target_id])
    const child = target.machine.types.first[list]
    const observed = observe({ machine: target.machine, value: target.value })
    const machine = invalid({ machine: observed, valid: !(in.frame.a == 1 && !detached({ types: observed.types, id: child })) })

    if (!machine.context.valid || update) {
        return push({ machine: machine, value: 0 })
    }

    const kind = machine.arena.kinds[target.value]

    const borrowed = match kind {
        ValueKind.None => { arena: machine.arena, value: 0 },
        ValueKind.Version => make({ arena: machine.arena, kind: ValueKind.Borrowed, number: machine.arena.numbers[target.value] }),
        ValueKind.Borrowed => make({ arena: machine.arena, kind: ValueKind.Borrowed, number: machine.arena.numbers[target.value] }),
        _ => { arena: machine.arena, value: 1 },
    }

    const operation = table.collection_kinds[payload]

    const children = match operation {
        CollectionKind.Pop => [borrowed.value, 0],
        CollectionKind.Splice => [0, borrowed.value],
        _ => [0, 0],
    }

    const made = aggregate({ arena: borrowed.arena, children: children })

    return push({ machine: { ...machine, arena: made.arena }, value: made.value })
}
