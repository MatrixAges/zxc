import integers from "std:integer"

import frame from "../frame"
import expressions from "../machine/expressions"
import observe from "../machine/observe"
import schedule from "../machine/schedule"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const machine = observe({ machine: in.machine, value: in.machine.stack[in.machine.stack.length - 1] })
    const table = expressions(machine)

    return schedule({ machine: machine, next: frame({ op: Op.BinaryRight, id: in.frame.id, a: 0, b: machine.context.current }), id: table.binary_right[integers.widen(table.payloads[in.frame.id])] })
}
