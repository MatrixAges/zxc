import integers from "std:integer"

import expressions from "../machine/expressions"
import push from "../machine/push"
import restoreCached from "../machine/restore_cached"
import take from "../machine/take"
import aggregate from "../value/aggregate"

import type { Machine } from "../model"

export type Input = { machine: Machine, id: u64 }

export type Output = Machine

export default function (in: Input): Output {
    const table = expressions(in.machine)
    const payload = integers.widen(table.payloads[in.id])
    const first = integers.widen(table.object_first[payload])
    const count = integers.widen(table.object_count[payload])
    const taken = take({ machine: in.machine, count: count })

    const fields = loop({ table: table, first: first, values: taken.values, children: taken.values.map(value => 0), position: 0 }, {
        while: current => current.position < current.values.length,
        next: current => {
            current.children[integers.widen(current.table.object_field_indices[current.first + current.position])] = current.values[current.position]
            current.position += 1
        }
    }).children

    const machine = taken.machine
    const made = aggregate({ arena: machine.arena, children: fields })

    return push({ machine: restoreCached({ ...machine, arena: made.arena }), value: made.value })
}
