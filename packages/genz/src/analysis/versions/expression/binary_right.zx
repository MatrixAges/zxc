import integers from "std:integer"
import { BinaryOperator } from "core/expression_table/kinds"

import expressions from "../machine/expressions"
import invalid from "../machine/invalid"
import observe from "../machine/observe"
import pop from "../machine/pop"
import push from "../machine/push"
import reject from "../machine/reject"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const right = pop(in.machine)
    const left = pop(right.machine)
    const observed = observe({ machine: observe({ machine: left.machine, value: left.value }), value: right.value })
    const table = expressions(observed)
    const operator = table.binary_operators[integers.widen(table.payloads[in.frame.id])]
    const coalesce = operator == BinaryOperator.Coalesce
    const checked = coalesce ? reject({ machine: reject({ machine: observed, value: left.value }), value: right.value }) : observed
    const ordered = operator == BinaryOperator.LogicalAnd || operator == BinaryOperator.LogicalOr || coalesce

    return push({ machine: invalid({ machine: checked, valid: !(ordered && checked.context.current != in.frame.b) }), value: 0 })
}
