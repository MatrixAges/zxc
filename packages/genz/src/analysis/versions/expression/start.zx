import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import frame from "../frame"
import cached from "../machine/cached"
import chosen from "../machine/chosen"
import invalid from "../machine/invalid"
import push from "../machine/push"
import restoreCached from "../machine/restore_cached"
import snapshot from "../machine/snapshot"
import store from "../machine/store"
import symbol from "../machine/symbol"
import { Op } from "../model"
import aggregate from "../value/aggregate"
import sequence from "./sequence"

import type { Step, Machine } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const machine = in.machine
    const id = in.frame.id
    const empty: u64[] = []

    if (!machine.context.valid) {
        return push({ machine: machine, value: 0 })
    }

    const cached_value = cached({ machine: machine, id: id })

    if (cached_value != 0) {
        return push({ machine: machine, value: cached_value - 1 })
    }

    const expressions = machine.units[machine.context.unit].expressions
    const kind = expressions.kinds[id]
    const payload = integers.widen(expressions.payloads[id])
    const rejected = kind == ExpressionKind.Capture || kind == ExpressionKind.Task || kind == ExpressionKind.AwaitTask || kind == ExpressionKind.CancelTask || kind == ExpressionKind.Parallel || kind == ExpressionKind.Transform || kind == ExpressionKind.StoreGet

    if (rejected) {
        return push({ machine: invalid({ machine: machine, valid: false }), value: 0 })
    }

    if (kind == ExpressionKind.Reference) {
        return push({ machine: machine, value: symbol({ machine: machine, symbol: integers.widen(expressions.references[payload]) }) })
    }

    const evaluate = Op.Expression

    if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
        return { ...machine, frames: machine.frames.concat([frame({ op: Op.Field, id: id, a: integers.widen(expressions.projection_indices[payload]), b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.projection_targets[payload]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Length) {
        return { ...machine, frames: machine.frames.concat([frame({ op: Op.Replace, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.lengths[payload]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Index) {
        return { ...machine, frames: machine.frames.concat([frame({ op: Op.IndexTarget, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.index_targets[payload]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.ListUpdate || kind == ExpressionKind.ListOperation) {
        const target = kind == ExpressionKind.ListUpdate ? expressions.update_targets[payload] : expressions.collection_targets[payload]
        const plain = kind == ExpressionKind.ListUpdate ? Op.UpdateTarget : Op.OperationTarget
        const next = machine.context.borrowing ? Op.CollectionTarget : plain

        return { ...machine, frames: machine.frames.concat([frame({ op: next, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(target), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Scope) {
        const first = integers.widen(expressions.scope_first[payload])
        const count = integers.widen(expressions.scope_count[payload])

        const saved = loop({ machine: machine, expressions: expressions, position: first, end: first + count }, {
            while: current => current.position < current.end,
            next: current => {
                const bound = current.expressions.scope_symbols[current.position]

                current.machine = push({ machine: current.machine, value: bound == null ? 0 : symbol({ machine: current.machine, symbol: integers.widen(bound) }) })
                current.position += 1
            }
        }).machine

        const tail = frame({ op: Op.ScopeEnd, id: id, a: 0, b: 0 })

        if (count == 0) {
            return { ...saved, frames: saved.frames.concat([tail, frame({ op: evaluate, id: integers.widen(expressions.scope_results[payload]), a: 0, b: 0 })])[0] }
        }

        return { ...saved, frames: saved.frames.concat([tail, frame({ op: Op.ScopeBind, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.scope_values[first]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Object) {
        const evaluations = integers.widen(expressions.object_evaluation_count[payload])
        const fields = integers.widen(expressions.object_count[payload])
        const saved = snapshot(machine)

        if (evaluations != 0) {
            return { ...saved, frames: saved.frames.concat([frame({ op: Op.ObjectCache, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.object_evaluation_values[integers.widen(expressions.object_evaluation_first[payload])]), a: 0, b: 0 })])[0] }
        }

        if (fields != 0) {
            return { ...saved, frames: saved.frames.concat([frame({ op: Op.ObjectField, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.object_field_values[integers.widen(expressions.object_first[payload])]), a: 0, b: 0 })])[0] }
        }

        const made = aggregate({ arena: saved.arena, children: empty })

        return push({ machine: restoreCached({ ...saved, arena: made.arena }), value: made.value })
    }

    if (kind == ExpressionKind.Tuple) {
        const count = integers.widen(expressions.sequence_count[payload])

        if (count == 0) {
            const made = aggregate({ arena: machine.arena, children: empty })

            return push({ machine: { ...machine, arena: made.arena }, value: made.value })
        }

        return { ...machine, frames: machine.frames.concat([frame({ op: Op.TupleItem, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.sequence_items[integers.widen(expressions.sequence_first[payload])]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Conditional) {
        return { ...machine, frames: machine.frames.concat([frame({ op: Op.ConditionalCondition, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.conditional_conditions[payload]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Match) {
        const subject = expressions.match_subjects[payload]

        if (subject != null) {
            return { ...machine, frames: machine.frames.concat([frame({ op: Op.MatchSubject, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(subject), a: 0, b: 0 })])[0] }
        }

        return { ...machine, frames: machine.frames.push(frame({ op: Op.MatchSubject, id: id, a: 1, b: 0 }))[0] }
    }

    if (kind == ExpressionKind.Call) {
        return { ...machine, frames: machine.frames.concat([frame({ op: Op.CallArgument, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.call_arguments[payload]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Some || kind == ExpressionKind.OptionalValue) {
        const child = kind == ExpressionKind.Some ? expressions.some[payload] : expressions.optional_values[payload]

        return { ...machine, frames: machine.frames.concat([frame({ op: Op.Reject, id: id, a: 1, b: 0 }), frame({ op: evaluate, id: integers.widen(child), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.List || kind == ExpressionKind.Template) {
        return sequence({ machine: machine, expressions: expressions, payload: payload })
    }

    if (kind == ExpressionKind.Iteration) {
        const selected = machine.context.looping ? chosen({ loops: machine.loops, id: id }) : machine.loops.length
        const initial = integers.widen(expressions.iteration_initials[payload])

        if (selected != machine.loops.length) {
            const path = machine.loops[selected].path
            const first = machine.paths.length

            return { ...machine, paths: store({ paths: machine.paths, path: path }), frames: machine.frames.concat([{ ...frame({ op: Op.UpdatingInitial, id: id, a: 0, b: 0 }), first: first, count: path.length }, frame({ op: evaluate, id: initial, a: 0, b: 0 })])[0] }
        }

        return { ...machine, frames: machine.frames.concat([frame({ op: machine.context.borrowing ? Op.BorrowInitial : Op.IndependentInitial, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: initial, a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Unary) {
        return { ...machine, frames: machine.frames.concat([frame({ op: Op.Observe, id: id, a: 1, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.unary_operands[payload]), a: 0, b: 0 })])[0] }
    }

    if (kind == ExpressionKind.Binary) {
        return { ...machine, frames: machine.frames.concat([frame({ op: Op.BinaryLeft, id: id, a: 0, b: 0 }), frame({ op: evaluate, id: integers.widen(expressions.binary_left[payload]), a: 0, b: 0 })])[0] }
    }

    return push({ machine: machine, value: 0 })
}
