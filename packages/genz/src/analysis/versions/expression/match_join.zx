import frame from "../frame"
import join from "../machine/join"
import pop from "../machine/pop"
import push from "../machine/push"
import release from "../machine/release"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const next = pop(in.machine)
    const result = pop(next.machine)
    const joined = join({ machine: result.machine, depth: 0, left: result.value, right: next.value })
    const machine = push({ machine: release({ machine: joined.machine, count: 1 }), value: joined.value })

    return { ...machine, frames: machine.frames.push(frame({ op: Op.MatchArm, id: in.frame.id, a: in.frame.a + 1, b: 0 }))[0] }
}
