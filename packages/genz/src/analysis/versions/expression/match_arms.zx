import integers from "std:integer"

import frame from "../frame"
import expressions from "../machine/expressions"
import invalid from "../machine/invalid"
import schedule from "../machine/schedule"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine } from "../model"

export type Input = { machine: Machine, id: u64, version: u64 }

export type Output = Machine

export default function (in: Input): Output {
    const machine = snapshot(invalid({ machine: in.machine, valid: in.machine.context.current == in.version }))
    const table = expressions(machine)

    return schedule({ machine: machine, next: frame({ op: Op.MatchArm, id: in.id, a: 0, b: 0 }), id: table.match_fallbacks[integers.widen(table.payloads[in.id])] })
}
