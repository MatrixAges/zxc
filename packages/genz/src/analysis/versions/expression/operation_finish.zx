import integers from "std:integer"
import { CollectionKind } from "core/expression_table/kinds"

import prefix from "../../calls/prefix"
import advance from "../machine/advance"
import expressions from "../machine/expressions"
import invalid from "../machine/invalid"
import observe from "../machine/observe"
import pop from "../machine/pop"
import push from "../machine/push"
import aggregate from "../value/aggregate"
import make from "../value/make"
import { ValueKind } from "../value/model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const target = pop(in.machine)
    const machine = target.machine
    const kind = machine.arena.kinds[target.value]

    if (kind == ValueKind.None) {
        return push({ machine: machine, value: 0 })
    }

    const table = expressions(machine)
    const operation = table.collection_kinds[integers.widen(table.payloads[in.frame.id])]

    if (operation == CollectionKind.Splice) {
        if (kind == ValueKind.Version && prefix({ expressions: table, id: in.frame.id })) {
            const advanced = advance({ machine: machine, id: in.frame.id, target: target.value })
            const made = aggregate({ arena: advanced.machine.arena, children: [0, advanced.value] })

            return push({ machine: { ...advanced.machine, arena: made.arena }, value: made.value })
        }

        const observed = observe({ machine: machine, value: target.value })
        const readable = kind == ValueKind.Version || kind == ValueKind.Borrowed
        const borrowed = readable ? make({ arena: observed.arena, kind: ValueKind.Borrowed, number: observed.arena.numbers[target.value] }) : { arena: observed.arena, value: 1 }
        const made = aggregate({ arena: borrowed.arena, children: [0, borrowed.value] })

        return push({ machine: { ...observed, arena: made.arena }, value: made.value })
    }

    if (operation != CollectionKind.Push && operation != CollectionKind.Concat && operation != CollectionKind.Pop) {
        return push({ machine: invalid({ machine: machine, valid: false }), value: 0 })
    }

    const advanced = advance({ machine: machine, id: in.frame.id, target: target.value })
    const made = aggregate({ arena: advanced.machine.arena, children: [advanced.value, 0] })

    return push({ machine: { ...advanced.machine, arena: made.arena }, value: made.value })
}
