import integers from "std:integer"

import frame from "../frame"
import expressions from "../machine/expressions"
import push from "../machine/push"
import schedule from "../machine/schedule"
import take from "../machine/take"
import { Op } from "../model"
import aggregate from "../value/aggregate"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const table = expressions(in.machine)
    const payload = integers.widen(table.payloads[in.frame.id])
    const count = integers.widen(table.sequence_count[payload])
    const next = in.frame.a + 1

    if (next < count) {
        return schedule({ machine: in.machine, next: frame({ op: Op.TupleItem, id: in.frame.id, a: next, b: 0 }), id: table.sequence_items[integers.widen(table.sequence_first[payload]) + next] })
    }

    const taken = take({ machine: in.machine, count: count })
    const made = aggregate({ arena: taken.machine.arena, children: taken.values })

    return push({ machine: { ...taken.machine, arena: made.arena }, value: made.value })
}
