import integers from "std:integer"

import frame from "../frame"
import expressions from "../machine/expressions"
import observe from "../machine/observe"
import pop from "../machine/pop"
import schedule from "../machine/schedule"
import { Op } from "../model"
import arms from "./match_arms"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const condition = pop(in.machine)
    const machine = observe({ machine: condition.machine, value: condition.value })
    const table = expressions(machine)
    const payload = integers.widen(table.payloads[in.frame.id])
    const next = in.frame.a + 1

    if (next < integers.widen(table.match_count[payload])) {
        return schedule({ machine: machine, next: frame({ op: Op.MatchCondition, id: in.frame.id, a: next, b: in.frame.b }), id: table.match_conditions[integers.widen(table.match_first[payload]) + next] })
    }

    return arms({ machine: machine, id: in.frame.id, version: in.frame.b })
}
