import integers from "std:integer"

import frame from "../frame"
import bind from "../machine/bind"
import expressions from "../machine/expressions"
import pop from "../machine/pop"
import schedule from "../machine/schedule"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const value = pop(in.machine)
    const table = expressions(value.machine)
    const payload = integers.widen(table.payloads[in.frame.id])
    const first = integers.widen(table.scope_first[payload])
    const count = integers.widen(table.scope_count[payload])
    const symbol = table.scope_symbols[first + in.frame.a]
    const machine = symbol == null ? value.machine : bind({ machine: value.machine, symbol: integers.widen(symbol), value: value.value })
    const next = in.frame.a + 1

    if (next < count) {
        return schedule({ machine: machine, next: frame({ op: Op.ScopeBind, id: in.frame.id, a: next, b: 0 }), id: table.scope_values[first + next] })
    }

    return { ...machine, frames: machine.frames.push(frame({ op: Op.Expression, id: integers.widen(table.scope_results[payload]), a: 0, b: 0 }))[0] }
}
