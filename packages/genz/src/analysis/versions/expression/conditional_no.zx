import join from "../machine/join"
import pop from "../machine/pop"
import push from "../machine/push"
import release from "../machine/release"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const no = pop(in.machine)
    const yes = pop(no.machine)
    const joined = join({ machine: yes.machine, depth: 0, left: yes.value, right: no.value })

    return push({ machine: release({ machine: joined.machine, count: 2 }), value: joined.value })
}
