import frame from "../frame"
import join from "../machine/join"
import pop from "../machine/pop"
import push from "../machine/push"
import release from "../machine/release"
import restore from "../machine/restore"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const returned = pop(in.machine)
    const yes = in.frame.c == 1
    const no = returned.value == 1
    const next = frame({ op: Op.Block, id: in.frame.id, a: in.frame.a + 1, b: 0 })

    if (yes && no) {
        return push({ machine: release({ machine: returned.machine, count: 2 }), value: 1 })
    }

    if (yes) {
        const machine = release({ machine: returned.machine, count: 2 })

        return { ...machine, frames: machine.frames.push(next)[0] }
    }

    const merged = no ? restore({ machine: returned.machine, depth: 0 }) : join({ machine: returned.machine, depth: 0, left: 0, right: 0 }).machine
    const machine = release({ machine: merged, count: 2 })

    return { ...machine, frames: machine.frames.push(next)[0] }
}
