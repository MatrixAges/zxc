import pop from "../machine/pop"
import push from "../machine/push"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const value = pop(in.machine)
    const machine = value.machine

    return push({ machine: { ...machine, results: { values: machine.results.values.push(value.value)[0], versions: machine.results.versions.push(machine.context.current)[0] } }, value: 1 })
}
