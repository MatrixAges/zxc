import join from "../machine/join"
import pop from "../machine/pop"
import release from "../machine/release"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const returned = pop(in.machine)
    const next = { ...in.frame, op: Op.SwitchCase, d: in.frame.d + 1 }

    if (returned.value == 1) {
        return { ...returned.machine, frames: returned.machine.frames.push(next)[0] }
    }

    const machine = in.frame.c == 1 ? release({ machine: join({ machine: returned.machine, depth: 0, left: 0, right: 0 }).machine, count: 1 }) : returned.machine
    const saved = snapshot(machine)

    return { ...saved, frames: saved.frames.push({ ...next, c: 1 })[0] }
}
