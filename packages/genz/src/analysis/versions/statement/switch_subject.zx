import observe from "../machine/observe"
import pop from "../machine/pop"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const subject = pop(in.machine)
    const before = snapshot(observe({ machine: subject.machine, value: subject.value }))
    const exhaustive = before.units[before.context.unit].control.selection_exhaustive[in.frame.b]
    const machine = exhaustive ? before : snapshot(before)

    return { ...machine, frames: machine.frames.push({ ...in.frame, op: Op.SwitchCase, c: exhaustive ? 0 : 1, d: 0 })[0] }
}
