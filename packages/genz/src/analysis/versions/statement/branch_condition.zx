import integers from "std:integer"

import frame from "../frame"
import observe from "../machine/observe"
import pop from "../machine/pop"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const condition = pop(in.machine)
    const machine = snapshot(observe({ machine: condition.machine, value: condition.value }))
    const control = machine.units[machine.context.unit].control

    return { ...machine, frames: machine.frames.concat([{ ...in.frame, op: Op.BranchYes }, frame({ op: Op.Block, id: integers.widen(control.branch_yes[in.frame.b]), a: 0, b: 0 })])[0] }
}
