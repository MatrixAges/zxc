import integers from "std:integer"

import frame from "../frame"
import push from "../machine/push"
import release from "../machine/release"
import restore from "../machine/restore"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const control = in.machine.units[in.machine.context.unit].control
    const combined = in.frame.c == 1

    if (in.frame.d == integers.widen(control.selection_count[in.frame.b])) {
        if (!combined) {
            return push({ machine: release({ machine: in.machine, count: 1 }), value: 1 })
        }

        const machine = release({ machine: restore({ machine: in.machine, depth: 0 }), count: 2 })

        return { ...machine, frames: machine.frames.push(frame({ op: Op.Block, id: in.frame.id, a: in.frame.a + 1, b: 0 }))[0] }
    }

    const machine = restore({ machine: in.machine, depth: combined ? 1 : 0 })
    const body = control.case_bodies[integers.widen(control.selection_first[in.frame.b]) + in.frame.d]

    return { ...machine, frames: machine.frames.concat([{ ...in.frame, op: Op.SwitchCaseDone }, frame({ op: Op.Block, id: integers.widen(body), a: 0, b: 0 })])[0] }
}
