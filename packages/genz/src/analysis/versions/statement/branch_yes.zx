import integers from "std:integer"

import frame from "../frame"
import pop from "../machine/pop"
import restore from "../machine/restore"
import snapshot from "../machine/snapshot"
import { Op } from "../model"

import type { Machine, Step } from "../model"

export type Input = Step

export type Output = Machine

export default function (in: Input): Output {
    const returned = pop(in.machine)
    const machine = restore({ machine: snapshot(returned.machine), depth: 1 })
    const control = machine.units[machine.context.unit].control

    return { ...machine, frames: machine.frames.concat([{ ...in.frame, op: Op.BranchNo, c: returned.value }, frame({ op: Op.Block, id: integers.widen(control.branch_no[in.frame.b]), a: 0, b: 0 })])[0] }
}
