import observe from "../value/observe"

import type { Machine } from "../model"

export type Input = { machine: Machine, value: u64 }

export type Output = Machine

export default function (in: Input): Output {
    const valid = in.machine.context.valid && observe({ arena: in.machine.arena, value: in.value, current: in.machine.context.current })

    return { ...in.machine, context: { ...in.machine.context, valid: valid } }
}
