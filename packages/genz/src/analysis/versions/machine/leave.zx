import forget from "./forget"
import parent from "./parent"
import shrink from "./shrink"

import type { Machine } from "../model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    const child = in.context

    return {
        ...in,
        context: parent(in.parents),
        parents: forget(in.parents),
        symbols: shrink({ values: in.symbols, length: child.symbol_base }),
        cached: shrink({ values: in.cached, length: child.cached_base }),
        results: { values: shrink({ values: in.results.values, length: child.result_base }), versions: shrink({ values: in.results.versions, length: child.result_base }) }
    }
}
