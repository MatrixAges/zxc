import integers from "std:integer"

import frame from "../frame"
import { Op } from "../model"

import type { Frame, Machine } from "../model"

export type Input = { machine: Machine, next: Frame, id: u32 }

export type Output = Machine

export default function (in: Input): Output {
    return { ...in.machine, frames: in.machine.frames.concat([in.next, frame({ op: Op.Expression, id: integers.widen(in.id), a: 0, b: 0 })])[0] }
}
