import save from "./save"
import zeros from "./zeros"

import type { Machine } from "../model"

export type Input = { machine: Machine, unit: u64, argument: u64 }

export type Output = Machine

export default function (in: Input): Output {
    const machine = in.machine
    const context = machine.context
    const unit = machine.units[in.unit]
    const symbol_base = machine.symbols.length
    const symbols = zeros({ values: machine.symbols, count: unit.symbols.names.length })
    const readers = context.readers < in.unit ? context.readers : in.unit

    return {
        ...machine,
        parents: save({ parents: machine.parents, context: context }),
        symbols: symbols.with(symbol_base, in.argument),
        cached: zeros({ values: machine.cached, count: unit.expressions.kinds.length }),
        context: { ...context, unit: in.unit, limit: in.unit, valid: true, borrowing: true, summaries: in.unit, readers: readers, discover: false, selecting: false, looping: false, symbol_base: symbol_base, cached_base: machine.cached.length, result_base: machine.results.values.length }
    }
}
