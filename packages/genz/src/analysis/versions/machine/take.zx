import collect from "./collect"

import type { Machine } from "../model"

export type Input = { machine: Machine, count: u64 }

export type Output = { machine: Machine, values: u64[] }

export default function (in: Input): Output {
    const start = in.machine.stack.length - in.count
    const values = collect({ stack: in.machine.stack, start: start })

    const truncated = loop({ stack: in.machine.stack, start: start }, {
        while: current => current.stack.length > current.start,
        next: current => { current.stack = current.stack.pop()[0] }
    }).stack

    return { machine: { ...in.machine, stack: truncated }, values: values }
}
