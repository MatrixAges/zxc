import type { Context, Contexts } from "../model"

export type Input = { parents: Contexts, context: Context }

export type Output = Contexts

export default function (in: Input): Output {
    const parents = in.parents
    const context = in.context

    return {
        units: parents.units.push(context.unit)[0],
        limits: parents.limits.push(context.limit)[0],
        currents: parents.currents.push(context.current)[0],
        serials: parents.serials.push(context.serial)[0],
        valid: parents.valid.push(context.valid)[0],
        borrowing: parents.borrowing.push(context.borrowing)[0],
        enabled: parents.enabled.push(context.enabled)[0],
        summaries: parents.summaries.push(context.summaries)[0],
        readers: parents.readers.push(context.readers)[0],
        discover: parents.discover.push(context.discover)[0],
        selecting: parents.selecting.push(context.selecting)[0],
        looping: parents.looping.push(context.looping)[0],
        symbol_bases: parents.symbol_bases.push(context.symbol_base)[0],
        cached_bases: parents.cached_bases.push(context.cached_base)[0],
        result_bases: parents.result_bases.push(context.result_base)[0]
    }
}
