export type Input = { values: u64[], count: u64 }

export type Output = u64[]

export default function (in: Input): Output {
    const result = loop({ values: in.values, remaining: in.count }, {
        while: current => current.remaining != 0,
        next: current => {
            current.values = current.values.push(0)[0]
            current.remaining -= 1
        }
    })

    return result.values
}
