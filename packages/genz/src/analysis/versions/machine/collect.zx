export type Input = { stack: u64[], start: u64 }

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    const result = loop({ stack: in.stack, position: in.start, values: empty }, {
        while: current => current.position < current.stack.length,
        next: current => {
            current.values = current.values.push(current.stack[current.position])[0]
            current.position += 1
        }
    })

    return result.values
}
