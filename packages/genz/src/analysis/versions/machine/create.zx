import initial from "../value/initial"

import type { Table } from "core/type_table/model"
import type { Call, Iteration, Lanes, Unit } from "../../unit"
import type { Frame, Machine } from "../model"

export type Settings = { enabled: bool, summaries: u64, readers: u64, discover: bool, selecting: bool, looping: bool }

export type Input = { types: Table, units: Unit[], summaries: Lanes[], readers: bool[], selected: Call[], loops: Iteration[], unit: u64, limit: u64, settings: Settings }

export type Output = Machine

export default function (in: Input): Output {
    const unit = in.units[in.unit]
    const numbers: u64[] = []
    const ids: u32[] = []
    const flags: bool[] = []
    const frames: Frame[] = []
    const settings = in.settings

    return {
        types: in.types,
        units: in.units,
        summaries: in.summaries,
        readers: in.readers,
        selected: in.selected,
        loops: in.loops,
        arena: initial(),
        context: { unit: in.unit, limit: in.limit, current: 0, serial: 0, valid: true, borrowing: false, enabled: settings.enabled, summaries: settings.summaries, readers: settings.readers, discover: settings.discover, selecting: settings.selecting, looping: settings.looping, symbol_base: 0, cached_base: 0, result_base: 0 },
        parents: { units: numbers, limits: numbers, currents: numbers, serials: numbers, valid: flags, borrowing: flags, enabled: flags, summaries: numbers, readers: numbers, discover: flags, selecting: flags, looping: flags, symbol_bases: numbers, cached_bases: numbers, result_bases: numbers },
        symbols: unit.symbols.names.map(name => 0),
        cached: unit.expressions.kinds.map(kind => 0),
        saved: numbers,
        snapshots: { firsts: numbers, currents: numbers },
        results: { values: numbers, versions: numbers },
        updates: ids,
        inferred: { expressions: ids, lanes: numbers },
        frames: frames,
        paths: ids,
        stack: numbers
    }
}
