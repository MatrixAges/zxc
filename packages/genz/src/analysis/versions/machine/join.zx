import merge from "../value/merge"
import mergeCached from "./merge_cached"
import mergeSymbols from "./merge_symbols"

import type { Machine } from "../model"

export type Input = { machine: Machine, depth: u64, left: u64, right: u64 }

export type Output = { machine: Machine, value: u64 }

export default function (in: Input): Output {
    const machine = in.machine
    const position = machine.snapshots.firsts.length - 1 - in.depth
    const first = machine.snapshots.firsts[position]
    const previous = machine.snapshots.currents[position]
    const next_version = machine.context.current
    const fresh = previous != next_version
    const serial = fresh ? machine.context.serial + 1 : machine.context.serial
    const joined = fresh ? serial : next_version
    const width = machine.symbols.length - machine.context.symbol_base
    const symbols = mergeSymbols({ arena: machine.arena, symbols: machine.symbols, saved: machine.saved, base: machine.context.symbol_base, from: first, left: previous, right: next_version, joined: joined })
    const cached = mergeCached({ arena: symbols.arena, cached: machine.cached, saved: machine.saved, base: machine.context.cached_base, from: first + width, left: previous, right: next_version, joined: joined })
    const result = merge({ arena: cached.arena, left: in.left, right: in.right, left_version: previous, right_version: next_version, joined: joined })

    return { machine: { ...machine, arena: result.arena, symbols: symbols.symbols, cached: cached.cached, context: { ...machine.context, serial: serial, current: joined } }, value: result.value }
}
