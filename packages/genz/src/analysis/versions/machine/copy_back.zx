export type Input = { target: u64[], saved: u64[], base: u64, from: u64 }

export type Output = u64[]

export default function (in: Input): Output {
    const result = loop({ target: in.target, saved: in.saved, base: in.base, from: in.from, index: 0 }, {
        while: current => current.base + current.index < current.target.length,
        next: current => {
            current.target = current.target.with(current.base + current.index, current.saved[current.from + current.index])
            current.index += 1
        }
    })

    return result.target
}
