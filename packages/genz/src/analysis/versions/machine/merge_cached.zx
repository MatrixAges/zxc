import merge from "../value/merge"

import type { Arena } from "../value/model"

export type Input = { arena: Arena, cached: u64[], saved: u64[], base: u64, from: u64, left: u64, right: u64, joined: u64 }

export type Output = { arena: Arena, cached: u64[] }

export default function (in: Input): Output {
    const result = loop({ arena: in.arena, cached: in.cached, saved: in.saved, base: in.base, from: in.from, left: in.left, right: in.right, joined: in.joined, index: 0 }, {
        while: current => current.base + current.index < current.cached.length,
        next: current => {
            const saved = current.saved[current.from + current.index]
            const value = current.cached[current.base + current.index]

            if (saved == 0 || value == 0) {
                current.cached = current.cached.with(current.base + current.index, 0)
            } else {
                const made = merge({ arena: current.arena, left: saved - 1, right: value - 1, left_version: current.left, right_version: current.right, joined: current.joined })

                current.arena = made.arena
                current.cached = current.cached.with(current.base + current.index, made.value + 1)
            }

            current.index += 1
        }
    })

    return { arena: result.arena, cached: result.cached }
}
