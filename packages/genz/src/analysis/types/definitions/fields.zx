import bytes from "std:bytes"
import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Input as Source, Output, Types, Field } from "./model"

export type Input = {
    source: Source,
    types: Types
}

export default function (in: Input): Output {
    const fields: Field[] = []

    const result = loop({
        source: in.source.types,
        values: in.types.values,
        valid: in.types.valid,
        type_index: 0,
        field_index: 0,
        field_end: 0,
        fields
    }, {
        while: current => current.valid &&
            (
                current.type_index < current.source.kinds.length ||
                    current.field_index < current.field_end
            ),
        next: current => {
            if (current.field_index < current.field_end) {
                const field = current.field_index

                current.fields = current.fields.push({
                    name: bytes.fromText(current.source.field_names[field]),
                    value: current
                        .values[integers.widen(
                            current.source.field_types[field]
                        )],
                    default_value: null,
                    comptime_parameter: false
                })[0]
                current.field_index += 1
            } else {
                const index = current.type_index

                if (kind(current.source.kinds[index]) == Kind.Object) {
                    current.field_index = integers.widen(current.source.first[index])
                    current.field_end = current.field_index +
                        integers.widen(current.source.second[index])
                }

                current.type_index += 1
            }
        }
    })

    return {
        types: in.types,
        fields: result.fields
    }
}
