import integers from "std:integer"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    id: u32,
    optional: bool
}

export type Output = u32[][]

export type Pending = {
    id: u32,
    path: u32[]
}

export default function (in: Input): Output {
    const empty: u32[] = []

    const pending: Pending[] = [{
        id: in.id,
        path: empty
    }]

    const leaves: u32[][] = []

    return loop({
        types: in.types,
        optional: in.optional,
        pending,
        leaves
    }, {
        while: current => current.pending.length != 0,
        next: current => {
            const item = current.pending[current.pending.length - 1]
            const index = integers.widen(item.id)
            const kind = current.types.kinds[index]

            current.pending = current.pending.pop()[0]

            const condition = (
                - kind == 3
                - or (kind == 2 && current.optional)
            )

            if (condition) {
                current.leaves = current.leaves.push(item.path)[0]
            } else if (kind == 1 || kind == 4) {
                current.pending = loop({
                    types: current.types,
                    pending: current.pending,
                    object: kind == 1,
                    first: integers.widen(current.types.first[index]),
                    path: item.path,
                    remaining: integers.widen(
                        current.types.second[index]
                    )
                }, {
                    while: members => members.remaining != 0,
                    next: members => {
                        members.remaining -= 1

                        const child =
                            match {
                                members.object => members.types
                                    .field_types[members.first +
                                        members.remaining],
                                _ => members.types
                                    .children[members.first +
                                        members.remaining]
                            }

                        members.pending = members.pending.push({
                            id: child,
                            path:
                                members.path.push(
                                    integers.narrow(
                                        members.remaining
                                    )
                                )[0]
                        })[0]
                    },
                    return: state => state.pending
                })
            }
        },
        return: state => state.leaves
    })
}
