import type { Plan, Build } from "../model"

export type Input = Plan

export type Output = Build

export default function (in: Input): Output {
    const count = in.ordered.length
    const empty: bool[] = []

    const state_claimed = loop({
        values: empty
    }, {
        while: current => current.values.length < count,
        next: current => { current.values = current.values.push(false)[0] },
        return: state => state.values
    })

    const view_claimed = loop({
        values: empty
    }, {
        while: current => current.values.length < count,
        next: current => { current.values = current.values.push(false)[0] },
        return: state => state.values
    })

    return {
        source: in,
        state_claimed,
        view_claimed,
        index: 0,
        field_count: 0,
        null_count: 0,
        valid: true,
        tags: [],
        offsets: [],
        identifier: [],
        primitive: [],
        optional_type: [],
        const_pointer: [],
        const_slice: [],
        tuple_type: [],
        enum_type: [],
        struct_type_start: [],
        struct_type_len: [],
        declarations: [],
        records: [],
        values: [],
        layouts: [],
        views: []
    }
}
