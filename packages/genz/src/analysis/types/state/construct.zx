import finish from "./construct/finish"
import initial from "./construct/initial"
import step from "./construct/step"

import type { Plan, Types } from "./model"

export type Input = Plan

export type Output = Types

export default function (in: Input): Output {
    return loop(initial(in), {
        while: current => current.valid &&
            current.index < current.source.source.types.kinds.length,
        next: current => {
            current = step(current)
        },
        return: state => finish(state)
    })
}
