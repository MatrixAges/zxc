import bytes from "std:bytes"
import integers from "std:integer"
import strings from "std:string"
import { max_u32 } from "core/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import {
    ExpressionsKind,
    ExpressionsPrimitive
} from "../../../printer/model/expressions"
import position from "../../names/position"
import {
    list_nodes,
    object_nodes,
    tuple_nodes,
    view_prefix,
    storage_plain,
    storage_shared,
    storage_exclusive
} from "./const"
import tuple from "./tuple"

import type { Constant } from "../../../ast/declarations/model"
import type { Plan, Types, Record } from "./model"

export type Input = Plan

export type Output = Types

export default function (in: Input): Output {
    const tags: ExpressionsKind[] = []
    const offsets: u32[] = []
    const identifier: u8[][] = []
    const primitive: ExpressionsPrimitive[] = []
    const optional_type: u32[] = []
    const const_pointer: u32[] = []
    const const_slice: u32[] = []
    const tuple_type: u32[][] = []
    const enum_type: u8[][][] = []
    const struct_type_start: u32[] = []
    const struct_type_len: u32[] = []
    const declarations: Constant[] = []
    const records: Record[] = []
    const values: u32[] = []
    const layouts: u32[] = []
    const views: u32[] = []
    const state_claimed: bool[] = []
    const view_claimed: bool[] = []

    const result = loop({
        source: in,
        state_claimed: loop({
            count: in.ordered.length,
            values: state_claimed
        }, {
            while: current => current.values.length < current.count,
            next: current => { current.values =
                current.values.push(false)[0] }
        }).values,
        view_claimed: loop({
            count: in.ordered.length,
            values: view_claimed
        }, {
            while: current => current.values.length < current.count,
            next: current => { current.values =
                current.values.push(false)[0] }
        }).values,
        index: 0,
        field_count: 0,
        null_count: 0,
        valid: true,
        tags,
        offsets,
        identifier,
        primitive,
        optional_type,
        const_pointer,
        const_slice,
        tuple_type,
        enum_type,
        struct_type_start,
        struct_type_len,
        declarations,
        records,
        values,
        layouts,
        views
    }, {
        while: current => current.valid &&
            current.index < current.source.source.types.kinds.length,
        next: current => {
            const index = current.index
            const source = current.source.source
            const target = kind(source.types.kinds[index])
            const first = source.types.first[index]
            const second = source.types.second[index]
            const selected = source.selected[index]
            const borrowed = source.borrowed[index]
            const changed = current.source.changed[index]
            const aggregate = target == Kind.Object || target == Kind.Tuple
            const count = match {
                target == Kind.Optional => changed ? 2 : 1,
                !selected => 0,
                target == Kind.List => list_nodes,
                target == Kind.Object => object_nodes * (changed ? 2 : 1),
                _ => tuple_nodes * (changed ? 2 : 1)
            }
            const field_count = match {
                selected && target == Kind.List => 2,
                selected && target == Kind.Object =>
                    (integers.widen(second) + 1) * (changed ? 2 : 1),
                _ => 0
            }
            const start_wide = integers.widen(source.base) + current.tags.length
            const field_start = integers.widen(source.field_base)

            if (
                start_wide + count + (borrowed ? 1 : 0) > integers.widen(max_u32) ||
                    field_start + current.field_count + field_count >
                    integers.widen(max_u32)
            ) {
                current.valid = false
            } else {
                const start = integers.narrow(start_wide)
                const name = current.source.names[index]
                const slot = selected ? position({
                    names: current.source.ordered,
                    name
                }) : 0
                const value = match {
                    target == Kind.Optional => start,
                    !selected => source.abi_types[index],
                    _ =>
                        start +
                        integers.narrow(count / (changed && aggregate ? 2 : 1)) - 1
                }
                const layout = target == Kind.Optional || selected ? value :
                    source.abi_layouts[index]
                const view = match {
                    target == Kind.Optional => changed ? start + 1 : value,
                    target == Kind.List &&
                        kind(source.types.kinds[integers.widen(first)]) == Kind.Object &&
                        source.selected[integers.widen(first)] => start,
                    selected && aggregate => changed ?
                        start + integers.narrow(count) - 1 : value,
                    _ => source.abi_types[index]
                }

                if (target == Kind.Optional) {
                    current = {
                        ...current,
                        tags: current.tags.push(ExpressionsKind.OptionalType)[0],
                        offsets:
                            current.offsets.push(
                                integers.narrow(
                                    current.optional_type.length
                                )
                            )[0],
                        optional_type:
                            current.optional_type.push(
                                current.values[integers.widen(
                                    first
                                )]
                            )[0]
                    }
                    if (changed) {
                        current = {
                            ...current,
                            tags: current.tags.push(ExpressionsKind.OptionalType)[0],
                            offsets:
                                current.offsets.push(
                                    integers.narrow(
                                        current.optional_type.length
                                    )
                                )[0],
                            optional_type:
                                current.optional_type.push(
                                    current.views[integers.widen(
                                        first
                                    )]
                                )[0]
                        }
                    }
                } else if (selected) {
                    const fresh_state = !current.state_claimed[slot]

                    current.state_claimed[slot] = true

                    if (target == Kind.List) {
                        const child = integers.widen(first)
                        const child_kind = kind(source.types.kinds[child])
                        const element = match {
                            source.element_storage[index] && source.selected[child] &&
                                child_kind == Kind.List =>
                                current.values[child],
                            source.selected[child] && child_kind == Kind.Object =>
                                source.abi_layouts[child],
                            _ => source.abi_types[child]
                        }

                        current = {
                            ...current,
                            tags: current.tags.push(ExpressionsKind.ConstSlice)[0],
                            offsets:
                                current.offsets.push(
                                    integers.narrow(
                                        current.const_slice.length
                                    )
                                )[0],
                            const_slice: current.const_slice.push(element)[0]
                        }
                        current = {
                            ...current,
                            tags: current.tags.push(ExpressionsKind.EnumType)[0],
                            offsets:
                                current.offsets.push(
                                    integers.narrow(
                                        current.enum_type.length
                                    )
                                )[0],
                            enum_type: current.enum_type.push(
                                [
                                    bytes.fromText(
                                        storage_plain
                                    ),
                                    bytes.fromText(storage_shared),
                                    bytes.fromText(storage_exclusive)
                                ]
                            )[0]
                        }
                        current = {
                            ...current,
                            tags: current.tags.push(ExpressionsKind.StructType)[0],
                            offsets:
                                current.offsets.push(
                                    integers.narrow(
                                        current.struct_type_start.length
                                    )
                                )[0],
                            struct_type_start:
                                current.struct_type_start.push(
                                    integers.narrow(
                                        field_start + current.field_count
                                    )
                                )[0],
                            struct_type_len: current.struct_type_len.push(2)[0],
                            records: current.records.push({
                                owner: index,
                                view: false,
                                start
                            })[0],
                            field_count: current.field_count + integers.widen(2)
                        }
                    } else {
                        current = {
                            ...current,
                            tags: current.tags.push(ExpressionsKind.OptionalType)[0],
                            offsets:
                                current.offsets.push(
                                    integers.narrow(
                                        current.optional_type.length
                                    )
                                )[0],
                            optional_type:
                                current.optional_type.push(
                                    current.source.source.abi_types[index]
                                )[0]
                        }
                        if (target == Kind.Object) {
                            current = {
                                ...current,
                                tags: current.tags.push(ExpressionsKind.NullValue)[0],
                                offsets:
                                    current.offsets.push(
                                        integers.narrow(
                                            current.null_count
                                        )
                                    )[0],
                                null_count: current.null_count + 1
                            }
                            current = {
                                ...current,
                                tags:
                                    current.tags.push(ExpressionsKind.StructType)[0],
                                offsets:
                                    current.offsets.push(
                                        integers.narrow(
                                            current.struct_type_start.length
                                        )
                                    )[0],
                                struct_type_start:
                                    current.struct_type_start.push(
                                        integers.narrow(
                                            field_start + current.field_count
                                        )
                                    )[0],
                                struct_type_len:
                                    current.struct_type_len.push(second + 1)[0],
                                records: current.records.push({
                                    owner: index,
                                    view: false,
                                    start
                                })[0],
                                field_count:
                                    current.field_count + integers.widen(second + 1)
                            }
                        } else {
                            current = {
                                ...current,
                                tags: current.tags.push(ExpressionsKind.TupleType)[0],
                                offsets:
                                    current.offsets.push(
                                        integers.narrow(
                                            current.tuple_type.length
                                        )
                                    )[0],
                                tuple_type: current.tuple_type.push(tuple({
                                    children: current.source.source.types.children,
                                    first: integers.widen(first),
                                    count: integers.widen(second),
                                    values: current.values,
                                    origin: start
                                }))[0]
                            }
                        }
                    }

                    const definition = value - 1

                    if (fresh_state) {
                        current.declarations = current.declarations.push({
                            name: bytes.fromText(name),
                            type_expr: null,
                            value: definition,
                            exported: source.exported
                        })[0]
                    }

                    current = {

                        ...current,

                        tags: current.tags.push(ExpressionsKind.Identifier)[0],

                        offsets:
                            current.offsets.push(
                                integers.narrow(
                                    current.identifier.length
                                )
                            )[0],

                        identifier: current.identifier.push(bytes.fromText(name))[0]

                    }

                    if (aggregate) {
                        const view_name = strings.join("", [
                            view_prefix,
                            name
                        ])

                        if (changed) {
                            const view_start = value + 1
                            current = {
                                ...current,
                                tags:
                                    current.tags.push(ExpressionsKind.OptionalType)[0],
                                offsets:
                                    current.offsets.push(
                                        integers.narrow(
                                            current.optional_type.length
                                        )
                                    )[0],
                                optional_type:
                                    current.optional_type.push(
                                        current.source.source.abi_types[index]
                                    )[0]
                            }
                            if (target == Kind.Object) {
                                current = {
                                    ...current,
                                    tags:
                                        current.tags.push(ExpressionsKind.NullValue)[0],
                                    offsets:
                                        current.offsets.push(
                                            integers.narrow(
                                                current.null_count
                                            )
                                        )[0],
                                    null_count: current.null_count + 1
                                }
                                current = {
                                    ...current,
                                    tags:
                                        current.tags.push(ExpressionsKind.StructType)[0],
                                    offsets:
                                        current.offsets.push(
                                            integers.narrow(
                                                current.struct_type_start.length
                                            )
                                        )[0],
                                    struct_type_start:
                                        current.struct_type_start.push(
                                            integers.narrow(
                                                field_start + current.field_count
                                            )
                                        )[0],
                                    struct_type_len:
                                        current.struct_type_len.push(second + 1)[0],
                                    records: current.records.push({
                                        owner: index,
                                        view: true,
                                        start: view_start
                                    })[0],
                                    field_count:
                                        current.field_count + integers.widen(
                                            second + 1
                                        )
                                }
                            } else {
                                current = {
                                    ...current,
                                    tags:
                                        current.tags.push(ExpressionsKind.TupleType)[0],
                                    offsets:
                                        current.offsets.push(
                                            integers.narrow(
                                                current.tuple_type.length
                                            )
                                        )[0],
                                    tuple_type: current.tuple_type.push(tuple({
                                        children: current.source.source.types.children,
                                        first: integers.widen(first),
                                        count: integers.widen(second),
                                        values: current.views,
                                        origin: view_start
                                    }))[0]
                                }
                            }
                        }

                        if (!current.view_claimed[slot]) {
                            current.declarations = current.declarations.push({
                                name: bytes.fromText(view_name),
                                type_expr: null,
                                value: changed ? view - 1 : value,
                                exported: source.exported
                            })[0]
                            current.view_claimed[slot] = true
                        }

                        if (changed) {
                            current = {
                                ...current,
                                tags:
                                    current.tags.push(ExpressionsKind.Identifier)[0],
                                offsets:
                                    current.offsets.push(
                                        integers.narrow(
                                            current.identifier.length
                                        )
                                    )[0],
                                identifier:
                                    current.identifier.push(
                                        bytes.fromText(
                                            view_name
                                        )
                                    )[0]
                            }
                        }
                    }
                }

                const reference = borrowed ? integers.narrow(
                    integers.widen(source.base) + current.tags.length
                ) : value

                if (borrowed) {
                    current = {
                        ...current,
                        tags: current.tags.push(ExpressionsKind.ConstPointer)[0],
                        offsets: current.offsets.push(
                            integers.narrow(
                                current.const_pointer.length
                            )
                        )[0],
                        const_pointer: current.const_pointer.push(value)[0]
                    }
                }

                current = {
                    ...current,
                    values: current.values.push(borrowed ? reference : value)[0],
                    layouts: current.layouts.push(layout)[0],
                    views: current.views.push(view)[0],
                    index: current.index + 1
                }
            }
        }
    })

    const empty_ids: u32[] = []
    const empty_text: u8[][] = []
    const empty_errors: u8[][][] = []
    const empty_optional_errors: u8[][]?[] = []
    const empty_flags: bool[] = []
    const empty_arguments: u32[][] = []

    return {
        expressions: {
            tags: result.tags,
            offsets: result.offsets,
            identifier: result.identifier,
            primitive: result.primitive,
            field_target: empty_ids,
            field_name: empty_text,
            const_pointer: result.const_pointer,
            optional_type: result.optional_type,
            const_slice: result.const_slice,
            error_set: empty_errors,
            error_union_payload: empty_ids,
            error_union_errors: empty_optional_errors,
            error_union_inferred: empty_flags,
            call_callee: empty_ids,
            call_arguments: empty_arguments
        },
        definitions: {
            tuple_type: result.tuple_type,
            enum_type: result.enum_type,
            struct_type_start: result.struct_type_start,
            struct_type_len: result.struct_type_len
        },
        declarations: result.declarations,
        records: result.records,
        values: result.values,
        layouts: result.layouts,
        views: result.views,
        valid: result.valid
    }
}
