import integers from "std:integer"

import type { Table } from "core/type_table/model"

export type Input = { types: Table, id: u32, pending: u32[], count: u64 }

export type Output = { pending: u32[], count: u64 }

export default function (in: Input): Output {
    const index = integers.widen(in.id)
    const kind = in.types.kinds[index]
    const single = kind == 2 || kind == 3

    const count = match {
        single => 1,
        kind == 1 || kind == 4 => integers.widen(in.types.second[index]),
        _ => 0,
    }

    const result = loop({ types: in.types, kind: kind, single: single, first: in.types.first[index], pending: in.pending, count: in.count, position: 0, end: count }, {
        while: current => current.position < current.end,
        next: current => {
            const child = match {
                current.single => current.first,
                current.kind == 1 => current.types.field_types[integers.widen(current.first) + current.position],
                _ => current.types.children[integers.widen(current.first) + current.position],
            }

            if (current.count == current.pending.length) {
                current.pending = current.pending.push(child)[0]
            } else {
                current.pending[current.count] = child
            }

            current.count += 1
            current.position += 1
        }
    })

    return { pending: result.pending, count: result.count }
}
