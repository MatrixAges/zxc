import type { Plan, Build } from "../model"

export type Input = Plan

export type Output = Build

export default function (in: Input): Output {
    return {
        source: in.source,
        order: in.order,
        child: in.child,
        remaining: in.order.length,
        valid: true,
        tags: [],
        offsets: [],
        identifier: [],
        primitive: [],
        field_target: [],
        field_name: [],
        const_pointer: [],
        optional_type: [],
        const_slice: [],
        error_set: [],
        error_union_payload: [],
        error_union_errors: [],
        error_union_inferred: [],
        call_callee: [],
        call_arguments: [],
        ids: [],
        values: [],
        layouts: []
    }
}
