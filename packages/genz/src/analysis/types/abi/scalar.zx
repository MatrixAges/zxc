import {
    scalar_void,
    scalar_bool,
    scalar_u8,
    scalar_u16,
    scalar_u32,
    scalar_u64,
    scalar_i32,
    scalar_i64,
    scalar_f32,
    scalar_f64
} from "core/type_table/const"

import { ExpressionsPrimitive } from "../../../printer/model/expressions"

export type Input = u32

export type Output = ExpressionsPrimitive

export default function (in: Input): Output {
    return match in {
        scalar_void => ExpressionsPrimitive.Void,
        scalar_bool => ExpressionsPrimitive.Bool,
        scalar_u8 => ExpressionsPrimitive.U8,
        scalar_u16 => ExpressionsPrimitive.U16,
        scalar_u32 => ExpressionsPrimitive.U32,
        scalar_u64 => ExpressionsPrimitive.U64,
        scalar_i32 => ExpressionsPrimitive.I32,
        scalar_i64 => ExpressionsPrimitive.I64,
        scalar_f32 => ExpressionsPrimitive.F32,
        scalar_f64 => ExpressionsPrimitive.F64,
        _ => ExpressionsPrimitive.U8
    }
}
