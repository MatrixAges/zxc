import integers from "std:integer"

import children from "./children"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    boxed: bool[],
    roots: u32[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const queue: u32[] = []

    const seeded = loop({
        boxed: in.boxed,
        roots: in.roots,
        queue,
        index: 0
    }, {
        while: current => current.index < current.roots.length,
        next: current => {
            const id = current.roots[current.index]
            const index = integers.widen(id)

            if (!current.boxed[index]) {
                current.boxed[index] = true
                current.queue = current.queue.push(id)[0]
            }

            current.index += 1
        }
    })

    return loop({
        types: in.types,
        boxed: seeded.boxed,
        queue: seeded.queue,
        index: 0
    }, {
        while: current => current.index < current.queue.length,
        next: current => {

            const reached = current.queue[current.index]
                -> children({
                    types: current.types,
                    id: _,
                    deep: true
                })

            const discovered = loop({
                boxed: current.boxed,
                queue: current.queue,
                children: reached,
                index: 0
            }, {
                while: pending => pending.index < pending.children.length,
                next: pending => {
                    const child = pending.children[pending.index]
                    const index = integers.widen(child)

                    if (!pending.boxed[index]) {
                        pending.boxed[index] = true
                        pending.queue = pending.queue.push(child)[0]
                    }

                    pending.index += 1
                }
            })

            current.boxed = discovered.boxed
            current.queue = discovered.queue
            current.index += 1
        },
        return: state => state.boxed
    })
}
