import integers from "std:integer"

import children from "./children"

import type { Table } from "core/type_table/model"

export type Input = { types: Table, parent: u32, root: u32 }

export type Output = bool

export default function (in: Input): Output {
    const direct = children({ types: in.types, id: in.parent, deep: false })
    const stack = in.types.kinds[integers.widen(in.parent)] == 3 ? direct.push(in.types.first[integers.widen(in.parent)])[0] : direct

    const result = loop({ types: in.types, root: in.root, stack: stack, found: false }, {
        while: current => !current.found && current.stack.length != 0,
        next: current => {
            const id = current.stack[current.stack.length - 1]

            current.stack = current.stack.pop()[0]

            if (id == current.root) {
                current.found = true
            } else {
                const kind = current.types.kinds[integers.widen(id)]
                const nested = children({ types: current.types, id: id, deep: false })

                current.stack = current.stack.concat(nested)[0]

                if (kind == 3) {
                    current.stack = current.stack.push(current.types.first[integers.widen(id)])[0]
                }
            }
        }
    })

    return result.found
}
