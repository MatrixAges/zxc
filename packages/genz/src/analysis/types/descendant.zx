import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import contains from "./contains"

import type { Input } from "./contains"

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.parent)
    const target = kind(in.types.kinds[index])

    if (target == Kind.Optional || target == Kind.List) {
        return contains({
            ...in,
            parent: in.types.first[index]
        })
    }

    if (target != Kind.Object && target != Kind.Tuple) {
        return false
    }

    const first = integers.widen(in.types.first[index])
    const count = integers.widen(in.types.second[index])
    const items = target == Kind.Object ? in.types.field_types : in.types.children

    return loop({
        index: 0,
        found: false
    }, {
        while: state => !state.found && state.index < count,
        next: state => {
            const parent = items[first + state.index]

            state.found = contains({
                ...in,
                parent
            })
            state.index += 1
        },
        return: state => state.found
    })
}
