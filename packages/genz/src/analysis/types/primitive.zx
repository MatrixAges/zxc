import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const base = loop({
        id: in.id
    }, {
        while: current =>
            kind(in.types.kinds[integers.widen(current.id)]) == Kind.Optional,
        next: current => { current.id = in.types.first[integers.widen(current.id)] },
        return: current => current.id
    })

    return match kind(in.types.kinds[integers.widen(base)]) {
        Kind.Scalar => true,
        Kind.ErrorSet => true,
        Kind.Enumeration => true,
        Kind.NativeReference => true,
        _ => false
    }
}
