import integers from "std:integer"

import type { Table } from "core/type_table/model"

export type Input = { types: Table, id: u32 }

export type Output = bool

export default function (in: Input): Output {
    const base = loop({ types: in.types, id: in.id }, {
        while: current => current.types.kinds[integers.widen(current.id)] == 2,
        next: current => { current.id = current.types.first[integers.widen(current.id)] }
    })

    const kind = in.types.kinds[integers.widen(base.id)]

    return kind == 0 || kind == 5 || kind == 7 || kind == 8
}
