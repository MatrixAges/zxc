import integers from "std:integer"

import product from "./flat_product"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const stack: u32[] = [in.id]

    return loop({
        types: in.types,
        stack,
        valid: true
    }, {
        while: current => current.valid && current.stack.length != 0,
        next: current => {
            const id = current.stack[current.stack.length - 1]
            const index = integers.widen(id)
            const kind = current.types.kinds[index]

            current.stack = current.stack.pop()[0]

            if (kind == 2 || kind == 3) {
                current.valid = product({
                    types: current.types,
                    id: current.types.first[index]
                })
            } else if (kind == 1 || kind == 4) {
                current.stack = loop({
                    types: current.types,
                    stack: current.stack,
                    object: kind == 1,
                    position: integers.widen(current.types.first[index]),
                    end:
                        integers.widen(current.types.first[index]) +
                        integers.widen(
                            current.types.second[index]
                        )
                }, {
                    while: members => members.position < members.end,
                    next: members => {
                        members.stack =
                            members.stack.push(
                                match {
                                    members.object =>
                                        members.types.field_types[members.position],
                                    _ => members.types.children[members.position]
                                }
                            )[0]
                        members.position += 1
                    },
                    return: state => state.stack
                })
            } else {
                current.valid = product({
                    types: current.types,
                    id
                })
            }
        },
        return: state => state.valid
    })
}
