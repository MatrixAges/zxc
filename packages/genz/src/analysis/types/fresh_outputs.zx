import integers from "std:integer"

import children from "./fresh_outputs/children"

import type { Program } from "../model"

export type Input = Program

export type Output = bool[]

export default function (in: Input): Output {
    const seen: u32[] = in.types.kinds.map(kind => 0)
    const pending: u32[] = []
    const fresh = in.functions.input_types.map(id => true)

    const result = loop({
        types: in.types,
        functions: in.functions,
        seen: seen,
        pending: pending,
        fresh: fresh,
        index: 0
    }, {
        while: current => current.index < current.functions.input_types.length,
        next: current => {
            const initial = children({
                types: current.types,
                id: current.functions.output_types[current.index],
                pending: current.pending,
                count: 0
            })

            const visited = loop({
                types: current.types,
                input: current.functions.input_types[current.index],
                round: integers.narrow(current.index + 1),
                seen: current.seen,
                pending: initial.pending,
                count: initial.count,
                fresh: true
            }, {
                while: walk => walk.fresh && walk.count != 0,
                next: walk => {
                    walk.count -= 1

                    const id = walk.pending[walk.count]
                    const index = integers.widen(id)

                    if (id == walk.input) {
                        walk.fresh = false
                    } else if (walk.seen[index] != walk.round) {
                        walk.seen[index] = walk.round

                        const nested = children({
                            types: walk.types,
                            id: id,
                            pending: walk.pending,
                            count: walk.count
                        })

                        walk.pending = nested.pending
                        walk.count = nested.count
                    }
                }
            })

            current.seen = visited.seen
            current.pending = visited.pending
            current.fresh[current.index] = visited.fresh
            current.index += 1
        }
    })

    return result.fresh
}
