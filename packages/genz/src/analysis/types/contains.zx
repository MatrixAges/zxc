import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    parent: u32,
    root: u32
}

export type Output = bool

export default function contains(in: Input): Output {
    if (in.parent == in.root) {
        return true
    }

    const index = integers.widen(in.parent)
    const target = kind(in.types.kinds[index])

    if (target == Kind.Optional || target == Kind.List) {
        return contains({
            ...in,
            parent: in.types.first[index]
        })
    }

    if (target != Kind.Object && target != Kind.Tuple) {
        return false
    }

    const loop_initial = {
        index: 0,
        found: false
    }

    const loop_scope = {
        ...in,
        index,
        target
    }

    return loop(loop_initial, {
        while: state => !state.found &&
            state.index < integers.widen(loop_scope.types.second[loop_scope.index]),
        next: state => {
            const position =
                integers.widen(loop_scope.types.first[loop_scope.index]) + state.index
            const parent = match {
                loop_scope.target == Kind.Object =>
                    loop_scope.types.field_types[position],
                _ => loop_scope.types.children[position]
            }

            state.found = contains({
                types: loop_scope.types,
                parent,
                root: loop_scope.root
            })
            state.index += 1
        },
        return: state => state.found
    })
}
