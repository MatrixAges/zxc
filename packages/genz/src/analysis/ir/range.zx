export type Input = { items: u32[], first: u64, count: u64, prefix: u32[] }

export type Output = u32[]

export default function (in: Input): Output {
    const result = loop({ items: in.items, position: in.first, end: in.first + in.count, output: in.prefix }, {
        while: current => current.position < current.end,
        next: current => {
            current.output = current.output.push(current.items[current.position])[0]
            current.position += 1
        }
    })

    return result.output
}
