import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    return {
        expressions: in.context.expressions,
        forms: in.context.forms,
        extra: in.extra,
        statements: in.context.statements,
        variables: in.context.variables,
        fields: in.fields,
        name: in.name,
        name_slot: in.name_slot,
        serial: in.context.serial,
        root: in.root,
        headered: in.headered,
        valid: in.context.valid
    }
}
