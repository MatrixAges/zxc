import context from "../../../ast/context/initialize"
import fields from "../../../ast/fields/empty"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        source: in,
        context: context(in.bases),
        extra: {
            catch_scope_value: [],
            catch_scope_capture: [],
            catch_scope_body_start: [],
            catch_scope_body_len: [],
            mutable_slice: [],
            error_union_payload: [],
            error_union_errors: [],
            error_union_inferred: [],
            namespace_type_start: [],
            namespace_type_len: []
        },
        fields: fields({}),
        declarations: {
            tags: [],
            offsets: [],
            function_name: [],
            function_parameters_start: [],
            function_parameters_len: [],
            function_return_type: [],
            function_body_start: [],
            function_body_len: [],
            function_exported: [],
            function_abi_export: [],
            function_inlined: [],
            function_calling_convention: []
        },
        context_id: 0,
        failure_id: 0,
        false_id: 0,
        guard_id: 0,
        guard_start: 0,
        comparison_id: 0,
        error_start: 0,
        body_start: 0,
        items_id: 0,
        reuse_id: 0,
        ordering: 0,
        sort: 0
    }
}
