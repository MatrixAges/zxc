import bytes from "std:bytes"
import integers from "std:integer"

import binary from "../../../../ast/context/binary"
import boolean from "../../../../ast/context/boolean"
import field from "../../../../ast/context/field"
import identifier from "../../../../ast/context/identifier"
import nullValue from "../../../../ast/context/null_value"
import result from "../../../../ast/context/result"
import { ExpressionsBinaryOperator } from "../../../../printer/model/expressions"
import { context_name, failure_name } from "../const"

import type { State as Input, State as Output } from "../model"

export default function (in: Input): Output {
    const context = identifier({
        state: in.context,
        name: bytes.fromText(context_name)
    })

    const failure = field({
        state: context.state,
        target: context.id,
        name: bytes.fromText(failure_name)
    })

    const no = boolean({
        state: failure.state,
        value: false
    })

    const empty = nullValue(no.state)

    const condition = binary({
        state: empty.state,
        operator: ExpressionsBinaryOperator.NotEqual,
        left: failure.id,
        right: empty.id
    })

    const start = integers.narrow(
        integers.widen(in.source.bases.statement_base) +
            condition.state.statements.tags.length
    )

    return {
        ...in,
        context: result({
            state: condition.state,
            value: no.id
        }),
        context_id: context.id,
        failure_id: failure.id,
        false_id: no.id,
        guard_id: condition.id,
        guard_start: start
    }
}
