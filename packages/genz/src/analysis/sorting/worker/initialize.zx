import context from "../../../ast/context/initialize"
import fields from "../../../ast/fields/empty"

import type { Input, State as Output, Bindings } from "./model"

export default function (in: Input): Output {
    const bindings: Bindings = {
        tags: [],
        offsets: [],
        constant_name: [],
        constant_type_expr: [],
        constant_value: [],
        constant_exported: [],
        discard: []
    }

    return {
        source: in,
        context: context(in.bases),
        discard: [],
        bindings,
        prefix: bindings,
        context_count: 0,
        extra: {
            error_union_payload: [],
            error_union_errors: [],
            error_union_inferred: []
        },
        fields: fields({})
    }
}
