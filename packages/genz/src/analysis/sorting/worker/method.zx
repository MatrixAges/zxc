import bytes from "std:bytes"
import integers from "std:integer"

import primitive from "../../../ast/context/primitive"
import result from "../../../ast/context/result"
import declaration from "../../../ast/declarations/function"
import errorUnion from "../../../ast/expressions/error_union"
import appendField from "../../../ast/fields/append"
import { ExpressionsPrimitive } from "../../../printer/model/expressions"
import { context_name, compare_name } from "../functions/const"
import { left_element_name, right_element_name } from "./const"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const context_type = primitive({
        state: in.context,
        value: ExpressionsPrimitive.Anytype
    })

    const returns = errorUnion({
        table: {
            ...context_type.state.expressions.pick([
                "tags",
                "offsets"
            ]),
            ...in.extra
        },
        base: in.source.bases.expression_base,
        payload: in.source.output_type,
        errors: in.source.errors,
        inferred: false
    })

    const ending = result({
        state: {
            ...context_type.state,
            expressions: {
                ...context_type.state.expressions,
                ...returns.table.pick([
                    "tags",
                    "offsets"
                ])
            },
            valid: context_type.state.valid && returns.valid
        },
        value: in.source.value
    })

    const context = appendField({
        table: in.fields,
        name: bytes.fromText(context_name),
        value: context_type.id,
        default_value: null,
        comptime_parameter: false
    })

    const left = appendField({
        table: context,
        name: bytes.fromText(left_element_name),
        value: in.source.child,
        default_value: null,
        comptime_parameter: false
    })

    const fields = appendField({
        table: left,
        name: bytes.fromText(right_element_name),
        value: in.source.child,
        default_value: null,
        comptime_parameter: false
    })

    const count = (
        in.context_count + in.source.reference_count + in.source.helper_count +
            in.bindings.tags.length + ending.statements.tags.length
    )

    const function_value = declaration({
        base: in.source.declaration_base,
        name: bytes.fromText(compare_name),
        parameters_start: in.source.bases.field_base,
        parameters_count: 3,
        return_type: returns.id,
        body_start: in.source.bases.statement_base,
        body_count: integers.narrow(count),
        exported: false,
        abi_export: false,
        inlined: false,
        calling_convention: null
    })

    return {
        expressions: ending.expressions,
        forms: ending.forms,
        extra: returns.table.omit([
            "tags",
            "offsets"
        ]),
        prefix: in.prefix,
        bindings: in.bindings,
        ending: ending.statements,
        fields,
        declarations: function_value.table,
        valid: ending.valid && function_value.valid
    }
}
