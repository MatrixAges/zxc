import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import key from "./key"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    keys: u8[],
    bytes: u8[],
    index: u64,
    chosen: bool
}

export type Output = u8[]

export default function (in: Input): Output {
    const target = kind(in.types.kinds[in.index])
    const first = integers.widen(in.types.first[in.index])

    if (target == Kind.Optional || target == Kind.List) {
        return key({
            keys: in.keys,
            bytes: in.bytes,
            id: first
        })
    }

    if (!in.chosen) {
        return in.bytes
    }

    return loop({
        types: in.types,
        keys: in.keys,
        bytes: in.bytes,
        object: target == Kind.Object,
        first,
        count: integers.widen(in.types.second[in.index]),
        position: 0
    }, {
        while: current => current.position < current.count,
        next: current => {
            const child =
                current.object ? current.types
                .field_types[current.first +
                    current.position] :
                current.types.children[current.first + current.position]

            current.bytes = key({
                keys: current.keys,
                bytes: current.bytes,
                id: integers.widen(child)
            })
            current.position += 1
        },
        return: state => state.bytes
    })
}
