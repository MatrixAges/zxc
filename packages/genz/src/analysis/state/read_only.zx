import body from "./read_only/body"
import scalar from "./read_only/scalar"

import type { Program } from "../model"

export type Input = Program

export type Output = bool

export default function (in: Input): Output {
    if (in.stores.types.length != 0 || !scalar({
        types: in.types,
        id: in.output_type
    })) {
        return false
    }

    if (!body(in.pick([
        "expressions",
        "control",
        "contracts",
        "root"
    ]))) {
        return false
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: (current, source) => current.valid &&
            current.index < source.functions.output_types.length,
        next: (current, source) => {
            const index = current.index
            const functions = source.functions
            const condition = (
                - functions.native_modules[index] == null
                - and functions.stores[index].types.length == 0
                - and scalar({
                    types: source.types,
                    id: functions.output_types[index]
                })
                - and body({
                    expressions: functions.expressions[index],
                    control: functions.control[index],
                    root: functions.roots[index],
                    contracts: functions.contracts[index]
                })
            )

            current.valid = condition
            current.index += 1
        },
        return: current => current.valid
    }, in)
}
