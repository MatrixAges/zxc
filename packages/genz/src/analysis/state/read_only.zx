import body from "./read_only/body"
import scalar from "./read_only/scalar"

import type { Program } from "../model"

export type Input = Program

export type Output = bool

export default function (in: Input): Output {
    if (in.stores.types.length != 0 || !scalar({
        types: in.types,
        id: in.output_type
    })) {
        return false
    }

    if (!body(in.pick([
        "expressions",
        "control",
        "contracts",
        "root"
    ]))) {
        return false
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: current => current.valid &&
            current.index < in.functions.output_types.length,
        next: current => {
            const index = current.index
            const functions = in.functions
            const native_modules = functions.native_modules
            const stores = functions.stores
            const local_body = match {
                native_modules[index] == null => stores[index].types.length == 0,
                _ => false
            }

            if (!local_body) {
                current.valid = false
            } else if (!scalar({
                types: in.types,
                id: functions.output_types[index]
            })) {
                current.valid = false
            } else {
                current.valid = body({
                    expressions: functions.expressions[index],
                    control: functions.control[index],
                    root: functions.roots[index],
                    contracts: functions.contracts[index]
                })
            }

            current.index += 1
        },
        return: current => current.valid
    })
}
