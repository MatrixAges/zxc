import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"
import type { Boundaries } from "../model"

export type Input = {
    types: Table,
    source: Boundaries
}

export type Output = u32[]

export default function (in: Input): Output {
    const roots: u32[] = []

    return loop({
        roots,
        index: 0
    }, {
        while: state => state.index < in.source.inputs.length,
        next: state => {
            const output = in.source.outputs[state.index]
            const target = kind(in.types.kinds[integers.widen(output)])
            const scalar = (
                match target {
                    Kind.Scalar => true,
                    Kind.Enumeration => true,
                    Kind.ErrorSet => true,
                    _ => false
                }
            )

            if (!scalar) {
                state.roots = state.roots.push(in.source.inputs[state.index])[0]
            }

            state.index += 1
        },
        return: state => state.roots
    })
}
