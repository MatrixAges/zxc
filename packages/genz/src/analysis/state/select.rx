<Module>
    <Call fn="../types/unmarked" in={$in.types} />
    <Call fn="roots" in={$in} />
    <Call fn="../types/closure" in={{ types: $in.types, boxed: $ctx.unmarked, roots: $ctx.roots }} />
    <Call fn="duplicates" in={{ program: $in, boxed: $ctx.closure }} />
    <Call fn="built" in={$in} />
    <Call fn="frozen" in={{ types: $in.types, boxed: $ctx.duplicates, built: $ctx.built }} />
    <Call fn="keys" in={{ types: $in.types, boxed: $ctx.frozen }} />

    <Return value={$ctx.keys} />
</Module>
