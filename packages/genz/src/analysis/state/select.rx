<Module>
    <Type from="built" as="Built" />
    <Type from="keys" as="Keys" />
    <Type from="../model" as="Model" />

    <Args
        in={{
            program: Built.Input,
            boundaries: Model.Boundaries,
            local: bool[]
        }}
        out={Keys.Output}
    />

    <Call fn="../types/unmarked" in={$in.program.types} />
    <Call fn="records" in={$in.program.types} />

    <Call
        module="visible"
        in={{
            program: $in.program,
            roots: $in.boundaries,
            local: $in.local,
            boxed: $ctx.unmarked
        }}
    />

    <Call fn="read_only" in={$in.program} />

    <Call
        fn="roots"
        in={{
            program: $in.program,
            records: $ctx.records,
            read_only: $ctx.read_only,
            visible: $ctx.visible
        }}
    />

    <Call
        fn="../types/closure"
        in={{
            types: $in.program.types,
            boxed: $ctx.unmarked,
            roots: $ctx.roots
        }}
    />

    <Call
        fn="duplicates"
        in={{
            program: $in.program,
            boxed: $ctx.closure
        }}
    />

    <Call fn="built" in={$in.program} />

    <Call
        fn="row_storage"
        in={{
            types: $in.program.types,
            built: $ctx.built,
            boxed: $ctx.duplicates
        }}
    />

    <Call
        fn="frozen"
        in={{
            types: $in.program.types,
            boxed: $ctx.duplicates,
            built: $ctx.row_storage
        }}
    />

    <Call
        module="borrowing/plan"
        in={{
            program: $in.program,
            boxed: $ctx.frozen
        }}
    />

    <Call fn="element_storage" in={$in.program} />

    <Call
        fn="keys"
        in={{
            types: $in.program.types,
            boxed: $ctx.frozen,
            element_storage: $ctx.element_storage,
            borrowed: $ctx.plan
        }}
    />

    <Return value={$ctx.keys} />
</Module>
