import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import captures from "./captures"
import comparisons from "./comparisons"
import contractComparisons from "./contract_comparisons"
import sharing from "./sharing"

import type { Program } from "../model"

export type Input = {
    program: Program,
    records: bool[],
    visible: bool[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    const containers = loop({
        types: in.program.types,
        visible: in.visible,
        records: in.records,
        index: 0,
        roots: empty
    }, {
        while: current => current.index < current.types.kinds.length,
        next: current => {
            const target = kind(current.types.kinds[current.index])

            const child = integers.widen(current.types.first[current.index])
            const visible = current.visible
            const records = current.records
            const index = current.index
            const boxed_list = match target {
                Kind.List => (
                    - visible[index]
                    - or visible[child]
                    - or !records[child]
                ),
                _ => false
            }

            if (boxed_list || target == Kind.Task) {
                current.roots =
                    current.roots.push(
                        current.types.first[current.index]
                    )[0]
            }

            current.index += 1
        },
        return: state => state.roots
    })

    const program = containers.concat(in.program.stores.types)[0].concat(
        comparisons(
            in.program.expressions
        )
    )[0].concat(
        contractComparisons(
            in.program.contracts
        )
    )[0].concat(captures({
        tables:
            [in.program.expressions].concat(in.program.contracts.expressions)[0],
        symbols: in.program.symbols
    }))[0]

    const shared = program.concat(sharing({
        types: in.program.types,
        records: in.records,
        visible: in.visible,
        tables:
            [in.program.expressions].concat(in.program.contracts.expressions)[0]
    }))[0]

    return loop({
        functions: in.program.functions,
        types: in.program.types,
        records: in.records,
        visible: in.visible,
        index: 0,
        roots: shared
    }, {
        while: current => current.index < current.functions.output_types.length,
        next: current => {
            const position = current.index

            current.roots =
                current.roots.concat(
                    comparisons(
                        current.functions.expressions[position]
                    )
                )[0].concat(
                    contractComparisons(
                        current.functions.contracts[position]
                    )
                )[0].concat(
                    current.functions.stores[position].types
                )[0].concat(captures({
                    tables: [current.functions.expressions[position]].concat(
                        current.functions.contracts[position].expressions
                    )[0],
                    symbols: current.functions.symbols[position]
                }))[0]

            current.roots = current.roots.concat(sharing({
                types: current.types,
                records: current.records,
                visible: current.visible,
                tables: [current.functions.expressions[position]].concat(
                    current.functions.contracts[position].expressions
                )[0]
            }))[0]

            if (current.functions.native_modules[position] != null) {
                current.roots =
                    current.roots.concat(
                        [
                            current.functions.input_types[position],
                            current.functions.output_types[position]
                        ]
                    )[0]
            }

            current.index += 1
        },
        return: state => state.roots
    })
}
