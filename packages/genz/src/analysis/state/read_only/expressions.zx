import { TransformKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = Expressions

export type Output = bool

export default function (in: Input): Output {
    const unsafe = (
        - in.collection_kinds.length != 0
        - or in.update_targets.length != 0
        - or in.parallel_count.length != 0
        - or in.task_bodies.length != 0
        - or in.awaits.length != 0
        - or in.cancellations.length != 0
        - or in.stores.length != 0
    )

    if (unsafe) {
        return false
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: (current, source) => current.valid &&
            current.index < source.transform_kinds.length,
        next: (current, source) => {
            current.valid = source.transform_kinds[current.index] == TransformKind.Sort
            current.index += 1
        },
        return: current => current.valid
    }, in)
}
