import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    return loop(in, {
        while: current => kind(current.types.kinds[integers.widen(current.id)]) ==
            Kind.Optional,
        next: current => {
            current.id = current.types.first[integers.widen(current.id)]
        },
        return: current =>
            match kind(current.types.kinds[integers.widen(current.id)]) {
                Kind.Scalar => true,
                Kind.Enumeration => true,
                Kind.ErrorSet => true,
                _ => false
            }
    })
}
