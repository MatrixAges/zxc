import parallel from "../../control/parallel"
import expressions from "./expressions"

import type { Contracts } from "core/contract_table/model"
import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    control: Control,
    root?: u32,
    contracts: Contracts
}

export type Output = bool

export default function (in: Input): Output {
    if (parallel(in.pick([
        "control",
        "root"
    ])) || !expressions(in.expressions)) {
        return false
    }

    const loop_initial = {
        index: 0,
        valid: true
    }

    const readonly_contracts = in.contracts

    return loop(loop_initial, {
        while: current => current.valid &&
            current.index < readonly_contracts.expressions.length,
        next: current => {
            current.valid = expressions(readonly_contracts.expressions[current.index])
            current.index += 1
        },
        return: current => current.valid
    })
}
