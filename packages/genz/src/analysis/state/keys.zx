import crypto from "std:crypto"
import encoding from "std:encoding"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import {
    value_layout_identity,
    inline_layout_flag,
    reference_layout_flag
} from "./const"
import material from "./material"

import type { Table } from "core/type_table/model"
import type { State } from "../model"

export type Input = {
    types: Table,
    boxed: bool[]
    borrowed: bool[]
}

export type Output = State

export default function (in: Input): Output {
    const selected: bool[] = []
    const keys: u8[] = []

    const result = loop({
        types: in.types,
        boxed: in.boxed,
        borrowed: in.borrowed,
        prefix: encoding.encodeUtf8(value_layout_identity),
        index: 0,
        selected,
        keys
    }, {
        while: current => current.index < current.types.kinds.length,
        next: current => {
            const target = kind(current.types.kinds[current.index])
            const chosen =
                target == Kind.List || (
                    !current.boxed[current.index] && (
                        target == Kind.Object || target == Kind.Tuple
                    )
                )
            const flag: u8 = match {
                current.borrowed[current.index] => reference_layout_flag,
                chosen => inline_layout_flag,
                _ => 0
            }
            const bytes = material({
                types: current.types,
                keys: current.keys,
                bytes: current.prefix.push(flag)[0],
                index: current.index,
                chosen
            })

            current.selected = current.selected.push(chosen)[0]
            current.keys = current.keys.concat(crypto.sha256(bytes))[0]
            current.index += 1
        }
    })

    return {
        selected: result.selected,
        borrowed: in.borrowed,
        keys: result.keys
    }
}
