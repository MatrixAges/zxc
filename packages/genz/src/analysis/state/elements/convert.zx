import append from "../conversion/emit/append"

import type { Work as Input, Work as Output } from "./model"

export default function (in: Input): Output {
    const conversion = in.source.conversion

    if (conversion == null) {
        return {
            ...in,
            state: {
                ...in.state,
                context: {
                    ...in.state.context,
                    valid: false
                }
            }
        }
    }

    const source = {
        ...conversion,
        value: in.root
    }

    const state = append({
        source,
        state: in.state
    })

    return {
        ...in,
        state,
        root: state.nodes[0].result
    }
}
