import integers from "std:integer"
import { map } from "std:utils"

import traverse from "./traverse"

import type { Program } from "../model"

export type Input = {
    program: Program,
    boxed: bool[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const seen: u64[] = map(in.program.types.kinds, kind => 0)

    const first = traverse({
        types: in.program.types,
        boxed: in.boxed,
        seen,
        generation: 1,
        root: in.program.output_type
    })

    const result = loop({
        program: in.program,
        boxed: first.boxed,
        seen: first.seen,
        index: 0
    }, {
        while: current =>
            current.index < current.program.functions.output_types.length,
        next: current => {
            const root = current.program.functions.output_types[current.index]

            if (current.seen[integers.widen(root)] == 0) {
                const pass = traverse({
                    types: current.program.types,
                    boxed: current.boxed,
                    seen: current.seen,
                    generation: current.index + 2,
                    root
                })

                current.boxed = pass.boxed
                current.seen = pass.seen
            }

            current.index += 1
        }
    })

    return result.boxed
}
