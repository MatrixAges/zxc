import traverse from "./traverse"

import type { Program } from "../model"

export type Input = { program: Program, boxed: bool[] }

export type Output = bool[]

export default function (in: Input): Output {
    const first = traverse({ types: in.program.types, boxed: in.boxed, root: in.program.output_type })

    const result = loop({ program: in.program, boxed: first, index: 0 }, {
        while: current => current.index < current.program.functions.output_types.length,
        next: current => {
            current.boxed = traverse({ types: current.program.types, boxed: current.boxed, root: current.program.functions.output_types[current.index] })
            current.index += 1
        }
    })

    return result.boxed
}
