import initialize from "../../../../ast/context/initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        context: initialize(
            in.pick(
                [
                    "capture",
                    "expression_base",
                    "statement_base",
                    "field_base",
                    "serial"
                ]
            )
        ),
        body: {
            tags: [],
            offsets: []
        },
        storage: {
            tags: [],
            offsets: []
        },
        borrow_storage: {
            tags: [],
            offsets: []
        },
        fields: [],
        nodes: in.plan.types.map(type_id => ({
            input: 0,
            result: 0,
            child: 0,
            empty: 0,
            target: 0,
            capture: [],
            index: [],
            outer: {
                tags: [],
                offsets: []
            },
            filled: {
                tags: [],
                offsets: []
            }
        }))[0],
        index: 0,
        uses_allocator: false
    }
}
