import integers from "std:integer"

import builtin from "../../../../ast/context/builtin"
import object from "../../../../ast/context/object"
import tuple from "../../../../ast/context/tuple"
import { ExpressionsBuiltinName } from "../../../../printer/model/expressions"
import isInput from "../is_input"
import { Operation } from "../model"
import origin from "./origin"
import outbound from "./outbound"
import reference from "./reference"

import type { Field } from "../../../types/definitions/model"
import type { Step as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const fields: Field[] = []
    const values: u32[] = []
    const category = in.source.plan.kinds[in.node]

    const children = loop({
        fields,
        values,
        index: 0
    }, {
        while: current => current.index < in.source.plan.count[in.node],
        next: current => {
            const position = in.source.plan.first[in.node] + current.index
            const child = integers.widen(in.source.plan.children[position])
            const value = in.state.nodes[child].result

            if (category == Operation.Object) {
                current.fields = current.fields.push({
                    name: in.source.plan.names[child],
                    value,
                    default_value: null,
                    comptime_parameter: false
                })[0]
            } else {
                current.values = current.values.push(value)[0]
            }

            current.index += 1
        }
    })

    const input = isInput(in.source.plan.modes[in.node])

    const provenance = match {
        input => origin(in),
        _ => {
            state: in.state.context,
            id: in.state.nodes[in.node].input
        }
    }

    const members = match {
        input && category == Operation.Object => children.fields.push({
            name: in.source.origins[in.node],
            value: provenance.id,
            default_value: null,
            comptime_parameter: false
        })[0],
        _ => children.fields
    }

    const items = match {
        input && category == Operation.Tuple =>
            children.values.push(provenance.id)[0],
        _ => children.values
    }

    const product = match category {
        Operation.Object => object({
            state: provenance.state,
            type_expr: in.source.layouts[in.node],
            first: in.source.field_base + integers.narrow(in.state.fields.length),
            count: integers.narrow(members.length)
        }),
        _ => tuple({
            state: provenance.state,
            values: items
        })
    }

    const result = match category {
        Operation.Object => product,
        _ => builtin({
            state: product.state,
            name: ExpressionsBuiltinName.As,
            arguments: [
                in.source.layouts[in.node],
                product.id
            ]
        })
    }

    const state = {
        ...in.state,
        context: result.state,
        fields: match category {
            Operation.Object => in.state.fields.concat(members)[0],
            _ => in.state.fields
        },
        body: in.state.body,
        nodes: in.state.nodes.with(in.node, {
            ...in.state.nodes[in.node],
            result: result.id
        })
    }

    if (!input) {
        return outbound({
            ...in,
            state
        })
    }

    return reference({
        ...in,
        state: {
            ...state,
            body: {
                tags: state.nodes[in.node].outer.tags.concat(state.body.tags)[0],
                offsets:
                    state.nodes[in.node].outer.offsets.concat(state.body.offsets)[0]
            }
        }
    })
}
