import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    boxed: bool[],
    built: bool[],
    written: bool[]
}

export type Output = {
    written: bool[],
    changed: bool
}

export default function (in: Input): Output {
    const result = loop({
        types: in.types,
        boxed: in.boxed,
        built: in.built,
        written: in.written,
        changed: false,
        index: 0
    }, {
        while: current => current.index < current.types.kinds.length,
        next: current => {
            const target = kind(current.types.kinds[current.index])

            if (
                !current.boxed[current.index] && !current.written[current.index] &&
                    (
                        target == Kind.Object || target == Kind.Optional ||
                            target == Kind.Tuple
                    )
            ) {
                const direct = target == Kind.Tuple ||
                    (target == Kind.Object && current.built[current.index])

                const reached = direct || loop({
                    types: current.types,
                    written: current.written,
                    target,
                    first: integers.widen(current.types.first[current.index]),
                    count: target == Kind.Optional ? 1 :
                        integers.widen(current.types.second[current.index]),
                    index: 0,
                    found: false
                }, {
                    while: fields => !fields.found && fields.index < fields.count,
                    next: fields => {
                        const child = match fields.target {
                            Kind.Optional => fields.first,
                            Kind.Object => integers.widen(
                                fields.types.field_types[fields.first + fields.index]
                            ),
                            _ => integers.widen(
                                fields.types.children[fields.first + fields.index]
                            )
                        }

                        fields.found = fields.written[child]
                        fields.index += 1
                    }
                }).found

                if (reached) {
                    current.written[current.index] = true
                    current.changed = true
                }
            }

            current.index += 1
        }
    })

    return {
        written: result.written,
        changed: result.changed
    }
}
