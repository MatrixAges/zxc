import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import { Operation } from "../model"

import type { Input as Source } from "../model"

export type Input = {
    source: Source,
    operation: Operation
}

export type Output = u64

export default function (in: Input): Output {
    const types = in.source.types
    const row = integers.widen(in.source.root)

    return match in.operation {
        Operation.Optional => 1,
        Operation.Object => integers.widen(types.second[row]),
        Operation.Tuple => integers.widen(types.second[row]),
        Operation.Rows => match {
            kind(types.kinds[integers.widen(types.first[row])]) == Kind.List => 1,
            _ => 0
        },
        _ => 0
    }
}
