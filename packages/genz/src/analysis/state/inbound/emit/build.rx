<Module>
    <Type from="model" as="Inbound" />

    <Args in={Inbound.Input} out={Inbound.Output} />

    <Call fn="initialize" in={$in} />

    <Call
        fn="walk"
        in={{
            source: $in,
            state: $ctx.initialize
        }}
    />

    <Call fn="publish" in={$ctx.walk} />

    <Return value={$ctx.publish} />
</Module>
