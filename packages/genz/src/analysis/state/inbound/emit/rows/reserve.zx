import binding from "../../../../../ast/body/binding"
import empty from "../../../../../ast/statements/empty"
import apply from "../../../../growth/apply.rx"
import { Operation } from "../../../../growth/const"

import type { Body, StateBody } from "../../../../../ast/body/model"
import type { State as Context } from "../../../../../ast/context/model"
import type { Input as Source } from "../model"

export type Input = {
    source: Source,
    context: Context,
    element: u32,
    value: u32,
    count: u32
}

export type Output = {
    context: Context,
    body: Body,
    root: u32
}

export default function (in: Input): Output {
    const result = apply({
        source: {
            operation: Operation.Reserve,
            element: in.element,
            value: in.value,
            count: in.count,
            minimum: 0,
            flag: false,
            shared: in.source.shared,
            capture: in.source.capture,
            expression_base: in.context.source.expression_base,
            statement_base: in.context.source.statement_base,
            serial: in.context.serial
        },
        context: in.context,
        body: empty({}),
        arguments: [],
        callee: 0,
        root: in.value
    })

    const initial: StateBody = {
        context: result.context,
        body: {
            tags: [],
            offsets: []
        }
    }

    const appended = loop({
        state: initial,
        index: 0
    }, {
        while: current => current.index < result.body.constant_name.length,
        next: current => {
            current.state = binding({
                state: current.state,
                name: result.body.constant_name[current.index],
                value: result.body.constant_value[current.index]
            })
            current.index += 1
        },
        return: current => current.state
    })

    return {
        ...appended,
        root: result.root
    }
}
