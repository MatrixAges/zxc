import { TransformKind } from "core/expression_table/kinds"

import add from "./add"

import type { Parameters as Input, Registration as Output } from "./model"

export default function (in: Input): Output {
    const state: Output = {
        index: in.index,
        added: []
    }

    if (in.kind != TransformKind.Reduce) {
        return state
    }

    return add({
        facts: in.facts,
        state,
        symbol: in.parameters[0]
    })
}
