import storage from "./storage"

import type { Elements as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return storage({
        storage: {
            kinds: in.types.kinds,
            first: in.types.first,
            selected: in.selected,
            element_storage: in.element_storage
        },
        list: in.list
    })
}
