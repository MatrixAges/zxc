import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Elements as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const list = integers.widen(in.list)

    if (kind(in.types.kinds[list]) != Kind.List) {
        return false
    }

    const child = integers.widen(in.types.first[list])
    const target = kind(in.types.kinds[child])

    const storage = in.element_storage

    const stored = (
        - target == Kind.List
        - and list < storage.length
        - and storage[list]
    )

    return (target == Kind.Object || stored) && in.selected[child]
}
