import integers from "std:integer"
import { ExpressionKind, CollectionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    value: u32
}

export type Output = bool

export default function (in: Input): Output {
    const expressions = in.expressions

    return loop({
        value: in.value,
        active: true,
        appended: false,
        found: false
    }, {
        while: state => state.active,
        next: state => {
            const index = integers.widen(state.value)
            const payload = integers.widen(expressions.payloads[index])

            const kind = expressions.kinds[index]

            if (kind == ExpressionKind.Scope) {
                state.value = expressions.scope_results[payload]
            } else if (kind == ExpressionKind.TupleField) {
                const target = integers.widen(expressions.projection_targets[payload])
                const target_payload = integers.widen(expressions.payloads[target])

                if (
                    expressions.projection_indices[payload] != 0 ||
                        expressions.kinds[target] != ExpressionKind.ListOperation
                ) {
                    state.active = false
                } else {
                    const operation = expressions.collection_kinds[target_payload]
                    const is_push = operation == CollectionKind.Push
                    const is_concat = operation == CollectionKind.Concat

                    state.active = is_push || is_concat
                    state.appended = state.active
                    state.value = expressions.collection_targets[target_payload]
                }
            } else {
                state.found = kind == ExpressionKind.Index && state.appended
                state.active = false
            }
        },
        return: state => state.found
    })
}
