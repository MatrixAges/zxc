import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    boxed: bool[],
    built: bool[]
}

export type Output = bool[]

export default function (in: Input): Output {
    return loop({
        types: in.types,
        boxed: in.boxed,
        built: in.built,
        index: 0
    }, {
        while: current => current.index < current.types.kinds.length,
        next: current => {
            const condition = (
                - kind(current.types.kinds[current.index]) == Kind.Object
                - and !current.boxed[current.index]
                - and !current.built[current.index]
            )

            if (condition) {
                current.boxed = current.boxed.with(current.index, true)
            }

            current.index += 1
        },
        return: state => state.boxed
    })
}
