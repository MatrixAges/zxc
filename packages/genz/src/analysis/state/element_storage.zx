import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import nestedAppend from "./nested_append"

import type { Program as Input } from "../model"

export type Output = bool[]

export default function (in: Input): Output {
    const tables = [in.expressions].concat(in.functions.expressions)[0]

    const marked = loop({
        values: in.types.kinds.map(value => false)[0],
        index: 0
    }, {
        while: state => state.index < tables.length,
        next: state => {
            const expressions = tables[state.index]

            state.values = loop({
                values: state.values,
                node: 0
            }, {
                while: row => row.node < expressions.update_targets.length,
                next: row => {
                    if (nestedAppend({
                        expressions,
                        value: expressions.update_values[row.node]
                    })) {
                        const target = integers.widen(
                            expressions.update_targets[row.node]
                        )

                        row.values[integers.widen(
                            expressions.types[target]
                        )] = true
                    }

                    row.node += 1
                },
                return: state => state.values
            })
            state.index += 1
        },
        return: state => state.values
    })

    const loop_initial = {
        values: marked,
        index: 0
    }

    const readonly_types = in.types

    return loop(loop_initial, {
        while: state => state.index < readonly_types.kinds.length,
        next: state => {
            if (kind(readonly_types.kinds[state.index]) == Kind.List) {
                const child = integers.widen(readonly_types.first[state.index])

                state.values[state.index] = state.values[state.index] ||
                    (
                        kind(readonly_types.kinds[child]) == Kind.List &&
                            state.values[child]
                    )
            }

            state.index += 1
        },
        return: state => state.values
    })
}
