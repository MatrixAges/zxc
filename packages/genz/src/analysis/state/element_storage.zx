import integers from "std:integer"
import { ExpressionKind, CollectionKind } from "core/expression_table/kinds"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Program as Input } from "../model"

export type Output = bool[]

export default function (in: Input): Output {
    const tables = [in.expressions].concat(in.functions.expressions)[0]

    const marked = loop({
        values: in.types.kinds.map(value => false)[0],
        index: 0
    }, {
        while: state => state.index < tables.length,
        next: state => {
            const expressions = tables[state.index]

            state.values = loop({
                values: state.values,
                node: 0
            }, {
                while: row => row.node < expressions.kinds.length,
                next: row => {
                    if (
                        expressions.kinds[row.node] == ExpressionKind.ListOperation
                    ) {
                        const payload = integers.widen(expressions.payloads[row.node])
                        const operation = expressions.collection_kinds[payload]
                        const target =
                            integers.widen(
                                expressions.collection_targets[payload]
                            )

                        const is_push = operation == CollectionKind.Push

                        const is_concat = operation == CollectionKind.Concat

                        if (is_push || is_concat) {
                            const target_kind = expressions.kinds[target]

                            if (target_kind == ExpressionKind.Index) {
                                const indexed = integers.widen(
                                    expressions
                                        .index_targets[
                                            integers.widen(
                                                expressions.payloads[target]
                                            )
                                        ]
                                )

                                row
                                    .values[integers.widen(
                                        expressions.types[indexed]
                                    )] = true
                            }
                        }
                    }

                    row.node += 1
                },
                return: state => state.values
            })
            state.index += 1
        },
        return: state => state.values
    })

    const loop_initial = {
        values: marked,
        index: 0
    }

    const readonly_types = in.types

    return loop(loop_initial, {
        while: state => state.index < readonly_types.kinds.length,
        next: state => {
            if (kind(readonly_types.kinds[state.index]) == Kind.List) {
                const child = integers.widen(readonly_types.first[state.index])

                state.values[state.index] = state.values[state.index] ||
                    (
                        kind(readonly_types.kinds[child]) == Kind.List &&
                            state.values[child]
                    )
            }

            state.index += 1
        },
        return: state => state.values
    })
}
