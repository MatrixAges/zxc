import integers from "std:integer"
import {
    CollectionKind,
    TransformKind,
    ExpressionKind
} from "core/expression_table/kinds"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import fresh from "./fresh"

import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    records: bool[],
    visible: bool[],
    expressions: Expressions,
    roots: u32[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const collections = loop({
        types: in.types,
        records: in.records,
        expressions: in.expressions,
        roots: in.roots,
        index: 0
    }, {
        while: current => current.index < current.expressions.collection_kinds.length,
        next: current => {
            const expressions = current.expressions
            const operation = expressions.collection_kinds[current.index]
            const target =
                integers.widen(expressions.collection_targets[current.index])

            const list = integers.widen(expressions.types[target])

            const child =
                current.types.first[list]
            const index = integers.widen(child)

            const not_pop = operation != CollectionKind.Pop

            const object_type = match {
                not_pop && current.records[index] =>
                    kind(current.types.kinds[index]) == Kind.Object,
                _ => false
            }

            if (object_type) {
                const first =
                    integers.widen(expressions.collection_first[current.index])
                const reused = operation != CollectionKind.Push || !fresh({
                    expressions,
                    id: expressions.collection_arguments[first]
                })

                if (reused) {
                    current.roots = current.roots.push(child)[0]
                }
            }

            current.index += 1
        },
        return: state => state.roots
    })

    const updates = loop({
        types: in.types,
        records: in.records,
        expressions: in.expressions,
        roots: collections,
        index: 0
    }, {
        while: current => current.index < current.expressions.update_targets.length,
        next: current => {
            const target =
                integers.widen(current.expressions.update_targets[current.index])

            const list = integers.widen(current.expressions.types[target])

            const child =
                current.types.first[list]
            const index = integers.widen(child)

            const object_type = match {
                current.records[index] =>
                    kind(current.types.kinds[index]) == Kind.Object,
                _ => false
            }

            if (object_type && !fresh({
                expressions: current.expressions,
                id: current.expressions.update_values[current.index]
            })) {
                current.roots = current.roots.push(child)[0]
            }

            current.index += 1
        },
        return: state => state.roots
    })

    const transforms = loop({
        types: in.types,
        records: in.records,
        expressions: in.expressions,
        roots: updates,
        index: 0
    }, {
        while: current => current.index < current.expressions.transform_kinds.length,
        next: current => {
            const expressions = current.expressions
            const operation = expressions.transform_kinds[current.index]
            const target = integers.widen(
                expressions.transform_targets[current.index]
            )

            const list = integers.widen(expressions.types[target])
            const body = expressions.transform_bodies[current.index]
            const child = match {
                operation == TransformKind.Map =>
                    expressions.types[integers.widen(body)],
                _ => current.types.first[list]
            }
            const index = integers.widen(child)

            if (
                current.records[index] &&
                    kind(current.types.kinds[index]) == Kind.Object
            ) {
                const is_filter = operation == TransformKind.Filter

                const valid_operation =
                    operation == TransformKind.Sort && in.visible[index]

                const reused = match {
                    is_filter || valid_operation => true,
                    operation == TransformKind.Map => !fresh({
                        expressions,
                        id: body
                    }),
                    _ => false
                }

                if (reused) {
                    current.roots = current.roots.push(child)[0]
                }
            }

            current.index += 1
        },
        return: state => state.roots
    })

    return loop({
        roots: transforms,
        index: 0
    }, {
        while: current => current.index < in.expressions.kinds.length,
        next: current => {
            const expressions = in.expressions

            if (expressions.kinds[current.index] == ExpressionKind.List) {
                const list = integers.widen(expressions.types[current.index])
                const child = in.types.first[list]
                const index = integers.widen(child)
                const record =
                    in.records[index] && kind(in.types.kinds[index]) == Kind.Object

                if (record) {
                    const payload =
                        integers.widen(expressions.payloads[current.index])
                    const first = integers.widen(expressions.sequence_first[payload])
                    const end =
                        first + integers.widen(expressions.sequence_count[payload])
                    const reused = loop({
                        index: first,
                        found: false
                    }, {
                        while: item => !item.found && item.index < end,
                        next: item => {
                            item.found = !fresh({
                                expressions,
                                id: expressions.sequence_items[item.index]
                            })
                            item.index += 1
                        },
                        return: item => item.found
                    })

                    if (reused) {
                        current.roots = current.roots.push(child)[0]
                    }
                }
            }

            current.index += 1
        },
        return: current => current.roots
    })
}
