<Module>
    <Type from="../model" as="Model" />

    <Args
        in={{
            program: Model.Program,
            roots: Model.Boundaries,
            local: bool[],
            boxed: bool[]
        }}
        out={bool[]}
    />

    <Call
        fn="public_inputs"
        in={{
            types: $in.program.types,
            source: $in.roots
        }}
    />

    <Call
        fn="boundaries"
        in={{
            program: $in.program,
            roots: $ctx.public_inputs,
            local: $in.local
        }}
    />

    <Call
        fn="../types/closure"
        in={{
            types: $in.program.types,
            boxed: $in.boxed,
            roots: $ctx.boundaries
        }}
    />

    <Return value={$ctx.closure} />
</Module>
