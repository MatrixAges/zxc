import integers from "std:integer"
import { ExpressionKind, BinaryOperator } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = Expressions

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        expressions: in,
        index: 0,
        types: empty
    }, {
        while: current => current.index < current.expressions.kinds.length,
        next: current => {
            if (
                current.expressions.kinds[current.index] == ExpressionKind.Binary
            ) {
                const payload =
                    integers.widen(
                        current.expressions.payloads[current.index]
                    )
                const operator = current.expressions.binary_operators[payload]
                const left =
                    integers.widen(
                        current.expressions.binary_left[payload]
                    )
                const right =
                    integers.widen(
                        current.expressions.binary_right[payload]
                    )

                const condition = (
                    - operator == BinaryOperator.Equal
                    - or operator == BinaryOperator.NotEqual
                    - and current.expressions.kinds[left] != ExpressionKind.None
                    - and current.expressions.kinds[right] != ExpressionKind.None
                )

                if (condition) {
                    current.types =
                        current.types.concat(
                            [
                                current.expressions.types[left],
                                current.expressions.types[right]
                            ]
                        )[0]
                }
            }

            current.index += 1
        },
        return: state => state.types
    })
}
