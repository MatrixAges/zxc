import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    built: bool[],
    boxed: bool[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const carriers: bool[] = []

    return loop({
        built: in.built,
        carriers,
        index: 0
    }, {
        while: state => state.index < in.types.kinds.length,
        next: state => {
            const target = kind(in.types.kinds[state.index])
            const first = integers.widen(in.types.first[state.index])
            const row = match target {
                Kind.List =>
                    kind(in.types.kinds[first]) == Kind.Object && !in.boxed[first],
                _ => false
            }

            if (row) {
                state.built = state.built.with(first, true)
            }

            const nested_initial = {
                index: first,
                found: false
            }

            const nested_scope = {
                types: in.types,
                carriers: state.carriers,
                object: target == Kind.Object,
                product: target == Kind.Object || target == Kind.Tuple,
                end: first + integers.widen(in.types.second[state.index])
            }

            const nested = loop(nested_initial, {
                while: fields => nested_scope.product && !fields.found &&
                    fields.index < nested_scope.end,
                next: fields => {
                    const id = match {
                        nested_scope.object =>
                            nested_scope.types.field_types[fields.index],
                        _ => nested_scope.types.children[fields.index]
                    }
                    const child = integers.widen(id)

                    fields.found = nested_scope.carriers[child]
                    fields.index += 1
                },
                return: fields => fields.found
            })

            const carrier = match target {
                Kind.List => row || state.carriers[first],
                Kind.Optional => state.carriers[first],
                Kind.Object => nested,
                Kind.Tuple => nested,
                _ => false
            }

            state.carriers = state.carriers.push(carrier)[0]

            if (target == Kind.Object && carrier) {
                state.built = state.built.with(state.index, true)
            }

            state.index += 1
        },
        return: state => state.built
    })
}
