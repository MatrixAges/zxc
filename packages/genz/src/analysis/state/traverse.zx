import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import children from "../types/children"
import closure from "../types/closure"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    boxed: bool[],
    seen: u64[],
    generation: u64,
    root: u32
}

export type Output = {
    boxed: bool[],
    seen: u64[]
}

export default function (in: Input): Output {
    const root = integers.widen(in.root)
    const target = kind(in.types.kinds[root])

    if (
        in.boxed[root] || (
            target != Kind.Object && target != Kind.Tuple && target != Kind.Optional
        )
    ) {
        return {
            boxed: in.boxed,
            seen: in.seen
        }
    }

    const stack: u32[] = [in.root]

    const result = loop({
        types: in.types,
        boxed: in.boxed,
        seen: in.seen,
        generation: in.generation,
        stack
    }, {
        while: current => current.stack.length != 0,
        next: current => {
            const id = current.stack[current.stack.length - 1]
            const index = integers.widen(id)
            const target = kind(current.types.kinds[index])

            current.stack = current.stack.pop()[0]

            if (!current.boxed[index]) {
                const aggregate = target == Kind.Object || target == Kind.Tuple

                if (aggregate && current.seen[index] == current.generation) {
                    current.boxed = closure({
                        types: current.types,
                        boxed: current.boxed,
                        roots: [id]
                    })
                } else {
                    if (aggregate) {
                        current.seen[index] = current.generation
                    }

                    const next = children({
                        types: current.types,
                        id,
                        deep: false
                    })

                    current.stack = loop({
                        stack: current.stack,
                        next,
                        remaining: next.length
                    }, {
                        while: pending => pending.remaining != 0,
                        next: pending => {
                            pending.remaining -= 1
                            pending.stack =
                                pending.stack.push(
                                    pending.next[pending.remaining]
                                )[0]
                        }
                    }).stack
                }
            }
        }
    })

    return {
        boxed: result.boxed,
        seen: result.seen
    }
}
