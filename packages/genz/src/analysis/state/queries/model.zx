import type { Table } from "core/type_table/model"

export enum Query {
    Plain,
    Represented,
    Nested,
    RepresentedNested,
    InlineRows,
    RepresentedRows,
    NestedRows,
    RepresentedNestedRows
}

export enum Property { Represented, Nested, InlineRows }

export type Input = {
    types: Table,
    selected: bool[]
}

export type Lookup = {
    value: Query,
    property: Property
}
