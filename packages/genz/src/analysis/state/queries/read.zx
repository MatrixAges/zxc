import { Query, Property } from "./model"

import type { Lookup as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return match in.property {
        Property.Represented => (
            match in.value {
                Query.Represented => true,
                Query.RepresentedNested => true,
                Query.RepresentedRows => true,
                Query.RepresentedNestedRows => true,
                _ => false
            }
        ),
        Property.Nested => (
            match in.value {
                Query.Nested => true,
                Query.RepresentedNested => true,
                Query.NestedRows => true,
                Query.RepresentedNestedRows => true,
                _ => false
            }
        ),
        _ => (
            match in.value {
                Query.InlineRows => true,
                Query.RepresentedRows => true,
                Query.NestedRows => true,
                Query.RepresentedNestedRows => true,
                _ => false
            }
        )
    }
}
