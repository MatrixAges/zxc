import { Query, Property } from "./model"

import type { Lookup as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return match in.property {
        Property.Represented => (
            - in.value == Query.Represented
            - or in.value == Query.RepresentedNested
            - or in.value == Query.RepresentedRows
            - or in.value == Query.RepresentedNestedRows
        ),
        Property.Nested => (
            - in.value == Query.Nested
            - or in.value == Query.RepresentedNested
            - or in.value == Query.NestedRows
            - or in.value == Query.RepresentedNestedRows
        ),
        _ => (
            - in.value == Query.InlineRows
            - or in.value == Query.RepresentedRows
            - or in.value == Query.NestedRows
            - or in.value == Query.RepresentedNestedRows
        )
    }
}
