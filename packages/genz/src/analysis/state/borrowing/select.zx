import integers from "std:integer"
import { scalar_string, scalar_void } from "core/type_table/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import { minimum_words, list_words, string_words } from "./const"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    boxed: bool[],
    counts: u32[],
    escaped: bool[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const words: u64[] = []
    const chosen: bool[] = []
    const managed: bool[] = []

    return loop({
        words,
        chosen,
        managed,
        index: 0
    }, {
        while: state => state.index < in.types.kinds.length,
        next: state => {
            const index = state.index
            const target = kind(in.types.kinds[index])
            const first = integers.widen(in.types.first[index])
            const count = integers.widen(in.types.second[index])
            const aggregate = target == Kind.Object || target == Kind.Tuple

            const fields_initial = {
                words: state.words,
                managed: state.managed,
                index: first,
                total: 1,
                nested: false
            }

            const fields_scope = {
                types: in.types,
                object: target == Kind.Object,
                aggregate: aggregate && !in.boxed[index],
                end: first + count
            }

            const fields = loop(fields_initial, {
                while: fields =>
                    fields_scope.aggregate && fields.index < fields_scope.end,
                next: fields => {
                    const child = match {
                        fields_scope.object =>
                            fields_scope.types.field_types[fields.index],
                        _ => fields_scope.types.children[fields.index]
                    }

                    fields.total += fields.words[integers.widen(child)]
                    fields.nested = fields.nested ||
                        fields.managed[integers.widen(child)]
                    fields.index += 1
                }
            })

            const width = match {
                target == Kind.Optional => state.words[first] + 1,
                target == Kind.List => list_words,
                aggregate && !in.boxed[index] => fields.total,
                target == Kind.Scalar && first == integers.widen(scalar_string) =>
                    string_words,
                target == Kind.Scalar && first == integers.widen(scalar_void) => 0,
                _ => 1
            }

            const nested = match {
                target == Kind.Optional => state.managed[first],
                target == Kind.List => true,
                aggregate && !in.boxed[index] => fields.nested,
                _ => false
            }

            const borrowed =
                (
                    - target == Kind.Object
                    - and !in.boxed[index]
                    - and !in.escaped[index]
                    - and in.counts[index] == 1
                    - and nested
                    - and width >= minimum_words
                )

            state.chosen = state.chosen.push(borrowed)[0]
            state.words = state.words.push(borrowed ? 1 : width)[0]
            state.managed = state.managed.push(nested)[0]
            state.index += 1
        },
        return: state => state.chosen
    })
}
