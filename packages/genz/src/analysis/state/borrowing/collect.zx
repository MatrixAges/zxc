import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import scan from "./scan"

import type { Program } from "../../model"
import type { Output } from "./scan"

export type Input = {
    program: Program,
    boxed: bool[]
}

export default function (in: Input): Output {
    const counts: u32[] = in.program.types.kinds.map(kind => 0)[0]

    const roots_initial = {
        roots:
            [in.program.output_type].concat(in.program.functions.output_types)[0],
        index: 0
    }

    const readonly_program = in.program

    const roots = loop(roots_initial, {
        while: state => state.index < readonly_program.types.kinds.length,
        next: state => {
            const target = kind(readonly_program.types.kinds[state.index])

            if (target == Kind.List || target == Kind.Task) {
                state.roots =
                    state.roots.push(readonly_program.types.first[state.index])[0]
            }

            state.index += 1
        },
        return: state => state.roots
    })

    const own = scan({
        tables:
            [in.program.expressions].concat(in.program.contracts.expressions)[0],
        boxed: in.boxed,
        counts,
        roots
    })

    return loop({
        counts: own.counts,
        roots: own.roots,
        index: 0
    }, {
        while: state =>
            state.index < in.program.functions.expressions.length,
        next: state => {
            const functions = in.program.functions

            const result = scan({
                tables: [functions.expressions[state.index]].concat(
                    functions.contracts[state.index].expressions
                )[0],
                boxed: in.boxed,
                counts: state.counts,
                roots: state.roots
            })

            state.counts = result.counts
            state.roots = result.roots
            state.index += 1
        },
        return: state => state.pick([
            "counts",
            "roots"
        ])
    })
}
