import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import scan from "./scan"

import type { Program } from "../../model"
import type { Output } from "./scan"

export type Input = {
    program: Program,
    boxed: bool[]
}

export default function (in: Input): Output {
    const counts: u32[] = in.program.types.kinds.map(kind => 0)[0]

    const roots = loop({
        roots:
            [in.program.output_type].concat(in.program.functions.output_types)[0],
        index: 0
    }, {
        while: (state, source) => state.index < source.types.kinds.length,
        next: (state, source) => {
            const target = kind(source.types.kinds[state.index])

            if (target == Kind.List || target == Kind.Task) {
                state.roots = state.roots.push(source.types.first[state.index])[0]
            }

            state.index += 1
        }
    }, in.program).roots

    const own = scan({
        tables:
            [in.program.expressions].concat(in.program.contracts.expressions)[0],
        boxed: in.boxed,
        counts,
        roots
    })

    return loop({
        counts: own.counts,
        roots: own.roots,
        index: 0
    }, {
        while: (state, source) =>
            state.index < source.program.functions.expressions.length,
        next: (state, source) => {
            const functions = source.program.functions

            const result = scan({
                tables: [functions.expressions[state.index]].concat(
                    functions.contracts[state.index].expressions
                )[0],
                boxed: source.boxed,
                counts: state.counts,
                roots: state.roots
            })

            state.counts = result.counts
            state.roots = result.roots
            state.index += 1
        }
    }, in).pick([
        "counts",
        "roots"
    ])
}
