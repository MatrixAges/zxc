import { state_key_size } from "./const"

export type Input = {
    keys: u8[],
    bytes: u8[],
    id: u64
}

export type Output = u8[]

export default function (in: Input): Output {
    return loop({
        keys: in.keys,
        bytes: in.bytes,
        position: in.id * state_key_size,
        end: in.id * state_key_size + state_key_size
    }, {
        while: current => current.position < current.end,
        next: current => {
            current.bytes =
                current.bytes.push(current.keys[current.position])[0]
            current.position += 1
        }
    })
        -> _.bytes
}
