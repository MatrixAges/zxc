import initialize from "../../../../../ast/context/initialize"

import type { Output } from "./model"

export type Input = u64

export default function (in: Input): Output {
    const context = initialize({
        capture: null,
        expression_base: 0,
        statement_base: 0,
        field_base: 0,
        serial: in
    })

    return {
        segments: [],
        statements: context.statements,
        body: context.statements,
        storage: context.statements,
        variables: context.variables,
        declaration: null,
        serial: in,
        valid: false
    }
}
