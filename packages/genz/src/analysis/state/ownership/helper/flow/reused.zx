import empty from "../../../../../ast/statements/empty"

import type { Reused as Input, Output } from "./model"

export default function (in: Input): Output {
    const statements = empty({})

    return {
        segments: [{
            expressions: in.invocation.state.expressions,
            forms: in.invocation.state.forms,
            borrow_text: true
        }],
        statements,
        body: in.invocation.state.statements,
        storage: statements,
        variables: in.invocation.state.variables,
        declaration: null,
        serial: in.serial,
        valid: in.invocation.state.valid
    }
}
