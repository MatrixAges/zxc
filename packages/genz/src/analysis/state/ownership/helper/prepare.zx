import bytes from "std:bytes"

import identifier from "../../../../ast/context/identifier"
import initialize from "../../../../ast/context/initialize"
import { helper_parameter } from "../const"

import type { Preparation as Input, Prepared as Output } from "./model"

export default function (in: Input): Output {
    const context = initialize({
        capture: null,
        expression_base: in.expression_base,
        statement_base: 0,
        field_base: 0,
        serial: 0
    })

    const value = identifier({
        state: context,
        name: bytes.fromText(helper_parameter)
    })

    return {
        expressions: value.state.expressions,
        forms: value.state.forms,
        root: value.id,
        valid: value.state.valid
    }
}
