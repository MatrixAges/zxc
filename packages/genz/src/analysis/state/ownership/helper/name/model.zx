import type { Sha256State } from "std:crypto"
import type { Eligibility } from "../../model"

export type Input = {
    hash: Sha256State,
    state_name: u8[],
    source: Eligibility,
    count: u32
}

export type Slots = {
    hash: Sha256State,
    source: Eligibility,
    count: u32
}

export type Seed = {
    hash: Sha256State,
    state_name: u8[]
}

export type Output = string
