<Module>
    <Type from="model" as="Name" />

    <Args in={Name.Input} out={Name.Output} />

    <Call
        fn="../../../../types/state/name"
        in={$in.pick([
            "names",
            "index",
            "key"
        ])}
    />

    <Call
        fn="seed"
        in={{
            hash: $in.hash,
            state_name: $ctx.name
        }}
    />

    <Call
        fn="slots"
        in={{
            hash: $ctx.seed,
            ...$in.pick([
                "source",
                "count"
            ])
        }}
    />

    <Call fn="format" in={$ctx.slots} />

    <Return value={$ctx.format} />
</Module>
