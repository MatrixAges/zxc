import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import { minimum_outline_writes } from "./const"
import leaves from "./leaves"

import type { Outline as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const row = integers.widen(in.source.type_id)

    if (kind(in.source.facts.types.kinds[row]) == Kind.Optional) {
        return false
    }

    const writes = leaves(in)

    if (writes == null) {
        return false
    }

    return writes >= minimum_outline_writes
}
