import integers from "std:integer"

import { bits_per_word } from "../../uniqueness/flow/body/const"

import type { Eligibility as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.node)

    if (index + 1 >= in.first.length) {
        return false
    }

    const first = in.first[index]
    const end = in.first[index + 1]
    const base = in.first[0]

    if (in.slot >= end - first) {
        return false
    }

    const bit = integers.widen(first - base + in.slot)
    const word = bit / bits_per_word

    return word < in.transfers.length &&
        integers.andBits(
            in.transfers[word],
            integers.bitMask(bit % bits_per_word)
        ) != 0
}
