import { max_u32 } from "core/const"

import type { Outline as Input } from "../model"
import type { Append as Output } from "./model"

export default function (in: Input): Output {
    return {
        source: in,
        plan: {
            types: [],
            parents: [],
            names: [],
            kinds: [],
            events: [],
            entering: []
        },
        parent: max_u32,
        name: []
    }
}
