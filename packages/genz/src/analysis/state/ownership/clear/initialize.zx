import initialize from "../../../../ast/context/initialize"

import type { Body } from "../../../../ast/body/model"
import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const values: u32[] = in.plan.types.map(type_id => 0)[0]

    const bodies: Body[] = in.plan.types.map(type_id => ({
        tags: [],
        offsets: []
    }))[0]

    return {
        context: initialize({
            capture: null,
            expression_base: in.expression_base,
            statement_base: in.statement_base,
            field_base: 0,
            serial: in.serial
        }),
        body: {
            tags: [],
            offsets: []
        },
        storage: {
            tags: [],
            offsets: []
        },
        values,
        targets: values,
        bodies,
        index: 0
    }
}
