import failed from "../helper/flow/failed"

import type { Failure as Input, Output } from "./model"

export default function (in: Input): Output {
    const result = failed(in.serial)

    const body = {
        statements: result.body,
        variables: result.variables,
        borrow_text: true
    }

    return {
        result,
        binding: body,
        body,
        root: in.value
    }
}
