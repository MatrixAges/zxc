import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import shared from "../value/shares_aggregate"
import constructed from "./constructed"

import type { Program } from "../model"

export type Input = Program

export type Output = bool[]

export default function (in: Input): Output {
    const own = constructed({
        built: in.types.kinds.map(kind => false)[0],
        tables: [in.expressions].concat(in.contracts.expressions)[0]
    })

    const built = loop({
        functions: in.functions,
        built: own,
        index: 0
    }, {
        while: current => current.index < current.functions.expressions.length,
        next: current => {
            const tables =
                [current.functions.expressions[current.index]].concat(
                    current.functions.contracts[current.index].expressions
                )[0]

            current.built = constructed({
                built: current.built,
                tables
            })

            current.index += 1
        },
        return: state => state.built
    })

    return loop({
        built,
        index: 0
    }, {
        while: state => state.index < in.functions.input_types.length,
        next: state => {
            const input = in.functions.input_types[state.index]
            const row = integers.widen(input)
            const native_modules = in.functions.native_modules
            const index = state.index
            const local_input = (
                - native_modules[index] == null
                - and !state.built[row]
            )

            if (local_input) {
                const target = kind(in.types.kinds[row])

                if (target == Kind.Object && shared({
                    types: in.types,
                    input,
                    output: in.functions.output_types[state.index]
                })) {
                    state.built = state.built.with(row, true)
                }
            }

            state.index += 1
        },
        return: state => state.built
    })
}
