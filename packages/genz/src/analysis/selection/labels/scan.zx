import integers from "std:integer"

import visit from "./visit"

import type { Scan as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    if (in.source.subject == null) {
        return false
    }

    const type_id = in.source.expressions.types[integers.widen(in.source.subject)]

    return loop(in.state, {
        while: state => state.valid && state.index < in.source.conditions.length,
        next: state => {
            state = visit({
                scan: {
                    source: in.source,
                    state
                },
                id: in.source.conditions[state.index],
                type_id
            })
            state.index += 1
        },
        return: state => state.valid
    })
}
