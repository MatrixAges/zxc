export const minimum_labels: u64 = 2

export const dense_key_limit: u64 = 256

export const dense_word_bits: u64 = 64

export const dense_word_count: u64 = dense_key_limit / dense_word_bits

export const initial_capacity: u64 = 16

export const capacity_growth: u64 = 2

export const load_factor: u64 = 2
