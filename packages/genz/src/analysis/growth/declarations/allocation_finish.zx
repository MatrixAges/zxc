import textBytes from "std:bytes"
import integers from "std:integer"

import makeBuiltin from "../../../ast/context/builtin"
import makeDereference from "../../../ast/context/dereference"
import makeField from "../../../ast/context/field"
import makeIdentifier from "../../../ast/context/identifier"
import makeObject from "../../../ast/context/object"
import makeSlice from "../../../ast/context/slice"
import makeAppendField from "../../../ast/fields/append"
import makeAssignment from "../../../ast/statements/builder/assignment"
import makeEvaluate from "../../../ast/statements/builder/evaluate"
import makeResult from "../../../ast/statements/builder/result"
import { ExpressionsBuiltinName as F } from "../../../printer/model/expressions"
import { length_member } from "../const"
import makeComplete from "./complete"
import { capacity_name, committed_name, data_name, fresh_name } from "./const"
import { Method } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const capacity = makeIdentifier({
        state: in.context,
        name: textBytes.fromText(capacity_name),
    })

    const first = integers.narrow(in.fields.name.length)

    const capacity_field = makeAppendField({
        table: in.fields,
        name: textBytes.fromText(capacity_name),
        value: capacity.id,
        comptime_parameter: false
    })

    const committed_field = makeAppendField({
        table: capacity_field,
        name: textBytes.fromText(committed_name),
        value: in.symbols.count,
        comptime_parameter: false
    })

    const header_value = makeObject({
        state: capacity.state,
        first: in.context.source.field_base + first,
        count: 2,
    })

    const fresh = makeIdentifier({
        state: header_value.state,
        name: textBytes.fromText(fresh_name),
    })

    const header_target = makeDereference({
        state: fresh.state,
        value: fresh.id,
    })

    const initialized = makeAssignment({
        state: in.statements,
        target: header_target.id,
        value: header_value.id,
    })

    const data = makeIdentifier({
        state: header_target.state,
        name: textBytes.fromText(data_name),
    })

    const length = makeField({
        state: data.state,
        target: in.symbols.items,
        name: textBytes.fromText(length_member),
    })

    const prefix = makeSlice({
        state: length.state,
        target: data.id,
        end: length.id,
    })

    const copied = makeBuiltin({
        state: prefix.state,
        name: F.Memcpy,
        arguments: [
            prefix.id,
            in.symbols.items
        ],
    })

    const copy = makeEvaluate({
        state: initialized,
        value: copied.id,
        discard: false,
    })

    const buffer = makeSlice({
        state: copied.state,
        target: data.id,
        end: in.symbols.count,
    })

    const result = makeResult({
        state: copy,
        value: buffer.id,
    })

    return makeComplete({
        state: {
            ...in,
            context: buffer.state,
            statements: result,
            fields: committed_field,
        },
        method: Method.Allocate
    })
}
