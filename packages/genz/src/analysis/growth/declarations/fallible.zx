import textBytes from "std:bytes"

import makeConstruct from "../../../ast/expressions/error_union"
import { out_of_memory_name } from "./const"

import type { State, Node as Output } from "./model"

export type Input = {
    state: State,
    payload: u32
}

export default function (in: Input): Output {
    const state = in.state

    const node = makeConstruct({
        table: {
            ...state.context.expressions.pick([
                "tags",
                "offsets"
            ]),
            ...state.extra.pick([
                "error_union_payload",
                "error_union_errors",
                "error_union_inferred"
            ])
        },
        base: state.context.source.expression_base,
        payload: in.payload,
        errors: [textBytes.fromText(out_of_memory_name)],
        inferred: false
    })

    return {
        id: node.id,
        state: {
            ...state,
            context: {
                ...state.context,
                expressions: {
                    ...state.context.expressions,
                    tags: node.table.tags,
                    offsets: node.table.offsets
                },
                valid: state.context.valid && node.valid
            },
            extra: {
                ...state.extra,
                ...node.table.omit([
                    "tags",
                    "offsets"
                ])
            }
        }
    }
}
