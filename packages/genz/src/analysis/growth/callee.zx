import target from "./target"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const value = target({
        context: in.context,
        operation: in.source.operation,
        shared: in.source.shared
    })

    return {
        ...in,
        context: value.state,
        callee: value.id
    }
}
