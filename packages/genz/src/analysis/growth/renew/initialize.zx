import slice from "../../../ast/context/const_slice"
import primitive from "../../../ast/context/primitive"
import { ExpressionsPrimitive } from "../../../printer/model/expressions"
import initialize from "../initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const growth = initialize(in.source)

    const byte = primitive({
        state: growth.context,
        value: ExpressionsPrimitive.U8
    })

    const text = slice({
        state: byte.state,
        value: byte.id
    })

    return {
        source: in,
        growth: {
            ...growth,
            context: text.state
        },
        text: text.id,
        steps: []
    }
}
