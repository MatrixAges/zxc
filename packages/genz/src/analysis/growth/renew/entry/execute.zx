import append from "../append.rx"
import buffered from "../buffered"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const source = in.source

    return loop({
        growth: in.growth,
        applied: false,
        index: 0
    }, {
        while: state => state.index < source.paths.length,
        next: state => {
            const path = source.paths[state.index]
            const type_id = source.type_id
            const types = source.types

            if (!buffered({
                types,
                type_id,
                path,
                inline_lists: source.inline_lists
            })) {
                state.growth = append({
                    source: {
                        types,
                        type_id,
                        path,
                        source: {
                            ...source.source,
                            value: in.value
                        }
                    },
                    growth: state.growth
                })
                state.applied = true
            }

            state.index += 1
        },
        return: state => ({
            ...in,
            ...state.pick([
                "growth",
                "applied"
            ])
        })
    })
}
