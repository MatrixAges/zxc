import type { Table } from "core/type_table/model"
import type { Input as GrowthInput, State as Growth } from "../../model"

export type Input = {
    source: GrowthInput,
    types: Table,
    type_id: u32,
    paths: u32[][],
    skipped: u64[],
    name?: u8[],
    inline_lists: bool
}

export type State = {
    source: Input,
    growth: Growth,
    value: u32,
    applied: bool
}
