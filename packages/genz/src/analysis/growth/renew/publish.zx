import type { State as Growth, Output } from "../model"

export type Input = {
    growth: Growth,
    value: u32,
    applied: bool
}

export default function (in: Input): Output {
    return {
        expressions: in.growth.context.expressions,
        forms: in.growth.context.forms,
        statements: in.growth.context.statements,
        body: in.growth.body,
        root: in.value,
        serial: in.growth.context.serial,
        uses_allocator: in.applied,
        valid: in.growth.context.valid
    }
}
