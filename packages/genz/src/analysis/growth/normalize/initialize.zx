import initialize from "../initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const { context, body } = initialize(in.source)

    return {
        source: in,
        context,
        body,
        value: in.source.value,
        items: in.source.value,
        copied: {
            body,
            value: in.source.value
        },
        root: in.source.value,
        fields: []
    }
}
