import block from "../block"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const result = block({
        state: in.context,
        body: in.copied.body,
        value: in.copied.value
    })

    return {
        ...in,
        context: result.state,
        root: result.id
    }
}
