import bytes from "std:bytes"

import boolean from "../../../ast/context/boolean"
import object from "../../../ast/context/object"
import { Storage } from "../../state/list/const"
import tag from "../../state/list/tag"
import { items_field, storage_field, list_field_count } from "../../types/state/const"

import type { Field } from "../../types/definitions/model"
import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const header = boolean({
        state: in.context,
        value: true
    })

    const unique = boolean({
        state: header.state,
        value: true
    })

    const storage = tag({
        state: unique.state,
        storage: Storage.Exclusive
    })

    const fields: Field[] = [
        {
            name: bytes.fromText(items_field),
            value: in.root,
            default_value: null,
            comptime_parameter: false
        },
        {
            name: bytes.fromText(storage_field),
            value: storage.id,
            default_value: null,
            comptime_parameter: false
        }
    ]

    const result = object({
        state: storage.state,
        type_expr: in.source.layout,
        first: in.source.field_base,
        count: list_field_count
    })

    return {
        ...in,
        context: result.state,
        root: result.id,
        fields
    }
}
