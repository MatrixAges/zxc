import bind from "../bind"

import type { State as Input, Result as Output } from "./model"

export default function (in: Input): Output {
    const result = bind({
        state: in.context,
        body: in.body,
        value: in.root
    })

    return {
        expressions: result.state.expressions,
        forms: result.state.forms,
        statements: result.state.statements,
        body: result.body,
        root: result.id,
        serial: result.state.serial,
        uses_allocator: true,
        valid: result.state.valid
    }
}
