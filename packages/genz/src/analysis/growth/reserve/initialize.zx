import initialize from "../initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const state = initialize(in)

    return {
        source: in,
        context: state.context,
        body: state.body,
        value: in.value,
        items: 0,
        no: {
            body: state.body,
            value: 0
        },
        yes: {
            body: state.body,
            value: 0
        },
        root: in.value
    }
}
