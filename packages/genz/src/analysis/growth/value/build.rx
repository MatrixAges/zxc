<Module>
    <Type from="model" as="Value" />
    <Type from="../model" as="Growth" />

    <Args in={Value.Input} out={Growth.Output} />

    <Call
        fn="../../uniqueness/renewals/range"
        in={{
            keys: $in.records.keys,
            owner: $in.owner,
            value: true
        }}
    />

    <Call fn="initialize" in={$in} />

    <Call
        fn="execute"
        in={{
            initial: $ctx.initialize,
            range: $ctx.range
        }}
    />

    <Call
        fn="../renew/publish"
        in={{
            ...$ctx.execute.pick([
                "growth",
                "applied"
            ]),
            value: $in.source.value
        }}
    />

    <Return value={$ctx.publish} />
</Module>
