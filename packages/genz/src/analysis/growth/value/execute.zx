import append from "../renew/append.rx"
import buffered from "../renew/buffered"

import type { Output as Range } from "../../uniqueness/renewals/range"
import type { State as Output } from "./model"

export type Input = {
    initial: Output,
    range: Range
}

export default function (in: Input): Output {
    const source = in.initial.source

    const result = loop({
        growth: in.initial.growth,
        applied: false,
        index: in.range.first
    }, {
        while: state => state.index < in.range.end,
        next: state => {
            const path = source.records.paths[state.index]

            if (!buffered({
                types: source.types,
                type_id: source.type_id,
                path,
                inline_lists: source.inline_lists
            })) {
                state.growth = append({
                    source: {
                        ...source.pick([
                            "types",
                            "type_id"
                        ]),
                        source: source.source,
                        path
                    },
                    growth: state.growth
                })
                state.applied = true
            }

            state.index += 1
        }
    })

    return {
        ...in.initial,
        growth: result.growth,
        applied: result.applied
    }
}
