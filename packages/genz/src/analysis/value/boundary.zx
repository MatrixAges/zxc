import integers from "std:integer"

import inputLeaf from "../types/input_leaf"
import outputLeaf from "../types/output_leaf"

import type { Program } from "../model"

export type Input = {
    program: Program,
    position: u64,
    borrowed: bool
}

export type Output = bool

export default function (in: Input): Output {
    const functions = in.program.functions
    const types = in.program.types

    const io = functions.native_io
    const process = functions.native_process
    const index = in.position

    const condition = (
        - in.borrowed
        - and (
            io[index] || process[index]
        )
    )

    if (condition) {
        return false
    }

    if (functions.stores[in.position].paths.length != 0 || !outputLeaf({
        types,
        id: functions.output_types[in.position]
    })) {
        return false
    }

    const input = functions.input_types[in.position]

    if (!functions.native_tuples[in.position]) {
        return inputLeaf({
            types,
            id: input,
            borrowed: in.borrowed
        })
    }

    const type_index = integers.widen(input)

    if (types.kinds[type_index] != 4) {
        return false
    }

    return loop({
        types,
        borrowed: in.borrowed,
        position: integers.widen(types.first[type_index]),
        end:
            integers.widen(types.first[type_index]) +
            integers.widen(
                types.second[type_index]
            ),
        valid: true
    }, {
        while: current => current.valid && current.position < current.end,
        next: current => {
            current.valid = inputLeaf({
                types: current.types,
                id: current.types.children[current.position],
                borrowed: current.borrowed
            })
            current.position += 1
        },
        return: state => state.valid
    })
}
