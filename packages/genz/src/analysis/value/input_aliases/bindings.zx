import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Input, Bindings as Output } from "./model"

export default function (in: Input): Output {
    const constants_initial = {
        values: in.names.map(name => max_u32)[0],
        repeated: in.names.map(name => false)[0],
        index: 0
    }

    const readonly_control = in.control

    const constants = loop(constants_initial, {
        while: state => state.index < readonly_control.constant_symbols.length,
        next: state => {
            const symbol =
                integers.widen(readonly_control.constant_symbols[state.index])

            if (state.values[symbol] != max_u32) {
                state.repeated[symbol] = true
            }

            state.values[symbol] = readonly_control.constant_values[state.index]
            state.index += 1
        }
    })

    const scopes_initial = {
        ...constants.pick([
            "values",
            "repeated"
        ]),
        index: 0,
        position: 0,
        end: 0
    }

    const readonly_expressions = in.expressions

    const scopes = loop(scopes_initial, {
        while: state =>
            state.index < readonly_expressions.kinds.length || state.position < state.end,
        next: state => {
            if (state.position < state.end) {
                const symbol = readonly_expressions.scope_symbols[state.position]

                if (symbol != null) {
                    const index = integers.widen(symbol)

                    if (state.values[index] != max_u32) {
                        state.repeated[index] = true
                    }

                    state.values[index] =
                        readonly_expressions.scope_values[state.position]
                }

                state.position += 1
            } else {
                if (
                    readonly_expressions.kinds[state.index] == ExpressionKind.Scope
                ) {
                    const payload =
                        integers.widen(readonly_expressions.payloads[state.index])

                    state.position =
                        integers.widen(readonly_expressions.scope_first[payload])
                    state.end = state.position +
                        integers.widen(readonly_expressions.scope_count[payload])
                }

                state.index += 1
            }
        }
    })

    return scopes.pick([
        "values",
        "repeated"
    ])
}
