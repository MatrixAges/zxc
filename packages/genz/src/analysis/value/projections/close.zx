import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"

import observe from "./observe"

import type { Expressions } from "core/expression_table/model"
import type { State, Output } from "./model"

export type Input = {
    expressions: Expressions,
    state: State
}

export default function (in: Input): Output {
    const loop_initial = {
        state: in.state
    }

    const readonly_expressions = in.expressions

    return loop(loop_initial, {
        while: current => current.state.pending.length != 0,
        next: current => {
            const id = integers.widen(
                current.state.pending[current.state.pending.length - 1]
            )

            current.state.pending = current.state.pending.pop()[0]

            const kind = readonly_expressions.kinds[id]
            const payload = integers.widen(readonly_expressions.payloads[id])

            if (kind == ExpressionKind.Reference) {
                const symbol =
                    integers.widen(readonly_expressions.references[payload])
                const value = current.state.bindings[symbol]

                current.state.projected[symbol] = false

                if (value != max_u32) {
                    current.state = observe({
                        state: current.state,
                        id: value
                    })
                }
            } else if (kind == ExpressionKind.Conditional) {
                current.state = observe({
                    state: observe({
                        state: current.state,
                        id: readonly_expressions.conditional_yes[payload]
                    }),
                    id: readonly_expressions.conditional_no[payload]
                })
            } else if (kind == ExpressionKind.Match) {
                current.state = loop({
                    state: observe({
                        state: current.state,
                        id: readonly_expressions.match_fallbacks[payload]
                    }),
                    position:
                        integers.widen(
                            readonly_expressions.match_first[payload]
                        ),
                    end: integers.widen(
                        readonly_expressions.match_first[payload]
                    ) +
                        integers.widen(
                            readonly_expressions.match_count[payload]
                        )
                }, {
                    while: row => row.position < row.end,
                    next: row => {
                        row.state = observe({
                            state: row.state,
                            id: readonly_expressions.match_results[row.position]
                        })
                        row.position += 1
                    },
                    return: state => state.state
                })
            } else if (kind == ExpressionKind.Scope) {
                current.state = observe({
                    state: current.state,
                    id: readonly_expressions.scope_results[payload]
                })
            }
        },
        return: state => state.state.projected
    })
}
