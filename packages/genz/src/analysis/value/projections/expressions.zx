import integers from "std:integer"
import { max_u32 } from "core/const"
import child from "core/expression_table/child"
import { ExpressionKind } from "core/expression_table/kinds"

import bind from "./bind"
import observe from "./observe"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const pending: u32[] = []

    const loop_initial = {
        state: {
            projected: in.names.map(name => true)[0],
            observed: in.expressions.kinds.map(kind => false)[0],
            bindings: in.names.map(name => max_u32)[0],
            pending
        },
        index: 0
    }

    const readonly_expressions = in.expressions

    return loop(loop_initial, {
        while: current => current.index < readonly_expressions.kinds.length,
        next: current => {
            const kind = readonly_expressions.kinds[current.index]
            const payload =
                integers.widen(readonly_expressions.payloads[current.index])

            if (kind == ExpressionKind.Conditional) {
                current.state = observe({
                    state: current.state,
                    id: readonly_expressions.conditional_conditions[payload]
                })
            } else if (kind == ExpressionKind.Match) {
                const subject = readonly_expressions.match_subjects[payload]

                if (subject != null) {
                    current.state = observe({
                        state: current.state,
                        id: subject
                    })
                }

                current.state = loop({
                    state: current.state,
                    position:
                        integers.widen(
                            readonly_expressions.match_first[payload]
                        ),
                    end: integers.widen(
                        readonly_expressions.match_first[payload]
                    ) +
                        integers.widen(
                            readonly_expressions.match_count[payload]
                        )
                }, {
                    while: row => row.position < row.end,
                    next: row => {
                        row.state = observe({
                            state: row.state,
                            id: readonly_expressions.match_conditions[row.position]
                        })
                        row.position += 1
                    },
                    return: state => state.state
                })
            } else if (kind == ExpressionKind.Scope) {
                current.state = loop({
                    state: observe({
                        state: current.state,
                        id: readonly_expressions.scope_results[payload]
                    }),
                    position:
                        integers.widen(
                            readonly_expressions.scope_first[payload]
                        ),
                    end: integers.widen(
                        readonly_expressions.scope_first[payload]
                    ) +
                        integers.widen(
                            readonly_expressions.scope_count[payload]
                        )
                }, {
                    while: row => row.position < row.end,
                    next: row => {
                        const symbol = readonly_expressions.scope_symbols[row.position]
                        const value = readonly_expressions.scope_values[row.position]

                        row.state = match {
                            symbol == null => observe({
                                state: row.state,
                                id: value
                            }),
                            _ => bind({
                                state: row.state,
                                symbol,
                                value
                            })
                        }
                        row.position += 1
                    },
                    return: state => state.state
                })
            } else {
                const condition = (
                    match kind {
                        ExpressionKind.Field => false,
                        ExpressionKind.TupleField => false,
                        ExpressionKind.Reference => false,
                        _ => true
                    }
                )

                if (condition) {
                    current.state = loop({
                        state: current.state,
                        index: 0,
                        id: current.index,
                        done: false
                    }, {
                        while: row => !row.done,
                        next: row => {
                            const value = child({
                                table: readonly_expressions,
                                id: row.id,
                                index: row.index
                            })

                            if (value == null) {
                                row.done = true
                            } else {
                                row.state = observe({
                                    state: row.state,
                                    id: value
                                })
                                row.index += 1
                            }
                        },
                        return: state => state.state
                    })

                    if (kind == ExpressionKind.Task) {
                        current.state.projected = loop({
                            values: current.state.projected,
                            position:
                                integers.widen(
                                    readonly_expressions.task_capture_first[payload]
                                ),
                            end: integers.widen(
                                readonly_expressions.task_capture_first[payload]
                            ) +
                                integers.widen(
                                    readonly_expressions.task_capture_count[payload]
                                )
                        }, {
                            while: row => row.position < row.end,
                            next: row => {
                                row
                                    .values[integers.widen(
                                        readonly_expressions
                                            .task_captures[row.position]
                                    )] = false
                                row.position += 1
                            },
                            return: state => state.values
                        })
                    }
                }
            }

            current.index += 1
        },
        return: state => state.state
    })
}
