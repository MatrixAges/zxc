import integers from "std:integer"

import type { State } from "./model"

export type Input = {
    state: State,
    id: u32
}

export type Output = State

export default function (in: Input): Output {
    const index = integers.widen(in.id)

    return match {
        in.state.observed[index] => in.state,
        _ => {
            ...in.state,
            observed: in.state.observed.with(index, true),
            pending: in.state.pending.push(in.id)[0]
        }
    }
}
