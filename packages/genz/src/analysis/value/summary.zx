import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import { Property } from "../state/queries/model"
import query from "../state/queries/read"
import purity from "./pure"

import type { Program, Values } from "../model"
import type { Query } from "../state/queries/model"

export type Input = {
    program: Program,
    queries: Query[],
    local: bool[]
}

export type Output = Values

export default function (in: Input): Output {
    const values = in.program.functions.output_types.map(id => false)[0]

    const result = loop({
        program: in.program,
        queries: in.queries,
        local: in.local,
        values,
        index: 0
    }, {
        while: current =>
            current.index < current.program.functions.output_types.length,
        next: current => {
            const index = current.index
            const functions = current.program.functions
            const output = functions.output_types[index]
            const input = functions.input_types[index]

            const object =
                kind(current.program.types.kinds[integers.widen(
                    output
                )]) == Kind.Object
            const output_state = query({
                value: current.queries[integers.widen(output)],
                property: Property.Represented
            })
            const input_state = query({
                value: current.queries[integers.widen(input)],
                property: Property.Represented
            })
            const inline_rows = query({
                value: current.queries[integers.widen(input)],
                property: Property.InlineRows
            })
            const represented = output_state || input_state || inline_rows
            const native = functions.native_modules[index] != null
            const state = !native && represented

            current.values[index] = current.local[index] && (object || state)
            current.index += 1
        }
    })

    return {
        pure: purity({
            program: in.program
        }),
        local: result.local,
        values: result.values
    }
}
