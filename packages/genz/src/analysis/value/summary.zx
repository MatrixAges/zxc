import integers from "std:integer"
import { map } from "std:utils"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import body from "../calls/body"
import parallel from "../control/parallel"
import represented from "../types/represented"
import boundary from "./boundary"
import purity from "./pure"

import type { Program, Values } from "../model"

export type Input = {
    program: Program,
    selected: bool[]
}

export type Output = Values

export default function (in: Input): Output {
    const local = map(in.program.functions.output_types, id => false)
    const values = map(in.program.functions.output_types, id => false)

    const result = loop({
        program: in.program,
        selected: in.selected,
        local: local,
        values: values,
        index: 0
    }, {
        while: current =>
            current.index < current.program.functions.output_types.length,
        next: current => {
            const index = current.index
            const functions = current.program.functions

            if (functions.native_modules[index] != null) {
                current.local[index] = boundary({
                    program: current.program,
                    position: index,
                    borrowed: true
                })
            } else {
                const plain =
                    functions.stores[index].paths.length == 0 && !parallel({
                        control: functions.control[index],
                        root: functions.roots[index]
                    })

                current.local[index] = plain && body({
                    expressions: functions.expressions[index],
                    contracts: functions.contracts[index],
                    allowed: current.local,
                    limit: index
                })
            }

            const output = functions.output_types[index]

            const object =
                kind(current.program.types.kinds[integers.widen(
                    output
                )]) == Kind.Object
            const state = functions.native_modules[index] == null && represented({
                types: current.program.types,
                selected: current.selected,
                id: output
            })

            current.values[index] = current.local[index] && (object || state)
            current.index += 1
        }
    })

    return {
        pure: purity({
            program: in.program
        }),
        local: result.local,
        values: result.values
    }
}
