import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import contains from "../types/contains"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    input: u32,
    output: u32
}

export type Output = bool

export default function shared(in: Input): Output {
    const index = integers.widen(in.input)
    const target = kind(in.types.kinds[index])
    const product = target == Kind.Object || target == Kind.Tuple

    if (product) {
        if (contains({
            types: in.types,
            parent: in.output,
            root: in.input
        })) {
            return true
        }
    }

    if (target == Kind.Optional || target == Kind.List) {
        return shared({
            ...in,
            input: in.types.first[index]
        })
    }

    if (!product) {
        return false
    }

    const loop_initial = {
        index: 0,
        found: false
    }

    const loop_scope = {
        ...in,
        index,
        target
    }

    return loop(loop_initial, {
        while: state => !state.found &&
            state.index < integers.widen(loop_scope.types.second[loop_scope.index]),
        next: state => {
            const position =
                integers.widen(loop_scope.types.first[loop_scope.index]) + state.index
            const input = match {
                loop_scope.target == Kind.Object =>
                    loop_scope.types.field_types[position],
                _ => loop_scope.types.children[position]
            }

            state.found = shared({
                types: loop_scope.types,
                input,
                output: loop_scope.output
            })
            state.index += 1
        },
        return: state => state.found
    })
}
