import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import scalar from "core/type_table/scalar"

import { maximum_result_fields } from "./const"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    type_id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const type_id_initial = {
        type_id: in.type_id
    }

    const readonly_types = in.types

    const type_id = loop(type_id_initial, {
        while: current =>
            kind(readonly_types.kinds[integers.widen(current.type_id)]) == Kind.Optional,
        next: current => {
            current.type_id = readonly_types.first[integers.widen(current.type_id)]
        },
        return: state => state.type_id
    })

    const row = integers.widen(type_id)
    const count = in.types.second[row]

    if (
        kind(in.types.kinds[row]) != Kind.Object || count > maximum_result_fields
    ) {
        return false
    }

    const loop_initial = {
        index: 0,
        valid: true
    }

    const loop_scope = {
        types: in.types,
        first: integers.widen(in.types.first[row]),
        count: integers.widen(count)
    }

    return loop(loop_initial, {
        while: current => current.valid && current.index < loop_scope.count,
        next: current => {
            current.valid = scalar({
                kinds: loop_scope.types.kinds,
                first: loop_scope.types.first,
                type_id: loop_scope.types.field_types[loop_scope.first +
                    current.index]
            })
            current.index += 1
        },
        return: state => state.valid
    })
}
