import identifier from "../../../../ast/context/identifier"
import initialize from "../../../../ast/context/initialize"

import type { Input as Bases } from "../../../../ast/context/model"
import type { Columns as Expressions } from "../../../../ast/expressions/model"
import type { Columns as Fields } from "../../../../ast/fields/model"

export type Input = {
    parameters: Fields,
    input_type: u32,
    bases: Bases
}

export type Output = {
    expressions: Expressions,
    parameters: Fields,
    arguments: u32[],
    valid: bool
}

export default function (in: Input): Output {
    const arguments: u32[] = []

    return loop({
        context: initialize(in.bases),
        arguments,
        index: 0
    }, {
        while: current => current.index < in.parameters.name.length,
        next: current => {
            const value = identifier({
                state: current.context,
                name: in.parameters.name[current.index]
            })

            current.context = value.state
            current.arguments = current.arguments.push(value.id)[0]
            current.index += 1
        },
        return: current => {
            return {
                expressions: current.context.expressions,
                parameters: {
                    ...in.parameters,
                    value: in.parameters.value.with(1, in.input_type)
                },
                arguments: current.arguments,
                valid: current.context.valid
            }
        }
    })
}
