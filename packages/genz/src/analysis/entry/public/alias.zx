import bytes from "std:bytes"

import identifier from "../../../ast/context/identifier"
import initialize from "../../../ast/context/initialize"
import constants from "../../../ast/declarations/constants"
import { allocator_entry_name, state_entry_name, value_entry_name } from "./const"

import type { Input as Bases, Node } from "../../../ast/context/model"
import type { Columns as Declarations } from "../../../ast/declarations/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"

export type Input = {
    state: bool,
    target?: u32,
    bases: Bases
}

export type Output = {
    expressions: Expressions,
    declarations: Declarations,
    valid: bool
}

export default function (in: Input): Output {
    const target = in.target
    const state = initialize(in.bases)

    const reference: Node = match {
        target != null => {
            state,
            id: target
        },
        _ => identifier({
            state,
            name: bytes.fromText(allocator_entry_name)
        })
    }

    const name = in.state ? state_entry_name : value_entry_name

    const declarations = constants({
        base: 0,
        values: [{
            name: bytes.fromText(name),
            value: reference.id,
            exported: true
        }]
    })

    return {
        expressions: reference.state.expressions,
        declarations: declarations.table,
        valid: reference.state.valid && declarations.valid
    }
}
