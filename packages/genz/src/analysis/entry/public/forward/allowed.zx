import integers from "std:integer"

import needed from "../../../state/ownership/needed"
import { normalize_flag, renew_flag } from "../../../uniqueness/function/plan/const"

import type { Facts } from "../../../state/ownership/model"

export type Input = {
    flags: u8[],
    types: u32[],
    ownership: Facts,
    node: u32
}

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.node)

    const flag = match {
        index < in.flags.length => integers.widenByte(in.flags[index]),
        _ => 0
    }

    if (integers.andBits(flag, normalize_flag + renew_flag) != 0) {
        return false
    }

    return !needed({
        facts: in.ownership,
        node: in.node,
        type_id: in.types[index],
        slot: 0
    })
}
