<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={Entry.Flags} />

    <Call fn="effects" in={$in} />

    <If on={$in.stores.paths.length != 0}>
        <Return
            value={{
                ...$ctx.effects,
                inlined: false,
                value: false,
                scalar: false
            }}
        />
    </If>

    <Call
        fn="../control/parallel"
        in={{
            control: $in.control,
            root: $in.root
        }}
    />

    <If on={$ctx.parallel}>
        <Return
            value={{
                ...$ctx.effects,
                inlined: false,
                value: false,
                scalar: false
            }}
        />
    </If>

    <Call fn="eligibility" in={$in} />
    <Call fn="scalar" in={$in} />
    <Call fn="inlined" in={$in} />

    <Call
        fn="flags"
        in={{
            effects: $ctx.effects,
            local: $ctx.eligibility.local,
            pure: $ctx.eligibility.pure,
            scalar: $ctx.scalar,
            inlined: $ctx.inlined
        }}
    />

    <Return value={$ctx.flags} />
</Module>
