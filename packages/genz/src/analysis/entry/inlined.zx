import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import body from "../calls/body"
import primitive from "../types/primitive"
import {
    minimum_record_fields,
    maximum_routing_fields,
    maximum_body_expressions,
    maximum_result_fields,
    maximum_scalar_expressions
} from "./const"
import recordResult from "./record_result"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const owner = in.self_function
    const input = integers.widen(in.input_type)
    const output = integers.widen(in.output_type)

    const has_kinds = in.expressions.kinds.length > maximum_body_expressions

    const condition = (
        - owner == null
        - or in.contracts.kinds.length != 0
        - or has_kinds
    )

    if (condition) {
        return false
    }

    if (kind(in.types.kinds[input]) != Kind.Object) {
        return false
    }

    const wide = in.types.second[input] >= minimum_record_fields

    const scalar = primitive({
        types: in.types,
        id: in.output_type
    })

    if (scalar) {
        if (
            in.types.second[input] > maximum_routing_fields ||
                in.expressions.kinds.length > maximum_scalar_expressions
        ) {
            return false
        }
    } else if (wide) {
        if (
            kind(in.types.kinds[output]) != Kind.Object ||
                in.types.second[output] > maximum_result_fields
        ) {
            return false
        }
    } else if (
        in.types.second[input] > maximum_routing_fields || !recordResult({
            types: in.types,
            type_id: in.output_type
        })
    ) {
        return false
    }

    const bounded = loop({
        index: 0,
        bounded: true,
        cost: in.expressions.kinds.length
    }, {
        while: state => state.bounded &&
            state.index < in.expressions.kinds.length,
        next: state => {
            const expression = in.expressions.kinds[state.index]

            state.bounded = (
                match expression {
                    ExpressionKind.Iteration => false,
                    ExpressionKind.Transform => false,
                    ExpressionKind.Task => false,
                    ExpressionKind.Parallel => false,
                    _ => true
                }
            )

            if (expression == ExpressionKind.Object) {
                const payload = integers.widen(in.expressions.payloads[state.index])
                const fields = integers.widen(in.expressions.object_count[payload])

                if (fields > maximum_body_expressions - state.cost) {
                    state.bounded = false
                } else {
                    state.cost += fields
                }
            }

            state.index += 1
        },
        return: state => state.bounded
    })

    return bounded && body({
        expressions: in.expressions,
        contracts: in.contracts,
        allowed: in.pure,
        limit: owner
    })
}
