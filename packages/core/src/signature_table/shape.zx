import integers from "std:integer"
import { max_u32 } from "core/const"

import type { Table } from "./model"

export type Input = Table

export type Output = bool

export default function (in: Input): Output {
    const index_limit = integers.widen(max_u32)

    const count = in.files.length

    const types_aligned =
        in.input_types.length == count && in.output_types.length == count &&
        in.ownership.length == count

    const same_native_inputs = in.native_inputs.length == count
    const same_native_modules = in.native_modules.length == count
    const same_native_members = in.native_members.length == count
    const same_native_exports = in.native_exports.length == count

    const names_aligned =
        (
            - same_native_inputs
            - and same_native_modules
            - and same_native_members
            - and same_native_exports
        )

    const same_native_allocators = in.native_allocators.length == count
    const same_native_process = in.native_process.length == count
    const same_native_tuples = in.native_tuples.length == count

    const arguments_aligned =
        (
            - same_native_allocators
            - and in.native_io.length == count
            - and same_native_process
            - and same_native_tuples
        )

    const effects_aligned =
        in.native_fallible.length == count && in.native_errors.length == count &&
        in.native_concurrent.length == count

    const condition = (
        - count > index_limit
        - or !types_aligned
        - or !names_aligned
        - or !arguments_aligned
        - or !effects_aligned
    )

    if (condition) {
        return false
    }

    return loop({
        table: in,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.table.files.length,
        next: current => {
            const index = current.index
            const table = current.table

            if (table.native_modules[index] == null) {
                const no_names =
                    table.native_inputs[index] == null &&
                    table.native_members[index].length == 0 &&
                    table.native_exports[index] == null
                const allocators = table.native_allocators
                const io = table.native_io
                const process = table.native_process
                const tuples = table.native_tuples
                const no_arguments = (
                    - !allocators[index]
                    - and !io[index]
                    - and !process[index]
                    - and !tuples[index]
                )
                const no_effects =
                    !table.native_fallible[index] &&
                    table.native_errors[index] == null &&
                    !table.native_concurrent[index]

                current.valid = no_names && no_arguments && no_effects
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
