import find from "./find"

import type { Put as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const result = find({
        ...in.state.pick([
            "metadata",
            "keys"
        ]),
        key: in.key
    })

    if (result.found) {
        return {
            ...in.state,
            values: in.state.values.with(result.slot, in.value)
        }
    }

    return {
        count: in.state.count + 1,
        metadata: in.state.metadata.with(result.slot, result.tag),
        keys: in.state.keys.with(result.slot, in.key),
        values: in.state.values.with(result.slot, in.value)
    }
}
