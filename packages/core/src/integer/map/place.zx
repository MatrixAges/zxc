import find from "./find"
import write from "./write"

import type { Put as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const position = find({
        ...in.state.pick([
            "metadata",
            "keys"
        ]),
        key: in.key
    })

    return write({
        source: in,
        position
    })
}
