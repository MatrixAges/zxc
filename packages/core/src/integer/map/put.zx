import {
    initial_capacity,
    capacity_growth,
    load_numerator,
    load_denominator
} from "./const"
import grow from "./grow"
import place from "./place"

import type { Put as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const capacity = in.state.metadata.length
    const limit = capacity * load_numerator / load_denominator

    const state = match {
        in.state.count + 1 > limit => grow({
            state: in.state,
            capacity: match {
                capacity == 0 => initial_capacity,
                _ => capacity * capacity_growth
            }
        }),
        _ => in.state
    }

    return place({
        ...in,
        state
    })
}
