import lookup from "./lookup"

import type { State } from "./model"

export type Input = {
    state: State,
    keys: u32[]
}

export type Output = u32?[]

export default function (in: Input): Output {
    const state = in.state

    return in.keys.map(key => {
        const slot = lookup({
            ...state.omit(["values"]),
            key
        })

        return match {
            slot == null => null,
            _ => state.values[slot]
        }
    })[0]
}
