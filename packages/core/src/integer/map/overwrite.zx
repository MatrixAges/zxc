import lookup from "./lookup"

import type { Put as Input, State } from "./model"

export type Output = State?

export default function (in: Input): Output {
    const slot = lookup({
        ...in.state.omit(["values"]),
        key: in.key
    })

    if (slot == null) {
        return null
    }

    return {
        count: in.state.count,
        metadata: in.state.metadata,
        keys: in.state.keys,
        values: in.state.values.with(slot, in.value)
    }
}
