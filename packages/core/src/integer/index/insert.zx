import get from "./get"
import insert from "./insert_columns"

import type { Inserted as Output, Key as Input } from "./model"

export default function (in: Input): Output {
    const previous = get(in)

    if (previous != null) {
        return {
            index: in.index,
            position: previous,
            found: true
        }
    }

    const result = insert({
        ...in.index,
        key: in.key
    })

    return {
        index: result.pick([
            "count",
            "keys",
            "buckets"
        ]),
        position: result.position,
        found: result.found
    }
}
