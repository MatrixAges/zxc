import integers from "std:integer"

import { max_u32 } from "../../const"
import probe from "./probe"

export type Input = {
    count: u64,
    keys: u32[],
    capacity: u64
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    const buckets = loop({
        values: empty
    }, {
        while: state => state.values.length < in.capacity,
        next: state => {
            state.values = state.values.push(max_u32)[0]
        },
        return: state => state.values
    })

    return loop({
        buckets,
        position: 0
    }, {
        while: state => state.position < in.count,
        next: state => {
            const key = in.keys[state.position]
            const slot = probe({
                keys: in.keys,
                buckets: state.buckets,
                key
            })

            state.buckets = state.buckets.with(
                slot,
                integers.narrow(state.position)
            )
            state.position += 1
        },
        return: state => state.buckets
    })
}
