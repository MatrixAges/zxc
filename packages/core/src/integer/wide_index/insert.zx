import integers from "std:integer"

import { max_u32 } from "../../const"
import {
    initial_capacity,
    capacity_growth,
    load_numerator,
    load_denominator
} from "../index/const"
import grow from "./grow"
import probe from "./probe"

import type { Inserted as Output } from "./model"
import type { Key as Input } from "./model"

export default function (in: Input): Output {
    const capacity = in.index.buckets.length

    const existing_slot = match {
        capacity == 0 => 0,
        _ => probe({
            ...in.index.omit(["count"]),
            key: in.key
        })
    }

    if (capacity != 0) {
        const previous = in.index.buckets[existing_slot]

        if (previous != max_u32) {
            return {
                index: in.index,
                position: integers.widen(previous),
                found: true
            }
        }
    }

    const count = in.index.count + 1
    const position = integers.narrow(count) - 1
    const limit = capacity * load_numerator / load_denominator
    const needs_growth = count > limit

    const prepared = match {
        needs_growth => grow({
            index: in.index,
            capacity: match {
                capacity == 0 => initial_capacity,
                _ => capacity * capacity_growth
            }
        }),
        _ => in.index
    }

    const slot = match {
        needs_growth => probe({
            ...prepared.omit(["count"]),
            key: in.key
        }),
        _ => existing_slot
    }

    const keys = match {
        prepared.count < prepared.keys.length =>
            prepared.keys.with(prepared.count, in.key),
        _ => prepared.keys.push(in.key)[0]
    }

    return {
        index: {
            count,
            keys,
            buckets: prepared.buckets.with(slot, position)
        },
        position: integers.widen(position),
        found: false
    }
}
