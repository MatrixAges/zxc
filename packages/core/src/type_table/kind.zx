import {
    kind_scalar,
    kind_object,
    kind_optional,
    kind_list,
    kind_tuple,
    kind_error_set,
    kind_task,
    kind_enumeration
} from "./const"
import { Kind } from "./model"

export type Input = u8

export type Output = Kind

export default function (in: Input): Output {
    return match in {
        kind_scalar => Kind.Scalar,
        kind_object => Kind.Object,
        kind_optional => Kind.Optional,
        kind_list => Kind.List,
        kind_tuple => Kind.Tuple,
        kind_error_set => Kind.ErrorSet,
        kind_task => Kind.Task,
        kind_enumeration => Kind.Enumeration,
        _ => Kind.NativeReference
    }
}
