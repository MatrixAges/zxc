import integers from "zig:integers"

import { ExpressionKind } from "../kinds"
import header from "./header"

import type { Expressions } from "../model"
import type { Metadata, Result } from "./model"

export type Input = { table: Expressions, metadata: Metadata, value: bool }

export type Output = Result

export default function (in: Input): Output {
    const result = header({ table: in.table, metadata: in.metadata, kind: ExpressionKind.Boolean, payload: integers.narrow(in.table.booleans.length) })

    return { table: { ...result.table, booleans: result.table.booleans.push(in.value)[0] }, id: result.id }
}
