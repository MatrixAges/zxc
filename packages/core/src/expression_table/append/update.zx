import integers from "zig:integers"

import { ExpressionKind } from "../kinds"
import header from "./header"

import type { Expressions } from "../model"
import type { Metadata, Result } from "./model"

export type Input = { table: Expressions, metadata: Metadata, target: u32, index: u32, value: u32 }

export type Output = Result

export default function (in: Input): Output {
    const result = header({ table: in.table, metadata: in.metadata, kind: ExpressionKind.ListUpdate, payload: integers.narrow(in.table.update_targets.length) })

    return {
        table: {
            ...result.table,
            update_targets: result.table.update_targets.push(in.target)[0],
            update_indices: result.table.update_indices.push(in.index)[0],
            update_values: result.table.update_values.push(in.value)[0]
        },
        id: result.id
    }
}
