import integers from "std:integer"

import { ExpressionKind } from "../kinds"
import header from "./header"

import type { UnaryOperator } from "../kinds"
import type { Expressions } from "../model"
import type { Metadata, Result } from "./model"

export type Input = { table: Expressions, metadata: Metadata, operator: UnaryOperator, operand: u32 }

export type Output = Result

export default function (in: Input): Output {
    const result = header({ table: in.table, metadata: in.metadata, kind: ExpressionKind.Unary, payload: integers.narrow(in.table.unary_operators.length) })

    return {
        table: {
            ...result.table,
            unary_operators: result.table.unary_operators.push(in.operator)[0],
            unary_operands: result.table.unary_operands.push(in.operand)[0]
        },
        id: result.id
    }
}
