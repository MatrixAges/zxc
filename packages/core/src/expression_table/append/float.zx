import integers from "std:integer"

import { ExpressionKind } from "../kinds"
import header from "./header"

import type { Expressions } from "../model"
import type { Metadata, Result } from "./model"

export type Input = { table: Expressions, metadata: Metadata, value: f64 }

export type Output = Result

export default function (in: Input): Output {
    const result = header({ table: in.table, metadata: in.metadata, kind: ExpressionKind.Float, payload: integers.narrow(in.table.floats.length) })

    return { table: { ...result.table, floats: result.table.floats.push(in.value)[0] }, id: result.id }
}
