import integers from "std:integer"

import { ExpressionKind } from "../kinds"
import header from "./header"

import type { BinaryOperator } from "../kinds"
import type { Expressions } from "../model"
import type { Metadata, Result } from "./model"

export type Input = { table: Expressions, metadata: Metadata, operator: BinaryOperator, left: u32, right: u32 }

export type Output = Result

export default function (in: Input): Output {
    const result = header({ table: in.table, metadata: in.metadata, kind: ExpressionKind.Binary, payload: integers.narrow(in.table.binary_operators.length) })

    return {
        table: {
            ...result.table,
            binary_operators: result.table.binary_operators.push(in.operator)[0],
            binary_left: result.table.binary_left.push(in.left)[0],
            binary_right: result.table.binary_right.push(in.right)[0]
        },
        id: result.id
    }
}
