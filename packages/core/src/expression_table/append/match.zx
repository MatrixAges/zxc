import integers from "std:integer"

import { ExpressionKind } from "../kinds"
import header from "./header"

import type { Expressions } from "../model"
import type { Metadata, Result } from "./model"

export type Input = { table: Expressions, metadata: Metadata, subject: u32?, fallback: u32, conditions: u32[], results: u32[] }

export type Output = Result

export default function (in: Input): Output {
    const result = header({ table: in.table, metadata: in.metadata, kind: ExpressionKind.Match, payload: integers.narrow(in.table.match_subjects.length) })

    return {
        table: {
            ...result.table,
            match_subjects: result.table.match_subjects.push(in.subject)[0],
            match_fallbacks: result.table.match_fallbacks.push(in.fallback)[0],
            match_first: result.table.match_first.push(integers.narrow(result.table.match_conditions.length))[0],
            match_count: result.table.match_count.push(integers.narrow(in.conditions.length))[0],
            match_conditions: result.table.match_conditions.concat(in.conditions)[0],
            match_results: result.table.match_results.concat(in.results)[0]
        },
        id: result.id
    }
}
