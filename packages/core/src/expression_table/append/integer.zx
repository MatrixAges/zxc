import integers from "std:integer"

import { ExpressionKind } from "../kinds"
import header from "./header"

import type { Expressions } from "../model"
import type { Metadata, Result } from "./model"

export type Input = { table: Expressions, metadata: Metadata, value: u64, negative: bool }

export type Output = Result

export default function (in: Input): Output {
    const count = in.negative ? in.table.negative_integers.length : in.table.integers.length
    const result = header({ table: in.table, metadata: in.metadata, kind: in.negative ? ExpressionKind.NegativeInteger : ExpressionKind.Integer, payload: integers.narrow(count) })

    return {
        table: {
            ...result.table,
            integers: in.negative ? result.table.integers : result.table.integers.push(in.value)[0],
            negative_integers: in.negative ? result.table.negative_integers.push(in.value)[0] : result.table.negative_integers
        },
        id: result.id
    }
}
