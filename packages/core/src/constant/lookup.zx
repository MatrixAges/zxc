import type { Literal, Values } from "./model"

export type Input = {
    constants?: Values,
    name: string
}

export type Output = Literal?

    export default function (in: Input): Output {
        const constants = in.constants

        if (constants == null) {
            return null
        }

        const missing: u64? = null

        const found = loop({
            names: constants.names,
            name: in.name,
            index: 0,
            value: missing
        }, {
            while: current =>
                current.value == null && current.index < current.names.length,
            next: current => {
                if (current.names[current.index] == current.name) {
                    current.value = current.index
                }

                current.index += 1
            }
        }).value

        return found != null ? constants.values[found] : null
    }
