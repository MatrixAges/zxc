export enum StatementKind { Evaluate, Constant, Parallel, Destructure, Branch, Switch, StoreSet, Result }

export type Control = {
    statement_kinds: StatementKind[]
    statement_payloads: u32[]
    evaluations: u32[]
    constant_symbols: u32[]
    constant_values: u32[]
    parallel_first: u32[]
    parallel_count: u32[]
    parallel_symbols: u32?[]
    parallel_values: u32[]
    destructure_values: u32[]
    destructure_first: u32[]
    destructure_count: u32[]
    destructure_symbols: u32?[]
    branch_conditions: u32[]
    branch_yes: u32[]
    branch_no: u32[]
    selection_subjects: u32[]
    selection_first: u32[]
    selection_count: u32[]
    selection_exhaustive: bool[]
    case_values: u32?[]
    case_bodies: u32[]
    setter_slots: u32[]
    setter_values: u32[]
    results: u32?[]
    block_first: u32[]
    block_count: u32[]
}
