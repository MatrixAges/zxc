import integers from "zig:integers"

import { StatementKind } from "../model"
import header from "./header"

import type { Control } from "../model"

export type Input = { table: Control, slot: u32, value: u32 }

export type Output = Control

export default function (in: Input): Output {
    const table = header({ table: in.table, kind: StatementKind.StoreSet, payload: integers.narrow(in.table.setter_slots.length) })

    return {
        ...table,
        setter_slots: table.setter_slots.push(in.slot)[0],
        setter_values: table.setter_values.push(in.value)[0]
    }
}
