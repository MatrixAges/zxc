import memory from "std:memory"

import probe from "./slot"

import type { U64Buffer } from "std:memory"

// The caller lends a power-of-two table with at least one vacant bucket.
export type Input = {
    keys: u8[][],
    buckets: U64Buffer,
    capacity: u64,
    key: u8[],
    insert?: u64
}

export type Output = u64?

export default function (in: Input): Output {
    const found = probe({
        keys: in.keys,
        buckets: in.buckets,
        capacity: in.capacity,
        key: in.key
    })

    if (found.entry != 0) {
        return found.entry - 1
    }

    const insert = in.insert

    if (insert != null) {
        memory.writeU64(in.buckets, found.slot, insert + 1)
    }

    return null
}
