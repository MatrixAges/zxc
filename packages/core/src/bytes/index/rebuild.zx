import memory from "std:memory"

import probe from "./slot"

import type { U64Buffer } from "std:memory"

export type Input = {
    keys: u8[][],
    buckets: U64Buffer,
    capacity: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { keys, buckets, capacity } = in

    return loop({
        row: 0
    }, {
        while: state => state.row < keys.length,
        next: state => {
            const row = state.row
            const found = probe({
                keys,
                buckets,
                capacity,
                key: keys[row]
            })

            memory.writeU64(buckets, found.slot, row + 1)

            state.row += 1
        },
        return: state => state.row
    })
}
