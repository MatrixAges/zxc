export type Input = string[]

export type Output = string[]

export default function (in: Input): Output {
    const names = in.sort()[0]
    const values: string[] = []

    return loop({
        names,
        values,
        index: 0
    }, {
        while: current => current.index < current.names.length,
        next: current => {
            if (
                current.index == 0 ||
                    current.names[current.index] != current
                    .names[current.index -
                        1]
            ) {
                current.values =
                    current.values.push(
                        current.names[current.index]
                    )[0]
            }

            current.index += 1
        },
        return: state => state.values
    })
}
