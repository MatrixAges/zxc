import integers from "std:integer"

import mark from "./mark"

import type { Seen } from "./model"

export type Input = {
    seen: Seen,
    id: u32
}

export type Output = {
    seen: Seen,
    fresh: bool
}

export default function (in: Input): Output {
    const result = mark({
        ...in.seen,
        id: integers.widen(in.id)
    })

    return {
        seen: {
            slots: result.slots,
            count: result.count
        },
        fresh: result.fresh
    }
}
