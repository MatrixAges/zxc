import integers from "std:integer"

import { initial_capacity, capacity_growth } from "./const"

export type Input = u64[]

export type Output = u64[]

export default function (in: Input): Output {
    const capacity = in.length == 0 ? initial_capacity : in.length * capacity_growth
    const slots: u64[] = []

    const empty = loop({
        slots,
        capacity
    }, {
        while: current => current.slots.length < current.capacity,
        next: current => { current.slots = current.slots.push(0)[0] },
        return: state => state.slots
    })

    return loop({
        previous: in,
        slots: empty,
        index: 0
    }, {
        while: current => current.index < current.previous.length,
        next: current => {
            const key = current.previous[current.index]

            if (key != 0) {
                const slots = current.slots

                const position = loop({
                    position: integers.hash(key) % current.slots.length
                }, {
                    while: item => slots[item.position] != 0,
                    next: item =>
                        { item.position =
                            (item.position + 1) % slots.length },
                    return: state => state.position
                })

                current.slots = current.slots.with(position, key)
            }

            current.index += 1
        },
        return: state => state.slots
    })
}
