import integers from "std:integer"

import type { Workspace } from "./model"

export type Input = {
    state: Workspace,
    start: u64
}

export type Output = Workspace

export default function (in: Input): Output {
    const finished = loop({
        state: in.state,
        index: in.start,
        component: integers.narrow(in.state.first.length - 1)
    }, {
        while: current => current.index < current.state.stack_count,
        next: current => {
            const member = current.state.stack[current.index]
            const index = integers.widen(member)

            current.state.membership[index] = current.component
            current.state.on_stack[index] = false
            current.state.members = current.state.members.push(member)[0]
            current.index += 1
        }
    })

    return {
        ...finished.state,
        stack_count: in.start,
        first: finished.state.first.push(finished.state.members.length)[0]
    }
}
