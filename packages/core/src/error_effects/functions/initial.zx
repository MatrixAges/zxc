import { map } from "std:utils"
import { max_u32 } from "core/const"

import type { Workspace } from "./model"

export type Input = u32[][]

export type Output = Workspace

export default function (in: Input): Output {
    return {
        order: map(in, calls => max_u32),
        low: map(in, calls => 0),
        on_stack: map(in, calls => false),
        stack: map(in, calls => 0),
        stack_count: 0,
        nodes: map(in, calls => 0),
        children: map(in, calls => 0),
        starts: map(in, calls => 0),
        frame_count: 0,
        ordinal: 0,
        membership: map(in, calls => 0),
        members: [],
        first: [0]
    }
}
