import { max_u32 } from "core/const"

import type { Workspace } from "./model"

export type Input = u32[][]

export type Output = Workspace

export default function (in: Input): Output {
    return {
        order: in.map(calls => max_u32)[0],
        low: in.map(calls => 0)[0],
        on_stack: in.map(calls => false)[0],
        stack: in.map(calls => 0)[0],
        stack_count: 0,
        nodes: in.map(calls => 0)[0],
        children: in.map(calls => 0)[0],
        starts: in.map(calls => 0)[0],
        frame_count: 0,
        ordinal: 0,
        membership: in.map(calls => 0)[0],
        members: [],
        first: [0]
    }
}
