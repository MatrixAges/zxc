<Module>
    <Type from="./model" as="Effects" />

    <Args in={Effects.Sources} out={Effects.Result} />

    <Call fn="initial" in={$in.callees} />
    <Call fn="components" in={{ callees: $in.callees, state: $ctx.initial }} />
    <Call fn="join" in={{ sources: $in, components: $ctx.components }} />

    <Return value={{ components: $ctx.components.membership, names: $ctx.join.names, unknown: $ctx.join.unknown }} />
</Module>
