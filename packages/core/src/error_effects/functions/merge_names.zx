export type Input = {
    names: string[],
    added: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const result = loop({
        names: in.names,
        added: in.added,
        index: 0
    }, {
        while: current => current.index < current.added.length,
        next: current => {
            const name = current.added[current.index]

            if (!current.names.some(existing => existing == name)) {
                current.names = current.names.push(name)[0]
            }

            current.index += 1
        }
    })

    return result.names
}
