import type { Contracts } from "../contract_table/model"
import type { Control } from "../control_table/model"
import type { Expressions } from "../expression_table/model"
import type { Table } from "../function_table/model"
import type { Tables } from "../type_table/model"

export enum Operation { Expression, Function, Block, Children }

export type Frame = {
    operation: Operation,
    source: u64,
    index: u64,
    count: u64
}

export type Source = {
    expressions: Expressions,
    control: Control,
    returns: bool[],
    offset: u64
}

export type Context = {
    types: Tables,
    functions: Table
}

export type State = {
    context: Context,
    sources: Source[],
    frames: Frame[],
    called: u64[],
    called_count: u64,
    visited: u64[],
    visited_count: u64,
    next_expression: u64,
    names: string[],
    unknown: bool,
    collect: bool,
    known?: string[]?[],
    callees: u32[]
}

export type Request = {
    context: Context,
    expressions: Expressions,
    control: Control,
    root?: u32,
    contracts: Contracts,
    stores: bool,
    expression: u32,
    program: bool,
    known?: string[]?[]
}
