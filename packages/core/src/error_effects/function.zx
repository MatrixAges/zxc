import integers from "std:integer"

import contracts from "./contracts"
import merge from "./functions/merge_names"
import { Operation } from "./model"
import mark from "./seen/mark"
import source from "./source"

import type { State } from "./model"

export type Input = {
    state: State,
    index: u64
}

export type Output = State

export default function (in: Input): Output {
    if (in.index >= in.state.context.functions.input_types.length) {
        return {
            ...in.state,
            unknown: true
        }
    }

    const called = mark({
        slots: in.state.called,
        count: in.state.called_count,
        id: in.index
    })

    const state = {
        ...in.state,
        called: called.slots,
        called_count: called.count
    }

    if (!called.fresh) {
        return state
    }

    const functions = state.context.functions

    if (functions.native_modules[in.index] != null) {
        if (!functions.native_fallible[in.index]) {
            return state
        }

        const names = functions.native_errors[in.index]

        return match {
            names == null => {
                ...state,
                unknown: true
            },
            _ => {
                ...state,
                names: merge({
                    names: state.names,
                    added: names
                })
            }
        }
    }

    if (state.collect) {
        return {
            ...state,
            callees: state.callees.push(integers.narrow(in.index))[0]
        }
    }

    if (functions.stores[in.index].types.length != 0) {
        return {
            ...state,
            unknown: true
        }
    }

    const control = functions.control[in.index]
    const root = functions.roots[in.index]

    const registered = source({
        state,
        expressions: functions.expressions[in.index],
        control
    })

    const frames = match {
        root == null => registered.state.frames,
        _ => registered.state.frames.push({
            operation: Operation.Block,
            source: registered.source,
            index: integers.widen(control.block_first[integers.widen(
                root
            )]),
            count: integers.widen(control.block_count[integers.widen(
                root
            )])
        })[0]
    }

    return contracts({
        state: {
            ...registered.state,
            frames: frames
        },
        contracts: functions.contracts[in.index]
    })
}
