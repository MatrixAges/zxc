import integers from "std:integer"

import row from "../../type_table/row"
import add from "../add"

import type { Tables } from "../../type_table/model"

export type Input = {
    tables: Tables,
    type_id: u32,
    names: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const task = row({
        tables: in.tables,
        id: in.type_id
    })

    const errors = row({
        tables: in.tables,
        id: task.second
    })

    const table = errors.delta ? in.tables.delta : in.tables.base

    return loop({
        names: in.names,
        index: 0
    }, {
        while: current => current.index < integers.widen(errors.second),
        next: current => {
            current.names = add({
                names: current.names,
                name: table.names[integers.widen(errors.first) + current.index]
            })

            current.index += 1
        },
        return: current => current.names
    })
}
