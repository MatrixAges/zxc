import integers from "std:integer"

import { Operation } from "../model"
import child from "./child"

import type { State, Frame } from "../model"

export type Input = {
    state: State,
    frame: Frame
}

export type Output = State

export default function (in: Input): Output {
    const value = child({
        table: in.state.sources[in.frame.source].expressions,
        id: in.frame.index,
        index: in.frame.count
    })

    if (value == null) {
        return in.state
    }

    return {
        ...in.state,
        frames: in.state.frames.push({
            ...in.frame,
            count: in.frame.count + 1
        })[0].push({
            operation: Operation.Expression,
            source: in.frame.source,
            index: integers.widen(value),
            count: 0
        })[0]
    }
}
