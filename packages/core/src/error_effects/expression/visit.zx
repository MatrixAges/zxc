import integers from "std:integer"

import { ExpressionKind } from "../../expression_table/kinds"
import { Operation } from "../model"
import mark from "../seen/mark"
import intrinsic from "./intrinsic"

import type { State, Frame } from "../model"

export type Input = {
    state: State,
    frame: Frame
}

export type Output = State

export default function (in: Input): Output {
    const source = in.state.sources[in.frame.source]

    const visited = mark({
        slots: in.state.visited,
        count: in.state.visited_count,
        id: source.offset + in.frame.index
    })

    const state = {
        ...in.state,
        visited: visited.slots,
        visited_count: visited.count
    }

    if (!visited.fresh) {
        return state
    }

    const expressions = source.expressions

    const names = intrinsic({
        tables: state.context.types,
        expressions,
        index: in.frame.index,
        names: state.names
    })

    const frames =
        match {
            expressions.kinds[in.frame.index] == ExpressionKind.Call =>
                state.frames.push({
                    operation: Operation.Function,
                    source: 0,
                    index:
                        integers.widen(
                            expressions
                                .call_functions[integers.widen(
                                    expressions.payloads[in.frame.index]
                                )]
                        ),
                    count: 0
                })[0],
            _ => state.frames
        }

    const scheduled = frames.push({
        operation: Operation.Children,
        source: in.frame.source,
        index: in.frame.index,
        count: 0
    })[0]

    return {
        ...state,
        names,
        frames: scheduled
    }
}
