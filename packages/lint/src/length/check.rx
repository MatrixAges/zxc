<Module>
    <Args
        in={{
            maximum?: u64,
            text: u8[]
        }}
        out={u64?}
    />

    <If on={$in.maximum != null && $in.maximum == 0}>
        <Return value={null} />

        <Else>
            <Call fn="count" in={$in.text} />

            <If on={$in.maximum == null || $ctx.count > $in.maximum}>
                <Return value={$ctx.count} />

                <Else>
                    <Return value={null} />
                </Else>
            </If>
        </Else>
    </If>
</Module>
