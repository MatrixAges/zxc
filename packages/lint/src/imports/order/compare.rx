<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Input} out={Model.Output} />

    <Call fn="classify" in={$in} />

    <If on={$ctx.classify.left_category != $ctx.classify.right_category}>
        <Return
            value={{
                less_than:
                    $ctx.classify.left_category < $ctx.classify.right_category,
                same_group: $ctx.classify.same_group
            }}
        />

        <Else>
            <Call fn="path_order" in={$in} />

            <Return
                value={{
                    less_than: $ctx.path_order,
                    same_group: true
                }}
            />
        </Else>
    </If>
</Module>
