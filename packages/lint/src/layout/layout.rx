<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.Input} out={Layout.Break[]} />

    <Call fn="scan" in={$in} />

    <If on={$in.indent_only}>
        <Call
            fn="breaks"
            in={{
                graph: $ctx.scan,
                wraps: []
            }}
        />

        <Return value={$ctx.breaks} />
    </If>

    <Call fn="suffixes" in={$ctx.scan} />
    <Call fn="measure" in={$ctx.suffixes} />
    <Call fn="breaks" in={$ctx.measure} />

    <Return value={$ctx.breaks} />
</Module>
