import { print_width, indent_width } from "./const"

import type { Graph, Plan } from "./model"

export type Input = Graph

export type Output = Plan

export default function (in: Input): Output {
    const wraps: bool[] = []

    const result = loop({
        graph: in,
        wraps,
        index: 0
    }, {
        while: current => current.index < current.graph.input.tokens.length,
        next: current => {
            const token = current.graph.input.tokens[current.index]
            const partner = current.graph.partners[current.index]
            const opening = partner != null && partner > current.index
            const nonempty = partner != null && partner > current.index + 1
            const width =
                opening &&
                partner !=
                null ? current.graph.widths[partner] -
                current.graph.widths[current.index] +
                current.graph.input.tokens[partner].text.length : 0
            const margin =
                current.graph.depths[current.index] ==
                0 ? current.graph.input.prefix + current.graph.input.suffix : 0
            const tail =
                opening && partner != null &&
                partner + 1 < current.graph.trailers.length ?
                current.graph.trailers[partner + 1] : 0
            const prefix =
                current.graph.input.level * indent_width +
                current.graph.depths[current.index] * indent_width +
                current.graph.prefixes[current.index] + margin
            const children =
                opening && partner != null &&
                current.graph.vertical_counts[partner] >
                current.graph.vertical_counts[current.index]
            const limit = current.graph.input.width == 0 ? print_width :
                current.graph.input.width
            const wrap =
                opening && nonempty && !token.block &&
                (
                    token.object || (
                        !children && prefix + width + tail > limit
                    )
                )

            current.wraps = current.wraps.push(wrap)[0]
            current.index += 1
        }
    })

    return {
        graph: in,
        wraps: result.wraps
    }
}
