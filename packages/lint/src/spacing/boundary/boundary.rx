<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Input} out={Model.Output} />

    <Call fn="scan" in={$in} />

    <If on={!$ctx.scan.has_newline}>
        <Return
            value={{
                needs_edit: false,
                start: 0,
                end: 0,
                crlf: false,
                separate: false
            }}
        />

        <Else>
            <Call
                fn="check"
                in={{
                    gap: $in.gap,
                    scanned: $ctx.scan
                }}
            />

            <Return value={$ctx.check} />
        </Else>
    </If>
</Module>
