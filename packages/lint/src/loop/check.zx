import { loop_name } from "./const"

export enum Kind {
    Other,
    Call,
    Field,
    Index,
    Identifier
}

export type Input = {
    kind: Kind,
    receiver: Kind,
    callee: Kind,
    name: string
}

export type Output = bool

export default function (in: Input): Output {
    const postfix = match in.kind {
        Kind.Call => true,
        Kind.Field => true,
        Kind.Index => true,
        _ => false
    }

    return (
        - postfix
        - and in.receiver == Kind.Call
        - and in.callee == Kind.Identifier
        - and in.name == loop_name
    )
}
