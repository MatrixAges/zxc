import type { Output, Scanned } from "./model"

export type Input = {
    scanned: Scanned,
    offset: u64,
    level: u64
}

export default function (in: Input): Output {
    const count = in.level * 4

    return in.offset - in.scanned.start != count || in.scanned.has_tab
        -> {
            needs_edit: _,
            start: in.scanned.start,
            end: in.offset,
            count
        }
}
