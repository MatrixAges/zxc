<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Input} out={Model.Output} />

    <Call fn="scan" in={$in} />

    <If on={!$ctx.scan.at_line_start}>
        <Return
            value={{
                needs_edit: false,
                start: 0,
                end: 0,
                count: 0
            }}
        />

        <Else>
            <Call
                fn="check"
                in={{
                    scanned: $ctx.scan,
                    offset: $in.offset,
                    level: $in.level
                }}
            />

            <Return value={$ctx.check} />
        </Else>
    </If>
</Module>
