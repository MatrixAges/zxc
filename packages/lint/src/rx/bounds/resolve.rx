<Module>
    <Type from="./model" as="Model" />

    <Args
        in={{
            kind: u64,
            source: u8[],
            start: u64
        }}
        out={Model.Output}
    />

    <If on={$in.kind == 0}>
        <Call
            fn="tag_end"
            in={{
                source: $in.source,
                start: $in.start
            }}
        />

        <Call
            fn="opening"
            in={{
                source: $in.source,
                end: $ctx.tag_end
            }}
        />

        <Return value={$ctx.opening} />

        <Else>
            <If on={$in.kind == 1}>
                <Call
                    fn="closing_start"
                    in={{
                        source: $in.source,
                        start: $in.start
                    }}
                />

                <Call
                    fn="tag_end"
                    in={{
                        source: $in.source,
                        start: $ctx.closing_start
                    }}
                />

                <Return
                    value={{
                        start: $ctx.closing_start,
                        end: $ctx.tag_end,
                        self_closing: false
                    }}
                />

                <Else>
                    <If on={$in.kind == 2}>
                        <Call
                            fn="comment_end"
                            in={{
                                source: $in.source,
                                start: $in.start
                            }}
                        />

                        <Return
                            value={{
                                start: $in.start,
                                end: $ctx.comment_end,
                                self_closing: false
                            }}
                        />

                        <Else>
                            <Call
                                fn="tag_end"
                                in={{
                                    source: $in.source,
                                    start: $in.start
                                }}
                            />

                            <Return
                                value={{
                                    start: $in.start,
                                    end: $ctx.tag_end,
                                    self_closing: false
                                }}
                            />
                        </Else>
                    </If>
                </Else>
            </If>
        </Else>
    </If>
</Module>
