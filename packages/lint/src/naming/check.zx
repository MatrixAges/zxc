import {
    ascii_upper_first,
    ascii_upper_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_digit_first,
    ascii_digit_last,
    ascii_underscore
} from "core/const"

import { NameKind } from "./model"

export type Input = {
    name: string,
    kind: NameKind
}

export type Output = bool

export default function (in: Input): Output {
    if (in.name.length == 0) {
        return false
    }

    const first = in.name[0]

    const kind =
        (
            first >= ascii_upper_first && first <= ascii_upper_last ? NameKind.TypeDecl :
                NameKind.ImportedValue
        )
        -> (in.kind == NameKind.ImportedValue ? _ : in.kind)

    const valid_first =
        kind == NameKind.TypeDecl ? first >= ascii_upper_first &&
        first <= ascii_upper_last :
        first >= ascii_lower_first && first <= ascii_lower_last

    if (!valid_first) {
        return false
    }

    const state = loop({
        name: in.name,
        kind,
        index: 0,
        after_underscore: false,
        valid: true
    }, {
        while: current => current.valid && current.index < current.name.length,
        next: current => {
            const byte = current.name[current.index]
            const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
            const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
            const digit = byte >= ascii_digit_first && byte <= ascii_digit_last

            const condition = (
                - current.kind == NameKind.Value
                - or current.kind == NameKind.ImportedValue
                - and byte == ascii_underscore
            )

            if (condition) {
                current.valid = !current.after_underscore
                current.after_underscore = true
            } else {
                current.valid =
                    (
                        - upper
                        - or lower
                        - or digit
                        - and (current.kind != NameKind.Value || !upper)
                    )
                current.after_underscore = false
            }

            current.index += 1
        }
    })

    return state.valid && !state.after_underscore
}
