import {
    ascii_upper_first,
    ascii_upper_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_digit_first,
    ascii_digit_last,
    ascii_underscore
} from "core/const"

import { NameKind } from "./model"

export type Input = {
    name: string,
    kind: NameKind
}

export type Output = bool

export default function (in: Input): Output {
    if (in.name.length == 0) {
        return false
    }

    const first = in.name[0]

    const imported_kind = match {
        first >= ascii_upper_first && first <= ascii_upper_last => NameKind.TypeDecl,
        _ => NameKind.ImportedValue
    }

    const kind =
        in.kind == NameKind.ImportedValue ? imported_kind : in.kind

    const valid_first =
        match {
            kind == NameKind.TypeDecl => first >= ascii_upper_first &&
                first <= ascii_upper_last,
            _ => first >= ascii_lower_first && first <= ascii_lower_last
        }

    if (!valid_first) {
        return false
    }

    const state = loop({
        name: in.name,
        kind,
        index: 0,
        after_underscore: false,
        valid: true
    }, {
        while: current => current.valid && current.index < current.name.length,
        next: current => {
            const byte = current.name[current.index]
            const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
            const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
            const digit = byte >= ascii_digit_first && byte <= ascii_digit_last

            const is_value = current.kind == NameKind.Value
            const variable = match current.kind {
                NameKind.Value => true,
                NameKind.ImportedValue => true,
                _ => false
            }

            const condition = variable && byte == ascii_underscore

            if (condition) {
                current.valid = !current.after_underscore
                current.after_underscore = true
            } else {
                const identifier = upper || lower || digit
                const allowed_case = !is_value || !upper

                current.valid = (
                    - identifier
                    - and allowed_case
                )
                current.after_underscore = false
            }

            current.index += 1
        }
    })

    return state.valid && !state.after_underscore
}
