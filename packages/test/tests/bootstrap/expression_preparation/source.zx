import type { Prepared } from "../../../../compiler/src/zx/frontend/parser/templates/model"
import type { Hint } from "../../../../compiler/src/zx/frontend/parser/expressions/prepare/model"
import lexical from "../../../../compiler/src/zx/frontend/parser/templates/prepare"
import prepare from "../../../../compiler/src/zx/frontend/parser/expressions/prepare/all"

export type Input = u8[]

export type Output = { lexical: Prepared, hints: Hint[], interpolation_hints: Hint[][] }

export default function (in: Input): Output {
  return prepare(lexical(in))
}
