import fromLiteral from "../../../fixtures/concat_reverse_literal.zx";

export type Input = { items: u64[]; other: u64[]; };

export type Output = string[];

export default function (in: Input): Output {
  const owned: string[] = [fromLiteral(in.items[0]), fromLiteral(in.items[1])];
  const other: string[] = [fromLiteral(in.other[0])];
  const [joined, _] = owned.concat(other);
  const [result, _] = joined.reverse();

  return result;
}
