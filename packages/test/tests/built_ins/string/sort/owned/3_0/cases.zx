import fromLiteral from "../../../fixtures/sort_literal.zx";

export type Input = { items: u64[]; };

export type Output = string[];

export default function (in: Input): Output {
  const owned: string[] = [fromLiteral(in.items[0]), fromLiteral(in.items[1]), fromLiteral(in.items[2])];
  const [result, _] = owned.sort();

  return result;
}
