import host from "zig:host"

export type Input = { items: i64[], selected_index: u64, selected_value: i64 }

export type Output = bool

export default function (in: Input): Output {
    return host.source(in.items).some((item, index, source) => host.visit({ item, index, source }) && ((index == in.selected_index && item == in.selected_value) && source[index] == item))
}
