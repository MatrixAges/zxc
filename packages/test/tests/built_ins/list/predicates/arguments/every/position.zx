import host from "zig:host"

export type Input = {
    items: i64[],
    selected_index: u64,
    selected_value: i64
}

export type Output = bool

export default function (in: Input): Output {
    return host.source(in.items).every((item, index, source) => {
        const visited = host.visit({
            item,
            index,
            source
        })

        const selected = (
            - index != in.selected_index
            - or item == in.selected_value
        )

        return (
            - visited
            - and selected
            - and source[index] == item
        )
    })
}
