export type Input = { items: [i64, bool, string][], start: u64, count: u64, other: [i64, bool, string][] }

export type Output = { remaining: [i64, bool, string][], removed: [i64, bool, string][], original: [i64, bool, string][], remaining_length: u64, removed_length: u64 }

export default function (in: Input): Output {
  const owned = in.items.map(item => item)

  const [remaining, removed] = owned.splice(in.start, in.count, in.other)

  const remaining_length = remaining.length
  const removed_length = removed.length

  return { remaining, removed, original: in.items, remaining_length, removed_length }
}
