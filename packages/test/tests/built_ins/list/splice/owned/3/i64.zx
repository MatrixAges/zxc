export type Input = { items: i64[]; other: i64[]; start: u64; count: u64; };

export type Output = { items: i64[]; removed: i64[]; };

export default function (in: Input): Output {
  const owned: i64[] = [in.items[0], in.items[1], in.items[2]];

  const [items, removed] = owned.splice(in.start, in.count, in.other);

  return { items, removed };
}
