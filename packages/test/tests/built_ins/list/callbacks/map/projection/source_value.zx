import { map } from "std:utils"

export type Input = {
    items: i64[],
    threshold: i64
}

export type Output = {
    mapped: bool[],
    items: i64[]
}

export default function (in: Input): Output {
    return {
        mapped:
            map(
                in.items,
                (item, index, source) => item > in.threshold && source[index] == item
            ),
        items: in.items
    }
}
