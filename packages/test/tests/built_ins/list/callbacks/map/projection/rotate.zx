import { map } from "std:utils"

export type Input = {
    items: i64[]
}

export type Output = {
    mapped: i64[],
    items: i64[]
}

export default function (in: Input): Output {
    return {
        mapped:
            map(
                in.items,
                (item, index, source) =>
                    source[index + 1 == source.length ? 0 : index + 1]
            ),
        items: in.items
    }
}
