import choose from "./choose_view"

export type Input = u64

export type Output = u64

export default function (in: Input): Output {
    const empty: u64[] = []
    const first = empty.push(in)[0]
    const values = first.push(in + 1)[0]

    return choose({
        values,
        tag: values.reverse()[0][0]
    }).length
}
