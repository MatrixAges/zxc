import borrow from "./borrow"

export type Input = u64

export type Output = u64

export default function (in: Input): Output {
    const empty: u64[] = []
    const first = empty.push(in)[0]
    const values = first.push(in + 1)[0]
    const view = borrow(values)

    return view[values.reverse()[0].length - 1]
}
