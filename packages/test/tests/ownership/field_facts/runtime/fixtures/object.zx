import { map } from "std:utils"

export type Input = {
    values: u64[],
    count: u64,
    choice: bool
}

export type Output = {
    fresh: u64[],
    view: u64[]
}

export default function (in: Input): Output {
    const fresh = map(in.values, item => item + 1)

    const box = in.choice ? {
        fresh,
        view: in.values
    } : {
        fresh,
        view: fresh
    }

    return {
        fresh: box.fresh,
        view: box.view
    }
}
