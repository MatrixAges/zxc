export type Input = {
    values: u64[],
    count: u64,
    choice: bool
}

export type Output = {
    fresh: u64[],
    view: u64[]
}

export default function (in: Input): Output {
    const fresh = in.values.map(item => item + 1)[0]

    const box = match {
        in.choice => {
            fresh,
            view: in.values
        },
        _ => {
            fresh,
            view: fresh
        }
    }

    return {
        fresh: box.fresh,
        view: box.view
    }
}
