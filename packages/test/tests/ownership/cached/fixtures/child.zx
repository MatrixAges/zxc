export type Input = {
    first: u64[],
    second: u64[],
    choice: bool
}

export type Output = {
    first: u64[],
    second: u64[]
}

export default function (in: Input): Output {
    const first = in.first.map((item) => item)[0]
    const second = in.second.map((item) => item)[0]

    const source: {
        lists: Output
    } = {
        lists: {
            first,
            second
        }
    }

    return {
        ...source.lists
    }
}
