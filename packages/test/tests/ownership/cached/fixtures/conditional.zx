import { map } from "std:utils"

export type Input = {
    first: u64[],
    second: u64[],
    choice: bool
}

export type Output = {
    first: u64[],
    second: u64[]
}

export default function (in: Input): Output {
    const first = map(in.first, (item) => item)
    const second = map(in.second, (item) => item)

    const source: Output = {
        first,
        second
    }

    return in.choice ? {
        ...source
    } : {
        ...source
    }
}
