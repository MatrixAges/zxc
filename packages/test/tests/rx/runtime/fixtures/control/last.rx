<Module>
  <Call fn="./helper.zx" in={$in.value} />
  <Task name="choose">
    <Switch on={$in.enabled}>
      <Case value={true}>
        <Call module="./leaf.rx" in={$ctx.helper} />
        <Return value={$ctx.leaf + 10} />
      </Case>
      <Default><Return value={$ctx.helper} /></Default>
    </Switch>
  </Task>
</Module>
