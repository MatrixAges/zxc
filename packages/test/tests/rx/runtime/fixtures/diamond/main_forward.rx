<Module>
  <Call fn='number' in={$in.number} out='ctx.number'/>
  <Call fn='optional' in={$in.maybe} out='ctx.maybe'/>
  <Call service='./left.rx' in={ctx.number} out='ctx.left'/>
  <Call service='./right.rx' in={ctx.maybe} out='ctx.right'/>
  <Return value={{ left: ctx.left, right: ctx.right }}/>
</Module>
