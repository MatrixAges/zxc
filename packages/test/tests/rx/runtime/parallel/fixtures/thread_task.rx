<Module>
  <Parallel>
    <Task name="work" out="ctx.left">
      <Call fn="copy_values" in={$in} out="local.value" />
      <Return value={local.value} />
    </Task>
    <Task name="work" out="ctx.right">
      <Call fn="copy_values" in={$in} out="local.value" />
      <Return value={local.value} />
    </Task>
  </Parallel>
  <Return value={{left: ctx.left, right: ctx.right}} />
</Module>
