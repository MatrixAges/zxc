<Module>
  <Parallel>
    <Task name="left">
      <Call fn="copy_values" in={$in} />
      <Return value={$ctx.copy_values} />
    </Task>
    <Task name="right">
      <Call fn="copy_values" in={$in} />
      <Return value={$ctx.copy_values} />
    </Task>
  </Parallel>
  <Return value={{left: $ctx.task.left, right: $ctx.task.right}} />
</Module>
