<Module>
  <Call fn="map_values" in={$in} />
  <Parallel>
    <Task name="left">
      <Call fn="map_values_local" in={$in} />
      <Return value={$ctx.map_values_local} />
    </Task>
    <Task name="right">
      <Call fn="double_values" in={$in} />
      <Return value={$ctx.double_values} />
    </Task>
  </Parallel>
  <Call fn="pop_values" in={$ctx.map_values} />
  <Return value={{left: $ctx.task.left, right: $ctx.task.right, remaining: $ctx.pop_values}} />
</Module>
