<Module>
  <Parallel>
    <Task name="left">
      <Call module="left.rx" in={$in} />
      <Return value={$ctx.left} />
    </Task>
    <Task name="right">
      <Call module="right.rx" in={$in} />
      <Return value={$ctx.right} />
    </Task>
  </Parallel>
  <Return value={{left: $ctx.task.left, right: $ctx.task.right}} />
</Module>
