<Module>
  <Parallel>
    <Task name="left">
      <Call fn="copy_values" in={$in}/>
      <Call fn="consume" in={$ctx.copy_values}/>
      <Return value={$ctx.consume}/>
    </Task>
    <Task name="right">
      <Call fn="copy_values" in={$in}/>
      <Call fn="consume" in={$ctx.copy_values}/>
      <Return value={$ctx.consume}/>
    </Task>
  </Parallel>
  <Return value={{left: $ctx.task.left, right: $ctx.task.right}}/>
</Module>
