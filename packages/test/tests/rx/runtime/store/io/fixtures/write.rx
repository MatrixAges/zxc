<Module>
  <Store from="state" as="cache" />
  <Call fn="read" in={{path: $in.path, max_bytes: $in.max_bytes}} />
  <Call fn="save" in={{value: $ctx.read, state: store.cache.snapshot}} setter={[store.cache.snapshot]} />
  <Call fn="read_after" in={{path: $in.after_path, max_bytes: $in.max_bytes}} />
  <Call fn="view" in={store.cache.snapshot} />
  <Return value={$ctx.view} />
</Module>
