<Module>
  <Store from="right" as="inner" />

  <Call module="write_left" in={{increment: $in.increment, index: $in.left_index}} />
  <Call fn="advance_failure" in={{increment: $in.increment, index: $in.right_index, state: store.inner.counter}} setter={[store.inner.counter]} />

  <Return value={{first: $ctx.write_left, second: $ctx.advance_failure}} />
</Module>
