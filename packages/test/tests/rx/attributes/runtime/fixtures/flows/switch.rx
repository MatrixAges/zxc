<Module>
  <Call fn="../functions/number" in={$in}/>
  <Switch on={$ctx.number < 3 && $ctx.number > 0}>
    <Case value={true}><Return value={{selected: true, text: `前${$ctx.number}后`}}/></Case>
    <Default><Return value={{selected: false, text: `前${$ctx.number}后`}}/></Default>
  </Switch>
</Module>
