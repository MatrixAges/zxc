import { map } from "std:utils"

export type Input = i64[]

export type Output = {
    original: i64[],
    reversed: i64[]
}

export default function (in: Input): Output {
    const values = map(in, item => item + 1)
    const reversed = values.reverse()[0]

    return {
        original: values,
        reversed: reversed
    }
}
