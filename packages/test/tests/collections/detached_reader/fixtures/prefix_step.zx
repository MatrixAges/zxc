import read from "./read"

import type { State, StepInput } from "./model"

export type Input = StepInput

export type Output = State

export default function (in: Input): Output {
    const selected = in.state.values.length <= 1 ? 0 : in.item % (in.state.values.length - 1)
    const old = read({ values: in.state.values, selected: selected })
    const values = in.state.values.push({ value: old[selected].value + in.item + 1, label: old[selected].label })[0]

    return { values: values, seen: in.state.seen + old[selected].value + old.length, label: old[selected].label, count: in.state.count + 1 }
}
