import { reduce } from "std:utils"

import step from "./dual_step"

export type State = {
    a: u64[],
    b: u64[],
    count: u64
}

export type Input = {
    a: u64[],
    b: u64[],
    steps: u64[]
}

export type Output = State

export default function (in: Input): Output {
    const initial: State = {
        a: in.a,
        b: in.b,
        count: 3
    }

    return reduce(in.steps, (state, item) => step({
        state,
        item
    }), initial)
}
