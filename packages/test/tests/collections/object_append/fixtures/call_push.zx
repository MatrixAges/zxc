import { map, reduce } from "std:utils"

import step from "./push_step"

export type Input = {
    seed: u64[],
    steps: u64[]
}

export type State = {
    count: u64,
    previous: u64,
    values: u64[]
}

export type Output = State

export default function (in: Input): Output {
    const values = map(in.seed, item => item)

    const initial: State = {
        count: 3,
        previous: 99,
        values
    }

    return reduce(in.steps, (state, item) => step({
        state,
        item
    }), initial)
}
