export type State = { a: u64[], b: u64[], count: u64, seen: u64 }

export type Input = { state: State, item: u64 }

export type Output = State

export default function (in: owned Input): Output {
  return {b: in.state.b.push(in.item)[0], seen: in.state.a[0], a: in.state.a, count: in.state.count + 1}
}
