import readOld from "./branch"

import type { BranchState, DataInput, DataOutput } from "./types"

export type Input = DataInput

export type Output = DataOutput

export default function (in: Input): Output {
  const initial: BranchState = { left: { total: in.start, previous: in.start }, right: { total: in.start + 100, previous: in.start }, index: 0, limit: in.count, previous: in.start }

  const result = loop(initial, {
    while: state => state.index < state.limit,
    next: state => {
      const old = readOld(state)

      state.left.total += 1
      state.right.total += 2
      state.previous = old.total
      state.index += 1
    }
  })

  return { initial: initial.left.total, total: result.left.total, previous: result.previous, steps: result.index, other: result.right.total, values: in.values }
}
