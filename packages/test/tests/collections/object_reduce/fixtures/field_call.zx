import scalar from "./scalar"

export type Child = { value: u64 }

export type State = { count: u64, total: u64, last: u64, labels: string[], text: string, child: Child }

export type Input = { seed: State, steps: u64[] }

export type Output = State

export default function (in: Input): Output {
  return in.steps.reduce((state, item) => ({...state, count: state.count + 1, total: scalar(state.total) + state.count + item, last: state.count}), in.seed)
}
