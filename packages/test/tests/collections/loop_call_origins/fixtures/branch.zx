import create from "./factory/branch"

export type Input = { values: u64[], count: u64, enabled: bool }

export type State = { values: u64[], round: u64, count: u64 }

export type Output = { original: u64[], values: u64[] }

export default function (in: Input): Output {
    const fresh = create({ values: in.values, enabled: in.enabled })
    const initial: State = { values: fresh, round: 0, count: in.count }

    const result = loop(initial, {
        while: state => state.round < state.count,
        next: state => {
            state.values[0] += 1
            state.round += 1
        }
    })

    return { original: in.values, values: result.values }
}
