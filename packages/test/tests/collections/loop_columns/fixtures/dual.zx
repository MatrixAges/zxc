export type Frame = { position: u64, count: u64 }

export type Input = { frames: Frame[], columns: u64[], count: u64, selected: u64 }

export type State = { frames: Frame[], left: u64[], right: u64[], scratch: u64[], index: u64, count: u64 }

export type Output = { left: u64[], right: u64[], mirror: u64[], length: u64, left_value: u64, right_value: u64 }

export default function (in: Input): Output {
    const initial: State = { frames: in.frames, left: in.columns, right: in.columns, scratch: [], index: 0, count: in.count }

    const state = loop(initial, {
        while: current => current.index < current.count,
        next: current => {
            current.frames = current.frames.push({ position: current.index, count: current.index })[0]

            const [remaining, popped] = current.frames.pop()

            current.frames = remaining
            current.left = current.left.push(current.index + 11)[0]
            current.right = current.right.push(current.index + 101)[0]
            current.scratch = current.scratch.push(current.index)[0]
            current.index += 1
        }
    })

    return { left: state.left, right: state.right, mirror: state.left, length: state.left.length, left_value: state.left[in.selected], right_value: state.right[in.selected] }
}
