import append from "./append"

import type { Columns, Input, ObjectResult } from "./model"

export type Output = ObjectResult

export default function (in: Input): Output {
    const generated: Columns = { values: [], offsets: [], labels: [] }

    const state = loop({ input: in, generated: generated, direct: { values: in.prefix, marker: in.marker }, untouched: in.prefix, records: in.records, pairs: in.pairs, index: 0 }, {
        while: current => current.index < current.input.count,
        next: current => {
            current.generated = append({ columns: current.generated, value: current.index, label: current.input.label })

            if (current.input.enabled) {
                current.direct = { values: current.direct.values.push(current.index + 11)[0], marker: current.direct.marker }
            }

            current.index += 1
        }
    })

    return { generated: state.generated, direct: state.direct, untouched: state.untouched, records: state.records, pairs: state.pairs }
}
