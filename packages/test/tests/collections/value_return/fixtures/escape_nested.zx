import step from "./escape_nested_step.zx"

export type Cell = { value: u64 }

export type Bundle = { argument: { inner: { cell: Cell } }, local: { inner: { cell: Cell } } }

export type Input = u64[]

export type Output = Bundle[]

export default function (in: Input): Output {
  return in.map(item => [item].reduce((state, value) => step({value}), step({value: 0})))
}
