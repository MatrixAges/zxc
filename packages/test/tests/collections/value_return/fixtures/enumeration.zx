import { reduce } from "std:utils"

import step from "./enum_step"
import { Phase } from "./phase"

export type State = {
    phase: Phase,
    saved?: Phase,
    count: u64
}

export type Input = {
    seed: State,
    steps: bool[]
}

export type Output = State

export default function (in: Input): Output {
    return reduce(in.steps, (state, item) => step({
        state,
        item
    }), in.seed)
}
