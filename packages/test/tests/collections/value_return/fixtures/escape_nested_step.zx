export type Cell = { value: u64 }

export type Input = Cell

export type Output = { argument: { inner: { cell: Cell } }, local: { inner: { cell: Cell } } }

export default function (in: Input): Output {
  const value = in.value
  const local: Cell = {value: value + 1}

  return {argument: {inner: {cell: in}}, local: {inner: {cell: local}}}
}
