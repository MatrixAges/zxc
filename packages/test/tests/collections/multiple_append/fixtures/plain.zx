export type Input = {
    first: u64[],
    second: u64[],
    steps: u64[]
}

export type State = {
    primary: u64[],
    secondary: u64[],
    total: u64
}

export type Output = State

export default function (in: Input): Output {
    const primary = in.first.map((item) => item)[0]
    const secondary = in.second.map((item) => item)[0]

    const initial: State = {
        primary,
        secondary,
        total: 7
    }

    return in.steps.reduce((state, item) => ({
        total: state.total + state.primary.length + state.secondary.length,
        primary: state.primary.push(item)[0],
        secondary: state.secondary.concat([
            item,
            item + 10
        ])[0]
    }), initial)[1]
}
