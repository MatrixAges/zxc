import { map, reduce } from "std:utils"

export type Input = {
    first: u64[],
    second: u64[],
    steps: u64[]
}

export type State = {
    primary: u64[],
    secondary: u64[],
    total: u64
}

export type Output = State

export default function (in: Input): Output {
    const primary = map(in.first, (item) => item)
    const secondary = map(in.second, (item) => item)

    const initial: State = {
        primary: primary,
        secondary: secondary,
        total: 7
    }

    return reduce(in.steps, (state, item) => ({
        total: state.total + state.primary.length + state.secondary.length,
        primary: state.primary.push(item)[0],
        secondary: state.secondary.concat([item, item + 10])[0]
    }), initial)
}
