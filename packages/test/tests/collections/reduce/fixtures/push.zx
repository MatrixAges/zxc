import { map, reduce } from "std:utils"

export type Input = {
    seed: u64[],
    steps: {
        enabled: bool,
        value: u64,
        values: u64[]
    }[]
}

export type Output = u64[]

export default function (in: Input): Output {
    const initial = map(in.seed, item => item)

    return reduce(
        in.steps,
        (items, step) => items.push(step.value)[0],
        initial
    )
}
