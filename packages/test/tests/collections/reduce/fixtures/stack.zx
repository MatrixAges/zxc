export type Input = {
    seed: u64[],
    steps: {
        enabled: bool,
        value: u64,
        values: u64[]
    }[]
}

export type Output = u64[]

export default function (in: Input): Output {
    const initial = in.seed.map(item => item)[0]

    return in.steps.reduce(
        (items, step) => step.enabled ? items.push(step.value)[0] : items.pop()[0],
        initial
    )[1]
}
