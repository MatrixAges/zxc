export type Input = { values: i64[], count: u64, enabled: bool }

export type State = { left: i64[], right: i64[], count: u64, index: u64 }

export type Output = { original: i64[], values: i64[], seen: i64 }

export default function (in: Input): Output {
  const initial: State = { left: in.values, right: in.values, count: in.count, index: 0 }

  const result = iterate(initial, {
    while: state => state.index < state.count,
    next: state => {
      state.left[0] += 1
      state.right[1] += 2
      state.index += 1
    }
  })

  return { original: in.values, values: result.left, seen: result.right[1] }
}
