export type Input = { values: i64[], count: u64, enabled: bool }

export type State = { values: i64[], count: u64, index: u64, seen: i64 }

export type Output = { original: i64[], values: i64[], seen: i64 }

export default function (in: Input): Output {
  const initial: State = { values: in.values, count: in.count, index: 0, seen: 0 }

  const result = loop(initial, {
    while: state => state.index < state.count,
    next: state => {
      const old = state.values

      switch (state.index % 3) {
        case 0:
          state.values[0] += 1
        case 1:
          state.values[0] += 2
        default:
          state.values[0] += 3
      }
      state.seen += old[0]
      state.index += 1
    }
  })

  return { original: in.values, values: result.values, seen: result.seen }
}
