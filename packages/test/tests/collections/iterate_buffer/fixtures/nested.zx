export type Input = { values: i64[], count: u64, enabled: bool }

export type State = { box: { values: i64[] }, count: u64, index: u64 }

export type Output = { original: i64[], values: i64[], seen: i64 }

export default function (in: Input): Output {
  const initial: State = { box: { values: in.values }, count: in.count, index: 0 }

  const result = iterate(initial, {
    while: state => state.index < state.count,
    next: state => {
      state.box.values[0] += 1
      state.index += 1
    }
  })

  return { original: in.values, values: result.box.values, seen: 0 }
}
