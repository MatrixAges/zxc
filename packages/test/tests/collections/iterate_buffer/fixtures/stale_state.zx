export type Input = { values: i64[], count: u64, enabled: bool }

export type State = { values: i64[], history: i64[], count: u64, index: u64 }

export type Output = { original: i64[], values: i64[], seen: i64 }

export default function (in: Input): Output {
  const initial: State = { values: in.values, history: in.values, count: in.count, index: 0 }

  const result = loop(initial, {
    while: state => state.index < state.count,
    next: state => {
      state.history = state.values
      state.values[0] += 1
      state.index += 1
    }
  })

  return { original: in.values, values: result.values, seen: result.history[0] }
}
