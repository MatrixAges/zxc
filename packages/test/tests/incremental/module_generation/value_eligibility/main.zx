import { reduce } from "std:utils"

import step from "./step"

export type State = {
    count: u64
}

export type Input = {
    seed: State,
    items: u64[]
}

export type Output = State

export default function (in: Input): Output {
    return reduce(in.items, (state, item) => step({
        state,
        item
    }), in.seed)
}
