import type { Node } from "zig:host"

export enum Mode { First, Second }

export type Record = { count: u64, mode: Mode }

export type Request = { node: Node, record: Record, pair: [Mode, u64], values: Mode[], saved: Mode? }

export type Response = { node: Node, record: Record, pair: [Mode, u64], values: Mode[], saved: Mode?, total: u64 }
