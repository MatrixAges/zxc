import readLeft from "lib:probe-left"
import readRight from "lib:probe-right"

export type Input = { fail_left: bool
 fail_right: bool
 index: u64 }

export type Output = f64

export default function (in: Input): Output {
  const values: f64[] = [readLeft(in.fail_left), readRight(in.fail_right)]

  return values[in.index]
}
