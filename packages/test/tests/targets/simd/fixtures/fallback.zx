import { map, reduce } from "std:utils"

export type Input = i32[]

export type Output = {
    incremented: i32[],
    positive: i32[],
    total: i32,
    nested: i32[][]
}

export default function (in: Input): Output {
    return {
        incremented: map(in, value => value + 1),
        positive: in.filter(value => value > 0),
        total: reduce(in, (total, value) => total + value, 0),
        nested: map(in, value => map([value, -value], item => item * 2))
    }
}
