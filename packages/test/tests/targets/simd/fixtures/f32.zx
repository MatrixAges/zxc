export type Input = f32[]

export type Output = {
    identity: f32[],
    negative: f32[],
    broadcast: f32[],
    add: f32[],
    subtract: f32[],
    multiply: f32[],
    divide: f32[],
    chain: f32[],
    grouped: f32[],
    cancellation: f32[],
    conditional: f32[]
}

export default function (in: Input): Output {
    return {
        identity: in.map(value => value)[0],
        negative: in.map(value => -value)[0],
        broadcast: in.map(value => 1.5)[0],
        add: in.map(value => value + 1.5)[0],
        subtract: in.map(value => 1.5 - value)[0],
        multiply: in.map(value => value * value)[0],
        divide: in.map(value => value / 2.0)[0],
        chain: in.map(value => value * value + value)[0],
        grouped: in.map(value => (value + 1.5) * (value - 1.5))[0],
        cancellation: in.map(value => (value + 16777216.0) - 16777216.0)[0],
        conditional: in.map(value => value < 0.0 ? -value : value)[0]
    }
}
