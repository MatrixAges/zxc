import { map } from "std:utils"

export type Input = f64[]

export type Output = {
    identity: f64[],
    negative: f64[],
    broadcast: f64[],
    add: f64[],
    subtract: f64[],
    multiply: f64[],
    divide: f64[],
    chain: f64[],
    grouped: f64[],
    cancellation: f64[],
    conditional: f64[]
}

export default function (in: Input): Output {
    return {
        identity: map(in, value => value),
        negative: map(in, value => -value),
        broadcast: map(in, value => 1.5),
        add: map(in, value => value + 1.5),
        subtract: map(in, value => 1.5 - value),
        multiply: map(in, value => value * value),
        divide: map(in, value => value / 2.0),
        chain: map(in, value => value * value + value),
        grouped: map(in, value => (value + 1.5) * (value - 1.5)),
        cancellation: map(in, value => (value + 16777216.0) - 16777216.0),
        conditional: map(in, value => value < 0.0 ? -value : value)
    }
}
