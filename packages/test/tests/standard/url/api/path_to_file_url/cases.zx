import url from "std:url"
import type { Url, Resolve, Platform } from "std:url"

export type Input = { path: string, cwd: string, windows: bool }

export type Output = string

export default function (in: Input): Output {
  return url.pathToFileURL({ path: in.path, cwd: in.cwd, platform: in.windows ? Platform.Windows : Platform.Posix })
}
