export type Input = u64

export type Output = string

export default function (in: Input): Output {
  switch (in) {
    case 0: return "/*var y = 0*/"
    case 1: return "/*var y = 0"
    case 2: return "//var y = 0"
    case 3: return "*/"
    case 4: return "/* // */"
    default: return ""
  }
}
