export type Input = u64

export type Output = u64

export default function (in: Input): Output {
  switch (in) {
    case 0: return 00_0
    case 1: return 01_0
    case 2: return 07_0
    case 3: return 0_0
    case 4: return 0_1
    case 5: return 0_7
    case 6: return 08_0
    case 7: return 09_0
    case 8: return 0_8
    case 9: return 0_9
    case 10: return 0_0123456789
    default: return 0
  }
}
