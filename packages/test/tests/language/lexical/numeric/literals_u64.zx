export type Input = u64;

export type Output = u64;

export default function (in: Input): Output {
  switch (in) {
    case 0: return 1_1;
    case 1: return 1_0123456789;
    case 2: return 123456789_0;
    case 3: return 123456789_1;
    case 4: return 123456789_2;
    case 5: return 123456789_3;
    case 6: return 123456789_4;
    case 7: return 123456789_5;
    case 8: return 123456789_6;
    case 9: return 123456789_7;
    case 10: return 123456789_8;
    case 11: return 123456789_9;
    default: return 0;
  }
}
