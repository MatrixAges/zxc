import fraction from "./cases/fraction"
import fractionExponent from "./cases/fraction_exponent"
import integerDigit from "./cases/integer_digit"
import integerLowerExponent from "./cases/integer_lower_exponent"
import integerMultiDigit from "./cases/integer_multi_digit"
import integerSigned from "./cases/integer_signed"
import integerUpperExponent from "./cases/integer_upper_exponent"

export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    if ((in >= 99 && in <= 128)) {
        return fraction(in)
    }

    if ((in >= 129 && in <= 208) || (in >= 371 && in <= 372)) {
        return fractionExponent(in)
    }

    if ((in >= 0 && in <= 9)) {
        return integerDigit(in)
    }

    if ((in >= 19 && in <= 28) || (in >= 39 && in <= 48) || (in >= 59 && in <= 68) || (in >= 79 && in <= 88) || (in >= 209 && in <= 218) || (in >= 229 && in <= 238) || (in >= 249 && in <= 258) || (in >= 269 && in <= 278)) {
        return integerLowerExponent(in)
    }

    if ((in >= 10 && in <= 18) || (in >= 289 && in <= 370) || (in >= 373 && in <= 392)) {
        return integerMultiDigit(in)
    }

    if ((in >= 393 && in <= 402)) {
        return integerSigned(in)
    }

    if ((in >= 29 && in <= 38) || (in >= 49 && in <= 58) || (in >= 69 && in <= 78) || (in >= 89 && in <= 98) || (in >= 219 && in <= 228) || (in >= 239 && in <= 248) || (in >= 259 && in <= 268) || (in >= 279 && in <= 288)) {
        return integerUpperExponent(in)
    }

    return 0
}
