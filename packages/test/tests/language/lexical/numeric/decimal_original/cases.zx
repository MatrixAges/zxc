import fraction from "./cases/fraction"
import fractionExponentNegative from "./cases/fraction_exponent/negative"
import fractionExponentPositive from "./cases/fraction_exponent/positive"
import fractionExponentUnsigned from "./cases/fraction_exponent/unsigned"
import integerDigit from "./cases/integer_digit"
import integerLowerExponentNegative from "./cases/integer_lower_exponent/negative"
import integerLowerExponentPositive from "./cases/integer_lower_exponent/positive"
import integerLowerExponentUnsigned from "./cases/integer_lower_exponent/unsigned"
import integerMultiDigitDecimal2Digits from "./cases/integer_multi_digit/decimal_2_digits"
import integerMultiDigitDecimal3Digits from "./cases/integer_multi_digit/decimal_3_digits"
import integerMultiDigitLeadingZero2Digits from "./cases/integer_multi_digit/leading_zero_2_digits"
import integerMultiDigitLeadingZero3Digits from "./cases/integer_multi_digit/leading_zero_3_digits"
import integerMultiDigitLeadingZero4Digits from "./cases/integer_multi_digit/leading_zero_4_digits"
import integerSigned from "./cases/integer_signed"
import integerUpperExponentNegative from "./cases/integer_upper_exponent/negative"
import integerUpperExponentPositive from "./cases/integer_upper_exponent/positive"
import integerUpperExponentUnsigned from "./cases/integer_upper_exponent/unsigned"

export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    if ((in >= 99 && in <= 128)) {
        return fraction(in)
    }

    if ((in >= 149 && in <= 168) || in == 371) {
        return fractionExponentNegative(in)
    }

    if ((in >= 169 && in <= 188) || in == 372) {
        return fractionExponentPositive(in)
    }

    if ((in >= 129 && in <= 148) || (in >= 189 && in <= 208)) {
        return fractionExponentUnsigned(in)
    }

    if ((in >= 0 && in <= 9)) {
        return integerDigit(in)
    }

    if ((in >= 39 && in <= 48) || (in >= 229 && in <= 238)) {
        return integerLowerExponentNegative(in)
    }

    if ((in >= 59 && in <= 68) || (in >= 249 && in <= 258)) {
        return integerLowerExponentPositive(in)
    }

    if ((in >= 19 && in <= 28) || (in >= 79 && in <= 88) || (in >= 209 && in <= 218) || (in >= 269 && in <= 278)) {
        return integerLowerExponentUnsigned(in)
    }

    if ((in >= 10 && in <= 18)) {
        return integerMultiDigitDecimal2Digits(in)
    }

    if ((in >= 373 && in <= 392)) {
        return integerMultiDigitDecimal3Digits(in)
    }

    if ((in >= 289 && in <= 290)) {
        return integerMultiDigitLeadingZero2Digits(in)
    }

    if ((in >= 291 && in <= 300) || (in >= 311 && in <= 320) || (in >= 331 && in <= 340) || (in >= 351 && in <= 360)) {
        return integerMultiDigitLeadingZero3Digits(in)
    }

    if ((in >= 301 && in <= 310) || (in >= 321 && in <= 330) || (in >= 341 && in <= 350) || (in >= 361 && in <= 370)) {
        return integerMultiDigitLeadingZero4Digits(in)
    }

    if ((in >= 393 && in <= 402)) {
        return integerSigned(in)
    }

    if ((in >= 49 && in <= 58) || (in >= 239 && in <= 248)) {
        return integerUpperExponentNegative(in)
    }

    if ((in >= 69 && in <= 78) || (in >= 259 && in <= 268)) {
        return integerUpperExponentPositive(in)
    }

    if ((in >= 29 && in <= 38) || (in >= 89 && in <= 98) || (in >= 219 && in <= 228) || (in >= 279 && in <= 288)) {
        return integerUpperExponentUnsigned(in)
    }

    return 0
}
