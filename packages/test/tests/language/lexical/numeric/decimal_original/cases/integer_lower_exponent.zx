export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 19:
            return 0e1
        case 20:
            return 1e1
        case 21:
            return 2e1
        case 22:
            return 3e1
        case 23:
            return 4e1
        case 24:
            return 5e1
        case 25:
            return 6e1
        case 26:
            return 7e1
        case 27:
            return 8e1
        case 28:
            return 9e1
        case 39:
            return 0e-1
        case 40:
            return 1e-1
        case 41:
            return 2e-1
        case 42:
            return 3e-1
        case 43:
            return 4e-1
        case 44:
            return 5e-1
        case 45:
            return 6e-1
        case 46:
            return 7e-1
        case 47:
            return 8e-1
        case 48:
            return 9e-1
        case 59:
            return 0e+1
        case 60:
            return 1e+1
        case 61:
            return 2e+1
        case 62:
            return 3e+1
        case 63:
            return 4e+1
        case 64:
            return 5e+1
        case 65:
            return 6e+1
        case 66:
            return 7e+1
        case 67:
            return 8e+1
        case 68:
            return 9e+1
        case 79:
            return 0e0
        case 80:
            return 1e0
        case 81:
            return 2e0
        case 82:
            return 3e0
        case 83:
            return 4e0
        case 84:
            return 5e0
        case 85:
            return 6e0
        case 86:
            return 7e0
        case 87:
            return 8e0
        case 88:
            return 9e0
        case 209:
            return 0e01
        case 210:
            return 1e01
        case 211:
            return 2e01
        case 212:
            return 3e01
        case 213:
            return 4e01
        case 214:
            return 5e01
        case 215:
            return 6e01
        case 216:
            return 7e01
        case 217:
            return 8e01
        case 218:
            return 9e01
        case 229:
            return 0e-01
        case 230:
            return 1e-01
        case 231:
            return 2e-01
        case 232:
            return 3e-01
        case 233:
            return 4e-01
        case 234:
            return 5e-01
        case 235:
            return 6e-01
        case 236:
            return 7e-01
        case 237:
            return 8e-01
        case 238:
            return 9e-01
        case 249:
            return 0e+01
        case 250:
            return 1e+01
        case 251:
            return 2e+01
        case 252:
            return 3e+01
        case 253:
            return 4e+01
        case 254:
            return 5e+01
        case 255:
            return 6e+01
        case 256:
            return 7e+01
        case 257:
            return 8e+01
        case 258:
            return 9e+01
        case 269:
            return 0e00
        case 270:
            return 1e00
        case 271:
            return 2e00
        case 272:
            return 3e00
        case 273:
            return 4e00
        case 274:
            return 5e00
        case 275:
            return 6e00
        case 276:
            return 7e00
        case 277:
            return 8e00
        case 278:
            return 9e00
        default:
            return 0
    }
}
