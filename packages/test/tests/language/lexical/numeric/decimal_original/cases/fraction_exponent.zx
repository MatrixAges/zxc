            return 6.6E+1
        case 186:
            return 7.7E+1
        case 187:
            return 8.8E+1
        case 188:
            return 9.9E+1
        case 189:
            return 0.0e0
        case 190:
            return 1.1e0
        case 191:
            return 2.2e0
        case 192:
            return 3.3e0
        case 193:
            return 4.4e0
        case 194:
            return 5.5e0
        case 195:
