export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 129:
            return 0.0e1
        case 130:
            return 1.1e1
        case 131:
            return 2.2e1
        case 132:
            return 3.3e1
        case 133:
            return 4.4e1
