export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 393:
            return -123456789_0
        case 394:
            return -123456789_1
        case 395:
            return -123456789_2
        case 396:
            return -123456789_3
        case 397:
            return -123456789_4
        case 398:
            return -123456789_5
        case 399:
            return -123456789_6
        case 400:
            return -123456789_7
        case 401:
            return -123456789_8
        case 402:
            return -123456789_9
        default:
            return 0
    }
}
