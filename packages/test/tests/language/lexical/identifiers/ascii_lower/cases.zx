export type Input = { selector: u64
 value: u64 }

export type Output = u64

export default function (in: Input): Output {
  switch (in.selector) {
    case 0:
      const a = in.value

      return a
    case 1:
      const b = in.value

      return b
    case 2:
      const c = in.value

      return c
    case 3:
      const d = in.value

      return d
    case 4:
      const e = in.value

      return e
    case 5:
      const f = in.value

      return f
    case 6:
      const g = in.value

      return g
    case 7:
      const h = in.value

      return h
    case 8:
      const i = in.value

      return i
    case 9:
      const j = in.value

      return j
    case 10:
      const k = in.value

      return k
    case 11:
      const l = in.value

      return l
    case 12:
      const m = in.value

      return m
    case 13:
      const n = in.value

      return n
    case 14:
      const o = in.value

      return o
    case 15:
      const p = in.value

      return p
    case 16:
      const q = in.value

      return q
    case 17:
      const r = in.value

      return r
    case 18:
      const s = in.value

      return s
    case 19:
      const t = in.value

      return t
    case 20:
      const u = in.value

      return u
    case 21:
      const v = in.value

      return v
    case 22:
      const w = in.value

      return w
    case 23:
      const x = in.value

      return x
    case 24:
      const y = in.value

      return y
    case 25:
      const z = in.value

      return z
    default:
      return 0
  }
}
