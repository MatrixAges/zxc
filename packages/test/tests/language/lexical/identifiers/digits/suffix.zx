export type Input = {
  selector: u64
  v0: u64
  v1: u64
  v2: u64
  v3: u64
  v4: u64
  v5: u64
  v6: u64
  v7: u64
  v8: u64
  v9: u64
}

export type Output = u64

export default function (in: Input): Output {
  const a0 = in.v0
  const a1 = in.v1
  const a2 = in.v2
  const a3 = in.v3
  const a4 = in.v4
  const a5 = in.v5
  const a6 = in.v6
  const a7 = in.v7
  const a8 = in.v8
  const a9 = in.v9

  switch (in.selector) {
    case 0:
      return a0
    case 1:
      return a1
    case 2:
      return a2
    case 3:
      return a3
    case 4:
      return a4
    case 5:
      return a5
    case 6:
      return a6
    case 7:
      return a7
    case 8:
      return a8
    case 9:
      return a9
    default:
      return 0
  }
}
