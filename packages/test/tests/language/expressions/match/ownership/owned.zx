import make from "./helpers/make"
import other from "./helpers/other"

export type Input = { choice: bool
 value: u64 }

export type Output = u64[]

export default function (in: Input): Output {
  const values = match in.choice { true => make(in.value), _ => other(in.value) }

  const [next, _] = values.reverse()

  return next
}
