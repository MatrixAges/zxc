import { State } from "./types"
import type { Code } from "./types"
import choose from "./nested/choose"
import probe from "./nested/probe"

export type Input = { state: Code
 items: u64[] }

export type Output = u64

export default function (in: Input): Output {
  return match choose(in.state) { State.First => 11, probe(in.items) => 22, _ => 33 }
}
