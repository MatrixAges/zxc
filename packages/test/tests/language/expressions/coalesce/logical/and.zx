export type Input = { group: u8
 value: bool?
 left: bool
 right: bool }

export type Output = bool

export default function (in: Input): Output {
  switch (in.group) {
    case 0: return (in.value ?? in.left) && in.right

    case 1: return in.value ?? (in.left && in.right)

    case 2: return in.left && (in.value ?? in.right)

    default: return false
  }
}
