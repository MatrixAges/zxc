import { map, reduce } from "std:utils"

export type Input = { kind: u64
 items: i64[]
 seed: i64 }

export type Output = i64[]

export default function (in: Input): Output {
  switch (in.kind) {
    case 0:
      return map(in.items, x => x)
    case 1:
      return map(in.items, x =>
x)
    case 2:
      return map(in.items, (x) => x)
    case 3:
      return map(in.items, (x) =>
x)
    case 4:
      return map(in.items, x =>x)
    case 5:
      return map(in.items, (x) =>x)
    case 6:
      return map(in.items, x =>
x)
    case 7:
      return map(in.items, (x) =>
x)
    case 8:
      return map(in.items, a => a + 1)
    case 9:
      return [reduce(in.items, (a, b) => a + b, in.seed)]
    default:
      return []
  }
}
