export type Input = { kind: u64
 items: i64[]
 seed: i64 }

export type Output = i64[]

export default function (in: Input): Output {
  switch (in.kind) {
    case 0:
      return in.items.map(x => x)[0]
    case 1:
      return in.items.map(x =>
x)[0]
    case 2:
      return in.items.map((x) => x)[0]
    case 3:
      return in.items.map((x) =>
x)[0]
    case 4:
      return in.items.map(x =>
x)[0]
    case 5:
      return in.items.map((x) =>
x)[0]
    case 6:
      return in.items.map(x =>
x)[0]
    case 7:
      return in.items.map((x) =>
x)[0]
    case 8:
      return in.items.map(a => a + 1)[0]
    case 9:
      return [in.items.reduce((a, b) => a + b, in.seed)[1]]
    default:
      return []
  }
}
