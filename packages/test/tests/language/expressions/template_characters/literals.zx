export type Input = u64

export type Output = string

export default function (in: Input): Output {
  switch (in) {
    case 0:
      return `\"`
    case 1:
      return `\\`
    case 2:
      return `\n`
    case 3:
      return `\r`
    case 4:
      return `\t`
    case 5:
      return `\``
    case 6:
      return `a`
    case 7:
      return `$`
    case 8:
      return `test`
    case 9:
      return `᠎`
    default:
      return ""
  }
}
