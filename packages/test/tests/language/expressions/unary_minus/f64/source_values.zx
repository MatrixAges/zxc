export type Input = u64;

export type Output = f64;

export default function (in: Input): Output {
  const x = -1.0;
  const object = { prop: 1.0 };

  switch (in) {
    case 0: return -1;
    case 1: return -(-1);
    case 2: return -x;
    case 3: return -(-x);
    case 4: return -object.prop;
    default: return 0;
  }
}
