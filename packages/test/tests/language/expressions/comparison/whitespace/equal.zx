export type Input = { shape: u64
 value: f64 }

export type Output = bool

export default function (in: Input): Output {
  switch (in.shape) {
    case 0: return in.value	== 1

    case 1: return in.value ==	1

    case 2: return in.value	==	1

    case 3: return in.value== 1

    case 4: return in.value ==1

    case 5: return in.value==1

    case 6: return in.value== 1

    case 7: return in.value ==1

    case 8: return in.value==1

    case 9: return in.value == 1

    case 10: return in.value == 1

    case 11: return in.value == 1

    case 12: return in.value
== 1

    case 13: return in.value ==
1

    case 14: return in.value
==
1

    case 15: return in.value== 1

    case 16: return in.value ==1

    case 17: return in.value==1

    default: return false
  }
}
