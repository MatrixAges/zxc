import greater from "./whitespace/greater"
import greaterEqual from "./whitespace/greater_equal"
import less from "./whitespace/less"
import lessEqual from "./whitespace/less_equal"

export type Input = { shape: u64
 value: f64 }

export type Output = bool

export default function (in: Input): Output {
    return less(in) || greater(in) || lessEqual(in) || greaterEqual(in)
}
