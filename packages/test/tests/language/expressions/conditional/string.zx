export type Input = u8

export type Output = string

export default function (in: Input): Output {
  switch (in) {
    case 0: return false ? "" : "1"

    case 1: return false ? "1" : ""

    case 2: return true ? "" : "1"

    case 3: return true ? "1" : ""

    default: return false ? "" : "1"
  }
}
