export type Input = u64

export type Output = string

export default function (in: Input): Output {
  switch (in) {
    case 0:
      return `foo ${5} bar`
    case 1:
      return `foo ${"string"} bar`
    case 2:
      return `${0} ${5} bar`
    case 3:
      return `${0} ${"string"} bar`
    case 4:
      return `${0} ${1} ${5} bar`
    case 5:
      return `${0} ${1} ${"string"} bar`
    default:
      return ""
  }
}
