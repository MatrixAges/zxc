export type Input = { left: f64, right: f64, shape: u8 }

export type Output = { scalar: f64, field: f64, element: f64 }

export default function (in: Input): Output {
    const initial = { scalar: in.left, box: { value: in.left }, values: [in.left], right: in.right, round: 0, shape: in.shape }

    const result = loop(initial, {
        while: state => state.round < 1,
        next: state => {
            switch (state.shape) {
                case 0:
                    state.scalar	-= state.right
                    state.box.value	-= state.right
                    state.values[0]	-= state.right
                case 1:
                    state.scalar -=	state.right
                    state.box.value -=	state.right
                    state.values[0] -=	state.right
                case 2:
                    state.scalar	-=	state.right
                    state.box.value	-=	state.right
                    state.values[0]	-=	state.right
                case 3:
                    state.scalar-= state.right
                    state.box.value-= state.right
                    state.values[0]-= state.right
                case 4:
                    state.scalar -=state.right
                    state.box.value -=state.right
                    state.values[0] -=state.right
                case 5:
                    state.scalar-=state.right
                    state.box.value-=state.right
                    state.values[0]-=state.right
                case 6:
                    state.scalar-= state.right
                    state.box.value-= state.right
                    state.values[0]-= state.right
                case 7:
                    state.scalar -=state.right
                    state.box.value -=state.right
                    state.values[0] -=state.right
                case 8:
                    state.scalar-=state.right
                    state.box.value-=state.right
                    state.values[0]-=state.right
                case 9:
                    state.scalar -= state.right
                    state.box.value -= state.right
                    state.values[0] -= state.right
                case 10:
                    state.scalar -= state.right
                    state.box.value -= state.right
                    state.values[0] -= state.right
                case 11:
                    state.scalar -= state.right
                    state.box.value -= state.right
                    state.values[0] -= state.right
                case 12:
                    state.scalar
-= state.right
                    state.box.value
-= state.right
                    state.values[0]
-= state.right
                case 13:
                    state.scalar -=
state.right
                    state.box.value -=
state.right
                    state.values[0] -=
state.right
                case 14:
                    state.scalar
-=
state.right
                    state.box.value
-=
state.right
                    state.values[0]
-=
state.right
                case 15:
                    state.scalar-= state.right
                    state.box.value-= state.right
                    state.values[0]-= state.right
                case 16:
                    state.scalar -=state.right
                    state.box.value -=state.right
                    state.values[0] -=state.right
                case 17:
                    state.scalar-=state.right
                    state.box.value-=state.right
                    state.values[0]-=state.right
            }

            state.round += 1
        }
    })

    return { scalar: result.scalar, field: result.box.value, element: result.values[0] }
}
