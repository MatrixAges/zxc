{"path":"test/language/expressions/logical-and/S11.11.1_A2.4_T1.js","sha256":"05cacd938ba6c315f0d339c5beb6cfaa0ce023ea57bce3753c81bfeb1518d043","status":"adapted","reason":"原两项赋值表达式在 ZX 语法阶段精确拒绝，不宣称执行共享变量写入。其适用的首操作数先求值、仅在需要时执行第二操作数，以 fallible 原生探针实际记录 LR/RL 和单次 L 调用，并检查结果；交换源码顺序也交换轨迹，避免仅按函数名固定先后。赋值状态变化本身是明确的设计差异。","contract":"packages/core/IR契约.md#表达式与求值","cases":["logical_order/and/LR/left_true/right_true/fail_left_false/fail_right_false","logical_order/and/RL/left_true/right_true/fail_left_false/fail_right_false","logical_order/and/LR/left_false/right_true/fail_left_false/fail_right_true","language/types/logical_assignment/and/left_assignment","language/types/logical_assignment/and/right_assignment"],"assertions":[{"case":"logical_order/and/LR/left_true/right_true/fail_left_false/fail_right_false","field":"trace","expected":"LR"},{"case":"logical_order/and/LR/left_true/right_true/fail_left_false/fail_right_false","field":"value","expected":true},{"case":"logical_order/and/RL/left_true/right_true/fail_left_false/fail_right_false","field":"trace","expected":"RL"},{"case":"logical_order/and/RL/left_true/right_true/fail_left_false/fail_right_false","field":"value","expected":true},{"case":"logical_order/and/LR/left_false/right_true/fail_left_false/fail_right_true","field":"trace","expected":"L"},{"case":"logical_order/and/LR/left_false/right_true/fail_left_false/fail_right_true","field":"value","expected":false}],"diagnostics":[{"case":"language/types/logical_assignment/and/left_assignment","phase":"parse","code":"syntax","span":[136,137]},{"case":"language/types/logical_assignment/and/right_assignment","phase":"parse","code":"syntax","span":[141,142]}]}
