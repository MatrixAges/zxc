{"path":"test/language/expressions/logical-or/S11.11.2_A4_T2.js","sha256":"8ffc6d8e9b8a9ae8df7edcf34fe2a8db58f9449a40792317ceb4d06dc438faa7","status":"adapted","reason":"非零 number 左值保留自身，以及包装零/NaN对象仍 truthy 的行为，均不能用 bool 真值表替代；ZX 对数值逻辑操作静态拒绝。Number 包装构造与对象身份明确不适用。","contract":"packages/core/IR契约.md#表达式与求值","cases":["language/types/logical_or/left/false/number","language/types/logical_or/left/true/number","language/types/logical_or/right/false/number","language/types/logical_or/right/true/number"],"diagnostics":[{"case":"language/types/logical_or/left/false/number","phase":"analyze","code":"type_mismatch"},{"case":"language/types/logical_or/left/true/number","phase":"analyze","code":"type_mismatch"},{"case":"language/types/logical_or/right/false/number","phase":"analyze","code":"type_mismatch"},{"case":"language/types/logical_or/right/true/number","phase":"analyze","code":"type_mismatch"}],"assertions":[]}
