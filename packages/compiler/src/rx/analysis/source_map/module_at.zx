export type Input = {
    ends: u64[],
    offset: u64
}

export type Output = u64

export default function (in: Input): Output {
    return loop({
        first: 0,
        end: in.ends.length
    }, {
        while: state => state.first < state.end,
        next: state => {
            const middle = state.first + (state.end - state.first) / 2

            if (in.offset < in.ends[middle]) {
                state.end = middle
            } else {
                state.first = middle + 1
            }
        },
        return: state => state.first
    })
}
