export type Input = {
    native_modules: u64,
    original_native_modules: u64,
    initializers: u64,
    original_initializers: u64,
    functions: u64,
    original_functions: u64,
    lowered_functions?: u64
}

export type Output = bool

export default function (in: Input): Output {
    if (in.native_modules != in.original_native_modules) {
        return false
    }

    if (in.initializers != in.original_initializers) {
        return false
    }

    const { lowered_functions } = in

    return lowered_functions == null ||
        lowered_functions == in.original_functions ||
        in.functions == in.original_functions
}
