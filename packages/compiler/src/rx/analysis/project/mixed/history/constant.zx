import equal from "../../../../../zx/analysis/constants/value_equal"

import type { ConstantPair } from "./link_model"

export type Input = ConstantPair

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    const same_type = left.value.type_id == right.value.type_id

    return left.name == right.name && same_type && equal({
        left: left.value,
        right: right.value
    })
}
