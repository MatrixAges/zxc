import type { MemberPair } from "./link_model"

export type Input = MemberPair

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    const namespace = left.namespace == right.namespace
    const input = left.input_type == right.input_type
    const output = left.output_type == right.output_type
    const intrinsic = left.intrinsic == right.intrinsic

    return (
        - namespace
        - and left.name == right.name
        - and left.id == right.id
        - and input
        - and output
        - and intrinsic
    )
}
