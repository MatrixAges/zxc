import type { Pair } from "./link_model"

export type Input = Pair

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    const input = left.input_type == right.input_type
    const output = left.output_type == right.output_type
    const callable = left.function == right.function

    return input && output && callable
}
