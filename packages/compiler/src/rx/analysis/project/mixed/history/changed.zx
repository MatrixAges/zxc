export type Input = {
    dependencies: u64[],
    redone: bool[]
}

export type Output = bool

export default function (in: Input): Output {
    const { dependencies, redone } = in

    return loop({
        position: 0,
        changed: false
    }, {
        while: state => state.position < dependencies.length && !state.changed,
        next: state => {
            state.changed = redone[dependencies[state.position]]
            state.position += 1
        },
        return: state => state.changed
    })
}
