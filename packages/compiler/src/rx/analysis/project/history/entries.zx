import bytes from "std:bytes"

export type Input = {
    earlier: string[],
    current: string[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.earlier.length != in.current.length) {
        return false
    }

    return loop({
        position: 0,
        equal: true
    }, {
        while: state => state.equal && state.position < in.earlier.length,
        next: state => {
            const position = state.position
            const earlier = bytes.fromText(in.earlier[position])
            const current = bytes.fromText(in.current[position])

            state.equal = bytes.equals(earlier, current)
            state.position += 1
        },
        return: state => state.equal
    })
}
