import sort from "./sort"

export type Input = {
    order: u64[],
    depths: u64[],
    count: u64,
    first_end: u64
}

export type Output = u64[]

export default function (in: Input): Output {
    const { order, depths, first_end, count } = in

    const scan = loop({
        position: 0,
        max_depth: 0,
        previous: 0,
        sorted: true
    }, {
        while: state => state.position < count,
        next: state => {
            const depth = depths[order[state.position]]

            if (depth > state.max_depth) {
                state.max_depth = depth
            }

            if (state.position != first_end && depth < state.previous) {
                state.sorted = false
            }

            state.previous = depth
            state.position += 1
        }
    })

    if (scan.sorted) {
        return order
    }

    return sort({
        order,
        depths,
        first_end,
        count,
        size: scan.max_depth + 1
    })
}
