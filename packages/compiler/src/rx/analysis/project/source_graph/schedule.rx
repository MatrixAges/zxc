<Module>
    <Type from="model" as="SourceSchedule" />
    <Type from="../../../dependency_graph/model" as="Graph" />

    <Args in={SourceSchedule.Input} out={SourceSchedule.Output} />

    <Call
        fn="../../../dependency_graph/walk"
        in={{
            offsets: $in.offsets,
            ends: $in.ends,
            targets: $in.targets,
            issues: [],
            root: null,
            roots: $in.roots,
            ranked: true
        }}
    />

    <If on={$ctx.walk.issue != Graph.Issue.None}>
        <Return
            value={{
                order: [],
                count: 0,
                batch_ends: [],
                cycle: {
                    owner: $ctx.walk.owner,
                    edge: $ctx.walk.edge
                }
            }}
        />
    </If>

    <Call
        fn="rank"
        in={{
            order: $ctx.walk.order,
            depths: $ctx.walk.depths,
            count: $ctx.walk.count,
            first_end: $ctx.walk.first_end
        }}
    />

    <Call
        fn="batches"
        in={{
            order: $ctx.rank,
            depths: $ctx.walk.depths,
            count: $ctx.walk.count
        }}
    />

    <Return
        value={{
            order: $ctx.rank,
            count: $ctx.walk.count,
            batch_ends: $ctx.batches,
            cycle: null
        }}
    />
</Module>
