import { Mark } from "./model"

import type { Input as Graph, Cycle } from "./model"

export type Input = Graph

export type Output = {
    order: u64[],
    depths: u64[],
    count: u64,
    first_end: u64,
    cycle?: Cycle
}

export default function (in: Input): Output {
    const cycle: Cycle? = null

    return loop({
        marks: in.offsets.map(offset => Mark.Unseen)[0],
        depths: in.offsets.map(offset => 0)[0],
        cursors: in.offsets.map(offset => offset)[0],
        frames: in.offsets.map(offset => 0)[0],
        order: in.offsets.map(offset => 0)[0],
        root: 0,
        height: 0,
        count: 0,
        first_end: 0,
        cycle
    }, {
        while: state => state.cycle == null &&
            (state.root < in.roots.length || state.height != 0),
        next: state => {
            if (state.height == 0) {
                if (state.root == 1) {
                    state.first_end = state.count
                }

                const root = in.roots[state.root]

                if (state.marks[root] == Mark.Unseen) {
                    state.marks[root] = Mark.Visiting
                    state.frames[0] = root
                    state.height = 1
                }

                state.root += 1
            } else {
                const owner = state.frames[state.height - 1]
                const edge = state.cursors[owner]

                if (edge == in.offsets[owner + 1]) {
                    state.marks[owner] = Mark.Done
                    state.order[state.count] = owner
                    state.count += 1
                    state.height -= 1

                    if (state.height != 0) {
                        const parent = state.frames[state.height - 1]
                        const depth = state.depths[owner] + 1

                        if (depth > state.depths[parent]) {
                            state.depths[parent] = depth
                        }
                    }
                } else {
                    const target = in.targets[edge]

                    state.cursors[owner] += 1

                    if (state.marks[target] == Mark.Unseen) {
                        state.marks[target] = Mark.Visiting
                        state.frames[state.height] = target
                        state.height += 1
                    } else {
                        if (state.marks[target] == Mark.Visiting) {
                            state.cycle = {
                                owner,
                                edge
                            }
                        } else {
                            const depth = state.depths[target] + 1

                            if (depth > state.depths[owner]) {
                                state.depths[owner] = depth
                            }
                        }
                    }
                }
            }
        },
        return: state => ({
            order: state.order,
            depths: state.depths,
            count: state.count,
            first_end: in.roots.length == 1 ? state.count : state.first_end,
            cycle: state.cycle
        })
    })
}
