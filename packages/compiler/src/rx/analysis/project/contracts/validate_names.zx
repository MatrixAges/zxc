import bytes from "std:bytes"

import type { Declaration } from "../../../../zx/frontend/parser/declarations/model"

export type Input = {
    text: u8[],
    expected: string[],
    declarations: Declaration[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.declarations.length != in.expected.length) {
        return false
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.expected.length,
        next: state => {
            const span = in.declarations[state.index].name
            const name = in.expected[state.index]
            const size = bytes.fromText(name).length

            state.valid = span.end - span.start == size &&
                bytes.startsWithText(in.text, span.start, name)
            state.index += 1
        },
        return: state => state.valid
    })
}
