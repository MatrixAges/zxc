<Module>
    <Type from="model" as="Signature" />

    <Args in={Signature.Stage} out={Signature.Stage} />

    <Switch on={$in}>
        <Case value={Signature.Stage.Start}>
            <Return value={Signature.Stage.Bindings} />
        </Case>

        <Case value={Signature.Stage.Bindings}>
            <Return value={Signature.Stage.Tasks} />
        </Case>

        <Case value={Signature.Stage.Tasks}>
            <Return value={Signature.Stage.Input} />
        </Case>

        <Case value={Signature.Stage.Input}>
            <Return value={Signature.Stage.Output} />
        </Case>

        <Default>
            <Return value={Signature.Stage.Done} />
        </Default>
    </Switch>
</Module>
