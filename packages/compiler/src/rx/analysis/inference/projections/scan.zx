import integers from "std:integer"

import representative from "../forest/borrowed_root"
import { Kind } from "../unification/model"

import type { U32Buffer } from "std:memory"
import type { Kind as ShapeKind } from "../unification/model"

export enum Mode {
    Length,
    PendingLength,
    Index,
    DefaultIndex
}

export type Input = {
    targets: u32[],
    resolved: bool[],
    kinds: ShapeKind[],
    parents: U32Buffer,
    mode: Mode,
    start: u64
}

export type Output = {
    row: u64,
    root: u64,
    found: bool
}

export default function (in: Input): Output {
    return loop({
        row: in.start,
        root: 0,
        found: false
    }, {
        while: state => !state.found && state.row < in.targets.length,
        next: state => {
            const row = state.row
            const mode = in.mode

            if (mode != Mode.Index || !in.resolved[row]) {
                const root = representative({
                    parents: in.parents,
                    value: in.targets[row]
                })
                const kind = in.kinds[integers.widen(root)]
                const pending = kind == Kind.Unknown

                state.root = integers.widen(root)
                state.found = match mode {
                    Mode.PendingLength => pending,
                    Mode.DefaultIndex => pending,
                    Mode.Index => !pending && kind != Kind.Sequence,
                    _ => !pending
                }
            }

            if (!state.found) {
                state.row += 1
            }
        },
        return: state => state
    })
}
