import integers from "std:integer"

import root from "./root"

import type { Kind } from "../../unification/model"
import type { Edges } from "../model"

export type Input = {
    payloads: u32[],
    kinds: Kind[],
    edges: Edges
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty_rank: u8 = 0

    return loop({
        parents: in.kinds.map((kind, index) => integers.narrow(index))[0],
        ranks: in.kinds.map(kind => empty_rank)[0],
        edge: 0,
        index: 0
    }, {
        while: state => state.edge < in.edges.left.length ||
            state.index < state.parents.length,
        next: state => {
            if (state.edge == in.edges.left.length) {
                state.parents[state.index] = root({
                    parents: state.parents,
                    item: integers.narrow(state.index)
                })
                state.index += 1
            } else {
                const source = in.edges.left[state.edge]
                const target = in.edges.right[state.edge]
                const left_root = root({
                    parents: state.parents,
                    item: in.payloads[integers.widen(source)]
                })
                const right_root = root({
                    parents: state.parents,
                    item: in.payloads[integers.widen(target)]
                })

                const left = integers.widen(left_root)
                const right = integers.widen(right_root)

                if (left != right) {
                    const left_rank = state.ranks[left]
                    const right_rank = state.ranks[right]

                    if (left_rank < right_rank) {
                        state.parents[left] = right_root
                    } else {
                        state.parents[right] = left_root

                        if (left_rank == right_rank) {
                            state.ranks[left] += 1
                        }
                    }
                }

                state.edge += 1
            }
        },
        return: state => state.parents
    })
}
