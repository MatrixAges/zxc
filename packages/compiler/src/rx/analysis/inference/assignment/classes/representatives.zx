import integers from "std:integer"

import { Kind } from "../../unification/model"

import type { Nodes } from "../model"
import type { Output as Classes } from "./model"

export type Input = {
    parents: u32[],
    payloads: u32[],
    nodes: Nodes
}

export type Output = Classes

export default function (in: Input): Output {
    const parents = in.parents
    const empty: u32? = null

    const representatives = loop({
        values: in.parents.map(item => empty)[0],
        index: 0
    }, {
        while: state => state.index < in.payloads.length,
        next: state => {
            const payload = in.payloads[state.index]
            const index = integers.widen(payload)

            if (
                in.nodes.kinds[index] != Kind.Unknown ||
                    in.nodes.allowed[index] != null
            ) {
                const parent = parents[index]

                state.values[integers.widen(parent)] = payload
            }

            state.index += 1
        },
        return: state => state.values
    })

    return {
        parents,
        representatives
    }
}
