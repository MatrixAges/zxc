import integers from "std:integer"

import type { Output as Classes } from "./model"

export type Input = {
    parents: u32[],
    payloads: u32[],
    candidates: bool[]
}

export type Output = Classes

export default function (in: Input): Output {
    const parents = in.parents
    const empty: u32? = null

    const representatives = loop({
        values: in.parents.map(item => empty)[0],
        index: 0
    }, {
        while: state => state.index < in.payloads.length,
        next: state => {
            if (in.candidates[state.index]) {
                const payload = in.payloads[state.index]

                const parent = parents[integers.widen(payload)]

                state.values[integers.widen(parent)] = payload
            }

            state.index += 1
        },
        return: state => state.values
    })

    return {
        parents,
        representatives
    }
}
