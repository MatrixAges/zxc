import integers from "std:integer"

import { Kind } from "../../unification/model"

import type { Nodes, Payloads } from "../model"
import type { Output as Classes } from "./model"

export type Input = {
    parents: u32[],
    payloads: Payloads,
    nodes: Nodes
}

export type Output = Classes

export default function (in: Input): Output {
    const parents = in.parents
    const initial = in.payloads.initial
    const registered = in.payloads.registered
    const empty: u32? = null

    const representatives = loop({
        values: in.parents.map(item => empty)[0],
        index: 0
    }, {
        while: state => state.index < parents.length,
        next: state => {
            const position = state.index
            const payload = match {
                position < initial.length => initial[position],
                _ => registered[position - initial.length]
            }
            const index = integers.widen(payload)

            if (
                in.nodes.kinds[index] != Kind.Unknown ||
                    in.nodes.allowed[index] != null
            ) {
                const parent = parents[index]

                state.values[integers.widen(parent)] = payload
            }

            state.index += 1
        },
        return: state => state.values
    })

    return {
        parents,
        representatives
    }
}
