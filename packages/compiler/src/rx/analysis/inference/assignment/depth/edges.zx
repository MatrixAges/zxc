import integers from "std:integer"
import memory from "std:memory"

import representative from "../../forest/borrowed_root"
import { Kind } from "../../unification/model"

import type { Edges } from "../model"
import type { OptionalRoots } from "./model"

export type Input = OptionalRoots

export type Output = Edges

export default function (in: Input): Output {
    const kinds = in.graph.nodes.kinds
    const left: u32[] = []
    const right: u32[] = []

    return loop({
        left,
        right,
        index: 0
    }, {
        while: state => state.index < kinds.length,
        next: state => {
            const index = state.index

            if (kinds[index] == Kind.Optional) {
                const node = memory.readU32(in.parents, index)

                if (integers.widen(node) == index) {
                    const child = representative({
                        parents: in.parents,
                        value: in.graph.arguments[index]
                    })

                    state.left = state.left.push(child)[0]
                    state.right = state.right.push(node)[0]
                }
            }

            state.index += 1
        },
        return: state => ({
            left: state.left,
            right: state.right
        })
    })
}
