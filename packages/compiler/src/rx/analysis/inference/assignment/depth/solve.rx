<Module>
    <Type from="model" as="OptionalDepth" />

    <Args in={OptionalDepth.Input} out={OptionalDepth.Output} />

    <If on={$in.assignments.left.length == 0 && $in.optionals.left.length == 0}>
        <Call fn="lower" in={$in.graph} />

        <Return
            value={{
                depths: $ctx.lower,
                issue: OptionalDepth.Issue.None,
                position: 0
            }}
        />
    </If>

    <Call fn="settle" in={$in} />

    <Return value={$ctx.settle} />
</Module>
