import type { Edges } from "../model"

export enum Fact {
    Open,
    Optional,
    Exact
}

export enum Issue {
    None,
    Bounds,
    OptionalToRequired,
    Recursive
}

export enum Stage {
    Minimum,
    PinPreferred,
    Maximum,
    PinKnown,
    Final,
    Done
}

export type Input = {
    facts: Fact[],
    depths: u64[],
    assignments: Edges,
    optionals: Edges
}

export type Output = {
    depths: u64[],
    issue: Issue,
    position: u64
}
