import type { Types } from "../../optional/model"
import type { Edges, Nodes } from "../model"

export enum Issue {
    None,
    Bounds,
    OptionalToRequired,
    Recursive
}

export enum Stage {
    Minimum,
    PinPreferred,
    Maximum,
    PinKnown,
    Final,
    Done
}

export type Graph = {
    nodes: Nodes,
    arguments: u32[],
    types: Types
}

export type Input = {
    graph: Graph,
    assignments: Edges,
    optionals: Edges
}

export type Output = {
    depths: u64[],
    issue: Issue,
    position: u64
}
