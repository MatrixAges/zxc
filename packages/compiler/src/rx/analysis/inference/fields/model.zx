import type { Kind } from "../unification/model"

export enum Route {
    Declared,
    Open,
    KnownMember,
    Member,
    MissingMember,
    AppendMember,
    ScalarConflict,
    Length,
    RequireList,
    DeferLength,
    InvalidDeclared,
    InvalidInferred
}

export type Receiver = {
    kind: Kind,
    type_kind: u8,
    type_argument: u32,
    restricted: bool,
    name: string
}

export type Members = {
    names: string[],
    values: u32[]
}

export type Input = {
    receiver: Receiver,
    members: Members
}

export type Lookup = {
    members: Members,
    name: string,
    declared: bool
}

export type Output = {
    route: Route,
    value: u32
}
