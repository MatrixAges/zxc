import type { U32Buffer } from "std:memory"
import type { Kind } from "../../unification/model"

export enum Reach {
    Absent,
    Present,
    Depth
}

export enum Route {
    Empty,
    Select,
    Recursive,
    Depth
}

export type Edges = {
    offsets: u64[],
    children: u32[]
}

export type Reachability = {
    candidates: u32[],
    elements: u32[],
    edges: Edges
}

export type Output = {
    route: Route,
    position: u64
}

export type Graph = {
    parents: U32Buffer,
    kinds: Kind[],
    arguments: u32[],
    members: u32[][]
}

export type Classes = {
    initial: u32[],
    registered: u32[],
    groups: u32[],
    representatives: u32?[]
}

export type Sequences = {
    values: u32[],
    elements: u32[][]
}

export type Input = {
    graph: Graph,
    classes: Classes,
    sequences: Sequences
}
