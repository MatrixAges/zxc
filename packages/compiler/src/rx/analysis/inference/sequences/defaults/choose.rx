<Module>
    <Type from="model" as="SequenceDefault" />

    <Args in={SequenceDefault.Input} out={SequenceDefault.Output} />

    <Call fn="collect" in={$in} />

    <If on={$ctx.collect.pending.length == 0}>
        <Return
            value={{
                route: SequenceDefault.Route.Empty,
                position: 0
            }}
        />
    </If>

    <Call
        fn="expand"
        in={{
            ...$ctx.collect.omit(["pending"]),
            graph: $in.graph,
            classes: $in.classes
        }}
    />

    <If on={$ctx.expand.children.length == 0}>
        <Call
            fn="flat"
            in={{
                ...$ctx.expand.pick([
                    "keys",
                    "buckets"
                ]),
                source: $in,
                pending: $ctx.collect.pending
            }}
        />

        <Return value={$ctx.flat} />
    </If>

    <Call
        fn="positions"
        in={{
            ...$ctx.expand.pick([
                "keys",
                "buckets"
            ]),
            source: $in,
            pending: $ctx.collect.pending
        }}
    />

    <Call
        fn="choose"
        in={{
            ...$ctx.positions,
            edges: $ctx.expand.pick([
                "offsets",
                "children"
            ])
        }}
    />

    <Return
        value={{
            route: $ctx.choose.route,
            position: $ctx.collect.pending[$ctx.choose.position]
        }}
    />
</Module>
