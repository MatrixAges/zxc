import get from "core/integer/index/get"

import canonical from "./canonical"
import { Route } from "./model"

import type { Input as Source, Output as Selection } from "./model"

export type Input = {
    source: Source,
    pending: u64[],
    keys: u32[],
    buckets: u32[]
}

export type Output = Selection

export default function (in: Input): Output {
    const index = {
        count: in.keys.length,
        keys: in.keys,
        buckets: in.buckets
    }

    return loop({
        next: 0,
        position: 0,
        route: Route.Recursive
    }, {
        while: state => state.next < in.pending.length && state.route == Route.Recursive,
        next: state => {
            state.position = in.pending[state.next]

            const key = canonical({
                parents: in.source.graph.parents,
                classes: in.source.classes,
                value: in.source.sequences.values[state.position]
            })
            const previous = get({
                index,
                key
            })

            if (previous == null) {
                state.route = Route.Select
            }

            state.next += 1
        },
        return: state => ({
            route: state.route,
            position: state.position
        })
    })
}
