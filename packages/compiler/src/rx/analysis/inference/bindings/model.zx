import type { U32Buffer } from "std:memory"
import type { Kind } from "../unification/model"

export enum Status {
    Void,
    Pending,
    Value
}

export enum Collision {
    Ignore,
    Defer,
    Conflict
}

export type Graph = {
    kinds: Kind[],
    arguments: u32[]
}

export type Topology = {
    graph: Graph,
    parents: U32Buffer
}

export type Pairs = {
    left: u32[],
    right: u32[],
    final: bool
}

export enum Action {
    Done,
    Conflict,
    Missing,
    Unify
}

export type Input = {
    topology: Topology,
    collisions: Pairs,
    candidates: u32[][],
    start: u64
}

export type Output = {
    action: Action,
    row: u64,
    value: u32
}
