import { Collision, Status } from "./model"
import inspect from "./node"

import type { Collision as CollisionRoute, Topology } from "./model"

export type Input = {
    topology: Topology,
    left: u32,
    right: u32,
    final: bool
}

export type Output = CollisionRoute

export default function (in: Input): Output {
    const left = inspect({
        topology: in.topology,
        value: in.left
    })

    if (left == Status.Void) {
        return Collision.Ignore
    }

    const right = inspect({
        topology: in.topology,
        value: in.right
    })

    const known = left == Status.Value && right == Status.Value

    return match {
        right == Status.Void => Collision.Ignore,
        in.final || known => Collision.Conflict,
        _ => Collision.Defer
    }
}
