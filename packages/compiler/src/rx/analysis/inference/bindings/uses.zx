import { Status } from "./model"
import inspect from "./node"

import type { Topology } from "./model"

export type Input = {
    topology: Topology,
    values: u32[]
}

export type Output = u64?

export default function (in: Input): Output {
    const position: u64? = null

    return loop({
        index: 0,
        position
    }, {
        while: state => state.position == null && state.index < in.values.length,
        next: state => {
            const item = inspect({
                topology: in.topology,
                value: in.values[state.index]
            })

            if (item == Status.Void) {
                state.position = state.index
            }

            state.index += 1
        },
        return: state => state.position
    })
}
