import integers from "std:integer"

import representative from "../forest/borrowed_root"
import status from "./status"

import type { Status, Topology } from "./model"

export type Input = {
    topology: Topology,
    value: u32
}

export type Output = Status

export default function (in: Input): Output {
    const root = representative({
        parents: in.topology.parents,
        value: in.value
    })

    const index = integers.widen(root)
    const graph = in.topology.graph

    return status({
        kind: graph.kinds[index],
        argument: graph.arguments[index]
    })
}
