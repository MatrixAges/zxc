import integers from "std:integer"

import representative from "../forest/representative"
import status from "./status"

import type { Graph, Status } from "./model"

export type Input = {
    graph: Graph,
    parents: u32[],
    value: u32
}

export type Output = {
    parents: u32[],
    status: Status
}

export default function (in: Input): Output {
    const root = representative({
        parents: in.parents,
        value: in.value
    })

    const index = integers.widen(root.item)

    return {
        parents: root.parents,
        status: status({
            kind: in.graph.kinds[index],
            argument: in.graph.arguments[index]
        })
    }
}
