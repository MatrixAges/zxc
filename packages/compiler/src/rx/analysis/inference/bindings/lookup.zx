import { Status } from "./model"
import inspect from "./node"

import type { Topology } from "./model"

export type Input = {
    topology: Topology,
    candidates: u32[]
}

export type Output = {
    selected?: u32,
    multiple: bool
}

export default function (in: Input): Output {
    const selected: u32? = null

    return loop({
        index: 0,
        selected,
        multiple: false
    }, {
        while: state => state.index < in.candidates.length,
        next: state => {
            const candidate = in.candidates[state.index]
            const item = inspect({
                topology: in.topology,
                value: candidate
            })

            if (item != Status.Void) {
                state.multiple = state.multiple || state.selected != null
                state.selected = candidate
            }

            state.index += 1
        },
        return: state => state.omit(["index"])
    })
}
