import { Collision } from "./model"
import pair from "./pair"

import type { Pairs, Topology } from "./model"

export type Input = {
    topology: Topology,
    rows: Pairs
}

export type Output = u64?

export default function (in: Input): Output {
    const position: u64? = null

    return loop({
        index: 0,
        position
    }, {
        while: state => state.position == null && state.index < in.rows.left.length,
        next: state => {
            const result = pair({
                topology: in.topology,
                left: in.rows.left[state.index],
                right: in.rows.right[state.index],
                final: in.rows.final
            })

            if (result == Collision.Conflict) {
                state.position = state.index
            }

            state.index += 1
        },
        return: state => state.position
    })
}
