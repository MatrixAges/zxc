import integers from "std:integer"
import memory from "std:memory"

import type { U32Buffer } from "std:memory"

export type Input = {
    parents: U32Buffer,
    value: u32
}

export type Output = u32

export default function (in: Input): Output {
    const first = memory.readU32(in.parents, integers.widen(in.value))
    const parent = memory.readU32(in.parents, integers.widen(first))

    if (first == parent) {
        return first
    }

    return loop({
        value: in.value,
        parent: first
    }, {
        while: state => state.value != state.parent,
        next: state => {
            const index = integers.widen(state.value)
            const parent_index = integers.widen(state.parent)
            const grandparent = memory.readU32(in.parents, parent_index)

            memory.writeU32(in.parents, index, grandparent)

            state.value = grandparent
            state.parent = memory.readU32(in.parents, integers.widen(grandparent))
        },
        return: state => state.value
    })
}
