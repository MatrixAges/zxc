import integers from "std:integer"

import { Kind } from "../../unification/model"

export type Input = {
    kinds: Kind[],
    keys: u32[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const kinds = in.kinds

    return in.keys.map(key => kinds[integers.widen(key)] == Kind.Known)[0]
}
