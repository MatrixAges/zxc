import integers from "std:integer"

import representative from "../forest/representative"
import { Kind } from "../unification/model"

import type { Kind as ShapeKind } from "../unification/model"

export type Input = {
    targets: u32[],
    kinds: ShapeKind[],
    parents: u32[],
    index?: u64,
    position: u64
}

export type Output = {
    parents: u32[],
    index?: u64
}

export default function (in: Input): Output {
    return loop(in, {
        while: state =>
            state.index == null && state.position < state.targets.length,
        next: state => {
            const root = representative({
                parents: state.parents,
                value: state.targets[state.position]
            })

            state.parents = root.parents

            if (state.kinds[integers.widen(root.item)] == Kind.Unknown) {
                state.index = state.position
            }

            state.position += 1
        },
        return: state => ({
            parents: state.parents,
            index: state.index
        })
    })
}
