import type { Kind as Concrete } from "core/type_table/model"

export enum Kind {
    Unknown,
    Sequence,
    Known,
    Object,
    List,
    Optional,
    Tuple
}

export enum Route {
    Ready,
    Same,
    Depth,
    Recursive,
    Left,
    Right,
    Known,
    Child,
    Tuple,
    Object,
    SequenceMismatch,
    ShapeMismatch,
    TupleMismatch,
    ConcreteMismatch,
    ConcreteObjectMismatch,
    ConcreteContainerMismatch,
    ConcreteTupleMismatch
}

export type Input = {
    left: Kind,
    right: Kind,
    concrete: Concrete,
    left_id: u32,
    right_id: u32,
    left_size: u64,
    right_size: u64
}

export type Output = Route
