import integers from "std:integer"

import { Kind } from "../model"

import type { Graph } from "./model"

export type Input = {
    graph: Graph,
    index: u32
}

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.index)
    const kind = in.graph.kinds[index]

    return match kind {
        Kind.List => true,
        Kind.Optional => true,
        _ => in.graph.members[index].length > 0
    }
}
