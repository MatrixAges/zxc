import type { Kind } from "../model"

export enum Reach {
    Absent,
    Present,
    Depth
}

export type Graph = {
    kinds: Kind[],
    members: u32[][],
    arguments: u32[]
}

export type Query = {
    graph: Graph,
    parents: u32[],
    source: u32,
    target: u32,
    depth: u64
}

export type Result = {
    parents: u32[],
    reach: Reach
}
