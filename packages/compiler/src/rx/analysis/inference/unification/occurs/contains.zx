import integers from "std:integer"
import { max_nesting_depth } from "core/const"

import representative from "../../forest/borrowed_root"
import { Kind } from "../model"
import { Reach } from "./model"

import type { Query } from "./model"

export type Input = Query

export type Output = Reach

export default function contains(in: Input): Output {
    if (in.depth >= max_nesting_depth) {
        return Reach.Depth
    }

    const root = representative({
        parents: in.parents,
        value: in.source
    })

    if (root == in.target) {
        return Reach.Present
    }

    const index = integers.widen(root)
    const kind = in.graph.kinds[index]
    const depth = in.depth + 1

    if (kind == Kind.List || kind == Kind.Optional) {
        return contains({
            graph: in.graph,
            parents: in.parents,
            source: in.graph.arguments[index],
            target: in.target,
            depth
        })
    }

    const children = in.graph.members[index]

    return loop({
        reach: Reach.Absent,
        position: 0
    }, {
        while: state => state.position < children.length && state.reach == Reach.Absent,
        next: state => {
            state.reach = contains({
                graph: in.graph,
                parents: in.parents,
                source: children[state.position],
                target: in.target,
                depth
            })

            state.position += 1
        },
        return: state => state.reach
    })
}
