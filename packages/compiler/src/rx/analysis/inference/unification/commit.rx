<Module>
    <Type from="commit/model" as="Commit" />

    <Args in={Commit.Input} out={Commit.Output} />

    <Call
        fn="../scalar/combine"
        in={$in.pick([
            "left",
            "right"
        ])}
    />

    <Call
        fn="../forest/link"
        in={$in.omit([
            "graph",
            "left",
            "right"
        ])}
    />

    <If on={$ctx.combine.allowed == null}>
        <Return
            value={{
                fallback: $ctx.combine.fallback,
                restriction: null
            }}
        />
    </If>

    <Call
        module="../scalar/restrict"
        in={{
            target: {
                graph: $in.graph,
                node: $in.parent
            },
            requested: $ctx.combine.allowed ?? 0
        }}
    />

    <Return
        value={{
            fallback: $ctx.combine.fallback,
            restriction: $ctx.restrict
        }}
    />
</Module>
