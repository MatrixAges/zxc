export type Input = {
    names: string[],
    name: string
}

export type Output = u64?

export default function (in: Input): Output {
    return loop({
        index: 0
    }, {
        while: state =>
            state.index < in.names.length &&
            in.names[state.index] != in.name,
        next: state => {
            state.index += 1
        },
        return: state => state.index == in.names.length ? null : state.index
    })
}
