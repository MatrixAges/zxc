import { BinaryOperator } from "core/expression_table/kinds"

import classify from "../../../../zx/analysis/analyzer/expressions/operators/classify"
import domain from "./domain"
import { Domain } from "./model"

export enum Route {
    And,
    Or,
    Coalesce,
    Compare,
    Arithmetic
}

export type Input = BinaryOperator

export type Output = {
    route: Route,
    allowed?: u64
}

export default function (in: Input): Output {
    const facts = classify(in)

    const route = match {
        in == BinaryOperator.Coalesce => Route.Coalesce,
        in == BinaryOperator.LogicalAnd => Route.And,
        facts.logical => Route.Or,
        facts.comparison => Route.Compare,
        _ => Route.Arithmetic
    }

    const numeric = route == Route.Arithmetic || route == Route.Compare
    const allowed: u64? = numeric && !facts.equality ? domain(Domain.Numeric) : null

    return {
        route,
        allowed
    }
}
