<Module>
    <Type from="restriction" as="Restriction" />
    <Type from="model" as="Scalar" />

    <Args in={Restriction.Input} out={Restriction.Output} />

    <Call fn="target" in={$in.target} />

    <Call
        fn="intersect"
        in={{
            left: $ctx.target.previous,
            right: $in.requested
        }}
    />

    <If on={($ctx.intersect ?? 0) == 0}>
        <Return
            value={{
                root: $ctx.target.root,
                allowed: 0,
                issue: Scalar.Issue.Empty,
                changed: false
            }}
        />
    </If>

    <Call
        fn="admit"
        in={{
            allowed: $ctx.intersect ?? 0,
            shape: $ctx.target.shape,
            scalar: $ctx.target.scalar
        }}
    />

    <Return
        value={{
            root: $ctx.target.root,
            allowed: $ctx.intersect ?? 0,
            issue: $ctx.admit,
            changed: $ctx.target.previous != $ctx.intersect
        }}
    />
</Module>
