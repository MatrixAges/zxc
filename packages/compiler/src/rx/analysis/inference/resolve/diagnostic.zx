import {
    contract_code,
    depth_limit,
    numeric_mismatch,
    type_mismatch_code,
    unconstrained_input,
    unfinalized_sequence,
    unsupported_code
} from "./const"
import { Route } from "./model"

import type { Diagnostic } from "../../../../zx/analysis/semantic/constructing/model"

export type Input = Route

export type Output = Diagnostic?

export default function (in: Input): Output {
    return match in {
        Route.Depth => ({
            code: unsupported_code,
            message: depth_limit
        }),
        Route.Sequence => ({
            code: contract_code,
            message: unfinalized_sequence
        }),
        Route.Unconstrained => ({
            code: type_mismatch_code,
            message: unconstrained_input
        }),
        Route.NumericMismatch => ({
            code: type_mismatch_code,
            message: numeric_mismatch
        }),
        _ => null
    }
}
