import type { U8Buffer, U32Buffer, U64Buffer } from "std:memory"
import type { Fields, Tables } from "core/type_table/model"
import type { Kind } from "../unification/model"

export enum Route {
    Search,
    Complete,
    List,
    Optional,
    Object,
    Tuple,
    Depth,
    Sequence,
    Unconstrained,
    NumericMismatch
}

export enum Issue {
    Unsupported,
    Contract,
    TypeMismatch
}

export type Diagnostic = {
    issue: Issue,
    message: string
}

export type View = {
    kinds: Kind[],
    arguments: u32[],
    members: u32[][],
    allowed: u16?[],
    fallback: u8?[]
}

export type Publication = {
    kinds: U8Buffer,
    arguments: U32Buffer,
    revision: U64Buffer,
    known_kind: u8
}

export type Request = {
    graph: View,
    publication: Publication,
    parents: u32[],
    frames: u64[],
    values: u32[],
    depth: u64,
    used: u64,
    count: u64,
    node: u32,
    completed?: u32,
    route: Route
}

export type Aggregate = {
    route: Route,
    child: u32,
    children: u32[],
    fields: Fields
}

export type Materialization = {
    tables: Tables,
    aggregate: Aggregate
}
