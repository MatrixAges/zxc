import type { U8Buffer, U32Buffer, U64Buffer } from "std:memory"
import type { Tables } from "core/type_table/model"
import type {
    Publication as TypePublication
} from "../../../../zx/analysis/semantic/constructing/model"
import type { Kind } from "../unification/model"

export enum Route {
    Search,
    Complete,
    List,
    Optional,
    Object,
    Tuple,
    Depth,
    Sequence,
    Unconstrained,
    NumericMismatch
}

export type View = {
    kinds: Kind[],
    arguments: u32[],
    members: u32[][],
    allowed: u16?[],
    fallback: u8?[]
}

export type Publication = {
    kinds: U8Buffer,
    arguments: U32Buffer,
    revision: U64Buffer,
    known_kind: u8
}

export type Request = {
    graph: View,
    publication: Publication,
    parents: u32[],
    frames: u64[],
    values: u32[],
    depth: u64,
    used: u64,
    count: u64,
    node: u32,
    completed?: u32,
    route: Route
}

export type Pending = {
    route: Route,
    child: u32,
    values: u32[],
    start: u64,
    count: u64,
    names: string[]
}

export type Continuation = {
    tables: Tables,
    pending: Pending
}

export type Continued = TypePublication & {
    graph_issue: bool
}
