import { Kind } from "core/type_table/model"

import { Route } from "./model"

import type { Candidate } from "../../../../zx/analysis/semantic/types/model"
import type { Pending } from "./model"

export type Input = Pending

export type Output = Candidate

export default function (in: Input): Output {
    const kind = match in.route {
        Route.List => Kind.List,
        Route.Optional => Kind.Optional,
        Route.Tuple => Kind.Tuple,
        _ => Kind.Object
    }

    const members = in.values.splice(in.start, in.count, [])[1]
    const empty: u32[] = []

    return {
        kind,
        first: in.child,
        second: 0,
        label: "",
        children: kind == Kind.Tuple ? members : empty,
        fields: {
            names: in.names,
            types: kind == Kind.Object ? members : empty
        },
        names: []
    }
}
