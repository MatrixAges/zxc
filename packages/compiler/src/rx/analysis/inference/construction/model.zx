export enum Kind {
    Absent,
    Named,
    Open,
    AmbiguousNamed,
    AmbiguousOpen
}

export enum Action {
    Skip,
    Bind,
    Infer,
    Ambiguous,
    Missing
}

export enum Gate {
    Always,
    Required,
    Constrained
}

export type Parts = {
    explicit: string?[],
    fields: string[][],
    roots: u64[],
    open: bool[],
    aliases: bool[]
}

export type Candidate = {
    part: u64,
    field: u64,
    kind: Kind
}

export type Candidates = {
    parts: u64[],
    fields: u64[],
    kinds: Kind[]
}

export type Input = {
    parts: Parts,
    names: string[],
    final: bool
}

export type Output = {
    parts: u64[],
    fields: u64[],
    kinds: Kind[],
    named: Action,
    ambiguous: Action,
    open: Action,
    absent: Action,
    open_gate: Gate,
    absent_gate: Gate
}
