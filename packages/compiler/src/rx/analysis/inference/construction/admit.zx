import { Action, Gate } from "./model"

export type Input = bool

export type Output = {
    named: Action,
    ambiguous: Action,
    open: Action,
    absent: Action,
    open_gate: Gate,
    absent_gate: Gate
}

export default function (in: Input): Output {
    return {
        named: Action.Bind,
        ambiguous: in ? Action.Ambiguous : Action.Skip,
        open: Action.Infer,
        absent: in ? Action.Missing : Action.Skip,
        open_gate: in ? Gate.Required : Gate.Constrained,
        absent_gate: Gate.Required
    }
}
