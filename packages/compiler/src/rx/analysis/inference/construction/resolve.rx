<Module>
    <Type from="model" as="Construction" />

    <Args in={Construction.Input} out={Construction.Output} />

    <Call fn="search_all" in={$in.omit(["final"])} />
    <Call fn="admit" in={$in.final} />

    <Return
        value={{
            ...$ctx.search_all,
            ...$ctx.admit
        }}
    />
</Module>
