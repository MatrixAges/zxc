import bytes from "std:bytes"
import integers from "std:integer"

export type Input = {
    source: string[],
    canonical: string[]
}

export type Output = u32[]

export default function (in: Input): Output {
    return in.source.map(name => {
        const needle = bytes.fromText(name)

        return loop({
            first: 0,
            end: in.canonical.length
        }, {
            while: state => state.first < state.end,
            next: state => {
                const middle = state.first + (state.end - state.first) / 2
                const current = bytes.fromText(in.canonical[middle])

                if (bytes.lessThan(current, needle)) {
                    state.first = middle + 1
                } else {
                    state.end = middle
                }
            },
            return: state => integers.narrow(state.first)
        })
    })[0]
}
