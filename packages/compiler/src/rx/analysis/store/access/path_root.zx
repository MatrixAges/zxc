import bytes from "std:bytes"

import { ExprKind } from "../../../../zx/frontend/parser/expressions/state/model"
import { namespace } from "../const"

import type { ExprNode } from "../../../../zx/frontend/parser/expressions/state/model"

export type Input = {
    source: u8[],
    nodes: ExprNode[],
    target: u64
}

export type Output = bool

export default function (in: Input): Output {
    const alias = in.nodes[in.target]

    if (alias.kind != ExprKind.Field) {
        return false
    }

    const root = in.nodes[alias.first]

    if (root.kind != ExprKind.Identifier) {
        return false
    }

    const name = root.name
    const length = bytes.fromText(namespace).length

    return name.end - name.start == length &&
        bytes.startsWithText(in.source, name.start, namespace)
}
