import integers from "std:integer"
import memory from "std:memory"

import type { U32Buffer } from "std:memory"

export type Input = {
    layout: U32Buffer,
    position: u64,
    replacement: u64
}

export type Output = u64

export default function (in: Input): Output {
    const old = memory.readU32(in.layout, in.position)

    memory.writeU32(in.layout, in.position, integers.narrow(in.replacement))

    return integers.widen(old)
}
