import integers from "std:integer"
import { max_u32 } from "core/const"

import type { Symbols } from "./model"

export type Input = {
    symbols: Symbols,
    source: u32
}

export type Output = u32

export default function (in: Input): Output {
    const index = integers.widen(in.source)

    if (index == 0 || index >= in.symbols.count) {
        return max_u32
    }

    const offset = index - 1
    const count = in.symbols.bindings.length

    if (offset < count) {
        return in.symbols.bindings[offset]
    }

    return integers.narrow(in.symbols.locals_base + (offset - count))
}
