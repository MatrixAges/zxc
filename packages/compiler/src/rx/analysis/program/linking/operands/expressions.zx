import integers from "std:integer"
import memory from "std:memory"
import { max_u32 } from "core/const"

import type { U32Buffer } from "std:memory"

export type Input = {
    source: u32[],
    mapping: u32[],
    target: U32Buffer
}

export type Output = bool

export default function (in: Input): Output {
    const count = in.source.length

    return loop({
        position: 0,
        valid: true
    }, {
        while: state => state.valid && state.position < count,
        next: state => {
            const id = in.mapping[integers.widen(in.source[state.position])]

            if (id == max_u32) {
                state.valid = false
            } else {
                memory.writeU32(in.target, state.position, id)
                state.position += 1
            }
        },
        return: state => state.valid
    })
}
