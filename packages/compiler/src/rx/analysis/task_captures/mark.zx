import integers from "std:integer"
import { max_u32 } from "core/const"

export type Input = {
    references: u32[],
    positions?: u32[],
    marked: bool[],
    remaining: u64,
    cursor: u64
}

export type Output = {
    marked: bool[],
    remaining: u64
}

export default function (in: Input): Output {
    return loop(in, {
        while: state => state.remaining != 0 &&
            state.cursor < state.references.length,
        next: state => {
            const symbol = state.references[state.cursor]

            if (symbol != 0) {
                const index = integers.widen(symbol - 1)
                const positions = state.positions
                const position = match {
                    positions == null => index,
                    index < positions.length => integers.widen(positions[index]),
                    _ => integers.widen(max_u32)
                }

                if (position < state.marked.length && !state.marked[position]) {
                    state.marked[position] = true
                    state.remaining -= 1
                }
            }

            state.cursor += 1
        },
        return: state => ({
            marked: state.marked,
            remaining: state.remaining
        })
    })
}
