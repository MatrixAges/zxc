import { map } from "std:utils"

import { Issue } from "./model"

import type { Graph, State } from "./model"

export type Input = Graph

export type Output = State

export default function (in: Input): Output {
    return {
        graph: in,
        marks: map(in.offsets, offset => 0).pop()[0],
        cursors: map(in.offsets, offset => offset).pop()[0],
        frames: map(in.offsets, offset => 0).pop()[0],
        order: map(in.offsets, offset => 0).pop()[0],
        root: 0,
        depth: 0,
        count: 0,
        issue: Issue.None,
        edge: 0
    }
}
