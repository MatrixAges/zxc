import initial from "./initial"
import { Issue, Mark } from "./model"

import type { Graph } from "./model"

export type Input = Graph

export type Output = {
    order: u64[],
    depths: u64[],
    count: u64,
    first_end: u64,
    issue: Issue,
    owner: u64,
    edge: u64
}

export default function (in: Input): Output {
    const roots = in.roots
    const ends = in.ends
    const ranked = in.ranked

    const state = loop(initial(in), {
        while: value =>
            value.issue == Issue.None &&
            (
                value.root < value.limit || value.depth != 0
            ),
        next: value => {
            if (value.depth == 0) {
                if (value.root == 1 && ranked) {
                    value.first_end = value.count
                }

                const root = roots == null ? value.root : roots[value.root]

                if (value.marks[root] == Mark.Unseen) {
                    value.marks[root] = Mark.Visiting
                    value.frames[0] = root
                    value.depth = 1
                }

                value.root += 1
            } else {
                const owner = value.frames[value.depth - 1]
                const cursor = value.cursors[owner]
                const end = ends == null ? value.graph.offsets[owner + 1] : ends[owner]

                if (cursor == end) {
                    value.marks[owner] = Mark.Done
                    value.order[value.count] = owner
                    value.count += 1
                    value.depth -= 1

                    if (ranked && value.depth != 0) {
                        const parent = value.frames[value.depth - 1]
                        const rank = value.depths[owner] + 1

                        if (rank > value.depths[parent]) {
                            value.depths[parent] = rank
                        }
                    }
                } else {
                    const target = value.graph.targets[cursor]
                    const issue = match {
                        value.graph.issues.length != 0 => value.graph.issues[cursor],
                        target >= value.marks.length => Issue.Missing,
                        _ => Issue.None
                    }

                    value.cursors[owner] = cursor + 1

                    if (issue != Issue.None) {
                        value.issue = issue
                        value.owner = owner
                        value.edge = cursor
                    } else {
                        if (value.marks[target] == Mark.Visiting) {
                            value.issue = Issue.Cycle
                            value.owner = owner
                            value.edge = cursor
                        } else {
                            if (value.marks[target] == Mark.Unseen) {
                                value.marks[target] = Mark.Visiting
                                value.frames[value.depth] = target
                                value.depth += 1
                            } else if (ranked) {
                                const rank = value.depths[target] + 1

                                if (rank > value.depths[owner]) {
                                    value.depths[owner] = rank
                                }
                            }
                        }
                    }
                }
            }
        }
    })

    const first_end = roots != null && roots.length == 1 ? state.count : state.first_end

    return {
        order: state.order,
        depths: state.depths,
        count: state.count,
        first_end,
        issue: state.issue,
        owner: state.owner,
        edge: state.edge
    }
}
