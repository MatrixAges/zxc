import initial from "./initial"
import { Issue, Mark } from "./model"

import type { Graph } from "./model"

export type Input = Graph

export type Output = {
    order: u64[],
    count: u64,
    issue: Issue,
    edge: u64
}

export default function (in: Input): Output {
    const state = loop(initial(in), {
        while: value =>
            value.issue == Issue.None &&
            (
                value.root < value.limit || value.depth != 0
            ),
        next: value => {
            if (value.depth == 0) {
                const root = value.root

                if (value.marks[root] == Mark.Unseen) {
                    value.marks[root] = Mark.Visiting
                    value.frames[0] = root
                    value.depth = 1
                }

                value.root += 1
            } else {
                const owner = value.frames[value.depth - 1]
                const cursor = value.cursors[owner]

                if (cursor == value.graph.offsets[owner + 1]) {
                    value.marks[owner] = Mark.Done
                    value.order[value.count] = owner
                    value.count += 1
                    value.depth -= 1
                } else {
                    const target = value.graph.targets[cursor]
                    const issue = match {
                        value.graph.issues.length != 0 => value.graph.issues[cursor],
                        target >= value.marks.length => Issue.Missing,
                        _ => Issue.None
                    }

                    value.cursors[owner] = cursor + 1

                    if (issue != Issue.None) {
                        value.issue = issue
                        value.edge = cursor
                    } else {
                        if (value.marks[target] == Mark.Visiting) {
                            value.issue = Issue.Cycle
                            value.edge = cursor
                        } else {
                            if (value.marks[target] == Mark.Unseen) {
                                value.marks[target] = Mark.Visiting
                                value.frames[value.depth] = target
                                value.depth += 1
                            }
                        }
                    }
                }
            }
        }
    })

    return {
        order: state.order,
        count: state.count,
        issue: state.issue,
        edge: state.edge
    }
}
