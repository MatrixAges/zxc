import integers from "std:integer"
import memory from "std:memory"

import { Tag } from "../../schema/execution/model"
import conditional from "./conditional"
import {
    alternate,
    call_action,
    declaration,
    declaration_action,
    if_action,
    parallel_action,
    return_action,
    returns,
    switch_action,
    task_action,
    task_rank_stride,
    terminates
} from "./const"
import selection from "./selection"
import sequence from "./sequence"

import type { Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const view = in.view

    const children = {
        view,
        head: view.nodes[in.row].children
    }

    const flags = match in.tag {
        Tag.Module => sequence(children),
        Tag.Type => declaration + declaration_action,
        Tag.Args => declaration + declaration_action,
        Tag.Store => declaration + declaration_action,
        Tag.Import => declaration + declaration_action,
        Tag.Call => call_action,
        Tag.Task => sequence(children) + task_action,
        Tag.Parallel => parallel_action,
        Tag.Case => sequence(children),
        Tag.Else => sequence(children) + alternate,
        Tag.Default => sequence(children) + alternate,
        Tag.If => conditional(children) + if_action,
        Tag.Switch => selection(children) + switch_action,
        Tag.Return => returns + terminates + return_action,
        _ => 0
    }

    const rank = integers.narrow(in.task_rank * task_rank_stride)

    memory.writeU32(view.facts, view.slots[in.row], flags + rank)

    return flags
}
