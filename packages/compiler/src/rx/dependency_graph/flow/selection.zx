import integers from "std:integer"
import memory from "std:memory"

import { alternate, returns, terminates } from "./const"

import type { Children } from "./model"

export type Input = Children

export type Output = u32

export default function (in: Input): Output {
    const view = in.view

    const summary = loop({
        row: in.head,
        fallback: false,
        has_return: false,
        all_end: true
    }, {
        while: state => state.row != 0,
        next: state => {
            const row = state.row - 1
            const slot = view.slots[row]
            const flags = integers.widen(memory.readU32(view.facts, slot))
            const yields = integers.andBits(flags, integers.widen(returns)) != 0
            const stops = integers.andBits(flags, integers.widen(terminates)) != 0
            const otherwise = integers.andBits(flags, integers.widen(alternate)) != 0

            state.has_return = state.has_return || yields
            state.all_end = state.all_end && stops
            state.fallback = state.fallback || otherwise
            state.row = view.nodes[row].previous_sibling
        }
    })

    const result = summary.has_return ? returns : 0
    const end = summary.fallback && summary.all_end ? terminates : 0

    return result + end
}
