import memory from "std:memory"

import name from "../reference/name"
import { parallel_tag } from "./const"

import type { U64Buffer } from "std:memory"
import type { Node } from "../../syntax/document/model"

export type Input = {
    source: u8[],
    nodes: Node[],
    parents: U64Buffer,
    depth: u64
}

export type Output = bool

export default function (in: Input): Output {
    if (in.depth == 0) {
        return false
    }

    const parent = memory.readU64(in.parents, in.depth - 1) - 1
    const span = in.nodes[parent].name

    return name({
        source: in.source,
        start: span.start,
        end: span.end,
        name: parallel_tag
    })
}
