import bytes from "std:bytes"
import encoding from "std:encoding"
import integers from "std:integer"
import memory from "std:memory"

import { Tag } from "../../schema/execution/model"
import classify from "../../schema/execution/tag"
import { declaration, max_task_rank } from "../flow/const"
import parallelParent from "../flow/parallel_parent"
import project from "../flow/project"
import select from "./select"

import type { U32Buffer, U64Buffer } from "std:memory"
import type { Attribute, Node } from "../../syntax/document/model"
import type { Reference } from "./model"

export type Input = {
    source: string,
    nodes: Node[],
    attributes: Attribute[],
    root: u64,
    parents: U64Buffer,
    slots: u64[],
    facts: U32Buffer,
    project_flow: bool
}

export type Output = {
    references: Reference[],
    module_steps: u64,
    parallel_tasks: u64
    source_extent: u64
}

export default function (in: Input): Output {
    const parents = in.parents
    const source = bytes.fromText(in.source)

    const view = {
        nodes: in.nodes,
        slots: in.slots,
        facts: in.facts
    }

    const rank_tasks = in.nodes.length <= max_task_rank
    const references: Reference[] = []

    return loop({
        next: in.root + 1,
        depth: 0,
        finishing: false,
        module_steps: 0,
        parallel_tasks: 0,
        source_extent: 0,
        references
    }, {
        while: state => state.next != 0,
        next: state => {
            const row = state.next - 1
            const node = in.nodes[row]

            if (!state.finishing && node.children != 0) {
                memory.writeU64(parents, state.depth, state.next)
                state.depth += 1
                state.next = node.children
            } else {
                const name =
                    encoding.sliceBytes(in.source, node.name.start, node.name.end)
                const tag = classify(name)

                const node_end = node.name.end - 1

                if (node_end > state.source_extent) {
                    state.source_extent = node_end
                }

                if (in.project_flow) {
                    const task = rank_tasks && tag == Tag.Task
                    const parallel = task && parallelParent({
                        source,
                        nodes: view.nodes,
                        parents,
                        depth: state.depth
                    })

                    if (parallel) {
                        state.parallel_tasks += 1
                    }

                    const flags = project({
                        view,
                        row,
                        tag,
                        task_rank: parallel ? state.parallel_tasks : 0
                    })

                    const skipped = integers.andBits(
                        integers.widen(flags),
                        integers.widen(declaration)
                    )

                    if (state.depth == 1 && skipped == 0) {
                        state.module_steps += 1
                    }
                }

                const reference = select({
                    source,
                    node,
                    attributes: in.attributes,
                    row,
                    tag
                })

                if (reference != null) {
                    state.references = state.references.push(reference)[0]
                }

                if (node.previous_sibling != 0) {
                    state.next = node.previous_sibling
                    state.finishing = false
                } else if (state.depth != 0) {
                    state.depth -= 1
                    state.next = memory.readU64(parents, state.depth)
                    state.finishing = true
                } else {
                    state.next = 0
                }
            }
        },
        return: state => ({
            references: state.references,
            module_steps: state.module_steps,
            parallel_tasks: state.parallel_tasks,
            source_extent: state.source_extent
        })
    })
}
