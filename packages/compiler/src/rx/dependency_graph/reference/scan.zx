import bytes from "std:bytes"
import encoding from "std:encoding"
import memory from "std:memory"

import classify from "../../schema/execution/tag"
import project from "../flow/project"
import select from "./select"

import type { U32Buffer, U64Buffer } from "std:memory"
import type { Attribute, Node } from "../../syntax/document/model"
import type { Reference } from "./model"

export type Input = {
    source: string,
    nodes: Node[],
    attributes: Attribute[],
    root: u64,
    parents: U64Buffer,
    slots: u64[],
    facts: U32Buffer,
    project_flow: bool
}

export type Output = Reference[]

export default function (in: Input): Output {
    const parents = in.parents
    const source = bytes.fromText(in.source)

    const view = {
        nodes: in.nodes,
        slots: in.slots,
        facts: in.facts
    }

    const references: Reference[] = []

    return loop({
        next: in.root + 1,
        depth: 0,
        finishing: false,
        references
    }, {
        while: state => state.next != 0,
        next: state => {
            const row = state.next - 1
            const node = in.nodes[row]

            if (!state.finishing && node.children != 0) {
                memory.writeU64(parents, state.depth, state.next)
                state.depth += 1
                state.next = node.children
            } else {
                const name =
                    encoding.sliceBytes(in.source, node.name.start, node.name.end)
                const tag = classify(name)

                if (in.project_flow) {
                    project({
                        view,
                        row,
                        tag
                    })
                }

                const reference = select({
                    source,
                    node,
                    attributes: in.attributes,
                    row,
                    tag
                })

                if (reference != null) {
                    state.references = state.references.push(reference)[0]
                }

                if (node.previous_sibling != 0) {
                    state.next = node.previous_sibling
                    state.finishing = false
                } else if (state.depth != 0) {
                    state.depth -= 1
                    state.next = memory.readU64(parents, state.depth)
                    state.finishing = true
                } else {
                    state.next = 0
                }
            }
        },
        return: state => state.references
    })
}
