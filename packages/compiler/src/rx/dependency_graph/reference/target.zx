import { Tag } from "../../schema/execution/model"
import {
    attribute_fn,
    attribute_from,
    attribute_module,
    attribute_service
} from "./const"
import { Role, Target } from "./model"

import type { Output } from "./model"

export type Input = {
    tag: Tag,
    graph_only: bool
}

export default function (in: Input): Output {
    const graph_only = in.graph_only

    const absent: Output = {
        primary: "",
        fallback: "",
        target: Target.Module,
        fallback_target: Target.Module,
        role: Role.Dependency,
        required: false,
        package_allowed: false,
        graph: false
    }

    const graph_reference = in.tag == Tag.Import || in.tag == Tag.Call

    if (graph_only && !graph_reference) {
        return absent
    }

    return match in.tag {
        Tag.Import => {
            ...absent,
            primary: attribute_from,
            required: true,
            graph: true
        },
        Tag.Call => {
            ...absent,
            primary: attribute_module,
            fallback: graph_only ? "" : attribute_fn,
            fallback_target: Target.Function,
            fallback_target: Target.Function,
            role: Role.Call,
            required: !graph_only,
            package_allowed: true,
            graph: true
        },
        Tag.Module => {
            ...absent,
            primary: attribute_fn,
            target: Target.Function,
            fallback_target: Target.Function,
            role: Role.Call
        },
        Tag.Type => {
            ...absent,
            primary: attribute_from,
            target: Target.Function,
            fallback_target: Target.Function,
            role: Role.TypeImport,
            required: true,
            package_allowed: true
        },
        Tag.Store => {
            ...absent,
            primary: attribute_from,
            target: Target.Store,
            fallback_target: Target.Store
        },
        Tag.Route => {
            ...absent,
            primary: attribute_service,
            required: true
        },
        _ => absent
    }
}
