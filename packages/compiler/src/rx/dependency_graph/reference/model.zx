export enum Target {
    Module,
    Function,
    Store
}

export enum Role {
    Dependency,
    Call,
    TypeImport
}

export type Reference = {
    node: u64,
    attribute?: u64,
    target: Target,
    role: Role,
    package_allowed: bool,
    graph: bool
}

export type Input = {
    source: u8[],
    start: u64,
    end: u64,
    graph_only: bool
}

export type Output = {
    primary: string,
    fallback: string,
    target: Target,
    fallback_target: Target,
    role: Role,
    required: bool,
    package_allowed: bool,
    graph: bool
}
