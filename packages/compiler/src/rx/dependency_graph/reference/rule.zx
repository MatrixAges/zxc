import encoding from "std:encoding"

import { Tag } from "../../schema/execution/model"
import classify from "../../schema/execution/tag"
import select from "./target"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const name = encoding.sliceBytes(in.source, in.start, in.end)

    return select({
        tag: classify(name),
        graph_only: in.graph_only
    })
}
