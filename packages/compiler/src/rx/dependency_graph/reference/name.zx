import bytes from "std:bytes"

export type Input = {
    source: u8[],
    start: u64,
    end: u64,
    name: string
}

export type Output = bool

export default function (in: Input): Output {
    return in.end - in.start == in.name.length &&
        bytes.startsWithText(in.source, in.start, in.name)
}
