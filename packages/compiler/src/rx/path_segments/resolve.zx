import { reduce } from "std:utils"

import cancelStep from "./cancel_step"

import type { Resolution, Span } from "./model"

export type Input = Span[]

export type Output = {
    valid: bool,
    segments: Span[]
}

export default function (in: Input): Output {
    const segments: Span[] = []

    const initial: Resolution = {
        parents: 0,
        segments
    }

    const state = reduce(in.reverse()[0], (state, segment) => cancelStep({
        state,
        start: segment.start,
        end: segment.end,
        parent: segment.parent
    }), initial)

    return {
        valid: state.parents == 0,
        segments: state.segments.reverse()[0]
    }
}
