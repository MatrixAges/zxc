import type { Resolution } from "./model"

export type Input = {
    state: Resolution,
    start: u64,
    end: u64,
    parent: bool
}

export type Output = Resolution

export default function (in: Input): Output {
    if (in.parent) {
        return in.state.parents + 1
            -> {
                ...in.state,
                parents: _
            }
    }

    if (in.state.parents != 0) {
        return in.state.parents - 1
            -> {
                ...in.state,
                parents: _
            }
    }

    return {
        parents: in.state.parents,
        segments: in.state.segments.push({
            start: in.start,
            end: in.end,
            parent: false
        })[0]
    }
}
