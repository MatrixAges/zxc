<Module>
    <Type from="model" as="Path" />

    <Args in={Path.Request} out={Path.Plan} />

    <Call fn="tail" in={$in} />

    <If on={!$ctx.tail.valid}>
        <Return
            value={{
                valid: false,
                suffix: "",
                attached: false,
                length: 0
            }}
        />
    </If>

    <Call
        fn="walk"
        in={{
            directory: $in.directory,
            path: $in.path,
            suffix: $ctx.tail.suffix,
            attached: $ctx.tail.attached,
            capacity: 0,
            target: null
        }}
    />

    <Return
        value={{
            valid: $ctx.walk.parents == 0,
            suffix: $ctx.tail.suffix,
            attached: $ctx.tail.attached,
            length: $ctx.walk.length
        }}
    />
</Module>
