import finish from "./finish"
import tick from "./tick"

import type { State, Span } from "./model"

export type Input = u8[]

export type Output = Span[]

export default function (in: Input): Output {
  const segments: Span[] = []
  const initial: State = { offset: 0, start: 0, dots: true, segments: segments }
  const state = finish(in.reduce((state, byte) => tick({ state: state, byte: byte }), initial))

  return state.segments
}
