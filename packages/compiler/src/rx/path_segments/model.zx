import type { U8Buffer } from "std:memory"
import type { Kind } from "../path_kind/model"

export type Request = {
    directory: u8[],
    path: u8[],
    kind: Kind,
    suffix: string
}

export type Tail = {
    valid: bool,
    suffix: string,
    attached: bool
}

export type Plan = {
    valid: bool,
    suffix: string,
    attached: bool,
    length: u64
}

export type Position = {
    parents: u64,
    length: u64,
    attached: bool
}

export type Walk = {
    directory: u8[],
    path: u8[],
    suffix: string,
    attached: bool,
    capacity: u64,
    target?: U8Buffer
}
