import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const length = in.offset - in.start

    const condition = (
        - length == 0
        - or (in.dots && length == 1)
    )

    if (condition) {
        return in
    }

    return in.segments.push({
        start: in.start,
        end: in.offset,
        parent: in.dots && length == 2
    })[0]
        -> {
            offset: in.offset,
            start: in.start,
            dots: in.dots,
            segments: _
        }
}
