import {no_diagnostic} from "../../../const"
import {xml_declaration_start} from "../const"
import {
    ascii_name_required,
    declaration_quote_required,
    declaration_version_first,
    declaration_version_required,
    declaration_whitespace_required,
    invalid_declaration_field,
    invalid_standalone,
    unexpected_token,
    unsupported_encoding,
    unterminated_declaration
} from "../diagnostic/const"
import { Issue } from "./model"
import step from "./step"

export type Input = {
    source: u8[],
    offset: u64
}

export type Output = {
    end: u64,
    message: string
}

export default function (in: Input): Output {
    const state = loop({
        source: in.source,
        offset: in.offset + xml_declaration_start.length,
        count: 0,
        encoding: false,
        standalone: false,
        done: false,
        issue: Issue.None
    }, {
        while: value => !value.done,
        next: value => {
            value = step(value)
        }
    })

    switch (state.issue) {
        case Issue.None: return {
            end: state.offset,
            message: no_diagnostic
        }
        case Issue.VersionRequired: return {
            end: state.offset,
            message: declaration_version_required
        }
        case Issue.Space: return {
            end: state.offset,
            message: declaration_whitespace_required
        }
        case Issue.Name: return {
            end: state.offset,
            message:
                ascii_name_required
        }
        case Issue.Token: return {
            end: state.offset,
            message: unexpected_token
        }
        case Issue.Quote: return {
            end: state.offset,
            message: declaration_quote_required
        }
        case Issue.Unterminated: return {
            end: state.offset,
            message: unterminated_declaration
        }
        case Issue.Version: return {
            end: state.offset,
            message: declaration_version_first
        }
        case Issue.Encoding: return {
            end: state.offset,
            message: unsupported_encoding
        }
        case Issue.Standalone: return {
            end: state.offset,
            message: invalid_standalone
        }
        default: return {
            end: state.offset,
            message: invalid_declaration_field
        }
    }
}
