import { ascii_double_quote, ascii_equals, ascii_single_quote } from "core/ascii/const"

import {no_diagnostic} from "../../../const"
import {
    xml_declaration_end,
    xml_encoding,
    xml_encoding_attribute,
    xml_standalone_attribute,
    xml_standalone_no,
    xml_standalone_yes,
    xml_version,
    xml_version_attribute
} from "../const"
import matches from "../matches"
import name from "../name"
import starts from "../starts"
import until from "../until"
import whitespace from "../whitespace"
import { Issue } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const offset = whitespace({
        source: in.source,
        offset: in.offset
    })

    if (starts({
        source: in.source,
        offset,
        text: xml_declaration_end
    })) {
        return {
            ...in,
            offset: offset + xml_declaration_end.length,
            done: true,
            issue: in.count == 0 ? Issue.VersionRequired : Issue.None
        }
    }

    if (offset == in.offset) {
        return {
            ...in,
            done: true,
            issue: Issue.Space
        }
    }

    const field = name({
        source: in.source,
        offset
    })

    if (field.message != no_diagnostic) {
        return {
            ...in,
            offset: field.end,
            done: true,
            issue: Issue.Name
        }
    }

    const assign = whitespace({
        source: in.source,
        offset: field.end
    })

    if (assign == in.source.length || in.source[assign] != ascii_equals) {
        return {
            ...in,
            offset: assign,
            done: true,
            issue: Issue.Token
        }
    }

    const quoted = whitespace({
        source: in.source,
        offset: assign + 1
    })

    const condition = (
        - quoted == in.source.length
        - or (
            in.source[quoted] != ascii_double_quote &&
                in.source[quoted] != ascii_single_quote
        )
    )

    if (condition) {
        return {
            ...in,
            offset: quoted,
            done: true,
            issue: Issue.Quote
        }
    }

    const end = until({
        source: in.source,
        offset: quoted + 1,
        byte: in.source[quoted]
    })

    if (end == in.source.length) {
        return {
            ...in,
            offset: end,
            done: true,
            issue: Issue.Unterminated
        }
    }

    const field_span = {
        start: offset,
        end: field.end
    }

    const value_span = {
        start: quoted + 1,
        end
    }

    const version = matches({
        source: in.source,
        span: field_span,
        text: xml_version_attribute,
        ignore_case: false
    })

    const encoding = matches({
        source: in.source,
        span: field_span,
        text: xml_encoding_attribute,
        ignore_case: false
    })

    const standalone = matches({
        source: in.source,
        span: field_span,
        text: xml_standalone_attribute,
        ignore_case: false
    })

    const version_value = matches({
        source: in.source,
        span: value_span,
        text: xml_version,
        ignore_case: false
    })

    const encoding_value = matches({
        source: in.source,
        span: value_span,
        text: xml_encoding,
        ignore_case: true
    })

    const issue = matches({
        source: in.source,
        span: value_span,
        text: xml_standalone_yes,
        ignore_case: false
    }) || matches({
        source: in.source,
        span: value_span,
        text: xml_standalone_no,
        ignore_case: false
    })
        -> match {
            in.count == 0 => match {
                version && version_value => Issue.None,
                _ => Issue.Version
            },
            encoding && !in.encoding && !in.standalone => match {
                encoding_value => Issue.None,
                _ => Issue.Encoding
            },
            standalone && !in.standalone => match {
                (_) => Issue.None,
                _ => Issue.Standalone
            },
            _ => Issue.Field
        }

    return {
        ...in,
        offset: end + 1,
        count: in.count + 1,
        encoding: in.encoding || encoding,
        standalone: in.standalone || standalone,
        done: issue != Issue.None,
        issue
    }
}
