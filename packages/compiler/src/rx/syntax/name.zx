import { ascii_dot, ascii_minus, ascii_null } from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_underscore,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import {no_diagnostic} from "../../const"
import { ascii_name_required } from "./diagnostic/const"

export type Input = {
    source: u8[],
    offset: u64
}

export type Output = {
    end: u64,
    message: string
}

export default function (in: Input): Output {
    const byte = in.offset < in.source.length ? in.source[in.offset] : ascii_null

    const alphabetic =
        (
            - byte >= ascii_upper_first
            - and byte <= ascii_upper_last
            - or (byte >= ascii_lower_first && byte <= ascii_lower_last)
        )

    if (!alphabetic && byte != ascii_underscore) {
        return {
            end: in.offset,
            message:
                ascii_name_required
        }
    }

    const state = loop({
        source: in.source,
        offset: in.offset + 1,
        done: false
    }, {
        while: value => !value.done && value.offset < value.source.length,
        next: value => {
            const current = value.source[value.offset]
            const accepted =
                (
                    - current >= ascii_upper_first
                    - and current <= ascii_upper_last
                    - or (current >= ascii_lower_first && current <= ascii_lower_last)
                    - or (current >= ascii_digit_first && current <= ascii_digit_last)
                    - or current == ascii_underscore
                    - or current == ascii_minus
                    - or current == ascii_dot
                )
            const offset = value.offset + (accepted ? 1 : 0)

            value = {
                ...value,
                offset,
                done: !accepted
            }
        }
    })

    return {
        end: state.offset,
        message: no_diagnostic
    }
}
