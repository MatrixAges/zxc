import {
    ascii_backslash,
    ascii_backtick,
    ascii_dollar,
    ascii_double_quote,
    ascii_lower_n,
    ascii_lower_r,
    ascii_lower_t,
    ascii_open_brace
} from "core/ascii/const"

import { unsupported_template_escape } from "../../../zx/frontend/lexer/const"
import close from "./close"
import fail from "./fail"
import { Mode } from "./model"
import open from "./open"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const byte = in.source[in.offset]
    const has_next = in.offset + 1 < in.source.length
    const next = has_next ? in.source[in.offset + 1] : 0
    const offset = in.offset + 1

    if (byte == ascii_backtick) {
        return close(in)
    }

    if (byte == ascii_backslash) {
        if (
            has_next && next != ascii_double_quote && next != ascii_backslash &&
                next != ascii_lower_n && next != ascii_lower_r &&
                next != ascii_lower_t && next != ascii_backtick && next != ascii_dollar
        ) {
            const issue = in.offset

            return fail({
                state: in,
                offset: issue,
                message: unsupported_template_escape
            })
        }

        return {
            ...in,
            offset: has_next ? offset + 1 : offset
        }
    }

    if (byte == ascii_dollar && next == ascii_open_brace) {
        return in.frame.depth + 1
            -> open({
                state: in,
                mode: Mode.Interpolation,
                offset: offset + 1,
                start: offset + 1,
                depth: _
            })
    }

    return {
        ...in,
        offset
    }
}
