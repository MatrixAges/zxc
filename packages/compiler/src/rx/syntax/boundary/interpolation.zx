import {
    ascii_asterisk,
    ascii_backtick,
    ascii_close_brace,
    ascii_double_quote,
    ascii_open_brace,
    ascii_slash
} from "core/ascii/const"
import { max_nesting_depth } from "core/const"

import {no_diagnostic} from "../../../const"
import { template_nesting_limit } from "../../../zx/frontend/lexer/const"
import close from "./close"
import fail from "./fail"
import { Mode } from "./model"
import open from "./open"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const byte = in.source[in.offset]
    const has_next = in.offset + 1 < in.source.length
    const next = has_next ? in.source[in.offset + 1] : 0
    const offset = in.offset + 1
    const braces = in.frame.braces

    if (byte == ascii_close_brace && braces == 0) {
        return close(in)
    }

    if (byte == ascii_backtick) {
        const depth = in.frame.depth + 1
        const start = in.offset

        if (depth > max_nesting_depth) {
            return fail({
                state: in,
                offset: start,
                message: template_nesting_limit
            })
        }

        return open({
            state: in,
            mode: Mode.Template,
            offset: offset,
            start: start,
            depth: depth
        })
    }

    const mode = match {
        byte == ascii_double_quote => Mode.String,
        byte == ascii_slash && next == ascii_slash => Mode.LineComment,
        byte == ascii_slash && next == ascii_asterisk => Mode.BlockComment,
        _ => Mode.Interpolation
    }

    const comment_start = mode == Mode.BlockComment ? in.offset : in.comment_start

    const next_offset =
        mode == Mode.BlockComment || mode == Mode.LineComment ? offset + 1 : offset

    return {
        source: in.source,
        frames: in.frames,
        frame: {
            ...in.frame,
            mode: mode,
            braces: match byte {
                ascii_open_brace => braces + 1,
                ascii_close_brace => braces - 1,
                _ => braces
            }
        },
        offset: next_offset,
        comment_start: comment_start,
        done: false,
        message: no_diagnostic,
        issue: 0
    }
}
