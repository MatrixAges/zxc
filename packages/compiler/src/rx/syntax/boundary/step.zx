import {
    ascii_asterisk,
    ascii_backslash,
    ascii_carriage_return,
    ascii_double_quote,
    ascii_line_feed,
    ascii_slash
} from "core/ascii/const"

import {no_diagnostic} from "../../../const"
import {
    unterminated_interpolation,
    unterminated_template,
    unterminated_template_comment
} from "../../../zx/frontend/lexer/const"
import fail from "./fail"
import interpolation from "./interpolation"
import { Mode } from "./model"
import template from "./template"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.offset == in.source.length) {
        const mode = in.frame.mode
        const issue = mode == Mode.BlockComment ? in.comment_start : in.frame.start

        const message = match mode {
            Mode.Template => unterminated_template,
            Mode.BlockComment => unterminated_template_comment,
            _ => unterminated_interpolation
        }

        return fail({
            state: in,
            offset: issue,
            message: message
        })
    }

    if (in.frame.mode == Mode.Template) {
        return template(in)
    }

    if (in.frame.mode == Mode.Interpolation) {
        return interpolation(in)
    }

    const byte = in.source[in.offset]
    const has_next = in.offset + 1 < in.source.length
    const next = has_next ? in.source[in.offset + 1] : 0
    const mode = in.frame.mode

    const finished = match mode {
        Mode.String => byte == ascii_double_quote,
        Mode.LineComment =>
            byte == ascii_line_feed || byte == ascii_carriage_return,
        _ => byte == ascii_asterisk && next == ascii_slash
    }

    const skip =
        has_next &&
        (
            mode == Mode.String && byte == ascii_backslash ||
                mode == Mode.BlockComment && finished
        )

    const offset = in.offset + (skip ? 2 : 1)

    return {
        source: in.source,
        frames: in.frames,
        frame: {
            ...in.frame,
            mode: finished ? Mode.Interpolation : mode
        },
        offset: offset,
        comment_start: in.comment_start,
        done: false,
        message: no_diagnostic,
        issue: 0
    }
}
