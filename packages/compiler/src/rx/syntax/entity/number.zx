import integer from "std:integer"
import {
    ascii_tab,
    ascii_line_feed,
    ascii_carriage_return,
    ascii_space
} from "core/ascii/const"
import { decimal_radix, hexadecimal_radix } from "core/const"

import { no_diagnostic } from "../../../const"
import {
    xml_before_surrogates_last,
    xml_reference_accumulator_max,
    xml_after_surrogates_first,
    unicode_last,
    xml_bmp_last,
    xml_supplementary_first,
} from "../const"
import {
    empty_reference,
    forbidden_reference,
    invalid_reference,
    overflow_reference
} from "../diagnostic/const"
import digit from "./digit"

export type Input = {
    source: u8[],
    start: u64,
    end: u64,
    hexadecimal: bool
}

export type Output = {
    codepoint: u64,
    message: string
}

export default function (in: Input): Output {
    if (in.start == in.end) {
        return {
            codepoint: 0,
            message: empty_reference
        }
    }

    const state = loop({
        source: in.source,
        offset: in.start,
        end: in.end,
        radix: in.hexadecimal ? hexadecimal_radix : decimal_radix,
        value: 0,
        valid: true,
        overflow: false
    }, {
        while: value => value.offset < value.end,
        next: value => {
            const number = digit(value.source[value.offset])
            const valid = value.valid && number < value.radix
            const next = value.overflow ? 0 : value.value * value.radix + number
            const overflow = value.overflow || next > xml_reference_accumulator_max
            const offset = value.offset + 1

            value = {
                ...value,
                offset,
                value: next,
                valid,
                overflow
            }
        }
    })

    if (!state.valid) {
        return {
            codepoint: 0,
            message: invalid_reference
        }
    }

    if (state.overflow) {
        return {
            codepoint: 0,
            message: overflow_reference
        }
    }

    const character = state.value

    return (
        - character == integer.widenByte(ascii_tab)
        - or character == integer.widenByte(ascii_line_feed)
        - or character == integer.widenByte(ascii_carriage_return)
        - or (
            character >= integer.widenByte(ascii_space) &&
                character <= xml_before_surrogates_last
        )
        - or (
            character >= xml_after_surrogates_first && character <= xml_bmp_last
        )
        - or (character >= xml_supplementary_first && character <= unicode_last)
    )
        -> {
            codepoint: character,
            message: _ ? no_diagnostic : forbidden_reference
        }
}
