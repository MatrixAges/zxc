import integer from "std:integer"
import { ascii_lower_f, ascii_upper_f } from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_upper_first,
    decimal_radix,
    hexadecimal_radix
} from "core/const"

export type Input = u8

export type Output = u64

export default function (in: Input): Output {
    if (in >= ascii_digit_first && in <= ascii_digit_last) {
        return integer.widenByte(in - ascii_digit_first)
    }

    if (in >= ascii_upper_first && in <= ascii_upper_f) {
        return integer.widenByte(in - ascii_upper_first) + decimal_radix
    }

    if (in >= ascii_lower_first && in <= ascii_lower_f) {
        return integer.widenByte(in - ascii_lower_first) + decimal_radix
    }

    return hexadecimal_radix
}
