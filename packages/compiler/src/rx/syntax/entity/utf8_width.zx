import {
    utf8_three_byte_first,
    utf8_two_byte_first,
    xml_supplementary_first
} from "../const"

export type Input = u64

export type Output = u64

export default function (in: Input): Output {
    return match {
        in < utf8_two_byte_first => 1,
        in < utf8_three_byte_first => 2,
        in < xml_supplementary_first => 3,
        _ => 4
    }
}
