import {
    ascii_carriage_return,
    ascii_line_feed,
    ascii_space,
    ascii_tab
} from "core/ascii/const"

export type Input = {
    source: u8[],
    offset: u64
}

export type Output = u64

export default function (in: Input): Output {
    return loop({
        source: in.source,
        offset: in.offset,
        done: false
    }, {
        while: value => !value.done && value.offset < value.source.length,
        next: value => {
            const byte = value.source[value.offset]
            const accepted =
                byte == ascii_space || byte == ascii_tab || byte == ascii_line_feed ||
                byte == ascii_carriage_return
            const offset = value.offset + (accepted ? 1 : 0)

            value = {
                ...value,
                offset,
                done: !accepted
            }
        },
        return: state => state.offset
    })
}
