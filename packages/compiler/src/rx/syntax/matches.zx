import { ascii_case_delta } from "core/ascii/const"
import { ascii_upper_first, ascii_upper_last } from "core/const"

import type { Span } from "./model"

export type Input = {
    source: u8[],
    span: Span,
    text: string,
    ignore_case: bool
}

export type Output = bool

export default function (in: Input): Output {
    if (in.span.end - in.span.start != in.text.length) {
        return false
    }

    return loop({
        source: in.source,
        offset: in.span.start,
        text: in.text,
        index: 0,
        matches: true,
        ignore_case: in.ignore_case
    }, {
        while: value => value.matches && value.index < value.text.length,
        next: value => {
            const byte = value.source[value.offset + value.index]
            const pattern = value.text[value.index]
            const left =
                value.ignore_case && byte >= ascii_upper_first &&
                byte <= ascii_upper_last ? byte + ascii_case_delta :
                byte
            const right =
                value.ignore_case && pattern >= ascii_upper_first &&
                pattern <= ascii_upper_last ? pattern + ascii_case_delta :
                pattern
            const index = value.index + 1

            value = {
                ...value,
                index,
                matches: left == right
            }
        }
    }).matches
}
