import {xml_comment_end, xml_comment_start, xml_double_dash} from "./const"
import { invalid_comment, unterminated_comment } from "./diagnostic/const"
import starts from "./starts"

export enum Issue { None, Unterminated, DoubleDash }

export type Input = {
    source: u8[],
    offset: u64
}

export type Output = {
    end: u64,
    message: string
}

export default function (in: Input): Output {
    const state = loop({
        source: in.source,
        offset: in.offset + xml_comment_start.length,
        done: false,
        issue: Issue.None
    }, {
        while: value => !value.done,
        next: value => {
            const finish = starts({
                source: value.source,
                offset: value.offset,
                text: xml_comment_end
            })
            const double_dash = starts({
                source: value.source,
                offset: value.offset,
                text: xml_double_dash
            })
            const eof = value.offset == value.source.length
            const offset = match {
                finish => value.offset + xml_comment_end.length,
                eof || double_dash => value.offset,
                _ => value.offset + 1
            }
            const issue = match {
                finish => Issue.None,
                eof => Issue.Unterminated,
                double_dash => Issue.DoubleDash,
                _ => Issue.None
            }

            value = {
                ...value,
                offset: offset,
                done: finish || eof || double_dash,
                issue: issue
            }
        }
    })

    return {
        end: state.offset,
        message: match {
            state.issue == Issue.None => "",
            state.issue == Issue.Unterminated => unterminated_comment,
            _ => invalid_comment
        }
    }
}
