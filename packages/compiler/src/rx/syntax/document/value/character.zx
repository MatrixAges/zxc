import utf8Width from "../../entity/utf8_width"
import advance from "../advance"
import flush from "./flush"

import type { State } from "../model"

export type Input = {
    state: State,
    codepoint: u64,
    count: u64
}

export type Output = State

export default function (in: Input): Output {
    const state = flush(in.state)
    const end = state.control.location.offset + in.count
    const decoded_length = state.control.decoded_length + utf8Width(in.codepoint)

    const parts = state.tree.parts.push({
        span: {
            start: 0,
            end: 0
        },
        character: true,
        codepoint: in.codepoint
    })[0]

    return advance({
        state: {
            source: state.source,
            tree: {
                nodes: state.tree.nodes,
                attributes: state.tree.attributes,
                text: state.tree.text,
                parts: parts
            },
            frames: state.frames,
            frame: state.frame,
            control: {
                ...state.control,
                decoded_length,
                text_start: end
            }
        },
        count: in.count
    })
}
