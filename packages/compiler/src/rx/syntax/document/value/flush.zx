import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const end = in.control.location.offset

    const start = in.control.text_start

    if (start == end) {
        return in
    }

    const decoded_length = in.control.decoded_length + (end - start)

    const parts = in.tree.parts.push({
        span: {
            start,
            end
        },
        character: false,
        codepoint: 0
    })[0]

    return {
        source: in.source,
        tree: {
            nodes: in.tree.nodes,
            attributes: in.tree.attributes,
            text: in.tree.text,
            parts: parts
        },
        frames: in.frames,
        frame: in.frame,
        control: {
            ...in.control,
            decoded_length,
            text_start: end
        }
    }
}
