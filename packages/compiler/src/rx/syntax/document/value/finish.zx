import { xml_cdata_end } from "../../const"
import advance from "../advance"
import { ValueKind } from "../model"
import flush from "./flush"
import publish from "./publish"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const changed = in.control.decoded_start != in.control.decoded_length
    const state = changed ? flush(in) : in

    const value = {
        span: {
            start: state.control.value_start,
            end: state.control.location.offset
        },
        decoded_start: state.control.decoded_start,
        decoded_end: state.control.decoded_length
    }

    const count = match state.control.value_kind {
        ValueKind.Attribute => 1,
        ValueKind.Cdata => xml_cdata_end.length,
        _ => 0
    }

    return publish({
        state: advance({
            state,
            count: count
        }),
        value,
        expression: false
    })
}
