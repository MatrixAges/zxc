import integer from "std:integer"
import {
    ascii_ampersand,
    ascii_carriage_return,
    ascii_less_than,
    ascii_line_feed,
    ascii_semicolon,
    ascii_space,
    ascii_tab
} from "core/ascii/const"

import {no_diagnostic} from "../../../../const"
import {crlf, xml_cdata_end} from "../../const"
import {
    forbidden_attribute_less_than,
    forbidden_text_cdata_end,
    unterminated_attribute,
    unterminated_cdata,
    unterminated_entity
} from "../../diagnostic/const"
import decode from "../../entity/decode"
import starts from "../../starts"
import until from "../../until"
import advance from "../advance"
import fail from "../fail"
import { ValueKind } from "../model"
import character from "./character"
import finish from "./finish"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const offset = in.control.location.offset
    const kind = in.control.value_kind

    if (offset == in.source.length) {
        if (kind == ValueKind.Text) {
            return finish(in)
        }

        return fail({
            state: in,
            message: kind == ValueKind.Cdata ? unterminated_cdata :
                unterminated_attribute
        })
    }

    const byte = in.source[offset]

    const cdata_end = starts({
        source: in.source,
        offset,
        text: xml_cdata_end
    })

    if (kind == ValueKind.Cdata ? cdata_end : byte == in.control.terminator) {
        return finish(in)
    }

    if (kind == ValueKind.Attribute && byte == ascii_less_than) {
        return fail({
            state: in,
            message: forbidden_attribute_less_than
        })
    }

    if (kind == ValueKind.Text && cdata_end) {
        return fail({
            state: in,
            message: forbidden_text_cdata_end
        })
    }

    if (kind != ValueKind.Cdata && byte == ascii_ampersand) {
        const end = until({
            source: in.source,
            offset: offset + 1,
            byte: ascii_semicolon
        })

        if (end == in.source.length) {
            return fail({
                state: advance({
                    state: in,
                    count: end - offset
                }),
                message: unterminated_entity
            })
        }

        const result = decode({
            source: in.source,
            start: offset + 1,
            end
        })

        if (result.message != no_diagnostic) {
            return fail({
                state: advance({
                    state: in,
                    count: end - offset
                }),
                message: result.message
            })
        }

        return character({
            state: in,
            codepoint: result.codepoint,
            count: end + 1 - offset
        })
    }

    if (
        byte == ascii_carriage_return ||
            kind == ValueKind.Attribute &&
            (byte == ascii_line_feed || byte == ascii_tab)
    ) {
        const has_crlf = starts({
            source: in.source,
            offset,
            text: crlf
        })

        return character({
            state: in,
            codepoint:
                integer.widenByte(
                    kind == ValueKind.Attribute ? ascii_space : ascii_line_feed
                ),
            count: has_crlf ? crlf.length : 1
        })
    }

    return advance({
        state: in,
        count: 1
    })
}
