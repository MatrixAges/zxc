import type { Node } from "./model"

export type Input = void

export type Output = Node

export default function (in: Input): Output {
  return { name: { start: 0, end: 0 }, location: { offset: 0, line: 1, column: 1 }, attributes: 0, attribute_count: 0, children: 0, child_count: 0, text: 0, text_count: 0 }
}
