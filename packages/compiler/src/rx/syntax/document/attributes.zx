import {xml_self_close, xml_tag_end} from "../const"
import { attribute_whitespace_required } from "../diagnostic/const"
import starts from "../starts"
import whitespace from "../whitespace"
import advance from "./advance"
import attribute from "./attribute"
import fail from "./fail"
import { Phase } from "./model"
import publish from "./publish"
import transition from "./transition"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const start = in.control.location.offset

    const offset = whitespace({
        source: in.source,
        offset: start
    })

    const closed = starts({
        source: in.source,
        offset: offset,
        text: xml_self_close
    })

    const content = starts({
        source: in.source,
        offset: offset,
        text: xml_tag_end
    })

    const state = advance({
        state: in,
        count: offset - start
    })

    if (closed) {
        return publish(advance({
            state: state,
            count: xml_self_close.length
        }))
    }

    if (content) {
        return transition({
            state: advance({
                state: state,
                count: 1
            }),
            phase: Phase.Content
        })
    }

    if (offset == start) {
        return fail({
            state: state,
            message: attribute_whitespace_required
        })
    }

    return attribute(state)
}
