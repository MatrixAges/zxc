import { ascii_greater_than } from "core/ascii/const"

import {no_diagnostic} from "../../../const"
import { xml_close_start } from "../const"
import { mismatched_closing_tag, unexpected_token } from "../diagnostic/const"
import equal from "../equal"
import name from "../name"
import whitespace from "../whitespace"
import advance from "./advance"
import fail from "./fail"
import publish from "./publish"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const offset = in.control.location.offset

    const parsed = name({
        source: in.source,
        offset: offset + xml_close_start.length
    })

    const end = parsed.end

    const matched = equal({
        source: in.source,
        left: in.frame.name,
        right: {
            start: offset + xml_close_start.length,
            end: end
        }
    })

    const state = advance({
        state: in,
        count: end - offset
    })

    if (parsed.message != no_diagnostic) {
        return fail({
            state: state,
            message: parsed.message
        })
    }

    if (!matched) {
        return fail({
            state: state,
            message: mismatched_closing_tag
        })
    }

    const finish = whitespace({
        source: state.source,
        offset: end
    })

    const closed =
        finish < state.source.length && state.source[finish] == ascii_greater_than

    const advanced = advance({
        state: state,
        count: finish - end
    })

    if (!closed) {
        return fail({
            state: advanced,
            message: unexpected_token
        })
    }

    return publish(advance({
        state: advanced,
        count: 1
    }))
}
