import empty from "./empty"
import { Phase } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const result = in.tree.nodes.length
    const nodes = in.tree.nodes.push(in.frame)[0]

    if (in.frames.length == 0) {
        return {
            source: in.source,
            tree: {
                nodes,
                attributes: in.tree.attributes,
                text: in.tree.text,
                parts: in.tree.parts
            },
            frames: in.frames,
            frame: empty(),
            control: {
                ...in.control,
                phase: Phase.AfterRoot,
                result
            }
        }
    }

    const popped = in.frames.pop()
    const parent = popped[1] ?? empty()
    const head = result + 1
    const count = parent.child_count + 1

    return {
        source: in.source,
        tree: {
            nodes,
            attributes: in.tree.attributes,
            text: in.tree.text,
            parts: in.tree.parts
        },
        frames: popped[0],
        frame: {
            ...parent,
            children: head,
            child_count: count
        },
        control: {
            ...in.control,
            phase: Phase.Content
        }
    }
}
