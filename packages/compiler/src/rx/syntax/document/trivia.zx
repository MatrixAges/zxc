import {no_diagnostic} from "../../../const"
import comment from "../comment"
import {xml_comment_start} from "../const"
import { root_required } from "../diagnostic/const"
import starts from "../starts"
import whitespace from "../whitespace"
import advance from "./advance"
import fail from "./fail"
import { Phase } from "./model"
import transition from "./transition"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const start = in.control.location.offset

    const offset = whitespace({
        source: in.source,
        offset: start
    })

    if (starts({
        source: in.source,
        offset,
        text: xml_comment_start
    })) {
        const parsed = comment({
            source: in.source,
            offset
        })

        const state = advance({
            state: in,
            count: parsed.end - start
        })

        return match {
            parsed.message == no_diagnostic => state,
            _ => fail({
                state,
                message: parsed.message
            })
        }
    }

    const state = advance({
        state: in,
        count: offset - start
    })

    if (state.control.phase == Phase.BeforeRoot) {
        return transition({
            state,
            phase: Phase.Open
        })
    }

    if (offset != state.source.length) {
        return fail({
            state,
            message: root_required
        })
    }

    return transition({
        state,
        phase: Phase.Done
    })
}
