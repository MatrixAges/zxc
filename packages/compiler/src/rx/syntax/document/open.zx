import { ascii_less_than } from "core/ascii/const"
import { max_nesting_depth } from "core/const"

import {no_diagnostic} from "../../../const"
import { nesting_limit, unexpected_token } from "../diagnostic/const"
import name from "../name"
import advance from "./advance"
import fail from "./fail"
import { Phase } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.frames.length >= max_nesting_depth) {
        return fail({
            state: in,
            message: nesting_limit
        })
    }

    const offset = in.control.location.offset

    if (offset == in.source.length || in.source[offset] != ascii_less_than) {
        return fail({
            state: in,
            message: unexpected_token
        })
    }

    const location = {
        offset,
        line: in.control.location.line,
        column: in.control.location.column
    }

    const parsed = name({
        source: in.source,
        offset: offset + 1
    })

    const end = parsed.end

    const state = advance({
        state: in,
        count: end - offset
    })

    if (parsed.message != no_diagnostic) {
        return fail({
            state,
            message: parsed.message
        })
    }

    return {
        source: state.source,
        tree: state.tree,
        frames: state.frames,
        frame: {
            name: {
                start: offset + 1,
                end
            },
            location,
            attributes: 0,
            attribute_count: 0,
            children: 0,
            child_count: 0,
            text: 0,
            text_count: 0
        },
        control: {
            ...state.control,
            phase: Phase.Attributes
        }
    }
}
