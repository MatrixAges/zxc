import {
    ascii_double_quote,
    ascii_equals,
    ascii_open_brace,
    ascii_single_quote
} from "core/ascii/const"

import {no_diagnostic} from "../../../const"
import {
    attribute_quote_required,
    duplicate_attribute,
    unexpected_token
} from "../diagnostic/const"
import name from "../name"
import whitespace from "../whitespace"
import advance from "./advance"
import duplicate from "./duplicate"
import expression from "./expression"
import fail from "./fail"
import { ValueKind } from "./model"
import start from "./value/start"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const offset = in.control.location.offset

    const location = {
        offset,
        line: in.control.location.line,
        column: in.control.location.column
    }

    const parsed = name({
        source: in.source,
        offset
    })

    const end = parsed.end

    const repeated = duplicate({
        source: in.source,
        attributes: in.tree.attributes,
        start: in.frame.attribute_start,
        name: {
            start: offset,
            end
        }
    })

    const named = advance({
        state: in,
        count: end - offset
    })

    if (parsed.message != no_diagnostic) {
        return fail({
            state: named,
            message: parsed.message
        })
    }

    if (repeated) {
        return fail({
            state: named,
            message: duplicate_attribute
        })
    }

    const assign = whitespace({
        source: named.source,
        offset: end
    })

    const missing =
        assign == named.source.length || named.source[assign] != ascii_equals

    const assigned = advance({
        state: named,
        count: assign - end
    })

    if (missing) {
        return fail({
            state: assigned,
            message: unexpected_token
        })
    }

    const value_offset = whitespace({
        source: assigned.source,
        offset: assign + 1
    })

    const advanced = advance({
        state: assigned,
        count: value_offset - assign
    })

    const state = {
        source: advanced.source,
        tree: advanced.tree,
        frames: advanced.frames,
        frame: advanced.frame,
        control: {
            ...advanced.control,
            attribute: {
                start: offset,
                end
            },
            attribute_location: location
        }
    }

    const quote = value_offset < state.source.length ? state.source[value_offset] : 0

    if (quote == ascii_open_brace && state.control.expressions) {
        return expression(state)
    }

    if (quote != ascii_double_quote && quote != ascii_single_quote) {
        return fail({
            state,
            message: attribute_quote_required
        })
    }

    return start({
        state: advance({
            state,
            count: 1
        }),
        kind: ValueKind.Attribute,
        terminator: quote
    })
}
