import equal from "../equal"

import type { Span } from "../model"
import type { Attribute } from "./model"

export type Input = {
    source: u8[],
    attributes: Attribute[],
    start: u64,
    name: Span
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        source: in.source,
        attributes: in.attributes,
        cursor: in.attributes.length,
        start: in.start,
        name: in.name,
        found: false
    }, {
        while: value => !value.found && value.cursor > value.start,
        next: value => {
            value.cursor -= 1

            const attribute = value.attributes[value.cursor]
            const found = equal({
                source: value.source,
                left: value.name,
                right: attribute.name
            })

            value.found = found
        },
        return: state => state.found
    })
}
