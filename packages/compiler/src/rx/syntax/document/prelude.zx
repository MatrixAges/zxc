import {no_diagnostic} from "../../../const"
import {utf8_bom, xml_declaration_start} from "../const"
import declaration from "../declaration/scan"
import starts from "../starts"
import advance from "./advance"
import fail from "./fail"
import { Phase } from "./model"
import transition from "./transition"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const offset = starts({
        source: in.source,
        offset: 0,
        text: utf8_bom
    }) ? utf8_bom.length : 0

    const declared = starts({
        source: in.source,
        offset: offset,
        text: xml_declaration_start
    })

    const parsed = declared ? declaration({
        source: in.source,
        offset: offset
    }) : {
        end: offset,
        message: no_diagnostic
    }

    const state = advance({
        state: in,
        count: parsed.end
    })

    if (parsed.message != no_diagnostic) {
        return fail({
            state: state,
            message: parsed.message
        })
    }

    return transition({
        state: state,
        phase: Phase.BeforeRoot
    })
}
