import { ascii_less_than } from "core/ascii/const"

import {no_diagnostic} from "../../../const"
import comment from "../comment"
import {xml_cdata_start, xml_close_start, xml_comment_start} from "../const"
import { missing_closing_tag } from "../diagnostic/const"
import starts from "../starts"
import advance from "./advance"
import close from "./close"
import empty from "./empty"
import fail from "./fail"
import { ValueKind } from "./model"
import open from "./open"
import start from "./value/start"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const offset = in.control.location.offset

    if (offset == in.source.length) {
        return fail({
            state: in,
            message: missing_closing_tag
        })
    }

    if (starts({
        source: in.source,
        offset,
        text: xml_close_start
    })) {
        return close(in)
    }

    if (starts({
        source: in.source,
        offset,
        text: xml_comment_start
    })) {
        const parsed = comment({
            source: in.source,
            offset
        })

        const state = advance({
            state: in,
            count: parsed.end - offset
        })

        return parsed.message == no_diagnostic ? state : fail({
            state,
            message: parsed.message
        })
    }

    if (starts({
        source: in.source,
        offset,
        text: xml_cdata_start
    })) {
        return start({
            state: advance({
                state: in,
                count: xml_cdata_start.length
            }),
            kind: ValueKind.Cdata,
            terminator: 0
        })
    }

    if (in.source[offset] == ascii_less_than) {
        return open({
            source: in.source,
            tree: in.tree,
            frames: in.frames.push(in.frame)[0],
            frame: empty(),
            control: in.control
        })
    }

    return start({
        state: in,
        kind: ValueKind.Text,
        terminator: ascii_less_than
    })
}
