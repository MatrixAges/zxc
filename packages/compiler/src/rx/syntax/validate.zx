import {
    ascii_carriage_return,
    ascii_line_feed,
    ascii_space,
    ascii_tab
} from "core/ascii/const"

import { no_diagnostic } from "../../const"
import validateUtf8 from "../../zx/frontend/lexer/utf8/validate"
import {
    utf8_bmp_noncharacter_lead,
    utf8_bmp_noncharacter_middle,
    utf8_bmp_noncharacter_tail
} from "./const"
import { forbidden_character, invalid_utf8 } from "./diagnostic/const"

export type State = {
    valid: bool,
    first: u8,
    second: u8
}

export type Input = u8[]

export type Output = string

export default function (in: Input): Output {
    if (!validateUtf8(in)) {
        return invalid_utf8
    }

    const initial: State = {
        valid: true,
        second: 0,
        first: 0
    }

    const checked = in.reduce((state, byte) => ({
        valid:
            state.valid &&
            (
                byte >= ascii_space || byte == ascii_tab || byte == ascii_line_feed ||
                    byte == ascii_carriage_return
            ) && !(
                state.second == utf8_bmp_noncharacter_lead &&
                    state.first == utf8_bmp_noncharacter_middle &&
                    byte >= utf8_bmp_noncharacter_tail
            ),
        second: state.first,
        first: byte
    }), initial)

    return checked.valid ? no_diagnostic : forbidden_character
}
