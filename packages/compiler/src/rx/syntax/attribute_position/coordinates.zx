import memory from "std:memory"
import { ascii_carriage_return, ascii_line_feed } from "core/ascii/const"

import type { U64Buffer } from "std:memory"

export type Input = {
    raw: u8[],
    count: u64,
    line: u64,
    column: u64,
    xml_newlines: bool,
    position: U64Buffer
}

export type Output = void

export default function (in: Input): Output {
    const final = loop({
        index: 0,
        line: in.line,
        column: in.column,
        previous_cr: false
    }, {
        while: state => state.index < in.count,
        next: state => {
            const byte = in.raw[state.index]
            const cr = in.xml_newlines && byte == ascii_carriage_return
            const lf = byte == ascii_line_feed
            const newline = (
                - cr
                - or (lf && !state.previous_cr)
            )

            if (newline) {
                state.line += 1
                state.column = 1
            } else if (!lf) {
                state.column += 1
            }

            state.previous_cr = cr
            state.index += 1
        },
        return: state => state
    })

    memory.writeU64(in.position, 0, final.line)
    memory.writeU64(in.position, 1, final.column)
}
