import { Issue } from "./model"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const first = in.first_else

    if (first == null) {
        return null
    }

    if (first != 0 && first == in.count - 1) {
        return null
    }

    return {
        issue: Issue.MisplacedElse,
        index: first
    }
}
