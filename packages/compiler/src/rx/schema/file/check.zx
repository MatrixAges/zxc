import {app_file, gateway_suffix, rx_suffix, store_suffix} from "../../../const"
import ends from "../../path_kind/ends"
import equal from "../../path_kind/equal"
import { Kind } from "./model"

export type Input = u8[]

export type Output = Kind

export default function (in: Input): Output {
    if (equal({
        source: in,
        start: 0,
        pattern: app_file
    })) {
        return Kind.App
    }

    if (ends({
        source: in,
        pattern: gateway_suffix
    })) {
        return Kind.Gateway
    }

    if (ends({
        source: in,
        pattern: store_suffix
    })) {
        return Kind.Store
    }

    return ends({
        source: in,
        pattern: rx_suffix
    }) ? Kind.Module : Kind.Invalid
}
