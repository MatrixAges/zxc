export type Input = u8[]

export type Output = bool

export default function (in: Input): Output {
  const state = loop({ source: in, offset: 0 }, {
    while: value => value.offset < value.source.length && (value.source[value.offset] == 32 || value.source[value.offset] == 9 || value.source[value.offset] == 13 || value.source[value.offset] == 10),
    next: value => {
      value.offset += 1
    }
  })

  return state.offset < state.source.length
}
