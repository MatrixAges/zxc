import {
    ascii_space,
    ascii_tab,
    ascii_carriage_return,
    ascii_line_feed
} from "core/ascii/const"

export type Input = u8[]

export type Output = bool

export default function (in: Input): Output {
    const state = loop({
        source: in,
        offset: 0
    }, {
        while: value => {
            const remaining = value.offset < value.source.length

            return match {
                remaining => match value.source[value.offset] {
                    ascii_space => true,
                    ascii_tab => true,
                    ascii_carriage_return => true,
                    ascii_line_feed => true,
                    _ => false
                },
                _ => false
            }
        },
        next: value => {
            value.offset += 1
        }
    })

    return state.offset < state.source.length
}
