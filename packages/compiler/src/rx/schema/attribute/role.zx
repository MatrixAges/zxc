import { Role } from "./model"

export type Input = { element: string, attribute: string }

export type Output = Role

export default function (in: Input): Output {
    switch (in.element) {
        case "Call":
            return match {
                in.attribute == "in" => Role.Value,
                in.attribute == "setter" => Role.Expression,
                _ => Role.Static
            }
        case "Switch":
            return in.attribute == "on" ? Role.Value : Role.Static
        case "Return":
            return in.attribute == "value" ? Role.Value : Role.Static
        case "Case":
            return in.attribute == "value" ? Role.Value : Role.Static
        case "Emit":
            return in.attribute == "value" ? Role.Value : Role.Static
        case "Field":
            return match {
                in.attribute == "type" => Role.Type,
                in.attribute == "value" => Role.Value,
                _ => Role.Static
            }
        case "Task":
            return in.attribute == "out" ? Role.Expression : Role.Static
        case "Args":
            return in.attribute == "in" || in.attribute == "out" ? Role.Type : Role.Static
        case "Store":
            return in.attribute == "version" ? Role.Expression : Role.Static
        case "Gateway":
            return in.attribute == "max_header_bytes" || in.attribute == "max_body_bytes" ? Role.Expression : Role.Static
        default:
            return Role.Static
    }
}
