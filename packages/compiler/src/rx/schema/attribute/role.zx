import { Role } from "./model"

export type Input = {
    element: string,
    attribute: string
}

export type Output = Role

export default function (in: Input): Output {
    switch (in.element) {
        case "Call":
            return match in.attribute {
                "in" => Role.Value,
                "setter" => Role.Expression,
                _ => Role.Static
            }
        case "Switch":
            return in.attribute == "on" ? Role.Value : Role.Static
        case "If":
            return in.attribute == "on" ? Role.Expression : Role.Static
        case "Return":
            return in.attribute == "value" ? Role.Value : Role.Static
        case "Case":
            return in.attribute == "value" ? Role.Value : Role.Static
        case "Emit":
            return in.attribute == "value" ? Role.Value : Role.Static
        case "Field":
            return match in.attribute {
                "type" => Role.Type,
                "value" => Role.Value,
                _ => Role.Static
            }
        case "Task":
            return in.attribute == "out" ? Role.Expression : Role.Static
        case "Args":
            return match {
                in.attribute == "in" || in.attribute == "out" => Role.Type,
                _ => Role.Static
            }
        case "Store":
            return in.attribute == "version" ? Role.Expression : Role.Static
        case "Gateway":
            return match {
                in.attribute == "max_header_bytes" ||
                    in.attribute == "max_body_bytes" => Role.Expression,
                _ => Role.Static
            }
        default:
            return Role.Static
    }
}
