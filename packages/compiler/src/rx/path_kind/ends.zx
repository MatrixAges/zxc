import starts from "../syntax/starts"

export type Input = { source: u8[], pattern: u8[] }

export type Output = bool

export default function (in: Input): Output {
  if (in.source.length < in.pattern.length) {
    return false
  }

  return starts({ source: in.source, offset: in.source.length - in.pattern.length, text: in.pattern })
}
