import { ascii_backslash, ascii_colon, ascii_null, ascii_slash } from "core/ascii/const"

export type Input = u8[]

export type Output = u64

export default function (in: Input): Output {
    if (
        in.length == 0 || in[0] == ascii_slash
    ) {
        return in.length
    }

    const state = loop({
        source: in,
        offset: 0,
        start: 0,
        valid: true
    }, {
        while: value => value.valid && value.offset < value.source.length,
        next: value => {
            const byte = value.source[value.offset]

            value.valid =
                byte != ascii_null && byte != ascii_colon && byte != ascii_backslash

            if (byte == ascii_slash) {
                value.start = value.offset + 1
            }

            value.offset += 1
        }
    })

    if (!state.valid) {
        return in.length
    }

    return state.start == in.length ? state.start - 1 : state.start
}
