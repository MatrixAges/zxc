import {app_file, gateway_suffix, rx_suffix, store_suffix} from "../../const"
import ends from "./ends"
import equal from "./equal"

export type Input = {
    source: u8[],
    start: u64
}

export type Output = bool

export default function (in: Input): Output {
    const remaining = in.source.length - in.start

    if (remaining <= rx_suffix.length) {
        return false
    }

    const rx_file = ends({
        source: in.source,
        pattern: rx_suffix
    })

    if (!rx_file) {
        return false
    }

    const entry = equal({
        source: in.source,
        start: in.start,
        pattern: app_file
    })

    if (entry) {
        return false
    }

    const gateway = ends({
        source: in.source,
        pattern: gateway_suffix
    })

    if (gateway) {
        return false
    }

    return !ends({
        source: in.source,
        pattern: store_suffix
    })
}
