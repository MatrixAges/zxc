import {app_file, gateway_suffix, rx_suffix, store_suffix} from "../../const"
import ends from "./ends"
import equal from "./equal"

export type Input = {
    source: u8[],
    start: u64
}

export type Output = bool

export default function (in: Input): Output {
    return in.source.length - in.start > rx_suffix.length &&
        ends({
            source: in.source,
            pattern: rx_suffix
        }) &&
        !equal({
            source: in.source,
            start: in.start,
            pattern: app_file
        }) &&
        !ends({
            source: in.source,
            pattern: gateway_suffix
        }) &&
        !ends({
            source: in.source,
            pattern: store_suffix
        })
}
