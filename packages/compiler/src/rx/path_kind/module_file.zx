import ends from "./ends"
import equal from "./equal"

export type Input = { source: u8[], start: u64 }

export type Output = bool

export default function (in: Input): Output {
  return in.source.length - in.start > 3 &&
    ends({ source: in.source, pattern: [46, 114, 120] }) &&
    !equal({ source: in.source, start: in.start, pattern: [97, 112, 112, 46, 114, 120] }) &&
    !ends({ source: in.source, pattern: [46, 103, 97, 116, 101, 119, 97, 121, 46, 114, 120] }) &&
    !ends({ source: in.source, pattern: [46, 115, 116, 111, 114, 101, 46, 114, 120] })
}
