import type { Modules } from "core/native_module_table/model"
import type { Value } from "./model"

export type Input = { table: Modules, value: Value, index: u64 }

export type Output = bool

export default function (in: Input): Output {
    const names = in.table.type_names[in.index]
    const ids = in.table.type_ids[in.index]
    const namespace = in.table.type_namespaces[in.index]

    if (names.length != in.value.names.length || ids.length != in.value.ids.length || namespace.length != in.value.namespace.length) {
        return false
    }

    const same_namespace = loop({ left: namespace, right: in.value.namespace, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.left.length,
        next: current => {
            current.valid = current.left[current.index] == current.right[current.index]
            current.index += 1
        }
    }).valid

    return loop({ names: names, ids: ids, value: in.value, index: 0, valid: same_namespace }, {
        while: current => current.valid && current.index < current.names.length,
        next: current => {
            current.valid = current.names[current.index] == current.value.names[current.index] && current.ids[current.index] == current.value.ids[current.index]
            current.index += 1
        }
    }).valid
}
