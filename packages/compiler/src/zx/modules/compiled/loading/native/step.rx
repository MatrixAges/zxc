<Module>
    <Type from="model" as="Model" />

    <Args
        in={{
            index: u64,
            request: Model.Request,
            state: Model.State
        }}
        out={Model.State}
    />

    <Call
        fn="rebind"
        in={{
            source: $in.request.source,
            instance: $in.request.instance,
            index: $in.index
        }}
    />

    <Call
        fn="intern"
        in={{
            base: $in.request.base,
            value: $ctx.rebind,
            types: $in.request.types,
            state: $in.state,
            maximum: $in.request.maximum
        }}
    />

    <Return value={$ctx.intern} />
</Module>
