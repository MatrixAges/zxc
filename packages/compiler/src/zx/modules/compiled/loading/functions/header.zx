import integers from "std:integer"

import scope from "../../identity/scope"

import type { Header, Request } from "./model"

export type Input = Request

export type Output = Header

export default function (in: Input): Output {
    const { header, mapping, instance } = in

    const native_id = header.native_module

    const module_id: u32? = match {
        native_id == null => null,
        _ => mapping.natives[integers.widen(native_id)]
    }

    return {
        file: scope({
            instance,
            value: header.file
        }),
        input_type: mapping.types[integers.widen(header.input_type)],
        output_type: mapping.types[integers.widen(header.output_type)],
        native_module: module_id
    }
}
