import integers from "std:integer"

import scope from "../identity/scope"
import members from "./members"
import ids from "./remap/ids"

import type { Literal, Values } from "core/constant/model"
import type { Imports } from "../../function_import"
import type { Exports } from "../model"

export type Input = {
    source: Exports,
    mapping: u32[],
    first: u64,
    instance: string
}

export type Output = Exports

export default function (in: Input): Output {
    const paths: string[] = []
    const functions: u32?[] = []
    const types: u32[][] = []

    const constants: Values?[] = []
    const function_members: Imports[] = []

    const result = loop({
        input: in,
        paths: paths,
        functions: functions,
        types: types,
        constants: constants,
        members: function_members,
        index: 0
    }, {
        while: current => current.index < current.input.source.names.length,
        next: current => {
            const function_id = current.input.source.functions[current.index]
            const mapped: u32? = function_id == null ? null :
                integers.narrow(
                    current.input.first + integers.widen(
                        function_id
                    )
                )

            current.paths = current.paths.push(scope({
                instance: current.input.instance,
                value: current.input.source.paths[current.index]
            }))[0]
            current.functions = current.functions.push(mapped)[0]
            current.types = current.types.push(ids({
                values: current.input.source.type_ids[current.index],
                mapping: current.input.mapping
            }))[0]
            const source = current.input.source.constants[current.index]
            const empty: Literal[] = []
            const mapped_constants: Values? = source == null ? null : {
                names: source.names,
                values: loop({
                    source: source.values,
                    mapping: current.input.mapping,
                    values: empty,
                    index: 0
                }, {
                    while: row => row.index < row.source.length,
                    next: row => {
                        const value = row.source[row.index]

                        row.values = row.values.push({
                            ...value,
                            type_id:
                                row.mapping[integers.widen(
                                    value.type_id
                                )]
                        })[0]
                        row.index += 1
                    }
                }).values
            }

            current.members = current.members.push(members({
                source: current.input.source.members[current.index],
                mapping: current.input.mapping,
                first: current.input.first
            }))[0]
            current.constants = current.constants.push(mapped_constants)[0]
            current.index += 1
        }
    })

    return {
        ...in.source,
        paths: result.paths,
        functions: result.functions,
        type_ids: result.types,
        constants: result.constants,
        members: result.members
    }
}
