import integers from "std:integer"

import scope from "../identity/scope"
import members from "./members"
import ids from "./remap/ids"

import type { Literal, Values } from "core/constant/model"
import type { Imports } from "../../function_import"
import type { Exports } from "../model"
import type { Output as Selection } from "./selection/plan"

export type Input = {
    source: Exports,
    selection: Selection,
    mapping: u32[],
    first: u64,
    instance: string
}

export type Output = Exports

export default function (in: Input): Output {
    const paths: string[] = []
    const functions: u32?[] = []
    const types: u32[][] = []

    const constants: Values?[] = []
    const function_members: Imports[] = []
    const source_rows = in.selection.rows
    const select_all = source_rows.length == 0

    const result = loop({
        paths,
        functions,
        types,
        constants,
        members: function_members,
        index: 0
    }, {
        while: current => current.index < in.selection.names.length,
        next: current => {
            const row = select_all ? current.index : source_rows[current.index]
            const function_id = in.source.functions[row]
            const mapped: u32? = match {
                function_id == null => null,
                _ => integers.narrow(
                    in.first + integers.widen(
                        function_id
                    )
                )
            }

            current.paths = current.paths.push(scope({
                instance: in.instance,
                value: in.source.paths[row]
            }))[0]
            current.functions = current.functions.push(mapped)[0]
            current.types = current.types.push(ids({
                values: in.source.type_ids[row],
                mapping: in.mapping
            }))[0]
            const source = in.source.constants[row]
            const empty: Literal[] = []
            const mapped_constants: Values? = match {
                source == null => null,
                _ => {
                    names: source.names,
                    values: loop({
                        source: source.values,
                        mapping: in.mapping,
                        values: empty,
                        index: 0
                    }, {
                        while: row => row.index < row.source.length,
                        next: row => {
                            const value = row.source[row.index]

                            row.values = row.values.push({
                                ...value,
                                type_id:
                                    row.mapping[integers.widen(
                                        value.type_id
                                    )]
                            })[0]
                            row.index += 1
                        },
                        return: state => state.values
                    })
                }
            }

            current.members = current.members.push(members({
                source: in.source.members[row],
                mapping: in.mapping,
                first: in.first
            }))[0]
            current.constants = current.constants.push(mapped_constants)[0]
            current.index += 1
        }
    })

    return {
        names: in.selection.names,
        paths: result.paths,
        functions: result.functions,
        type_names: in.selection.type_names,
        type_ids: result.types,
        constants: result.constants,
        members: result.members
    }
}
