import { missing_public_module } from "./const"
import locate from "./locate"

import type { Exports, Selection, SelectionPlan } from "../../model"

export type Input = {
    source: Exports,
    selection?: Selection
}

export type Output = {
    status: u64,
    selection?: SelectionPlan
}

export default function (in: Input): Output {
    const { source, selection } = in

    if (selection == null) {
        return {
            status: 0,
            selection: null
        }
    }

    const rows: u64[] = []

    const result = loop({
        index: 0,
        rows,
        aliases: rows,
        first: rows,
        found: true
    }, {
        while: current =>
            current.found && current.index < selection.modules.length,
        next: current => {
            const module = selection.modules[current.index]
            const row = locate({
                names: source.names,
                module
            })

            if (row < source.names.length) {
                const selected_rows = current.rows
                const selected = loop({
                    index: 0
                }, {
                    while: item =>
                        item.index < selected_rows.length &&
                        selected_rows[item.index] != row,
                    next: item => {
                        item.index += 1
                    },
                    return: item => item.index
                })

                if (selected == selected_rows.length) {
                    current.rows = current.rows.push(row)[0]
                    current.first = current.first.push(current.index)[0]
                }

                current.aliases = current.aliases.push(selected)[0]
            } else {
                current.found = false
            }

            current.index += 1
        }
    })

    return {
        status: result.found ? 0 : missing_public_module,
        selection: {
            rows: result.rows,
            names: selection.names,
            aliases: result.aliases,
            first: result.first
        }
    }
}
