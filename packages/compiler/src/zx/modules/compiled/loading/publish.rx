<Module>
    <Type from="type_delta" as="TypeDelta" />
    <Type from="../model" as="Model" />
    <Type from="types/initial" as="Initial" />
    <Type from="native/model" as="NativeModel" />

    <Args
        in={{
            base: TypeDelta.Output,
            input: Model.Input,
            merged: Initial.Output,
            native: NativeModel.State
        }}
        out={Model.Result}
    />

    <Call
        fn="type_delta"
        in={{
            base: $in.base,
            delta: $in.merged.delta,
            existing_count: $in.input.destination.types.kinds.length
        }}
    />

    <Call
        fn="selection/plan"
        in={{
            source: $in.input.graph.exports,
            selection: $in.input.selection
        }}
    />

    <If on={$ctx.plan.status != 0}>
        <Call fn="../empty" in={$ctx.plan.status} />

        <Return value={$ctx.empty} />
    </If>

    <Return
        value={{
            status: 0,
            types: $ctx.type_delta,
            origins: $in.merged.origins,
            natives: $in.native.delta,
            functions: {
                types: $in.input.type_ids,
                natives: $in.native.mapping
            },
            selection: $ctx.plan.selection
        }}
    />
</Module>
