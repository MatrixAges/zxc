import integers from "std:integer"

import ids from "./remap/ids"

import type { Imports } from "../../function_import"

export type Input = {
    source: Imports,
    mapping: u32[],
    first: u64
}

export type Output = Imports

export default function (in: Input): Output {
    const first = in.first

    return {
        ...in.source,
        ids:
            in.source.ids.map(
                value => value == null ? null :
                    integers.narrow(first + integers.widen(value))
            )[0],
        input_types: in.source.input_types.map(
            value =>
                value == null ? null : in.mapping[integers.widen(value)]
        )[0],
        output_types: in.source.output_types.map(
            value =>
                value == null ? null : in.mapping[integers.widen(value)]
        )[0]
    }
}
