import integers from "std:integer"
import { map } from "std:utils"

import ids from "./remap/ids"

import type { Imports } from "../../function_import"

export type Input = {
    source: Imports,
    mapping: u32[],
    first: u64
}

export type Output = Imports

export default function (in: Input): Output {
    const first = in.first

    return {
        ...in.source,
        ids:
            map(
                in.source.ids,
                value => value == null ? null :
                    integers.narrow(first + integers.widen(value))
            ),
        input_types: map(
            in.source.input_types,
            value =>
                value == null ? null : in.mapping[integers.widen(value)]
        ),
        output_types: map(
            in.source.output_types,
            value =>
                value == null ? null : in.mapping[integers.widen(value)]
        )
    }
}
