import copyNames from "../../../artifact/materializing/copy_names"
import own from "../../../artifact/materializing/symbols"
import ids from "./ids"

import type { Symbols } from "core/symbol_table/model"

export type Input = {
    source: Symbols,
    mapping: u32[]
}

export type Output = Symbols

export default function (in: Input): Output {
    return own({
        source: in.source,
        names: copyNames(in.source.names),
        types: ids({
            values: in.source.types,
            mapping: in.mapping
        })
    })
}
