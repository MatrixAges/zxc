import integers from "std:integer"

import copyNames from "../../../artifact/materializing/copy_names"
import own from "../../../artifact/materializing/expressions"
import ids from "./ids"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    source: Expressions,
    mapping: u32[],
    first: u64
}

export type Output = Expressions

export default function (in: Input): Output {
    return own({
        source: in.source,
        strings: copyNames(in.source.strings),
        types: ids({
            values: in.source.types,
            mapping: in.mapping
        }),
        call_functions:
            in.source.call_functions.map(
                value => integers.narrow(
                    in.first + integers.widen(
                        value
                    )
                )
            )[0]
    })
}
