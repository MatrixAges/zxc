import copyNames from "../../../artifact/materializing/copy_names"
import store from "../../identity/store"
import ids from "./ids"

import type { Stores } from "core/store_table/model"

export type Input = {
    source: Stores,
    mapping: u32[],
    instance: string
}

export type Output = Stores

export default function (in: Input): Output {
    return {
        handles: copyNames(in.source.handles),
        readable: in.source.readable.slice(),
        writable: in.source.writable.slice(),
        types: ids({
            values: in.source.types,
            mapping: in.mapping
        }),
        paths: in.source.paths.map(value => store({
            instance: in.instance,
            value
        }))[0]
    }
}
