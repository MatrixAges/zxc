import integers from "std:integer"
import { map } from "std:utils"

import store from "../identity/store"

import type { Initializers } from "../model"

export type Input = {
    source: Initializers,
    first: u64,
    instance: string
}

export type Output = Initializers

export default function (in: Input): Output {
    return {
        ...in.source,
        identities: map(in.source.identities, value => store({
            instance: in.instance,
            value
        })),
        functions:
            map(
                in.source.functions,
                value => integers.narrow(
                    in.first + integers.widen(
                        value
                    )
                )
            )
    }
}
