import integers from "std:integer"

import type { Table } from "core/type_table/model"

export type Input = { table: Table, scalar_count: u64 }

export type Output = Table

export default function (in: Input): Output {
    if (in.table.kinds.length != 0) {
        return in.table
    }

    const empty: Table = { kinds: [], first: [], second: [], labels: [], children: [], field_types: [], field_names: [], names: [] }
    const scalar: u8 = 0
    const zero: u32 = 0

    return loop({ table: empty, count: in.scalar_count, scalar: scalar, zero: zero, index: 0 }, {
        while: current => current.index < current.count,
        next: current => {
            current.table = { ...current.table, kinds: current.table.kinds.push(current.scalar)[0], first: current.table.first.push(integers.narrow(current.index))[0], second: current.table.second.push(current.zero)[0], labels: current.table.labels.push("")[0] }
            current.index += 1
        }
    }).table
}
