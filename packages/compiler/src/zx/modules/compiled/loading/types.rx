<Module>
    <Type from="./types/model" as="Model" />
    <Type from="./types/initial" as="Initial" />

    <Args in={Model.Request} out={Initial.Output} />

    <Call fn="types/initial" in={$in} />

    <Call
        module="../../../analysis/semantic/preflight"
        in={{
            source: $in.source,
            target: $in.base,
            origins: $in.origins,
            names: $in.names,
            first: 0
        }}
    />

    <If on={$ctx.preflight != null}>
        <Call
            module="../../../analysis/semantic/merge"
            in={{
                request: {
                    source: $in.source,
                    origins: $in.origins,
                    origin_indices: $ctx.preflight,
                    base: $in.base,
                    base_origins: $in.base_origins,
                    first: 0,
                    checked: true
                },
                state: $ctx.initial
            }}
        />

        <Return value={$ctx.merge} />

        <Else>
            <Return
                value={{
                    ...$ctx.initial,
                    status: 3
                }}
            />
        </Else>
    </If>
</Module>
