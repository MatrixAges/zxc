import type { Result } from "./model"

export type Input = u64

export type Output = Result

export default function (in: Input): Output {
    return {
        status: in,
        types: {
            kinds: [],
            first: [],
            second: [],
            labels: [],
            children: [],
            field_types: [],
            field_names: [],
            names: []
        },
        origins: {
            ids: [],
            kinds: [],
            owners: [],
            members: []
        },
        natives: {
            identities: [],
            import_names: [],
            specifiers: [],
            type_ids: [],
            type_names: [],
            type_namespaces: []
        },
        functions: {
            types: [],
            natives: []
        },
        exports: {
            names: [],
            paths: [],
            functions: [],
            type_names: [],
            type_ids: [],
            constants: [],
            members: []
        },
        initializers: {
            identities: [],
            versions: [],
            functions: []
        },
        aliases: {
            names: [],
            rows: [],
            first: []
        }
    }
}
