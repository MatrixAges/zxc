import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import kind from "../../../../analysis/semantic/types/kind"
import text from "../../../../ir/canonical/native/text"
import slots from "./slots"

import type { Graph } from "../../model"

export type Input = { graph: Graph, index: u64 }

export type Output = bool

export default function (in: Input): Output {
    const initializers = in.graph.initializers
    const identity = initializers.identities[in.index]
    const index = integers.widen(initializers.functions[in.index])
    const functions = in.graph.program.context.functions
    const table = in.graph.program.context.table

    if (!text(identity) || identity.length <= 6 || identity[0] != 115 || identity[1] != 116 || identity[2] != 111 || identity[3] != 114 || identity[4] != 101 || identity[5] != 46 || index >= functions.files.length) {
        return false
    }

    const input_id = integers.widen(functions.input_types[index])
    const output_id = integers.widen(functions.output_types[index])

    if (kind(table.kinds[input_id]) != Kind.Scalar || table.first[input_id] != 0 || kind(table.kinds[output_id]) != Kind.Object || functions.native_modules[index] != null || functions.stores[index].paths.length != 0 || functions.contracts[index].kinds.length != 0) {
        return false
    }

    const pure = loop({ kinds: functions.expressions[index].kinds, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.kinds.length,
        next: current => {
            current.valid = current.kinds[current.index] != ExpressionKind.Call
            current.index += 1
        }
    }).valid

    return pure && slots({ stores: functions.stores, identity: identity, type_id: functions.output_types[index] })
}
