import integers from "zig:integers"

import text from "../../../../ir/canonical/native/text"
import unique from "../unique"

import type { Complete } from "core/function_table/complete"

export type Input = { names: string[], ids: u32[], count: u64, function_id: u32?, functions: Complete }

export type Output = bool

export default function (in: Input): Output {
    return loop({ input: in, index: 0, valid: unique(in.names) }, {
        while: current => current.valid && current.index < current.input.names.length,
        next: current => {
            const name = current.input.names[current.index]
            const id = current.input.ids[current.index]
            const function_id = current.input.function_id

            current.valid = text(name) && integers.widen(id) < current.input.count

            if (current.valid && function_id != null) {
                const index = integers.widen(function_id)

                current.valid = (name != "Input" || id == current.input.functions.input_types[index]) && (name != "Output" || id == current.input.functions.output_types[index])
            }

            current.index += 1
        }
    }).valid
}
