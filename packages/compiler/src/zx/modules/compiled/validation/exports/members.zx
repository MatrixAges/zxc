import integers from "std:integer"

import text from "../../../../ir/canonical/native/text"
import unique from "../unique"

import type { Values } from "core/constant/model"
import type { Complete } from "core/function_table/complete"
import type { Imports } from "../../../function_import"

export type Input = {
    members: Imports,
    types: string[],
    constants?: Values,
    functions: Complete
}

export type Output = bool

export default function (in: Input): Output {
    const members = in.members
    const count = members.names.length

    if (
        members.namespaces.length != count || members.ids.length != count ||
            members.input_types.length != count ||
            members.output_types.length != count || members.intrinsics.length != count
    ) {
        return false
    }

    if (count == 0 && in.constants == null) {
        return true
    }

    const names = in.types.concat(members.names)[0]
    const constants = in.constants
    const public_names = constants == null ? names : names.concat(constants.names)[0]

    return loop({
        input: in,
        index: 0,
        valid: unique(public_names)
    }, {
        while: current =>
            current.valid && current.index < current.input.members.names.length,
        next: current => {
            const values = current.input.members
            const row = current.index
            const id = values.ids[row]
            const input = values.input_types[row]
            const output = values.output_types[row]

            current.valid =
                (
                    text(values.names[row]) ||
                        (
                            values.names[row] == "" &&
                                values.intrinsics[row] != null
                        )
                ) && values.namespaces[row] == null

            if (current.valid) {
                if (values.intrinsics[row] != null) {
                    current.valid = id == null && input == null && output == null
                } else if (id != null && input != null && output != null) {
                    current.valid =
                        integers.widen(id) < current.input.functions.files.length

                    if (current.valid) {
                        current.valid =
                            input ==
                            current.input.functions.input_types[integers.widen(
                                id
                            )] &&
                            output ==
                            current.input.functions.output_types[integers.widen(
                                id
                            )]
                    }
                } else {
                    current.valid = false
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
