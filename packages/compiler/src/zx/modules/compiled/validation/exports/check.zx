import integers from "std:integer"

import validConstants from "../../../../analysis/constants/valid"
import text from "../../../../ir/canonical/native/text"
import members from "./members"
import types from "./types"

import type { Graph } from "../../model"

export type Input = {
    graph: Graph,
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const exports = in.graph.exports
    const name = exports.names[in.index]
    const path = exports.paths[in.index]
    const function_id = exports.functions[in.index]
    const functions = in.graph.program.context.functions

    const condition = (
        - !text(name)
        - or !text(path)
        - or exports.type_names[in.index].length != exports.type_ids[in.index].length
    )

    if (condition) {
        return false
    }

    if (function_id != null) {
        const index = integers.widen(function_id)

        if (
            index >= functions.files.length ||
                functions.native_modules[index] != null
        ) {
            return false
        }
    }

    if (!validConstants({
        constants: exports.constants[in.index],
        types: {
            base: in.graph.program.context.table,
            delta: {
                kinds: [],
                first: [],
                second: [],
                labels: [],
                children: [],
                field_types: [],
                field_names: [],
                names: []
            }
        }
    })) {
        return false
    }

    return members({
        members: exports.members[in.index],
        types: exports.type_names[in.index],
        constants: exports.constants[in.index],
        functions
    }) && types({
        names: exports.type_names[in.index],
        ids: exports.type_ids[in.index],
        count: in.graph.program.context.table.kinds.length,
        function_id,
        functions
    })
}
