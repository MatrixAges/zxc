export type Input = {
    type_only: bool,
    export_count: u64,
    constant_exports: bool,
    store_count: u64,
    public_count: u64
}

export type Output = bool

export default function (in: Input): Output {
    return (
        - in.type_only
        - and in.export_count == 0
        - and !in.constant_exports
        - and in.store_count == 0
        - and in.public_count != 0
    )
}
