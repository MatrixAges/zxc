export type Input = {
    type_only: bool,
    export_count: u64,
    constant_exports: bool,
    store_count: u64,
    public_count: u64
}

export type Output = bool

export default function (in: Input): Output {
    return in.type_only && in.export_count == 0 && !in.constant_exports &&
        in.store_count == 0 && in.public_count != 0
}
