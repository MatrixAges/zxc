export type Input = string[]

export type Output = bool

export default function (in: Input): Output {
    const names = in.sort()[0]

    return loop({ names: names, index: 1, valid: true }, {
        while: current => current.valid && current.index < current.names.length,
        next: current => {
            current.valid = current.names[current.index - 1] != current.names[current.index]
            current.index += 1
        }
    }).valid
}
