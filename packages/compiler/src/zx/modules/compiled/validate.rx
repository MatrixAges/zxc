<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Graph} out={bool} />

    <Call fn="validation/header" in={$in} />

    <If on={!$ctx.header}>
        <Return value={false} />
    </If>

    <Call module="../../ir/canonical/validation/validate" in={$in.program} />

    <If on={!$ctx.validate}>
        <Return value={false} />
    </If>

    <Call
        module="../../analysis/semantic/origins"
        in={{
            table: $in.program.context.table,
            origins: $in.origins,
            names: $in.origin_names
        }}
    />

    <If on={!$ctx.origins}>
        <Return value={false} />
    </If>

    <Call fn="validation/nominal" in={$in} />

    <If on={!$ctx.nominal}>
        <Return value={false} />
    </If>

    <Call fn="validation/initializers" in={$in} />

    <If on={!$ctx.initializers}>
        <Return value={false} />
    </If>

    <Call fn="validation/exports" in={$in} />

    <If on={!$ctx.exports}>
        <Return value={false} />
    </If>

    <Call fn="validation/stores" in={$in.program.context.functions.stores} />

    <If on={!$ctx.stores}>
        <Return value={false} />
    </If>

    <Return value={true} />
</Module>
