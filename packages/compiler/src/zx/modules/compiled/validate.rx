<Module>
    <Call fn="validation/header" in={$in} />

    <Switch on={$ctx.header}>
        <Case value={false}>
            <Return value={false} />
        </Case>
    </Switch>

    <Call module="../../ir/canonical/validation/validate" in={$in.program} />

    <Switch on={$ctx.validate}>
        <Case value={false}>
            <Return value={false} />
        </Case>
    </Switch>

    <Call module="../../analysis/semantic/origins" in={{ table: $in.program.context.table, origins: $in.origins, names: $in.origin_names }} />

    <Switch on={$ctx.origins}>
        <Case value={false}>
            <Return value={false} />
        </Case>
    </Switch>

    <Call fn="validation/nominal" in={$in} />

    <Switch on={$ctx.nominal}>
        <Case value={false}>
            <Return value={false} />
        </Case>
    </Switch>

    <Call fn="validation/initializers" in={$in} />

    <Switch on={$ctx.initializers}>
        <Case value={false}>
            <Return value={false} />
        </Case>
    </Switch>

    <Call fn="validation/exports" in={$in} />

    <Switch on={$ctx.exports}>
        <Case value={false}>
            <Return value={false} />
        </Case>
    </Switch>

    <Call fn="validation/stores" in={$in.program.context.functions.stores} />

    <Switch on={$ctx.stores}>
        <Case value={false}>
            <Return value={false} />
        </Case>
    </Switch>

    <Return value={true} />
</Module>
