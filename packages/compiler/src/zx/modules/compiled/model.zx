import type { U32Buffer } from "std:memory"
import type { Values } from "core/constant/model"
import type { Modules } from "core/native_module_table/model"
import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Program } from "../../ir/canonical/validation/model"
import type { Imports } from "../function_import"
import type { Mapping as FunctionMapping } from "./loading/functions/model"

export type Exports = {
    names: string[],
    paths: string[],
    functions: u32?[],
    type_names: string[][],
    type_ids: u32[][],
    constants: Values?[],
    members: Imports[]
}

export type Initializers = {
    identities: string[],
    versions: u32[],
    functions: u32[]
}

export type Selection = {
    names: string[],
    modules: string[]
}

export type Aliases = {
    names: string[],
    rows: u64[],
    first: u64[]
}

export type Graph = {
    program: Program,
    origins: Bindings,
    origin_names: string[],
    exports: Exports,
    initializers: Initializers
}

export type Destination = {
    types: Table,
    origins: Bindings,
    origin_names: string[],
    natives: Modules,
    function_count: u64
}

export type Input = {
    graph: Graph,
    instance: string,
    artifact: string,
    load: bool,
    seed: bool,
    publish_interfaces: bool,
    destination: Destination,
    type_ids: u32[],
    type_mapping: U32Buffer,
    selection?: Selection
}

export type Result = {
    status: u64,
    types: Table,
    origins: Bindings,
    natives: Modules,
    functions: FunctionMapping,
    exports: Exports,
    initializers: Initializers,
    aliases: Aliases
}
