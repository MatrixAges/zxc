import crypto from "std:crypto"
import encoding from "std:encoding"

import scope from "./scope"

export type Input = { instance: string, value: string }

export type Output = string

export default function (in: Input): Output {
    const identity = scope(in)
    const digest = crypto.sha256(encoding.encodeUtf8(identity))
    const encoded = encoding.encodeHex(digest)

    return `library_native_${encoded}`
}
