import crypto from "std:crypto"
import encoding from "std:encoding"

import scope from "./scope"

export type Input = {
    instance: string,
    value: string
}

export type Output = string

export default function (in: Input): Output {
    return scope(in)
        -> encoding.encodeUtf8(_)
        -> crypto.sha256(_)
        -> encoding.encodeHex(_)
        -> `library_native_${_}`
}
