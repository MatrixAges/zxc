<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Input} out={Model.Result} />

    <Call
        fn="loading/type_base"
        in={{
            table: $in.destination.types,
            scalar_count: $in.graph.program.context.scalar_count
        }}
    />

    <Call
        fn="loading/origins"
        in={{
            instance: $in.instance,
            origins: $in.graph.origins,
            modules: $in.graph.program.context.modules
        }}
    />

    <Call
        module="loading/types"
        in={{
            source: $in.graph.program.context.table,
            origins: $ctx.origins,
            names: $in.graph.origin_names,
            base: $ctx.type_base,
            base_origins: $in.destination.origins
        }}
    />

    <If on={$ctx.types.status == 0}>
        <Call
            fn="loading/capacity"
            in={{
                existing: $in.destination.function_count,
                added: $in.graph.program.context.functions.files.length,
                maximum: $in.graph.program.context.maximum_count
            }}
        />

        <If on={$ctx.capacity}>
            <Call
                fn="loading/native/walk"
                in={{
                    source: $in.graph.program.context.modules,
                    base: $in.destination.natives,
                    types: $ctx.types.mapping,
                    instance: $in.instance,
                    maximum: $in.graph.program.context.maximum_count
                }}
            />

            <If on={$ctx.walk.status == 0}>
                <Call
                    module="loading/publish"
                    in={{
                        input: $in,
                        base: $ctx.type_base,
                        merged: $ctx.types,
                        native: $ctx.walk
                    }}
                />

                <Return value={$ctx.publish} />

                <Else>
                    <Call fn="empty" in={$ctx.walk.status} />

                    <Return value={$ctx.empty} />
                </Else>
            </If>

            <Else>
                <Call fn="empty" in={6} />

                <Return value={$ctx.empty} />
            </Else>
        </If>

        <Else>
            <Call fn="loading/merge_status" in={$ctx.types.status} />
            <Call fn="empty" in={$ctx.merge_status} />

            <Return value={$ctx.empty} />
        </Else>
    </If>
</Module>
