<Module>
    <Call module="destination" in={{ seed: $in.seed, destination: $in.destination }} />

    <Switch on={$ctx.destination}>
        <Case value={true}>
            <Call fn="identity/valid" in={{ instance: $in.instance, artifact: $in.artifact, load: $in.load }} />

            <Switch on={$ctx.valid}>
                <Case value={true}>
                    <Call module="validate" in={$in.graph} />

                    <Switch on={$ctx.validate}>
                        <Case value={true}>
                            <Switch on={$in.load}>
                                <Case value={true}>
                                    <Call module="load" in={$in} />

                                    <Return value={$ctx.load} />
                                </Case>

                                <Default>
                                    <Call fn="empty" in={0} />

                                    <Return value={$ctx.empty} />
                                </Default>
                            </Switch>
                        </Case>

                        <Default>
                            <Call fn="empty" in={1} />

                            <Return value={$ctx.empty} />
                        </Default>
                    </Switch>
                </Case>

                <Default>
                    <Call fn="empty" in={1} />

                    <Return value={$ctx.empty} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Call fn="empty" in={7} />

            <Return value={$ctx.empty} />
        </Default>
    </Switch>
</Module>
