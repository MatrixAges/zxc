<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Input} out={Model.Result} />

    <Call
        module="destination"
        in={{
            seed: $in.seed,
            destination: $in.destination
        }}
    />

    <If on={!$ctx.destination}>
        <Call fn="empty" in={7} />

        <Return value={$ctx.empty} />
    </If>

    <Call
        fn="identity/valid"
        in={{
            instance: $in.instance,
            artifact: $in.artifact,
            load: $in.load
        }}
    />

    <If on={!$ctx.valid}>
        <Call fn="empty" in={1} />

        <Return value={$ctx.empty} />
    </If>

    <Call module="validate" in={$in.graph} />

    <If on={!$ctx.validate}>
        <Call fn="empty" in={1} />

        <Return value={$ctx.empty} />
    </If>

    <If on={!$in.load}>
        <Call fn="empty" in={0} />

        <Return value={$ctx.empty} />
    </If>

    <Call module="load" in={$in} />

    <Return value={$ctx.load} />
</Module>
