<Module>
    <Type from="./model" as="Binding" />

    <Args in={Binding.Request} out={Binding.Result} />

    <Call fn="initial" in={$in} />

    <Switch on={$ctx.initial.diagnostic.message != ""}>
        <Case value={true}>
            <Return value={$ctx.initial} />
        </Case>
    </Switch>

    <Call fn="names" in={$in} />

    <Call
        fn="select"
        in={{
            request: {
                ...$in,
                names: $ctx.names
            },
            result: $ctx.initial
        }}
    />

    <Return value={$ctx.select} />
</Module>
