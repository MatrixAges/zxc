<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Request} out={Model.Result} />

    <Call fn="constraint" in={$in} />

    <Switch on={$ctx.constraint.diagnostic.message != ""}>
        <Case value={true}>
            <Return
                value={{
                    aliases: {
                        names: [],
                        ids: []
                    },
                    imports: {
                        namespaces: [],
                        names: [],
                        ids: [],
                        input_types: [],
                        output_types: []
                    },
                    constants: null,
                    diagnostic: $ctx.constraint.diagnostic
                }}
            />
        </Case>
    </Switch>

    <Switch on={$ctx.constraint.callable}>
        <Case value={true}>
            <Call fn="functions" in={$in} />

            <Return
                value={{
                    aliases: {
                        names: [],
                        ids: []
                    },
                    imports: $ctx.functions,
                    constants: null,
                    diagnostic: $ctx.constraint.diagnostic
                }}
            />
        </Case>

        <Default>
            <Call fn="constants" in={$in} />

            <Call
                fn="aliases"
                in={{
                    ...$in,
                    names: $ctx.constants.names
                }}
            />

            <Return
                value={{
                    aliases: $ctx.aliases.aliases,
                    imports: {
                        namespaces: [],
                        names: [],
                        ids: [],
                        input_types: [],
                        output_types: []
                    },
                    constants: $ctx.constants.values,
                    diagnostic: $ctx.aliases.diagnostic
                }}
            />
        </Default>
    </Switch>
</Module>
