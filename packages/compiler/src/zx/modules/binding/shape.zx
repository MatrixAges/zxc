import type { PortShape } from "./model"

export type Input = PortShape

export type Output = bool

export default function (in: Input): Output {
    const id = in.id != null
    const input = in.input_type != null
    const output = in.output_type != null

    if (in.intrinsic == null) {
        return id && input && output
    }

    return !id && !input && !output
}
