export type Input = {
    id: u32?,
    input_type: u32?,
    output_type: u32?,
    intrinsic: u8?
}

export type Output = bool

export default function (in: Input): Output {
    const id = in.id != null
    const input = in.input_type != null
    const output = in.output_type != null

    if (in.intrinsic == null) {
        return id && input && output
    }

    return !id && !input && !output
}
