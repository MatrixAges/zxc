import encoding from "std:encoding"

import { ImportKind } from "../../frontend/parser/imports/model"
import { executable_required, namespace_required, module_code } from "./const"
import { Target } from "./model"
import position from "./position"

import type { Request, Result } from "./model"

export type Input = Request

export type Output = Result

export default function (in: Input): Output {
    const native = in.target == Target.Native
    const callable = in.kind == ImportKind.Function

    const member = match {
        callable && !native => position({
            names: in.members,
            name: ""
        }),
        _ => null
    }

    const invalid = callable && (
        in.names.originals.length != 1 ||
            (native ? in.members.length == 0 : member == null)
    )

    const namespace: string? = match {
        !callable || !native || invalid => null,
        in.names.source == null => in.names.aliases[0],
        _ => encoding.sliceBytes(
            in.names.source,
            in.names.locals[0].start,
            in.names.locals[0].end
        )
    }

    const failure = native ? namespace_required : executable_required

    return {
        aliases: {
            names: [],
            indices: []
        },
        constants: {
            names: [],
            indices: []
        },
        functions: {
            names: [],
            indices: []
        },
        namespace,
        diagnostic: {
            code: invalid ? module_code : "",
            message: invalid ? failure : "",
            start: invalid ? in.start : 0,
            end: invalid ? in.end : 0
        }
    }
}
