import { ImportKind } from "../../frontend/parser/imports/model"
import { Section } from "./model"

import type { Names, Request } from "./model"

export type Input = Request

export type Output = Names

export default function (in: Input): Output {
    if (!in.wildcard) {
        return in.names
    }

    const type_only = in.kind == ImportKind.TypeOnly

    const result: Names = {
        values: [],
        aliases: [],
        starts: [],
        ends: []
    }

    return loop({
        input: in,
        type_only: type_only,
        stage: Section.Types,
        index: 0,
        result: result
    }, {
        while: current => current.stage != Section.Done,
        next: current => {
            const values = match current.stage {
                Section.Types => current.input.exports.names,
                Section.Constants => current.type_only ? [] : current.input.constants,
                _ => current.type_only ? [] : current.input.members
            }

            if (current.index >= values.length) {
                current.stage = match current.stage {
                    Section.Types => Section.Constants,
                    Section.Constants => Section.Functions,
                    _ => Section.Done
                }
                current.index = 0
            } else {
                const name = values[current.index]

                if (name != "") {
                    current.result = {
                        values: current.result.values.push(name)[0],
                        aliases: current.result.aliases.push(name)[0],
                        starts: current.result.starts.push(current.input.start)[0],
                        ends: current.result.ends.push(current.input.end)[0]
                    }
                }

                current.index += 1
            }
        }
    }).result
}
