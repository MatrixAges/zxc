import type { Cache, Diagnostic } from "../../analysis/semantic/resolving/model"
import type { Span } from "../../frontend/lexer/token_model"
import type { ImportKind } from "../../frontend/parser/imports/model"

export enum Target {
    Source,
    Compiled,
    Native
}

export type Names = {
    source?: string,
    locals: Span[],
    originals: Span[],
    values: string[],
    aliases: string[]
}

export type Name = {
    original: string,
    local: string,
    start: u64,
    end: u64
}

export type Request = {
    target: Target,
    kind: ImportKind,
    reexport: bool,
    wildcard: bool,
    start: u64,
    end: u64,
    names: Names,
    type_kinds: u8[],
    exports: Cache,
    constants: string[],
    members: string[]
}

export type Bindings = {
    names: string[],
    indices: u64[]
}

export type FunctionBinding = {
    namespace?: string,
    name: string,
    id?: u32,
    input_type?: u32,
    output_type?: u32,
    intrinsic?: u8
}

export type PortShape = {
    id?: u32,
    input_type?: u32,
    output_type?: u32,
    intrinsic?: u8
}

export type Result = {
    aliases: Bindings,
    constants: Bindings,
    functions: Bindings,
    namespace?: string,
    diagnostic: Diagnostic
}
