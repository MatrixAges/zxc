import type { Cache, Diagnostic } from "../../analysis/semantic/resolving/model"
import type { ImportKind } from "../../frontend/parser/imports/model"

export enum Target { Source, Compiled, Native }

export enum Section { Types, Constants, Functions, Done }

export type Names = {
    values: string[],
    aliases: string[],
    starts: u64[],
    ends: u64[]
}

export type Request = {
    target: Target,
    kind: ImportKind,
    reexport: bool,
    wildcard: bool,
    start: u64,
    end: u64,
    names: Names,
    type_kinds: u8[],
    exports: Cache,
    constants: string[],
    members: string[]
}

export type Bindings = {
    names: string[],
    indices: u64[]
}

export type Result = {
    aliases: Bindings,
    constants: Bindings,
    functions: Bindings,
    namespace: string?,
    diagnostic: Diagnostic
}
