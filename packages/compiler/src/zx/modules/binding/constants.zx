import lookup from "core/constant/lookup"

import { ImportKind } from "../../frontend/parser/imports/model"

import type { Literal, Values } from "core/constant/model"
import type { Names, Request } from "./model"

export type Input = Request

export type Output = {
    names: Names,
    values: Values?
}

export default function (in: Input): Output {
    if (in.kind != ImportKind.Enumeration || in.constant_exports == null) {
        return {
            names: in.names,
            values: null
        }
    }

    const names: Names = {
        values: [],
        starts: [],
        ends: []
    }

    const values: Literal[] = []
    const strings: string[] = []

    const selected = loop({
        input: in,
        index: 0,
        names: names,
        exported: strings,
        values: values
    }, {
        while: current => current.index < current.input.names.values.length,
        next: current => {
            const name = current.input.names.values[current.index]
            const value = lookup({
                constants: current.input.constant_exports,
                name: name
            })

            if (value != null) {
                current.exported = current.exported.push(name)[0]
                current.values = current.values.push(value)[0]
            } else {
                current.names = {
                    values: current.names.values.push(name)[0],
                    starts: current.names.starts.push(current.input.names.starts[current.index])[0],
                    ends: current.names.ends.push(current.input.names.ends[current.index])[0]
                }
            }

            current.index += 1
        }
    })

    return {
        names: selected.names,
        values: selected.exported.length != 0 ? {
            names: selected.exported,
            values: selected.values
        } : null
    }
}
