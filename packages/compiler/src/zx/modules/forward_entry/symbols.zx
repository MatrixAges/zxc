import type { Symbols } from "core/symbol_table/model"
import type { Parameter } from "./model"

export type Input = Parameter

export type Output = Symbols

export default function (in: Input): Output {
    return {
        names: [in.name],
        types: [in.type_id],
        span_start: [in.span_start],
        span_end: [in.span_end],
        ownership: [in.ownership]
    }
}
