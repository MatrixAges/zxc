import integers from "std:integer"
import empty from "core/expression_table/empty"
import { ExpressionKind } from "core/expression_table/kinds"

import { parameter_id, payload_index, reference_id } from "./const"

import type { Expressions } from "core/expression_table/model"
import type { Input as Request } from "./model"

export type Input = Request

export type Output = Expressions

export default function (in: Input): Output {
    const parameter = in.parameter
    const argument = in.unit ? ExpressionKind.Unit : ExpressionKind.Reference

    const stores =
        in.store_types.map((type_id, index) => integers.narrow(index))[0]

    return {
        ...empty(),
        kinds: [
            argument,
            ExpressionKind.Call
        ],
        types: [
            in.input_type,
            in.output_type
        ],
        span_start: [
            parameter.span_start,
            parameter.span_start
        ],
        span_end: [
            parameter.span_end,
            parameter.span_end
        ],
        payloads: [
            payload_index,
            payload_index
        ],
        references: match {
            in.unit => [],
            _ => [parameter_id]
        },
        call_functions: [in.function_id],
        call_arguments: [reference_id],
        call_store_first: [payload_index],
        call_store_count: [integers.narrow(stores.length)],
        call_stores: stores
    }
}
