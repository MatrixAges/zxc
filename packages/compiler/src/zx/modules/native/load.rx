<Module>
    <Type from="../../analysis/semantic/constructing/delta" as="Delta" />
    <Type from="core/type_table/nominal" as="Nominal" />
    <Type from="../../analysis/semantic/merging/origin" as="Origin" />
    <Type from="../../analysis/semantic/resolving/model" as="Model" />
    <Type from="./validation/model" as="ValidationModel" />
    <Type from="./interface/exports" as="Exports" />
    <Type from="./interface/members" as="Members" />

    <Args in={{ base: Delta.Output, namespace: u8[][], origin: Nominal.Origin, origins: Origin.Output, shared: bool, source: u8[] }} out={{ cache: Model.Cache, delta: Delta.Output, diagnostic: ValidationModel.Output, exports: Exports.Export[], members: Members.Output, origins: Origin.Output }} />

    <Call module="parse" in={$in.source} />

    <Switch on={$ctx.parse.diagnostic.message == ""}>
        <Case value={true}>
            <Call module="analyze" in={{
                context: {
                    source: { indexed: { bytes: $in.source, types: $ctx.parse.types, order: $ctx.parse.type_order, declarations: $ctx.parse.declarations, members: $ctx.parse.members }, native: null },
                    base: $in.base,
                    resolved: { names: [], ids: [] },
                    aliases: { names: [], ids: [] },
                    visiting: [],
                    native_interface: true
                },
                shared: $in.shared,
                origins: $in.origins,
                origin: $in.origin,
                namespace: $in.namespace,
                functions: $ctx.parse.functions,
                parameters: $ctx.parse.parameters,
                errors: $ctx.parse.errors
            }} />

            <Return value={$ctx.analyze} />
        </Case>

        <Default>
            <Return value={{ delta: { kinds: [], first: [], second: [], labels: [], children: [], field_types: [], field_names: [], names: [] }, cache: { names: [], ids: [] }, diagnostic: $ctx.parse.diagnostic, exports: [], members: [], origins: { ids: [], kinds: [], owners: [], members: [] } }} />
        </Default>
    </Switch>
</Module>
