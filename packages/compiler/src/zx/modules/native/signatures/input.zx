import { Kind } from "core/type_table/model"

import construct from "../../../analysis/semantic/resolving/construct"

import type { State } from "../../../analysis/semantic/resolving/model"

export type Input = { resolution: State, types: u32[] }

export type Output = State

export default function (in: Input): Output {
    if (in.resolution.diagnostic.message != "") {
        return in.resolution
    }

    if (in.types.length < 2) {
        return { ...in.resolution, result: in.types.length == 0 ? 0 : in.types[0] }
    }

    return construct({ state: in.resolution, candidate: { kind: Kind.Tuple, first: 0, second: 0, label: "", children: in.types, fields: { names: [], types: [] }, names: [] } })
}
