<Module>
    <Type from="../../analysis/semantic/resolving/model" as="Model" />

    <Args in={Model.Context} out={Model.State} />

    <Call
        fn="../../analysis/semantic/resolving/initial"
        in={{
            context: $in,
            delta: {
                kinds: [],
                first: [],
                second: [],
                labels: [],
                children: [],
                field_types: [],
                field_names: [],
                names: []
            },
            cache: {
                names: [],
                ids: []
            },
            initialize: true,
            named: false,
            name: {
                text: "",
                start: 0,
                end: 0
            },
            reference: {
                enumeration: false,
                index: 0
            }
        }}
    />

    <Call module="../../analysis/semantic/resolving/initialize" in={$ctx.initial} />

    <If on={$ctx.initialize.diagnostic.message == ""}>
        <Call
            fn="../../analysis/semantic/resolving/declarations"
            in={$ctx.initialize}
        />

        <Return value={$ctx.declarations} />

        <Else>
            <Return value={$ctx.initialize} />
        </Else>
    </If>
</Module>
