<Module>
    <Type from="../../frontend/parser/native/model" as="Model" />

    <Args in={u8[]} out={Model.NativeOutput} />

    <Call module="../../frontend/parser/native" in={$in} />

    <If on={$ctx.native.diagnostic.message == ""}>
        <Call
            module="validate"
            in={{
                source: $in,
                ...$ctx.native.pick(
                    [
                        "declarations",
                        "functions",
                        "parameters",
                        "errors"
                    ]
                )
            }}
        />

        <Return
            value={{
                ...$ctx.native,
                diagnostic: $ctx.validate
            }}
        />

        <Else>
            <Return value={$ctx.native} />
        </Else>
    </If>
</Module>
