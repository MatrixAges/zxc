<Module>
    <Type from="../../frontend/lexer/initial" as="Initial" />
    <Type from="../../frontend/parser/native/model" as="Model" />
    <Type from="./signatures/check" as="Check" />
    <Type from="../../analysis/semantic/resolving/model" as="ResolvingModel" />
    <Type from="../../analysis/semantic/constructing/delta" as="Delta" />
    <Type from="../../frontend/lexer/model" as="LexerModel" />
    <Type from="./interface/exports" as="Exports" />
    <Type from="./interface/members" as="Members" />

    <Args
        in={{
            errors: Initial.Input[],
            functions: Model.Function[],
            namespace: u8[][],
            parameters: Model.Parameter[],
            resolution: Check.Output
        }}
        out={{
            cache: ResolvingModel.Cache,
            delta: Delta.Output,
            diagnostic: LexerModel.Diagnostic,
            exports: Exports.Export[],
            members: Members.Output
        }}
    />

    <Call fn="interface/namespace" in={$in.namespace} />

    <If on={$ctx.namespace}>
        <Call fn="interface/export_index" in={$in.resolution.cache.names} />

        <Call
            fn="interface/exports"
            in={{
                source: $in.resolution.context.source,
                resolved: $in.resolution.cache,
                slots: $ctx.export_index
            }}
        />

        <If on={$ctx.exports.diagnostic.message == ""}>
            <Call
                fn="signatures/functions"
                in={{
                    resolution: $in.resolution,
                    functions: $in.functions,
                    parameters: $in.parameters
                }}
            />

            <If on={$ctx.functions.resolution.diagnostic.message == ""}>
                <Call
                    fn="interface/members"
                    in={{
                        source: $in.resolution.context.source.indexed.bytes,
                        functions: $in.functions,
                        errors: $in.errors,
                        signatures: $ctx.functions.signatures
                    }}
                />

                <Return
                    value={{
                        delta: $ctx.functions.resolution.delta,
                        cache: $ctx.functions.resolution.cache,
                        diagnostic: $ctx.functions.resolution.diagnostic,
                        exports: $ctx.exports.exports,
                        members: $ctx.members
                    }}
                />

                <Else>
                    <Return
                        value={{
                            delta: $ctx.functions.resolution.delta,
                            cache: $ctx.functions.resolution.cache,
                            diagnostic: $ctx.functions.resolution.diagnostic,
                            exports: $ctx.exports.exports,
                            members: []
                        }}
                    />
                </Else>
            </If>

            <Else>
                <Return
                    value={{
                        delta: $in.resolution.delta,
                        cache: $in.resolution.cache,
                        diagnostic: $ctx.exports.diagnostic,
                        exports: $ctx.exports.exports,
                        members: []
                    }}
                />
            </Else>
        </If>

        <Else>
            <Return
                value={{
                    delta: $in.resolution.delta,
                    cache: $in.resolution.cache,
                    diagnostic: {
                        code: "module",
                        message: "native namespaces require nonempty UTF-8 member names",
                        start: 0,
                        end: 0
                    },
                    exports: [],
                    members: []
                }}
            />
        </Else>
    </If>
</Module>
