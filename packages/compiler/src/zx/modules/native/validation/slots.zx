export type Input = u64

export type Output = string?[]

export default function (in: Input): Output {
    const slots: Output = []

    const result = loop({ slots: slots, remaining: in == 0 ? 0 : in * 2 + 1 }, {
        while: current => current.remaining != 0,
        next: current => {
            current.slots = current.slots.push(null)[0]
            current.remaining -= 1
        }
    })

    return result.slots
}
