<Module>
    <Type from="../../analysis/semantic/resolving/model" as="Model" />
    <Type from="core/type_table/nominal" as="Nominal" />
    <Type from="../../analysis/semantic/merging/origin" as="Origin" />

    <Args
        in={{
            context: Model.Context,
            origin: Nominal.Origin,
            origins: Origin.Output,
            shared: bool
        }}
        out={{
            origins: Origin.Output,
            resolution: Model.State
        }}
    />

    <Call module="declarations" in={$in.context} />

    <If on={$ctx.declarations.diagnostic.message == "" && $in.shared}>
        <Call
            module="../../analysis/semantic/normalizing/normalize"
            in={{
                base: $in.context.base,
                delta: $ctx.declarations.delta,
                cache: $ctx.declarations.cache,
                id: $ctx.declarations.result,
                origins: $in.origins,
                origin: $in.origin
            }}
        />

        <Return
            value={{
                resolution: {
                    ...$ctx.declarations,
                    delta: $ctx.normalize.delta,
                    cache: $ctx.normalize.cache,
                    result: $ctx.normalize.id,
                    diagnostic: $ctx.normalize.diagnostic
                },
                origins: $ctx.normalize.origins
            }}
        />

        <Else>
            <Return
                value={{
                    resolution: $ctx.declarations,
                    origins: {
                        ids: [],
                        kinds: [],
                        owners: [],
                        members: []
                    }
                }}
            />
        </Else>
    </If>
</Module>
