import type { Values } from "core/constant/model"
import type { Ownership } from "core/symbol_table/model"
import type { Fields } from "core/type_table/model"

export enum Status {
    Ready,
    Invalid,
    Conflict
}

export enum Kind {
    TypeOnly,
    Function,
    Enumeration
}

export type Dependency = {
    kind: Kind,
    names: string[],
    source_names: string[],
    wildcard: bool
}

export type Bindings = {
    names: string[],
    namespaces: string?[],
    ids: u32?[],
    inputs: u32?[],
    outputs: u32?[],
    intrinsics: u8?[]
}

export type Signatures = {
    files: string[],
    input_types: u32[],
    output_types: u32[],
    ownership: Ownership[]
}

export type Provider = {
    executable: bool,
    members: Bindings,
    signatures: Signatures,
    aliases: Fields,
    kinds: u8[],
    constants?: Values,
    types: u32[]
}

export type Consumer = {
    members: Bindings,
    aliases: Fields,
    constants?: Values,
    types: u32[],
    functions: u32?[]
}

export type Request = {
    dependency: Dependency,
    provider: Provider,
    consumer: Consumer,
    linked: Signatures
}

export type Item = {
    request: Request,
    local: string,
    original: string
}

export type Member = {
    request: Request,
    local: string,
    row: u64
}
