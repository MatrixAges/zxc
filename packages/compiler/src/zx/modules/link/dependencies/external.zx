export type Input = {
    intrinsic: bool,
    type_only: bool,
    specifier: string,
    intrinsic_name: string,
    native_specifiers: string[]
}

export type Output = bool

export default function (in: Input): Output {
    const specifier = in.specifier

    return match {
        in.intrinsic => !in.type_only && specifier == in.intrinsic_name,
        _ => in.native_specifiers.some(name => name == specifier)
    }
}
