import valid from "../../binding/shape"

import type { Bindings } from "./model"

export type Input = {
    bindings: Bindings,
    row: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { bindings, row } = in

    return valid({
        id: bindings.ids[row],
        input_type: bindings.inputs[row],
        output_type: bindings.outputs[row],
        intrinsic: bindings.intrinsics[row]
    })
}
