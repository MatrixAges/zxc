import integers from "std:integer"

import type { Ownership } from "core/symbol_table/model"

export type Ports = {
    input_type: u32,
    output_type: u32,
    ownership: Ownership
}

export type Input = {
    ports: Ports,
    types: u32[]
}

export type Output = Ports

export default function (in: Input): Output {
    const input_id = integers.widen(in.ports.input_type)
    const output_id = integers.widen(in.ports.output_type)

    return {
        input_type: in.types[input_id],
        output_type: in.types[output_id],
        ownership: in.ports.ownership
    }
}
