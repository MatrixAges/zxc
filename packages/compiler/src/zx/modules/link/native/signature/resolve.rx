<Module>
    <Type from="model" as="Signature" />
    <Type from="../../signature/decision" as="Link" />

    <Args in={Signature.Lookup} out={Link.Decision} />

    <Call fn="find" in={$in} />

    <If on={$ctx.find == null}>
        <Return
            value={{
                status: Link.Status.Insert,
                row: $in.signatures.files.length
            }}
        />
    </If>

    <Call
        fn="check"
        in={{
            request: $in,
            index: $ctx.find ?? 0
        }}
    />

    <Return
        value={{
            status: $ctx.check ? Link.Status.Reuse : Link.Status.Conflict,
            row: $ctx.find ?? 0
        }}
    />
</Module>
