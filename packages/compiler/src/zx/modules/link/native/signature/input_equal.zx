import type { Names } from "core/signature_table/model"

export type Input = {
    left?: Names,
    right?: Names
}

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    if (left == null || right == null) {
        return left == null && right == null
    }

    if (left.length != right.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < left.length,
        next: state => {
            state.equal = left[state.index] == right[state.index]
            state.index += 1
        },
        return: state => state.equal
    })
}
