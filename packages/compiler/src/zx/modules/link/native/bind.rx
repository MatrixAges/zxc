<Module>
    <Type from="model" as="Binding" />

    <Args in={Binding.Input} out={Binding.Output} />

    <Call
        fn="lookup"
        in={$in.pick([
            "table",
            "value",
            "mapping"
        ])}
    />

    <If on={$ctx.lookup.status != Binding.Status.Missing}>
        <Return
            value={{
                ...$ctx.lookup,
                ids: []
            }}
        />
    </If>

    <If on={$in.table.specifiers.length >= $in.maximum}>
        <Return
            value={{
                status: Binding.Status.Full,
                row: 0,
                ids: []
            }}
        />
    </If>

    <Call
        fn="../../compiled/loading/remap/ids"
        in={{
            values: $in.value.ids,
            mapping: $in.mapping
        }}
    />

    <Return
        value={{
            status: Binding.Status.Insert,
            row: $in.table.specifiers.length,
            ids: $ctx.ids
        }}
    />
</Module>
