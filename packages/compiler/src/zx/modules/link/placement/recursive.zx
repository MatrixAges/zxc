import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

export type Input = {
    kinds: ExpressionKind[],
    payloads: u32[],
    calls: u32[],
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const { kinds, payloads, calls, id } = in

    return loop({
        row: 0,
        found: false
    }, {
        while: state => !state.found && state.row < kinds.length,
        next: state => {
            if (kinds[state.row] == ExpressionKind.Call) {
                const payload = integers.widen(payloads[state.row])

                state.found = calls[payload] == id
            }

            state.row += 1
        },
        return: state => state.found
    })
}
