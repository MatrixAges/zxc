import type { Index } from "core/bytes/index/model"
import type { Bindings, Signatures } from "../dependencies/model"
import type { Ports } from "../signature/ports"

export enum Visibility {
    Found,
    Missing,
    Invalid
}

export type Edge = {
    path: string,
    default_call: bool,
    members?: Bindings,
    files: string[]
}

export type Request = {
    path: string,
    key: u8[],
    ports: Ports,
    registry: Index,
    edges: Edge[],
    functions: u32?[],
    linked: Signatures
}
