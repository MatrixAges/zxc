<Module>
    <Type from="model" as="Source" />
    <Type from="../signature/decision" as="Link" />

    <Args in={Source.Request} out={Link.Decision} />

    <Call
        fn="../graph/locate"
        in={{
            index: $in.registry,
            key: $in.key
        }}
    />

    <If on={$ctx.locate == null}>
        <Return
            value={{
                status: Link.Status.Invalid,
                row: 0
            }}
        />
    </If>

    <Call
        fn="visible"
        in={{
            edges: $in.edges,
            path: $in.path
        }}
    />

    <If on={!$ctx.visible}>
        <Return
            value={{
                status: Link.Status.Invalid,
                row: 0
            }}
        />
    </If>

    <If on={$in.functions[$ctx.locate ?? 0] == null}>
        <Return
            value={{
                status: Link.Status.Invalid,
                row: 0
            }}
        />
    </If>

    <Call
        fn="compatible"
        in={{
            ports: $in.ports,
            linked: $in.linked,
            id: $in.functions[$ctx.locate ?? 0] ?? 0
        }}
    />

    <Return
        value={{
            status: $ctx.compatible != null ? Link.Status.Reuse : Link.Status.Conflict,
            row: $ctx.compatible ?? 0
        }}
    />
</Module>
