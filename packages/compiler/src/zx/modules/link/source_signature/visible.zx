import inspect from "./edge"
import { Visibility } from "./model"

import type { Edge } from "./model"

export type Input = {
    edges: Edge[],
    path: string
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        row: 0,
        status: Visibility.Missing
    }, {
        while: state => state.status == Visibility.Missing && state.row < in.edges.length,
        next: state => {
            state.status = inspect({
                edge: in.edges[state.row],
                path: in.path
            })
            state.row += 1
        },
        return: state => state.status == Visibility.Found
    })
}
