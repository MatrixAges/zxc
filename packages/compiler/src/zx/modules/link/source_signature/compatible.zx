import integers from "std:integer"

import type { Signatures } from "../dependencies/model"
import type { Ports } from "./model"

export type Input = {
    ports: Ports,
    linked: Signatures,
    id: u32
}

export type Output = bool

export default function (in: Input): Output {
    const row = integers.widen(in.id)

    const { ports, linked } = in

    const same_input = ports.input_type == linked.input_types[row]
    const same_output = ports.output_type == linked.output_types[row]
    const same_owner = ports.ownership == linked.ownership[row]

    return same_input && same_output && same_owner
}
