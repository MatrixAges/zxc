import { type_id_void } from "core/const"
import { StoreMode } from "core/function_table/complete"
import { Ownership } from "core/symbol_table/model"

import type { Root, State } from "./model"

export type Input = Root

export type Output = State

export default function (in: Input): Output {
    const body = in.body

    if (body == null) {
        return {
            header: {
                input_type: type_id_void,
                output_type: type_id_void,
                ownership: Ownership.Borrowed,
                store_mode: StoreMode.transaction
            },
            type_only: true,
            recursive: null
        }
    }

    return {
        header: body,
        type_only: false,
        recursive: in.recursive
    }
}
