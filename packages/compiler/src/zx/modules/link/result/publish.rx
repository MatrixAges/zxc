<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Entry} out={Result.State} />

    <If on={$in.calls != null}>
        <Call fn="../placement/recursive" in={$in.calls} />

        <If on={$ctx.recursive}>
            <Call
                fn="header"
                in={{
                    body: $in.body,
                    recursive: $in.calls.id
                }}
            />

            <Return value={$ctx.header} />
        </If>
    </If>

    <Call
        fn="header"
        in={{
            body: $in.body,
            recursive: null
        }}
    />

    <Return value={$ctx.header} />
</Module>
