<Module>
    <Type from="model" as="Result" />

    <Args
        in={{
            root: Result.Root,
            ids: u32[],
            mapping: u32[]
        }}
        out={{
            state: Result.State,
            exports: u32[]
        }}
    />

    <Call fn="header" in={$in.root} />

    <Call
        fn="types"
        in={{
            ids: $in.ids,
            mapping: $in.mapping
        }}
    />

    <Return
        value={{
            state: $ctx.header,
            exports: $ctx.types
        }}
    />
</Module>
