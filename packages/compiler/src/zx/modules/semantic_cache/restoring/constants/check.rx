<Module>
    <Type from="model" as="Constants" />
    <Type from="../../../../analysis/constants/bindings/model" as="Bindings" />

    <Args in={Constants.Input} out={bool} />

    <If on={$in.unchecked != null}>
        <Call module="../../validation/constants" in={$in.unchecked} />

        <If on={!$ctx.constants}>
            <Return value={false} />
        </If>
    </If>

    <Call
        module="../../../../analysis/constants/bindings"
        in={{
            previous: $in.imports,
            current: $in.current,
            mapping: $in.mapping
        }}
    />

    <Return value={$ctx.bindings == Bindings.Comparison.Equal} />
</Module>
