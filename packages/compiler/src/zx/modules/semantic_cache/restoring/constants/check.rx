<Module>
    <Type from="model" as="Constants" />
    <Type from="../../../../analysis/constants/bindings/model" as="Bindings" />

    <Args in={Constants.Input} out={bool} />

    <Task name="exports" out={$ctx.validate}>
        <Call
            module="../../../../analysis/constants/validate"
            in={{
                types: $in.types,
                constants: $in.exports
            }}
        />
    </Task>

    <If on={!$ctx.task.exports}>
        <Return value={false} />
    </If>

    <Call
        module="../../../../analysis/constants/validate"
        in={{
            types: $in.types,
            constants: $in.imports
        }}
    />

    <If on={!$ctx.validate}>
        <Return value={false} />
    </If>

    <Call
        module="../../../../analysis/constants/bindings"
        in={{
            previous: $in.imports,
            current: $in.current,
            mapping: $in.mapping
        }}
    />

    <Return value={$ctx.bindings == Bindings.Comparison.Equal} />
</Module>
