import type { Modules } from "core/native_module_table/model"
import type { Declaration } from "./model"

export type Input = {
    path: string,
    modules: Modules,
    export_names: string[],
    export_types: u32[],
    declaration: Declaration
}

export type Output = bool

export default function (in: Input): Output {
    const modules = in.modules

    const different_import_names = modules.import_names.length != 1
    const different_type_namespaces = modules.type_namespaces.length != 1

    const condition = (
        - modules.identities.length != 1
        - or different_import_names
        - or modules.specifiers.length != 1
        - or modules.type_ids.length != 1
        - or modules.type_names.length != 1
        - or different_type_namespaces
    )

    if (condition) {
        return false
    }

    const key = modules.identities[0] ?? modules.specifiers[0]
    const declared_key = in.declaration.identity ?? in.declaration.specifier

    const condition_2 = match {
        in.path != declared_key => true,
        key != declared_key => true,
        modules.specifiers[0] != in.declaration.specifier => true,
        _ => modules.import_names[0] != in.declaration.import_name
    }

    if (condition_2) {
        return false
    }

    const names = modules.type_names[0]
    const types = modules.type_ids[0]
    const namespace = modules.type_namespaces[0]

    const not_length = names.length != in.export_names.length
    const not_length_2 = types.length != in.export_types.length

    const not_length_3 = namespace.length != in.declaration.namespace.length

    const condition_3 = (
        - names.length != types.length
        - or not_length
        - or not_length_2
        - or not_length_3
    )

    if (condition_3) {
        return false
    }

    const same_namespace = loop({
        previous: namespace,
        current: in.declaration.namespace,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.previous.length,
        next: current => {
            current.valid =
                current.previous[current.index] == current.current[current.index]
            current.index += 1
        },
        return: state => state.valid
    })

    return loop({
        names,
        types,
        export_names: in.export_names,
        export_types: in.export_types,
        index: 0,
        valid: same_namespace
    }, {
        while: current => current.valid && current.index < current.names.length,
        next: current => {
            current.valid =
                current.names[current.index] ==
                current.export_names[current.index] &&
                current.types[current.index] == current.export_types[current.index]
            current.index += 1
        },
        return: state => state.valid
    })
}
