import integers from "std:integer"

import type { Ports } from "./result"

export type Input = {
    source: Ports,
    mapping: u32[]
}

export type Output = Ports

export default function (in: Input): Output {
    return {
        input_types: in.source.input_types.map(
            id => in.mapping[integers.widen(
                id
            )]
        )[0],
        output_types:
            in.source.output_types.map(id => in.mapping[integers.widen(
                id
            )])[0]
    }
}
