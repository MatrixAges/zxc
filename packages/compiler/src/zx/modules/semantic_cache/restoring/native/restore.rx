<Module>
    <Type from="restore_input" as="Restore" />
    <Type from="failed" as="Failed" />
    <Type from="result" as="Result" />

    <Args in={Restore.Input} out={Failed.Output} />

    <Call module="eligible" in={$in.validation.request} />

    <If on={$ctx.eligible}>
        <Call module="validate" in={$in.validation} />

        <If on={$ctx.validate}>
            <Call module="merge" in={$in} />

            <Return value={$ctx.merge} />

            <Else>
                <Call fn="failed" in={Result.Status.InvalidIr} />

                <Return value={$ctx.failed} />
            </Else>
        </If>

        <Else>
            <Call fn="failed" in={Result.Status.InvalidModule} />

            <Return value={$ctx.failed} />
        </Else>
    </If>
</Module>
