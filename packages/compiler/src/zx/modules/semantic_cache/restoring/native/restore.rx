<Module>
    <Type from="restore_input" as="Restore" />
    <Type from="failed" as="Failed" />

    <Args in={Restore.Input} out={Failed.Output} />

    <Call module="eligible" in={$in.validation.request} />

    <If on={$ctx.eligible}>
        <Call fn="program" in={$in.validation} />

        <Call
            module="../../../../ir/canonical/validation/validate"
            in={$ctx.program}
        />

        <If on={$ctx.validate}>
            <Call
                module="merge"
                in={{
                    input: $in,
                    program: $ctx.program
                }}
            />

            <Return value={$ctx.merge} />

            <Else>
                <Call fn="failed" in={2} />

                <Return value={$ctx.failed} />
            </Else>
        </If>

        <Else>
            <Call fn="failed" in={1} />

            <Return value={$ctx.failed} />
        </Else>
    </If>
</Module>
