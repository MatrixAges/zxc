import integers from "std:integer"

import shape from "../../../binding/shape"
import { local_module } from "../../native_artifact/const"

import type { Table } from "core/signature_table/model"
import type { FunctionBinding } from "../../../binding/model"
import type { Declaration } from "./model"

export type Input = {
    signatures: Table,
    imports: FunctionBinding[],
    declaration: Declaration,
    first: u64
}

export type Output = bool

export default function (in: Input): Output {
    const count = in.signatures.files.length

    if (in.first > count || in.imports.length > count - in.first) {
        return false
    }

    const { signatures, imports, declaration, first } = in

    return loop({
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < imports.length,
        next: current => {
            const index = first + current.index
            const binding = imports[current.index]
            const member = signatures.native_members[index]
            const module_id = signatures.native_modules[index]
            const namespace = declaration.namespace
            const input_type = binding.input_type ?? 0
            const output_type = binding.output_type ?? 0

            const valid = shape(binding.omit([
                "namespace",
                "name"
            ]))

            const condition = match {
                !valid => true,
                binding.intrinsic != null => true,
                signatures.files[index] != declaration.path => true,
                integers.widen(binding.id ?? 0) != index => true,
                binding.namespace != null => true,
                input_type != signatures.input_types[index] => true,
                _ => output_type != signatures.output_types[index]
            }

            const wrong_length = member.length != namespace.length + 1
            const wrong_member = (
                - module_id == null
                - or module_id != local_module
                - or wrong_length
            )

            if (condition || wrong_member) {
                current.valid = false
            } else {
                const name =
                    signatures.native_exports[index] ?? member[namespace.length]
                const same_namespace = loop({
                    member,
                    namespace,
                    index: 0,
                    valid: true
                }, {
                    while: position =>
                        position.valid &&
                        position.index < position.namespace.length,
                    next: position => {
                        position.valid =
                            position.member[position.index] ==
                            position.namespace[position.index]
                        position.index += 1
                    },
                    return: state => state.valid
                })

                current.valid =
                    same_namespace && member[namespace.length] == name &&
                    binding.name == name
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
