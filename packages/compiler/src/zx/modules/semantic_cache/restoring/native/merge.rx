<Module>
    <Type from="../../../../analysis/semantic/merging/model" as="Merge" />
    <Type from="restore_input" as="Restore" />
    <Type from="failed" as="Failed" />
    <Type from="result" as="Result" />

    <Args in={Restore.Input} out={Failed.Output} />

    <Call
        fn="../../../compiled/loading/type_base"
        in={{
            table: $in.base,
            scalar_count: $in.validation.scalar_count
        }}
    />

    <Call
        module="../../../compiled/loading/types"
        in={{
            source: $in.validation.types,
            origins: $in.validation.request.origins,
            names: $in.origin_names,
            base: $ctx.type_base,
            base_origins: $in.base_origins,
            mapping: $in.type_mapping
        }}
    />

    <If on={$ctx.types.status == Merge.Status.Ready}>
        <Call
            fn="ports"
            in={{
                ...$in.validation.request.signatures.pick([
                    "input_types",
                    "output_types"
                ]),
                mapping: $in.type_ids,
                inputs: $in.published.inputs,
                outputs: $in.published.outputs
            }}
        />

        <Call
            fn="../../../compiled/loading/type_delta"
            in={{
                base: $ctx.type_base,
                delta: $ctx.types.delta,
                existing_count: $in.base.kinds.length
            }}
        />

        <Call
            fn="exports"
            in={{
                source: $in.validation.request.export_types,
                target: $in.published.exports,
                mapping: $in.type_ids
            }}
        />

        <Return
            value={{
                status: Result.Status.Ready,
                value: {
                    types: $ctx.type_delta,
                    origins: $ctx.types.origins
                }
            }}
        />

        <Else>
            <Call fn="merge_status" in={$ctx.types.status} />
            <Call fn="failed" in={$ctx.merge_status} />

            <Return value={$ctx.failed} />
        </Else>
    </If>
</Module>
