import { Status as Merge } from "../../../../analysis/semantic/merging/model"
import { Status } from "./result"

export type Input = Merge

export type Output = Status

export default function (in: Input): Output {
    return match in {
        Merge.MissingOrigin => Status.MissingNominalOrigin,
        Merge.Conflict => Status.ConflictingNominalType,
        _ => Status.InvalidModule
    }
}
