import integers from "std:integer"
import memory from "std:memory"

import type { U32Buffer } from "std:memory"

export type Input = {
    source: u32[],
    target: U32Buffer,
    mapping: u32[]
}

export type Output = void

export default function (in: Input): Output {
    const { source, target, mapping } = in

    const written = loop({
        index: 0
    }, {
        while: state => state.index < source.length,
        next: state => {
            const id = source[state.index]

            memory.writeU32(target, state.index, mapping[integers.widen(id)])

            state.index += 1
        }
    })
}
