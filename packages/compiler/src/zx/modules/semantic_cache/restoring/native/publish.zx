import integers from "std:integer"

import { Status } from "./result"

import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Ports, Result } from "./result"

export type Input = {
    export_types: u32[],
    types: Table,
    origins: Bindings,
    ports: Ports,
    mapping: u32[]
}

export type Output = Result

export default function (in: Input): Output {
    return {
        status: Status.Ready,
        value: {
            types: in.types,
            origins: in.origins,
            ports: in.ports,
            export_types:
                in.export_types.map(id => in.mapping[integers.widen(
                    id
                )])[0]
        }
    }
}
