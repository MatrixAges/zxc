import type { Table as Signatures } from "core/signature_table/model"
import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export enum Status {
    Ready,
    InvalidModule,
    InvalidIr,
    MissingNominalOrigin,
    ConflictingNominalType
}

export type Ports = {
    input_types: u32[],
    output_types: u32[]
}

export type Value = {
    types: Table,
    origins: Bindings,
    signatures: Signatures
}

export type Result = {
    status: Status,
    value?: Value
}
