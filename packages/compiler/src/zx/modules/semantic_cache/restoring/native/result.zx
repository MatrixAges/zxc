import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export enum Status {
    Ready,
    InvalidModule,
    InvalidIr,
    MissingNominalOrigin,
    ConflictingNominalType
}

export type Value = {
    types: Table,
    origins: Bindings
}

export type Result = {
    status: Status,
    value?: Value
}
