import { nominal_kind_native } from "core/type_table/const"

import type { Bindings } from "core/type_table/nominal"
import type { Declaration } from "./model"

export type Input = {
    origins: Bindings,
    declaration: Declaration
}

export type Output = bool

export default function (in: Input): Output {
    const origins = in.origins

    const not_length = origins.ids.length != origins.kinds.length
    const not_length_2 = origins.ids.length != origins.owners.length
    const not_length_3 = origins.ids.length != origins.members.length

    const condition = (
        - not_length
        - or not_length_2
        - or not_length_3
    )

    if (condition) {
        return false
    }

    const key = in.declaration.identity ?? in.declaration.specifier

    return loop({
        origins,
        key,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.origins.ids.length,
        next: current => {
            const index = current.index

            current.valid =
                current.origins.kinds[index] == nominal_kind_native &&
                current.origins.members[index] == "" &&
                current.origins.owners[index] == current.key
            current.index += 1
        },
        return: state => state.valid
    })
}
