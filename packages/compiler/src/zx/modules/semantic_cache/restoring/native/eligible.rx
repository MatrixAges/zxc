<Module>
    <Type from="./header" as="Header" />

    <Args in={Header.Input} out={bool} />

    <Call fn="header" in={$in} />

    <If on={$ctx.header}>
        <Call
            fn="descriptor"
            in={{
                path: $in.path,
                modules: $in.modules,
                export_names: $in.export_names,
                export_types: $in.export_types,
                declaration: $in.declaration
            }}
        />

        <Call
            fn="origins"
            in={{
                origins: $in.origins,
                declaration: $in.declaration
            }}
        />

        <Call
            fn="bindings"
            in={{
                signatures: $in.signatures,
                imports: $in.imports,
                declaration: $in.declaration
            }}
        />

        <Return value={$ctx.descriptor && $ctx.origins && $ctx.bindings} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
