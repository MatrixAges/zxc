<Module>
    <Type from="header" as="Header" />

    <Args in={Header.Input} out={bool} />

    <Call fn="header" in={$in} />

    <If on={$ctx.header}>
        <Call
            fn="descriptor"
            in={$in.pick(
                [
                    "path",
                    "modules",
                    "export_names",
                    "export_types",
                    "declaration"
                ]
            )}
        />

        <Call
            fn="origins"
            in={{
                origins: $in.origins,
                declaration: $in.declaration
            }}
        />

        <Call
            fn="bindings"
            in={$in.pick([
                "signatures",
                "imports",
                "declaration"
            ])}
        />

        <Return value={$ctx.descriptor && $ctx.origins && $ctx.bindings} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
