import integers from "std:integer"
import { map } from "std:utils"

import type { Complete } from "core/function_table/complete"

export type Input = {
    source: Complete,
    mapping: u32[],
    module_id: u32
}

export type Output = Complete

export default function (in: Input): Output {
    const module_id: u32? = in.module_id

    return {
        ...in.source,
        input_types: map(
            in.source.input_types,
            id => in.mapping[integers.widen(
                id
            )]
        ),
        output_types:
            map(in.source.output_types,
                id => in.mapping[integers.widen(
                    id
                )]
            ),
        native_modules: map(in.source.native_modules, id => module_id)
    }
}
