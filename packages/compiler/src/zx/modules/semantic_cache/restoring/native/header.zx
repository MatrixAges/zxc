import shape from "core/signature_table/shape"

import type { Request } from "./request"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    return (
        - shape(in.signatures)
        - and !in.has_function
        - and in.dependency_count == 0
        - and in.type_import_count == 0
        - and in.store_count == 0
    )
}
