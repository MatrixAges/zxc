import shape from "core/signature_table/shape"

import type { Request } from "./request"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const no_constant_exports = in.constant_export_count == 0
    const no_constant_imports = in.constant_import_count == 0

    return (
        - no_constant_exports
        - and no_constant_imports
        - and !in.has_function
        - and in.dependency_count == 0
        - and in.type_import_count == 0
        - and in.store_count == 0
        - and shape(in.signatures)
    )
}
