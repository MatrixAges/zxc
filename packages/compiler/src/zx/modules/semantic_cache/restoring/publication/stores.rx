<Module>
    <Type from="core/store_table/model" as="Store" />
    <Type from="../../../artifact/remapping/model" as="Remap" />

    <Args
        in={{
            source: Store.Stores,
            mapping: Remap.Mapping,
            body?: Remap.FunctionOutput,
            reuse: bool
        }}
        out={Store.Stores}
    />

    <If on={$in.reuse}>
        <If on={$in.body != null}>
            <Call
                fn="../../../artifact/materializing/stores/own"
                in={{
                    source: $in.source,
                    types: $in.body.stores
                }}
            />

            <Return value={$ctx.own} />
        </If>
    </If>

    <Call
        fn="../../../artifact/remapping/ids"
        in={{
            values: $in.source.types,
            mapping: $in.mapping
        }}
    />

    <Call
        fn="../../../artifact/materializing/stores/own"
        in={{
            source: $in.source,
            types: $ctx.ids
        }}
    />

    <Return value={$ctx.own} />
</Module>
