import memory from "std:memory"

import id from "../../../artifact/remapping/id"

import type { Exports } from "./model"

export type Input = Exports

export type Output = void

export default function (in: Input): Output {
    const { mapping, count, ids } = in

    const walked = loop({
        row: 0
    }, {
        while: state => state.row < count,
        next: state => {
            const previous = memory.readU32(ids, state.row)
            const current = id({
                id: previous,
                mapping
            })

            memory.writeU32(ids, state.row, current)

            state.row += 1
        }
    })
}
