import type { U32Buffer } from "std:memory"
import type { Stores } from "core/store_table/model"
import type {
    FunctionInput,
    FunctionOutput,
    Mapping
} from "../../../artifact/remapping/model"

export type Exports = {
    mapping: Mapping,
    count: u64,
    ids: U32Buffer
}

export type Input = {
    body?: FunctionInput,
    stores: Stores,
    reuse_store_types: bool,
    exports: Exports
}

export type Plan = {
    body?: FunctionOutput,
    store_types: u32[]
}
