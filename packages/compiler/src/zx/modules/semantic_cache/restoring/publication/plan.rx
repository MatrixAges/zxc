<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Plan?} />

    <Call
        module="../../../artifact/remapping/optional_body"
        in={{
            source: $in.body
        }}
    />

    <Call
        module="stores"
        in={{
            source: $in.stores,
            mapping: $in.types,
            body: $ctx.optional_body,
            reuse: $in.reuse_store_types
        }}
    />

    <If on={$ctx.stores != null}>
        <Call module="../../../artifact/materializing/optional_control" in={$in.control} />

        <Return
            value={{
                body: $ctx.optional_body,
                stores: $ctx.stores,
                control: $ctx.optional_control
            }}
        />
    </If>

    <Return value={null} />
</Module>
