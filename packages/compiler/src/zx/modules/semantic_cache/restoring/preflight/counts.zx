import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const types = in.types == in.current_types
    const functions = in.functions == in.current_functions
    const constants = in.constants == in.current_constants
    const members = in.members == in.current_members
    const dependencies = in.dependency_count == in.current_dependency_count

    return (
        - types
        - and functions
        - and constants
        - and members
        - and dependencies
    )
}
