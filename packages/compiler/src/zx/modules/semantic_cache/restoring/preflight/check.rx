<Module>
    <Type from="model" as="Preflight" />

    <Args in={Preflight.Input} out={bool} />

    <Call fn="counts" in={$in} />

    <If on={!$ctx.counts}>
        <Return value={false} />
    </If>

    <Task name="cached" out={$ctx.structure}>
        <Call fn="../../../../ir/canonical/native/structure" in={$in.cached_modules} />
    </Task>

    <If on={!$ctx.task.cached}>
        <Return value={false} />
    </If>

    <Call fn="signatures" in={$in.signatures} />

    <If on={!$ctx.signatures}>
        <Return value={false} />
    </If>

    <Call fn="../../../../ir/canonical/native/structure" in={$in.current_modules} />

    <Return value={$ctx.structure} />
</Module>
