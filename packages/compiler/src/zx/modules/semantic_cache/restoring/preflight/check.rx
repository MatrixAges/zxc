<Module>
    <Type from="model" as="Preflight" />

    <Args in={Preflight.Input} out={bool} />

    <If on={$in.first}>
        <Call fn="counts" in={$in} />

        <If on={!$ctx.counts}>
            <Return value={false} />
        </If>

        <If on={!$in.decoded}>
            <Task name="cached" out={$ctx.structure}>
                <Call
                    fn="../../../../ir/canonical/native/structure"
                    in={$in.cached_modules}
                />
            </Task>

            <If on={!$ctx.task.cached}>
                <Return value={false} />
            </If>

            <Call fn="signatures" in={$in.signatures} />

            <If on={!$ctx.signatures}>
                <Return value={false} />
            </If>
        </If>

        <If on={!$in.verified_native}>
            <Call
                fn="../../../../ir/canonical/native/structure"
                in={$in.current_modules}
            />

            <If on={!$ctx.structure}>
                <Return value={false} />
            </If>
        </If>
    </If>

    <Call fn="../dependencies/check" in={$in.dependencies} />

    <If on={!$ctx.check}>
        <Return value={false} />
    </If>

    <If on={$in.finish}>
        <If on={$in.control != null}>
            <Call module="../../../../ir/canonical/control/structure" in={$in.control} />

            <Return value={$ctx.structure} />
        </If>
    </If>

    <Return value={true} />
</Module>
