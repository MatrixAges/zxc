import equal from "compiler/artifact_dependency_equal"

import type { Batch } from "./model"

export type Input = Batch

export type Output = bool

export default function (in: Input): Output {
    const { previous, current } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < previous.length,
        next: state => {
            state.valid = equal({
                previous: previous[state.row],
                current: current[state.row]
            })
            state.row += 1
        },
        return: state => state.valid
    })
}
