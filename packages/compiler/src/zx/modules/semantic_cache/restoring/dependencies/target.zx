import type { Pair } from "./model"

export type Input = Pair

export type Output = bool

export default function (in: Input): Output {
    const { previous, current } = in

    const kind = previous.target == current.target
    const path = previous.path == current.path
    const instance = previous.instance == current.instance
    const member = previous.member == current.member

    const equal = (
        - kind
        - and path
        - and instance
        - and member
    )

    return equal
}
