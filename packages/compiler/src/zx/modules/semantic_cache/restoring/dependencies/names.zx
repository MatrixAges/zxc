import type { Names } from "./model"

export type Input = Names

export type Output = bool

export default function (in: Input): Output {
    const { previous, current } = in

    if (previous.length != current.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < previous.length,
        next: state => {
            state.equal = previous[state.index] == current[state.index]
            state.index += 1
        },
        return: state => state.equal
    })
}
