import type { OptionalU32Buffer } from "std:memory"
import type { Table } from "core/signature_table/model"

export type Import = {
    namespace?: string,
    name: string,
    id?: u32,
    input_type?: u32,
    output_type?: u32,
    intrinsic?: u8
}

export type Binding = {
    previous: Import,
    current: Import,
    mapping: u32?[],
    target: OptionalU32Buffer,
    types: u32[],
    current_count: u64
}

export type Alias = {
    name: string,
    type_id: u32
}

export type Aliases = {
    previous: Alias[],
    current: Alias[],
    types: u32[]
}

export type Bindings = {
    previous: Import[],
    current: Import[],
    mapping: u32?[],
    target: OptionalU32Buffer,
    types: u32[],
    current_count: u64
}

export type Signatures = {
    previous: Table,
    current: Table,
    types: u32[],
    functions: u32?[],
    modules: u32?[]
}

export type Row = {
    signatures: Signatures,
    previous: u64,
    current: u64
}
