import integers from "std:integer"

import type { Aliases } from "./model"

export type Input = Aliases

export type Output = bool

export default function (in: Input): Output {
    const { previous, current, types } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < previous.length,
        next: state => {
            const left = previous[state.row]
            const right = current[state.row]
            const index = integers.widen(left.type_id)
            const matches = (
                - index < types.length
                - and left.name == right.name
                - and types[index] == right.type_id
            )

            state.valid = matches
            state.row += 1
        },
        return: state => state.valid
    })
}
