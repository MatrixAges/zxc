import integers from "std:integer"
import memory from "std:memory"

import type { OptionalU32Buffer } from "std:memory"

export type Input = {
    has_body: bool,
    local_count: u64,
    linked_count: u64,
    target: OptionalU32Buffer
}

export type Output = u32?

export default function (in: Input): Output {
    if (!in.has_body) {
        return null
    }

    const id = integers.narrow(in.linked_count)

    memory.writeOptionalU32(in.target, in.local_count, id)

    return id
}
