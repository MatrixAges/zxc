import valid from "../../../binding/shape"

import type { Binding } from "./model"

export type Input = Binding

export type Output = bool

export default function (in: Input): Output {
    const { previous, current } = in

    if (!valid(previous.omit([
        "namespace",
        "name"
    ]))) {
        return false
    }

    if (!valid(current.omit([
        "namespace",
        "name"
    ]))) {
        return false
    }

    const name = previous.name == current.name
    const namespace = previous.namespace == current.namespace
    const intrinsic = previous.intrinsic == current.intrinsic

    return name && namespace && intrinsic
}
