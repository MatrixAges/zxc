import integers from "std:integer"

import equal from "./signature_row"

import type { Signatures } from "./model"

export type Input = Signatures

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.functions.length,
        next: state => {
            const index = state.index
            const linked = in.functions[index]

            if (linked == null) {
                state.valid = false
            } else {
                state.valid = equal({
                    signatures: in,
                    previous: index,
                    current: integers.widen(linked)
                })
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
