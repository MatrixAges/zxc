import integers from "std:integer"

import type { Comparison } from "./model"

export type Input = Comparison

export type Output = bool

export default function (in: Input): Output {
    const { previous, current, types } = in

    if (previous.file != current.file || previous.ownership != current.ownership) {
        return false
    }

    const input = integers.widen(previous.input_type)
    const output = integers.widen(previous.output_type)

    if (input >= types.length || output >= types.length) {
        return false
    }

    const input_matches = types[input] == current.input_type
    const output_matches = types[output] == current.output_type

    return input_matches && output_matches
}
