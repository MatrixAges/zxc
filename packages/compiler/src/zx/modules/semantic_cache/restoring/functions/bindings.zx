import bind from "compiler/artifact_binding_restore"

import type { Bindings } from "./model"

export type Input = Bindings

export type Output = bool

export default function (in: Input): Output {
    const { previous, current, mapping, target, types, current_count } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < previous.length,
        next: state => {
            state.valid = bind({
                previous: previous[state.row],
                current: current[state.row],
                mapping,
                target,
                types,
                current_count
            })
            state.row += 1
        },
        return: state => state.valid
    })
}
