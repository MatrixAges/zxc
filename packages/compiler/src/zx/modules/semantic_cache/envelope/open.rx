<Module>
    <Type from="model" as="Envelope" />

    <Args in={Envelope.Open} out={Envelope.Payload?} />

    <Call fn="layout" in={$in.compiler.length} />

    <Call
        fn="inspect"
        in={{
            ...$in,
            layout: $ctx.layout
        }}
    />

    <If on={!$ctx.inspect}>
        <Return value={null} />
    </If>

    <Call
        fn="../../../artifact_codec/content"
        in={{
            source: $in.source,
            start: $ctx.layout.payload_start,
            digest_start: $ctx.layout.digest_start
        }}
    />

    <If on={!$ctx.content}>
        <Return value={null} />
    </If>

    <Call fn="payload" in={$ctx.layout} />

    <Return value={$ctx.payload} />
</Module>
