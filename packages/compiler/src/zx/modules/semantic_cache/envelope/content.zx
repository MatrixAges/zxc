import bytes from "std:bytes"

import digest from "./digest"

import type { Content as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const expected = digest({
        source: in.source,
        start: in.layout.payload_start
    })

    return bytes.startsWithText(
        bytes.fromText(in.source),
        in.layout.digest_start,
        expected
    )
}
