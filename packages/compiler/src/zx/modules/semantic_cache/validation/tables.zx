import signatures from "core/signature_table/shape"

import nativeModules from "../../../ir/canonical/native/structure"
import stores from "../../../ir/canonical/stores/validate"

import type { Tables as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return signatures(in.signatures) && nativeModules(in.modules) && stores(in.stores)
}
