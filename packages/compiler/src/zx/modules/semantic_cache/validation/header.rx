<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Header} out={bool} />

    <Call fn="tables" in={$in.tables} />

    <If on={!$ctx.tables}>
        <Return value={false} />
    </If>

    <Call
        module="../../../analysis/semantic/validate_types"
        in={{
            table: $in.types,
            scalar_count: $in.scalar_count,
            maximum_count: $in.maximum_count,
            trusted: false
        }}
    />

    <If on={!$ctx.validate_types}>
        <Return value={false} />
    </If>

    <If on={$in.constants != null}>
        <Call module="../../../analysis/constants/validate_pair" in={$in.constants} />

        <Return value={$ctx.validate_pair} />
    </If>

    <Return value={true} />
</Module>
