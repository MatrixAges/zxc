import matches from "./binding_ports"

import type { Bindings } from "./model"

export type Input = Bindings

export type Output = bool

export default function (in: Input): Output {
    const { bindings, input_types, output_types } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < bindings.length,
        next: state => {
            state.valid = matches({
                binding: bindings[state.row],
                input_types,
                output_types
            })
            state.row += 1
        },
        return: state => state.valid
    })
}
