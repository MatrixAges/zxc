import integers from "std:integer"

import type { Binding as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { intrinsic, id, input_type, output_type } = in

    if (intrinsic) {
        return id == null && input_type == null && output_type == null
    }

    if (id == null) {
        return false
    }

    if (input_type == null || output_type == null) {
        return false
    }

    const index = integers.widen(id)

    return index < in.input_types.length &&
        in.input_types[index] == input_type &&
        in.output_types[index] == output_type
}
