import bytes from "std:bytes"

import writeValue from "./optional_text"

import type { Writer } from "std:bytes"

export type Input = {
    out: Writer,
    value: string?[]
}

export type Output = void

export default function (in: Input): Output {
    const { out, value: values } = in

    bytes.writeU64Le(out, values.length)

    const result = loop({
        index: 0
    }, {
        while: state => state.index < values.length,
        next: state => {
            writeValue({
                out,
                value: values[state.index]
            })
            state.index += 1
        }
    })
}
