import bytes from "std:bytes"

import optionalText from "../columns/optional_text"
import text from "../columns/text"

import type { Writer } from "std:bytes"
import type { Store } from "./model"

export type Input = {
    writer: Writer,
    binding: Store
}

export type Output = void

export default function (in: Input): Output {
    const { writer, binding } = in
    const { type_id } = binding

    text({
        out: writer,
        value: binding.handle
    })

    text({
        out: writer,
        value: binding.path
    })

    optionalText({
        out: writer,
        value: binding.type_name
    })

    bytes.writeByte(writer, type_id == null ? 0 : 1)

    if (type_id != null) {
        bytes.writeU32Le(writer, type_id)
    }

    bytes.writeByte(writer, binding.readable ? 1 : 0)
    bytes.writeByte(writer, binding.writable ? 1 : 0)
}
