export type Input = {
    specifiers: string[],
    name: string,
    offset: u64,
    first?: u64,
    check_duplicates: bool
}

export type Output = {
    first?: u64,
    duplicate: bool
}

export default function (in: Input): Output {
    const { specifiers, name, offset } = in

    return loop({
        row: 0,
        first: in.first,
        duplicate: false
    }, {
        while: state => {
            const rows_left = state.row < specifiers.length
            const search = in.check_duplicates || state.first == null

            return !state.duplicate && rows_left && search
        },
        next: state => {
            if (specifiers[state.row] == name) {
                if (state.first == null) {
                    state.first = offset + state.row
                } else {
                    state.duplicate = true
                }
            }

            state.row += 1
        },
        return: state => ({
            first: state.first,
            duplicate: state.duplicate
        })
    })
}
