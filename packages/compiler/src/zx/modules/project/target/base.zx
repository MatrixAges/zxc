import bytes from "std:bytes"

import {
    current_directory,
    parent_directory,
    parent_prefix,
    relative_prefix,
    root_prefix
} from "../../path/const"
import { PathBase } from "./model"

import type { Base, Path } from "./model"

export type Input = Path

export type Output = Base

export default function (in: Input): Output {
    if (!in.directory && in.extension) {
        return {
            kind: PathBase.Extension,
            prefix: 0
        }
    }

    const path = bytes.fromText(in.path)

    if (bytes.startsWithText(path, 0, root_prefix)) {
        return {
            kind: PathBase.Root,
            prefix: root_prefix.length
        }
    }

    if (in.path == current_directory || in.path == parent_directory) {
        return {
            kind: PathBase.Relative,
            prefix: 0
        }
    }

    const relative = bytes.startsWithText(path, 0, relative_prefix) ||
        bytes.startsWithText(path, 0, parent_prefix)

    return {
        kind: relative ? PathBase.Relative : PathBase.Invalid,
        prefix: 0
    }
}
