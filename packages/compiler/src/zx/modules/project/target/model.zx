export enum Route {
    File,
    Package,
    Intrinsic,
    Interface,
    Invalid
}

export enum PathBase {
    Relative,
    Root,
    Extension,
    Invalid
}

export type Path = {
    path: string,
    extension: bool,
    directory: bool
}

export type Base = {
    kind: PathBase,
    prefix: u64
}

export type File = {
    path: string,
    basename: string,
    extension: bool,
    allow_rx: bool
}

export type FileTarget = {
    kind: PathBase,
    prefix: u64,
    path: string,
    suffix: string,
    directory: bool,
    rx: bool
}

export enum PackageShape {
    Source,
    Compiled,
    InvalidSource,
    InvalidCompiled
}

export type Package = {
    entry: string,
    compiled: bool,
    instance: bool,
    artifact: bool,
    name: bool
}
