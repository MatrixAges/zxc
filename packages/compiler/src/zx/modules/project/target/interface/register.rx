<Module>
    <Type from="registered" as="Registry" />
    <Type from="registry_slot" as="Slot" />

    <Args
        in={Registry.Input}
        out={Slot.Output}
    />

    <Call fn="../../../../ir/canonical/native/text" in={$in.name} />

    <If on={!$ctx.text}>
        <Return
            value={{
                valid: false,
                existing: false,
                id: null
            }}
        />
    </If>

    <Call fn="registered" in={$in} />

    <Call
        fn="registry_slot"
        in={{
            index: $ctx.registered,
            count: $in.modules.specifiers.length
        }}
    />

    <Return value={$ctx.registry_slot} />
</Module>
