<Module>
    <Type from="model" as="State" />

    <Args in={State.Body} out={State.Publication} />

    <If on={$in.type_only}>
        <Return value={State.Publication.Types} />
    </If>

    <If on={$in.entry}>
        <If on={$in.recursive}>
            <Return value={State.Publication.RecursiveEntry} />
        </If>

        <Return value={State.Publication.Entry} />
    </If>

    <If on={$in.recursive}>
        <Return value={State.Publication.RecursiveDependency} />
    </If>

    <Return value={State.Publication.Dependency} />
</Module>
