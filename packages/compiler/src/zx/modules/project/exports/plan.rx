<Module>
    <Type from="model" as="Exports" />

    <Args in={Exports.Input} out={Exports.Output} />

    <Call
        fn="names"
        in={{
            names: $in.names,
            first_function: $in.first_function,
            roots: $in.roots
        }}
    />

    <If on={$ctx.names.invalid_name != null || $ctx.names.default_member == null}>
        <Return
            value={{
                names: $ctx.names,
                action: Exports.Action.None
            }}
        />
    </If>

    <If on={$in.signature != null}>
        <Call fn="signature" in={$in.signature} />

        <Return
            value={{
                names: $ctx.names,
                action: $ctx.signature
            }}
        />
    </If>

    <Return
        value={{
            names: $ctx.names,
            action: Exports.Action.None
        }}
    />
</Module>
