import claim from "core/bytes/index/fixed"

import type { Input, Names as Output } from "./model"

export default function (in: Input): Output {
    const invalid_name: u64? = null
    const default_member: u64? = null

    const { keys, first_function, roots, buckets, capacity } = in

    return loop({
        invalid_name,
        default_member,
        cursor: 0
    }, {
        while: state => state.invalid_name == null && state.cursor < keys.length,
        next: state => {
            const row = state.cursor
            const key = keys[row]

            if (roots && key.length == 0) {
                state.invalid_name = row
            } else {
                const entered = claim({
                    keys,
                    buckets,
                    capacity,
                    key,
                    insert: row
                })

                if (entered != null) {
                    state.invalid_name = row
                } else if (row >= first_function && key.length == 0) {
                    state.default_member = row - first_function
                }
            }

            state.cursor += 1
        },
        return: state => {
            return {
                invalid_name: state.invalid_name,
                default_member: state.default_member
            }
        }
    })
}
