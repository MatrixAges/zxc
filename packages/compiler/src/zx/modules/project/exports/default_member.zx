import type { Input } from "./model"

export type Output = u64?

export default function (in: Input): Output {
    const selected: u64? = null

    return loop({
        selected,
        index: in.first_function
    }, {
        while: state => state.selected == null && state.index < in.names.length,
        next: state => {
            if (in.names[state.index] == "") {
                state.selected = state.index - in.first_function
            }

            state.index += 1
        },
        return: state => state.selected
    })
}
