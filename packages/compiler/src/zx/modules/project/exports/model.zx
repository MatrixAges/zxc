import type { U64Buffer } from "std:memory"

export type Input = {
    keys: u8[][],
    buckets: U64Buffer,
    capacity: u64,
    first_function: u64,
    roots: bool,
    has_function: bool,
    signature?: Signature
}

export type Names = {
    invalid_name?: u64,
    default_member?: u64
}

export type Signature = {
    callable: bool,
    deferred: bool,
    intrinsic: bool
}

export enum Action {
    None,
    Forward,
    Callable,
    Deferred,
    Intrinsic,
    Invalid
}

export type Output = {
    names: Names,
    action: Action
}
