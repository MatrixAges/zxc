import bytes from "std:bytes"
import claim from "core/bytes/index/claim"

import type { Index } from "core/bytes/index/model"

export type Input = string[]

export type Output = u64?

export default function (in: Input): Output {
    const seen: Index = {
        keys: [],
        values: [],
        buckets: []
    }

    const duplicate: u64? = null

    return loop({
        seen,
        duplicate,
        index: 0
    }, {
        while: state => state.duplicate == null && state.index < in.length,
        next: state => {
            const entered = claim({
                index: state.seen,
                key: bytes.fromText(in[state.index]),
                value: 0
            })

            state.seen = entered.index

            if (entered.previous != null) {
                state.duplicate = state.index
            }

            state.index += 1
        },
        return: state => state.duplicate
    })
}
