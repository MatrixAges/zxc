<Module>
    <Type from="model" as="Load" />

    <Args in={Load.Source} out={Load.SourcePlan} />

    <Call fn="is_rx" in={$in.path} />

    <If on={$ctx.is_rx}>
        <If on={!$in.signature}>
            <Return
                value={{
                    action: Load.SourceAction.RejectRx
                }}
            />
        </If>

        <If on={$in.function_import && !$in.exported}>
            <Return
                value={{
                    action: Load.SourceAction.SkipSignature
                }}
            />
        </If>

        <Return
            value={{
                action: Load.SourceAction.DeferSignature
            }}
        />
    </If>

    <Call fn="lookup" in={$in} />

    <If on={$ctx.lookup != null}>
        <Call
            fn="admit"
            in={{
                state: $in.states[$ctx.lookup],
                depth: $in.depth
            }}
        />

        <Switch on={$ctx.admit}>
            <Case value={Load.Admission.Push}>
                <Return
                    value={{
                        action: Load.SourceAction.Descend,
                        index: $ctx.lookup
                    }}
                />
            </Case>

            <Case value={Load.Admission.Cycle}>
                <Return
                    value={{
                        action: Load.SourceAction.Cycle
                    }}
                />
            </Case>

            <Case value={Load.Admission.Depth}>
                <Return
                    value={{
                        action: Load.SourceAction.Depth
                    }}
                />
            </Case>

            <Default>
                <Return
                    value={{
                        action: Load.SourceAction.Bind,
                        index: $ctx.lookup
                    }}
                />
            </Default>
        </Switch>
    </If>

    <Return
        value={{
            action: Load.SourceAction.Missing
        }}
    />
</Module>
