<Module>
    <Type from="model" as="Load" />

    <Args in={Load.Source} out={Load.SourceAction} />

    <If on={$in.rx}>
        <If on={!$in.signature}>
            <Return value={Load.SourceAction.RejectRx} />
        </If>

        <If on={$in.function_import && !$in.exported}>
            <Return value={Load.SourceAction.SkipSignature} />
        </If>

        <Return value={Load.SourceAction.DeferSignature} />
    </If>

    <If on={$in.state != null}>
        <Call
            fn="admit"
            in={{
                state: $in.state,
                depth: $in.depth
            }}
        />

        <Switch on={$ctx.admit}>
            <Case value={Load.Admission.Push}>
                <Return value={Load.SourceAction.Descend} />
            </Case>

            <Case value={Load.Admission.Cycle}>
                <Return value={Load.SourceAction.Cycle} />
            </Case>

            <Case value={Load.Admission.Depth}>
                <Return value={Load.SourceAction.Depth} />
            </Case>

            <Default>
                <If on={$in.signature}>
                    <Return value={Load.SourceAction.BindSignature} />
                </If>

                <Return value={Load.SourceAction.BindBody} />
            </Default>
        </Switch>
    </If>

    <Return value={Load.SourceAction.Missing} />
</Module>
