import type { U64Buffer } from "std:memory"

export enum State {
    Fresh,
    Visiting,
    Done
}

export enum Admission {
    Push,
    Skip,
    Cycle,
    Depth
}

export type Frame = {
    state: State,
    depth: u64
}

export enum SourceAction {
    Descend,
    Bind,
    DeferSignature,
    SkipSignature,
    RejectRx,
    Missing,
    Cycle,
    Depth
}

export type Source = {
    path: string,
    signature: bool,
    function_import: bool,
    exported: bool,
    depth: u64,
    keys: u8[][],
    buckets: U64Buffer,
    capacity: u64,
    states: State[]
}

export type SourcePlan = {
    action: SourceAction,
    index?: u64
}
