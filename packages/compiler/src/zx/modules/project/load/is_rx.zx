import bytes from "std:bytes"

import { rx_extension } from "../../path/const"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    const source = bytes.fromText(in)
    const width = rx_extension.length

    return source.length >= width && bytes.startsWithText(
        source,
        source.length - width,
        rx_extension
    )
}
