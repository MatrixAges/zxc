import recursive from "../../artifact/remapping/recursive"

import type { Request } from "./model"

export type Input = {
    module: Request,
    candidate?: u32
}

export type Output = bool

export default function (in: Input): Output {
    const { module, candidate } = in

    if (module.type_only || !module.declared) {
        return false
    }

    if (module.restored) {
        return module.restored_function != null
    }

    return recursive({
        calls: module.calls,
        candidate
    }) != null
}
