<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Request} out={Publication.Plan} />

    <Call fn="slot" in={$in} />

    <Call
        fn="recursion"
        in={{
            module: $in,
            candidate: $ctx.slot.id
        }}
    />

    <Call
        module="classify"
        in={{
            type_only: $in.type_only,
            entry: $in.entry
        }}
    />

    <Call
        fn="ownership_count"
        in={{
            linked_count: $in.linked_count,
            append: $ctx.slot.append,
            type_only: $in.type_only,
            recursive: $ctx.recursion,
            check: $in.check_ownership && !$in.restored
        }}
    />

    <Return
        value={{
            ...$ctx.slot,
            publication: $ctx.classify,
            own_function: $ctx.recursion ? $ctx.slot.id : null,
            ownership_count: $ctx.ownership_count,
            publish_artifact: $in.cache && !$in.restored
        }}
    />
</Module>
