import less from "../../analysis/semantic/constructing/fields/less"
import field from "../../analysis/semantic/resolving/source/field"
import item from "../../analysis/semantic/resolving/source/item"

import type { Source } from "../../analysis/semantic/resolving/source/model"

export type Input = { source: Source, position: u64, count: u64, object: bool }

export type Output = u64[]

export default function (in: Input): Output {
    const names: string[] = []
    const positions: u64[] = []

    const collected = loop({ input: in, position: in.position, index: 0, names: names, positions: positions }, {
        while: current => current.index < current.input.count,
        next: current => {
            current.positions = current.positions.push(current.position)[0]

            if (current.input.object) {
                const selected = field({ source: current.input.source, position: current.position })

                current.names = current.names.push(selected.name.text)[0]
                current.position = selected.next
            } else {
                const selected = item({ source: current.input.source, position: current.position })

                current.position = selected.next
            }

            current.index += 1
        }
    })

    if (!in.object || in.count < 2) {
        return collected.positions
    }

    const result = loop({ names: collected.names, positions: collected.positions, count: in.count, remaining: in.count / 2, root: 0, building: true, sifting: false }, {
        while: current => current.building || current.count > 1 || current.sifting,
        next: current => {
            if (current.sifting) {
                if (current.root >= current.count / 2) {
                    current.sifting = false
                } else {
                    const left = current.root * 2 + 1
                    const right = left + 1
                    const child = right < current.count && less({ left: current.names[left], right: current.names[right] }) ? right : left

                    if (less({ left: current.names[current.root], right: current.names[child] })) {
                        const name = current.names[current.root]
                        const position = current.positions[current.root]

                        current.names[current.root] = current.names[child]
                        current.positions[current.root] = current.positions[child]
                        current.names[child] = name
                        current.positions[child] = position
                        current.root = child
                    } else {
                        current.sifting = false
                    }
                }
            } else if (current.building) {
                if (current.remaining == 0) {
                    current.building = false
                } else {
                    current.remaining -= 1
                    current.root = current.remaining
                    current.sifting = true
                }
            } else {
                current.count -= 1

                const name = current.names[0]
                const position = current.positions[0]

                current.names[0] = current.names[current.count]
                current.positions[0] = current.positions[current.count]
                current.names[current.count] = name
                current.positions[current.count] = position
                current.root = 0
                current.sifting = true
            }
        }
    })

    return result.positions
}
