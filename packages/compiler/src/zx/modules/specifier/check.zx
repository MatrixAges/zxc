import { current_directory, parent_directory } from "../path/const"
import { Kind } from "./model"

export type Input = string

export type Output = Kind

export default function (in: Input): Output {
    if (in == current_directory || in == parent_directory) {
        return Kind.File
    }

    if (in.length == 0) {
        return Kind.Invalid
    }

    const state = loop({
        source: in,
        offset: 0,
        separator: in.length,
        valid: true
    }, {
        while: value => value.valid && value.offset < value.source.length,
        next: value => {
            const byte = value.source[value.offset]

            value.valid =
                (
                    - byte != 0
                    - and byte != 9
                    - and byte != 10
                    - and byte != 13
                    - and byte != 32
                    - and byte != 92
                )

            if (byte == 58) {
                value.valid =
                    value.separator == value.source.length &&
                    value.offset + 1 < value.source.length
                value.separator = value.offset
            }

            value.offset += 1
        }
    })

    if (!state.valid) {
        return Kind.Invalid
    }

    if (state.separator < in.length) {
        if (state.separator == 1 && in[0] == 99) {
            return Kind.C
        }

        if (state.separator == 3) {
            const condition = (
                - in[0] == 122
                - and in[1] == 105
                - and in[2] == 103
            )

            if (condition) {
                return Kind.Zig
            }

            const condition_2 = (
                - in[0] == 115
                - and in[1] == 116
                - and in[2] == 100
            )

            if (condition_2) {
                return Kind.Standard
            }

            const condition_3 = (
                - in[0] == 108
                - and in[1] == 105
                - and in[2] == 98
            )

            if (condition_3) {
                return Kind.LegacyLibrary
            }
        }

        return Kind.Invalid
    }

    const condition_4 = (
        - in.length >= 2
        - and (in[0] == 46 || in[0] == 64)
        - and in[1] == 47
    )

    if (condition_4) {
        return Kind.File
    }

    const condition_5 = (
        - in.length >= 3
        - and in[0] == 46
        - and in[1] == 46
        - and in[2] == 47
    )

    if (condition_5) {
        return Kind.File
    }

    return loop({
        source: in,
        offset: 0,
        start: 0,
        valid: true
    }, {
        while: value => value.valid && value.offset <= value.source.length,
        next: value => {
            if (
                value.offset == value.source.length ||
                    value.source[value.offset] == 47
            ) {
                const length = value.offset - value.start

                value.valid =
                    (
                        - length != 0
                        - and !(
                            length == 1 && value.source[value.start] == 46
                        )
                        - and !(
                            length == 2 && value.source[value.start] == 46 &&
                                value.source[value.start + 1] == 46
                        )
                    )
                value.start = value.offset + 1
            }

            value.offset += 1
        },
        return: state => state.valid
    }) ? Kind.Package : Kind.Invalid
}
