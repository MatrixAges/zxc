<Module>
    <Type from="model" as="SourceSignatureModel" />

    <Args in={SourceSignatureModel.Input} out={SourceSignatureModel.Result} />

    <Call module="../../analysis/analyzer/declarations" in={$in.declarations} />

    <Call
        fn="initial"
        in={{
            syntax: $in.declarations.syntax,
            types: $ctx.declarations.types,
            diagnostic: $ctx.declarations.diagnostic
        }}
    />

    <If on={$ctx.declarations.diagnostic.message == ""}>
        <Call
            module="../../analysis/analyzer/signature"
            in={{
                syntax: $in.declarations.syntax,
                types: $ctx.declarations.types
            }}
        />

        <If on={$ctx.signature.diagnostic.message == ""}>
            <Call
                fn="../../analysis/analyzer/exports"
                in={{
                    state: {
                        types: $ctx.signature.types,
                        diagnostic: $ctx.signature.diagnostic
                    }
                }}
            />

            <If on={$ctx.exports.state.diagnostic.message == ""}>
                <Call
                    fn="../../analysis/constants/declarations/analyze"
                    in={{
                        ...$in.declarations.pick(["bytes", "syntax", "native"]),
                        types: $ctx.exports.state.types,
                        imports: $in.imports
                    }}
                />

                <Return
                    value={{
                        ...$ctx.initial,
                        type_delta: $ctx.analyze.types.delta,
                        nominal_delta: $ctx.analyze.types.nominal_delta,
                        input_type: $ctx.signature.input_type,
                        output_type: $ctx.signature.output_type,
                        export_names: $ctx.exports.names,
                        export_types: $ctx.exports.types,
                        constant_scope: $ctx.analyze.scope,
                        constant_first: $ctx.analyze.first,
                        diagnostic: $ctx.analyze.diagnostic
                    }}
                />
            </If>

            <Return
                value={{
                    ...$ctx.initial,
                    type_delta: $ctx.exports.state.types.delta,
                    nominal_delta: $ctx.exports.state.types.nominal_delta,
                    input_type: $ctx.signature.input_type,
                    output_type: $ctx.signature.output_type,
                    export_names: $ctx.exports.names,
                    export_types: $ctx.exports.types,
                    diagnostic: $ctx.exports.state.diagnostic
                }}
            />

            <Else>
                <Return
                    value={{
                        ...$ctx.initial,
                        type_delta: $ctx.signature.types.delta,
                        nominal_delta: $ctx.signature.types.nominal_delta,
                        input_type: $ctx.signature.input_type,
                        output_type: $ctx.signature.output_type,
                        diagnostic: $ctx.signature.diagnostic
                    }}
                />
            </Else>
        </If>

        <Else>
            <Return value={$ctx.initial} />
        </Else>
    </If>
</Module>
