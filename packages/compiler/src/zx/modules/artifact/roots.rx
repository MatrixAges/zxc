<Module>
    <Type from="./roots/model" as="Model" />

    <Args in={Model.Request} out={bool[]?} />

    <Call fn="../../ir/canonical/native/structure" in={$in.modules} />
    <Call fn="roots/valid" in={$in} />
    <Call fn="dependencies/allowed" in={$in.record.import_kinds} />

    <Switch on={$ctx.structure && $ctx.valid && $ctx.allowed}>
        <Case value={true}>
            <Call module="roots/select" in={$in} />

            <Return value={$ctx.select} />
        </Case>

        <Default>
            <Return value={null} />
        </Default>
    </Switch>
</Module>
