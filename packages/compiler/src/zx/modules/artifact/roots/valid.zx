import integers from "std:integer"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const record = in.record
    const functions = in.functions
    const count = functions.count

    if (record.start > record.end || record.end > in.table.kinds.length) {
        return false
    }

    const condition = (
        - record.function_ids.length != record.function_inputs.length
        - or record.function_ids.length != record.function_outputs.length
        - or record.import_kinds.length != record.import_specifiers.length
    )

    if (condition) {
        return false
    }

    const condition_2 = (
        - functions.files.length != count
        - or functions.input_types.length != count
        - or functions.output_types.length != count
        - or functions.native_modules.length != count
        - or functions.symbols.length != count
        - or functions.expressions.length != count
        - or functions.contracts.length != count
        - or functions.stores.length != count
    )

    if (condition_2) {
        return false
    }

    const function_id = record.body_function

    return function_id == null || integers.widen(function_id) < count
}
