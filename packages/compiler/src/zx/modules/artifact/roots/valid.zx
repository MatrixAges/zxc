import integers from "std:integer"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const record = in.record
    const functions = in.functions
    const count = functions.count

    if (record.start > record.end || record.end > in.table.kinds.length) {
        return false
    }

    const function_ids = record.function_ids.length
    const dependencies = record.import_kinds.length
    const input_mismatch = record.function_inputs.length != function_ids
    const output_mismatch = record.function_outputs.length != function_ids
    const specifier_mismatch = record.import_specifiers.length != dependencies
    const key_mismatch = record.dependency_keys.length != dependencies

    const condition = (
        - input_mismatch
        - or output_mismatch
        - or specifier_mismatch
        - or key_mismatch
    )

    if (condition) {
        return false
    }

    const different_files = functions.files.length != count
    const different_input_types = functions.input_types.length != count
    const different_output_types = functions.output_types.length != count
    const different_native_modules = functions.native_modules.length != count
    const different_symbols = functions.symbols.length != count
    const different_expressions = functions.expressions.length != count
    const different_contracts = functions.contracts.length != count
    const different_stores = functions.stores.length != count

    const condition_2 = (
        - different_files
        - or different_input_types
        - or different_output_types
        - or different_native_modules
        - or different_symbols
        - or different_expressions
        - or different_contracts
        - or different_stores
    )

    if (condition_2) {
        return false
    }

    const function_id = record.body_function

    return function_id == null || integers.widen(function_id) < count
}
