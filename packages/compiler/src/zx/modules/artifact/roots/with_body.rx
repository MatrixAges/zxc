<Module>
    <Type from="model" as="Model" />

    <Args
        in={{
            body: Model.Body,
            request: Model.Request
        }}
        out={bool[]?}
    />

    <Call
        fn="body_valid"
        in={{
            body: $in.body,
            max_offset: $in.request.max_offset
        }}
    />

    <If on={$ctx.body_valid}>
        <Call
            module="reachable"
            in={{
                request: $in.request,
                body: $in.body
            }}
        />

        <Return value={$ctx.reachable} />

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
