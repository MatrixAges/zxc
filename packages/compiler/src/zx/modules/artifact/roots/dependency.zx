import integers from "std:integer"
import { Kind } from "core/type_table/model"

import kind from "../../../analysis/semantic/types/kind"

import type { Table } from "core/type_table/model"

export type Input = {
    table: Table,
    index: u64,
    edge: u64
}

export type Output = u32?

export default function (in: Input): Output {
    const type_kind = kind(in.table.kinds[in.index])

    if (type_kind == Kind.Optional || type_kind == Kind.List) {
        return in.edge == 0 ? in.table.first[in.index] : null
    }

    if (type_kind == Kind.Task) {
        if (in.edge >= 2) {
            return null
        }

        return in.edge == 0 ? in.table.first[in.index] : in.table.second[in.index]
    }

    const aggregate = type_kind == Kind.Tuple || type_kind == Kind.Object

    const condition = match {
        aggregate => in.edge < integers.widen(in.table.second[in.index]),
        _ => false
    }

    if (condition) {
        const index = integers.widen(in.table.first[in.index]) + in.edge

        return match {
            type_kind == Kind.Tuple => in.table.children[index],
            _ => in.table.field_types[index]
        }
    }

    return null
}
