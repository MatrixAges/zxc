<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Selection} out={bool[]?} />

    <Call fn="collect" in={$in} />

    <If on={$ctx.collect.valid}>
        <Call
            fn="closure"
            in={{
                table: $in.request.table,
                needed: $ctx.collect.needed
            }}
        />

        <Return value={$ctx.closure.valid ? $ctx.closure.needed : null} />

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
