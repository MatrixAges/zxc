import integers from "std:integer"
import memory from "std:memory"

import mark from "./mark"

import type { Request } from "./model"

export type Input = {
    request: Request
}

export type Output = bool

export default function (in: Input): Output {
    const { functions, record, modules, roots, buffer } = in.request

    const count = roots.length

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < record.function_ids.length,
        next: state => {
            const index = integers.widen(record.function_ids[state.index])

            if (index >= functions.count) {
                state.valid = false
            } else {
                const input = integers.widen(record.function_inputs[state.index])
                const output = integers.widen(record.function_outputs[state.index])
                const source_input = integers.widen(functions.input_types[index])
                const source_output = integers.widen(functions.output_types[index])
                const invalid = (
                    - input >= count
                    - or output >= count
                    - or source_input >= count
                    - or source_output >= count
                )

                if (invalid) {
                    state.valid = false
                } else {
                    memory.writeU8(buffer, input, 1)
                    memory.writeU8(buffer, output, 1)
                    memory.writeU8(buffer, source_input, 1)
                    memory.writeU8(buffer, source_output, 1)

                    const module = functions.native_modules[index]

                    if (module != null) {
                        const native = integers.widen(module)

                        if (native >= modules.specifiers.length) {
                            state.valid = false
                        } else {
                            state.valid = mark({
                                buffer,
                                count,
                                values: modules.type_ids[native]
                            })
                        }
                    }
                }
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
