<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Request} out={bool[]?} />

    <If on={$in.record.has_body}>
        <If on={$in.record.body_function == null}>
            <Call
                fn="entry_source"
                in={{
                    path: $in.record.path,
                    file_name: $in.file_name,
                    type_only: $in.type_only
                }}
            />

            <If on={$ctx.entry_source}>
                <Call
                    module="reachable"
                    in={{
                        request: $in,
                        body: $in.entry
                    }}
                />

                <Return value={$ctx.reachable} />

                <Else>
                    <Return value={null} />
                </Else>
            </If>

            <Else>
                <Call
                    fn="function_source"
                    in={{
                        path: $in.record.path,
                        functions: $in.functions,
                        index: $in.record.body_function ?? 0
                    }}
                />

                <If on={$ctx.function_source}>
                    <Call
                        fn="function_body"
                        in={{
                            functions: $in.functions,
                            index: $in.record.body_function ?? 0
                        }}
                    />

                    <Call
                        module="reachable"
                        in={{
                            request: $in,
                            body: $ctx.function_body
                        }}
                    />

                    <Return value={$ctx.reachable} />

                    <Else>
                        <Return value={null} />
                    </Else>
                </If>
            </Else>
        </If>

        <Else>
            <Call
                module="reachable"
                in={{
                    request: $in,
                    body: null
                }}
            />

            <Return value={$ctx.reachable} />
        </Else>
    </If>
</Module>
