import integers from "std:integer"
import memory from "std:memory"

import dependency from "./dependency"

import type { U8Buffer } from "std:memory"
import type { Table } from "core/type_table/model"

export type Input = {
    table: Table,
    needed: bool[],
    buffer: U8Buffer
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        table: in.table,
        remaining: in.needed.length,
        edge: 0,
        valid: true
    }, {
        while: current => current.valid && current.remaining > 0,
        next: current => {
            const index = current.remaining - 1
            const child = match {
                in.needed[index] => dependency({
                    table: current.table,
                    index,
                    edge: current.edge
                }),
                _ => null
            }

            if (child == null) {
                current.remaining -= 1
                current.edge = 0
            } else {
                const child_index = integers.widen(child)

                if (child_index >= in.needed.length) {
                    current.valid = false
                } else {
                    memory.writeU8(in.buffer, child_index, 1)
                    current.edge += 1
                }
            }
        },
        return: state => state.valid
    })
}
