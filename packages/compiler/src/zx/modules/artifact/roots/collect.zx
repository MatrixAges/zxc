import memory from "std:memory"

import mark from "./mark"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const { record, roots, buffer } = in

    const initialized = loop({
        index: record.start
    }, {
        while: state => state.index < record.end,
        next: state => {
            memory.writeU8(buffer, state.index, 1)
            state.index += 1
        }
    })

    const declarations = mark({
        buffer,
        count: roots.length,
        values: record.declaration_types
    })

    return declarations && mark({
        buffer,
        count: roots.length,
        values: record.type_imports
    })
}
