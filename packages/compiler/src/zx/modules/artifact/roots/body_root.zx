import integers from "std:integer"
import memory from "std:memory"

import mark from "./mark"

import type { U8Buffer } from "std:memory"
import type { Body } from "./model"

export type Input = {
    body?: Body,
    buffer: U8Buffer,
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { body, buffer, count } = in

    if (body == null) {
        return true
    }

    const input = integers.widen(body.input_type)
    const output = integers.widen(body.output_type)

    if (input >= count || output >= count) {
        return false
    }

    memory.writeU8(buffer, input, 1)
    memory.writeU8(buffer, output, 1)

    const symbols = mark({
        buffer,
        count,
        values: body.symbols.types
    })

    if (!symbols) {
        return false
    }

    const expressions = mark({
        buffer,
        count,
        values: body.expressions.types
    })

    if (!expressions) {
        return false
    }

    const contracts = body.contracts

    const checked = loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < contracts.kinds.length,
        next: state => {
            const symbols = mark({
                buffer,
                count,
                values: contracts.symbols[state.index].types
            })

            state.valid = symbols && mark({
                buffer,
                count,
                values: contracts.expressions[state.index].types
            })

            state.index += 1
        }
    })

    if (!checked.valid) {
        return false
    }

    return mark({
        buffer,
        count,
        values: body.stores.types
    })
}
