import bodyRoot from "./body_root"
import functionRoot from "./function_root"
import listRoot from "./list_root"
import nativeRoot from "./native_root"

import type { Cursor, Selection, Step } from "./model"

export type Input = {
    selection: Selection,
    cursor: Cursor
}

export type Output = Step

export default function (in: Input): Output {
    const request = in.selection.request
    const body = in.selection.body
    const cursor = in.cursor

    return match cursor.stage {
        0 => listRoot({
            values: request.record.declaration_types,
            cursor
        }),
        1 => listRoot({
            values: request.record.type_imports,
            cursor
        }),
        2 => functionRoot({
            request,
            cursor
        }),
        3 => nativeRoot({
            request,
            cursor
        }),
        _ => match {
            body != null => bodyRoot({
                body,
                cursor
            }),
            _ => {
                cursor: {
                    stage: 5,
                    index: 0,
                    section: 0,
                    offset: 0
                },
                valid: true,
                found: false,
                id: 0
            }
        }
    }
}
