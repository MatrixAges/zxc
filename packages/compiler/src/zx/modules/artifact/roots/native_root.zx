import { TargetKind } from "../dependencies/model"
import mark from "./mark"

import type { Request } from "./model"

export type Input = {
    request: Request
}

export type Output = bool

export default function (in: Input): Output {
    const { modules, record, buffer, roots } = in.request

    const count = roots.length

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < record.import_kinds.length,
        next: state => {
            if (record.import_kinds[state.index] == TargetKind.Native) {
                const specifier = record.import_specifiers[state.index]

                const matched = loop({
                    index: 0,
                    valid: true
                }, {
                    while: row => row.valid && row.index < modules.specifiers.length,
                    next: row => {
                        if (specifier == modules.specifiers[row.index]) {
                            row.valid = mark({
                                buffer,
                                count,
                                values: modules.type_ids[row.index]
                            })
                        }

                        row.index += 1
                    }
                })

                state.valid = matched.valid
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
