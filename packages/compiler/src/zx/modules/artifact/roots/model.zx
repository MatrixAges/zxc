import type { Contracts } from "core/contract_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Modules } from "core/native_module_table/model"
import type { Stores } from "core/store_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { Table } from "core/type_table/model"
import type { TargetKind } from "../dependencies/model"

export type Functions = {
    count: u64
    files: string[]
    input_types: u32[]
    output_types: u32[]
    native_modules: u32?[]
    symbols: Symbols[]
    expressions: Expressions[]
    contracts: Contracts[]
    stores: Stores[]
}

export type Body = { input_type: u32, output_type: u32, symbols: Symbols, expressions: Expressions, contracts: Contracts, stores: Stores }

export type Record = {
    path: string
    start: u64
    end: u64
    exports: u32[]
    type_imports: u32[]
    function_ids: u32[]
    function_inputs: u32[]
    function_outputs: u32[]
    import_kinds: TargetKind[]
    import_specifiers: string[]
    has_body: bool
    body_function: u32?
}

export type Request = { file_name: string, type_only: bool, table: Table, functions: Functions, modules: Modules, entry: Body, record: Record, max_offset: u64 }

export type Selection = { request: Request, body: Body? }

export type Cursor = { stage: u64, index: u64, section: u64, offset: u64 }

export type Step = { cursor: Cursor, valid: bool, found: bool, id: u32 }
