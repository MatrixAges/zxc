<Module>
    <Type from="core/signature_table/model" as="Declarations" />
    <Type from="model" as="PlanningModel" />
    <Type from="functions/model" as="FunctionsModel" />
    <Type from="../../../ir/canonical/native/structure" as="Structure" />

    <Type
        from="../../../analysis/semantic/extracting/planning/model"
        as="ExtractingPlanningModel"
    />

    <Type from="../materializing/natives" as="Natives" />
    <Type from="../materializing/signatures" as="Signatures" />
    <Type from="../materializing/body" as="Body" />

    <Type
        from="../../../analysis/semantic/extracting/materializing/nominal"
        as="Nominal"
    />

    <Type from="../../../analysis/semantic/extracting/materializing/rows" as="Rows" />

    <Args
        in={{
            body: Body.Input,
            declarations: Declarations.Table,
            dependencies: PlanningModel.Dependencies,
            function_imports: FunctionsModel.Imports,
            modules: Structure.Input,
            own_function?: u32,
            request: ExtractingPlanningModel.Request,
            signatures: FunctionsModel.Signatures,
            type_imports: u32[]
        }}
        out={{
            body: Body.Output?,
            natives: Natives.Output,
            plan: FunctionsModel.Plan,
            signatures: Signatures.Output,
            value: {
                origins: Nominal.Output,
                table: Rows.Output
            }?
        }}
    />

    <Call module="plan" in={$in.omit(["body"])} />

    <Call
        fn="../../../analysis/semantic/extracting/planning/ready"
        in={$ctx.plan.state}
    />

    <If on={$ctx.ready}>
        <Call
            module="../../../analysis/semantic/extracting/materializing/materialize"
            in={{
                table: $in.request.table,
                origins: $in.request.origins,
                plan: $ctx.plan.state
            }}
        />

        <Call
            fn="../materializing/natives"
            in={{
                modules: $in.modules,
                plan: $ctx.plan.natives,
                mapping: $ctx.plan.state.mapping
            }}
        />

        <If on={$ctx.natives != null}>
            <Call fn="../materializing/body" in={$in.body} />

            <Call
                fn="../materializing/signatures"
                in={{
                    source: $in.declarations,
                    plan: $ctx.plan.functions,
                    types: $ctx.plan.state.mapping,
                    natives: $ctx.plan.natives.mapping
                }}
            />

            <Return
                value={{
                    body: $ctx.body,
                    plan: $ctx.plan,
                    value: $ctx.materialize,
                    natives: $ctx.natives,
                    signatures: $ctx.signatures
                }}
            />

            <Else>
                <Return
                    value={{
                        body: null,
                        plan: $ctx.plan,
                        value: null,
                        natives: null,
                        signatures: null
                    }}
                />
            </Else>
        </If>

        <Else>
            <Return
                value={{
                    body: null,
                    plan: $ctx.plan,
                    value: null,
                    natives: null,
                    signatures: null
                }}
            />
        </Else>
    </If>
</Module>
