import integers from "std:integer"
import { map } from "std:utils"

import type { NativePlan } from "./model"

export type Input = {
    specifiers: string[]
}

export type Output = NativePlan

export default function (in: Input): Output {
    const mapping: u64[] = map(in.specifiers, value => 0)
    const order: u32[] = map(in.specifiers, value => integers.narrow(0))

    return {
        mapping,
        order,
        count: 0
    }
}
