import integers from "std:integer"

import type { NativePlan } from "./model"

export type Input = {
    specifiers: string[]
}

export type Output = NativePlan

export default function (in: Input): Output {
    const mapping: u64[] = in.specifiers.map(value => 0)[0]
    const order: u32[] = in.specifiers.map(value => integers.narrow(0))[0]

    return {
        mapping,
        order,
        count: 0
    }
}
