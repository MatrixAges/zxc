<Module>
    <Type from="./native_dependencies" as="NativeDependencies" />

    <Args in={NativeDependencies.Input} out={NativeDependencies.Output} />

    <Call fn="../../../analysis/semantic/extracting/planning/ready" in={$in.state} />

    <If on={$ctx.ready}>
        <Call fn="native_dependencies" in={$in} />

        <Return value={$ctx.native_dependencies} />

        <Else>
            <Return
                value={{
                    state: $in.state,
                    natives: $in.natives
                }}
            />
        </Else>
    </If>
</Module>
