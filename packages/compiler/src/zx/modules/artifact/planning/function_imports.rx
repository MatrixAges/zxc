<Module>
    <Type from="./functions/imports" as="Imports" />
    <Type from="./functions/model" as="Model" />

    <Args in={Imports.Input} out={Model.Plan} />

    <Call
        fn="functions/validate"
        in={{
            signatures: $in.signatures,
            imports: $in.imports,
            plan: $in.plan
        }}
    />

    <Call
        fn="../../../analysis/semantic/extracting/planning/ready"
        in={$ctx.validate.state}
    />

    <If on={$ctx.ready}>
        <Call
            fn="functions/imports"
            in={{
                ...$in,
                plan: $ctx.validate
            }}
        />

        <Return value={$ctx.imports} />

        <Else>
            <Return value={$ctx.validate} />
        </Else>
    </If>
</Module>
