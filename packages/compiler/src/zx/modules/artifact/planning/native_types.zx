import integers from "std:integer"
import { Kind } from "core/type_table/model"

import { Status } from "../../../analysis/semantic/extracting/planning/model"
import kind from "../../../analysis/semantic/types/kind"
import includeNative from "./native_include"

import type { Modules } from "core/native_module_table/model"
import type { Request, State } from "../../../analysis/semantic/extracting/planning/model"
import type { NativePlan } from "./model"

export type Input = { request: Request, state: State, modules: Modules, natives: NativePlan }

export type Output = { state: State, natives: NativePlan }

export default function (in: Input): Output {
    const result = loop({ request: in.request, plan: in.state, modules: in.modules, natives: in.natives, index: 0, member: 0 }, {
        while: current => current.plan.status == Status.Ready && current.index < current.modules.specifiers.length,
        next: current => {
            const values = current.modules.type_ids[current.index]

            if (current.natives.mapping[current.index] != 0 || current.member >= values.length) {
                current.index += 1
                current.member = 0
            } else {
                const id = integers.widen(values[current.member])

                if (kind(current.request.table.kinds[id]) == Kind.NativeReference && current.plan.mapping[id] != 0) {
                    const included = includeNative({ request: current.request, state: current.plan, modules: current.modules, natives: current.natives, index: current.index })

                    current.plan = included.state
                    current.natives = included.natives
                    current.index += 1
                    current.member = 0
                } else {
                    current.member += 1
                }
            }
        }
    })

    return { state: result.plan, natives: result.natives }
}
