import { Status } from "../../../../analysis/semantic/extracting/planning/model"

import type { Signatures, Imports, Plan } from "./model"

export type Input = {
    signatures: Signatures,
    imports: Imports,
    plan: Plan
}

export type Output = Plan

export default function (in: Input): Output {
    if (in.plan.state.status != Status.Ready) {
        return in.plan
    }

    const count = in.signatures.inputs.length
    const imported = in.imports.ids.length

    const condition = (
        - in.signatures.outputs.length != count
        - or in.signatures.native_modules.length != count
        - or in.imports.inputs.length != imported
        - or in.imports.outputs.length != imported
    )

    if (condition) {
        return {
            ...in.plan,
            state: {
                ...in.plan.state,
                status: Status.Invalid
            }
        }
    }

    return in.plan
}
