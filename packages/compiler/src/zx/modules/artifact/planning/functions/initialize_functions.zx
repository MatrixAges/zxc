import integers from "std:integer"
import { map } from "std:utils"

import type { FunctionPlan } from "./model"

export type Input = {
    inputs: u32[]
}

export type Output = FunctionPlan

export default function (in: Input): Output {
    const mapping: u64[] = map(in.inputs, value => 0)
    const order: u32[] = map(in.inputs, value => integers.narrow(0))

    return {
        mapping: mapping,
        order: order,
        count: 0
    }
}
