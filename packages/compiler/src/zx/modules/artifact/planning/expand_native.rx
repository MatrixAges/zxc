<Module>
    <Type from="./native_types" as="NativeTypes" />
    <Type from="./native_include" as="NativeInclude" />

    <Args in={NativeTypes.Input} out={NativeInclude.Output} />

    <Call fn="../../../analysis/semantic/extracting/planning/ready" in={$in.state} />

    <If on={$ctx.ready}>
        <Call fn="native_types" in={$in} />

        <Return value={$ctx.native_types} />

        <Else>
            <Return
                value={{
                    state: $in.state,
                    natives: $in.natives
                }}
            />
        </Else>
    </If>
</Module>
