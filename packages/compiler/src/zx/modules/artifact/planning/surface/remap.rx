<Module>
    <Type from="model" as="Surface" />

    <Args in={Surface.Request} out={void} />

    <Task name="types">
        <Call
            fn="column"
            in={{
                column: $in.references.types,
                mapping: $in.types
            }}
        />
    </Task>

    <Task name="functions">
        <Call
            fn="column"
            in={{
                column: $in.references.functions,
                mapping: $in.functions
            }}
        />
    </Task>
</Module>
