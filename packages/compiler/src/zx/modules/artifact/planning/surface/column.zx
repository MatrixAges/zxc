import integers from "std:integer"
import memory from "std:memory"

import { first_invalid_id } from "../../remapping/const"

import type { Column } from "./model"

export type Input = {
    column: Column,
    mapping: u64[]
}

export type Output = void

export default function (in: Input): Output {
    const { buffer, count } = in.column

    const mapping = in.mapping

    const walked = loop({
        row: 0
    }, {
        while: state => state.row < count,
        next: state => {
            const id = memory.readU32(buffer, state.row)
            const target = mapping[integers.widen(id)]
            const offset = target == 0 ? first_invalid_id : target - 1

            memory.writeU32(buffer, state.row, integers.narrow(offset))

            state.row += 1
        }
    })
}
