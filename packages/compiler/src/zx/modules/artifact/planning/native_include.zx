import integers from "zig:integers"

import { Status } from "../../../analysis/semantic/extracting/planning/model"
import visit from "../../../analysis/semantic/extracting/planning/visit"

import type { Modules } from "core/native_module_table/model"
import type { Request, State } from "../../../analysis/semantic/extracting/planning/model"
import type { NativePlan } from "./model"

export type Input = { request: Request, state: State, modules: Modules, natives: NativePlan, index: u64 }

export type Output = { state: State, natives: NativePlan }

export default function (in: Input): Output {
    if (in.index >= in.modules.specifiers.length) {
        return { state: { ...in.state, status: Status.Invalid }, natives: in.natives }
    }

    if (in.natives.mapping[in.index] != 0) {
        return { state: in.state, natives: in.natives }
    }

    const result = loop({ request: in.request, plan: in.state, natives: in.natives, index: in.index, values: in.modules.type_ids[in.index], member: 0 }, {
        while: current => current.plan.status == Status.Ready && current.member <= current.values.length,
        next: current => {
            if (current.member < current.values.length) {
                current.plan = visit({ request: current.request, state: current.plan, index: integers.widen(current.values[current.member]) })
            } else {
                current.natives.mapping[current.index] = current.natives.count + 1
                current.natives.order[current.natives.count] = integers.narrow(current.index)
                current.natives.count += 1
            }

            current.member += 1
        }
    })

    return { state: result.plan, natives: result.natives }
}
