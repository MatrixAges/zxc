import integers from "std:integer"
import strings from "std:string"

import ids from "../remapping/ids"
import planned from "../remapping/planned"
import copyNames from "./copy_names"

import type { Modules } from "core/native_module_table/model"
import type { NativePlan } from "../planning/model"

export type Input = {
    modules: Modules,
    plan: NativePlan,
    mapping: u64[]
}

export type Output = Modules?

export default function (in: Input): Output {
    const empty: Modules = {
        identities: [],
        import_names: [],
        specifiers: [],
        type_ids: [],
        type_names: [],
        type_namespaces: []
    }

    const mapping = planned(in.mapping)

    const result = loop({
        source: in.modules,
        plan: in.plan,
        mapping,
        identities: empty.identities,
        import_names: empty.import_names,
        specifiers: empty.specifiers,
        type_ids: empty.type_ids,
        type_names: empty.type_names,
        type_namespaces: empty.type_namespaces,
        index: 0,
        valid: in.plan.count <= in.plan.order.length
    }, {
        while: current => current.valid && current.index < current.plan.count,
        next: current => {
            const selected = integers.widen(current.plan.order[current.index])

            if (selected >= current.source.specifiers.length) {
                current.valid = false
            } else {
                const mapped = ids({
                    values: current.source.type_ids[selected],
                    mapping: current.mapping
                })

                const identity = current.source.identities[selected]
                const owned_identity: string? = match {
                    identity != null => strings.copy(identity),
                    _ => null
                }
                const import_name =
                    strings.copy(current.source.import_names[selected])
                const specifier = strings.copy(current.source.specifiers[selected])
                const names = current.source.type_names[selected]
                const namespaces = current.source.type_namespaces[selected]

                current.identities = current.identities.push(owned_identity)[0]
                current.import_names = current.import_names.push(import_name)[0]
                current.specifiers = current.specifiers.push(specifier)[0]
                current.type_ids = current.type_ids.push(mapped)[0]
                current.type_names =
                    current.type_names.push(
                        copyNames(names)
                    )[0]
                current.type_namespaces =
                    current.type_namespaces.push(
                        copyNames(namespaces)
                    )[0]
            }

            current.index += 1
        }
    })

    if (!result.valid) {
        return null
    }

    return {
        identities: result.identities,
        import_names: result.import_names,
        specifiers: result.specifiers,
        type_ids: result.type_ids,
        type_names: result.type_names,
        type_namespaces: result.type_namespaces
    }
}
