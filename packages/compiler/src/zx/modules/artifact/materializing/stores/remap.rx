<Module>
    <Type from="core/store_table/model" as="Stores" />
    <Type from="../../remapping/model" as="Remap" />

    <Args
        in={{
            source: Stores.Stores,
            mapping: Remap.Mapping
        }}
        out={Stores.Stores?}
    />

    <Call fn="../../../../ir/canonical/stores/validate" in={$in.source} />

    <If on={!$ctx.validate}>
        <Return value={null} />
    </If>

    <Call
        fn="../../remapping/ids"
        in={{
            values: $in.source.types,
            mapping: $in.mapping
        }}
    />

    <Call
        fn="own"
        in={{
            source: $in.source,
            types: $ctx.ids
        }}
    />

    <Return value={$ctx.own} />
</Module>
