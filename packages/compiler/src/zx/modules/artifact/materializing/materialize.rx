<Module>
    <Type from="core/signature_table/model" as="Declarations" />
    <Type from="core/type_table/nominal" as="Nominal" />
    <Type from="core/type_table/model" as="Types" />
    <Type from="core/native_module_table/model" as="Native" />
    <Type from="../planning/functions/model" as="Functions" />
    <Type from="../remapping/model" as="Remap" />
    <Type from="content_model" as="Content" />

    <Type
        from="../../../analysis/semantic/extracting/materializing/nominal"
        as="OwnedNominal"
    />

    <Args
        in={{
            table: Types.Table,
            origins: Nominal.Bindings,
            declarations: Declarations.Table,
            modules: Native.Modules,
            plan: Functions.Plan,
            content: Content.Input
        }}
        out={{
            table: Types.Table,
            origins: OwnedNominal.Output,
            natives?: Native.Modules,
            signatures?: Declarations.Table,
            function?: Remap.FunctionOutput,
            entry_store_types?: u32[]
        }}
    />

    <Call
        module="../../../analysis/semantic/extracting/materializing/materialize"
        in={{
            table: $in.table,
            origins: $in.origins,
            plan: $in.plan.state
        }}
    />

    <Call
        fn="natives"
        in={{
            modules: $in.modules,
            plan: $in.plan.natives,
            mapping: $in.plan.state.mapping
        }}
    />

    <If on={$ctx.natives == null}>
        <Return
            value={{
                table: $ctx.materialize.table,
                origins: $ctx.materialize.origins,
                natives: null,
                signatures: null,
                function: null,
                entry_store_types: null
            }}
        />
    </If>

    <Call
        fn="signatures"
        in={{
            source: $in.declarations,
            plan: $in.plan.functions,
            types: $in.plan.state.mapping,
            natives: $in.plan.natives.mapping
        }}
    />

    <If on={$ctx.signatures == null}>
        <Return
            value={{
                table: $ctx.materialize.table,
                origins: $ctx.materialize.origins,
                natives: null,
                signatures: null,
                function: null,
                entry_store_types: null
            }}
        />
    </If>

    <Call module="content" in={$in.content} />

    <Return
        value={{
            table: $ctx.materialize.table,
            origins: $ctx.materialize.origins,
            natives: $ctx.content.valid ? $ctx.natives : null,
            signatures: $ctx.content.valid ? $ctx.signatures : null,
            function: $ctx.content.function,
            entry_store_types: $ctx.content.entry_store_types
        }}
    />
</Module>
