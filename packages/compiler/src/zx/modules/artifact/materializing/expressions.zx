import type { Expressions } from "core/expression_table/model"

export type Input = {
    source: Expressions,
    types: u32[],
    call_functions: u32[],
    strings: string[]
}

export type Output = Expressions

export default function (in: Input): Output {
    const { source, types, call_functions, strings } = in

    return {
        kinds: source.kinds.slice(),
        types,
        span_start: source.span_start.slice(),
        span_end: source.span_end.slice(),
        payloads: source.payloads.slice(),
        integers: source.integers.slice(),
        negative_integers: source.negative_integers.slice(),
        floats: source.floats.slice(),
        strings,
        booleans: source.booleans.slice(),
        some: source.some.slice(),
        captures: source.captures.slice(),
        awaits: source.awaits.slice(),
        cancellations: source.cancellations.slice(),
        optional_values: source.optional_values.slice(),
        enumerations: source.enumerations.slice(),
        errors: source.errors.slice(),
        references: source.references.slice(),
        stores: source.stores.slice(),
        lengths: source.lengths.slice(),
        sequence_first: source.sequence_first.slice(),
        sequence_count: source.sequence_count.slice(),
        sequence_items: source.sequence_items.slice(),
        projection_targets: source.projection_targets.slice(),
        projection_indices: source.projection_indices.slice(),
        index_targets: source.index_targets.slice(),
        index_values: source.index_values.slice(),
        task_bodies: source.task_bodies.slice(),
        task_capture_first: source.task_capture_first.slice(),
        task_capture_count: source.task_capture_count.slice(),
        task_captures: source.task_captures.slice(),
        parallel_first: source.parallel_first.slice(),
        parallel_count: source.parallel_count.slice(),
        parallel_tasks: source.parallel_tasks.slice(),
        parallel_fields: source.parallel_fields.slice(),
        collection_kinds: source.collection_kinds.slice(),
        collection_targets: source.collection_targets.slice(),
        collection_first: source.collection_first.slice(),
        collection_count: source.collection_count.slice(),
        collection_arguments: source.collection_arguments.slice(),
        transform_kinds: source.transform_kinds.slice(),
        transform_targets: source.transform_targets.slice(),
        transform_bodies: source.transform_bodies.slice(),
        transform_initials: source.transform_initials.slice(),
        transform_first: source.transform_first.slice(),
        transform_count: source.transform_count.slice(),
        transform_parameters: source.transform_parameters.slice(),
        scope_results: source.scope_results.slice(),
        scope_first: source.scope_first.slice(),
        scope_count: source.scope_count.slice(),
        scope_symbols: source.scope_symbols.slice(),
        scope_values: source.scope_values.slice(),
        scope_borrows: source.scope_borrows.slice(),
        iteration_initials: source.iteration_initials.slice(),
        iteration_condition_parameters: source.iteration_condition_parameters.slice(),
        iteration_parameters: source.iteration_parameters.slice(),
        iteration_environment_symbols: source.iteration_environment_symbols.slice(),
        iteration_conditions: source.iteration_conditions.slice(),
        iteration_bodies: source.iteration_bodies.slice(),
        iteration_postconditions: source.iteration_postconditions.slice(),
        update_targets: source.update_targets.slice(),
        update_indices: source.update_indices.slice(),
        update_values: source.update_values.slice(),
        call_functions,
        call_arguments: source.call_arguments.slice(),
        call_store_first: source.call_store_first.slice(),
        call_store_count: source.call_store_count.slice(),
        call_stores: source.call_stores.slice(),
        unary_operators: source.unary_operators.slice(),
        unary_operands: source.unary_operands.slice(),
        binary_operators: source.binary_operators.slice(),
        binary_left: source.binary_left.slice(),
        binary_right: source.binary_right.slice(),
        conditional_conditions: source.conditional_conditions.slice(),
        conditional_yes: source.conditional_yes.slice(),
        conditional_no: source.conditional_no.slice(),
        match_subjects: source.match_subjects.slice(),
        match_fallbacks: source.match_fallbacks.slice(),
        match_first: source.match_first.slice(),
        match_count: source.match_count.slice(),
        match_conditions: source.match_conditions.slice(),
        match_results: source.match_results.slice(),
        object_first: source.object_first.slice(),
        object_count: source.object_count.slice(),
        object_field_indices: source.object_field_indices.slice(),
        object_field_values: source.object_field_values.slice(),
        object_evaluation_first: source.object_evaluation_first.slice(),
        object_evaluation_count: source.object_evaluation_count.slice(),
        object_evaluation_values: source.object_evaluation_values.slice()
    }
}
