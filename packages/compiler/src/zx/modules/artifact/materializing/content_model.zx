import type { Control } from "core/control_table/model"
import type { Stores } from "core/store_table/model"
import type { FunctionInput, FunctionOutput, Mapping } from "../remapping/model"

export type Input = {
    source?: FunctionInput,
    control?: Control,
    body_stores?: Stores,
    entry_stores: Stores,
    type_mapping: Mapping,
    copy_entry_stores: bool
}

export type Output = {
    valid: bool,
    function?: FunctionOutput,
    control?: Control,
    body_stores?: Stores,
    stores?: Stores
}
