import strings from "std:string"

import copyNames from "./copy_names"

import type { Binding } from "core/native_module_table/model"

export type Input = {
    source: Binding,
    mapped_ids?: u32[]
}

export type Output = Binding

export default function (in: Input): Output {
    const { source, mapped_ids } = in

    const identity: string? = match {
        source.identity != null => strings.copy(source.identity),
        _ => null
    }

    return {
        identity,
        specifier: strings.copy(source.specifier),
        import_name: strings.copy(source.import_name),
        namespace: copyNames(source.namespace),
        names: copyNames(source.names),
        ids: mapped_ids ?? source.ids.slice()
    }
}
