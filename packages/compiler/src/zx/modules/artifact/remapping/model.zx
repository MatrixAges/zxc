import type { Contracts } from "core/contract_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Symbols } from "core/symbol_table/model"

export enum Kind {
    Dense,
    Sparse,
    Planned,
    Range
}

export type Mapping = {
    kind: Kind,
    dense: u32[],
    sparse: u32?[],
    planned: u64[],
    first: u64,
    prefix: u64,
    count: u64
}

export type Ports = {
    input: u32,
    output: u32,
    native_module?: u32
}

export type FunctionInput = {
    ports: Ports,
    symbols: Symbols,
    expressions: Expressions,
    stores: u32[],
    contracts: Contracts,
    types: Mapping,
    functions: Mapping,
    natives: Mapping,
    candidate?: u32
}

export type FunctionOutput = {
    ports: Ports,
    symbols: Symbols,
    expressions: Expressions,
    stores: u32[],
    contracts: Contracts,
    recursive?: u32
}
