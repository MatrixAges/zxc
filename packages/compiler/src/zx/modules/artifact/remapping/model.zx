export enum Kind {
    Dense,
    Sparse,
    Planned,
    Range
}

export type Mapping = {
    kind: Kind,
    dense: u32[],
    sparse: u32?[],
    planned: u64[],
    first: u64,
    prefix: u64,
    count: u64
}

export type Ports = {
    input: u32,
    output: u32,
    native_module?: u32
}

export type ContractColumns = {
    symbols: u32[][],
    types: u32[][],
    calls: u32[][]
}
