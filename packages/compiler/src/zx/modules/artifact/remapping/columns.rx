<Module>
    <Type from="./pack" as="Pack" />

    <Args
        in={{
            function_mapping: u64[],
            functions: u32[],
            type_mapping: u64[],
            types: u32[]
        }}
        out={Pack.Output}
    />

    <Task name="types" out={$ctx.ids}>
        <Call
            fn="ids"
            in={{
                values: $in.types,
                mapping: $in.type_mapping
            }}
        />
    </Task>

    <Switch on={$ctx.task.types != null}>
        <Case value={true}>
            <Task name="functions" out={$ctx.ids}>
                <Call
                    fn="ids"
                    in={{
                        values: $in.functions,
                        mapping: $in.function_mapping
                    }}
                />
            </Task>

            <Call
                fn="pack"
                in={{
                    types: $ctx.task.types,
                    functions: $ctx.task.functions
                }}
            />

            <Return value={$ctx.pack} />
        </Case>

        <Default>
            <Return value={null} />
        </Default>
    </Switch>
</Module>
