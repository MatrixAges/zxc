<Module>
    <Type from="model" as="References" />

    <Args
        in={{
            function_mapping: References.Mapping,
            functions: u32[],
            type_mapping: References.Mapping,
            types: u32[]
        }}
        out={{
            functions: u32[],
            types: u32[]
        }}
    />

    <Task name="types" out={$ctx.ids}>
        <Call
            fn="ids"
            in={{
                values: $in.types,
                mapping: $in.type_mapping
            }}
        />
    </Task>

    <Task name="functions" out={$ctx.ids}>
        <Call
            fn="ids"
            in={{
                values: $in.functions,
                mapping: $in.function_mapping
            }}
        />
    </Task>

    <Return
        value={{
            types: $ctx.task.types,
            functions: $ctx.task.functions
        }}
    />
</Module>
