<Module>
    <Type from="model" as="References" />

    <Args in={References.FunctionInput} out={References.FunctionOutput} />

    <Call
        fn="ports"
        in={{
            ports: $in.ports,
            types: $in.types,
            natives: $in.natives
        }}
    />

    <Task name="symbols" out={$ctx.ids}>
        <Call
            fn="ids"
            in={{
                values: $in.symbols.types,
                mapping: $in.types
            }}
        />
    </Task>

    <Call
        module="columns"
        in={{
            types: $in.expressions.types,
            type_mapping: $in.types,
            functions: $in.expressions.call_functions,
            function_mapping: $in.functions
        }}
    />

    <Task name="stores" out={$ctx.ids}>
        <Call
            fn="ids"
            in={{
                values: $in.stores,
                mapping: $in.types
            }}
        />
    </Task>

    <Call
        fn="contracts"
        in={{
            source: $in.contracts,
            types: $in.types,
            functions: $in.functions
        }}
    />

    <Call
        fn="recursive"
        in={{
            calls: $ctx.columns.functions,
            candidate: $in.candidate
        }}
    />

    <Task name="names" out={$ctx.copy_names}>
        <Call fn="../materializing/copy_names" in={$in.symbols.names} />
    </Task>

    <Task name="strings" out={$ctx.copy_names}>
        <Call fn="../materializing/copy_names" in={$in.expressions.strings} />
    </Task>

    <Call
        fn="../materializing/symbols"
        in={{
            source: $in.symbols,
            types: $ctx.task.symbols,
            names: $ctx.task.names
        }}
    />

    <Call
        fn="../materializing/expressions"
        in={{
            source: $in.expressions,
            types: $ctx.columns.types,
            call_functions: $ctx.columns.functions,
            strings: $ctx.task.strings
        }}
    />

    <Return
        value={{
            ports: $ctx.ports,
            symbols: $ctx.symbols,
            expressions: $ctx.expressions,
            stores: $ctx.task.stores,
            contracts: $ctx.contracts,
            recursive: $ctx.recursive
        }}
    />
</Module>
