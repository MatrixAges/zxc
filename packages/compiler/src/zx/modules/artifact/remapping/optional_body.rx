<Module>
    <Type from="model" as="Remap" />

    <Args
        in={{
            source?: Remap.FunctionInput
        }}
        out={Remap.FunctionOutput?}
    />

    <If on={$in.source != null}>
        <Call module="body_columns" in={$in.source} />

        <Return value={$ctx.body_columns} />
    </If>

    <Return value={null} />
</Module>
