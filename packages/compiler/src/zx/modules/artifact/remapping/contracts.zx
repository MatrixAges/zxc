import copyNames from "../materializing/copy_names"
import ownExpressions from "../materializing/expressions"
import ownSymbols from "../materializing/symbols"
import ids from "./ids"

import type { Contracts } from "core/contract_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { Mapping } from "./model"

export type Input = {
    source: Contracts,
    types: Mapping,
    functions: Mapping
}

export type Output = Contracts

export default function (in: Input): Output {
    const { source, types, functions } = in

    const symbols: Symbols[] = []
    const expressions: Expressions[] = []

    return loop({
        symbols,
        expressions,
        index: 0
    }, {
        while: current => current.index < source.kinds.length,
        next: current => {
            const index = current.index
            const expression = source.expressions[index]
            const symbol = source.symbols[index]

            const symbol_types = ids({
                values: symbol.types,
                mapping: types
            })

            const expression_types = ids({
                values: expression.types,
                mapping: types
            })

            const call_functions = ids({
                values: expression.call_functions,
                mapping: functions
            })

            current.symbols = current.symbols.push(ownSymbols({
                source: symbol,
                types: symbol_types,
                names: copyNames(symbol.names)
            }))[0]

            current.expressions = current.expressions.push(ownExpressions({
                source: expression,
                types: expression_types,
                call_functions,
                strings: copyNames(expression.strings)
            }))[0]

            current.index += 1
        },
        return: state => ({
            kinds: source.kinds.slice(),
            predicates: source.predicates.slice(),
            span_start: source.span_start.slice(),
            span_end: source.span_end.slice(),
            symbols: state.symbols,
            expressions: state.expressions
        })
    })
}
