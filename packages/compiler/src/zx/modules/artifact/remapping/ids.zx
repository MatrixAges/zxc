import integers from "std:integer"

import { first_invalid_id } from "./const"
import { Kind } from "./model"

import type { Mapping } from "./model"

export type Input = {
    values: u32[],
    mapping: Mapping
}

export type Output = u32[]

export default function (in: Input): Output {
    const { values, mapping } = in

    return match mapping.kind {
        Kind.Dense => values.map(id => mapping.dense[integers.widen(id)])[0],
        Kind.Sparse => values.map(
            id => {
                const target = mapping.sparse[integers.widen(id)]
                const value = target == null ? first_invalid_id : integers.widen(target)

                return integers.narrow(value)
            }
        )[0],
        Kind.Planned => values.map(
            id => {
                const target = mapping.planned[integers.widen(id)]
                const value = target == 0 ? first_invalid_id : target - 1

                return integers.narrow(value)
            }
        )[0],
        _ => values.map(
            id => {
                const offset = integers.widen(id)
                const value = match {
                    offset >= mapping.count => first_invalid_id,
                    offset < mapping.prefix => offset,
                    _ => mapping.first + (offset - mapping.prefix)
                }

                return integers.narrow(value)
            }
        )[0]
    }
}
