<Module>
    <Type from="model" as="Model" />

    <Args in={Model.ExternalInput} out={Model.Result} />

    <Call module="../../frontend/parser/program" in={$in.bytes} />

    <Call fn="declaration_only" in={$ctx.program} />

    <If on={$ctx.declaration_only}>
        <Call
            module="signature"
            in={{
                input: $in,
                syntax: $ctx.program
            }}
        />

        <Call
            module="implementation"
            in={{
                input: $in,
                analysis: $ctx.signature
            }}
        />

        <Call fn="publish" in={$ctx.implementation} />

        <Return value={$ctx.publish} />

        <Else>
            <Call fn="failure" in={$in.span} />

            <Return value={$ctx.failure} />
        </Else>
    </If>
</Module>
