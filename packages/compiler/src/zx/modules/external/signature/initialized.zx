import type { Context } from "../../../analysis/semantic/resolving/model"
import type { Analysis, Resolution } from "../model"

export type Input = {
    context: Context,
    result: Resolution
}

export type Output = Analysis

export default function (in: Input): Output {
    return {
        types: {
            context: in.context,
            delta: match {
                in.result.publish => in.result.delta,
                _ => {
                    kinds: [],
                    first: [],
                    second: [],
                    labels: [],
                    children: [],
                    field_types: [],
                    field_names: [],
                    names: []
                }
            },
            cache: match {
                in.result.publish => in.result.cache,
                _ => {
                    names: [],
                    ids: []
                }
            },
            nominal_delta: match {
                in.result.publish => in.result.origins,
                _ => {
                    ids: [],
                    kinds: [],
                    owners: [],
                    members: []
                }
            }
        },
        publish: in.result.publish,
        input_type: 0,
        output_type: 0,
        members: [],
        diagnostic: in.result.diagnostic
    }
}
