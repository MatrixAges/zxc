<Module>
    <Type from="model" as="Model" />

    <Args
        in={{
            analysis: Model.Analysis,
            input: Model.ExternalInput
        }}
        out={Model.Analysis}
    />

    <If on={$in.analysis.diagnostic.message == ""}>
        <Call
            fn="implementation/tuple"
            in={{
                tables: {
                    base: $in.analysis.types.context.base,
                    delta: $in.analysis.types.delta
                },
                input_type: $in.analysis.input_type,
                expand_tuple: $in.input.expand_tuple,
                span: $in.input.span
            }}
        />

        <If on={$ctx.tuple.message == ""}>
            <Call
                fn="implementation/errors"
                in={$in.input.pick([
                    "errors",
                    "fallible",
                    "span"
                ])}
            />

            <If on={$ctx.errors.message == ""}>
                <Call
                    fn="implementation/members"
                    in={{
                        member: $in.input.member,
                        span: $in.input.span
                    }}
                />

                <Return
                    value={{
                        ...$in.analysis,
                        members: $ctx.members.members,
                        diagnostic: $ctx.members.diagnostic
                    }}
                />

                <Else>
                    <Return
                        value={{
                            ...$in.analysis,
                            diagnostic: $ctx.errors
                        }}
                    />
                </Else>
            </If>

            <Else>
                <Return
                    value={{
                        ...$in.analysis,
                        diagnostic: $ctx.tuple
                    }}
                />
            </Else>
        </If>

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
