import type { Table } from "core/type_table/model"
import type { Bindings, Origin } from "core/type_table/nominal"
import type { Types } from "../../analysis/analyzer/types/model"
import type { Cache, Diagnostic } from "../../analysis/semantic/resolving/model"
import type { Span } from "../../frontend/lexer/token_model"

export type ExternalInput = {
    bytes: u8[]
    type_base: Table
    nominal_base: Bindings
    nominal_origin: Origin
    span: Span
    expand_tuple: bool
    fallible: bool
    errors: string[]?
        member: u8[]
}

export type Analysis = { types: Types, publish: bool, input_type: u32, output_type: u32, members: Span[], diagnostic: Diagnostic }

export type Resolution = { delta: Table, cache: Cache, id: u32, diagnostic: Diagnostic, origins: Bindings, publish: bool }

export type Result = { type_delta: Table, nominal_delta: Bindings, publish: bool, input_type: u32, output_type: u32, members: Span[], diagnostic: Diagnostic }
