import type { Program as Input } from "../../frontend/parser/syntax/model"

export type Output = bool

export default function (in: Input): Output {
    const no_diagnostic = in.diagnostic.message == ""

    const no_declarations = (
        - in.imports.length == 0
        - and in.constants.length == 0
    )

    const condition = (
        - no_diagnostic
        - and in.body == null
        - and no_declarations
    )

    return condition
}
