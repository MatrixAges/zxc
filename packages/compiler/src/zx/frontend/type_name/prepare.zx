import encoding from "std:encoding"

export type Input = string

export type Output = {
    bytes: u8[],
    has_trivia: bool
}

export default function (in: Input): Output {
    const bytes = encoding.encodeUtf8(in)

    const has_trivia = bytes.some(
        byte => (
            match byte {
                32 => true,
                9 => true,
                10 => true,
                13 => true,
                47 => true,
                _ => false
            }
        )
    )

    return {
        bytes,
        has_trivia: has_trivia
    }
}
