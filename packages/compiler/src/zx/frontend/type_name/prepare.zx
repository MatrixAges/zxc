import encoding from "std:encoding"

export type Input = string

export type Output = {
    bytes: u8[],
    has_trivia: bool
}

export default function (in: Input): Output {
    const bytes = encoding.encodeUtf8(in)

    return bytes.some(
        byte => (
            - byte == 32
            - or byte == 9
            - or byte == 10
            - or byte == 13
            - or byte == 47
        )
    )
        -> {
            bytes,
            has_trivia: _
        }
}
