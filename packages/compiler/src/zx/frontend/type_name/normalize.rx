<Module>
    <Args in={string} out={string} />

    <Call fn="prepare" in={$in} />

    <If on={!$ctx.prepare.has_trivia}>
        <Return value={$in} />

        <Else>
            <Call module="../lexer/scan" in={$ctx.prepare.bytes} />

            <Call
                fn="compact"
                in={{
                    source: $in,
                    lexed: $ctx.scan
                }}
            />

            <Return value={$ctx.compact} />
        </Else>
    </If>
</Module>
