<Module>
    <Type from="types/model" as="Model" />

    <Args
        in={{
            depth: u64,
            source: u8[],
            start: u64
        }}
        out={Model.State}
    />

    <Call module="../lexical" in={$in.source} />

    <If on={$ctx.lexical.lexed.diagnostic.message == ""}>
        <Call
            fn="types/parse"
            in={{
                tokens: $ctx.lexical.lexed.tokens,
                start: $in.start,
                depth: $in.depth
            }}
        />

        <Return value={$ctx.parse} />

        <Else>
            <Call
                fn="types/lexical_failure"
                in={{
                    start: $in.start,
                    depth: $in.depth,
                    diagnostic: $ctx.lexical.lexed.diagnostic
                }}
            />

            <Return value={$ctx.lexical_failure} />
        </Else>
    </If>
</Module>
