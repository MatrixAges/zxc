<Module>
  <Call module="../lexical" in={$in.source} />

  <Switch on={$ctx.lexical.lexed.diagnostic.message == ""}>
    <Case value={true}>
      <Call fn="types/parse" in={{tokens: $ctx.lexical.lexed.tokens, start: $in.start, depth: $in.depth}} />

      <Return value={$ctx.parse} />
    </Case>

    <Default>
      <Call fn="types/lexical_failure" in={{start: $in.start, depth: $in.depth, diagnostic: $ctx.lexical.lexed.diagnostic}} />

      <Return value={$ctx.lexical_failure} />
    </Default>
  </Switch>
</Module>
