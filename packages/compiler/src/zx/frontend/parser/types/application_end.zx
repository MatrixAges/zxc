import { Symbol } from "../../lexer/token_model"
import addNode from "./add_node"
import consume from "./consume"
import copyFrame from "./copy_frame"
import fail from "./fail"
import { TypeKind, Phase } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.control.token.symbol != Symbol.Greater) {
        return fail({
            state: in,
            code: "syntax",
            message: "expected >"
        })
    }

    const frame = copyFrame(in.frames[in.frames.length - 1])
    const child = in.control.result

    return in.frames.pop()[0]
        -> {
            tree: in.tree,
            frames: _,
            control: in.control
        }
        -> addNode({
            state: _,
            kind: TypeKind.Application,
            name: frame.name,
            child,
            head: 0,
            count: 0
        })
        -> consume({
            state: _,
            phase: Phase.Suffix
        })
}
