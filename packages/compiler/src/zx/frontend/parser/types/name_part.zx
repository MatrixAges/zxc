import { max_nesting_depth } from "core/const"

import { Kind } from "../../lexer/token_model"
import consume from "./consume"
import fail from "./fail"
import { Phase } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.control.token.kind != Kind.Identifier) {
        return fail({
            state: in,
            code: "syntax",
            message: "expected an identifier after ."
        })
    }

    if (in.control.depth + in.frames.length >= max_nesting_depth) {
        return fail({
            state: in,
            code: "unsupported",
            message: "syntax nesting exceeds 256 levels"
        })
    }

    const name = {
        start: in.control.name.start,
        end: in.control.token.span.end
    }

    return consume({
        state: {
            tree: in.tree,
            frames: in.frames,
            control: {
                ...in.control,
                name
            }
        },
        phase: Phase.Name
    })
}
