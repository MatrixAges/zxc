import { Symbol } from "../../lexer/token_model"
import close from "./close"
import consume from "./consume"
import fail from "./fail"
import field from "./field"
import { Phase } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.control.token.symbol == Symbol.Comma) {
        return consume({
            state: in,
            phase: Phase.Field
        })
    }

    if (in.control.token.symbol == Symbol.CloseBrace) {
        return close(in)
    }

    if (in.control.token.line_break) {
        return {
            tree: in.tree,
            frames: in.frames,
            control: {
                ...in.control,
                phase: Phase.Field
            }
        }
            -> field(_)
    }

    return fail({
        state: in,
        code: "syntax",
        message: "expected a comma or newline between type fields"
    })
}
