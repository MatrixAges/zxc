import { Symbol } from "../../lexer/token_model"
import addNode from "./add_node"
import complete from "./complete"
import consume from "./consume"
import fail from "./fail"
import { TypeKind, Phase } from "./model"
import open from "./open"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.control.phase == Phase.Name && in.control.token.symbol == Symbol.Dot) {
        return consume({
            state: in,
            phase: Phase.NamePart
        })
    }

    if (in.control.phase == Phase.ListEnd) {
        if (in.control.token.symbol != Symbol.CloseBracket) {
            return fail({
                state: in,
                code: "syntax",
                message: "expected ]"
            })
        }

        return in.control.result
            -> addNode({
                state: in,
                kind: TypeKind.List,
                name: {
                    start: 0,
                    end: 0
                },
                child: _,
                head: 0,
                count: 0
            })
            -> consume({
                state: _,
                phase: Phase.Suffix
            })
    }

    if (in.control.phase == Phase.Name && in.control.token.symbol == Symbol.Less) {
        return {
            start: in.control.name.start,
            end: in.control.name.end
        }
            -> open({
                state: in,
                kind: TypeKind.Application,
                name: _,
                phase: Phase.Start
            })
    }

    const named = in.control.phase == Phase.Name

    const state = {
        start: in.control.name.start,
        end: in.control.name.end
    }
        -> (named ? addNode({
            state: in,
            kind: TypeKind.Named,
            name: _,
            child: 0,
            head: 0,
            count: 0
        }) : in)

    if (state.control.token.symbol == Symbol.Question) {
        return state.control.result
            -> addNode({
                state,
                kind: TypeKind.Optional,
                name: {
                    start: 0,
                    end: 0
                },
                child: _,
                head: 0,
                count: 0
            })
            -> consume({
                state: _,
                phase: Phase.Suffix
            })
    }

    if (state.control.token.symbol == Symbol.OpenBracket) {
        return consume({
            state,
            phase: Phase.ListEnd
        })
    }

    return complete(state)
}
