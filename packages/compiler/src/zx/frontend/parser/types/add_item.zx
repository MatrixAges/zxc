import copyFrame from "./copy_frame"
import replaceFrame from "./replace_frame"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const frame = copyFrame(in.frames[in.frames.length - 1])
    const head = in.tree.items.length + 1
    const count = frame.count + 1

    return in.tree.items.push({
        value: in.control.result,
        previous: frame.head
    })[0]
        -> {
            tree: {
                nodes: in.tree.nodes,
                fields: in.tree.fields,
                items: _
            },
            frames: in.frames,
            control: in.control
        }
        -> replaceFrame({
            state: _,
            frame: {
                ...frame,
                head,
                count
            }
        })
}
