import { reduce } from "std:utils"

import initial from "./initial"
import step from "./step"

import type { Token } from "../../lexer/token_model"
import type { State } from "./model"

export type Input = {
    tokens: Token[],
    start: u64,
    depth: u64
}

export type Output = State

export default function (in: Input): Output {
    return initial({
        start: in.start,
        depth: in.depth
    })
        -> reduce(in.tokens, (state, token) => step({
            state: state,
            token: {
                kind: token.kind,
                word: token.word,
                symbol: token.symbol,
                span: {
                    start: token.span.start,
                    end: token.span.end
                },
                line_break: token.line_break,
                dollar: token.dollar
            }
        }), _)
}
