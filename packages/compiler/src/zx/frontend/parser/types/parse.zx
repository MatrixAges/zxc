import initial from "./initial"
import step from "./step"

import type { Token } from "../../lexer/token_model"
import type { State } from "./model"

export type Input = {
    tokens: Token[],
    start: u64,
    depth: u64
}

export type Output = State

export default function (in: Input): Output {
    const return_input = initial({
        start: in.start,
        depth: in.depth
    })

    return in.tokens.reduce((state, token) => step({
        state,
        token: {
            kind: token.kind,
            word: token.word,
            symbol: token.symbol,
            span: {
                start: token.span.start,
                end: token.span.end
            },
            line_break: token.line_break,
            dollar: token.dollar
        }
    }), return_input)[1]
}
