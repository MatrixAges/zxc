import { TypeKind } from "./model"

import type { Span } from "../../lexer/token_model"
import type { State } from "./model"

export type Input = {
    state: State,
    kind: TypeKind,
    name: Span,
    child: u64,
    head: u64,
    count: u64
}

export type Output = State

export default function (in: Input): Output {
    const result = in.state.tree.nodes.length

    return in.state.tree.nodes.push({
        kind: in.kind,
        name: in.name,
        child: in.child,
        head: in.head,
        count: in.count
    })[0]
        -> {
            tree: {
                nodes: _,
                fields: in.state.tree.fields,
                items: in.state.tree.items
            },
            frames: in.state.frames,
            control: {
                ...in.state.control,
                result
            }
        }
}
