import { max_nesting_depth } from "core/const"

import { Kind, Symbol } from "../../lexer/token_model"
import close from "./close"
import consume from "./consume"
import fail from "./fail"
import { TypeKind, Phase } from "./model"
import open from "./open"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (
        in.control.phase == Phase.TupleItem &&
            in.control.token.symbol == Symbol.CloseBracket
    ) {
        return close(in)
    }

    if (in.control.depth + in.frames.length >= max_nesting_depth) {
        return fail({
            state: in,
            code: "unsupported",
            message: "syntax nesting exceeds 256 levels"
        })
    }

    if (in.control.token.symbol == Symbol.OpenBrace) {
        return open({
            state: in,
            kind: TypeKind.Object,
            name: {
                start: 0,
                end: 0
            },
            phase: Phase.Field
        })
    }

    if (in.control.token.symbol == Symbol.OpenBracket) {
        return open({
            state: in,
            kind: TypeKind.Tuple,
            name: {
                start: 0,
                end: 0
            },
            phase: Phase.TupleItem
        })
    }

    if (in.control.token.kind != Kind.Identifier) {
        return fail({
            state: in,
            code: "syntax",
            message: "expected an identifier"
        })
    }

    return {
        start: in.control.token.span.start,
        end: in.control.token.span.end
    }
        -> {
            tree: in.tree,
            frames: in.frames,
            control: {
                ...in.control,
                name: _
            }
        }
        -> consume({
            state: _,
            phase: Phase.Name
        })
}
