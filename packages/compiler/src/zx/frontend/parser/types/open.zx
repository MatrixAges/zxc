import consume from "./consume"
import { TypeKind, Phase } from "./model"

import type { Span } from "../../lexer/token_model"
import type { State } from "./model"

export type Input = {
    state: State,
    kind: TypeKind,
    name: Span,
    phase: Phase
}

export type Output = State

export default function (in: Input): Output {
    return {
        kind: in.kind,
        name: in.name,
        field: {
            start: 0,
            end: 0
        },
        optional: false,
        head: 0,
        count: 0
    }
        -> in.state.frames.push(_)[0]
        -> {
            tree: in.state.tree,
            frames: _,
            control: in.state.control
        }
        -> consume({
            state: _,
            phase: in.phase
        })
}
