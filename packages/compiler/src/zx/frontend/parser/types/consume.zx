import type { State } from "./model.zx"
import { Phase } from "./model.zx"

export type Input = { state: State, phase: Phase }

export type Output = State

export default function (in: owned Input): Output {
  const index = in.state.control.index + 1

  return { tree: in.state.tree, frames: in.state.frames, control: { ...in.state.control, index: index, phase: in.phase } }
}
