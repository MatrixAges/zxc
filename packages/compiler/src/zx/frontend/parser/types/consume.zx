import { Phase } from "./model"

import type { State } from "./model"

export type Input = {
    state: State,
    phase: Phase
}

export type Output = State

export default function (in: Input): Output {
    return in.state.control.index + 1
        -> {
            tree: in.state.tree,
            frames: in.state.frames,
            control: {
                ...in.state.control,
                index: _,
                phase: in.phase
            }
        }
}
