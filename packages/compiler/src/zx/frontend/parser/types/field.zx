import { Kind, Symbol } from "../../lexer/token_model"
import close from "./close"
import consume from "./consume"
import copyFrame from "./copy_frame"
import fail from "./fail"
import { Phase } from "./model"
import replaceFrame from "./replace_frame"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (
        in.control.phase == Phase.FieldOptional &&
            in.control.token.symbol == Symbol.Question
    ) {
        return copyFrame(in.frames[in.frames.length - 1])
            -> replaceFrame({
                state: in,
                frame: {
                    ..._,
                    optional: true
                }
            })
            -> consume({
                state: _,
                phase: Phase.FieldColon
            })
    }

    if (
        in.control.phase == Phase.FieldOptional || in.control.phase == Phase.FieldColon
    ) {
        if (in.control.token.symbol != Symbol.Colon) {
            return fail({
                state: in,
                code: "syntax",
                message: "expected :"
            })
        }

        return consume({
            state: in,
            phase: Phase.Start
        })
    }

    if (in.control.token.symbol == Symbol.CloseBrace) {
        return close(in)
    }

    if (in.control.token.kind != Kind.Identifier) {
        return fail({
            state: in,
            code: "syntax",
            message: "expected an identifier"
        })
    }

    const frame = copyFrame(in.frames[in.frames.length - 1])

    return {
        start: in.control.token.span.start,
        end: in.control.token.span.end
    }
        -> replaceFrame({
            state: in,
            frame: {
                ...frame,
                field: _,
                optional: false
            }
        })
        -> consume({
            state: _,
            phase: Phase.FieldOptional
        })
}
