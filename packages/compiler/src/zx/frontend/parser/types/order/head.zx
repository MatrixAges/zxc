import { TypeKind } from "../model"

import type { Tree, Node } from "../model"

export type Input = {
    tree: Tree,
    node: Node
}

export type Output = u64

export default function (in: Input): Output {
    const items = in.node.kind == TypeKind.Tuple || in.node.kind == TypeKind.Selection

    if (in.node.kind != TypeKind.Object && !items) {
        return 0
    }

    return loop({
        tree: in.tree,
        kind: in.node.kind,
        current: in.node.head,
        first: 0,
        remaining: in.node.count
    }, {
        while: current => current.remaining != 0,
        next: current => {
            current.first = current.current
            current.current =
                match {
                    current.kind ==
                        TypeKind.Object =>
                        current.tree.fields[current.current - 1].previous,
                    _ => current.tree.items[current.current - 1].previous
                }
            current.remaining -= 1
        },
        return: state => state.first
    })
}
