import { PartKind } from "../../templates/model"
import emit from "../state/emit"
import frame from "../state/frame"
import { Phase, FrameKind, ExprKind } from "../state/model"
import node from "../state/node"
import takeFrame from "../state/take_frame"

import type { ExprState, ExprControl } from "../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    if (in.control.phase == Phase.TemplateGather) {
        const cursor = in.control.cursor
        const previous = in.prepared.lexical.parts[cursor - 1].previous

        const frames = {
            ...frame({
                kind: FrameKind.TemplatePart,
                start: 0,
                depth: 0
            }),
            cursor
        }
            -> in.frames.push(_)[0]

        return {
            ...in.control,
            cursor: previous,
            phase: previous == 0 ? Phase.TemplatePart : Phase.TemplateGather
        }
            -> {
                prepared: in.prepared,
                tree: in.tree,
                types: in.types,
                frames,
                control: _
            }
    }

    const taken = takeFrame(in)

    if (taken.frame.kind == FrameKind.Template) {
        const value = {
            ...node({
                kind: ExprKind.Template,
                start: taken.frame.start,
                end: taken.frame.end,
                depth: taken.state.control.template_maximum + 1
            }),
            head: taken.state.control.template_head,
            count: taken.state.control.template_count
        }

        const depth = taken.frame.depth
        const start = taken.frame.start
        const end = taken.frame.end
        const index = taken.frame.index
        const stream = taken.frame.stream
        const head = taken.frame.head
        const count = taken.frame.count

        return taken.frame.maximum
            -> {
                ...taken.state.control,
                depth,
                primary_start: start,
                last_end: end,
                index,
                stream,
                template_head: head,
                template_count: count,
                template_maximum: _,
                phase: Phase.Postfix
            }
            -> emit({
                state: {
                    prepared: taken.state.prepared,
                    tree: taken.state.tree,
                    types: taken.state.types,
                    frames: taken.state.frames,
                    control: _
                },
                node: value
            })
    }

    const cursor = taken.frame.cursor

    const expression =
        taken.state.prepared.lexical.parts[cursor - 1].kind == PartKind.Expression

    const start = taken.state.prepared.lexical.parts[cursor - 1].span.start
    const end = taken.state.prepared.lexical.parts[cursor - 1].span.end

    if (!expression) {
        const head = taken.state.tree.parts.length + 1
        const count = taken.state.control.template_count + 1

        const parts = taken.state.tree.parts.push({
            span: {
                start,
                end
            },
            value: 0,
            expression: false,
            previous: taken.state.control.template_head
        })[0]

        return {
            ...taken.state.control,
            template_head: head,
            template_count: count
        }
            -> {
                prepared: taken.state.prepared,
                tree: {
                    nodes: taken.state.tree.nodes,
                    items: taken.state.tree.items,
                    fields: taken.state.tree.fields,
                    parameters: taken.state.tree.parameters,
                    parts,
                    arms: taken.state.tree.arms
                },
                types: taken.state.types,
                frames: taken.state.frames,
                control: _
            }
    }

    const stream = taken.state.prepared.lexical.parts[cursor - 1].interpolation

    if (
        taken.state.prepared.lexical.interpolations[stream -
            1].lexed.diagnostic.message !=
            ""
    ) {
        return stream + 1
            -> {
                prepared: taken.state.prepared,
                tree: taken.state.tree,
                types: taken.state.types,
                frames: taken.state.frames,
                control: {
                    ...taken.state.control,
                    lexical_diagnostic: _,
                    phase: Phase.Done
                }
            }
    }

    const continuation = {
        ...frame({
            kind: FrameKind.Interpolation,
            start,
            depth: taken.state.control.depth
        }),
        cursor,
        stream: taken.state.control.stream,
        index: taken.state.control.index,
        end: taken.state.control.last_end
    }

    const depth = taken.state.control.depth + 1
    const frames = taken.state.frames.push(continuation)[0]

    const control: ExprControl = {
        ...taken.state.control,
        stream,
        index: 0,
        last_end: start,
        depth,
        minimum: 0,
        allow_lambda: true,
        fresh_family: true,
        phase: Phase.BeginBinary
    }

    return {
        prepared: taken.state.prepared,
        tree: taken.state.tree,
        types: taken.state.types,
        frames,
        control
    }
}
