import { Symbol } from "../../../lexer/token_model"
import consume from "../state/consume"
import emit from "../state/emit"
import fail from "../state/fail"
import { Phase, FrameKind, ExprKind } from "../state/model"
import node from "../state/node"
import finishBinary from "./finish_binary"
import groupReturn from "./group_return"

import type { ExprState, ExprControl, Return } from "../state/model"

export type Input = Return

export type Output = ExprState

export default function (in: Input): Output {
    const result = in.state.control.result
    const child_depth = in.state.tree.nodes[result].depth
    const start = in.frame.start
    const end = in.state.control.last_end

    if (in.frame.kind == FrameKind.Group) {
        return groupReturn(in)
    }

    const condition = (
        match in.frame.kind {
            FrameKind.Capture => true,
            FrameKind.Async => true,
            FrameKind.Await => true,
            FrameKind.Cancel => true,
            _ => false
        }
    )

    if (condition) {
        const kind = match in.frame.kind {
            FrameKind.Capture => ExprKind.Capture,
            FrameKind.Async => ExprKind.Async,
            FrameKind.Await => ExprKind.Await,
            _ => ExprKind.Cancel
        }

        const value = {
            ...node({
                kind: kind,
                start,
                end,
                depth: child_depth + 1
            }),
            first: result
        }

        const control = {
            ...in.state.control,
            depth: in.frame.depth - 1,
            phase: Phase.Returning
        }

        return emit({
            state: {
                prepared: in.state.prepared,
                tree: in.state.tree,
                types: in.state.types,
                frames: in.state.frames,
                control: control
            },
            node: value
        })
    }

    if (in.frame.kind == FrameKind.Unary || in.frame.kind == FrameKind.Lambda) {
        const lambda = in.frame.kind == FrameKind.Lambda
        const depth = in.frame.depth - 1

        const condition_terms = match {
            in.frame.kind == FrameKind.Unary && !in.frame.flag =>
                in.state.tree.nodes[result].condition_terms,
            _ => 1
        }

        const value = {
            ...node({
                kind: lambda ? ExprKind.Lambda : ExprKind.Unary,
                start,
                end,
                depth: child_depth + 1
            }),
            first: result,
            flag: in.frame.flag,
            head: in.frame.head,
            count: in.frame.count,
            condition_terms: condition_terms,
            condition_list: !lambda && !in.frame.flag &&
                in.state.tree.nodes[result].condition_list
        }

        const control = {
            ...in.state.control,
            depth,
            phase: Phase.Returning
        }

        return emit({
            state: {
                prepared: in.state.prepared,
                tree: in.state.tree,
                types: in.state.types,
                frames: in.state.frames,
                control: control
            },
            node: value
        })
    }

    if (in.frame.kind == FrameKind.Index) {
        if (in.state.control.token.symbol != Symbol.CloseBracket) {
            return fail({
                state: in.state,
                code: "syntax",
                message: "]"
            })
        }

        const target_depth = in.state.tree.nodes[in.frame.first].depth
        const depth = in.frame.depth

        const value = {
            ...node({
                kind: ExprKind.Index,
                start,
                end: in.state.control.token.span.end,
                depth: (target_depth > child_depth ? target_depth : child_depth) + 1
            }),
            first: in.frame.first,
            second: result
        }

        const control = {
            ...in.state.control,
            depth,
            primary_start: start
        }

        return emit({
            state: consume({
                state: {
                    prepared: in.state.prepared,
                    tree: in.state.tree,
                    types: in.state.types,
                    frames: in.state.frames,
                    control: control
                },
                phase: Phase.Postfix
            }),
            node: value
        })
    }

    if (in.frame.kind == FrameKind.ConditionalYes) {
        if (in.state.control.token.symbol != Symbol.Colon) {
            return fail({
                state: in.state,
                code: "syntax",
                message: ":"
            })
        }

        const allow_lambda = in.frame.allow_lambda

        const frames = in.state.frames.push({
            ...in.frame,
            kind: FrameKind.ConditionalNo,
            second: result
        })[0]

        const control: ExprControl = {
            ...in.state.control,
            minimum: 0,
            allow_lambda,
            fresh_family: true
        }

        return consume({
            state: {
                prepared: in.state.prepared,
                tree: in.state.tree,
                types: in.state.types,
                frames,
                control
            },
            phase: Phase.BeginBinary
        })
    }

    const condition_depth = in.state.tree.nodes[in.frame.first].depth
    const yes_depth = in.state.tree.nodes[in.frame.second].depth
    const branch_depth = yes_depth > child_depth ? yes_depth : child_depth

    const computed_value = {
        ...node({
            kind: ExprKind.Conditional,
            start: in.state.tree.nodes[in.frame.first].span.start,
            end,
            depth:
                (
                    condition_depth > branch_depth ? condition_depth : branch_depth
                ) + 1
        }),
        first: in.frame.first,
        second: in.frame.second,
        third: result
    }

    return finishBinary({
        state: emit({
            state: in.state,
            node: computed_value
        }),
        frame: in.frame
    })
}
