import { max_nesting_depth } from "core/const"

import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import consume from "../state/consume"
import fail from "../state/fail"
import frame from "../state/frame"
import { Phase, FrameKind } from "../state/model"
import startCondition from "./condition/start"
import literal from "./literal"
import startLambda from "./start_lambda"
import startTemplate from "./start_template"

import type { ExprState, ExprControl } from "../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    if (in.control.depth >= max_nesting_depth) {
        return fail({
            state: in,
            code: "unsupported",
            message: "syntax nesting exceeds 256 levels"
        })
    }

    if (in.control.token.symbol == Symbol.Minus && in.control.token.line_break) {
        const tokens = match {
            in.control.stream == 0 => in.prepared.lexical.lexed.tokens,
            _ => in.prepared.lexical.interpolations[in.control.stream - 1].lexed.tokens
        }

        const root_condition = in.control.allow_condition && in.frames.length == 1

        const grouped = in.frames.length > 1 &&
            in.frames[in.frames.length - 2].kind == FrameKind.Group

        const condition_context = root_condition || grouped

        const at_condition_start = (
            - in.control.minimum == 0
            - and condition_context
            - and in.control.index > 0
        )

        const condition = match {
            at_condition_start =>
                tokens[in.control.index - 1].symbol == Symbol.OpenParen,
            _ => false
        }

        if (condition) {
            return startCondition(in)
        }
    }

    const start = in.control.token.span.start
    const depth = in.control.depth + 1

    const state = {
        prepared: in.prepared,
        tree: in.tree,
        types: in.types,
        frames: in.frames,
        control: {
            ...in.control,
            depth,
            primary_start: start
        }
    }

    if (state.control.token.word == Keyword.Match) {
        const continuation = frame({
            kind: FrameKind.MatchSubject,
            start,
            depth
        })

        const frames = state.frames.push(continuation)[0]

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames: frames,
                control: state.control
            },
            phase: Phase.MatchStart
        })
    }

    const condition_2 = (
        match state.control.token.word {
            Keyword.Try => true,
            Keyword.Async => true,
            Keyword.Await => true,
            Keyword.Cancel => true,
            _ => false
        }
    )

    if (condition_2) {
        const kind = match state.control.token.word {
            Keyword.Try => FrameKind.Capture,
            Keyword.Async => FrameKind.Async,
            Keyword.Await => FrameKind.Await,
            _ => FrameKind.Cancel
        }

        const continuation = frame({
            kind: kind,
            start,
            depth
        })

        const frames = state.frames.push(continuation)[0]

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames: frames,
                control: state.control
            },
            phase: Phase.Primary
        })
    }

    if (
        state.control.token.symbol == Symbol.Not ||
            state.control.token.symbol == Symbol.Minus
    ) {
        const continuation = {
            ...frame({
                kind: FrameKind.Unary,
                start,
                depth
            }),
            flag: state.control.token.symbol == Symbol.Minus
        }

        const frames = state.frames.push(continuation)[0]

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames: frames,
                control: state.control
            },
            phase: Phase.Primary
        })
    }

    if (state.control.allow_lambda && state.control.hint.lambda) {
        return startLambda({
            state,
            updating: false
        })
    }

    if (state.control.token.symbol == Symbol.OpenParen) {
        const continuation = frame({
            kind: FrameKind.Group,
            start,
            depth
        })

        const frames = state.frames.push(continuation)[0]

        const control: ExprControl = {
            ...state.control,
            minimum: 0,
            allow_lambda: true,
            fresh_family: true
        }

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames,
                control
            },
            phase: Phase.BeginBinary
        })
    }

    if (
        state.control.token.symbol == Symbol.OpenBrace ||
            state.control.token.symbol == Symbol.OpenBracket
    ) {
        const object = state.control.token.symbol == Symbol.OpenBrace

        const continuation = {
            ...frame({
                kind: object ? FrameKind.ObjectValue : FrameKind.Arguments,
                start,
                depth
            }),
            flag: false
        }

        const frames = state.frames.push(continuation)[0]

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames: frames,
                control: state.control
            },
            phase: object ? Phase.ObjectName : Phase.Arguments
        })
    }

    if (state.control.token.kind == Kind.Template) {
        return startTemplate(state)
    }

    return literal(state)
}
