import { max_nesting_depth } from "core/const"

import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import consume from "../state/consume"
import emit from "../state/emit"
import fail from "../state/fail"
import frame from "../state/frame"
import { Phase, FrameKind, ExprKind } from "../state/model"
import node from "../state/node"
import startCondition from "./condition/start"
import startLambda from "./start_lambda"
import startTemplate from "./start_template"

import type { ExprState, ExprControl } from "../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    if (in.control.depth >= max_nesting_depth) {
        return fail({
            state: in,
            code: "unsupported",
            message: "syntax nesting exceeds 256 levels"
        })
    }

    if (in.control.token.symbol == Symbol.Minus && in.control.token.line_break) {
        const tokens = in.control.stream == 0 ? in.prepared.lexical.lexed.tokens :
            in.prepared.lexical.interpolations[in.control.stream - 1].lexed.tokens

        const root_condition = in.control.allow_condition && in.frames.length == 1

        const grouped = in.frames.length > 1 &&
            in.frames[in.frames.length - 2].kind == FrameKind.Group

        const condition = (
            - in.control.minimum == 0
            - and (root_condition || grouped)
            - and in.control.index > 0
            - and tokens[in.control.index - 1].symbol == Symbol.OpenParen
        )

        if (condition) {
            return startCondition(in)
        }
    }

    const start = in.control.token.span.start
    const end = in.control.token.span.end
    const depth = in.control.depth + 1

    const state = {
        prepared: in.prepared,
        tree: in.tree,
        types: in.types,
        frames: in.frames,
        control: {
            ...in.control,
            depth,
            primary_start: start
        }
    }

    if (state.control.token.word == Keyword.Match) {
        return frame({
            kind: FrameKind.MatchSubject,
            start,
            depth
        })
            -> state.frames.push(_)[0]
            -> consume({
                state: {
                    prepared: state.prepared,
                    tree: state.tree,
                    types: state.types,
                    frames: _,
                    control: state.control
                },
                phase: Phase.MatchStart
            })
    }

    const condition_2 = (
        - state.control.token.word == Keyword.Try
        - or state.control.token.word == Keyword.Async
        - or state.control.token.word == Keyword.Await
        - or state.control.token.word == Keyword.Cancel
    )

    if (condition_2) {
        return match state.control.token.word {
            Keyword.Try => FrameKind.Capture,
            Keyword.Async => FrameKind.Async,
            Keyword.Await => FrameKind.Await,
            _ => FrameKind.Cancel
        }
            -> frame({
                kind: _,
                start,
                depth
            })
            -> state.frames.push(_)[0]
            -> consume({
                state: {
                    prepared: state.prepared,
                    tree: state.tree,
                    types: state.types,
                    frames: _,
                    control: state.control
                },
                phase: Phase.Primary
            })
    }

    if (
        state.control.token.symbol == Symbol.Not ||
            state.control.token.symbol == Symbol.Minus
    ) {
        return {
            ...frame({
                kind: FrameKind.Unary,
                start,
                depth
            }),
            flag: state.control.token.symbol == Symbol.Minus
        }
            -> state.frames.push(_)[0]
            -> consume({
                state: {
                    prepared: state.prepared,
                    tree: state.tree,
                    types: state.types,
                    frames: _,
                    control: state.control
                },
                phase: Phase.Primary
            })
    }

    if (state.control.allow_lambda && state.control.hint.lambda) {
        return startLambda({
            state,
            updating: false
        })
    }

    if (state.control.token.symbol == Symbol.OpenParen) {
        const frames = frame({
            kind: FrameKind.Group,
            start,
            depth
        })
            -> state.frames.push(_)[0]

        const control: ExprControl = {
            ...state.control,
            minimum: 0,
            allow_lambda: true,
            fresh_family: true
        }

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames,
                control
            },
            phase: Phase.BeginBinary
        })
    }

    if (
        state.control.token.symbol == Symbol.OpenBrace ||
            state.control.token.symbol == Symbol.OpenBracket
    ) {
        const object = state.control.token.symbol == Symbol.OpenBrace

        return {
            ...frame({
                kind: object ? FrameKind.ObjectValue : FrameKind.Arguments,
                start,
                depth
            }),
            flag: false
        }
            -> state.frames.push(_)[0]
            -> consume({
                state: {
                    prepared: state.prepared,
                    tree: state.tree,
                    types: state.types,
                    frames: _,
                    control: state.control
                },
                phase: object ? Phase.ObjectName : Phase.Arguments
            })
    }

    if (state.control.token.kind == Kind.Template) {
        return startTemplate(state)
    }

    const null_value = state.control.token.word == Keyword.Null

    const boolean =
        state.control.token.word == Keyword.True ||
        state.control.token.word == Keyword.False

    const number = state.control.token.kind == Kind.Number
    const string = state.control.token.kind == Kind.String

    const condition_3 = (
        - !null_value
        - and !boolean
        - and !number
        - and !string
        - and state.control.token.kind != Kind.Identifier
    )

    if (condition_3) {
        return fail({
            state,
            code: "syntax",
            message: "expected an identifier"
        })
    }

    return match {
        null_value => ExprKind.Null,
        boolean => ExprKind.Boolean,
        number => ExprKind.Number,
        string => ExprKind.String,
        _ => ExprKind.Identifier
    }
        -> {
            ...node({
                kind: _,
                start,
                end,
                depth: 1
            }),
            name: {
                start,
                end
            },
            flag:
                state.control.token.word == Keyword.True ||
                state.control.token.word == Keyword.Loop
        }
        -> emit({
            state: consume({
                state,
                phase: Phase.Postfix
            }),
            node: _
        })
}
