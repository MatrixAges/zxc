import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import consume from "../state/consume"
import fail from "../state/fail"
import { Phase } from "../state/model"
import takeFrame from "../state/take_frame"

import type { ExprState, ExprControl } from "../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    if (in.control.phase == Phase.LambdaBody) {
        const has_body = in.control.token.symbol == Symbol.OpenBrace

        const tokens = match {
            in.control.stream == 0 => in.prepared.lexical.lexed.tokens,
            _ => in.prepared.lexical.interpolations[in.control.stream - 1].lexed.tokens
        }

        const next_index = in.control.index + 1

        const declarations = match {
            has_body && next_index < tokens.length =>
                tokens[next_index].word == Keyword.Const ||
                tokens[next_index].word == Keyword.Return,
            _ => false
        }

        const updating = in.frames[in.frames.length - 1].flag

        const block =
            in.control.token.symbol == Symbol.OpenBrace && (updating || declarations)

        return {
            ...in,
            control: {
                ...in.control,
                phase: block ? Phase.StateBlock : Phase.BeginBinary
            }
        }
    }

    if (in.control.phase == Phase.LambdaArrow) {
        if (in.control.token.symbol != Symbol.Arrow) {
            return fail({
                state: in,
                code: "syntax",
                message: "=>"
            })
        }

        const control: ExprControl = {
            ...in.control,
            minimum: 0,
            allow_lambda: true,
            fresh_family: true
        }

        return consume({
            state: {
                prepared: in.prepared,
                tree: in.tree,
                types: in.types,
                frames: in.frames,
                control
            },
            phase: Phase.LambdaBody
        })
    }

    if (in.control.token.symbol == Symbol.CloseParen) {
        return consume({
            state: in,
            phase: Phase.LambdaArrow
        })
    }

    if (in.control.phase == Phase.LambdaSeparator) {
        if (in.control.token.symbol != Symbol.Comma) {
            return fail({
                state: in,
                code: "syntax",
                message: ","
            })
        }

        return consume({
            state: in,
            phase: Phase.LambdaParameter
        })
    }

    if (in.control.token.kind != Kind.Identifier) {
        return fail({
            state: in,
            code: "syntax",
            message: "expected an identifier"
        })
    }

    const taken = takeFrame(in)
    const head = taken.state.tree.parameters.length + 1
    const count = taken.frame.count + 1

    const parameters = taken.state.tree.parameters.push({
        name: {
            start: taken.state.control.token.span.start,
            end: taken.state.control.token.span.end
        },
        previous: taken.frame.head
    })[0]

    const frames = taken.state.frames.push({
        ...taken.frame,
        head,
        count
    })[0]

    const tree = {
        nodes: taken.state.tree.nodes,
        items: taken.state.tree.items,
        fields: taken.state.tree.fields,
        parameters,
        parts: taken.state.tree.parts,
        arms: taken.state.tree.arms
    }

    return consume({
        state: {
            prepared: taken.state.prepared,
            tree: tree,
            types: taken.state.types,
            frames,
            control: taken.state.control
        },
        phase: Phase.LambdaSeparator
    })
}
