import { Kind, Symbol } from "../../../../lexer/token_model"

import type { Token } from "../../../../lexer/token_model"

export type Input = {
    tokens: Token[],
    start: u64
}

export type Output = u64

export default function (in: Input): Output {
    return loop({
        tokens: in.tokens,
        index: in.start,
        depth: 0,
        done: false
    }, {
        while: state => !state.done && state.index < state.tokens.length,
        next: state => {
            const token = state.tokens[state.index]
            const closing = match token.symbol {
                Symbol.CloseParen => true,
                Symbol.CloseBracket => true,
                Symbol.CloseBrace => true,
                _ => false
            }

            const bullet = token.symbol == Symbol.Minus && token.line_break
            const root_boundary = state.depth == 0 && (closing || bullet)
            const condition = token.kind == Kind.Eof || root_boundary

            if (condition) {
                state.done = true
            } else {
                if (closing) {
                    state.depth -= 1
                }

                const opening = match token.symbol {
                    Symbol.OpenParen => true,
                    Symbol.OpenBracket => true,
                    Symbol.OpenBrace => true,
                    _ => false
                }

                if (opening) {
                    state.depth += 1
                }

                state.index += 1
            }
        },
        return: state => state.index
    })
}
