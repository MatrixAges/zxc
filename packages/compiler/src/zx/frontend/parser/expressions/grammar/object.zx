import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import consume from "../state/consume"
import emit from "../state/emit"
import fail from "../state/fail"
import { Phase, FrameKind, ExprKind } from "../state/model"
import node from "../state/node"
import takeFrame from "../state/take_frame"
import finish from "./object_finish"
import complete from "./object_return"

import type { ExprState, ExprControl } from "../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    const taken = takeFrame(in)

    if (taken.state.control.phase == Phase.ObjectColon) {
        if (taken.state.control.token.symbol == Symbol.Colon) {
            const phase = taken.frame.callback ? Phase.Callback : Phase.BeginBinary
            const frames = taken.state.frames.push(taken.frame)[0]

            const control: ExprControl = {
                ...taken.state.control,
                minimum: 0,
                allow_lambda: true,
                fresh_family: true
            }

            return consume({
                state: {
                    prepared: taken.state.prepared,
                    tree: taken.state.tree,
                    types: taken.state.types,
                    frames,
                    control
                },
                phase
            })
        }

        if (taken.frame.condition) {
            return fail({
                state: taken.state,
                code: "syntax",
                message: ":"
            })
        }

        return {
            ...node({
                kind: ExprKind.Identifier,
                start: taken.frame.name.start,
                end: taken.frame.name.end,
                depth: 1
            }),
            name: {
                start: taken.frame.name.start,
                end: taken.frame.name.end
            }
        }
            -> complete({
                state: emit({
                    state: taken.state,
                    node: _
                }),
                frame: taken.frame
            })
    }

    if (taken.state.control.token.symbol == Symbol.CloseBrace) {
        return finish(taken)
    }

    if (taken.state.control.token.symbol == Symbol.Spread) {
        const frames = taken.state.frames.push({
            ...taken.frame,
            flag: true
        })[0]

        const control: ExprControl = {
            ...taken.state.control,
            minimum: 0,
            allow_lambda: true,
            fresh_family: true
        }

        return consume({
            state: {
                prepared: taken.state.prepared,
                tree: taken.state.tree,
                types: taken.state.types,
                frames,
                control
            },
            phase: Phase.BeginBinary
        })
    }

    const options = taken.frame.kind == FrameKind.OptionsValue

    const condition = options && (
        taken.state.control.token.word == Keyword.While ||
            taken.state.control.token.word == Keyword.Return
    )

    const callback =
        options &&
        (
            taken.state.control.token.word == Keyword.Next ||
                taken.state.control.token.word == Keyword.Do
        )

    if (taken.state.control.token.kind != Kind.Identifier && !condition) {
        return fail({
            state: taken.state,
            code: "syntax",
            message: "expected an identifier"
        })
    }

    return {
        start: taken.state.control.token.span.start,
        end: taken.state.control.token.span.end
    }
        -> taken.state.frames.push({
            ...taken.frame,
            name: _,
            flag: false,
            callback,
            condition
        })[0]
        -> consume({
            state: {
                prepared: taken.state.prepared,
                tree: taken.state.tree,
                types: taken.state.types,
                frames: _,
                control: taken.state.control
            },
            phase: Phase.ObjectColon
        })
}
