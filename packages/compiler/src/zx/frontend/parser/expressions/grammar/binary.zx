import { Symbol } from "../../../lexer/token_model"
import { Operator, Family } from "../prepare/model"
import consume from "../state/consume"
import emit from "../state/emit"
import fail from "../state/fail"
import { Phase, FrameKind, ExprKind } from "../state/model"
import node from "../state/node"
import { term_limit } from "./condition/const"
import finishBinary from "./finish_binary"

import type { ExprState, ExprFrame, ExprControl } from "../state/model"

export type Input = {
    state: ExprState,
    frame: ExprFrame
}

export type Output = ExprState

export default function (in: Input): Output {
    const left = match {
        in.frame.kind == FrameKind.BinaryRight => in.frame.first,
        _ => in.state.control.result
    }

    const right = in.state.control.result
    const left_depth = in.state.tree.nodes[left].depth
    const right_depth = in.state.tree.nodes[right].depth
    const start = in.state.tree.nodes[left].span.start
    const end = in.state.control.last_end
    const depth = (left_depth > right_depth ? left_depth : right_depth) + 1

    const total = in.state.tree.nodes[left].condition_terms +
        in.state.tree.nodes[right].condition_terms

    const terms = total > term_limit ? term_limit : total

    const logical = in.frame.operator == Operator.And || in.frame.operator == Operator.Or

    const condition_terms =
        match {
            in.frame.operator == Operator.Pipeline =>
                in.state.tree.nodes[right].condition_terms,
            (logical) => terms,
            _ => 1
        }

    const kind = match {
        in.frame.operator == Operator.Pipeline => ExprKind.Pipeline,
        _ => ExprKind.Binary
    }

    const state = match {
        in.frame.kind == FrameKind.BinaryRight => emit({
            state: in.state,
            node: {
                ...node({
                    kind: kind,
                    start,
                    end,
                    depth
                }),
                first: left,
                second: right,
                operator: in.frame.operator,
                condition_terms,
                condition_list: in.frame.operator == Operator.Pipeline &&
                    in.state.tree.nodes[right].condition_list
            }
        }),
        _ => in.state
    }

    if (state.control.phase == Phase.Done) {
        return state
    }

    const control = state.control
    const binary = control.hint.binary
    const boundary = control.index == control.boundary
    const same_stream = control.stream == control.boundary_stream
    const at_boundary = boundary && same_stream
    const available = binary.operator != Operator.None
    const precedence = binary.precedence
    const minimum = in.frame.minimum

    const condition = (
        - !at_boundary
        - and available
        - and precedence >= minimum
    )

    if (condition) {
        const next_family = state.control.hint.binary.family
        const current_family = state.control.family

        const condition_2 = (
            - next_family != Family.None
            - and current_family != Family.None
            - and next_family != current_family
        )

        if (condition_2) {
            return fail({
                state,
                code: "syntax",
                message: "?? cannot be mixed with && or || without parentheses"
            })
        }

        const family = match {
            state.control.hint.binary.operator == Operator.Pipeline => Family.None,
            next_family == Family.None => state.control.family,
            _ => next_family
        }

        const minimum: u8 = state.control.hint.binary.precedence + 1
        const allow_lambda = in.frame.allow_lambda

        const continuation = {
            ...in.frame,
            kind: FrameKind.BinaryRight,
            first: state.control.result,
            operator: state.control.hint.binary.operator
        }

        const frames = state.frames.push(continuation)[0]

        const control = {
            ...state.control,
            minimum,
            allow_lambda,
            fresh_family: false,
            family
        }

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames,
                control: control
            },
            phase: Phase.BeginBinary
        })
    }

    if (in.frame.minimum == 0 && state.control.token.symbol == Symbol.Question) {
        const allow_lambda = in.frame.allow_lambda

        const continuation = {
            ...in.frame,
            kind: FrameKind.ConditionalYes,
            first: state.control.result
        }

        const frames = state.frames.push(continuation)[0]

        const control: ExprControl = {
            ...state.control,
            minimum: 0,
            allow_lambda,
            fresh_family: true
        }

        return consume({
            state: {
                prepared: state.prepared,
                tree: state.tree,
                types: state.types,
                frames,
                control
            },
            phase: Phase.BeginBinary
        })
    }

    return finishBinary({
        state,
        frame: in.frame
    })
}
