import type { ExprState } from "../state/model"
import { Phase, FrameKind } from "../state/model"
import { Symbol } from "../../../lexer/token_model"
import frame from "../state/frame"
import consume from "../state/consume"

export type Input = ExprState

export type Output = ExprState

export default function (in: owned Input): Output {
  const parenthesized = in.control.token.symbol == Symbol.OpenParen
  const start = in.control.token.span.start
  const end = in.control.token.span.end
  const continuation = frame({ kind: FrameKind.Lambda, start: start, depth: in.control.depth })

  if (parenthesized) {
    const frames = in.frames.push(continuation)[0]

    return consume({ state: { prepared: in.prepared, tree: in.tree, types: in.types, frames: frames, control: in.control }, phase: Phase.LambdaParameter })
  }

  const head = in.tree.parameters.length + 1
  const parameters = in.tree.parameters.push({ name: { start: start, end: end }, previous: 0 })[0]
  const frames = in.frames.push({ ...continuation, head: head, count: 1 })[0]
  const tree = { nodes: in.tree.nodes, items: in.tree.items, fields: in.tree.fields, parameters: parameters, parts: in.tree.parts, arms: in.tree.arms }

  return consume({ state: { prepared: in.prepared, tree: tree, types: in.types, frames: frames, control: in.control }, phase: Phase.LambdaArrow })
}
