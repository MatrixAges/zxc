import { Symbol } from "../../../lexer/token_model"
import consume from "../state/consume"
import frame from "../state/frame"
import { Phase, FrameKind } from "../state/model"

import type { ExprState } from "../state/model"

export type Input = {
    state: ExprState,
    updating: bool
}

export type Output = ExprState

export default function (in: Input): Output {
    const parenthesized = in.state.control.token.symbol == Symbol.OpenParen
    const start = in.state.control.token.span.start
    const end = in.state.control.token.span.end

    const continuation = {
        ...frame({
            kind: FrameKind.Lambda,
            start,
            depth: in.state.control.depth + (in.updating ? 1 : 0)
        }),
        flag: in.updating
    }

    if (parenthesized) {
        return in.state.frames.push(continuation)[0]
            -> consume({
                state: {
                    prepared: in.state.prepared,
                    tree: in.state.tree,
                    types: in.state.types,
                    frames: _,
                    control: in.state.control
                },
                phase: Phase.LambdaParameter
            })
    }

    const head = in.state.tree.parameters.length + 1

    const parameters = in.state.tree.parameters.push({
        name: {
            start,
            end
        },
        previous: 0
    })[0]

    const frames = in.state.frames.push({
        ...continuation,
        head,
        count: 1
    })[0]

    return {
        nodes: in.state.tree.nodes,
        items: in.state.tree.items,
        fields: in.state.tree.fields,
        parameters,
        parts: in.state.tree.parts,
        arms: in.state.tree.arms
    }
        -> consume({
            state: {
                prepared: in.state.prepared,
                tree: _,
                types: in.state.types,
                frames,
                control: in.state.control
            },
            phase: Phase.LambdaArrow
        })
}
