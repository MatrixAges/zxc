import { Connector } from "../../prepare/model"
import consume from "../../state/consume"
import frame from "../../state/frame"
import { Phase, FrameKind } from "../../state/model"
import boundary from "./boundary"

import type { ExprState } from "../../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    const tokens = match {
        in.control.stream == 0 => in.prepared.lexical.lexed.tokens,
        _ => in.prepared.lexical.interpolations[in.control.stream -
            1].lexed.tokens
    }

    const start = in.control.index + 1

    const pending = {
        ...frame({
            kind: FrameKind.Condition,
            start: in.control.token.span.start,
            depth: in.control.depth
        }),
        maximum: in.control.boundary,
        cursor: in.control.boundary_stream,
        stream: in.control.stream,
        count: 0,
        connector: Connector.None,
        condition: false
    }

    return consume({
        state: {
            ...in,
            frames: in.frames.push(pending)[0],
            control: {
                ...in.control,
                boundary: boundary({
                    tokens,
                    start
                }),
                boundary_stream: in.control.stream,
                minimum: 0,
                fresh_family: true
            }
        },
        phase: Phase.BeginBinary
    })
}
