import { Kind, Symbol } from "../../../lexer/token_model"
import typeInitial from "../../types/initial"
import consume from "../state/consume"
import emit from "../state/emit"
import fail from "../state/fail"
import frame from "../state/frame"
import { Phase, FrameKind, ExprKind } from "../state/model"
import node from "../state/node"
import resume from "./resume"
import startArguments from "./start_arguments"

import type { ExprState, ExprControl } from "../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    if (in.control.phase == Phase.FieldName) {
        if (in.control.token.kind != Kind.Identifier) {
            return fail({
                state: in,
                code: "syntax",
                message: "expected an identifier"
            })
        }

        return {
            ...node({
                kind: ExprKind.Field,
                start: in.control.primary_start,
                end: in.control.token.span.end,
                depth: in.tree.nodes[in.control.result].depth + 1
            }),
            first: in.control.result,
            name: {
                start: in.control.token.span.start,
                end: in.control.token.span.end
            },
            flag: in.control.hint.generic
        }
            -> emit({
                state: consume({
                    state: in,
                    phase: Phase.Postfix
                }),
                node: _
            })
    }

    if (in.control.token.symbol == Symbol.Dot) {
        return consume({
            state: in,
            phase: Phase.FieldName
        })
    }

    if (in.control.token.symbol == Symbol.OpenBracket) {
        const frames = {
            ...frame({
                kind: FrameKind.Index,
                start: in.control.primary_start,
                depth: in.control.depth
            }),
            first: in.control.result
        }
            -> in.frames.push(_)[0]

        const control: ExprControl = {
            ...in.control,
            minimum: 0,
            allow_lambda: true,
            fresh_family: true
        }

        return consume({
            state: {
                prepared: in.prepared,
                tree: in.tree,
                types: in.types,
                frames,
                control
            },
            phase: Phase.BeginBinary
        })
    }

    const condition = (
        - in.control.token.symbol == Symbol.Less
        - and in.tree.nodes[in.control.result].kind == ExprKind.Field
        - and in.tree.nodes[in.control.result].flag
    )

    if (condition) {
        const index = in.control.index + 1

        const initial = typeInitial({
            start: index,
            depth: in.control.depth
        })

        return {
            tree: in.types.tree,
            frames: initial.frames,
            control: {
                ...initial.control,
                index
            }
        }
            -> consume({
                state: {
                    prepared: in.prepared,
                    tree: in.tree,
                    types: _,
                    frames: in.frames,
                    control: in.control
                },
                phase: Phase.GenericType
            })
    }

    if (in.control.token.symbol == Symbol.OpenParen) {
        return startArguments({
            state: in,
            type_argument: 0
        })
    }

    return in.control.depth - 1
        -> resume({
            prepared: in.prepared,
            tree: in.tree,
            types: in.types,
            frames: in.frames,
            control: {
                ...in.control,
                depth: _,
                phase: Phase.Returning
            }
        })
}
