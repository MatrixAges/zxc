import consume from "../state/consume"
import frame from "../state/frame"
import { Phase, FrameKind } from "../state/model"

import type { ExprState, ExprControl } from "../state/model"

export type Input = ExprState

export type Output = ExprState

export default function (in: Input): Output {
    const cursor = in.prepared.lexical.templates[in.control.template - 1].head

    const frames = {
        ...frame({
            kind: FrameKind.Template,
            start: in.control.token.span.start,
            depth: in.control.depth
        }),
        end: in.control.token.span.end,
        stream: in.control.stream,
        index: in.control.index + 1,
        head: in.control.template_head,
        count: in.control.template_count,
        maximum: in.control.template_maximum
    }
        -> in.frames.push(_)[0]

    const control: ExprControl = {
        ...in.control,
        cursor,
        template_head: 0,
        template_count: 0,
        template_maximum: 0
    }

    return consume({
        state: {
            prepared: in.prepared,
            tree: in.tree,
            types: in.types,
            frames,
            control
        },
        phase: Phase.TemplateGather
    })
}
