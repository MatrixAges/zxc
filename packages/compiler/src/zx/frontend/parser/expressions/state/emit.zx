import { max_nesting_depth } from "core/const"

import { Phase } from "./model"

import type { ExprState, ExprNode } from "./model"

export type Input = {
    state: ExprState,
    node: ExprNode
}

export type Output = ExprState

export default function (in: Input): Output {
    if (in.node.depth > max_nesting_depth) {
        return {
            code: "unsupported",
            start: in.node.span.start,
            end: in.node.span.end,
            message: "expression nesting exceeds 256 levels"
        }
            -> {
                prepared: in.state.prepared,
                tree: in.state.tree,
                types: in.state.types,
                frames: in.state.frames,
                control: {
                    ...in.state.control,
                    phase: Phase.Done,
                    diagnostic: _
                }
            }
    }

    const result = in.state.tree.nodes.length

    return in.state.tree.nodes.push(in.node)[0]
        -> {
            prepared: in.state.prepared,
            tree: {
                nodes: _,
                items: in.state.tree.items,
                fields: in.state.tree.fields,
                parameters: in.state.tree.parameters,
                parts: in.state.tree.parts,
                arms: in.state.tree.arms
            },
            types: in.state.types,
            frames: in.state.frames,
            control: {
                ...in.state.control,
                result
            }
        }
}
