import type { ExprTree, ExprNode, Item, Field, Parameter, Part, Arm } from "./model"

export type Input = void

export type Output = ExprTree

export default function (in: Input): Output {
    const nodes: ExprNode[] = []
    const items: Item[] = []
    const fields: Field[] = []
    const parameters: Parameter[] = []
    const parts: Part[] = []
    const arms: Arm[] = []

    return {
        nodes,
        items,
        fields,
        parameters,
        parts,
        arms
    }
}
