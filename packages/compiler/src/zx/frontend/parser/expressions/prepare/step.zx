import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import operator from "./operator"

import type { State } from "./model"

export type Input = {
    state: State,
    kind: Kind,
    symbol: Symbol,
    word: Keyword
}

export type Output = State

export default function (in: Input): Output {
    const ending = in.symbol == Symbol.CloseParen && in.state.arrow

    const parameter_start =
        ending || (
            in.kind == Kind.Identifier && in.state.after_identifier
        )

    const after_identifier =
        ending || (
            in.symbol == Symbol.Comma && in.state.parameter_start
        )

    const not_parameter_start = in.symbol == Symbol.OpenParen && in.state.parameter_start

    const lambda =
        (
            - in.kind == Kind.Identifier
            - and in.state.arrow
            - or (not_parameter_start)
        )

    const generic = (
        match in.word {
            Keyword.QueryOne => true,
            Keyword.QueryMany => true,
            Keyword.Insert => true,
            Keyword.Update => true,
            Keyword.Delete => true,
            Keyword.Transaction => true,
            _ => false
        }
    )

    const hint = {
        lambda,
        generic: generic,
        binary: operator(in.symbol)
    }

    return {
        arrow: in.symbol == Symbol.Arrow,
        parameter_start,
        after_identifier,
        hints: in.state.hints.push(hint)[0]
    }
}
