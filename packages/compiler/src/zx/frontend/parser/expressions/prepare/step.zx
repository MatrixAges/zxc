import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import operator from "./operator"

import type { State } from "./model"

export type Input = {
    state: State,
    kind: Kind,
    symbol: Symbol,
    word: Keyword
}

export type Output = State

export default function (in: Input): Output {
    const ending = in.symbol == Symbol.CloseParen && in.state.arrow

    const parameter_start =
        ending || (
            in.kind == Kind.Identifier && in.state.after_identifier
        )

    const after_identifier =
        ending || (
            in.symbol == Symbol.Comma && in.state.parameter_start
        )

    const lambda =
        (
            - in.kind == Kind.Identifier
            - and in.state.arrow
            - or (in.symbol == Symbol.OpenParen && in.state.parameter_start)
        )

    return (
        - in.word == Keyword.QueryOne
        - or in.word == Keyword.QueryMany
        - or in.word == Keyword.Insert
        - or in.word == Keyword.Update
        - or in.word == Keyword.Delete
        - or in.word == Keyword.Transaction
    )
        -> {
            lambda,
            generic: _,
            binary: operator(in.symbol)
        }
        -> {
            arrow: in.symbol == Symbol.Arrow,
            parameter_start,
            after_identifier,
            hints: in.state.hints.push(_)[0]
        }
}
