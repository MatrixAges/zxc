import type { Prepared } from "../../templates/model"

export enum Operator {
    None,
    Coalesce,
    Add,
    Subtract,
    Multiply,
    Divide,
    Remainder,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    And,
    Or,
    Pipeline
}

export enum Family {
    None,
    Coalesce,
    Logical
}

export enum Connector {
    None,
    And,
    Or,
    Xor,
    Nand,
    Nor
}

export type Binary = {
    operator: Operator,
    precedence: u8,
    family: Family
}

export type Hint = {
    lambda: bool,
    generic: bool,
    binary: Binary
}

export type State = {
    arrow: bool,
    parameter_start: bool,
    after_identifier: bool,
    hints: Hint[]
}

export type PreparedInput = {
    source: u8[],
    lexical: Prepared,
    hints: Hint[],
    interpolation_hints: Hint[][]
}
