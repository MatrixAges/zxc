<Module>
    <Call module="../lexical" in={$in} />

    <Call fn="expressions/prepare/scan" in={$ctx.lexical.lexed.tokens} />
    <Call fn="expressions/prepare/interpolations" in={$ctx.lexical.interpolations} />

    <Return value={{ lexical: $ctx.lexical, hints: $ctx.scan, interpolation_hints: $ctx.interpolations }} />
</Module>
