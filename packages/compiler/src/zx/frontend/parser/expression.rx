<Module>
    <Type from="expressions/parse" as="Parse" />

    <Args
        in={{
            allow_lambda: bool,
            depth: u64,
            minimum: u8,
            source: u8[],
            start: u64
        }}
        out={Parse.Output}
    />

    <Call module="prepare" in={$in.source} />

    <Call
        fn="expressions/parse"
        in={{
            prepared: $ctx.prepare,
            start: $in.start,
            depth: $in.depth,
            minimum: $in.minimum,
            allow_lambda: $in.allow_lambda
        }}
    />

    <Return value={$ctx.parse} />
</Module>
