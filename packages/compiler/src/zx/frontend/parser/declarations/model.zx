import type { Diagnostic } from "../../lexer/model"
import type { Span, Token } from "../../lexer/token_model"
import type { Tree, Frame, Control } from "../types/model"

export enum Phase { Start, Kind, Name, Open, Value, Member, Separator, Done }

export type Declaration = { name: Span, span: Span, enumeration: bool, value: u64, first: u64, count: u64 }

export type TypeState = { tree: Tree, frames: Frame[], control: Control }

export type DeclControl = {
  phase: Phase, index: u64, start: u64, depth: u64, token: Token,
  opening: u64, opening_index: u64, last_end: u64, name: Span,
  enumeration: bool, first: u64, count: u64, type_diagnostic: bool, diagnostic: Diagnostic
}

export type State = { declarations: Declaration[], members: Span[], types: TypeState, control: DeclControl }
