import { Keyword } from "../../lexer/keyword_model"
import { Kind, Symbol } from "../../lexer/token_model"
import typeInitial from "../types/initial"
import consume from "./consume"
import fail from "./fail"
import { Phase } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.control.phase == Phase.Kind) {
        if (
            in.control.token.word != Keyword.Type && in.control.token.word != Keyword.Enum
        ) {
            return in.control.opening_index
                -> {
                    declarations: in.declarations,
                    members: in.members,
                    types: in.types,
                    control: {
                        ...in.control,
                        phase: Phase.Done,
                        index: _
                    }
                }
        }

        return in.control.token.word == Keyword.Enum
            -> consume({
                state: {
                    declarations: in.declarations,
                    members: in.members,
                    types: in.types,
                    control: {
                        ...in.control,
                        enumeration: _
                    }
                },
                phase: Phase.Name
            })
    }

    if (in.control.phase == Phase.Name) {
        if (in.control.token.kind != Kind.Identifier) {
            return fail({
                state: in,
                message: "expected an identifier"
            })
        }

        return {
            start: in.control.token.span.start,
            end: in.control.token.span.end
        }
            -> consume({
                state: {
                    declarations: in.declarations,
                    members: in.members,
                    types: in.types,
                    control: {
                        ...in.control,
                        name: _
                    }
                },
                phase: Phase.Open
            })
    }

    if (in.control.enumeration) {
        if (in.control.token.symbol != Symbol.OpenBrace) {
            return fail({
                state: in,
                message: "expected {"
            })
        }

        return consume({
            state: in,
            phase: Phase.Member
        })
    }

    if (in.control.token.symbol != Symbol.Assign) {
        return fail({
            state: in,
            message: "expected ="
        })
    }

    const index = in.control.index + 1

    const initial = typeInitial({
        start: index,
        depth: in.control.depth
    })

    return {
        tree: in.types.tree,
        frames: initial.frames,
        control: {
            ...initial.control,
            index
        }
    }
        -> consume({
            state: {
                declarations: in.declarations,
                members: in.members,
                types: _,
                control: in.control
            },
            phase: Phase.Value
        })
}
