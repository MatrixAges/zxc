import { Phase } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    return {
        name: {
            start: in.control.name.start,
            end: in.control.name.end
        },
        span: {
            start: in.control.opening,
            end: in.control.last_end
        },
        enumeration: in.control.enumeration,
        value: in.types.control.result,
        first: in.control.first,
        count: in.control.count
    }
        -> in.declarations.push(_)[0]
        -> {
            declarations: _,
            members: in.members,
            types: in.types,
            control: {
                ...in.control,
                phase: Phase.Start
            }
        }
}
