import { Kind, Symbol } from "../../lexer/token_model"
import typeDone from "../types/done"
import typeStep from "../types/step"
import begin from "./begin"
import fail from "./fail"
import { Phase } from "./model"
import publish from "./publish"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: owned Input): Output {
  const token = {
    kind: in.control.token.kind, word: in.control.token.word, symbol: in.control.token.symbol,
    span: { start: in.control.token.span.start, end: in.control.token.span.end },
    line_break: in.control.token.line_break, dollar: in.control.token.dollar
  }

  const types = typeStep({ state: in.types, token: token })
  const index = types.control.index
  const last_end = index == in.control.index ? in.control.last_end : in.control.token.span.end
  const failed = types.control.diagnostic.message != ""
  const done = typeDone(types.control.phase)
  const state = { declarations: in.declarations, members: in.members, types: types, control: { ...in.control, index: index, last_end: last_end } }

  if (failed) {
    return { declarations: state.declarations, members: state.members, types: state.types, control: { ...state.control, phase: Phase.Done, type_diagnostic: true } }
  }

  if (!done) {
    return state
  }

  if (state.control.token.symbol == Symbol.Semicolon) {
    return fail({ state: state, message: "semicolons are not allowed in ZX" })
  }

  if (state.control.token.kind != Kind.Eof && state.control.token.symbol != Symbol.CloseBrace && !state.control.token.line_break) {
    return fail({ state: state, message: "expected a newline, closing block or end of source" })
  }

  return begin(publish(state))
}
