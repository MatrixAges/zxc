import { ExprKind } from "../../expressions/state/model"
import { StatementKind, Phase } from "../model"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const result = in.expression.control.result
    const kind = in.frame.statement

    const expression_kind = in.expression.tree.nodes[result].kind

    const condition = (
        - kind == StatementKind.Evaluate
        - and expression_kind != ExprKind.Call
        - and expression_kind != ExprKind.Pipeline
        - and expression_kind != ExprKind.Await
        - and expression_kind != ExprKind.Cancel
    )

    if (condition) {
        const start = in.expression.tree.nodes[result].span.start

        return in.expression.tree.nodes[result].span.end
            -> {
                code: "syntax",
                start,
                end: _,
                message:
                    "only calls, await and cancel can be used as standalone expressions"
            }
            -> {
                expression: in.expression,
                tree: in.tree,
                frames: in.frames,
                suspended: in.suspended,
                frame: in.frame,
                control: {
                    ...in.control,
                    phase: Phase.Done,
                    diagnostic: _
                }
            }
    }

    return (kind == StatementKind.StoreSet || kind == StatementKind.StateUpdate ? {
        ...in.frame,
        second: result
    } : {
        ...in.frame,
        first: match kind {
            StatementKind.Result => result + 1,
            _ => result
        }
    })
        -> {
            expression: in.expression,
            tree: in.tree,
            frames: in.frames,
            suspended: in.suspended,
            frame: _,
            control: {
                ...in.control,
                phase: Phase.EndStatement
            }
        }
}
