import { ExprKind } from "../../expressions/state/model"
import { StatementKind, Phase } from "../model"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const result = in.expression.control.result
    const kind = in.frame.statement

    const expression_kind = in.expression.tree.nodes[result].kind

    const not_call = expression_kind != ExprKind.Call
    const not_pipeline = expression_kind != ExprKind.Pipeline
    const not_await = expression_kind != ExprKind.Await
    const not_cancel = expression_kind != ExprKind.Cancel

    const condition = (
        - kind == StatementKind.Evaluate
        - and not_call
        - and not_pipeline
        - and not_await
        - and not_cancel
    )

    if (condition) {
        const start = in.expression.tree.nodes[result].span.start
        const end = in.expression.tree.nodes[result].span.end

        const diagnostic = {
            code: "syntax",
            start,
            end: end,
            message:
                "only calls, await and cancel can be used as standalone expressions"
        }

        return {
            expression: in.expression,
            tree: in.tree,
            frames: in.frames,
            suspended: in.suspended,
            frame: in.frame,
            control: {
                ...in.control,
                phase: Phase.Done,
                diagnostic: diagnostic
            }
        }
    }

    const next = match {
        kind == StatementKind.StoreSet || kind == StatementKind.StateUpdate => {
            ...in.frame,
            second: result
        },
        _ => {
            ...in.frame,
            first: match kind {
                StatementKind.Result => result + 1,
                _ => result
            }
        }
    }

    return {
        expression: in.expression,
        tree: in.tree,
        frames: in.frames,
        suspended: in.suspended,
        frame: next,
        control: {
            ...in.control,
            phase: Phase.EndStatement
        }
    }
}
