import { Symbol } from "../../../lexer/token_model"
import { Operator } from "../../expressions/prepare/model"
import { ExprKind } from "../../expressions/state/model"
import { StatementKind, Phase } from "../model"
import consume from "../state/consume"
import expect from "../state/expect"
import fail from "../state/fail"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.control.phase == Phase.UpdateAssign) {
        return expect({
            state: in,
            symbol: Symbol.Assign,
            phase: Phase.BeginValue,
            message: "="
        })
    }

    const result = in.expression.control.result
    const operator = in.expression.control.hint.binary.operator

    const state = (
        in.control.phase == Phase.StoreAssign ? StatementKind.StoreSet :
            StatementKind.StateUpdate
    )
        -> {
            expression: in.expression,
            tree: in.tree,
            frames: in.frames,
            suspended: in.suspended,
            frame: {
                ...in.frame,
                statement: _,
                first: result
            },
            control: in.control
        }

    if (
        state.control.phase == Phase.StoreAssign ||
            state.expression.control.token.symbol == Symbol.Assign
    ) {
        return expect({
            state,
            symbol: Symbol.Assign,
            phase: Phase.BeginValue,
            message: "="
        })
    }

    if (operator == Operator.None) {
        const expression_kind = state.expression.tree.nodes[result].kind

        const condition = (
            - expression_kind == ExprKind.Call
            - or expression_kind == ExprKind.Pipeline
            - or expression_kind == ExprKind.Await
            - or expression_kind == ExprKind.Cancel
        )

        if (condition) {
            return {
                expression: state.expression,
                tree: state.tree,
                frames: state.frames,
                suspended: state.suspended,
                frame: {
                    ...state.frame,
                    statement: StatementKind.Evaluate
                },
                control: {
                    ...state.control,
                    phase: Phase.EndStatement
                }
            }
        }

        const start = state.expression.tree.nodes[result].span.start

        return state.expression.tree.nodes[result].span.end
            -> {
                code: "syntax",
                start,
                end: _,
                message: "expected a state update, call, await or cancel"
            }
            -> {
                expression: state.expression,
                tree: state.tree,
                frames: state.frames,
                suspended: state.suspended,
                frame: state.frame,
                control: {
                    ...state.control,
                    phase: Phase.Done,
                    diagnostic: _
                }
            }
    }

    const condition_2 = (
        - operator != Operator.Add
        - and operator != Operator.Subtract
        - and operator != Operator.Multiply
        - and operator != Operator.Divide
        - and operator != Operator.Remainder
    )

    if (condition_2) {
        return fail({
            state,
            code: "syntax",
            message: "expected a state update or a standalone call"
        })
    }

    return consume({
        state: {
            expression: state.expression,
            tree: state.tree,
            frames: state.frames,
            suspended: state.suspended,
            frame: {
                ...state.frame,
                operator
            },
            control: state.control
        },
        phase: Phase.UpdateAssign
    })
}
