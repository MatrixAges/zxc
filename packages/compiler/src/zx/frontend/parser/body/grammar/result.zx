import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import { Phase } from "../model"
import expression from "../state/expression"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const word = in.expression.control.token.word

    const next =
        (
            - in.expression.control.token.line_break
            - and (
                - word == Keyword.Const
                - or word == Keyword.Return
                - or word == Keyword.If
                - or word == Keyword.Switch
                - or word == Keyword.Store
            )
        )

    const condition = (
        - next
        - or in.expression.control.token.symbol == Symbol.CloseBrace
        - or in.expression.control.token.kind == Kind.Eof
    )

    if (condition) {
        return {
            expression: in.expression,
            tree: in.tree,
            frames: in.frames,
            suspended: in.suspended,
            frame: in.frame,
            control: {
                ...in.control,
                phase: Phase.EndStatement
            }
        }
    }

    return expression({
        state: in,
        resume: Phase.Value,
        minimum: 0
    })
}
