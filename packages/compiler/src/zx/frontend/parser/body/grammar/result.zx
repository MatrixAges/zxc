import { Keyword } from "../../../lexer/keyword_model"
import { Kind, Symbol } from "../../../lexer/token_model"
import { Phase } from "../model"
import expression from "../state/expression"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const word = in.expression.control.token.word
    const line_break = in.expression.control.token.line_break

    const statement = match word {
        Keyword.Const => true,
        Keyword.Return => true,
        Keyword.If => true,
        Keyword.Switch => true,
        Keyword.Store => true,
        _ => false
    }

    const next = line_break && statement

    const is_close_brace = in.expression.control.token.symbol == Symbol.CloseBrace
    const is_eof = in.expression.control.token.kind == Kind.Eof

    const condition = (
        - next
        - or is_close_brace
        - or is_eof
    )

    if (condition) {
        return {
            expression: in.expression,
            tree: in.tree,
            frames: in.frames,
            suspended: in.suspended,
            frame: in.frame,
            control: {
                ...in.control,
                phase: Phase.EndStatement
            }
        }
    }

    return expression({
        state: in,
        resume: Phase.Value,
        minimum: 0
    })
}
