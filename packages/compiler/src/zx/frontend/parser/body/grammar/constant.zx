import { Kind, Symbol } from "../../../lexer/token_model"
import typeInitial from "../../types/initial"
import { Phase } from "../model"
import consume from "../state/consume"
import expect from "../state/expect"
import fail from "../state/fail"
import pattern from "./pattern/enter"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const symbol = in.expression.control.token.symbol

    if (in.control.phase == Phase.ConstAssign) {
        if (symbol != Symbol.Assign) {
            return fail({
                state: in,
                code: "syntax",
                message: "expected ="
            })
        }

        return consume({
            state: in,
            phase: Phase.BeginValue
        })
    }

    if (in.control.phase == Phase.ConstAfterName) {
        if (symbol != Symbol.Colon) {
            return expect({
                state: in,
                symbol: Symbol.Assign,
                phase: Phase.BeginValue,
                message: "expected ="
            })
        }

        const index = in.expression.control.index + 1

        const initial = typeInitial({
            start: index,
            depth: in.frame.depth
        })

        const types = {
            tree: in.expression.types.tree,
            frames: initial.frames,
            control: {
                ...initial.control,
                index
            }
        }

        const state = {
            expression: {
                prepared: in.expression.prepared,
                tree: in.expression.tree,
                types: types,
                frames: in.expression.frames,
                control: in.expression.control
            },
            tree: in.tree,
            frames: in.frames,
            suspended: in.suspended,
            frame: in.frame,
            control: in.control
        }

        return consume({
            state: state,
            phase: Phase.Type
        })
    }

    const constant_name = in.control.phase == Phase.ConstName
    const pattern_open = symbol == Symbol.OpenBracket || symbol == Symbol.OpenBrace

    if (constant_name && pattern_open) {
        return pattern(in)
    }

    if (in.expression.control.token.kind != Kind.Identifier) {
        return fail({
            state: in,
            code: "syntax",
            message: "expected an identifier"
        })
    }

    const name = {
        start: in.expression.control.token.span.start,
        end: in.expression.control.token.span.end
    }

    return consume({
        state: {
            ...in,
            frame: {
                ...in.frame,
                name
            }
        },
        phase: Phase.ConstAfterName
    })
}
