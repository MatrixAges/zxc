import { Kind, Symbol } from "../../../lexer/token_model"
import { Phase } from "../model"
import fail from "../state/fail"
import publish from "../state/publish"

import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.expression.control.token.symbol == Symbol.Semicolon) {
        return fail({
            state: in,
            code: "syntax",
            message: "semicolons are not allowed in ZX"
        })
    }

    const not_eof = in.expression.control.token.kind != Kind.Eof
    const not_close_brace = in.expression.control.token.symbol != Symbol.CloseBrace

    const line_break = !in.expression.control.token.line_break

    const condition = (
        - not_eof
        - and not_close_brace
        - and line_break
    )

    if (condition) {
        return fail({
            state: in,
            code: "syntax",
            message: "expected a newline, closing block or end of source"
        })
    }

    return publish(in)
}
