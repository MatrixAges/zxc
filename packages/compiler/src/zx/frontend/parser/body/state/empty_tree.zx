import type { Tree, Statement, Block, Item, Name, Case } from "../model"

export type Input = void

export type Output = Tree

export default function (in: Input): Output {
  const statements: Statement[] = []
  const blocks: Block[] = []
  const items: Item[] = []
  const names: Name[] = []
  const cases: Case[] = []

  return { statements: statements, blocks: blocks, items: items, names: names, cases: cases }
}
