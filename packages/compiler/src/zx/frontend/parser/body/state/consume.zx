import consume from "../../expressions/state/consume"

import type { State, Phase } from "../model"

export type Input = {
    state: State,
    phase: Phase
}

export type Output = State

export default function (in: Input): Output {
    return in.state.expression.control.phase
        -> consume({
            state: in.state.expression,
            phase: _
        })
        -> {
            expression: _,
            tree: in.state.tree,
            frames: in.state.frames,
            suspended: in.state.suspended,
            frame: in.state.frame,
            control: {
                ...in.state.control,
                phase: in.phase
            }
        }
}
