import { Phase } from "../model"

import type { State } from "../model"

export type Input = {
    state: State,
    code: string,
    message: string
}

export type Output = State

export default function (in: Input): Output {
    const start = in.state.expression.control.token.span.start

    return in.state.expression.control.token.span.end
        -> {
            code: in.code,
            start,
            end: _,
            message: in.message
        }
        -> {
            expression: in.state.expression,
            tree: in.state.tree,
            frames: in.state.frames,
            suspended: in.state.suspended,
            frame: in.state.frame,
            control: {
                ...in.state.control,
                phase: Phase.Done,
                diagnostic: _
            }
        }
}
