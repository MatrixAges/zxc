import initial from "./initial"
import { Phase } from "./model"
import step from "./step"

import type { Result } from "../../lexer/model"
import type { NativeState } from "./model"

export type Input = Result

export type Output = NativeState

export default function (in: owned Input): Output {
  return loop(initial(in), {
    while: value => value.control.phase != Phase.Done,
    next: value => {
      value = step(value)
    }
  })
}
