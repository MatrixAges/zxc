import type { Diagnostic } from "../../lexer/model"
import type { NativeState } from "./model"

export type Input = NativeState

export type Output = Diagnostic

export default function (in: Input): Output {
    const issue = match {
        in.lexed.diagnostic.message != "" => in.lexed.diagnostic,
        in.control.diagnostic.message != "" => in.control.diagnostic,
        in.declarations.types.control.diagnostic.message != "" => in.declarations.types.control.diagnostic,
        _ => in.declarations.control.diagnostic
    }

    if (in.declarations.declarations.length == 0 && in.functions.length == 0 && issue.message == "") {
        return { code: "contract", start: 0, end: 0, message: "native interfaces must export types or functions" }
    }

    return { code: issue.code, start: issue.start, end: issue.end, message: issue.message }
}
