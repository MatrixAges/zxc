import { HeaderPhase } from "./model"

import type { State } from "./model"

export type Input = {
    state: State,
    code: string,
    message: string
}

export type Output = State

export default function (in: Input): Output {
    return {
        code: in.code,
        start: in.state.control.token.span.start,
        end: in.state.control.token.span.end,
        message: in.message
    }
        -> {
            expression: in.state.expression,
            body: in.state.body,
            contracts: in.state.contracts,
            control: {
                ...in.state.control,
                phase: HeaderPhase.Done,
                diagnostic: _
            }
        }
}
