import expression from "../expressions/state/initial"
import initial from "./initial"
import { HeaderPhase } from "./model"
import step from "./step"

import type { PreparedInput } from "../expressions/prepare/model"
import type { State } from "./model"

export type Input = {
    prepared: PreparedInput,
    start: u64,
    depth: u64
}

export type Output = State

export default function (in: Input): Output {
    return expression({
        prepared: in.prepared,
        start: in.start,
        depth: in.depth,
        minimum: 0,
        allow_lambda: true
    })
        -> initial(_)
        -> loop(_, {
            while: value => value.control.phase != HeaderPhase.Done,
            next: value => {
                value = step(value)
            }
        })
}
