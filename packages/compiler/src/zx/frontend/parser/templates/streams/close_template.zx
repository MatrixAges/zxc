import resume from "./resume"

import type { State } from "./model"

export type Input = {
    state: State,
    template: u64
}

export type Output = State

export default function (in: Input): Output {
    const popped = in.state.parents.pop()

    const active = resume({
        parent: popped[1],
        diagnostics: in.state.diagnostics,
        length: in.state.length,
        end: in.state.offset + 1,
        template: in.template
    })

    return {
        ...in.state,
        active,
        parents: popped[0],
        skip: true
    }
}
