import tick from "../../../lexer/tick"
import appendTokenIds from "../boundary/append_token_ids"

import type { State } from "./model"

export type Input = {
    state: State,
    byte: u8
}

export type Output = State

export default function (in: Input): Output {
    const previous = in.state.active.lexer.tokens.length

    const lexer = tick({
        state: in.state.active.lexer,
        byte: in.byte
    })

    const token_templates = appendTokenIds({
        ids: in.state.active.token_templates,
        count: lexer.tokens.length - previous,
        template: 0
    }).ids

    const active = {
        present: in.state.active.present,
        start: in.state.active.start,
        lexer,
        token_templates: token_templates
    }

    return {
        ...in.state,
        active
    }
}
