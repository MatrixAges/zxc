import emit from "../../../lexer/emit"
import initial from "../../../lexer/initial"
import session from "./session"

import type { Diagnostic, LexerState } from "../../../lexer/model"
import type { Session, Suspended } from "./model"

export type Input = {
    parent?: Suspended,
    diagnostics: Diagnostic[],
    length: u64,
    end: u64,
    template: u64
}

export type Output = Session

export default function (in: Input): Output {
    const parent = in.parent

    if (parent == null || !parent.present) {
        return session({
            start: 0,
            end: in.length,
            present: false
        })
    }

    const base = initial({
        start: in.end,
        end: in.end
    })

    const diagnostic = parent.diagnostic

    const lexer: LexerState = {
        ...base,
        tokens: parent.tokens,
        comments: parent.comments,
        line_break: parent.line_break,
        symbol: parent.symbol,
        dollar: parent.dollar,
        diagnostic: diagnostic != null ? in.diagnostics[diagnostic] : base.diagnostic
    }

    if (lexer.diagnostic.message != "") {
        return {
            present: true,
            start: parent.session_start,
            lexer,
            token_templates: parent.token_templates
        }
    }

    const emitted = emit({
        kind: "template",
        start: parent.template_start,
        end: in.end,
        comment: false,
        state: lexer
    })

    return {
        present: true,
        start: parent.session_start,
        lexer: emitted,
        token_templates: parent.token_templates.push(in.template)[0]
    }
}
