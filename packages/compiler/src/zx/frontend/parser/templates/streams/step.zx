import type { State } from "./model"
import event from "./event"
import feed from "./feed"

export type Input = { state: State, byte: u8 }

export type Output = State

export default function (in: owned Input): Output {
  const routed = event(event({ ...in.state, skip: false }))
  const next = routed.active.present && !routed.skip ? feed({ state: routed, byte: in.byte }) : routed
  const offset = next.offset + 1

  return { ...next, offset: offset }
}
