import type { State } from "./model"
import finishPrefix from "./finish_prefix"
import result from "./result"
import session from "./session"

export type Input = State

export type Output = State

export default function (in: owned Input): Output {
  const completed = result({ session: finishPrefix({ session: in.active, end: in.offset }), end: in.offset })
  const interpolations = in.interpolations.push(completed)[0]

  return { active: session({ start: 0, end: in.length, present: false }), parents: in.parents, interpolations: interpolations, events: in.events, event_index: in.event_index, offset: in.offset, length: in.length, skip: true }
}
