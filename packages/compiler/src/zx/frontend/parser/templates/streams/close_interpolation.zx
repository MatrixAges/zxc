import finishPrefix from "./finish_prefix"
import result from "./result"
import session from "./session"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    return result({
        session: finishPrefix({
            session: in.active,
            end: in.offset
        }),
        end: in.offset
    })
        -> in.interpolations.push(_)[0]
        -> {
            active: session({
                start: 0,
                end: in.length,
                present: false
            }),
            parents: in.parents,
            interpolations: _,
            events: in.events,
            event_index: in.event_index,
            offset: in.offset,
            length: in.length,
            skip: true
        }
}
