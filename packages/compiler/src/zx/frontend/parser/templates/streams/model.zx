import type { Diagnostic, LexerState } from "../../../lexer/model"
import type { Span, Symbol, Token } from "../../../lexer/token_model"
import type { Event, Interpolation } from "../model"

export type Session = {
    present: bool,
    start: u64,
    lexer: LexerState,
    token_templates: u64[]
}

export type Suspended = {
    present: bool,
    session_start: u64,
    template_start: u64,
    tokens: Token[],
    comments: Span[],
    token_templates: u64[],
    line_break: bool,
    symbol: Symbol,
    dollar: bool,
    diagnostic?: u64
}

export type State = {
    active: Session
    parents: Suspended[]
    diagnostics: Diagnostic[]
    interpolations: Interpolation[]
    events: Event[]
    event_index: u64
    offset: u64
    length: u64
    skip: bool
}
