import finishPrefix from "./finish_prefix"
import session from "./session"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const active = match {
        in.active.present => finishPrefix({
            session: in.active,
            end: in.offset
        }),
        _ => in.active
    }

    const lexer = active.lexer
    const failed = lexer.diagnostic.message != ""
    const diagnostic: u64? = failed ? in.diagnostics.length : null
    const diagnostics = failed ? in.diagnostics.push(lexer.diagnostic)[0] : in.diagnostics

    const parents = in.parents.push({
        present: active.present,
        session_start: active.start,
        template_start: in.offset,
        tokens: lexer.tokens,
        comments: lexer.comments,
        token_templates: active.token_templates,
        line_break: lexer.line_break,
        symbol: lexer.symbol,
        dollar: lexer.dollar,
        diagnostic
    })[0]

    return {
        ...in,
        active: session({
            start: 0,
            end: in.length,
            present: false
        }),
        parents,
        diagnostics,
        skip: true
    }
}
