import { reduce } from "std:utils"

import step from "./step"

import type { Interpolation } from "../model"
import type { State } from "./model"

export type Input = {
    source: u8[],
    state: State
}

export type Output = Interpolation[]

export default function (in: Input): Output {
    const completed = reduce(in.source, (state, byte) => step({
        state,
        byte
    }), in.state)

    return completed.interpolations
}
