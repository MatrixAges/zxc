<Module>
    <Type from="./model" as="Model" />

    <Args in={u8[]} out={Model.Prepared} />

    <Call module="boundary/scan" in={$in} />

    <If
        on={$ctx.scan.lexed.diagnostic.message == "" && $ctx.scan.templates.length != 0}
    >
        <Call
            fn="streams/initial"
            in={{
                events: $ctx.scan.events,
                length: $in.length
            }}
        />

        <Call
            fn="streams/interpolations"
            in={{
                source: $in,
                state: $ctx.initial
            }}
        />

        <Return
            value={{
                lexed: $ctx.scan.lexed,
                token_templates: $ctx.scan.token_templates,
                templates: $ctx.scan.templates,
                parts: $ctx.scan.parts,
                interpolations: $ctx.interpolations
            }}
        />

        <Else>
            <Return
                value={{
                    lexed: $ctx.scan.lexed,
                    token_templates: $ctx.scan.token_templates,
                    templates: $ctx.scan.templates,
                    parts: $ctx.scan.parts,
                    interpolations: []
                }}
            />
        </Else>
    </If>
</Module>
