import { Mode } from "../../../lexer/model"
import closeInterpolation from "./close_interpolation"
import closeTemplate from "./close_template"
import openInterpolation from "./open_interpolation"
import openTemplate from "./open_template"

import type { Graph } from "./model"

export type Input = {
    graph: Graph,
    mode: Mode,
    offset: u64,
    braces: u64,
    byte: u8,
    next: u8,
    has_next: bool
}

export type Output = Graph

export default function (in: Input): Output {
    if (in.mode == Mode.Template) {
        if (in.byte == 96) {
            return closeTemplate({
                graph: in.graph,
                offset: in.offset
            })
        }

        const condition = (
            - in.byte == 36
            - and in.has_next
            - and in.next == 123
        )

        if (condition) {
            return openInterpolation({
                graph: in.graph,
                offset: in.offset
            })
        }
    }

    const condition_2 = (
        - in.mode == Mode.Interpolation
        - and in.byte == 125
        - and in.braces == 0
    )

    if (condition_2) {
        return closeInterpolation({
            graph: in.graph,
            offset: in.offset
        })
    }

    const can_open = match in.mode {
        Mode.Idle => true,
        Mode.Identifier => true,
        Mode.Number => true,
        Mode.Interpolation => true,
        _ => false
    }

    const condition_3 = in.byte == 96 && can_open

    if (condition_3) {
        return openTemplate({
            graph: in.graph,
            offset: in.offset
        })
    }

    return in.graph
}
