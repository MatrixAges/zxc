import advance from "./advance"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    if (in.lexer.diagnostic.message != "" || in.lexer.warmed == 0) {
        return in
    }

    const warmed = in.lexer.warmed
    const last = in.lexer.ahead_two

    const next = advance({
        byte: in.lexer.ahead_one,
        next: in.lexer.ahead_two,
        after: 0,
        has_next: in.lexer.warmed == 2,
        has_after: false,
        state: in
    })

    const advanced = next.lexer.offset + 1
        -> {
            lexer: {
                ...next.lexer,
                offset: _
            },
            graph: next.graph
        }

    if (warmed == 1 || advanced.lexer.diagnostic.message != "") {
        return advanced
    }

    const final = advance({
        byte: last,
        next: 0,
        after: 0,
        has_next: false,
        has_after: false,
        state: advanced
    })

    return final.lexer.offset + 1
        -> {
            lexer: {
                ...final.lexer,
                offset: _
            },
            graph: final.graph
        }
}
