import { PartKind, EventKind } from "../model"
import addPart from "./add_part"

import type { Graph } from "./model"

export type Input = {
    graph: Graph,
    offset: u64
}

export type Output = Graph

export default function (in: Input): Output {
    const graph = in.graph.frames[in.graph.frames.length - 1].text_start
        -> addPart({
            graph: in.graph,
            kind: PartKind.Text,
            span: {
                start: _,
                end: in.offset
            },
            interpolation: 0,
            text_start: in.offset + 2
        })

    return graph.events.push({
        kind: EventKind.InterpolationOpen,
        offset: in.offset + 2,
        reference: 0
    })[0]
        -> {
            templates: graph.templates,
            parts: graph.parts,
            events: _,
            frames: graph.frames,
            interpolations: graph.interpolations,
            token_templates: graph.token_templates
        }
}
