<Module>
    <Call fn="../../../lexer/utf8/validate" in={$in} />

    <Switch on={$ctx.validate}>
        <Case value={true}>
            <Call fn="initial" in={$in.length} />
            <Call fn="bytes" in={{ source: $in, state: $ctx.initial }} />
            <Call fn="flush" in={$ctx.bytes} />
            <Call fn="finish" in={$ctx.flush} />

            <Switch on={$ctx.finish.lexer.diagnostic.message == ""}>
                <Case value={true}>
                    <Call fn="publish" in={$ctx.finish} />

                    <Return value={$ctx.publish} />
                </Case>

                <Default>
                    <Call fn="empty" in={$ctx.finish.lexer.diagnostic} />

                    <Return value={$ctx.empty} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Call fn="empty" in={{ code: "lexical", start: 0, end: $in.length, message: "source must be valid UTF-8" }} />

            <Return value={$ctx.empty} />
        </Default>
    </Switch>
</Module>
