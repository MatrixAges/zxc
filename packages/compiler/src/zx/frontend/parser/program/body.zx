import { Phase } from "../body/model"
import initial from "./body/initial"
import advance from "./body/step"

import type { BodyStage } from "./body/model"
import type { HeaderStage } from "./header/model"

export type Input = HeaderStage

export type Output = BodyStage

export default function (in: Input): Output {
    return loop(initial(in), {
        while: value => {
            const header = value.header
            const header_valid = header.diagnostic.message == ""
            const expression_valid = !header.expression_diagnostic
            const body_active = value.body.control.phase != Phase.Done

            return (
                - value.prefix.present
                - and header_valid
                - and expression_valid
                - and body_active
            )
        },
        next: value => {
            value = advance(value)
        }
    })
}
