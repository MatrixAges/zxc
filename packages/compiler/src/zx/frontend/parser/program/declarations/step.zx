import parseConstant from "compiler/constant_syntax"

import { Keyword } from "../../../lexer/keyword_model"
import { Phase } from "../../declarations/model"
import step from "../../declarations/step"
import reference from "../../imports/reference"
import current from "../token"
import imports from "./imports"

import type { DeclarationStage } from "./model"

export type Input = DeclarationStage

export type Output = DeclarationStage

export default function (in: Input): Output {
    const is_start = in.declarations.control.phase == Phase.Start
    const is_done = in.declarations.control.phase == Phase.Done

    const same_message = in.declarations.control.diagnostic.message == ""

    const type_diagnostic = !in.declarations.control.type_diagnostic

    const can_import = (
        - is_start
        - or is_done
        - and same_message
        - and type_diagnostic
    )

    const condition = match {
        can_import => reference({
            tokens: in.prefix.prepared.lexical.lexed.tokens,
            index: in.declarations.control.index
        }),
        _ => false
    }

    if (condition) {
        return imports(in)
    }

    if (in.declarations.control.phase == Phase.Done) {
        const parsed = parseConstant({
            prepared: in.prefix.prepared,
            start: in.declarations.control.index
        })

        const value = parsed.constant

        return {
            ...in,
            constants: value != null ? in.constants.push(value)[0] : in.constants,
            finished: value == null,
            declarations: {
                ...in.declarations,
                control: {
                    ...in.declarations.control,
                    phase: value != null ? Phase.Start : Phase.Done,
                    index: parsed.index,
                    diagnostic: parsed.diagnostic
                }
            }
        }
    }

    const token = current({
        prepared: in.prefix.prepared,
        index: in.declarations.control.index
    })

    const declarations = step({
        state: in.declarations,
        token: token
    })

    const tokens = in.prefix.prepared.lexical.lexed.tokens
    const index = declarations.control.index
    const done = declarations.control.phase == Phase.Done

    const constant = match {
        !done => false,
        index + 1 >= tokens.length => false,
        tokens[index].word != Keyword.Export => false,
        _ => tokens[index + 1].word == Keyword.Const
    }

    const imported = match {
        !done => false,
        constant => true,
        _ => reference({
            tokens,
            index
        })
    }

    const diagnostic = declarations.control.diagnostic.message != ""
    const invalid_type = declarations.control.type_diagnostic
    const invalid = diagnostic || invalid_type
    const finished = done && (!imported || invalid)

    return {
        ...in,
        declarations,
        finished
    }
}
