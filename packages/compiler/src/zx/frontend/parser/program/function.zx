import { Keyword } from "../../lexer/keyword_model"
import { Kind } from "../../lexer/token_model"
import { default_function_message } from "./const"

import type { Diagnostic } from "../../lexer/model"
import type { Span } from "../../lexer/token_model"
import type { DeclarationStage } from "./declarations/model"

export type Input = DeclarationStage

export type Output = {
    index: u64,
    start: u64,
    present: bool,
    name?: Span,
    diagnostic: Diagnostic
}

export default function (in: Input): Output {
    const tokens = in.prefix.prepared.lexical.lexed.tokens
    const index = in.declarations.control.index

    const token = index < tokens.length ? tokens[index] : {
        kind: Kind.Eof,
        word: Keyword.Root,
        symbol: in.declarations.control.token.symbol,
        span: {
            start: in.prefix.prepared.lexical.lexed.diagnostic.start,
            end: in.prefix.prepared.lexical.lexed.diagnostic.end
        },
        line_break: false,
        dollar: false
    }

    const lexical = in.prefix.prepared.lexical.lexed.diagnostic
    const imports = in.prefix.imports.control.diagnostic

    const declarations =
        in.declarations.control.type_diagnostic ?
        in.declarations.types.control.diagnostic :
        in.declarations.control.diagnostic

    const diagnostic = {
        code: "",
        start: 0,
        end: 0,
        message: ""
    }

    const condition = (
        - lexical.message != ""
        - or imports.message != ""
        - or declarations.message != ""
    )

    if (condition) {
        return {
            index,
            start: token.span.start,
            present: false,
            name: null,
            diagnostic
        }
    }

    if (token.kind == Kind.Eof) {
        return {
            index,
            start: token.span.start,
            present: false,
            name: null,
            diagnostic:
                in.declarations.declarations.length == 0 && in.constants.length == 0 &&
                !in.prefix.imports.imports.some(item => item.exported) ? {
                    code: "contract",
                    start: token.span.start,
                    end: token.span.end,
                    message: "a pure type file must export at least one type or enum"
                } : diagnostic
        }
    }

    const condition_2 = (
        - token.word != Keyword.Export
        - or index + 1 >= tokens.length
        - or tokens[index + 1].word != Keyword.Default
    )

    if (condition_2) {
        return {
            index,
            start: token.span.start,
            present: false,
            name: null,
            diagnostic: {
                code: "contract",
                start: token.span.start,
                end: token.span.end,
                message: default_function_message
            }
        }
    }

    const function_token = tokens[index + 2]

    if (function_token.word != Keyword.Function) {
        return {
            index: index + 2,
            start: token.span.start,
            present: false,
            name: null,
            diagnostic: {
                code: "syntax",
                start: function_token.span.start,
                end: function_token.span.end,
                message: "expected function"
            }
        }
    }

    const next = index + 3
    const named = tokens[next].kind == Kind.Identifier

    return {
        index: named ? next + 1 : next,
        start: token.span.start,
        present: true,
        name: named ? tokens[next].span : null,
        diagnostic
    }
}
