import { Keyword } from "../../lexer/keyword_model"
import { Kind, Symbol } from "../../lexer/token_model"
import begin from "./begin"
import { expected_alias, default_alias } from "./const"
import fail from "./fail"
import finish from "./finish"
import { Phase } from "./model"

import type { Token } from "../../lexer/token_model"
import type { State } from "./model"

export type Input = {
    state: State,
    token: Token
}

export type Output = State

export default function (in: Input): Output {
    if (in.state.control.phase == Phase.Done) {
        return in.state
    }

    if (in.state.control.index < in.state.control.start) {
        return in.state.control.index + 1
            -> {
                ...in.state,
                control: {
                    ...in.state.control,
                    index: _
                }
            }
    }

    const state = {
        ...in.state,
        control: {
            ...in.state.control,
            token: in.token
        }
    }

    const phase = state.control.phase

    const span = {
        start: state.control.token.span.start,
        end: state.control.token.span.end
    }

    const symbol = state.control.token.symbol
    const word = state.control.token.word
    const kind = state.control.token.kind
    const index = state.control.index + 1

    if (phase == Phase.Start) {
        return begin(state)
    }

    if (phase == Phase.End) {
        return finish(state)
    }

    const condition = (
        - phase == Phase.Binding
        - and !state.control.type_only
        - and word == Keyword.Type
    )

    if (condition) {
        return {
            ...state,
            control: {
                ...state.control,
                type_only: true,
                index
            }
        }
    }

    const condition_2 = (
        - phase == Phase.Binding
        - and state.control.exported
        - and symbol == Symbol.Star
    )

    if (condition_2) {
        return {
            ...state,
            control: {
                ...state.control,
                named: true,
                wildcard: true,
                phase: Phase.From,
                index
            }
        }
    }

    const condition_3 = (
        - phase == Phase.Separator
        - and word == Keyword.As
        - and !state.control.aliased
    )

    if (condition_3) {
        return {
            ...state,
            control: {
                ...state.control,
                aliased: true,
                phase: Phase.Alias,
                index
            }
        }
    }

    if (phase == Phase.Alias) {
        const condition_4 = (
            - kind != Kind.Identifier
            - and !(state.control.exported && word == Keyword.Default)
        )

        if (condition_4) {
            return fail({
                state,
                span,
                message: expected_alias
            })
        }

        return {
            ...state,
            names:
                state.names.with(state.control.first + state.control.count - 1, span),
            control: {
                ...state.control,
                phase: Phase.Separator,
                index
            }
        }
    }

    const condition_5 = (
        - phase == Phase.Separator
        - and state.control.default_binding
        - and !state.control.aliased
        - and !state.control.exported
    )

    if (condition_5) {
        return fail({
            state,
            span,
            message: default_alias
        })
    }

    if (phase == Phase.Binding && symbol == Symbol.OpenBrace) {
        return {
            ...state,
            control: {
                ...state.control,
                named: true,
                phase: Phase.Name,
                index
            }
        }
    }

    const condition_6 = (
        - phase == Phase.Name
        - or phase == Phase.Separator
        - and symbol == Symbol.CloseBrace
    )

    if (condition_6) {
        return {
            ...state,
            control: {
                ...state.control,
                phase: Phase.From,
                index
            }
        }
    }

    if (phase == Phase.Binding || phase == Phase.Name) {
        const condition_7 = (
            - kind != Kind.Identifier
            - and !(phase == Phase.Name && word == Keyword.Default)
        )

        if (condition_7) {
            return fail({
                state,
                span,
                message: "expected an identifier"
            })
        }

        const count = state.control.count + 1

        return state.names.push(span)[0]
            -> {
                ...state,
                names: _,
                sources: state.sources.push(span)[0],
                control: {
                    ...state.control,
                    phase: phase == Phase.Binding ? Phase.From : Phase.Separator,
                    count,
                    aliased: false,
                    default_binding: word == Keyword.Default,
                    index
                }
            }
    }

    if (phase == Phase.Separator) {
        if (symbol != Symbol.Comma) {
            return fail({
                state,
                span,
                message: "expected }"
            })
        }

        return {
            ...state,
            control: {
                ...state.control,
                phase: Phase.Name,
                index
            }
        }
    }

    if (phase == Phase.From) {
        if (word != Keyword.From) {
            return fail({
                state,
                span,
                message: "expected from"
            })
        }

        return {
            ...state,
            control: {
                ...state.control,
                phase: Phase.Path,
                index
            }
        }
    }

    if (kind != Kind.String) {
        return fail({
            state,
            span,
            message: "import path must be a string literal"
        })
    }

    return {
        ...state,
        control: {
            ...state.control,
            phase: Phase.End,
            path: span,
            index
        }
    }
}
