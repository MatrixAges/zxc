import { Keyword } from "../../lexer/keyword_model"
import { Kind, Symbol } from "../../lexer/token_model"
import begin from "./begin"
import { expected_alias, default_alias } from "./const"
import fail from "./fail"
import finish from "./finish"
import { Phase } from "./model"

import type { Token } from "../../lexer/token_model"
import type { State } from "./model"

export type Input = {
    state: State,
    token: Token
}

export type Output = State

export default function (in: Input): Output {
    if (in.state.control.phase == Phase.Done) {
        return in.state
    }

    if (in.state.control.index < in.state.control.start) {
        const index = in.state.control.index + 1

        return {
            ...in.state,
            control: {
                ...in.state.control,
                index: index
            }
        }
    }

    const state = {
        ...in.state,
        control: {
            ...in.state.control,
            token: in.token
        }
    }

    const phase = state.control.phase

    const span = {
        start: state.control.token.span.start,
        end: state.control.token.span.end
    }

    const symbol = state.control.token.symbol
    const word = state.control.token.word
    const kind = state.control.token.kind
    const index = state.control.index + 1

    if (phase == Phase.Start) {
        return begin(state)
    }

    if (phase == Phase.End) {
        return finish(state)
    }

    if (phase == Phase.Binding && !state.control.type_only && word == Keyword.Type) {
        return {
            ...state,
            control: {
                ...state.control,
                type_only: true,
                index: index
            }
        }
    }

    if (phase == Phase.Binding && state.control.exported && symbol == Symbol.Star) {
        return {
            ...state,
            control: {
                ...state.control,
                named: true,
                wildcard: true,
                phase: Phase.From,
                index: index
            }
        }
    }

    if (phase == Phase.Separator && word == Keyword.As && !state.control.aliased) {
        return {
            ...state,
            control: {
                ...state.control,
                aliased: true,
                phase: Phase.Alias,
                index: index
            }
        }
    }

    if (phase == Phase.Alias) {
        if (
            kind != Kind.Identifier &&
                !(state.control.exported && word == Keyword.Default)
        ) {
            return fail({
                state: state,
                span: span,
                message: expected_alias
            })
        }

        return {
            ...state,
            names:
                state.names.with(state.control.first + state.control.count - 1, span),
            control: {
                ...state.control,
                phase: Phase.Separator,
                index: index
            }
        }
    }

    if (
        phase == Phase.Separator && state.control.default_binding &&
            !state.control.aliased && !state.control.exported
    ) {
        return fail({
            state: state,
            span: span,
            message: default_alias
        })
    }

    if (phase == Phase.Binding && symbol == Symbol.OpenBrace) {
        return {
            ...state,
            control: {
                ...state.control,
                named: true,
                phase: Phase.Name,
                index: index
            }
        }
    }

    if (
        (phase == Phase.Name || phase == Phase.Separator) && symbol == Symbol.CloseBrace
    ) {
        return {
            ...state,
            control: {
                ...state.control,
                phase: Phase.From,
                index: index
            }
        }
    }

    if (phase == Phase.Binding || phase == Phase.Name) {
        if (
            kind != Kind.Identifier &&
                !(phase == Phase.Name && word == Keyword.Default)
        ) {
            return fail({
                state: state,
                span: span,
                message: "expected an identifier"
            })
        }

        const count = state.control.count + 1
        const names = state.names.push(span)[0]

        return {
            ...state,
            names: names,
            sources: state.sources.push(span)[0],
            control: {
                ...state.control,
                phase: phase == Phase.Binding ? Phase.From : Phase.Separator,
                count: count,
                aliased: false,
                default_binding: word == Keyword.Default,
                index: index
            }
        }
    }

    if (phase == Phase.Separator) {
        if (symbol != Symbol.Comma) {
            return fail({
                state: state,
                span: span,
                message: "expected }"
            })
        }

        return {
            ...state,
            control: {
                ...state.control,
                phase: Phase.Name,
                index: index
            }
        }
    }

    if (phase == Phase.From) {
        if (word != Keyword.From) {
            return fail({
                state: state,
                span: span,
                message: "expected from"
            })
        }

        return {
            ...state,
            control: {
                ...state.control,
                phase: Phase.Path,
                index: index
            }
        }
    }

    if (kind != Kind.String) {
        return fail({
            state: state,
            span: span,
            message: "import path must be a string literal"
        })
    }

    return {
        ...state,
        control: {
            ...state.control,
            phase: Phase.End,
            path: span,
            index: index
        }
    }
}
