import type { Diagnostic } from "../../lexer/model"
import type { Span, Token } from "../../lexer/token_model"

export enum Phase {
    Start,
    Binding,
    Name,
    Separator,
    Alias,
    From,
    Path,
    End,
    Done
}

export enum ImportKind {
    Function,
    Enumeration,
    TypeOnly
}

export type Import = {
    kind: ImportKind,
    exported: bool,
    wildcard: bool,
    span: Span,
    path: Span,
    first: u64,
    count: u64
}

export type Control = {
    phase: Phase,
    index: u64,
    start: u64,
    token: Token,
    opening: Span,
    path: Span,
    first: u64,
    count: u64,
    named: bool,
    reference: bool,
    exported: bool,
    wildcard: bool,
    aliased: bool,
    default_binding: bool,
    type_only: bool,
    diagnostic: Diagnostic
}

export type State = {
    imports: Import[],
    names: Span[],
    sources: Span[],
    control: Control
}

export type Session = {
    tokens: Token[],
    state: State
}
