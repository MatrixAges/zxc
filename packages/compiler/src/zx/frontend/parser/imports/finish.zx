import { Kind, Symbol } from "../../lexer/token_model"
import begin from "./begin"
import fail from "./fail"
import { ImportKind } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: owned Input): Output {
  const span = { start: in.control.token.span.start, end: in.control.token.span.end }

  if (in.control.token.symbol == Symbol.Semicolon) {
    return fail({ state: in, span: span, message: "semicolons are not allowed in ZX" })
  }

  if (in.control.token.kind != Kind.Eof && in.control.token.symbol != Symbol.CloseBrace && !in.control.token.line_break) {
    return fail({ state: in, span: span, message: "expected a newline, closing block or end of source" })
  }

  const opening = { start: in.control.opening.start, end: in.control.opening.end }

  if (in.control.count == 0) {
    return fail({ state: in, span: opening, message: "an import must bind at least one name" })
  }

  if (in.control.type_only && !in.control.named) {
    return fail({ state: in, span: opening, message: "type imports require named bindings" })
  }

  const kind = in.control.type_only ? ImportKind.TypeOnly : in.control.named ? ImportKind.Enumeration : ImportKind.Function

  const item = {
    kind: kind, span: { start: in.control.opening.start, end: in.control.path.end },
    path: { start: in.control.path.start, end: in.control.path.end },
    first: in.control.first, count: in.control.count
  }

  const imports = in.imports.push(item)[0]

  return begin({ imports: imports, names: in.names, control: in.control })
}
