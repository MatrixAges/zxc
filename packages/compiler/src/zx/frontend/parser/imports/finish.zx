import { Kind, Symbol } from "../../lexer/token_model"
import begin from "./begin"
import fail from "./fail"
import { ImportKind } from "./model"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const span = {
        start: in.control.token.span.start,
        end: in.control.token.span.end
    }

    if (in.control.token.symbol == Symbol.Semicolon) {
        return fail({
            state: in,
            span,
            message: "semicolons are not allowed in ZX"
        })
    }

    const condition = (
        - in.control.token.kind != Kind.Eof
        - and in.control.token.symbol != Symbol.CloseBrace
        - and !in.control.token.line_break
    )

    if (condition) {
        return fail({
            state: in,
            span,
            message: "expected a newline, closing block or end of source"
        })
    }

    const opening = {
        start: in.control.opening.start,
        end: in.control.opening.end
    }

    if (in.control.count == 0 && !in.control.wildcard) {
        return fail({
            state: in,
            span: opening,
            message: "an import must bind at least one name"
        })
    }

    if (in.control.type_only && !in.control.named) {
        return fail({
            state: in,
            span: opening,
            message: "type imports require named bindings"
        })
    }

    return match {
        in.control.type_only => ImportKind.TypeOnly,
        in.control.named => ImportKind.Enumeration,
        _ => ImportKind.Function
    }
        -> {
            kind: _,
            exported: in.control.exported,
            wildcard: in.control.wildcard,
            span: {
                start: in.control.opening.start,
                end: in.control.path.end
            },
            path: {
                start: in.control.path.start,
                end: in.control.path.end
            },
            first: in.control.first,
            count: in.control.count
        }
        -> in.imports.push(_)[0]
        -> begin({
            ...in,
            imports: _
        })
}
