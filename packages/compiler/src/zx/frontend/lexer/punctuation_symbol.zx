import {
    ascii_ampersand,
    ascii_asterisk,
    ascii_bang,
    ascii_close_brace,
    ascii_close_bracket,
    ascii_close_paren,
    ascii_colon,
    ascii_comma,
    ascii_dot,
    ascii_equals,
    ascii_greater_than,
    ascii_less_than,
    ascii_minus,
    ascii_open_brace,
    ascii_open_bracket,
    ascii_open_paren,
    ascii_percent,
    ascii_plus,
    ascii_question,
    ascii_semicolon,
    ascii_slash
} from "core/ascii/const"

import { Symbol } from "./token_model"

export type Input = {
    byte: u8,
    next: u8,
    length: u64
}

export type Output = Symbol

export default function (in: Input): Output {
    if (in.length == 3) {
        return Symbol.Spread
    }

    if (in.length == 2) {
        return match in.byte {
            ascii_equals => in.next == ascii_greater_than ? Symbol.Arrow : Symbol.Equal,
            ascii_minus => Symbol.Pipeline,
            ascii_bang => Symbol.NotEqual,
            ascii_less_than => Symbol.LessEqual,
            ascii_greater_than => Symbol.GreaterEqual,
            ascii_question => Symbol.Coalesce,
            ascii_ampersand => Symbol.And,
            _ => Symbol.Or
        }
    }

    return match in.byte {
        ascii_open_brace => Symbol.OpenBrace,
        ascii_close_brace => Symbol.CloseBrace,
        ascii_open_paren => Symbol.OpenParen,
        ascii_close_paren => Symbol.CloseParen,
        ascii_open_bracket => Symbol.OpenBracket,
        ascii_close_bracket => Symbol.CloseBracket,
        ascii_colon => Symbol.Colon,
        ascii_semicolon => Symbol.Semicolon,
        ascii_comma => Symbol.Comma,
        ascii_dot => Symbol.Dot,
        ascii_question => Symbol.Question,
        ascii_plus => Symbol.Plus,
        ascii_minus => Symbol.Minus,
        ascii_asterisk => Symbol.Star,
        ascii_slash => Symbol.Slash,
        ascii_percent => Symbol.Percent,
        ascii_less_than => Symbol.Less,
        ascii_greater_than => Symbol.Greater,
        ascii_equals => Symbol.Assign,
        ascii_bang => Symbol.Not,
        ascii_ampersand => Symbol.Ampersand,
        _ => Symbol.Pipe
    }
}
