import {
    ascii_ampersand,
    ascii_asterisk,
    ascii_bang,
    ascii_close_brace,
    ascii_close_bracket,
    ascii_close_paren,
    ascii_colon,
    ascii_comma,
    ascii_dot,
    ascii_equals,
    ascii_greater_than,
    ascii_less_than,
    ascii_minus,
    ascii_open_brace,
    ascii_open_bracket,
    ascii_open_paren,
    ascii_percent,
    ascii_plus,
    ascii_question,
    ascii_semicolon,
    ascii_slash
} from "core/ascii/const"

import { Symbol } from "./token_model"

export type Input = {
    byte: u8,
    next: u8,
    length: u64
}

export type Output = Symbol

export default function (in: Input): Output {
    if (in.length == 3) {
        return Symbol.Spread
    }

    if (in.length == 2) {
        return match {
            in.byte == ascii_equals && in.next == ascii_greater_than => Symbol.Arrow,
            in.byte == ascii_equals => Symbol.Equal,
            in.byte == ascii_bang => Symbol.NotEqual,
            in.byte == ascii_less_than => Symbol.LessEqual,
            in.byte == ascii_greater_than => Symbol.GreaterEqual,
            in.byte == ascii_question => Symbol.Coalesce,
            in.byte == ascii_ampersand => Symbol.And,
            _ => Symbol.Or
        }
    }

    return match {
        in.byte == ascii_open_brace => Symbol.OpenBrace,
        in.byte == ascii_close_brace => Symbol.CloseBrace,
        in.byte == ascii_open_paren => Symbol.OpenParen,
        in.byte == ascii_close_paren => Symbol.CloseParen,
        in.byte == ascii_open_bracket => Symbol.OpenBracket,
        in.byte == ascii_close_bracket => Symbol.CloseBracket,
        in.byte == ascii_colon => Symbol.Colon,
        in.byte == ascii_semicolon => Symbol.Semicolon,
        in.byte == ascii_comma => Symbol.Comma,
        in.byte == ascii_dot => Symbol.Dot,
        in.byte == ascii_question => Symbol.Question,
        in.byte == ascii_plus => Symbol.Plus,
        in.byte == ascii_minus => Symbol.Minus,
        in.byte == ascii_asterisk => Symbol.Star,
        in.byte == ascii_slash => Symbol.Slash,
        in.byte == ascii_percent => Symbol.Percent,
        in.byte == ascii_less_than => Symbol.Less,
        in.byte == ascii_greater_than => Symbol.Greater,
        in.byte == ascii_equals => Symbol.Assign,
        in.byte == ascii_bang => Symbol.Not,
        in.byte == ascii_ampersand => Symbol.Ampersand,
        _ => Symbol.Pipe
    }
}
