      _ => Keyword.Dead
    }
    case Keyword.Fu: return match {
      in.byte == 110 => Keyword.Fun,
      _ => Keyword.Dead
    }
    case Keyword.Fun: return match {
      in.byte == 99 => Keyword.Func,
      _ => Keyword.Dead
    }
    case Keyword.Func: return match {
      in.byte == 116 => Keyword.Funct,
      _ => Keyword.Dead
    }
    case Keyword.Funct: return match {
      in.byte == 105 => Keyword.Functi,
      _ => Keyword.Dead
    }
    case Keyword.Functi: return match {
      in.byte == 111 => Keyword.Functio,
      _ => Keyword.Dead
    }
    case Keyword.Functio: return match {
      in.byte == 110 => Keyword.Function,
      _ => Keyword.Dead
    }
    case Keyword.I: return match {
      in.byte == 102 => Keyword.If,
      in.byte == 109 => Keyword.Im,
      in.byte == 110 => Keyword.In,
      in.byte == 111 => Keyword.Io,
