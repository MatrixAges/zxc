import { Keyword } from "./keyword_model"
import a from "./keyword_transition/a"
import b from "./keyword_transition/b"
import c from "./keyword_transition/c"
import d from "./keyword_transition/d"
import e from "./keyword_transition/e"
import f from "./keyword_transition/f"
import i from "./keyword_transition/i"
import l from "./keyword_transition/l"
import m from "./keyword_transition/m"
import n from "./keyword_transition/n"
import p from "./keyword_transition/p"
import q from "./keyword_transition/q"
import r from "./keyword_transition/r"
import s from "./keyword_transition/s"
import t from "./keyword_transition/t"
import u from "./keyword_transition/u"
import upperI from "./keyword_transition/upper_i"
import upperO from "./keyword_transition/upper_o"
import v from "./keyword_transition/v"
import w from "./keyword_transition/w"

export type Input = { keyword: Keyword, byte: u8 }

export type Output = Keyword

export default function (in: Input): Output {
    switch (in.keyword) {
        case Keyword.Root: return match {
            in.byte == 73 => Keyword.UpperI,
            in.byte == 79 => Keyword.UpperO,
            in.byte == 95 => Keyword.Underscore,
            in.byte == 97 => Keyword.A,
            in.byte == 98 => Keyword.B,
            in.byte == 99 => Keyword.C,
            in.byte == 100 => Keyword.D,
            in.byte == 101 => Keyword.E,
            in.byte == 102 => Keyword.F,
            in.byte == 105 => Keyword.I,
            in.byte == 108 => Keyword.L,
            in.byte == 109 => Keyword.M,
            in.byte == 110 => Keyword.N,
            in.byte == 112 => Keyword.P,
            in.byte == 113 => Keyword.Q,
            in.byte == 114 => Keyword.R,
            in.byte == 115 => Keyword.S,
            in.byte == 116 => Keyword.T,
            in.byte == 117 => Keyword.U,
            in.byte == 118 => Keyword.V,
            in.byte == 119 => Keyword.W,
            _ => Keyword.Dead
        }
        case Keyword.UpperI: return upperI(in)
        case Keyword.UpperIn: return upperI(in)
        case Keyword.UpperInp: return upperI(in)
        case Keyword.UpperInpu: return upperI(in)
        case Keyword.UpperO: return upperO(in)
        case Keyword.UpperOu: return upperO(in)
        case Keyword.UpperOut: return upperO(in)
        case Keyword.UpperOutp: return upperO(in)
        case Keyword.UpperOutpu: return upperO(in)
        case Keyword.A: return a(in)
        case Keyword.Al: return a(in)
        case Keyword.All: return a(in)
        case Keyword.Allo: return a(in)
        case Keyword.Alloc: return a(in)
        case Keyword.Alloca: return a(in)
        case Keyword.Allocat: return a(in)
        case Keyword.Allocato: return a(in)
        case Keyword.As: return a(in)
        case Keyword.Asy: return a(in)
        case Keyword.Asyn: return a(in)
        case Keyword.Aw: return a(in)
        case Keyword.Awa: return a(in)
        case Keyword.Awai: return a(in)
        case Keyword.B: return b(in)
        case Keyword.Br: return b(in)
        case Keyword.Bre: return b(in)
        case Keyword.Brea: return b(in)
        case Keyword.C: return c(in)
        case Keyword.Ca: return c(in)
        case Keyword.Can: return c(in)
        case Keyword.Canc: return c(in)
        case Keyword.Cance: return c(in)
        case Keyword.Cas: return c(in)
        case Keyword.Co: return c(in)
        case Keyword.Con: return c(in)
        case Keyword.Conc: return c(in)
        case Keyword.Concu: return c(in)
        case Keyword.Concur: return c(in)
        case Keyword.Concurr: return c(in)
        case Keyword.Concurre: return c(in)
        case Keyword.Concurren: return c(in)
        case Keyword.Cons: return c(in)
        case Keyword.D: return d(in)
        case Keyword.De: return d(in)
        case Keyword.Dec: return d(in)
        case Keyword.Decl: return d(in)
        case Keyword.Decla: return d(in)
        case Keyword.Declar: return d(in)
        case Keyword.Def: return d(in)
        case Keyword.Defa: return d(in)
        case Keyword.Defau: return d(in)
        case Keyword.Defaul: return d(in)
        case Keyword.Del: return d(in)
        case Keyword.Dele: return d(in)
        case Keyword.Delet: return d(in)
        case Keyword.E: return e(in)
        case Keyword.El: return e(in)
        case Keyword.Els: return e(in)
        case Keyword.En: return e(in)
        case Keyword.Ens: return e(in)
        case Keyword.Ensu: return e(in)
        case Keyword.Ensur: return e(in)
        case Keyword.Ensure: return e(in)
        case Keyword.Enu: return e(in)
        case Keyword.Ex: return e(in)
        case Keyword.Exp: return e(in)
        case Keyword.Expo: return e(in)
        case Keyword.Expor: return e(in)
        case Keyword.F: return f(in)
        case Keyword.Fa: return f(in)
        case Keyword.Fal: return f(in)
        case Keyword.Fals: return f(in)
        case Keyword.Fo: return f(in)
        case Keyword.Fr: return f(in)
        case Keyword.Fro: return f(in)
        case Keyword.Fu: return f(in)
        case Keyword.Fun: return f(in)
        case Keyword.Func: return f(in)
        case Keyword.Funct: return f(in)
        case Keyword.Functi: return f(in)
        case Keyword.Functio: return f(in)
        case Keyword.I: return i(in)
        case Keyword.Im: return i(in)
        case Keyword.Imp: return i(in)
        case Keyword.Impo: return i(in)
        case Keyword.Impor: return i(in)
        case Keyword.In: return i(in)
        case Keyword.Ins: return i(in)
        case Keyword.Inse: return i(in)
        case Keyword.Inser: return i(in)
        case Keyword.L: return l(in)
        case Keyword.Le: return l(in)
        case Keyword.Lo: return l(in)
        case Keyword.Loo: return l(in)
        case Keyword.M: return m(in)
        case Keyword.Ma: return m(in)
        case Keyword.Mat: return m(in)
        case Keyword.Matc: return m(in)
        case Keyword.N: return n(in)
        case Keyword.Ne: return n(in)
        case Keyword.Nex: return n(in)
        case Keyword.Nu: return n(in)
        case Keyword.Nul: return n(in)
        case Keyword.P: return p(in)
        case Keyword.Pr: return p(in)
        case Keyword.Pro: return p(in)
        case Keyword.Proc: return p(in)
        case Keyword.Proce: return p(in)
        case Keyword.Proces: return p(in)
        case Keyword.Q: return q(in)
        case Keyword.Qu: return q(in)
        case Keyword.Que: return q(in)
        case Keyword.Quer: return q(in)
        case Keyword.Query: return q(in)
        case Keyword.QueryM: return q(in)
        case Keyword.QueryMa: return q(in)
        case Keyword.QueryMan: return q(in)
        case Keyword.QueryO: return q(in)
        case Keyword.QueryOn: return q(in)
        case Keyword.R: return r(in)
        case Keyword.Re: return r(in)
        case Keyword.Req: return r(in)
        case Keyword.Requ: return r(in)
        case Keyword.Requi: return r(in)
        case Keyword.Requir: return r(in)
        case Keyword.Require: return r(in)
        case Keyword.Ret: return r(in)
        case Keyword.Retu: return r(in)
        case Keyword.Retur: return r(in)
        case Keyword.S: return s(in)
        case Keyword.St: return s(in)
        case Keyword.Sto: return s(in)
        case Keyword.Stor: return s(in)
        case Keyword.Sw: return s(in)
        case Keyword.Swi: return s(in)
        case Keyword.Swit: return s(in)
        case Keyword.Switc: return s(in)
        case Keyword.T: return t(in)
        case Keyword.Th: return t(in)
        case Keyword.Thr: return t(in)
        case Keyword.Thro: return t(in)
        case Keyword.Throw: return t(in)
        case Keyword.Tr: return t(in)
        case Keyword.Tra: return t(in)
        case Keyword.Tran: return t(in)
        case Keyword.Trans: return t(in)
        case Keyword.Transa: return t(in)
        case Keyword.Transac: return t(in)
        case Keyword.Transact: return t(in)
        case Keyword.Transacti: return t(in)
        case Keyword.Transactio: return t(in)
        case Keyword.Tru: return t(in)
        case Keyword.Ty: return t(in)
        case Keyword.Typ: return t(in)
        case Keyword.U: return u(in)
        case Keyword.Up: return u(in)
        case Keyword.Upd: return u(in)
        case Keyword.Upda: return u(in)
        case Keyword.Updat: return u(in)
        case Keyword.V: return v(in)
        case Keyword.Va: return v(in)
        case Keyword.W: return w(in)
        case Keyword.Wh: return w(in)
        case Keyword.Whi: return w(in)
        case Keyword.Whil: return w(in)
        default: return Keyword.Dead
    }
}
