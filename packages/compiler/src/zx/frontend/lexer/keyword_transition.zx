      _ => Keyword.Dead
    }
    case Keyword.Concurre: return match {
      in.byte == 110 => Keyword.Concurren,
      _ => Keyword.Dead
    }
    case Keyword.Concurren: return match {
      in.byte == 116 => Keyword.Concurrent,
      _ => Keyword.Dead
    }
    case Keyword.Cons: return match {
      in.byte == 116 => Keyword.Const,
      _ => Keyword.Dead
    }
    case Keyword.D: return match {
      in.byte == 101 => Keyword.De,
      in.byte == 111 => Keyword.Do,
      _ => Keyword.Dead
    }
    case Keyword.De: return match {
      in.byte == 99 => Keyword.Dec,
      in.byte == 102 => Keyword.Def,
      in.byte == 108 => Keyword.Del,
      _ => Keyword.Dead
    }
    case Keyword.Dec: return match {
      in.byte == 108 => Keyword.Decl,
      _ => Keyword.Dead
    }
    case Keyword.Decl: return match {
      in.byte == 97 => Keyword.Decla,
