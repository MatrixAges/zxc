    case Keyword.M: return match {
      in.byte == 97 => Keyword.Ma,
      _ => Keyword.Dead
    }
    case Keyword.Ma: return match {
      in.byte == 116 => Keyword.Mat,
      _ => Keyword.Dead
    }
    case Keyword.Mat: return match {
      in.byte == 99 => Keyword.Matc,
      _ => Keyword.Dead
    }
    case Keyword.Matc: return match {
      in.byte == 104 => Keyword.Match,
      _ => Keyword.Dead
    }
    case Keyword.N: return match {
      in.byte == 101 => Keyword.Ne,
      in.byte == 117 => Keyword.Nu,
      _ => Keyword.Dead
    }
    case Keyword.Ne: return match {
      in.byte == 119 => Keyword.New,
      in.byte == 120 => Keyword.Nex,
      _ => Keyword.Dead
    }
    case Keyword.Nex: return match {
