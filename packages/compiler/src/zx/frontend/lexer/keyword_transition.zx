import { Keyword } from "./keyword_model"

export type Input = { keyword: Keyword, byte: u8 }

export type Output = Keyword

export default function (in: Input): Output {
  switch (in.keyword) {
    case Keyword.Root: return match {
      in.byte == 73 => Keyword.UpperI,
      in.byte == 79 => Keyword.UpperO,
      in.byte == 95 => Keyword.Underscore,
      in.byte == 97 => Keyword.A,
      in.byte == 98 => Keyword.B,
      in.byte == 99 => Keyword.C,
      in.byte == 100 => Keyword.D,
      in.byte == 101 => Keyword.E,
      in.byte == 102 => Keyword.F,
      in.byte == 105 => Keyword.I,
      in.byte == 108 => Keyword.L,
      in.byte == 109 => Keyword.M,
      in.byte == 110 => Keyword.N,
      in.byte == 112 => Keyword.P,
      in.byte == 113 => Keyword.Q,
      in.byte == 114 => Keyword.R,
      in.byte == 115 => Keyword.S,
      in.byte == 116 => Keyword.T,
      in.byte == 117 => Keyword.U,
      in.byte == 118 => Keyword.V,
      in.byte == 119 => Keyword.W,
      _ => Keyword.Dead
    }
    case Keyword.UpperI: return match {
      in.byte == 110 => Keyword.UpperIn,
      _ => Keyword.Dead
    }
    case Keyword.UpperIn: return match {
      in.byte == 112 => Keyword.UpperInp,
      _ => Keyword.Dead
    }
    case Keyword.UpperInp: return match {
      in.byte == 117 => Keyword.UpperInpu,
      _ => Keyword.Dead
    }
    case Keyword.UpperInpu: return match {
      in.byte == 116 => Keyword.UpperInput,
      _ => Keyword.Dead
    }
    case Keyword.UpperO: return match {
      in.byte == 117 => Keyword.UpperOu,
      _ => Keyword.Dead
    }
    case Keyword.UpperOu: return match {
      in.byte == 116 => Keyword.UpperOut,
      _ => Keyword.Dead
    }
    case Keyword.UpperOut: return match {
      in.byte == 112 => Keyword.UpperOutp,
      _ => Keyword.Dead
    }
    case Keyword.UpperOutp: return match {
      in.byte == 117 => Keyword.UpperOutpu,
      _ => Keyword.Dead
    }
    case Keyword.UpperOutpu: return match {
      in.byte == 116 => Keyword.UpperOutput,
      _ => Keyword.Dead
    }
    case Keyword.A: return match {
      in.byte == 108 => Keyword.Al,
      in.byte == 115 => Keyword.As,
      in.byte == 119 => Keyword.Aw,
      _ => Keyword.Dead
    }
    case Keyword.Al: return match {
      in.byte == 108 => Keyword.All,
      _ => Keyword.Dead
    }
    case Keyword.All: return match {
      in.byte == 111 => Keyword.Allo,
      _ => Keyword.Dead
    }
    case Keyword.Allo: return match {
      in.byte == 99 => Keyword.Alloc,
      _ => Keyword.Dead
    }
    case Keyword.Alloc: return match {
      in.byte == 97 => Keyword.Alloca,
      _ => Keyword.Dead
    }
    case Keyword.Alloca: return match {
      in.byte == 116 => Keyword.Allocat,
      _ => Keyword.Dead
    }
    case Keyword.Allocat: return match {
      in.byte == 111 => Keyword.Allocato,
      _ => Keyword.Dead
    }
    case Keyword.Allocato: return match {
      in.byte == 114 => Keyword.Allocator,
      _ => Keyword.Dead
    }
    case Keyword.As: return match {
      in.byte == 121 => Keyword.Asy,
      _ => Keyword.Dead
    }
    case Keyword.Asy: return match {
      in.byte == 110 => Keyword.Asyn,
      _ => Keyword.Dead
    }
    case Keyword.Asyn: return match {
      in.byte == 99 => Keyword.Async,
      _ => Keyword.Dead
    }
    case Keyword.Aw: return match {
      in.byte == 97 => Keyword.Awa,
      _ => Keyword.Dead
    }
    case Keyword.Awa: return match {
      in.byte == 105 => Keyword.Awai,
      _ => Keyword.Dead
    }
    case Keyword.Awai: return match {
      in.byte == 116 => Keyword.Await,
      _ => Keyword.Dead
    }
    case Keyword.B: return match {
      in.byte == 114 => Keyword.Br,
      _ => Keyword.Dead
    }
    case Keyword.Br: return match {
      in.byte == 101 => Keyword.Bre,
      _ => Keyword.Dead
    }
    case Keyword.Bre: return match {
      in.byte == 97 => Keyword.Brea,
      _ => Keyword.Dead
    }
    case Keyword.Brea: return match {
      in.byte == 107 => Keyword.Break,
      _ => Keyword.Dead
    }
    case Keyword.C: return match {
      in.byte == 97 => Keyword.Ca,
      in.byte == 111 => Keyword.Co,
      _ => Keyword.Dead
    }
    case Keyword.Ca: return match {
