import {
    ascii_dot,
    ascii_lower_e,
    ascii_minus,
    ascii_plus,
    ascii_upper_e
} from "core/ascii/const"
import { ascii_underscore } from "core/const"

import isDigit from "./is_digit"
import { Phase } from "./number_state"

import type { State } from "./number_state"

export type Input = {
    state: State
    byte: u8
}

export type Output = State

export default function (in: Input): Output {
    if (in.state.phase == Phase.Done) {
        return {
            end: in.state.end,
            phase: in.state.phase,
            last_byte: in.state.last_byte,
            separators_valid: in.state.separators_valid
        }
    }

    if (in.state.phase == Phase.FractionStart) {
        if (isDigit(in.byte)) {
            return {
                ...in.state,
                end: in.state.end + 2,
                phase: Phase.Fraction,
                last_byte: in.byte,
                separators_valid:
                    in.state.separators_valid && in.state.last_byte != ascii_underscore
            }
        }

        return {
            ...in.state,
            phase: Phase.Done
        }
    }

    if (isDigit(in.byte)) {
        return {
            ...in.state,
            end: in.state.end + 1,
            phase: in.state.phase == Phase.ExponentStart ? Phase.ExponentDigits :
                in.state.phase,
            last_byte: in.byte
        }
    }

    if (in.byte == ascii_underscore) {
        return {
            ...in.state,
            end: in.state.end + 1,
            phase: in.state.phase == Phase.ExponentStart ? Phase.ExponentDigits :
                in.state.phase,
            last_byte: in.byte,
            separators_valid: in.state.separators_valid && isDigit(
                in.state.last_byte
            )
        }
    }

    if (in.state.phase == Phase.Integer && in.byte == ascii_dot) {
        return {
            ...in.state,
            phase: Phase.FractionStart
        }
    }

    if (
        (in.state.phase == Phase.Integer || in.state.phase == Phase.Fraction) &&
            (
                in.byte == ascii_lower_e || in.byte == ascii_upper_e
            )
    ) {
        return {
            ...in.state,
            end: in.state.end + 1,
            phase: Phase.ExponentStart,
            last_byte: in.byte,
            separators_valid:
                in.state.separators_valid && in.state.last_byte != ascii_underscore
        }
    }

    if (
        in.state.phase == Phase.ExponentStart && (
            in.byte == ascii_plus || in.byte == ascii_minus
        )
    ) {
        return {
            ...in.state,
            end: in.state.end + 1,
            phase: Phase.ExponentDigits,
            last_byte: in.byte
        }
    }

    return {
        ...in.state,
        phase: Phase.Done
    }
}
