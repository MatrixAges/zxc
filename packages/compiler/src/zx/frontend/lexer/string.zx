import {
    ascii_backslash,
    ascii_double_quote,
    ascii_lower_n,
    ascii_lower_r,
    ascii_lower_t,
    ascii_space
} from "core/ascii/const"

import {
    kind_string,
    lexical_code,
    unescaped_control,
    unsupported_string_escape
} from "./const"
import emit from "./emit"
import fail from "./fail"
import { Mode } from "./model"

import type { AdvanceInput, LexerState } from "./model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: Input): Output {
    if (in.state.mode == Mode.StringEscape) {
        const condition = (
            - in.byte != ascii_double_quote
            - and in.byte != ascii_backslash
            - and in.byte != ascii_lower_n
            - and in.byte != ascii_lower_r
            - and in.byte != ascii_lower_t
        )

        if (condition) {
            return fail({
                code: lexical_code,
                start: in.state.offset - 1,
                end: in.state.offset + 1,
                message: unsupported_string_escape,
                state: in.state
            })
        }

        return {
            ...in.state,
            mode: Mode.String
        }
    }

    if (in.byte == ascii_double_quote) {
        return emit({
            kind: kind_string,
            start: in.state.start,
            end: in.state.offset + 1,
            comment: false,
            state: {
                ...in.state,
                mode: Mode.Idle
            }
        })
    }

    if (in.byte < ascii_space) {
        return fail({
            code: lexical_code,
            start: in.state.start,
            end: in.state.offset + 1,
            message: unescaped_control,
            state: in.state
        })
    }

    return {
        ...in.state,
        mode: in.byte == ascii_backslash ? Mode.StringEscape : Mode.String
    }
}
