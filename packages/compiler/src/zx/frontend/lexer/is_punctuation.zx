import {
    ascii_ampersand,
    ascii_asterisk,
    ascii_bang,
    ascii_close_brace,
    ascii_close_bracket,
    ascii_close_paren,
    ascii_colon,
    ascii_comma,
    ascii_dot,
    ascii_equals,
    ascii_greater_than,
    ascii_less_than,
    ascii_minus,
    ascii_open_brace,
    ascii_open_bracket,
    ascii_open_paren,
    ascii_percent,
    ascii_pipe,
    ascii_plus,
    ascii_question,
    ascii_semicolon,
    ascii_slash
} from "core/ascii/const"

export type Input = u8

export type Output = bool

export default function (in: Input): Output {
    return (
        - in == ascii_open_brace
        - or in == ascii_close_brace
        - or in == ascii_open_paren
        - or in == ascii_close_paren
        - or in == ascii_colon
        - or in == ascii_semicolon
        - or in == ascii_comma
        - or in == ascii_dot
        - or in == ascii_question
        - or in == ascii_open_bracket
        - or in == ascii_close_bracket
        - or in == ascii_plus
        - or in == ascii_minus
        - or in == ascii_asterisk
        - or in == ascii_slash
        - or in == ascii_percent
        - or in == ascii_less_than
        - or in == ascii_greater_than
        - or in == ascii_equals
        - or in == ascii_bang
        - or in == ascii_ampersand
        - or in == ascii_pipe
    )
}
