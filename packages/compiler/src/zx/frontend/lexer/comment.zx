import {
    ascii_asterisk,
    ascii_carriage_return,
    ascii_line_feed,
    ascii_slash
} from "core/ascii/const"

import emit from "./emit"
import { Mode } from "./model"

import type { AdvanceInput, LexerState } from "./model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: Input): Output {
    const line_break =
        in.state.line_break || in.byte == ascii_line_feed ||
        in.byte == ascii_carriage_return

    const is_line_comment = in.state.mode == Mode.LineComment

    const valid_byte = in.byte == ascii_line_feed || in.byte == ascii_carriage_return

    const condition = (
        - is_line_comment
        - and (valid_byte)
    )

    if (condition) {
        return emit({
            kind: "",
            start: in.state.start,
            end: in.state.offset,
            comment: true,
            state: {
                ...in.state,
                mode: Mode.Idle,
                line_break: true
            }
        })
    }

    const is_block_comment = in.state.mode == Mode.BlockComment

    const condition_2 = (
        - is_block_comment
        - and in.byte == ascii_asterisk
        - and in.has_next
        - and in.next == ascii_slash
    )

    if (condition_2) {
        const return_input = in.state.offset + 2

        return emit({
            kind: "",
            start: in.state.start,
            end: in.state.offset + 2,
            comment: true,
            state: {
                ...in.state,
                skip_until: return_input,
                mode: Mode.Idle
            }
        })
    }

    return {
        ...in.state,
        line_break
    }
}
