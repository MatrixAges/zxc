import {
    ascii_asterisk,
    ascii_carriage_return,
    ascii_line_feed,
    ascii_slash
} from "core/ascii/const"

import emit from "./emit"
import { Mode } from "./model"

import type { AdvanceInput, LexerState } from "./model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: Input): Output {
    const line_break =
        in.state.line_break || in.byte == ascii_line_feed ||
        in.byte == ascii_carriage_return

    if (
        in.state.mode == Mode.LineComment &&
            (in.byte == ascii_line_feed || in.byte == ascii_carriage_return)
    ) {
        return emit({
            kind: "",
            start: in.state.start,
            end: in.state.offset,
            comment: true,
            state: {
                ...in.state,
                mode: Mode.Idle,
                line_break: true
            }
        })
    }

    if (
        in.state.mode == Mode.BlockComment && in.byte == ascii_asterisk && in.has_next &&
            in.next == ascii_slash
    ) {
        return in.state.offset + 2
            -> emit({
                kind: "",
                start: in.state.start,
                end: in.state.offset + 2,
                comment: true,
                state: {
                    ...in.state,
                    skip_until: _,
                    mode: Mode.Idle
                }
            })
    }

    return {
        ...in.state,
        line_break
    }
}
