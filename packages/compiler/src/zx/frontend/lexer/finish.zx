import {
    lexical_code,
    unterminated_block_comment,
    unterminated_interpolation,
    unterminated_string,
    unterminated_template,
    unterminated_template_comment
} from "./const"
import emit from "./emit"
import endIdentifier from "./end_identifier"
import endNumber from "./end_number"
import fail from "./fail"
import { Mode } from "./model"

import type { LexerState } from "./model"

export type Input = LexerState

export type Output = LexerState

export default function (in: Input): Output {
    if (in.diagnostic.message != "" || in.mode == Mode.Idle) {
        return in
    }

    if (in.mode == Mode.Identifier) {
        return endIdentifier(in)
    }

    if (in.mode == Mode.Number) {
        return endNumber(in)
    }

    if (in.mode == Mode.LineComment) {
        return emit({
            kind: "",
            start: in.start,
            end: in.source_length,
            comment: true,
            state: {
                ...in,
                mode: Mode.Idle
            }
        })
    }

    const message = match in.mode {
        Mode.BlockComment => unterminated_block_comment,
        Mode.String => unterminated_string,
        Mode.StringEscape => unterminated_string,
        Mode.Template => unterminated_template,
        Mode.TemplateEscape => unterminated_template,
        Mode.InterpolationBlockComment => unterminated_template_comment,
        _ => unterminated_interpolation
    }

    return fail({
        code: lexical_code,
        start: in.start,
        end: in.source_length,
        message,
        state: in
    })
}
