import {
    ascii_lower_first,
    ascii_lower_last,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

export type Input = u8

export type Output = bool

export default function (in: Input): Output {
    const valid_in = in >= ascii_lower_first && in <= ascii_lower_last

    return (
        - in >= ascii_upper_first
        - and in <= ascii_upper_last
        - or (valid_in)
    )
}
