import { max_nesting_depth } from "core/const"

import { syntax_code, template_nesting_limit } from "../const"
import fail from "../fail"
import { Mode } from "../model"

import type { LexerState } from "../model"

export type Input = LexerState

export type Output = LexerState

export default function (in: Input): Output {
    if (in.mode == Mode.Idle) {
        return in.offset
            -> {
                ...in,
                mode: Mode.Template,
                start: _,
                braces: 0,
                depth: 0
            }
    }

    if (in.depth + 1 > max_nesting_depth) {
        return fail({
            code: syntax_code,
            start: in.offset,
            end: in.offset + 1,
            message: template_nesting_limit,
            state: in
        })
    }

    return {
        mode: in.mode,
        start: in.start,
        braces: in.braces,
        depth: in.depth
    }
        -> in.frames.push(_)[0]
        -> {
            source_length: in.source_length,
            warmed: in.warmed,
            ahead_one: in.ahead_one,
            ahead_two: in.ahead_two,
            keyword_state: in.keyword_state,
            symbol: in.symbol,
            line_break: in.line_break,
            dollar: in.dollar,
            offset: in.offset,
            skip_until: in.skip_until,
            mode: Mode.Template,
            start: in.offset,
            braces: 0,
            depth: in.depth + 1,
            frames: _,
            number: in.number,
            tokens: in.tokens,
            comments: in.comments,
            diagnostic: in.diagnostic
        }
}
