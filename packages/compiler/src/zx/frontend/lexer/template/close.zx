import emit from "../emit"
import { Mode } from "../model"

import type { LexerState } from "../model"

export type Input = LexerState

export type Output = LexerState

export default function (in: owned Input): Output {
  if (in.frames.length == 0) {
    return emit({ kind: "template", start: in.start, end: in.offset + 1, comment: false, state: { ...in, mode: Mode.Idle } })
  }

  const last = in.frames.length - 1
  const mode = in.frames[last].mode
  const start = in.frames[last].start
  const braces = in.frames[last].braces
  const depth = in.frames[last].depth
  const frames = in.frames.pop()[0]

  return {
      source_length: in.source_length, warmed: in.warmed, ahead_one: in.ahead_one, ahead_two: in.ahead_two, keyword: in.keyword,
      symbol: in.symbol,
      line_break: in.line_break,
      dollar: in.dollar,
      offset: in.offset,
      skip_until: in.skip_until,
      mode: mode,
      start: start,
      braces: braces,
      depth: depth,
      frames: frames,
      number: in.number,
      tokens: in.tokens,
      comments: in.comments,
      diagnostic: in.diagnostic
    }
}
