import {
    ascii_asterisk,
    ascii_backslash,
    ascii_backtick,
    ascii_carriage_return,
    ascii_close_brace,
    ascii_dollar,
    ascii_double_quote,
    ascii_line_feed,
    ascii_lower_n,
    ascii_lower_r,
    ascii_lower_t,
    ascii_open_brace,
    ascii_slash
} from "core/ascii/const"

import { lexical_code, unsupported_template_escape } from "../const"
import fail from "../fail"
import { Mode } from "../model"
import close from "./close"
import openInterpolation from "./open_interpolation"
import openTemplate from "./open_template"

import type { AdvanceInput, LexerState } from "../model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: Input): Output {
    if (in.state.mode == Mode.TemplateEscape) {
        const condition = (
            - in.byte != ascii_double_quote
            - and in.byte != ascii_backslash
            - and in.byte != ascii_lower_n
            - and in.byte != ascii_lower_r
            - and in.byte != ascii_lower_t
            - and in.byte != ascii_backtick
            - and in.byte != ascii_dollar
        )

        if (condition) {
            return fail({
                code: lexical_code,
                start: in.state.offset - 1,
                end: in.state.offset + 1,
                message: unsupported_template_escape,
                state: in.state
            })
        }

        return {
            ...in.state,
            mode: Mode.Template
        }
    }

    if (in.state.mode == Mode.Template) {
        if (in.byte == ascii_backtick) {
            return close(in.state)
        }

        if (in.byte == ascii_backslash) {
            return {
                ...in.state,
                mode: Mode.TemplateEscape
            }
        }

        const condition_2 = (
            - in.byte == ascii_dollar
            - and in.has_next
            - and in.next == ascii_open_brace
        )

        if (condition_2) {
            return openInterpolation(in.state)
        }

        return in.state
    }

    if (in.state.mode == Mode.InterpolationStringEscape) {
        return {
            ...in.state,
            mode: Mode.InterpolationString
        }
    }

    if (in.state.mode == Mode.InterpolationString) {
        return {
            ...in.state,
            mode: match in.byte {
                ascii_double_quote => Mode.Interpolation,
                ascii_backslash => Mode.InterpolationStringEscape,
                _ => Mode.InterpolationString
            }
        }
    }

    if (in.state.mode == Mode.InterpolationLineComment) {
        return {
            ...in.state,
            mode: in.byte == ascii_line_feed || in.byte == ascii_carriage_return ?
                Mode.Interpolation :
                Mode.InterpolationLineComment
        }
    }

    if (in.state.mode == Mode.InterpolationBlockComment) {
        const condition_3 = (
            - in.byte == ascii_asterisk
            - and in.has_next
            - and in.next == ascii_slash
        )

        if (condition_3) {
            return in.state.offset + 2
                -> {
                    ...in.state,
                    skip_until: _,
                    mode: Mode.Interpolation
                }
        }

        return in.state
    }

    if (in.byte == ascii_close_brace && in.state.braces == 0) {
        return close(in.state)
    }

    if (in.byte == ascii_open_brace || in.byte == ascii_close_brace) {
        return (
            in.byte == ascii_open_brace ? in.state.braces + 1 :
                in.state.braces - 1
        )
            -> {
                ...in.state,
                braces: _
            }
    }

    if (in.byte == ascii_backtick) {
        return openTemplate(in.state)
    }

    if (in.byte == ascii_double_quote) {
        return {
            ...in.state,
            mode: Mode.InterpolationString
        }
    }

    if (in.byte == ascii_slash && in.has_next) {
        const next = in.next

        if (next == ascii_slash || next == ascii_asterisk) {
            return in.state.offset + 2
                -> {
                    ...in.state,
                    skip_until: _,
                    mode: next == ascii_slash ? Mode.InterpolationLineComment :
                        Mode.InterpolationBlockComment
                }
        }
    }

    return in.state
}
