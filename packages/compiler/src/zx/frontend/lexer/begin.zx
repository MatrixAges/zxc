import {
    ascii_asterisk,
    ascii_backtick,
    ascii_carriage_return,
    ascii_dollar,
    ascii_double_quote,
    ascii_line_feed,
    ascii_slash,
    ascii_space,
    ascii_tab
} from "core/ascii/const"
import { ascii_underscore } from "core/const"

import { kind_punctuation, lexical_code, unexpected_character } from "./const"
import emit from "./emit"
import fail from "./fail"
import isLetter from "./is_letter"
import isPunctuation from "./is_punctuation"
import keywordTransition from "./keyword_transition"
import { Mode } from "./model"
import isDigit from "./number/is_digit"
import { Phase } from "./number/number_state"
import operatorLength from "./operator_length"
import punctuationSymbol from "./punctuation_symbol"
import openTemplate from "./template/open_template"

import type { AdvanceInput, LexerState } from "./model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: Input): Output {
    const line_break =
        in.state.line_break || in.byte == ascii_line_feed ||
        in.byte == ascii_carriage_return

    const offset = in.state.offset

    if (
        in.byte == ascii_space ||
            (in.byte >= ascii_tab && in.byte <= ascii_carriage_return)
    ) {
        return {
            ...in.state,
            line_break
        }
    }

    if (in.byte == ascii_slash && in.has_next) {
        const next = in.next

        if (next == ascii_slash || next == ascii_asterisk) {
            const next_skip_until = offset + 2

            return {
                ...in.state,
                skip_until: next_skip_until,
                mode: next == ascii_slash ? Mode.LineComment : Mode.BlockComment,
                start: offset
            }
        }
    }

    if (
        isLetter(in.byte) || in.byte == ascii_underscore || in.byte == ascii_dollar
    ) {
        return {
            ...in.state,
            keyword_state: keywordTransition({
                state: 0,
                byte: in.byte
            }),
            dollar: in.byte == ascii_dollar,
            mode: Mode.Identifier,
            start: offset
        }
    }

    if (isDigit(in.byte)) {
        return {
            ...in.state,
            mode: Mode.Number,
            start: offset,
            number: {
                end: 1,
                phase: Phase.Integer,
                last_byte: in.byte,
                separators_valid: true
            }
        }
    }

    if (in.byte == ascii_double_quote) {
        return {
            ...in.state,
            mode: Mode.String,
            start: offset
        }
    }

    if (in.byte == ascii_backtick) {
        return openTemplate(in.state)
    }

    if (!isPunctuation(in.byte)) {
        return fail({
            code: lexical_code,
            start: offset,
            end: offset + 1,
            message: unexpected_character,
            state: in.state
        })
    }

    const length = operatorLength({
        byte: in.byte,
        next: in.next,
        after: in.after,
        has_next: in.has_next,
        has_after: in.has_after
    })

    const symbol = punctuationSymbol({
        byte: in.byte,
        next: in.next,
        length
    })

    return offset + length
        -> emit({
            kind: kind_punctuation,
            start: offset,
            end: offset + length,
            comment: false,
            state: {
                ...in.state,
                symbol,
                skip_until: _
            }
        })
}
