import emit from "./emit"
import fail from "./fail"
import isLetter from "./is_letter"
import isPunctuation from "./is_punctuation"
import { Keyword } from "./keyword_model"
import keywordTransition from "./keyword_transition"
import { Mode } from "./model"
import isDigit from "./number/is_digit"
import { Phase } from "./number/number_state"
import operatorLength from "./operator_length"
import punctuationSymbol from "./punctuation_symbol"
import openTemplate from "./template/open_template"

import type { AdvanceInput, LexerState } from "./model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: owned Input): Output {
  const line_break = in.state.line_break || in.byte == 10 || in.byte == 13

  const offset = in.state.offset

  if (in.byte == 32 || (in.byte >= 9 && in.byte <= 13)) {
    return { ...in.state, line_break: line_break }
  }

  if (in.byte == 47 && in.has_next) {
    const next = in.next

    if (next == 47 || next == 42) {
      const next_skip_until = offset + 2

      return { ...in.state, skip_until: next_skip_until, mode: next == 47 ? Mode.LineComment : Mode.BlockComment, start: offset }
    }
  }

  if (isLetter(in.byte) || in.byte == 95 || in.byte == 36) {
    return { ...in.state, keyword: keywordTransition({ keyword: Keyword.Root, byte: in.byte }), dollar: in.byte == 36, mode: Mode.Identifier, start: offset }
  }

  if (isDigit(in.byte)) {
    return { ...in.state, mode: Mode.Number, start: offset, number: { end: 1, phase: Phase.Integer, last_byte: in.byte, separators_valid: true } }
  }

  if (in.byte == 34) {
    return { ...in.state, mode: Mode.String, start: offset }
  }

  if (in.byte == 96) {
    return openTemplate(in.state)
  }

  if (!isPunctuation(in.byte)) {
    return fail({ code: "lexical", start: offset, end: offset + 1, message: "unexpected character", state: in.state })
  }

  const length = operatorLength({ byte: in.byte, next: in.next, after: in.after, has_next: in.has_next, has_after: in.has_after })

  const symbol = punctuationSymbol({ byte: in.byte, next: in.next, length: length })
  const next_skip_until = offset + length

  return emit({ kind: "punctuation", start: offset, end: offset + length, comment: false, state: { ...in.state, symbol: symbol, skip_until: next_skip_until } })
}
