import {
    kind_eof,
    kind_identifier,
    kind_keyword,
    kind_number,
    kind_punctuation,
    kind_string,
    kind_template
} from "./const"
import { Kind } from "./token_model"

export type Input = Kind

export type Output = string

export default function (in: Input): Output {
    return match in {
        Kind.Identifier => kind_identifier,
        Kind.Keyword => kind_keyword,
        Kind.Number => kind_number,
        Kind.String => kind_string,
        Kind.Template => kind_template,
        Kind.Punctuation => kind_punctuation,
        _ => kind_eof
    }
}
