import advance from "./advance"

import type { LexerState } from "./model"

export type Input = LexerState

export type Output = LexerState

export default function (in: Input): Output {
    if (in.diagnostic.message != "" || in.warmed == 0) {
        return in
    }

    const warmed = in.warmed
    const last = in.ahead_two

    const next = advance({
        byte: in.ahead_one,
        next: in.ahead_two,
        after: 0,
        has_next: in.warmed == 2,
        has_after: false,
        state: in
    })

    const advanced = next.offset + 1
        -> {
            ...next,
            offset: _
        }

    if (warmed == 1 || advanced.diagnostic.message != "") {
        return advanced
    }

    const final = advance({
        byte: last,
        next: 0,
        after: 0,
        has_next: false,
        has_after: false,
        state: advanced
    })

    return final.offset + 1
        -> {
            ...final,
            offset: _
        }
}
