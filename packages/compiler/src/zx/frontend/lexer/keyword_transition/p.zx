import { Keyword } from "../keyword_model"

export type Input = { keyword: Keyword, byte: u8 }

export type Output = Keyword

export default function (in: Input): Output {
    switch (in.keyword) {
        case Keyword.P: return match {
            in.byte == 114 => Keyword.Pr,
            _ => Keyword.Dead
        }
        case Keyword.Pr: return match {
            in.byte == 111 => Keyword.Pro,
            _ => Keyword.Dead
        }
        case Keyword.Pro: return match {
            in.byte == 99 => Keyword.Proc,
            _ => Keyword.Dead
        }
        case Keyword.Proc: return match {
            in.byte == 101 => Keyword.Proce,
            _ => Keyword.Dead
        }
        case Keyword.Proce: return match {
            in.byte == 115 => Keyword.Proces,
            _ => Keyword.Dead
        }
        case Keyword.Proces: return match {
            in.byte == 115 => Keyword.Process,
            _ => Keyword.Dead
        }
        default: return Keyword.Dead
    }
}
