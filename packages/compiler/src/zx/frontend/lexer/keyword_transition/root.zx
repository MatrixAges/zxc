export type Input = {
    state: u64,
    byte: u8
}

export type Output = u64

export default function (in: Input): Output {
    switch (in.state) {
        case 0: return match in.byte {
            73 => 2,
            79 => 7,
            95 => 13,
            97 => 14,
            98 => 31,
            99 => 36,
            100 => 55,
            101 => 72,
            102 => 89,
            105 => 106,
            108 => 119,
            109 => 125,
            110 => 130,
            112 => 138,
            113 => 145,
            114 => 157,
            115 => 169,
            116 => 179,
            117 => 201,
            118 => 207,
            119 => 210,
            _ => 1
        }
        default: return 1
    }
}
