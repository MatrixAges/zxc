import { Keyword } from "../keyword_model"

export type Input = { keyword: Keyword, byte: u8 }

export type Output = Keyword

export default function (in: Input): Output {
    switch (in.keyword) {
        case Keyword.L: return match {
            in.byte == 101 => Keyword.Le,
            in.byte == 111 => Keyword.Lo,
            _ => Keyword.Dead
        }
        case Keyword.Le: return match {
            in.byte == 116 => Keyword.Let,
            _ => Keyword.Dead
        }
        case Keyword.Lo: return match {
            in.byte == 111 => Keyword.Loo,
            _ => Keyword.Dead
        }
        case Keyword.Loo: return match {
            in.byte == 112 => Keyword.Loop,
            _ => Keyword.Dead
        }
        default: return Keyword.Dead
    }
}
