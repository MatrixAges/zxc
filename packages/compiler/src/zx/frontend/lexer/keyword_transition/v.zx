export type Input = { state: u64, byte: u8 }

export type Output = u64

export default function (in: Input): Output {
    switch (in.state) {
        case 207: return match {
            in.byte == 97 => 208,
            _ => 1
        }
        case 208: return match {
            in.byte == 114 => 209,
            _ => 1
        }
        default: return 1
    }
}
