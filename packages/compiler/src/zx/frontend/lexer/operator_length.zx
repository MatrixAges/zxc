import {
    ascii_ampersand,
    ascii_bang,
    ascii_dot,
    ascii_equals,
    ascii_greater_than,
    ascii_less_than,
    ascii_minus,
    ascii_pipe,
    ascii_question
} from "core/ascii/const"

export type Input = {
    byte: u8,
    next: u8,
    after: u8,
    has_next: bool,
    has_after: bool
}

export type Output = u64

export default function (in: Input): Output {
    const condition = (
        - in.byte == ascii_dot
        - and in.has_after
        - and in.next == ascii_dot
        - and in.after == ascii_dot
    )

    if (condition) {
        return 3
    }

    const arrow_prefix = in.byte == ascii_equals || in.byte == ascii_minus
    const arrow = arrow_prefix && in.next == ascii_greater_than

    const comparison_prefix = match in.byte {
        ascii_equals => true,
        ascii_bang => true,
        ascii_less_than => true,
        ascii_greater_than => true,
        _ => false
    }

    const comparison = in.next == ascii_equals && comparison_prefix

    const repeated_prefix = match in.byte {
        ascii_question => true,
        ascii_ampersand => true,
        ascii_pipe => true,
        _ => false
    }

    const repeated = in.byte == in.next && repeated_prefix

    const compound = (
        - arrow
        - or comparison
        - or repeated
    )

    const condition_2 = in.has_next && compound

    if (condition_2) {
        return 2
    }

    return 1
}
