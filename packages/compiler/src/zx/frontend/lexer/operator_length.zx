import {
    ascii_ampersand,
    ascii_bang,
    ascii_dot,
    ascii_equals,
    ascii_greater_than,
    ascii_less_than,
    ascii_pipe,
    ascii_question
} from "core/ascii/const"

export type Input = {
    byte: u8,
    next: u8,
    after: u8,
    has_next: bool,
    has_after: bool
}

export type Output = u64

export default function (in: Input): Output {
    if (
        in.byte == ascii_dot && in.has_after && in.next == ascii_dot &&
            in.after == ascii_dot
    ) {
        return 3
    }

    if (
        in.has_next &&
            (
                (in.byte == ascii_equals && in.next == ascii_greater_than) ||
                    (
                        in.next == ascii_equals &&
                            (
                                in.byte == ascii_equals || in.byte == ascii_bang ||
                                    in.byte == ascii_less_than ||
                                    in.byte == ascii_greater_than
                            )
                    ) ||
                    (
                        in.byte == in.next && (
                            in.byte == ascii_question || in.byte == ascii_ampersand ||
                                in.byte == ascii_pipe
                        )
                    )
            )
    ) {
        return 2
    }

    return 1
}
