import {
    ascii_ampersand,
    ascii_bang,
    ascii_dot,
    ascii_equals,
    ascii_greater_than,
    ascii_less_than,
    ascii_minus,
    ascii_pipe,
    ascii_question
} from "core/ascii/const"

export type Input = {
    byte: u8,
    next: u8,
    after: u8,
    has_next: bool,
    has_after: bool
}

export type Output = u64

export default function (in: Input): Output {
    const condition = (
        - in.byte == ascii_dot
        - and in.has_after
        - and in.next == ascii_dot
        - and in.after == ascii_dot
    )

    if (condition) {
        return 3
    }

    const condition_2 = (
        - in.has_next
        - and (
            - in.byte == ascii_equals
            - or in.byte == ascii_minus
            - and in.next == ascii_greater_than
            - or (
                - in.next == ascii_equals
                - and (
                    - in.byte == ascii_equals
                    - or in.byte == ascii_bang
                    - or in.byte == ascii_less_than
                    - or in.byte == ascii_greater_than
                )
            )
            - or (
                - in.byte == in.next
                - and (
                    in.byte == ascii_question || in.byte == ascii_ampersand ||
                        in.byte == ascii_pipe
                )
            )
        )
    )

    if (condition_2) {
        return 2
    }

    return 1
}
