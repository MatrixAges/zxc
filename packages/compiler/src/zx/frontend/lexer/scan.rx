<Module>
    <Type from="./model" as="Model" />

    <Args in={u8[]} out={Model.Result} />

    <Call fn="utf8/validate" in={$in} />

    <If on={$ctx.validate}>
        <Call
            fn="initial"
            in={{
                start: 0,
                end: $in.length
            }}
        />

        <Call
            fn="bytes"
            in={{
                source: $in,
                state: $ctx.initial
            }}
        />

        <Call fn="flush" in={$ctx.bytes} />
        <Call fn="finish" in={$ctx.flush} />

        <If on={$ctx.finish.diagnostic.message == ""}>
            <Call fn="publish" in={$ctx.finish} />

            <Return value={$ctx.publish} />

            <Else>
                <Call fn="failure" in={$ctx.finish.diagnostic} />

                <Return value={$ctx.failure} />
            </Else>
        </If>

        <Else>
            <Call
                fn="failure"
                in={{
                    code: "lexical",
                    start: 0,
                    end: $in.length,
                    message: "source must be valid UTF-8"
                }}
            />

            <Return value={$ctx.failure} />
        </Else>
    </If>
</Module>
