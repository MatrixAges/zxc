import begin from "./begin"
import endNumber from "./end_number"
import isDigit from "./number/is_digit"
import { Phase } from "./number/number_state"
import step from "./number/number_step"

import type { AdvanceInput, LexerState } from "./model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: Input): Output {
    const is_integer = in.state.number.phase == Phase.Integer

    const integer_dot = is_integer && in.byte == 46

    const decimal_boundary = match {
        !integer_dot => false,
        !in.has_next => true,
        _ => !isDigit(in.next)
    }

    const number = step({
        byte: in.byte,
        state: in.state.number
    })

    if (decimal_boundary || number.phase == Phase.Done) {
        const ended = endNumber(in.state)

        if (ended.diagnostic.message != "") {
            return ended
        }

        return begin({
            byte: in.byte,
            next: in.next,
            after: in.after,
            has_next: in.has_next,
            has_after: in.has_after,
            state: ended
        })
    }

    return {
        ...in.state,
        number
    }
}
