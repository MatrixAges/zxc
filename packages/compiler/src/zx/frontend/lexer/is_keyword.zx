import { Keyword } from "./keyword_model"

export type Input = Keyword

export type Output = bool

export default function (in: Input): Output {
    return (
        match in {
            Keyword.Export => true,
            Keyword.Type => true,
            Keyword.Default => true,
            Keyword.Function => true,
            Keyword.Const => true,
            Keyword.If => true,
            Keyword.Else => true,
            Keyword.Return => true,
            Keyword.True => true,
            Keyword.False => true,
            Keyword.Import => true,
            Keyword.Enum => true,
            Keyword.Switch => true,
            Keyword.Null => true,
            Keyword.Let => true,
            Keyword.Var => true,
            Keyword.For => true,
            Keyword.While => true,
            Keyword.New => true,
            Keyword.Throw => true,
            Keyword.Async => true,
            Keyword.Await => true,
            Keyword.Case => true,
            Keyword.Break => true,
            Keyword.Match => true,
            Keyword.Try => true,
            Keyword.Cancel => true,
            _ => false
        }
    )
}
