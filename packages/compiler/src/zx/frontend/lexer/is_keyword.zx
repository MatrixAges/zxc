import { Keyword } from "./keyword_model"

export type Input = Keyword

export type Output = bool

export default function (in: Input): Output {
    return (
        - in == Keyword.Export
        - or in == Keyword.Type
        - or in == Keyword.Default
        - or in == Keyword.Function
        - or in == Keyword.Const
        - or in == Keyword.If
        - or in == Keyword.Else
        - or in == Keyword.Return
        - or in == Keyword.True
        - or in == Keyword.False
        - or in == Keyword.Import
        - or in == Keyword.Enum
        - or in == Keyword.Switch
        - or in == Keyword.Null
        - or in == Keyword.Let
        - or in == Keyword.Var
        - or in == Keyword.For
        - or in == Keyword.While
        - or in == Keyword.New
        - or in == Keyword.Throw
        - or in == Keyword.Async
        - or in == Keyword.Await
        - or in == Keyword.Case
        - or in == Keyword.Break
        - or in == Keyword.Match
        - or in == Keyword.Try
        - or in == Keyword.Cancel
    )
}
