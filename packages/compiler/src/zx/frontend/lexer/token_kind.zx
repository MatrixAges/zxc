import {
    kind_identifier,
    kind_keyword,
    kind_number,
    kind_punctuation,
    kind_string,
    kind_template
} from "./const"
import { Kind } from "./token_model"

export type Input = string

export type Output = Kind

export default function (in: Input): Output {
    return match in {
        kind_identifier => Kind.Identifier,
        kind_keyword => Kind.Keyword,
        kind_number => Kind.Number,
        kind_string => Kind.String,
        kind_template => Kind.Template,
        kind_punctuation => Kind.Punctuation,
        _ => Kind.Eof
    }
}
