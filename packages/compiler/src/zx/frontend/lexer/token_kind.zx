import {
    kind_identifier,
    kind_keyword,
    kind_number,
    kind_punctuation,
    kind_string,
    kind_template
} from "./const"
import { Kind } from "./token_model"

export type Input = string

export type Output = Kind

export default function (in: Input): Output {
    return match {
        in == kind_identifier => Kind.Identifier,
        in == kind_keyword => Kind.Keyword,
        in == kind_number => Kind.Number,
        in == kind_string => Kind.String,
        in == kind_template => Kind.Template,
        in == kind_punctuation => Kind.Punctuation,
        _ => Kind.Eof
    }
}
