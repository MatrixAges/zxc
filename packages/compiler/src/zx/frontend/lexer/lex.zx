import legacyKind from "./legacy_kind"
import scan from "./scan"

import type { Diagnostic } from "./model"
import type { Span } from "./token_model"

export type Token = { kind: string, span: Span }

export type Input = u8[]

export type Output = { tokens: Token[], comments: Span[], diagnostic: Diagnostic }

export default function (in: Input): Output {
  const result = scan(in)
  const tokens = result.tokens.map(token => { kind: legacyKind(token.kind), span: token.span })

  return { tokens: tokens, comments: result.comments, diagnostic: result.diagnostic }
}
