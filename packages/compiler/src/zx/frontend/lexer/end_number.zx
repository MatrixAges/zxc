import { kind_number, lexical_code } from "./const"
import emit from "./emit"
import fail from "./fail"
import { Mode } from "./model"
import result from "./number/number_result"

import type { LexerState } from "./model"

export type Input = LexerState

export type Output = LexerState

export default function (in: Input): Output {
    const number = result(in.number)

    if (number.diagnostic != "") {
        return fail({
            code: lexical_code,
            start: in.start,
            end: in.start + number.end,
            message: number.diagnostic,
            state: in
        })
    }

    return emit({
        kind: kind_number,
        start: in.start,
        end: in.start + number.end,
        comment: false,
        state: {
            ...in,
            mode: Mode.Idle
        }
    })
}
