import type { LexerState } from "./model"
import { Mode } from "./model"
import result from "./number/number_result"
import emit from "./emit"
import fail from "./fail"

export type Input = LexerState

export type Output = LexerState

export default function (in: owned Input): Output {
  const number = result(in.number)

  if (number.diagnostic != "") {
    return fail({ code: "lexical", start: in.start, end: in.start + number.end, message: number.diagnostic, state: in })
  }

  return emit({ kind: "number", start: in.start, end: in.start + number.end, comment: false, state: { ...in, mode: Mode.Idle } })
}
