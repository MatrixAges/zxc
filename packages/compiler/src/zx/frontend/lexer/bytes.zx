import { reduce } from "std:utils"

import tick from "./tick"

import type { LexerState } from "./model"

export type Input = {
    source: u8[],
    state: LexerState
}

export type Output = LexerState

export default function (in: Input): Output {
    return reduce(in.source, (state, byte) => tick({
        byte: byte,
        state: state
    }), in.state)
}
