import {
    hash_primary_modulus,
    hash_secondary_modulus,
    hash_primary_multiplier,
    hash_secondary_multiplier
} from "../const"

export type Input = {
    parent: u64,
    field: u64,
    capacity: u64
}

export type Output = u64

export default function (in: Input): Output {
    const parent =
        ((in.parent % hash_primary_modulus) * hash_primary_multiplier) %
        hash_primary_modulus

    const return_input =
        ((in.field % hash_secondary_modulus) * hash_secondary_multiplier) %
        hash_secondary_modulus

    return (parent + return_input) % in.capacity
}
