import integers from "zig:integers"

import { ExpressionKind } from "../../ir/canonical/expressions/kinds"
import emptySlot from "./empty_slot"
import hash from "./hash"
import lookup from "./lookup"
import projection from "./projection"

import type { Program } from "../ir/input_model"
import type { Built, Roots } from "./model"

export enum Phase { Expression, AncestorStart, Ancestor, Root, Path, Ensure, Grow, Clear, Rehash }

export type Input = { program: Program, references: bool[], roots: Roots }

export type Output = Built

export default function (in: Input): Output {
    const empty: u64[] = []

    const result = loop({ program: in.program, references: in.references, cached: in.roots.cached, heads: in.roots.heads, next: in.roots.next, parents: in.roots.tree.parents, children: in.roots.tree.children, siblings: in.roots.tree.siblings, reference_flags: in.roots.tree.references, bindings: empty, slots: empty, key_parents: empty, key_fields: empty, values: empty, path: empty, phase: Phase.Expression, expression: 0, ancestor: 0, record: 0, path_index: 0, parent: 0, child_expression: 0, direct: false, capacity: 0, cursor: 0, active: true }, {
        while: current => current.active,
        next: current => {
            if (current.phase == Phase.Expression) {
                if (current.expression == current.program.expressions.kinds.length) {
                    current.active = false
                } else {
                    const kind = current.program.expressions.kinds[current.expression]
                    const payload = integers.widen(current.program.expressions.payloads[current.expression])

                    if (kind == ExpressionKind.Reference) {
                        current.bindings = current.bindings.push(integers.widen(current.program.expressions.references[payload]) + 1)[0]
                        current.expression += 1
                    } else if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
                        const field = projection({ expressions: current.program.expressions, id: current.expression })
                        const parent = current.bindings[field.target]

                        if (parent == 0) {
                            current.bindings = current.bindings.push(0)[0]
                            current.phase = Phase.AncestorStart
                        } else {
                            current.parent = parent - 1
                            current.child_expression = current.expression
                            current.direct = true
                            current.phase = Phase.Ensure
                        }
                    } else {
                        current.bindings = current.bindings.push(0)[0]
                        current.expression += 1
                    }
                }
            } else if (current.phase == Phase.AncestorStart) {
                current.ancestor = current.expression
                current.path = current.path.splice(0, 0, [])[1]
                current.phase = Phase.Ancestor
            } else if (current.phase == Phase.Ancestor) {
                const kind = current.program.expressions.kinds[current.ancestor]

                if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
                    const field = projection({ expressions: current.program.expressions, id: current.ancestor })

                    current.path = current.path.push(current.ancestor)[0]
                    current.ancestor = field.target
                    current.record = current.heads[field.target]
                    current.phase = Phase.Root
                } else {
                    current.expression += 1
                    current.phase = Phase.Expression
                }
            } else if (current.phase == Phase.Root) {
                if (current.record == 0) {
                    current.phase = Phase.Ancestor
                } else {
                    current.parent = current.cached.positions[current.record - 1]
                    current.path_index = current.path.length
                    current.phase = Phase.Path
                }
            } else if (current.phase == Phase.Path) {
                if (current.path_index == 0) {
                    current.record = current.next[current.record - 1]
                    current.phase = Phase.Root
                } else {
                    current.child_expression = current.path[current.path_index - 1]
                    current.direct = false
                    current.phase = Phase.Ensure
                }
            } else if (current.phase == Phase.Ensure) {
                const field = projection({ expressions: current.program.expressions, id: current.child_expression })
                const field_index = integers.widen(field.index)
                const location = lookup({ index: { slots: current.slots, parents: current.key_parents, fields: current.key_fields, values: current.values }, key: { parent: current.parent, field: field_index } })

                if (!location.found && (current.slots.length == 0 || current.values.length >= current.slots.length / 2)) {
                    current.capacity = current.slots.length == 0 ? 16 : current.slots.length * 2
                    current.phase = Phase.Grow
                } else {
                    const child = location.found ? location.value : current.parents.length

                    if (!location.found) {
                        const sibling = current.children[current.parent]
                        const type_id = current.program.expressions.types[current.child_expression]

                        current.parents = current.parents.push(current.parent + 1)[0]
                        current.children = current.children.push(0)[0]
                        current.siblings = current.siblings.push(sibling)[0]
                        current.reference_flags = current.reference_flags.push(current.references[integers.widen(type_id)])[0]
                        current.children[current.parent] = child + 1
                        current.key_parents = current.key_parents.push(current.parent)[0]
                        current.key_fields = current.key_fields.push(field_index)[0]
                        current.values = current.values.push(child)[0]
                        current.slots[location.slot] = current.values.length
                    }

                    if (current.direct) {
                        current.bindings = current.bindings.push(child + 1)[0]
                        current.phase = Phase.AncestorStart
                    } else {
                        current.parent = child
                        current.path_index -= 1
                        current.phase = Phase.Path
                    }
                }
            } else if (current.phase == Phase.Grow) {
                if (current.slots.length < current.capacity) {
                    current.slots = current.slots.push(0)[0]
                } else {
                    current.cursor = 0
                    current.phase = Phase.Clear
                }
            } else if (current.phase == Phase.Clear) {
                if (current.cursor < current.slots.length) {
                    current.slots[current.cursor] = 0
                    current.cursor += 1
                } else {
                    current.cursor = 0
                    current.phase = Phase.Rehash
                }
            } else if (current.cursor < current.values.length) {
                const first = hash({ parent: current.key_parents[current.cursor], field: current.key_fields[current.cursor], capacity: current.slots.length })
                const slot = emptySlot({ slots: current.slots, first: first })

                current.slots[slot] = current.cursor + 1
                current.cursor += 1
            } else {
                current.phase = Phase.Ensure
            }
        }
    })

    return { tree: { parents: result.parents, children: result.children, siblings: result.siblings, references: result.reference_flags }, cached: result.cached, slots: result.slots, parents: result.key_parents, fields: result.key_fields, values: result.values }
}
