import referenceType from "./reference_type"

import type { Program } from "./input_model"

export type Input = Program

export type Output = bool[]

export default function (in: Input): Output {
    const initial: bool[] = []

    const result = loop({ types: in.types, index: 0, references: initial }, {
        while: current => current.index < current.types.kinds.length,
        next: current => {
            const reference = referenceType({ types: current.types, id: current.index })

            current.references = current.references.push(reference)[0]
            current.index += 1
        }
    })

    return result.references
}
