<Module>
    <Type from="./references" as="References" />
    <Type from="../loops/model" as="Model" />
    <Type from="../layout/model" as="LayoutModel" />

    <Args
        in={References.Input}
        out={{
            domains: Model.Domains,
            layout: LayoutModel.Built,
            references: bool[],
            returns: bool[]
        }}
    />

    <Call fn="./references" in={$in} />
    <Call fn="../../ir/canonical/control/terminates" in={$in.control} />
    <Call fn="../loops/domains" in={$in} />

    <Call
        fn="../layout/roots"
        in={{
            program: $in,
            references: $ctx.references
        }}
    />

    <Call
        fn="../layout/project"
        in={{
            program: $in,
            references: $ctx.references,
            roots: $ctx.roots
        }}
    />

    <Return
        value={{
            references: $ctx.references,
            returns: $ctx.terminates,
            domains: $ctx.domains,
            layout: $ctx.project
        }}
    />
</Module>
