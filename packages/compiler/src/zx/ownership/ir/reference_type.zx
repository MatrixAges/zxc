import integers from "std:integer"
import { Kind } from "core/type_table/model"
import row from "core/type_table/row"

import type { Tables } from "core/type_table/model"

export type Input = {
    types: Tables,
    id: u64
}

export type Output = bool

export default function (in: Input): Output {
    const result = loop({
        types: in.types,
        target: row({
            tables: in.types,
            id: integers.narrow(in.id)
        })
    }, {
        while: current => current.target.kind == Kind.Optional,
        next: current => {
            current.target = row({
                tables: current.types,
                id: current.target.first
            })
        },
        return: state => state.target
    })

    const valid_result = result.kind == Kind.Scalar && result.first == 10

    return (
        - result.kind == Kind.List
        - or result.kind == Kind.Object
        - or result.kind == Kind.Tuple
        - or result.kind == Kind.Task
        - or (valid_result)
    )
}
