import integers from "std:integer"
import { Kind } from "core/type_table/model"
import row from "core/type_table/row"

import type { Tables } from "core/type_table/model"

export type Input = { types: Tables, id: u64 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ types: in.types, target: row({ tables: in.types, id: integers.narrow(in.id) }) }, {
        while: current => current.target.kind == Kind.Optional,
        next: current => {
            current.target = row({ tables: current.types, id: current.target.first })
        }
    }).target

    return result.kind == Kind.List || result.kind == Kind.Object || result.kind == Kind.Tuple || result.kind == Kind.Task || (result.kind == Kind.Scalar && result.first == 10)
}
