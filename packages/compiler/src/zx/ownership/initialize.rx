<Module>
    <Type from="./ir/references" as="References" />
    <Type from="./runtime/model" as="Model" />
    <Type from="./loops/model" as="LoopsModel" />
    <Type from="./layout/model" as="LayoutModel" />
    <Type from="./runtime/snapshots/model" as="SnapshotsModel" />

    <Args in={References.Input} out={{ memory: Model.Memory, prepared: { domains: LoopsModel.Domains, layout: LayoutModel.Built, references: bool[], returns: bool[] }, snapshots: SnapshotsModel.Stack }} />

    <Call module="./ir/prepare" in={$in} />

    <Call fn="./runtime/initialize" in={{ program: $in, references: $ctx.prepare.references, layout: $ctx.prepare.layout }} />

    <Return value={{ prepared: $ctx.prepare, memory: $ctx.initialize.memory, snapshots: $ctx.initialize.snapshots }} />
</Module>
