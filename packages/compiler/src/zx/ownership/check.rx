<Module>
    <Type from="ir/references" as="References" />
    <Type from="result" as="Result" />

    <Args in={References.Input} out={Result.Output} />

    <Call module="./initialize" in={$in} />

    <Call
        fn="./runtime/execute"
        in={{
            program: $in,
            references: $ctx.initialize.prepared.references,
            returns: $ctx.initialize.prepared.returns,
            domains: $ctx.initialize.prepared.domains,
            layout: $ctx.initialize.prepared.layout,
            runtime: {
                memory: $ctx.initialize.memory,
                snapshots: $ctx.initialize.snapshots
            }
        }}
    />

    <Call
        fn="result"
        in={{
            ...$ctx.execute,
            count: $in.expressions.kinds.length,
            start: $in.expressions.span_start,
            end: $in.expressions.span_end
        }}
    />

    <Return value={$ctx.result} />
</Module>
