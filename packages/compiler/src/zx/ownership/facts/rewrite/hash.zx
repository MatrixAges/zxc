import {
    hash_primary_modulus,
    hash_secondary_modulus,
    hash_primary_multiplier,
    hash_secondary_multiplier
} from "../../const"

export type Input = {
    left: u64,
    right: u64,
    capacity: u64
}

export type Output = u64

export default function (in: Input): Output {
    const left =
        ((in.left % hash_primary_modulus) * hash_primary_multiplier) %
        hash_primary_modulus

    return ((in.right % hash_secondary_modulus) * hash_secondary_multiplier) %
        hash_secondary_modulus
        -> (left + _) % in.capacity
}
