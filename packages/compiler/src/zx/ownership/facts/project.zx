import { fact_copy, fact_moved, first_product_fact } from "./const"

import type { Forest } from "./model"

export type Input = {
    forest: Forest,
    fact: u64,
    index: u64,
    reference: bool
}

export type Output = u64

export default function (in: Input): Output {
    if (in.fact >= first_product_fact) {
        return in.forest
            .children[in.forest.first[in.fact - first_product_fact] + in.index]
    }

    return in.reference || in.fact == fact_moved ? in.fact : fact_copy
}
