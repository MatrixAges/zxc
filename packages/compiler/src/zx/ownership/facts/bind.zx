import { fact_copy, fact_moved } from "./const"
import project from "./project"
import replace from "./replace"
import summary from "./summary"

import type { Tables } from "core/type_table/model"
import type { Layout } from "../places/model"
import type { Storage } from "./storage"

export type Input = {
    types: Tables,
    references: bool[],
    layout: Layout,
    storage: Storage,
    id: u64,
    fact: u64
}

export type Output = Storage

export default function (in: Input): Output {
    const fact = match {
        in.layout.references[in.id] || in.fact == fact_moved => in.fact,
        _ => fact_copy
    }

    if (in.storage.facts[in.id] == fact) {
        return in.storage
    }

    const types = in.types
    const references = in.references
    const layout = in.layout

    const result = loop({
        forest: in.storage.forest,
        facts: in.storage.facts,
        states: in.storage.states,
        id: in.id,
        root: in.id,
        fact,
        ascending: true,
        leaving: false,
        active: true
    }, {
        while: current => current.active,
        next: current => {
            if (current.ascending) {
                current.facts[current.id] = current.fact
                current.states[current.id] = summary({
                    forest: current.forest,
                    fact: current.fact
                })

                const parent = layout.parents[current.id]

                if (parent == 0) {
                    current.root = current.id
                    current.ascending = false
                } else {
                    const changed = replace({
                        types,
                        references,
                        forest: current.forest,
                        fact: current.facts[parent - 1],
                        type_id: layout.types[parent - 1],
                        index: layout.field_indices[current.id],
                        value: current.fact
                    })

                    current.forest = changed.forest
                    current.fact = changed.fact
                    current.id = parent - 1
                }
            } else if (!current.leaving) {
                if (current.id != current.root) {
                    const child_fact_input = layout.parents[current.id] - 1

                    const child_fact = project({
                        forest: current.forest,
                        fact: current.facts[child_fact_input],
                        index: layout.field_indices[current.id],
                        reference: layout.references[current.id]
                    })

                    current.facts[current.id] = child_fact
                    current.states[current.id] = summary({
                        forest: current.forest,
                        fact: child_fact
                    })
                }

                const child = layout.children[current.id]

                if (child == 0) {
                    current.leaving = true
                } else {
                    current.id = child - 1
                }
            } else if (current.id == current.root) {
                current.active = false
            } else {
                const sibling = layout.siblings[current.id]

                if (sibling == 0) {
                    current.id = layout.parents[current.id] - 1
                } else {
                    current.id = sibling - 1
                    current.leaving = false
                }
            }
        }
    })

    return {
        forest: result.forest,
        facts: result.facts,
        states: result.states
    }
}
