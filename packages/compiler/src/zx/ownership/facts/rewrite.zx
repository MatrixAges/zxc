import integers from "std:integer"

import { fact_copy, fact_loaned, first_product_fact } from "./const"
import fieldType from "./field_type"
import product from "./product"
import project from "./project"
import cache from "./rewrite/cache"
import find from "./rewrite/find"
import { RewriteAction } from "./rewrite/model"
import rewind from "./rewrite/rewind"
import same from "./rewrite/same"
import state from "./rewrite/state"
import summary from "./summary"
import uniform from "./uniform"

import type { Tables } from "core/type_table/model"
import type { Forest, Result } from "./model"

export type Input = {
    types: Tables,
    references: bool[],
    forest: Forest,
    left: u64,
    right: u64,
    action: RewriteAction
}

export type Output = Result

export default function (in: Input): Output {
    const empty: u64[] = []

    const paired =
        in.action == RewriteAction.Join || in.action == RewriteAction.ReleaseNewLoans

    const right = paired ? in.right : fact_copy

    const condition = (
        - paired
        - and in.left == right
        - or (
            - in.action == RewriteAction.ReleaseNewLoans
            - and (
                (
                    in.left < first_product_fact && in.left != fact_loaned
                ) || right == fact_loaned
            )
        )
    )

    if (condition) {
        return {
            forest: in.forest,
            fact: in.left
        }
    }

    if (in.left < first_product_fact && right < first_product_fact) {
        return uniform(state({
            left: summary({
                forest: in.forest,
                fact: in.left
            }),
            right: summary({
                forest: in.forest,
                fact: right
            }),
            action: in.action
        }))
            -> {
                forest: in.forest,
                fact: _
            }
    }

    const result = loop({
        types: in.types,
        references: in.references,
        forest: in.forest,
        action: in.action,
        paired,
        left: [in.left],
        right: [right],
        indices: [0],
        first: [0],
        children: empty,
        cache: {
            left: empty,
            right: empty,
            values: empty,
            slots: empty
        },
        value: fact_copy
    }, {
        while: current => current.left.length != 0,
        next: current => {
            const top = current.left.length - 1
            const left = current.left[top]
            const right = current.right[top]
            const first = current.first[top]
            const saved = find({
                cache: current.cache,
                left,
                right
            })
            const identical = current.paired && left == right
            const unchanged =
                (
                    - current.action == RewriteAction.ReleaseNewLoans
                    - and (
                        (
                            left < first_product_fact && left != fact_loaned
                        ) || right == fact_loaned
                    )
                )
            const uniform_pair = left < first_product_fact && right < first_product_fact

            const condition_2 = (
                - saved.found
                - or identical
                - or unchanged
                - or uniform_pair
            )

            if (condition_2) {
                current.value = saved.found ? saved.value : left

                const condition_3 = (
                    - !saved.found
                    - and !identical
                    - and !unchanged
                )

                if (condition_3) {
                    current.value = uniform(state({
                        left: summary({
                            forest: current.forest,
                            fact: left
                        }),
                        right: summary({
                            forest: current.forest,
                            fact: right
                        }),
                        action: current.action
                    }))
                }

                current.left = current.left.pop()[0]
                current.right = current.right.pop()[0]
                current.indices = current.indices.pop()[0]
                current.first = current.first.pop()[0]
                current.children = rewind({
                    values: current.children,
                    count: first
                })

                if (current.left.length != 0) {
                    current.children = current.children.push(current.value)[0]
                }
            } else {
                const node =
                    (left >= first_product_fact ? left : right) - first_product_fact
                const type_id = current.forest.types[node]
                const count = current.forest.count[node]
                const index = current.indices[top]

                if (index < count) {
                    const reference =
                        fieldType({
                            types: current.types,
                            type_id,
                            index
                        })
                        -> current.references[integers.widen(
                            _
                        )]
                    const child_left = project({
                        forest: current.forest,
                        fact: left,
                        index,
                        reference
                    })
                    const child_right = current.paired ? project({
                        forest: current.forest,
                        fact: right,
                        index,
                        reference
                    }) : fact_copy

                    current.indices[top] = index + 1
                    current.left = current.left.push(child_left)[0]
                    current.right = current.right.push(child_right)[0]
                    current.indices = current.indices.push(0)[0]
                    current.first = current.first.push(current.children.length)[0]
                } else {
                    const left_shell = left < first_product_fact ? summary({
                        forest: current.forest,
                        fact: left
                    }) : current.forest.shells[left - first_product_fact]
                    const shell = (right < first_product_fact ? summary({
                        forest: current.forest,
                        fact: right
                    }) : current.forest.shells[right - first_product_fact])
                        -> state({
                            left: left_shell,
                            right: _,
                            action: current.action
                        })
                    const unchanged = same({
                        types: current.types,
                        references: current.references,
                        forest: current.forest,
                        fact: left,
                        type_id,
                        shell,
                        children: current.children,
                        first,
                        count
                    })

                    current.value = left

                    if (!unchanged) {
                        const built = product({
                            forest: current.forest,
                            type_id,
                            shell,
                            children: current.children,
                            first,
                            count
                        })

                        current.forest = built.forest
                        current.value = built.fact
                    }

                    current.cache = cache({
                        cache: current.cache,
                        left,
                        right,
                        value: current.value
                    })
                }
            }
        }
    })

    return {
        forest: result.forest,
        fact: result.value
    }
}
