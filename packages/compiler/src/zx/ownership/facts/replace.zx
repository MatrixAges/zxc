import integers from "zig:integers"
import row from "core/type_table/row"

import fieldType from "./field_type"
import product from "./product"
import project from "./project"
import summary from "./summary"

import type { Tables } from "core/type_table/model"
import type { Forest, Result } from "./model"

export type Input = { types: Tables, references: bool[], forest: Forest, fact: u64, type_id: u32, index: u64, value: u64 }

export type Output = Result

export default function (in: Input): Output {
    const child_type = fieldType({ types: in.types, type_id: in.type_id, index: in.index })
    const previous = project({ forest: in.forest, fact: in.fact, index: in.index, reference: in.references[integers.widen(child_type)] })

    if (previous == in.value) {
        return { forest: in.forest, fact: in.fact }
    }

    const empty: u64[] = []

    const result = loop({ types: in.types, references: in.references, forest: in.forest, fact: in.fact, type_id: in.type_id, target: in.index, value: in.value, count: integers.widen(row({ tables: in.types, id: in.type_id }).second), children: empty, index: 0 }, {
        while: current => current.index < current.count,
        next: current => {
            const child_type = fieldType({ types: current.types, type_id: current.type_id, index: current.index })
            const child = current.index == current.target ? current.value : project({ forest: current.forest, fact: current.fact, index: current.index, reference: current.references[integers.widen(child_type)] })

            current.children = current.children.push(child)[0]
            current.index += 1
        }
    })

    const shell = in.fact < 5 ? summary({ forest: in.forest, fact: in.fact }) : in.forest.shells[in.fact - 5]

    return product({ forest: in.forest, type_id: in.type_id, shell: shell, children: result.children, first: 0, count: result.children.length })
}
