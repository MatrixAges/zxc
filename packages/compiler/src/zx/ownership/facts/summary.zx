import { State } from "../places/model"
import {
    fact_copy,
    fact_owned,
    fact_loaned,
    fact_borrowed,
    first_product_fact
} from "./const"

import type { Forest } from "./model"

export type Input = {
    forest: Forest,
    fact: u64
}

export type Output = State

export default function (in: Input): Output {
    if (in.fact >= first_product_fact) {
        return in.forest.states[in.fact - first_product_fact]
    }

    return match in.fact {
        fact_copy => State.Copy,
        fact_owned => State.Owned,
        fact_loaned => State.Loaned,
        fact_borrowed => State.Borrowed,
        _ => State.Moved
    }
}
