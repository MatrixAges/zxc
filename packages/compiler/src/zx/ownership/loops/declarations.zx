import integers from "zig:integers"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = { expressions: Expressions, expression: u64, locals: bool[] }

export type Output = bool[]

export default function (in: Input): Output {
    const kind = in.expressions.kinds[in.expression]
    const payload = integers.widen(in.expressions.payloads[in.expression])
    const count = match kind { ExpressionKind.Iteration => 2, ExpressionKind.Scope => integers.widen(in.expressions.scope_count[payload]), ExpressionKind.Transform => integers.widen(in.expressions.transform_count[payload]), _ => 0 }

    const result = loop({ expressions: in.expressions, locals: in.locals, kind: kind, payload: payload, count: count, index: 0 }, {
        while: current => current.index < current.count,
        next: current => {
            const symbol: u32? = match current.kind {
                ExpressionKind.Iteration => current.index == 0 ? current.expressions.iteration_condition_parameters[current.payload] : current.expressions.iteration_parameters[current.payload],
                ExpressionKind.Scope => current.expressions.scope_symbols[integers.widen(current.expressions.scope_first[current.payload]) + current.index],
                _ => current.expressions.transform_parameters[integers.widen(current.expressions.transform_first[current.payload]) + current.index]
            }

            if (symbol != null) {
                current.locals[integers.widen(symbol)] = true
            }

            current.index += 1
        }
    })

    return result.locals
}
