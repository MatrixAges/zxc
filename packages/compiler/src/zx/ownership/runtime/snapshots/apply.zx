import bind from "../../facts/bind"
import rewrite from "../../facts/rewrite"
import { RewriteAction } from "../../facts/rewrite/model"
import nextRoot from "../../places/next_root"
import { Action } from "./model"
import restoreMemo from "./restore_memo"

import type { Tables } from "core/type_table/model"
import type { Layout } from "../../places/model"
import type { Memory } from "../model"
import type { Stack } from "./model"

export type Input = {
    types: Tables,
    references: bool[],
    layout: Layout,
    memory: Memory,
    stack: Stack,
    frame: u64,
    action: Action
}

export type Output = Memory

export default function (in: Input): Output {
    if (in.action == Action.RestoreMemo) {
        const first = in.stack.memo_first[in.frame]

        if (in.memory.memo.length == 0) {
            return in.memory
        }

        const memo = restoreMemo({
            memo: in.memory.memo,
            saved: in.stack.memo,
            first
        })

        return {
            ...in.memory,
            memo
        }
    }

    const state_first = in.action == Action.ReleaseAllLoans ? 0 :
        in.stack.state_first[in.frame]

    const rewrite_action =
        match in.action {
            Action.MergeStates => RewriteAction.Join,
            Action.ReleaseNewLoans => RewriteAction.ReleaseNewLoans,
            _ => RewriteAction.ReleaseAllLoans
        }

    return loop({
        types: in.types,
        references: in.references,
        layout: in.layout,
        memory: in.memory,
        saved: in.stack,
        state_first,
        action: in.action,
        rewrite_action,
        count: in.memory.facts.length,
        index: nextRoot({
            parents: in.layout.parents,
            first: 0,
            end: in.memory.facts.length
        })
    }, {
        while: current => current.index < current.count,
        next: current => {
            const saved = current.action == Action.ReleaseAllLoans ? 0 :
                current.saved.facts[current.state_first + current.index]
            const unchanged = current.action != Action.ReleaseAllLoans &&
                saved == current.memory.facts[current.index] &&
                current.layout.references[current.index]

            if (!unchanged) {
                const changed = current.action == Action.RestoreStates ? {
                    forest: current.memory.forest,
                    fact: saved
                } : rewrite({
                    types: current.types,
                    references: current.references,
                    forest: current.memory.forest,
                    left: current.memory.facts[current.index],
                    right: saved,
                    action: current.rewrite_action
                })
                const bound = bind({
                    types: current.types,
                    references: current.references,
                    layout: current.layout,
                    storage: {
                        forest: changed.forest,
                        facts: current.memory.facts,
                        states: current.memory.states
                    },
                    id: current.index,
                    fact: changed.fact
                })

                current.memory = {
                    ...current.memory,
                    forest: bound.forest,
                    facts: bound.facts,
                    states: bound.states
                }
            }

            current.index = nextRoot({
                parents: current.layout.parents,
                first: current.index + 1,
                end: current.count
            })
        },
        return: state => state.memory
    })
}
