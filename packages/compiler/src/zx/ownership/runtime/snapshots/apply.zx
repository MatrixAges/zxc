import bind from "../../facts/bind"
import { fact_copy, fact_loaned, first_product_fact } from "../../facts/const"
import rewrite from "../../facts/rewrite"
import { RewriteAction } from "../../facts/rewrite/model"
import nextRoot from "../../places/next_root"
import { Action } from "./model"
import restoreMemo from "./restore_memo"

import type { Tables } from "core/type_table/model"
import type { Layout } from "../../places/model"
import type { Memory } from "../model"
import type { Stack } from "./model"

export type Input = {
    types: Tables,
    references: bool[],
    layout: Layout,
    memory: Memory,
    stack: Stack,
    frame: u64,
    action: Action
}

export type Output = Memory

export default function (in: Input): Output {
    if (in.action == Action.RestoreMemo) {
        return restoreMemo({
            memory: in.memory,
            first: in.stack.memo_first[in.frame]
        })
    }

    const action = in.action
    const types = in.types
    const references = in.references
    const layout = in.layout
    const saved_facts = in.stack.facts

    const state_first = match {
        action == Action.ReleaseAllLoans => 0,
        _ => in.stack.state_first[in.frame]
    }

    const rewrite_action =
        match action {
            Action.MergeStates => RewriteAction.Join,
            Action.ReleaseNewLoans => RewriteAction.ReleaseNewLoans,
            _ => RewriteAction.ReleaseAllLoans
        }

    return loop({
        memory: in.memory,
        count: in.memory.facts.length,
        index: nextRoot({
            parents: in.layout.parents,
            first: 0,
            end: in.memory.facts.length
        })
    }, {
        while: current => current.index < current.count,
        next: current => {
            const saved = match {
                action == Action.ReleaseAllLoans => fact_copy,
                _ => saved_facts[state_first + current.index]
            }
            const left = current.memory.facts[current.index]
            const unloaned = left < first_product_fact && left != fact_loaned
            const unchanged = match action {
                Action.ReleaseAllLoans => unloaned,
                Action.ReleaseNewLoans =>
                    unloaned || left == saved || saved == fact_loaned,
                _ => left == saved
            }

            if (!unchanged) {
                const changed = match {
                    action == Action.RestoreStates => {
                        forest: current.memory.forest,
                        fact: saved
                    },
                    _ => rewrite({
                        types,
                        references,
                        forest: current.memory.forest,
                        left,
                        right: saved,
                        action: rewrite_action
                    })
                }
                const bound = bind({
                    types,
                    references,
                    layout,
                    storage: {
                        forest: changed.forest,
                        facts: current.memory.facts,
                        states: current.memory.states
                    },
                    id: current.index,
                    fact: changed.fact
                })

                current.memory = {
                    ...current.memory,
                    forest: bound.forest,
                    facts: bound.facts,
                    states: bound.states
                }
            }

            current.index = nextRoot({
                parents: layout.parents,
                first: current.index + 1,
                end: current.count
            })
        },
        return: state => state.memory
    })
}
