import type { Memory } from "../model"

export type Input = {
    memory: Memory,
    first: u64
}

export type Output = Memory

export default function (in: Input): Output {
    const first = in.first

    return loop(in.memory, {
        while: current => current.memo_history.length > first,
        next: current => {
            const index = current.memo_history.length - 2
            const expression = current.memo_history[index]

            current.memo[expression] = current.memo_history[index + 1]
            current.memo_history = current.memo_history.pop()[0]
            current.memo_history = current.memo_history.pop()[0]
        }
    })
}
