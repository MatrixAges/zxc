export type Input = {
    memo: u64[],
    saved: u64[],
    first: u64
}

export type Output = u64[]

export default function (in: Input): Output {
    return loop({
        memo: in.memo,
        saved: in.saved,
        first: in.first,
        index: 0
    }, {
        while: current => current.index < current.memo.length,
        next: current => {
            current.memo[current.index] = current.saved[current.first + current.index]
            current.index += 1
        },
        return: state => state.memo
    })
}
