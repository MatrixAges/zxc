import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import uniform from "../../../facts/uniform"
import projection from "../../../layout/projection"
import { State } from "../../../places/model"
import { WorkAction } from "../../work/model"
import push from "../../work/push"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const condition = (
        match in.kind {
            ExpressionKind.Integer => true,
            ExpressionKind.NegativeInteger => true,
            ExpressionKind.Float => true,
            ExpressionKind.String => true,
            ExpressionKind.Boolean => true,
            ExpressionKind.None => true,
            ExpressionKind.Unit => true,
            ExpressionKind.EnumValue => true,
            ExpressionKind.ErrorValue => true,
            _ => false
        }
    )

    if (condition) {
        return {
            ...in.machine,
            value: uniform(State.Copy)
        }
    }

    if (in.kind == ExpressionKind.StoreGet) {
        return {
            ...in.machine,
            value: uniform(State.Borrowed)
        }
    }

    if (in.kind == ExpressionKind.Some || in.kind == ExpressionKind.OptionalValue) {
        const child = match in.kind {
            ExpressionKind.Some =>
                integers.widen(
                    in.machine.program.expressions.some[in.payload]
                ),
            _ =>
                integers.widen(
                    in.machine.program.expressions.optional_values[in.payload]
                )
        }

        return {
            ...in.machine,
            work: push({
                work: in.machine.work,
                frame: {
                    action: WorkAction.Value,
                    subject: child,
                    moving: in.frame.moving,
                    index: 0
                }
            })
        }
    }

    if (in.kind == ExpressionKind.Capture) {
        const work = push({
            work: in.machine.work,
            frame: {
                action: WorkAction.Captured,
                subject: in.frame.subject,
                moving: false,
                index: 0
            }
        })

        return {
            ...in.machine,
            work: push({
                work: work,
                frame: {
                    action: WorkAction.Value,
                    subject:
                        integers.widen(
                            in.machine.program.expressions.captures[in.payload]
                        ),
                    moving: in.frame.moving,
                    index: 0
                }
            })
        }
    }

    if (in.kind == ExpressionKind.Field || in.kind == ExpressionKind.TupleField) {
        const field = projection({
            expressions: in.machine.program.expressions,
            id: in.frame.subject
        })

        const work = push({
            work: in.machine.work,
            frame: {
                action: WorkAction.Project,
                subject: in.frame.subject,
                moving: false,
                index: integers.widen(field.index)
            }
        })

        return {
            ...in.machine,
            work: push({
                work: work,
                frame: {
                    action: WorkAction.Value,
                    subject: field.target,
                    moving: in.container && in.frame.moving,
                    index: 0
                }
            })
        }
    }

    if (in.kind == ExpressionKind.Index) {
        const work = push({
            work: in.machine.work,
            frame: {
                action: WorkAction.IndexTarget,
                subject: in.frame.subject,
                moving: false,
                index: 0
            }
        })

        return {
            ...in.machine,
            work: push({
                work: work,
                frame: {
                    action: WorkAction.Value,
                    subject:
                        integers.widen(
                            in.machine.program.expressions
                                .index_targets[in.payload]
                        ),
                    moving: in.container && in.frame.moving,
                    index: 0
                }
            })
        }
    }

    const condition_2 = (
        match in.kind {
            ExpressionKind.Length => true,
            ExpressionKind.Unary => true,
            ExpressionKind.AwaitTask => true,
            ExpressionKind.CancelTask => true,
            _ => false
        }
    )

    if (condition_2) {
        const child = match in.kind {
            ExpressionKind.Length =>
                integers.widen(
                    in.machine.program.expressions.lengths[in.payload]
                ),
            ExpressionKind.Unary =>
                integers.widen(
                    in.machine.program.expressions.unary_operands[in.payload]
                ),
            ExpressionKind.AwaitTask =>
                integers.widen(
                    in.machine.program.expressions.awaits[in.payload]
                ),
            _ =>
                integers.widen(
                    in.machine.program.expressions.cancellations[in.payload]
                )
        }

        const work = push({
            work: in.machine.work,
            frame: {
                action: match {
                    in.kind == ExpressionKind.AwaitTask => WorkAction.Borrowed,
                    _ => WorkAction.Copy
                },
                subject: 0,
                moving: false,
                index: 0
            }
        })

        return {
            ...in.machine,
            work: push({
                work: work,
                frame: {
                    action: WorkAction.Value,
                    subject: child,
                    moving:
                        in.kind == ExpressionKind.AwaitTask ||
                        in.kind == ExpressionKind.CancelTask,
                    index: 0
                }
            })
        }
    }

    return {
        ...in.machine,
        complete: false
    }
}
