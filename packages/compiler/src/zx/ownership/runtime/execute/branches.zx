import { WorkAction } from "../work/model"
import binary from "./branches/binary"
import conditional from "./branches/conditional"
import matchFlow from "./branches/match"
import selection from "./branches/selection"
import statement from "./branches/statement"
import family from "./family"
import { Family } from "./model"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => family(actions[actions.length - 1]) == Family.Branches,
                _ => false
            }
        },
        next: current => {
            const action = current.work.actions[current.work.actions.length - 1]

            current = match action {
                WorkAction.BranchCondition => statement(current),
                WorkAction.BranchYes => statement(current),
                WorkAction.BranchNo => statement(current),
                WorkAction.SwitchSubject => selection(current),
                WorkAction.SwitchCase => selection(current),
                WorkAction.SwitchResult => selection(current),
                WorkAction.MatchSubject => matchFlow(current),
                WorkAction.MatchArm => matchFlow(current),
                WorkAction.MatchCondition => matchFlow(current),
                WorkAction.MatchResult => matchFlow(current),
                WorkAction.MatchFinish => matchFlow(current),
                WorkAction.BinaryLeft => binary(current),
                WorkAction.BinaryRight => binary(current),
                WorkAction.ConditionalCondition => conditional(current),
                WorkAction.ConditionalYes => conditional(current),
                WorkAction.ConditionalNo => conditional(current),
                _ => current
            }
        }
    })
}
