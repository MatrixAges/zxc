import { WorkAction } from "../work/model"
import binary from "./branches/binary"
import conditional from "./branches/conditional"
import matchFlow from "./branches/match"
import selection from "./branches/selection"
import statement from "./branches/statement"
import family from "./family"
import { Family } from "./model"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current =>
            (
                - current.active
                - and current.complete
                - and !current.failed
                - and current.work.actions.length != 0
                - and family(
                    current.work.actions[current.work.actions.length - 1]
                ) == Family.Branches
            ),
        next: current => {
            const action = current.work.actions[current.work.actions.length - 1]

            const condition = (
                - action == WorkAction.BranchCondition
                - or action == WorkAction.BranchYes
                - or action == WorkAction.BranchNo
            )

            if (condition) {
                current = statement(current)
            } else {
                const condition_2 = (
                    - action == WorkAction.SwitchSubject
                    - or action == WorkAction.SwitchCase
                    - or action == WorkAction.SwitchResult
                )

                if (condition_2) {
                    current = selection(current)
                } else {
                    const condition_3 = (
                        - action == WorkAction.MatchSubject
                        - or action == WorkAction.MatchArm
                        - or action == WorkAction.MatchCondition
                        - or action == WorkAction.MatchResult
                        - or action == WorkAction.MatchFinish
                    )

                    if (condition_3) {
                        current = matchFlow(current)
                    } else if (
                        action == WorkAction.BinaryLeft ||
                            action == WorkAction.BinaryRight
                    ) {
                        current = binary(current)
                    } else {
                        const condition_4 = (
                            - action == WorkAction.ConditionalCondition
                            - or action == WorkAction.ConditionalYes
                            - or action == WorkAction.ConditionalNo
                        )

                        if (condition_4) {
                            current = conditional(current)
                        }
                    }
                }
            }
        }
    })
}
