import integers from "std:integer"

import project from "../../facts/project"
import summary from "../../facts/summary"
import optionalId from "../../ir/widen_optional"
import { Operation, State } from "../../places/model"
import borrow from "../borrowing/execute"
import place from "../place"
import apply from "../snapshots/apply"
import { Action } from "../snapshots/model"
import { WorkAction } from "../work/model"
import pop from "../work/pop"
import push from "../work/push"
import top from "../work/top"
import family from "./family"
import { Family } from "./model"
import schedule from "./statements/schedule"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => family(actions[actions.length - 1]) == Family.Statements,
                _ => false
            }
        },
        next: current => {
            const frame = top(current.work)

            current.work = pop(current.work)

            if (frame.action == WorkAction.Block) {
                const count =
                    integers.widen(
                        current.program.control.block_count[frame.subject]
                    )

                if (frame.index < count) {
                    const statement =
                        integers.widen(
                            current.program.control.block_first[frame.subject]
                        ) + frame.index

                    current.work = push({
                        work: current.work,
                        frame: {
                            action: WorkAction.Block,
                            subject: frame.subject,
                            moving: false,
                            index: frame.index + 1
                        }
                    })
                    current.work = push({
                        work: current.work,
                        frame: {
                            action: WorkAction.Release,
                            subject: 0,
                            moving: false,
                            index: 0
                        }
                    })
                    current.work = push({
                        work: current.work,
                        frame: {
                            action: WorkAction.Statement,
                            subject: statement,
                            moving: false,
                            index: 0
                        }
                    })
                }
            } else if (frame.action == WorkAction.Release) {
                current.memory = apply({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    stack: current.snapshots,
                    frame: 0,
                    action: Action.ReleaseAllLoans
                })
            } else if (frame.action == WorkAction.Statement) {
                const scheduled = schedule({
                    work: current.work,
                    control: current.program.control,
                    subject: frame.subject
                })

                if (scheduled == null) {
                    current.complete = false
                } else {
                    current.work = scheduled
                }
            } else if (frame.action == WorkAction.Constant) {
                current.memory = place({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    id: frame.subject,
                    operation: Operation.Assign,
                    fact: current.value
                })
            } else if (frame.action == WorkAction.Result) {
                if (current.returned == State.Borrowed || summary({
                    forest: current.memory.forest,
                    fact: current.value
                }) == State.Borrowed) {
                    current.returned = State.Borrowed
                } else if (current.returned == State.Owned || summary({
                    forest: current.memory.forest,
                    fact: current.value
                }) == State.Owned) {
                    current.returned = State.Owned
                } else {
                    current.returned = summary({
                        forest: current.memory.forest,
                        fact: current.value
                    })
                }
            } else if (frame.action == WorkAction.Store) {
                current.stores_owned = current.stores_owned && (summary({
                    forest: current.memory.forest,
                    fact: current.value
                }) == State.Owned || summary({
                    forest: current.memory.forest,
                    fact: current.value
                }) == State.Copy)
                current.memory = borrow({
                    types: current.program.types,
                    references: current.references,
                    expressions: current.program.expressions,
                    layout: current.layout,
                    memory: current.memory,
                    expression: frame.subject,
                    permanent: true
                })
            } else if (frame.action == WorkAction.Destructure) {
                const symbols = {
                    first:
                        integers.widen(
                            current.program.control.destructure_first[frame.subject]
                        ),
                    count:
                        integers.widen(
                            current.program.control.destructure_count[frame.subject]
                        )
                }

                if (frame.index < symbols.count) {
                    const symbol =
                        optionalId(
                            current.program.control
                                .destructure_symbols[symbols.first +
                                    frame.index]
                        )

                    if (symbol != null) {
                        current.memory = place({
                            types: current.program.types,
                            references: current.references,
                            layout: current.layout.tree,
                            memory: current.memory,
                            id: symbol,
                            operation: Operation.Assign,
                            fact: project({
                                forest: current.memory.forest,
                                fact: current.value,
                                index: frame.index,
                                reference:
                                    current.layout.tree.references[symbol]
                            })
                        })
                    }

                    current.work = push({
                        work: current.work,
                        frame: {
                            action: WorkAction.Destructure,
                            subject: frame.subject,
                            moving: false,
                            index: frame.index + 1
                        }
                    })
                }
            }
        }
    })
}
