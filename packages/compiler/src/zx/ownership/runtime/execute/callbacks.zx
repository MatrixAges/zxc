import { WorkAction } from "../work/model"
import iteration from "./callbacks/iteration"
import transformFinish from "./callbacks/transform_finish"
import transformStart from "./callbacks/transform_start"
import family from "./family"
import { Family } from "./model"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => family(actions[actions.length - 1]) == Family.Callbacks,
                _ => false
            }
        },
        next: current => {
            const action = current.work.actions[current.work.actions.length - 1]

            current = match action {
                WorkAction.IterationRound => iteration(current),
                WorkAction.IterationAdvance => iteration(current),
                WorkAction.IterationInitial => iteration(current),
                WorkAction.IterationCondition => iteration(current),
                WorkAction.IterationBody => iteration(current),
                WorkAction.IterationFinish => iteration(current),
                WorkAction.TransformTarget => transformStart(current),
                WorkAction.TransformInitial => transformStart(current),
                WorkAction.TransformParameter => transformStart(current),
                WorkAction.TransformBody => transformFinish(current),
                WorkAction.TransformFinish => transformFinish(current),
                _ => current
            }
        }
    })
}
