import { WorkAction } from "../work/model"
import iteration from "./callbacks/iteration"
import transformFinish from "./callbacks/transform_finish"
import transformStart from "./callbacks/transform_start"
import family from "./family"
import { Family } from "./model"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current =>
            (
                - current.active
                - and current.complete
                - and !current.failed
                - and current.work.actions.length != 0
                - and family(
                    current.work.actions[current.work.actions.length - 1]
                ) == Family.Callbacks
            ),
        next: current => {
            const action = current.work.actions[current.work.actions.length - 1]

            const condition = (
                - action == WorkAction.IterationRound
                - or action == WorkAction.IterationAdvance
                - or action == WorkAction.IterationInitial
                - or action == WorkAction.IterationCondition
                - or action == WorkAction.IterationBody
                - or action == WorkAction.IterationFinish
            )

            if (condition) {
                current = iteration(current)
            } else {
                const condition_2 = (
                    - action == WorkAction.TransformTarget
                    - or action == WorkAction.TransformInitial
                    - or action == WorkAction.TransformParameter
                )

                if (condition_2) {
                    current = transformStart(current)
                } else if (
                    action == WorkAction.TransformBody ||
                        action == WorkAction.TransformFinish
                ) {
                    current = transformFinish(current)
                }
            }
        }
    })
}
