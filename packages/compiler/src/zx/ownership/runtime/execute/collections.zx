import integers from "std:integer"
import { CollectionKind } from "core/expression_table/kinds"
import row from "core/type_table/row"

import summary from "../../facts/summary"
import uniform from "../../facts/uniform"
import { State } from "../../places/model"
import borrow from "../borrowing/execute"
import update from "../snapshots/update"
import { WorkAction } from "../work/model"
import pop from "../work/pop"
import push from "../work/push"
import top from "../work/top"
import freeze from "./collections/freeze"
import updated from "./collections/update"
import family from "./family"
import { Family } from "./model"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => family(actions[actions.length - 1]) == Family.Collections,
                _ => false
            }
        },
        next: current => {
            const frame = top(current.work)

            current.work = pop(current.work)

            if (frame.action == WorkAction.CollectionTarget) {
                const collection =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )
                const element_input = integers.widen(
                    current.program.expressions
                        .types[integers.widen(
                            current.program.expressions
                                .collection_targets[collection]
                        )]
                )

                const element = integers.widen(row({
                    tables: current.program.types,
                    id: integers.narrow(element_input)
                }).first)
                const shares =
                    current.program.expressions.collection_kinds[collection] ==
                    CollectionKind.Pop ||
                    current.program.expressions.collection_kinds[collection] ==
                    CollectionKind.Splice || current.references[element]
                const borrowed = shares && (summary({
                    forest: current.memory.forest,
                    fact: current.value
                }) == State.Borrowed || summary({
                    forest: current.memory.forest,
                    fact: current.value
                }) == State.Loaned)

                current.values =
                    current.values.push(
                        uniform(
                            borrowed ? State.Borrowed : State.Owned
                        )
                    )[0]
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.CollectionArgument,
                        subject: frame.subject,
                        moving: false,
                        index: 0
                    }
                })
            } else if (frame.action == WorkAction.CollectionArgument) {
                const collection =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )

                if (
                    frame.index <
                        integers.widen(
                            current.program.expressions.collection_count[collection]
                        )
                ) {
                    current.work = push({
                        work: current.work,
                        frame: {
                            action: WorkAction.CollectionResult,
                            subject: frame.subject,
                            moving: false,
                            index: frame.index
                        }
                    })
                    current.work = push({
                        work: current.work,
                        frame: {
                            action: WorkAction.Value,
                            subject:
                                integers.widen(
                                    current.program.expressions
                                        .collection_arguments[integers
                                            .widen(
                                                current.program.expressions
                                                    .collection_first[collection]
                                            ) + frame.index]
                                ),
                            moving: false,
                            index: 0
                        }
                    })
                } else {
                    current.value = current.values[current.values.length - 1]
                    current.values = current.values.pop()[0]

                    if (summary({
                        forest: current.memory.forest,
                        fact: current.value
                    }) == State.Borrowed) {
                        current.memory = borrow({
                            types: current.program.types,
                            references: current.references,
                            expressions: current.program.expressions,
                            layout: current.layout,
                            memory: current.memory,
                            expression:
                                integers.widen(
                                    current.program.expressions
                                        .collection_targets[collection]
                                ),
                            permanent: true
                        })
                        current.work = push({
                            work: current.work,
                            frame: {
                                action: WorkAction.CollectionFreeze,
                                subject: frame.subject,
                                moving: false,
                                index: 0
                            }
                        })
                    }
                }
            } else if (frame.action == WorkAction.CollectionResult) {
                const element_input = integers.widen(
                    current.program.expressions.payloads[frame.subject]
                )

                const element_step = integers.widen(
                    current.program.expressions
                        .types[integers.widen(
                            current.program.expressions
                                .collection_targets[element_input]
                        )]
                )

                const element = integers.widen(row({
                    tables: current.program.types,
                    id: integers.narrow(element_step)
                }).first)

                const borrowed = match {
                    current.references[element] => summary({
                        forest: current.memory.forest,
                        fact: current.value
                    }) == State.Borrowed || summary({
                        forest: current.memory.forest,
                        fact: current.value
                    }) == State.Loaned,
                    _ => false
                }

                if (borrowed) {
                    current.values[current.values.length - 1] =
                        uniform(
                            State.Borrowed
                        )
                }

                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.CollectionArgument,
                        subject: frame.subject,
                        moving: false,
                        index: frame.index + 1
                    }
                })
            } else if (frame.action == WorkAction.CollectionFreeze) {
                current = freeze({
                    machine: current,
                    frame
                })
            } else if (frame.action == WorkAction.UpdateResult) {
                current = updated({
                    machine: current,
                    frame
                })
            }
        }
    })
}
