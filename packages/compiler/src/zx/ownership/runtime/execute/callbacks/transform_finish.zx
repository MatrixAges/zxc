import integers from "std:integer"
import { TransformKind } from "core/expression_table/kinds"
import row from "core/type_table/row"

import summary from "../../../facts/summary"
import uniform from "../../../facts/uniform"
import optionalId from "../../../ir/widen_optional"
import { State } from "../../../places/model"
import borrow from "../../borrowing/execute"
import apply from "../../snapshots/apply"
import drop from "../../snapshots/drop"
import { Action } from "../../snapshots/model"
import { WorkAction } from "../../work/model"
import pop from "../../work/pop"
import push from "../../work/push"
import top from "../../work/top"

import type { Machine } from "../model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => match actions[actions.length - 1] {
                    WorkAction.TransformBody => true,
                    WorkAction.TransformFinish => true,
                    _ => false
                },
                _ => false
            }
        },
        next: current => {
            const frame = top(current.work)

            current.work = pop(current.work)

            if (frame.action == WorkAction.TransformBody) {
                const transform =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )
                const initial = summary({
                    forest: current.memory.forest,
                    fact: current.values[current.values.length - 1]
                })

                current.values = current.values.push(current.value)[0]
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.TransformFinish,
                        subject: frame.subject,
                        moving: false,
                        index: 0
                    }
                })

                const kind = current.program.expressions.transform_kinds[transform]
                const borrowed = match kind {
                    TransformKind.Reduce => summary({
                        forest: current.memory.forest,
                        fact: current.value
                    }) == State.Borrowed,
                    _ => false
                }

                if (borrowed && initial != State.Borrowed) {
                    current.memory = apply({
                        types: current.program.types,
                        references: current.references,
                        layout: current.layout.tree,
                        memory: current.memory,
                        stack: current.snapshots,
                        frame: current.snapshots.state_first.length - 1,
                        action: Action.RestoreStates
                    })
                    current.work = push({
                        work: current.work,
                        frame: {
                            action: WorkAction.TransformParameter,
                            subject: frame.subject,
                            moving: true,
                            index: 0
                        }
                    })
                }
            } else if (frame.action == WorkAction.TransformFinish) {
                const transform =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )
                const initial_state = summary({
                    forest: current.memory.forest,
                    fact: current.values[current.values.length - 2]
                })
                const result = summary({
                    forest: current.memory.forest,
                    fact: current.values[current.values.length - 1]
                })
                const element_input = integers.widen(
                    current.program.expressions
                        .types[integers.widen(
                            current.program.expressions
                                .transform_targets[transform]
                        )]
                )

                const element = integers.widen(row({
                    tables: current.program.types,
                    id: integers.narrow(element_input)
                }).first)
                const kind = current.program.expressions.transform_kinds[transform]
                const predicate =
                    kind == TransformKind.Every || kind == TransformKind.Some
                const retained =
                    kind == TransformKind.Filter || kind == TransformKind.Sort
                const reduced =
                    kind == TransformKind.Reduce && initial_state == State.Borrowed
                const borrowed = match {
                    predicate => false,
                    retained && current.references[element] => true,
                    result == State.Borrowed => true,
                    _ => reduced
                }
                const before = current.snapshots.state_first.length - 2

                current.memory = apply({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    stack: current.snapshots,
                    frame: before + 1,
                    action: Action.RestoreStates
                })

                if (borrowed) {
                    const initial =
                        optionalId(
                            current.program.expressions.transform_initials[transform]
                        )

                    current.memory = borrow({
                        types: current.program.types,
                        references: current.references,
                        expressions: current.program.expressions,
                        layout: current.layout,
                        memory: current.memory,
                        expression:
                            integers.widen(
                                current.program.expressions
                                    .transform_targets[transform]
                            ),
                        permanent: true
                    })

                    if (
                        initial != null &&
                            current.program.expressions.transform_kinds[transform] !=
                            TransformKind.Filter
                    ) {
                        current.memory = borrow({
                            types: current.program.types,
                            references: current.references,
                            expressions: current.program.expressions,
                            layout: current.layout,
                            memory: current.memory,
                            expression: initial,
                            permanent: true
                        })
                    }
                }

                current.memory = apply({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    stack: current.snapshots,
                    frame: before,
                    action: Action.ReleaseNewLoans
                })
                current.snapshots = drop({
                    stack: current.snapshots,
                    frame: before
                })
                current.values = current.values.pop()[0]
                current.values = current.values.pop()[0]
                const output = borrowed ? State.Borrowed : State.Owned

                current.value = uniform(predicate ? State.Copy : output)
            }
        }
    })
}
