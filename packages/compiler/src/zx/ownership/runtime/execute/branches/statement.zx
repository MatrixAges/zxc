import integers from "std:integer"

import apply from "../../snapshots/apply"
import drop from "../../snapshots/drop"
import { Action } from "../../snapshots/model"
import { Capture } from "../../snapshots/model"
import save from "../../snapshots/save"
import { WorkAction } from "../../work/model"
import pop from "../../work/pop"
import push from "../../work/push"
import top from "../../work/top"

import type { Machine } from "../model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => match actions[actions.length - 1] {
                    WorkAction.BranchCondition => true,
                    WorkAction.BranchYes => true,
                    WorkAction.BranchNo => true,
                    _ => false
                },
                _ => false
            }
        },
        next: current => {
            const frame = top(current.work)

            current.work = pop(current.work)

            if (frame.action == WorkAction.BranchCondition) {
                const captured = save({
                    memory: current.memory,
                    stack: current.snapshots,
                    capture: Capture.States
                })
                const branch = frame.subject

                current.snapshots = captured.stack
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.BranchYes,
                        subject: frame.subject,
                        moving: false,
                        index: captured.frame
                    }
                })
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.Block,
                        subject:
                            integers.widen(
                                current.program.control.branch_yes[branch]
                            ),
                        moving: false,
                        index: 0
                    }
                })
            } else if (frame.action == WorkAction.BranchYes) {
                const captured = save({
                    memory: current.memory,
                    stack: current.snapshots,
                    capture: Capture.States
                })
                const branch = frame.subject

                current.snapshots = captured.stack
                current.memory = apply({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    stack: current.snapshots,
                    frame: frame.index,
                    action: Action.RestoreStates
                })
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.BranchNo,
                        subject: frame.subject,
                        moving: false,
                        index: frame.index
                    }
                })
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.Block,
                        subject:
                            integers.widen(
                                current.program.control.branch_no[branch]
                            ),
                        moving: false,
                        index: 0
                    }
                })
            } else if (frame.action == WorkAction.BranchNo) {
                const branch = frame.subject

                if (
                    current
                        .returns[integers.widen(
                            current.program.control.branch_yes[branch]
                        )]
                ) {
                    if (
                        current
                            .returns[integers.widen(
                                current.program.control.branch_no[branch]
                            )]
                    ) {
                        current.memory = apply({
                            types: current.program.types,
                            references: current.references,
                            layout: current.layout.tree,
                            memory: current.memory,
                            stack: current.snapshots,
                            frame: frame.index,
                            action: Action.RestoreStates
                        })
                    }
                } else {
                    current.memory = apply({
                        types: current.program.types,
                        references: current.references,
                        layout: current.layout.tree,
                        memory: current.memory,
                        stack: current.snapshots,
                        frame: frame.index + 1,
                        action:
                            match {
                                current
                                    .returns[integers.widen(
                                        current.program.control.branch_no[branch]
                                    )] => Action.RestoreStates,
                                _ => Action.MergeStates
                            }
                    })
                }

                current.snapshots = drop({
                    stack: current.snapshots,
                    frame: frame.index
                })
            }
        }
    })
}
