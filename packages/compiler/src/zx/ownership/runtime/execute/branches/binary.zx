import integers from "std:integer"
import { BinaryOperator } from "core/expression_table/kinds"

import rewrite from "../../../facts/rewrite"
import { RewriteAction } from "../../../facts/rewrite/model"
import apply from "../../snapshots/apply"
import drop from "../../snapshots/drop"
import { Action } from "../../snapshots/model"
import { Capture } from "../../snapshots/model"
import save from "../../snapshots/save"
import { WorkAction } from "../../work/model"
import pop from "../../work/pop"
import push from "../../work/push"
import top from "../../work/top"

import type { Machine } from "../model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => match actions[actions.length - 1] {
                    WorkAction.BinaryLeft => true,
                    WorkAction.BinaryRight => true,
                    _ => false
                },
                _ => false
            }
        },
        next: current => {
            const frame = top(current.work)

            current.work = pop(current.work)

            if (frame.action == WorkAction.BinaryLeft) {
                const binary =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )
                const captured = save({
                    memory: current.memory,
                    stack: current.snapshots,
                    capture: Capture.States
                })

                current.snapshots = captured.stack
                current.values = current.values.push(current.value)[0]
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.BinaryRight,
                        subject: frame.subject,
                        moving: false,
                        index: captured.frame
                    }
                })
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.Value,
                        subject:
                            integers.widen(
                                current.program.expressions.binary_right[binary]
                            ),
                        moving: frame.moving,
                        index: 0
                    }
                })
            } else if (frame.action == WorkAction.BinaryRight) {
                const binary =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )

                const operator = current.program.expressions.binary_operators[binary]
                const short_circuit = match operator {
                    BinaryOperator.LogicalAnd => true,
                    BinaryOperator.LogicalOr => true,
                    BinaryOperator.Coalesce => true,
                    _ => false
                }

                if (short_circuit) {
                    current.memory = apply({
                        types: current.program.types,
                        references: current.references,
                        layout: current.layout.tree,
                        memory: current.memory,
                        stack: current.snapshots,
                        frame: frame.index,
                        action: Action.MergeStates
                    })
                }

                current.snapshots = drop({
                    stack: current.snapshots,
                    frame: frame.index
                })
                const combined = rewrite({
                    types: current.program.types,
                    references: current.references,
                    forest: current.memory.forest,
                    left: current.values[current.values.length - 1],
                    right: current.value,
                    action: RewriteAction.Join
                })

                current.memory = {
                    ...current.memory,
                    forest: combined.forest
                }
                current.value = combined.fact
                current.values = current.values.pop()[0]
            }
        }
    })
}
