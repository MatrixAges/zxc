import integers from "std:integer"

import rewrite from "../../../facts/rewrite"
import { RewriteAction } from "../../../facts/rewrite/model"
import uniform from "../../../facts/uniform"
import { State } from "../../../places/model"
import apply from "../../snapshots/apply"
import drop from "../../snapshots/drop"
import { Action } from "../../snapshots/model"
import { Capture } from "../../snapshots/model"
import save from "../../snapshots/save"
import update from "../../snapshots/update"
import { WorkAction } from "../../work/model"
import pop from "../../work/pop"
import push from "../../work/push"
import top from "../../work/top"
import arm from "./match/arm"

import type { Machine } from "../model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => {
            const actions = current.work.actions
            const ready = (
                - current.active
                - and current.complete
                - and !current.failed
                - and actions.length != 0
            )

            return match {
                ready => match actions[actions.length - 1] {
                    WorkAction.MatchSubject => true,
                    WorkAction.MatchArm => true,
                    WorkAction.MatchCondition => true,
                    WorkAction.MatchResult => true,
                    WorkAction.MatchFinish => true,
                    _ => false
                },
                _ => false
            }
        },
        next: current => {
            const frame = top(current.work)

            current.work = pop(current.work)

            if (frame.action == WorkAction.MatchSubject) {
                const before = save({
                    memory: current.memory,
                    stack: current.snapshots,
                    capture: Capture.States
                })
                const combined = save({
                    memory: current.memory,
                    stack: before.stack,
                    capture: Capture.States
                })

                current.snapshots = combined.stack
                current.values = current.values.push(uniform(State.Copy))[0]
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.MatchFinish,
                        subject: frame.subject,
                        moving: false,
                        index: before.frame
                    }
                })
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.MatchArm,
                        subject: frame.subject,
                        moving: frame.moving,
                        index: 0
                    }
                })
            } else if (frame.action == WorkAction.MatchArm) {
                current.work = arm({
                    work: current.work,
                    expressions: current.program.expressions,
                    frame
                })
            } else if (frame.action == WorkAction.MatchCondition) {
                const selection =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )

                const updated = update({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    stack: current.snapshots,
                    frame: current.snapshots.state_first.length - 2,
                    merge: false
                })

                current.memory = updated.memory
                current.snapshots = updated.snapshots
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.MatchResult,
                        subject: frame.subject,
                        moving: frame.moving,
                        index: frame.index
                    }
                })
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.Value,
                        subject:
                            integers.widen(
                                current.program.expressions
                                    .match_results[integers
                                        .widen(
                                            current.program.expressions
                                                .match_first[selection]
                                        ) + frame.index]
                            ),
                        moving: frame.moving,
                        index: 0
                    }
                })
            } else if (frame.action == WorkAction.MatchResult) {
                const joined = rewrite({
                    types: current.program.types,
                    references: current.references,
                    forest: current.memory.forest,
                    left: current.values[current.values.length - 1],
                    right: current.value,
                    action: RewriteAction.Join
                })

                current.memory = {
                    ...current.memory,
                    forest: joined.forest
                }
                current.values[current.values.length - 1] = joined.fact

                const updated = update({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    stack: current.snapshots,
                    frame: current.snapshots.state_first.length - 1,
                    merge: frame.index != 0
                })

                current.memory = updated.memory
                current.snapshots = updated.snapshots
                current.memory = apply({
                    types: current.program.types,
                    references: current.references,
                    layout: current.layout.tree,
                    memory: current.memory,
                    stack: current.snapshots,
                    frame: current.snapshots.state_first.length - 2,
                    action: Action.RestoreStates
                })
                current.work = push({
                    work: current.work,
                    frame: {
                        action: WorkAction.MatchArm,
                        subject: frame.subject,
                        moving: frame.moving,
                        index: frame.index + 1
                    }
                })
            } else if (frame.action == WorkAction.MatchFinish) {
                const selection =
                    integers.widen(
                        current.program.expressions.payloads[frame.subject]
                    )

                if (
                    integers.widen(
                        current.program.expressions.match_count[selection]
                    ) != 0
                ) {
                    current.memory = apply({
                        types: current.program.types,
                        references: current.references,
                        layout: current.layout.tree,
                        memory: current.memory,
                        stack: current.snapshots,
                        frame: frame.index + 1,
                        action: Action.MergeStates
                    })
                }

                current.snapshots = drop({
                    stack: current.snapshots,
                    frame: frame.index
                })
                const combined = rewrite({
                    types: current.program.types,
                    references: current.references,
                    forest: current.memory.forest,
                    left: current.values[current.values.length - 1],
                    right: current.value,
                    action: RewriteAction.Join
                })

                current.memory = {
                    ...current.memory,
                    forest: combined.forest
                }
                current.value = combined.fact
                current.values = current.values.pop()[0]
            }
        }
    })
}
