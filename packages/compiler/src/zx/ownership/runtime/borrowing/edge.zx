import integers from "std:integer"
import { ExpressionKind, TransformKind } from "core/expression_table/kinds"

import projection from "../../layout/projection"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    expression: u64,
    index: u64,
    permanent: bool
}

export type Output = {
    found: bool,
    expression: u64
}

export default function (in: Input): Output {
    const kind = in.expressions.kinds[in.expression]
    const payload = integers.widen(in.expressions.payloads[in.expression])

    if (kind == ExpressionKind.Match) {
        const first = integers.widen(in.expressions.match_first[payload])
        const count = integers.widen(in.expressions.match_count[payload])

        if (in.index < count) {
            return {
                found: true,
                expression:
                    integers.widen(
                        in.expressions.match_results[first + in.index]
                    )
            }
        }

        return {
            found: in.index == count,
            expression: integers.widen(in.expressions.match_fallbacks[payload])
        }
    }

    const condition = (
        - kind == ExpressionKind.List
        - or kind == ExpressionKind.Tuple
        - or kind == ExpressionKind.Object
    )

    if (condition) {
        const object = kind == ExpressionKind.Object

        const first =
            integers.widen(
                object ? in.expressions.object_evaluation_first[payload] :
                    in.expressions.sequence_first[payload]
            )

        const count =
            integers.widen(
                object ? in.expressions.object_evaluation_count[payload] :
                    in.expressions.sequence_count[payload]
            )

        return (
            object ? in.expressions.object_evaluation_values :
                in.expressions.sequence_items
        )
            -> {
                found: in.index < count,
                expression: in.index < count ? integers.widen(
                    _[first + in.index]
                ) : 0
            }
    }

    if (kind == ExpressionKind.ListUpdate) {
        return {
            found: in.index < 2,
            expression:
                integers.widen(
                    in.index == 0 ? in.expressions.update_targets[payload] :
                        in.expressions.update_values[payload]
                )
        }
    }

    if (kind == ExpressionKind.Conditional) {
        return {
            found: in.index < 2,
            expression:
                integers.widen(
                    in.index == 0 ? in.expressions.conditional_yes[payload] :
                        in.expressions.conditional_no[payload]
                )
        }
    }

    if (kind == ExpressionKind.Binary) {
        return {
            found: in.index < 2,
            expression:
                integers.widen(
                    in.index == 0 ? in.expressions.binary_left[payload] :
                        in.expressions.binary_right[payload]
                )
        }
    }

    if (in.permanent && kind == ExpressionKind.Transform) {
        if (in.index == 0) {
            return {
                found: true,
                expression: integers.widen(
                    in.expressions.transform_targets[payload]
                )
            }
        }

        const operation = in.expressions.transform_kinds[payload]
        const initial = in.expressions.transform_initials[payload]

        return (
            - in.index == 1
            - and initial != null
            - and (
                operation == TransformKind.Map ||
                    operation == TransformKind.Reduce
            )
        )
            -> {
                found: _,
                expression: initial != null ? integers.widen(initial) : 0
            }
    }

    if (in.index != 0) {
        return {
            found: false,
            expression: 0
        }
    }

    if (kind == ExpressionKind.Scope) {
        return {
            found: true,
            expression: integers.widen(in.expressions.scope_results[payload])
        }
    }

    if (kind == ExpressionKind.Iteration) {
        return {
            found: true,
            expression: integers.widen(
                in.expressions.iteration_initials[payload]
            )
        }
    }

    if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
        return {
            found: true,
            expression: projection({
                expressions: in.expressions,
                id: in.expression
            }).target
        }
    }

    if (kind == ExpressionKind.Index) {
        return {
            found: true,
            expression: integers.widen(in.expressions.index_targets[payload])
        }
    }

    const condition_2 = (
        - kind == ExpressionKind.Some
        - or kind == ExpressionKind.Capture
        - or kind == ExpressionKind.OptionalValue
    )

    if (condition_2) {
        return match kind {
            ExpressionKind.Some => in.expressions.some[payload],
            ExpressionKind.Capture => in.expressions.captures[payload],
            _ => in.expressions.optional_values[payload]
        }
            -> {
                found: true,
                expression: integers.widen(_)
            }
    }

    if (in.permanent && kind == ExpressionKind.Call) {
        return {
            found: true,
            expression: integers.widen(in.expressions.call_arguments[payload])
        }
    }

    return {
        found: false,
        expression: 0
    }
}
