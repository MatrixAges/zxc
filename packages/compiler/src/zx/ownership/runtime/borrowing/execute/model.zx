import type { Expressions } from "core/expression_table/model"
import type { Tables } from "core/type_table/model"
import type { Forest } from "../../../facts/model"
import type { Built } from "../../../layout/model"
import type { State } from "../../../places/model"

export enum Phase { Next, Query, Descend, Expand, Enter, Done }

export type Session = {
    types: Tables,
    references: bool[],
    forest: Forest,
    facts: u64[],
    expressions: Expressions,
    layout: Built,
    memo: u64[],
    permanent: bool,
    states: State[],
    trail: u64[],
    work: u64[],
    cursors: u64[],
    expression: u64,
    query: u64,
    position: u64,
    root: u64,
    phase: Phase,
    active: bool
}
