import { Kind } from "core/type_table/model"
import row from "core/type_table/row"

import { State } from "../places/model"

import type { Symbols } from "core/symbol_table/model"
import type { Tables } from "core/type_table/model"

export type Input = {
    types: Tables,
    symbols: Symbols,
    position: u64,
    current: State,
    moving: bool
}

export type Output = {
    failed: bool,
    value: State,
    assign: bool,
    assigned: State
}

export default function (in: Input): Output {
    if (in.current == State.Moved) {
        return {
            failed: true,
            value: State.Moved,
            assign: false,
            assigned: State.Copy
        }
    }

    const linear = in.position < in.symbols.types.length && row({
        tables: in.types,
        id: in.symbols.types[in.position]
    }).kind == Kind.Task

    const condition = (
        - in.moving
        - and in.current == State.Owned
        - and linear
    )

    if (condition) {
        return {
            failed: false,
            value: in.current,
            assign: true,
            assigned: State.Moved
        }
    }

    const valid_current = in.current == State.Loaned || in.current == State.Borrowed

    const condition_2 = (
        - in.moving
        - and (valid_current)
    )

    if (condition_2) {
        return {
            failed: false,
            value: State.Borrowed,
            assign: true,
            assigned: State.Borrowed
        }
    }

    return {
        failed: false,
        value: in.current == State.Loaned ? State.Borrowed : in.current,
        assign: false,
        assigned: State.Copy
    }
}
