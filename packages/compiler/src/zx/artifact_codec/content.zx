import bytes from "std:bytes"

import digest from "./digest"

export type Input = {
    source: string,
    start: u64,
    digest_start: u64
}

export type Output = bool

export default function (in: Input): Output {
    const expected = digest({
        source: in.source,
        start: in.start
    })

    return bytes.startsWithText(
        bytes.fromText(in.source),
        in.digest_start,
        expected
    )
}
