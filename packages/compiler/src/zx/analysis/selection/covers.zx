import integers from "std:integer"

export type Input = {
    source: string[],
    result: string[],
    indices: u32[],
    all: bool
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.result.length,
        next: state => {
            const name = in.result[state.index]

            if (in.all) {
                state.valid = in.source.some(field => field == name)
            } else {
                state.valid = in.indices.some(
                    index =>
                        in.source[integers.widen(index)] == name
                )
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
