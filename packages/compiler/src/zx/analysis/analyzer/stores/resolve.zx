import binding from "./binding"

import type { Stores } from "core/store_table/model"
import type { Diagnostic } from "../../semantic/resolving/model"
import type { Context } from "../context"
import type { Signature } from "../signature/model"

export type Input = { context: Context, signature: Signature }

export type Output = { stores: Stores, diagnostic: Diagnostic }

export default function (in: Input): Output {
    const stores: Stores = { paths: [], types: [], handles: [], readable: [], writable: [] }

    const result = loop({ input: in, stores: stores, diagnostic: in.signature.diagnostic, index: 0 }, {
        while: current => current.diagnostic.message == "" && current.index < current.input.context.store_bindings.handles.length,
        next: current => {
            const bindings = current.input.context.store_bindings
            const selected = binding({ bindings: bindings, index: current.index, types: current.input.signature.types, type_count: current.input.context.store_type_count })

            if (selected.message != "") {
                current.diagnostic = { code: selected.code, message: selected.message, start: current.input.signature.span.start, end: current.input.signature.span.end }
            } else {
                current.stores = {
                    paths: current.stores.paths.push(bindings.paths[current.index])[0],
                    types: current.stores.types.push(selected.id)[0],
                    handles: current.stores.handles.push(bindings.handles[current.index])[0],
                    readable: current.stores.readable.push(bindings.readable[current.index])[0],
                    writable: current.stores.writable.push(bindings.writable[current.index])[0]
                }
            }

            current.index += 1
        }
    })

    return { stores: result.stores, diagnostic: result.diagnostic }
}
