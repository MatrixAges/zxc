<Module>
    <Type from="./model" as="Model" />
    <Type from="../context" as="Context" />

    <Args
        in={{
            analysis: Model.Analysis,
            module: Context.ModuleInput
        }}
        out={Model.Analysis}
    />

    <If on={$in.analysis.state.diagnostic.message == "" && !$in.analysis.type_only}>
        <Call
            fn="./bindings"
            in={{
                state: $in.analysis.state,
                module: $in.module
            }}
        />

        <Call
            module="../body"
            in={{
                state: $ctx.bindings.state,
                source: {
                    bytes: $in.module.bytes,
                    tree: $in.module.syntax.expressions,
                    blocks: $in.module.syntax.blocks,
                    constant_values: $in.analysis.constant_scope,
                    native: $in.module.native
                },
                imports: $ctx.bindings.imports,
                functions: $in.module.context.functions,
                block: $in.module.syntax.body ?? 0,
                span:
                    $in.module.syntax.blocks.blocks[
                        $in.module.syntax.body ?? 0
                    ].span
            }}
        />

        <Return
            value={{
                ...$in.analysis,
                state: $ctx.body.state,
                root: $ctx.body.root
            }}
        />

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
