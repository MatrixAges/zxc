<Module>
    <Type from="model" as="Model" />
    <Type from="../context" as="Context" />

    <Args
        in={{
            analysis: Model.Analysis,
            module: Context.ModuleInput
        }}
        out={Model.Analysis}
    />

    <If on={$in.analysis.state.diagnostic.message == ""}>
        <Call
            module="../contracts"
            in={{
                state: $in.analysis.state,
                source: {
                    bytes: $in.module.bytes,
                    tree: $in.module.syntax.expressions,
                    blocks: $in.module.syntax.blocks,
                    constant_values: $in.analysis.constant_scope,
                    native: $in.module.native
                },
                items: $in.module.syntax.contracts,
                names: $in.analysis.names,
                types: $in.analysis.types
            }}
        />

        <Return
            value={{
                ...$in.analysis,
                state: $ctx.contracts.state,
                contracts: $ctx.contracts.contracts
            }}
        />

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
