<Module>
    <Type from="./model" as="Model" />
    <Type from="../context" as="Context" />

    <Args in={{ analysis: Model.Analysis, module: Context.ModuleInput }} out={Model.Analysis} />

    <Switch on={$in.analysis.state.diagnostic.message == ""}>
        <Case value={true}>
            <Call module="../contracts" in={{ state: $in.analysis.state, source: { bytes: $in.module.bytes, tree: $in.module.syntax.expressions, blocks: $in.module.syntax.blocks, native: $in.module.native }, items: $in.module.syntax.contracts, names: $in.analysis.names, types: $in.analysis.types }} />

            <Return value={{ ...$in.analysis, state: $ctx.contracts.state, contracts: $ctx.contracts.contracts }} />
        </Case>

        <Default>
            <Return value={$in.analysis} />
        </Default>
    </Switch>
</Module>
