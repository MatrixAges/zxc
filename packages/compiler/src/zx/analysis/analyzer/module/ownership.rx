<Module>
    <Type from="./model" as="Model" />
    <Type from="../context" as="Context" />

    <Args
        in={{
            analysis: Model.Analysis,
            module: Context.ModuleInput
        }}
        out={Model.Analysis}
    />

    <If on={$in.analysis.state.diagnostic.message == ""}>
        <Call
            module="../ownership"
            in={{
                state: $in.analysis.state,
                root: $in.analysis.root,
                functions: $in.module.context.functions,
                type_only: $in.analysis.type_only
            }}
        />

        <Return
            value={{
                ...$in.analysis,
                state: $ctx.ownership.state,
                ownership: $ctx.ownership.ownership
            }}
        />

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
