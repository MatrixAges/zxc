<Module>
    <Switch on={$in.analysis.state.diagnostic.message == ""}>
        <Case value={true}>
            <Call module="../ownership" in={{ state: $in.analysis.state, root: $in.analysis.root, functions: $in.module.context.functions, type_only: $in.analysis.type_only }} />

            <Return value={{ ...$in.analysis, state: $ctx.ownership.state, ownership: $ctx.ownership.ownership }} />
        </Case>

        <Default>
            <Return value={$in.analysis} />
        </Default>
    </Switch>
</Module>
