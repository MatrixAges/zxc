import { type_id_bool } from "core/const"
import append from "core/expression_table/append/boolean"

import type { Span } from "../../../../../frontend/lexer/token_model"
import type { Prepared } from "../../../model"
import type { Result } from "../../model"

export type Input = {
    state: Prepared,
    span: Span,
    value: bool
}

export type Output = Result

export default function (in: Input): Output {
    const result = append({
        table: in.state.local.expressions,
        metadata: {
            type_id: type_id_bool,
            span_start: in.span.start,
            span_end: in.span.end
        },
        value: in.value
    })

    return {
        state: {
            ...in.state,
            local: {
                ...in.state.local,
                expressions: result.table
            }
        },
        value: result.id
    }
}
