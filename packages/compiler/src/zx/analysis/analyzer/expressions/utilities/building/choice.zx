import integers from "std:integer"
import append from "core/expression_table/append/conditional"

import type { Span } from "../../../../../frontend/lexer/token_model"
import type { Prepared } from "../../../model"
import type { Result } from "../../model"

export type Input = {
    state: Prepared,
    span: Span,
    condition: u32,
    yes: u32,
    no: u32
}

export type Output = Result

export default function (in: Input): Output {
    const result = append({
        table: in.state.local.expressions,
        metadata: {
            type_id: in.state.local.expressions.types[integers.widen(in.yes)],
            span_start: in.span.start,
            span_end: in.span.end
        },
        condition: in.condition,
        yes: in.yes,
        no: in.no
    })

    return {
        state: {
            ...in.state,
            local: {
                ...in.state.local,
                expressions: result.table
            }
        },
        value: result.id
    }
}
