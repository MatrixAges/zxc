<Module>
    <Type from="./model" as="Model" />
    <Type from="../model" as="Expressions" />

    <Args in={Model.Input} out={Expressions.Result} />

    <Call fn="bindings" in={$in} />

    <Call
        fn="dispatch"
        in={{
            ...$in,
            state: $ctx.bindings.state,
            values: $ctx.bindings.values
        }}
    />

    <Call
        fn="finish"
        in={{
            result: $ctx.dispatch,
            bindings: $ctx.bindings.bindings,
            span: $in.span
        }}
    />

    <Return value={$ctx.finish} />
</Module>
