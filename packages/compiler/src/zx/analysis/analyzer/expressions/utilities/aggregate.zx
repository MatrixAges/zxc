import { type_id_u8, type_id_f64, type_id_u64 } from "core/const"
import { ValueKind } from "core/expression_table/append/model"
import { BinaryOperator, TransformKind } from "core/expression_table/kinds"
import { Ownership } from "core/symbol_table/model"

import { Operation } from "../../../../modules/intrinsic/model"
import integer from "../../collections/building/integer"
import reference from "../../collections/building/reference"
import symbol from "../../collections/building/symbol"
import lower from "../../collections/lower.rx"
import binary from "../operators/binary"
import index from "../projections/index"
import choice from "./building/choice"
import none from "./building/none"
import optional from "./building/optional"
import value from "./building/value"
import zero from "./building/zero"
import { item_name, index_name, type_code, elements_message } from "./const"

import type { Result } from "../model"
import type { List } from "./model"

export type Input = List

export type Output = Result

export default function (in: Input): Output {
    if (in.element_type < type_id_u8 || in.element_type > type_id_f64) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: type_code,
                    message: elements_message,
                    start: in.span.start,
                    end: in.span.end
                }
            },
            value: 0
        }
    }

    const sum = in.operation == Operation.Sum

    const position = integer({
        state: in.state,
        span: in.span,
        value: 0
    })

    const initial = sum ? zero({
        state: position.state,
        span: in.span,
        type_id: in.element_type
    }) : index({
        state: position.state,
        span: in.span,
        index_span: in.span,
        target: in.values[0],
        index: position.value
    })

    const accumulator = symbol({
        state: initial.state,
        span: in.span,
        name: item_name,
        type_id: in.element_type,
        ownership: Ownership.Copy
    })

    const item = symbol({
        state: accumulator.state,
        span: in.span,
        name: index_name,
        type_id: in.element_type,
        ownership: Ownership.Copy
    })

    const left = reference({
        state: item.state,
        span: in.span,
        symbol: accumulator.symbol
    })

    const right = reference({
        state: left.state,
        span: in.span,
        symbol: item.symbol
    })

    const check = binary({
        state: right.state,
        span: in.span,
        operator: match in.operation {
            Operation.Sum => BinaryOperator.Add,
            Operation.Min => BinaryOperator.Less,
            _ => BinaryOperator.Greater
        },
        left: left.value,
        right: right.value
    })

    const body = sum ? check : choice({
        state: check.state,
        span: in.span,
        condition: check.value,
        yes: left.value,
        no: right.value
    })

    const result = lower({
        state: body.state,
        span: in.span,
        kind: TransformKind.Reduce,
        target: in.values[0],
        initial: initial.value,
        ignored: null,
        callback: {
            parameters: [
                accumulator.symbol,
                item.symbol
            ],
            captures: {
                sources: [],
                targets: [],
                values: []
            },
            body: body.value
        },
        result_type: in.element_type
    })

    if (sum) {
        return result
    }

    const length = value({
        state: result.state,
        span: in.span,
        type_id: type_id_u64,
        kind: ValueKind.Length,
        value: in.values[0]
    })

    const present = binary({
        state: length.state,
        span: in.span,
        operator: BinaryOperator.Greater,
        left: length.value,
        right: position.value
    })

    const wrapped = optional({
        state: present.state,
        span: in.span,
        type_id: in.element_type
    })

    const some = value({
        state: wrapped.state,
        span: in.span,
        type_id: wrapped.id,
        kind: ValueKind.Some,
        value: result.value
    })

    const empty = none({
        state: some.state,
        span: in.span,
        type_id: wrapped.id
    })

    return choice({
        state: empty.state,
        span: in.span,
        condition: present.value,
        yes: some.value,
        no: empty.value
    })
}
