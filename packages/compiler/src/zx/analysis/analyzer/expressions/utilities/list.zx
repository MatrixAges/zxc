import { Operation } from "../../../../modules/intrinsic/model"
import aggregate from "./aggregate"
import edge from "./edge"
import slice from "./slice.rx"

import type { Result } from "../model"
import type { List } from "./model"

export type Input = List

export type Output = Result

export default function (in: Input): Output {
    if (in.operation == Operation.Head || in.operation == Operation.Last) {
        return edge(in)
    }

    const condition = (
        match in.operation {
            Operation.Sum => true,
            Operation.Min => true,
            Operation.Max => true,
            _ => false
        }
    )

    if (condition) {
        return aggregate(in)
    }

    return slice(in)
}
