import { ValueKind } from "core/expression_table/append/model"
import append from "core/expression_table/append/value"

import typeOf from "../../../ir/canonical/refinement/type_of"

import type { Expressions } from "core/expression_table/model"
import type { Tables } from "core/type_table/model"
import type { Span } from "../../../frontend/lexer/token_model"
import type { Facts } from "../../../ir/canonical/refinement/facts/model"

export type Input = { expressions: Expressions, tables: Tables, facts: Facts, type_id: u32, symbol: u32, span: Span }

export type Output = { expressions: Expressions, value: u32 }

export default function (in: Input): Output {
    const original = in.type_id
    const value = append({ table: in.expressions, metadata: { type_id: original, span_start: in.span.start, span_end: in.span.end }, kind: ValueKind.Reference, value: in.symbol })
    const refined = typeOf({ facts: in.facts, tables: in.tables, type_id: original, symbol: in.symbol })
    const result = refined == original ? value : append({ table: value.table, metadata: { type_id: refined, span_start: in.span.start, span_end: in.span.end }, kind: ValueKind.OptionalValue, value: value.id })

    return { expressions: result.table, value: result.id }
}
