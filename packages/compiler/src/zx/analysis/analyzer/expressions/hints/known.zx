import enter from "./enter"
import matchLiteral from "./match_literal"
import { Operation } from "./model"
import project from "./project"

import type { Context, Work, Frame } from "./model"

export type Input = {
    context: Context,
    node: u64,
    declared?: bool
}

export type Output = u32?

export default function (in: Input): Output {
    const frames: Frame[] = [{
        operation: in.declared == true ? Operation.Declared : Operation.Probe,
        node: in.node
    }]

    const initial: Work = {
        context: in.context,
        frames,
        result: null
    }

    const result = loop(initial, {
        while: current => current.frames.length > 0,
        next: current => {
            const frame = current.frames[current.frames.length - 1]

            current.frames = current.frames.pop()[0]

            const is_probe = frame.operation == Operation.Probe

            const is_declared = frame.operation == Operation.Declared

            const valid_operation = frame.operation == Operation.Fallback &&
                current.result == null

            const condition = (
                - is_probe
                - or is_declared
                - or (
                    valid_operation
                )
            )

            if (condition) {
                const result = enter({
                    work: current,
                    node: frame.node,
                    declared: frame.operation == Operation.Declared
                })

                current.frames = result.frames
                current.result = result.result
            } else if (frame.operation == Operation.MatchLiteral) {
                if (current.result == null) {
                    current.result = matchLiteral({
                        source: current.context.source,
                        node: frame.node
                    })
                }
            } else if (frame.operation != Operation.Fallback) {
                const type_id = current.result

                if (type_id != null) {
                    current.result = project({
                        context: current.context,
                        frame,
                        type_id
                    })
                }
            }
        }
    })

    return result.result
}
