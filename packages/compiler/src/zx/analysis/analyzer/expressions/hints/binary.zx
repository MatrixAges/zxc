import { Operator } from "../../../../frontend/parser/expressions/prepare/model"
import payload from "../../types/payload"
import classify from "../operators/classify"
import decode from "../operators/decode"
import known from "./known"
import literal from "./literal"

import type { Context } from "./model"

export type Input = { context: Context, node: u64, expected: u32? }

export type Output = u32?

    export default function (in: Input): Output {
        const node = in.context.source.tree.nodes[in.node]

        if (node.operator == Operator.Coalesce) {
            return null
        }

        const flags = classify(decode(node.operator))

        if (flags.logical) {
            return 1
        }

        const left = known({ context: in.context, node: node.first })

        if (left != null) {
            return left
        }

        const right = known({ context: in.context, node: node.second })

        if (right != null) {
            return right
        }

        const expected: u32? = flags.comparison ? null : payload({ types: in.context.state.types, expected: in.expected })

        return expected != null ? expected : literal({ source: in.context.source, left: node.first, right: node.second })
    }
