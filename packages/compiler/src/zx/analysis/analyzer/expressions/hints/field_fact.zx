import integers from "std:integer"

import matches from "./field_path"

import type { Context } from "./model"

export type Input = { context: Context, node: u64 }

export type Output = bool

export default function (in: Input): Output {
    const facts = in.context.state.local.refinement.facts

    return loop({ context: in.context, node: in.node, facts: facts, index: 0, found: false }, {
        while: current => current.index < current.facts.nonnull.length && !current.found,
        next: current => {
            if (current.facts.projected[current.index]) {
                current.found = matches({ context: current.context, node: current.node, value: integers.widen(current.facts.nonnull[current.index]) })
            }

            current.index += 1
        }
    }).found
}
