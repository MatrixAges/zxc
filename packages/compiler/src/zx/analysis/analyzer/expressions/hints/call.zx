import { ExprKind } from "../../../../frontend/parser/expressions/state/model"
import lookup from "../../bindings/lookup"
import { NameKind } from "../../source/model"
import readName from "../../source/name"

import type { Context } from "./model"

export type Input = { context: Context, callee: u64 }

export type Output = u32?

    export default function (in: Input): Output {
        const source = in.context.source
        const callee = source.tree.nodes[in.callee]
        const field = callee.kind == ExprKind.Field

        if (callee.kind != ExprKind.Identifier && !field) {
            return null
        }

        const owner = field ? source.tree.nodes[callee.first] : callee

        if (owner.kind != ExprKind.Identifier) {
            return null
        }

        const root_name = readName({ source: source, kind: NameKind.Expression, index: field ? callee.first : in.callee }).text

        if (lookup({ local: in.context.state.local, name: root_name }) != null) {
            return null
        }

        const name = readName({ source: source, kind: NameKind.Expression, index: in.callee }).text
        const namespace: string? = field ? root_name : null
        const missing: u32? = null

        const found = loop({ imports: in.context.imports, namespace: namespace, name: name, index: 0, result: missing }, {
            while: current => current.index < current.imports.names.length && current.result == null,
            next: current => {
                if (current.imports.namespaces[current.index] == current.namespace && current.imports.names[current.index] == current.name) {
                    current.result = current.imports.output_types[current.index]
                }

                current.index += 1
            }
        })

        return found.result
    }
