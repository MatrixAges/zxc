import integers from "std:integer"
import append from "core/expression_table/append/binary"
import { BinaryOperator, ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import row from "../../../semantic/types/row"
import classify from "./classify"
import comparable from "./comparable"

import type { Span } from "../../../../frontend/lexer/token_model"
import type { Prepared } from "../../model"
import type { Result } from "../model"

export type Input = {
    state: Prepared,
    operator: BinaryOperator,
    left: u32,
    right: u32,
    span: Span
}

export type Output = Result

export default function (in: Input): Output {
    const expressions = in.state.local.expressions
    const operand = expressions.types[integers.widen(in.left)]

    const tables = {
        base: in.state.types.context.base,
        delta: in.state.types.delta
    }

    const target = row({
        tables,
        id: operand
    })

    const flags = classify(in.operator)
    const numeric = operand >= 2 && operand <= 9

    const optional_aggregate =
        flags.equality && target.kind == Kind.Optional && !comparable({
            tables,
            type_id: operand
        })

    const condition = (
        - optional_aggregate
        - and expressions.kinds[integers.widen(in.left)] != ExpressionKind.None
        - and expressions.kinds[integers.widen(
            in.right
        )] != ExpressionKind.None
    )

    if (condition) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: "optional aggregates can only be compared with null",
                    start: in.span.start,
                    end: in.span.end
                }
            },
            value: 0
        }
    }

    const equality =
        (
            - flags.equality
            - and (
                - operand == 1
                - or operand == 10
                - or target.kind == Kind.Enumeration
                - or target.kind == Kind.ErrorSet
                - or target.kind == Kind.Optional
            )
        )

    const condition_2 = (
        - in.operator != BinaryOperator.Coalesce
        - and !flags.logical
        - and !numeric
        - and !equality
    )

    if (condition_2) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: "operator is not supported for these operand types",
                    start: in.span.start,
                    end: in.span.end
                }
            },
            value: 0
        }
    }

    const result = match {
        in.operator == BinaryOperator.Coalesce => target.first,
        flags.logical || flags.comparison => 1,
        _ => operand,
    }
        -> append({
            table: expressions,
            metadata: {
                type_id: _,
                span_start: in.span.start,
                span_end: in.span.end
            },
            operator: in.operator,
            left: in.left,
            right: in.right
        })

    return {
        state: {
            ...in.state,
            local: {
                ...in.state.local,
                expressions: result.table
            }
        },
        value: result.id
    }
}
