import { BinaryOperator } from "core/expression_table/kinds"

export type Input = BinaryOperator

export type Output = {
    logical: bool,
    comparison: bool,
    equality: bool
}

export default function (in: Input): Output {
    const equality = in == BinaryOperator.Equal || in == BinaryOperator.NotEqual

    return (
        - in == BinaryOperator.Less
        - or in == BinaryOperator.LessEqual
        - or in == BinaryOperator.Greater
        - or in == BinaryOperator.GreaterEqual
    )
        -> {
            logical: in == BinaryOperator.LogicalAnd || in == BinaryOperator.LogicalOr,
            comparison: equality || _,
            equality
        }
}
