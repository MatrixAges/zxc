import { BinaryOperator } from "core/expression_table/kinds"

export type Input = BinaryOperator

export type Output = {
    logical: bool,
    comparison: bool,
    equality: bool
}

export default function (in: Input): Output {
    const equality = in == BinaryOperator.Equal || in == BinaryOperator.NotEqual

    const ordered = (
        match in {
            BinaryOperator.Less => true,
            BinaryOperator.LessEqual => true,
            BinaryOperator.Greater => true,
            BinaryOperator.GreaterEqual => true,
            _ => false
        }
    )

    return {
        logical: in == BinaryOperator.LogicalAnd || in == BinaryOperator.LogicalOr,
        comparison: equality || ordered,
        equality
    }
}
