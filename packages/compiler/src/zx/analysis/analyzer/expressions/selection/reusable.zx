import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    value: u32
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        expressions: in.expressions,
        value: in.value,
        done: false,
        reusable: false
    }, {
        while: current => !current.done,
        next: current => {
            const index = integers.widen(current.value)
            const kind = current.expressions.kinds[index]
            const payload = integers.widen(current.expressions.payloads[index])

            if (kind == ExpressionKind.Reference) {
                current.reusable = true
                current.done = true
            } else if (
                kind == ExpressionKind.Field || kind == ExpressionKind.TupleField
            ) {
                current.value = current.expressions.projection_targets[payload]
            } else if (kind == ExpressionKind.OptionalValue) {
                current.value = current.expressions.optional_values[payload]
            } else {
                current.done = true
            }
        },
        return: state => state.reusable
    })
}
