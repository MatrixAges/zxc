import integers from "std:integer"
import { pick } from "std:utils"

import plan from "../../../selection/plan"
import row from "../../../semantic/types/row"
import { name_code, unknown_field_message } from "./const"
import keys from "./keys"
import lower from "./lower"

import type { Prepared } from "../../model"
import type { Result } from "../model"
import type { Source } from "../request"

export type Input = {
    state: Prepared,
    source: Source,
    node: u64,
    target: u32,
    offset: u64,
    omit: bool
}

export type Output = Result

export default function (in: Input): Output {
    const node = in.source.tree.nodes[in.node]

    const fields = keys(pick(in, [
        "source",
        "node",
        "offset"
    ]))

    if (fields.diagnostic.message != "") {
        return {
            state: {
                ...in.state,
                diagnostic: fields.diagnostic
            },
            value: 0
        }
    }

    const tables = {
        base: in.state.types.context.base,
        delta: in.state.types.delta
    }

    const target = row({
        tables,
        id: in.state.local.expressions.types[integers.widen(in.target)]
    })

    const table = target.delta ? tables.delta : tables.base

    const selected = plan({
        names: table.field_names,
        first: integers.widen(target.first),
        count: integers.widen(target.second),
        keys: fields.names,
        omit: in.omit
    })

    if (selected.missing) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: name_code,
                    message: unknown_field_message,
                    start: node.span.start,
                    end: node.span.end
                }
            },
            value: 0
        }
    }

    if (selected.all) {
        return {
            state: in.state,
            value: in.target
        }
    }

    return lower({
        state: in.state,
        target: in.target,
        indices: selected.indices,
        span: node.span
    })
}
