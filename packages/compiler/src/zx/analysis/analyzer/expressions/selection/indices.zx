import integers from "std:integer"

import { no_diagnostic } from "../../../../../const"
import { name_code, unknown_field_message } from "./const"

import type { Diagnostic } from "../../../../frontend/lexer/model"
import type { Span } from "../../../../frontend/lexer/token_model"

export type Input = {
    names: string[],
    first: u64,
    count: u64,
    keys: string[],
    omit: bool,
    span: Span
}

export type Output = {
    indices: u32[],
    diagnostic: Diagnostic
}

export default function (in: Input): Output {
    const indices: u32[] = []

    const diagnostic: Diagnostic = {
        code: no_diagnostic,
        message: no_diagnostic,
        start: 0,
        end: 0
    }

    const checked = loop({
        input: in,
        index: 0,
        diagnostic
    }, {
        while: current =>
            current.index < current.input.keys.length && current.diagnostic.message == "",
        next: current => {
            const key = current.input.keys[current.index]
            const found = loop({
                input: current.input,
                key,
                index: 0
            }, {
                while: field =>
                    field.index < field.input.count &&
                    field.input.names[field.input.first + field.index] != field.key,
                next: field => { field.index += 1 }
            })

            if (found.index == current.input.count) {
                current.diagnostic = {
                    code: name_code,
                    message: unknown_field_message,
                    start: current.input.span.start,
                    end: current.input.span.end
                }
            }

            current.index += 1
        }
    })

    if (checked.diagnostic.message != "") {
        return {
            indices,
            diagnostic: checked.diagnostic
        }
    }

    const selected = loop({
        input: in,
        indices,
        index: 0
    }, {
        while: current => current.index < current.input.count,
        next: current => {
            const name = current.input.names[current.input.first + current.index]
            const requested = current.input.keys.some(key => key == name)

            if (requested != current.input.omit) {
                current.indices =
                    current.indices.push(integers.narrow(current.index))[0]
            }

            current.index += 1
        }
    })

    return {
        indices: selected.indices,
        diagnostic
    }
}
