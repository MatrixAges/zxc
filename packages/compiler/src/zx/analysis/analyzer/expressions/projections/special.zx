import { Kind } from "core/type_table/model"

import { ExprKind } from "../../../../frontend/parser/expressions/state/model"
import constant from "../../../constants/lookup"
import row from "../../../semantic/types/row"
import lookup from "../../bindings/lookup"
import { NameKind } from "../../source/model"
import readName from "../../source/name"
import readStore from "../../stores/read"
import payload from "../../types/payload"
import injected from "../injected/lookup"
import enumOwner from "./enum_owner"
import member from "./member"

import type { Result } from "../model"
import type { Request } from "../request"

export type Input = Request

export type Output = {
    handled: bool,
    result: Result
}

export default function (in: Input): Output {
    const node = in.source.tree.nodes[in.node]
    const owner = in.source.tree.nodes[node.first]

    const unhandled: Output = {
        handled: false,
        result: {
            state: in.state,
            value: 0
        }
    }

    if (owner.kind != ExprKind.Identifier) {
        const condition = (
            - owner.kind != ExprKind.Field
            - or in.source.tree.nodes[owner.first].kind != ExprKind.Identifier
            - or in.state.types.context.aliases.names.length == 0
        )

        if (condition) {
            return unhandled
        }

        const type_id = enumOwner({
            ...in,
            node: node.first
        })

        if (type_id.found) {
            return {
                handled: true,
                result: member({
                    state: in.state,
                    type_id: type_id.id,
                    name: readName({
                        source: in.source,
                        kind: NameKind.Expression,
                        index: in.node
                    }),
                    span: node.span,
                    error_member: false
                })
            }
        }

        return unhandled
    }

    const root = readName({
        source: in.source,
        kind: NameKind.Expression,
        index: node.first
    })

    const name = readName({
        source: in.source,
        kind: NameKind.Expression,
        index: in.node
    })

    const binding = injected({
        local: in.state.local,
        source: in.source,
        node: node.first
    })

    const condition_2 = (
        - root.text.length != 0
        - and root.text[0] == 36
        - and binding.symbol == null
        - and !binding.unit
    )

    if (condition_2) {
        return {
            handled: true,
            result: readStore({
                state: in.state,
                source: in.source,
                node: in.node
            })
        }
    }

    const tables = {
        base: in.state.types.context.base,
        delta: in.state.types.delta
    }

    const condition_3 = (
        - root.text == "error"
        - and lookup({
            active: in.state.local.active,
            names: in.state.local.symbols.names,
            scope_floor: in.state.local.scope_floor,
            name: root.text
        }) == null
        - and (in.source.constant_values == null || constant({
            active: in.state.local.active,
            names: in.state.local.symbols.names,
            constants: in.source.constant_values,
            name: root.text
        }) == null)
    )

    if (condition_3) {
        const expected = payload({
            types: in.state.types,
            expected: in.expected
        })

        if (expected == null || row({
            tables,
            id: expected
        }).kind != Kind.ErrorSet) {
            return {
                handled: true,
                result: {
                    state: {
                        ...in.state,
                        diagnostic: {
                            code: "type_mismatch",
                            message:
                                "an error member requires a finite error-set context",
                            start: node.span.start,
                            end: node.span.end
                        }
                    },
                    value: 0
                }
            }
        }

        return {
            handled: true,
            result: member({
                state: in.state,
                type_id: expected,
                name,
                span: node.span,
                error_member: true
            })
        }
    }

    const type_id = enumOwner({
        ...in,
        node: node.first
    })

    if (type_id.found && row({
        tables,
        id: type_id.id
    }).kind == Kind.Enumeration) {
        return {
            handled: true,
            result: member({
                state: in.state,
                type_id: type_id.id,
                name,
                span: node.span,
                error_member: false
            })
        }
    }

    return unhandled
}
