import known from "../../hints/known"
import next from "./next"

import type { Work } from "../model"
import type { Frame as Pipeline } from "../pipeline/model"

export type Input = Work

export type Output = Work

export default function (in: Input): Output {
    const index = in.frames.selections.length - 1
    const frame = in.frames.selections[index]

    const pipeline: Pipeline? = match {
        in.context.pipelines.length == 0 => null,
        _ => in.context.pipelines[in.context.pipelines.length - 1]
    }

    const expected = match {
        frame.expected != null => frame.expected,
        _ => known({
            context: {
                state: in.state,
                source: in.source,
                imports: in.imports,
                pipeline
            },
            node: frame.node
        })
    }

    const selections = in.frames.selections.splice(index, 1, [{
        ...frame,
        expected: expected
    }])[0]

    return next({
        ...in,
        frames: {
            ...in.frames,
            selections: selections
        }
    })
}
