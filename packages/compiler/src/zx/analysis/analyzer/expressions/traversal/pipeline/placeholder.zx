import integers from "std:integer"

import { ExprKind } from "../../../../../frontend/parser/expressions/state/model"
import capture from "../../../captures/by_symbol"
import { NameKind } from "../../../source/model"
import readName from "../../../source/name"
import coerce from "../../coerce"
import reference from "../../reference"
import { Phase } from "../model"
import { placeholder_name, boundary_message, name_code } from "./const"
import fail from "./fail"

import type { Output as Captured } from "../../../captures/by_symbol"
import type { Work } from "../model"

export type Input = Work

export type Output = {
    handled: bool,
    work: Work
}

export default function (in: Input): Output {
    const node = in.source.tree.nodes[in.node]

    if (in.context.pipelines.length == 0 || node.kind != ExprKind.Identifier) {
        return {
            handled: false,
            work: in
        }
    }

    const name = readName({
        source: in.source,
        kind: NameKind.Expression,
        index: in.node
    })

    if (name.text != placeholder_name) {
        return {
            handled: false,
            work: in
        }
    }

    const index = in.context.pipelines.length - 1
    const frame = in.context.pipelines[index]

    const shadowed_initial = {
        index: in.state.local.active.length,
        found: false
    }

    const shadowed_scope = {
        local: in.state.local,
        frame
    }

    const shadowed = loop(shadowed_initial, {
        while: state => !state.found &&
            state.index > shadowed_scope.frame.scope_start &&
            state.index > shadowed_scope.local.scope_floor,
        next: state => {
            state.index -= 1
            state.found = shadowed_scope.local.symbols
                .names[integers.widen(
                    shadowed_scope.local.active[state.index]
                )] == placeholder_name
        },
        return: state => state.found
    })

    if (shadowed) {
        return {
            handled: false,
            work: in
        }
    }

    const crossed = frame.depth != in.state.local.lambda_depth
    const not_length = frame.asynchronous != in.frames.asynchronous.length

    const valid_crossed = crossed && in.state.local.captures.current == frame.owner

    const condition = (
        - !frame.active
        - or not_length
        - or (valid_crossed)
    )

    if (condition) {
        return {
            handled: true,
            work: fail({
                work: in,
                code: name_code,
                message: boundary_message
            })
        }
    }

    const captured: Captured = match {
        in.state.local.captures.current == frame.owner => {
            state: in.state,
            symbol: frame.symbol
        },
        _ => capture({
            state: in.state,
            owner: frame.owner,
            symbol: frame.symbol,
            span: node.span
        })
    }

    if (captured.symbol == null) {
        return {
            handled: true,
            work: fail({
                work: in,
                code: name_code,
                message: boundary_message
            })
        }
    }

    const value = reference({
        expressions: captured.state.local.expressions,
        tables: {
            base: captured.state.types.context.base,
            delta: captured.state.types.delta
        },
        facts: captured.state.local.refinement.facts,
        type_id: captured.state.local.symbols.types[integers.widen(captured.symbol)],
        symbol: captured.symbol,
        span: node.span
    })

    const state = {
        ...captured.state,
        local: {
            ...captured.state.local,
            expressions: value.expressions
        }
    }

    const result = match {
        in.expected == null => {
            state,
            value: value.value
        },
        _ => coerce({
            state,
            value: value.value,
            expected: in.expected,
            span: node.span
        })
    }

    return {
        handled: true,
        work: {
            ...in,
            state: result.state,
            value: result.value,
            phase: Phase.Complete,
            context: {
                ...in.context,
                pipelines: in.context.pipelines.splice(index, 1, [{
                    ...frame,
                    uses: frame.uses + 1
                }])[0]
            }
        }
    }
}
