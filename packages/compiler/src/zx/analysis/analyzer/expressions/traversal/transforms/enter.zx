import { TransformKind } from "core/expression_table/kinds"

import payload from "../../../types/payload"
import { Phase, Action } from "../model"
import callback from "./callback"

import type { Frame } from "../../../collections/model"
import type { Work } from "../model"

export type Input = {
    work: Work,
    tuple_result: bool,
    projection?: u64,
    node: u64,
    kind: TransformKind,
    target: u32,
    expected?: u32,
    arguments: u64[]
}

export type Output = Work

export default function (in: Input): Output {
    const node = in.work.source.tree.nodes[in.node]
    const arguments = in.arguments
    const kind = in.kind

    if (arguments.length < 1 || arguments.length > 2) {
        return {
            ...in.work,
            state: {
                ...in.work.state,
                diagnostic: {
                    code: "type_mismatch",
                    message:
                        "collection operation requires a callback and at most one additional argument",
                    start: node.span.start,
                    end: node.span.end
                }
            }
        }
    }

    const frame: Frame = {
        tuple_result: in.tuple_result,
        projection: in.projection,
        node: in.node,
        kind,
        target: in.target,
        expected: in.expected,
        second: null,
        arguments,
        capture_frame: 0,
        parameters: [],
        result_type: 0
    }

    const work = {
        ...in.work,
        frames: {
            ...in.work.frames,
            transforms: in.work.frames.transforms.push(frame)[0]
        }
    }

    if (arguments.length == 1) {
        return callback(work)
    }

    const expected = kind == TransformKind.Reduce ? payload({
        types: work.state.types,
        expected: in.expected
    }) : null

    return {
        ...work,
        node: arguments[1],
        expected,
        phase: Phase.Evaluate,
        frames: {
            ...work.frames,
            actions: work.frames.actions.push(Action.TransformSecond)[0]
        }
    }
}
