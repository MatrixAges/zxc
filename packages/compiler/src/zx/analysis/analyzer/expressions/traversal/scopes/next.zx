import { StatementKind } from "../../../../../frontend/parser/body/model"
import { NameKind } from "../../../source/model"
import readName from "../../../source/name"
import reference from "../../../source/reference"
import bindingName from "../../../statements/scopes/binding_name"
import annotation from "../../../types/annotation"
import { Phase, Action } from "../model"
import complete from "./complete"

import type { Prepared } from "../../../model"
import type { Work } from "../model"

export type Input = Work

export type Output = Work

export default function (in: Input): Output {
    const position = in.scopes.frames.length - 1
    const frame = in.scopes.frames[position]

    if (frame.next == frame.statements.length) {
        return complete(in)
    }

    const id = frame.statements[frame.next]
    const statement = in.source.blocks.statements[id]

    const scopes = {
        ...in.scopes,
        frames: in.scopes.frames.splice(position, 1, [{
            ...frame,
            next: frame.next + 1
        }])[0]
    }

    const work: Work = {
        ...in,
        scopes: scopes,
        node: statement.first,
        expected: null,
        phase: Phase.Evaluate
    }

    if (frame.value_block && statement.kind == StatementKind.Result) {
        if (statement.first == 0 || frame.next + 1 != frame.statements.length) {
            return {
                ...work,
                state: {
                    ...work.state,
                    diagnostic: {
                        code: "return_path",
                        message: "callback blocks require a final return value",
                        start: statement.span.start,
                        end: statement.span.end
                    }
                }
            }
        }

        return {
            ...work,
            node: statement.first - 1,
            expected: frame.expected,
            frames: {
                ...work.frames,
                actions: work.frames.actions.push(Action.ValueReturn)[0]
            }
        }
    }

    const local_statement = statement.kind == StatementKind.Constant ||
        statement.kind == StatementKind.Destructure ||
        statement.kind == StatementKind.Evaluate

    if (frame.value_block && !local_statement) {
        return {
            ...work,
            state: {
                ...work.state,
                diagnostic: {
                    code: "unsupported",
                    message:
                        "value callback blocks support local bindings and a final return",
                    start: statement.span.start,
                    end: statement.span.end
                }
            }
        }
    }

    if (
        statement.kind == StatementKind.Result || statement.kind == StatementKind.StoreSet
    ) {
        const returning = statement.kind == StatementKind.Result

        return {
            ...work,
            state: {
                ...work.state,
                diagnostic: {
                    code: returning ? "return_path" : "capability",
                    message:
                        match {
                            returning =>
                                "loop steps yield state at the block end; return is not allowed",
                            _ => "Store writes are not allowed in loop callbacks"
                        },
                    start: statement.span.start,
                    end: statement.span.end
                }
            }
        }
    }

    if (statement.kind == StatementKind.Constant) {
        const name = readName({
            source: work.source,
            kind: NameKind.Statement,
            index: id
        })

        const diagnostic = bindingName({
            scopes: work.scopes,
            local: work.state.local,
            name: name
        })

        if (diagnostic.message != "") {
            return {
                ...work,
                state: {
                    ...work.state,
                    diagnostic
                }
            }
        }

        const resolved: {
            state: Prepared,
            id: u32
        } = match {
            statement.annotation == 0 => {
                state: work.state,
                id: 0
            },
            _ => annotation({
                state: work.state,
                reference: reference({
                    source: work.source,
                    index: statement.annotation - 1
                })
            })
        }

        return {
            ...work,
            state: resolved.state,
            expected: statement.annotation == 0 ? null : resolved.id,
            frames: {
                ...work.frames,
                statements: work.frames.statements.push(id)[0],
                actions: work.frames.actions.push(Action.StateConstant)[0]
            }
        }
    }

    if (statement.kind == StatementKind.StateUpdate) {
        return {
            ...work,
            frames: {
                ...work.frames,
                updates: work.frames.updates.push({
                    statement: id,
                    places: [],
                    target: 0
                })[0],
                actions: work.frames.actions.push(Action.StateTarget)[0]
            }
        }
    }

    if (statement.kind == StatementKind.Branch) {
        return {
            ...work,
            expected: 1,
            frames: {
                ...work.frames,
                branches: work.frames.branches.push({
                    statement: id,
                    condition: 0,
                    yes: 0,
                    state_symbol: frame.state_symbol,
                    mark: {
                        nonnull: 0,
                        captures: 0
                    }
                })[0],
                actions: work.frames.actions.push(Action.StateCondition)[0]
            }
        }
    }

    if (statement.kind == StatementKind.Switch) {
        return {
            ...work,
            node: id,
            phase: Phase.StateSwitch
        }
    }

    return {
        ...work,
        frames: {
            ...work.frames,
            statements: work.frames.statements.push(id)[0],
            actions:
                work.frames.actions.push(
                    match {
                        statement.kind == StatementKind.Evaluate => Action.StateEvaluate,
                        _ => Action.StateDestructure
                    }
                )[0]
        }
    }
}
