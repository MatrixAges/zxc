import integers from "std:integer"
import { Kind } from "core/type_table/model"

import row from "../../../../semantic/types/row"
import items from "../../items"
import intrinsic from "../utilities/enter"
import { native_arity_message, tuple_arity_message, input_arity_message } from "./const"
import invalid from "./invalid"
import next from "./next"

import type { Work, Imported } from "../model"

export type Input = {
    work: Work,
    index: u64
}

export type Output = Work

export default function (in: Input): Output {
    const work = in.work
    const node = work.source.tree.nodes[work.node]

    if (work.imports.intrinsics[in.index] != null) {
        return intrinsic(in)
    }

    const id = work.imports.ids[in.index]
    const input = work.imports.input_types[in.index]

    if (id == null || input == null) {
        return invalid({
            work,
            node: work.node
        })
    }

    const self_call = work.state.local.self_function == id

    const stores = self_call ? work.state.local.stores :
        work.functions.stores[integers.widen(id)]

    if (stores.types.length != 0) {
        return {
            ...work,
            state: {
                ...work.state,
                diagnostic: {
                    code: "capability",
                    message:
                        "Store functions require an explicitly authorized orchestration Call",
                    start: node.span.start,
                    end: node.span.end
                }
            }
        }
    }

    const native_tuple =
        !self_call && work.functions.native_modules[integers.widen(id)] != null &&
        work.functions.native_tuples[integers.widen(
            id
        )]

    const target = row({
        tables: {
            base: work.state.types.context.base,
            delta: work.state.types.delta
        },
        id: input
    })

    const tuple = native_tuple || (target.kind == Kind.Tuple && node.count > 1)

    const valid = tuple ? node.count == integers.widen(target.second) :
        node.count == 1 || (
            input == 0 && node.count == 0
        )

    if (!valid) {
        return match {
            native_tuple => native_arity_message,
            tuple => tuple_arity_message,
            _ => input_arity_message
        }
            -> {
                ...work,
                state: {
                    ...work.state,
                    diagnostic: {
                        code: "type_mismatch",
                        message: _,
                        start: node.span.start,
                        end: node.span.end
                    }
                }
            }
    }

    const frame: Imported = {
        node: work.node,
        import_index: in.index,
        tuple,
        arguments: items({
            items: work.source.tree.items,
            head: node.head
        }),
        index: 0,
        values: []
    }

    return next({
        ...work,
        frames: {
            ...work.frames,
            imported: work.frames.imported.push(frame)[0]
        }
    })
}
