import mark from "../../../../ir/canonical/refinement/facts/mark"
import { Phase } from "./model"

import type { Work } from "./model"

export type Input = { work: Work, node: u64, expected: u32? }

export type Output = Work

export default function (in: Input): Output {
    const local = in.work.state.local

    return {
        ...in.work,
        boundary: { active: local.active.length, floor: local.scope_floor, depth: local.lambda_depth, captures: local.captures.current, facts: mark(local.refinement.facts) },
        node: in.node,
        expected: in.expected,
        value: 0,
        phase: Phase.Evaluate
    }
}
