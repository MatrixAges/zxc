import integers from "std:integer"
import { TransformKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import row from "../../../../semantic/types/row"
import { NameKind } from "../../../source/model"
import readName from "../../../source/name"
import {
    method_map,
    method_reduce,
    method_clone,
    unsupported_code,
    removed_method_message,
    clone_message
} from "../../calls/const"
import plan from "../../calls/list/plan"
import items from "../../items"
import { method_pick, method_omit } from "../../selection/const"
import select from "../../selection/select"
import next from "../lists/next"
import { Phase } from "../model"
import transform from "../transforms/enter"

import type { Work, ListCall } from "../model"

export type Input = Work

export type Output = Work

export default function (in: Input): Output {
    const position = in.frames.methods.length - 1
    const frame = in.frames.methods[position]
    const node = in.source.tree.nodes[frame.node]
    const callee = in.source.tree.nodes[node.first]

    const name = readName({
        source: in.source,
        kind: NameKind.Expression,
        index: node.first
    })

    const message = match name.text {
        method_clone => clone_message,
        method_map => removed_method_message,
        method_reduce => removed_method_message,
        _ => ""
    }

    if (message != "") {
        return {
            ...in,
            state: {
                ...in.state,
                diagnostic: {
                    code: unsupported_code,
                    message,
                    start: node.span.start,
                    end: node.span.end
                }
            }
        }
    }

    const list = in.state.local.expressions.types[integers.widen(in.value)]

    const target = row({
        tables: {
            base: in.state.types.context.base,
            delta: in.state.types.delta
        },
        id: list
    })

    if (target.kind != Kind.List) {
        if (
            target.kind == Kind.Object &&
                (name.text == method_pick || name.text == method_omit)
        ) {
            const result = select({
                state: in.state,
                source: in.source,
                node: frame.node,
                target: in.value,
                offset: 0,
                omit: name.text == method_omit
            })

            return {
                ...in,
                state: result.state,
                value: result.value,
                phase: Phase.Complete,
                frames: {
                    ...in.frames,
                    methods: in.frames.methods.pop()[0]
                }
            }
        }

        return {
            ...in,
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: "collection methods require a list",
                    start: name.start,
                    end: name.end
                }
            }
        }
    }

    if (
        name.text == "filter" || name.text == "every" || name.text == "some"
    ) {
        return transform({
            work: {
                ...in,
                frames: {
                    ...in.frames,
                    methods: in.frames.methods.pop()[0]
                }
            },
            node: frame.node,
            kind: match name.text {
                "filter" => TransformKind.Filter,
                "every" => TransformKind.Every,
                _ => TransformKind.Some
            },
            target: in.value,
            expected: frame.expected,
            arguments: items({
                items: in.source.tree.items,
                head: node.head
            })
        })
    }

    const planned = plan({
        name: name.text,
        count: node.count,
        list,
        element: target.first
    })

    if (planned.message != "") {
        return {
            ...in,
            state: {
                ...in.state,
                diagnostic: {
                    code: planned.code,
                    message: planned.message,
                    start: node.span.start,
                    end: node.span.end
                }
            }
        }
    }

    const call: ListCall = {
        node: frame.node,
        target: in.value,
        kind: planned.kind,
        replacement: planned.replacement,
        arguments: items({
            items: in.source.tree.items,
            head: node.head
        }),
        hints: planned.hints,
        index: 0,
        values: []
    }

    return next({
        ...in,
        frames: {
            ...in.frames,
            methods: in.frames.methods.pop()[0],
            lists: in.frames.lists.push(call)[0]
        }
    })
}
