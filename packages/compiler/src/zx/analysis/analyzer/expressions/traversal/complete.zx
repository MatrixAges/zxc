import coerce from "../coerce"
import asynchronous from "./asynchronous"
import binary from "./binary"
import target from "./calls/target"
import conditional from "./conditional"
import imported from "./imported/resume"
import iteration from "./iteration/resume"
import list from "./lists/resume"
import matching from "./matching/resume"
import { Phase, Action } from "./model"
import object from "./objects/resume"
import parallel from "./parallel/resume"
import pipeline from "./pipeline/resume"
import projection from "./projection"
import binding from "./scopes/binding"
import branch from "./scopes/branch"
import selection from "./scopes/selection/resume"
import update from "./scopes/update"
import sequence from "./sequence/resume"
import template from "./templates/resume"
import transform from "./transforms/resume"

import type { Work } from "./model"

export type Input = Work

export type Output = Work

export default function (in: Input): Output {
    if (in.frames.actions.length == 0) {
        return {
            ...in,
            phase: Phase.Done
        }
    }

    const action = in.frames.actions[in.frames.actions.length - 1]

    const work = {
        ...in,
        frames: {
            ...in.frames,
            actions: in.frames.actions.pop()[0]
        }
    }

    if (action == Action.PipelineInput || action == Action.PipelineStage) {
        return pipeline({
            work,
            action
        })
    }

    if (action == Action.AsyncBody) {
        return asynchronous(work)
    }

    if (action == Action.ParallelBody) {
        return parallel(work)
    }

    if (action == Action.Coerce) {
        const frame = work.frames.coercions[work.frames.coercions.length - 1]

        const result = coerce({
            state: work.state,
            value: work.value,
            expected: frame.expected,
            span: frame.span
        })

        return {
            ...work,
            state: result.state,
            value: result.value,
            frames: {
                ...work.frames,
                coercions: work.frames.coercions.pop()[0]
            }
        }
    }

    if (action == Action.BinaryLeft || action == Action.BinaryRight) {
        return binary({
            work,
            action
        })
    }

    const condition = (
        - action == Action.Condition
        - or action == Action.Yes
        - or action == Action.No
    )

    if (condition) {
        return conditional({
            work,
            action
        })
    }

    const condition_2 = (
        - action == Action.MatchSubject
        - or action == Action.MatchCondition
        - or action == Action.MatchResult
        - or action == Action.MatchFallback
    )

    if (condition_2) {
        return matching({
            work,
            action
        })
    }

    if (action == Action.Object) {
        return object(work)
    }

    if (action == Action.Imported) {
        return imported(work)
    }

    if (action == Action.MethodTarget) {
        return target(work)
    }

    if (action == Action.ListArgument) {
        return list(work)
    }

    if (action == Action.Template) {
        return template(work)
    }

    if (action == Action.TransformSecond || action == Action.TransformBody) {
        return transform({
            work,
            action
        })
    }

    const condition_3 = (
        - action == Action.IterationInitial
        - or action == Action.IterationContext
        - or action == Action.IterationCondition
        - or action == Action.IterationStep
        - or action == Action.IterationReturn
    )

    if (condition_3) {
        return iteration({
            work,
            action
        })
    }

    const condition_4 = (
        - action == Action.StateEvaluate
        - or action == Action.StateConstant
        - or action == Action.StateDestructure
    )

    if (condition_4) {
        return binding({
            work,
            action
        })
    }

    if (action == Action.StateTarget || action == Action.StateValue) {
        return update({
            work,
            action
        })
    }

    const condition_5 = (
        - action == Action.StateCondition
        - or action == Action.StateYes
        - or action == Action.StateNo
    )

    if (condition_5) {
        return branch({
            work,
            action
        })
    }

    const condition_6 = (
        - action == Action.StateSubject
        - or action == Action.StateLabel
        - or action == Action.StateCase
    )

    if (condition_6) {
        return selection({
            work,
            action
        })
    }

    return action == Action.Sequence ? sequence(work) : projection({
        work,
        action
    })
}
