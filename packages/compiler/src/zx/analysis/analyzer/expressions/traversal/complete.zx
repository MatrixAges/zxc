import asynchronous from "./asynchronous"
import binary from "./binary"
import target from "./calls/target"
import coercion from "./coercion"
import conditional from "./conditional"
import imported from "./imported/resume"
import iteration from "./iteration/resume"
import list from "./lists/resume"
import matching from "./matching/resume"
import { Phase, Action } from "./model"
import object from "./objects/resume"
import parallel from "./parallel/resume"
import pipeline from "./pipeline/resume"
import projection from "./projection"
import binding from "./scopes/binding"
import branch from "./scopes/branch"
import selection from "./scopes/selection/resume"
import update from "./scopes/update"
import sequence from "./sequence/resume"
import template from "./templates/resume"
import transform from "./transforms/resume"

import type { Work } from "./model"

export type Input = Work

export type Output = Work

export default function (in: Input): Output {
    if (in.frames.actions.length == 0) {
        return {
            ...in,
            phase: Phase.Done
        }
    }

    const action = in.frames.actions[in.frames.actions.length - 1]

    const work = {
        ...in,
        frames: {
            ...in.frames,
            actions: in.frames.actions.pop()[0]
        }
    }

    if (action == Action.ValueReturn) {
        const position = work.scopes.frames.length - 1
        const frame = work.scopes.frames[position]

        return {
            ...work,
            scopes: {
                ...work.scopes,
                frames: work.scopes.frames.splice(position, 1, [{
                    ...frame,
                    result: work.value
                }])[0]
            },
            phase: Phase.ScopeNext
        }
    }

    if (action == Action.PipelineInput || action == Action.PipelineStage) {
        return pipeline({
            work,
            action
        })
    }

    if (action == Action.AsyncBody) {
        return asynchronous(work)
    }

    if (action == Action.ParallelBody) {
        return parallel(work)
    }

    if (action == Action.Coerce) {
        return coercion(work)
    }

    if (action == Action.BinaryLeft || action == Action.BinaryRight) {
        return binary({
            work,
            action
        })
    }

    const condition = (
        match action {
            Action.Condition => true,
            Action.Yes => true,
            Action.No => true,
            _ => false
        }
    )

    if (condition) {
        return conditional({
            work,
            action
        })
    }

    const condition_2 = (
        match action {
            Action.MatchSubject => true,
            Action.MatchCondition => true,
            Action.MatchResult => true,
            Action.MatchFallback => true,
            _ => false
        }
    )

    if (condition_2) {
        return matching({
            work,
            action
        })
    }

    if (action == Action.Object) {
        return object(work)
    }

    if (action == Action.Imported) {
        return imported(work)
    }

    if (action == Action.MethodTarget) {
        return target(work)
    }

    if (action == Action.ListArgument) {
        return list(work)
    }

    if (action == Action.Template) {
        return template(work)
    }

    if (action == Action.TransformSecond || action == Action.TransformBody) {
        return transform({
            work,
            action
        })
    }

    const condition_3 = (
        match action {
            Action.IterationInitial => true,
            Action.IterationCondition => true,
            Action.IterationStep => true,
            Action.IterationReturn => true,
            _ => false
        }
    )

    if (condition_3) {
        return iteration({
            work,
            action
        })
    }

    const condition_4 = (
        match action {
            Action.StateEvaluate => true,
            Action.StateConstant => true,
            Action.StateDestructure => true,
            _ => false
        }
    )

    if (condition_4) {
        return binding({
            work,
            action
        })
    }

    if (action == Action.StateTarget || action == Action.StateValue) {
        return update({
            work,
            action
        })
    }

    const condition_5 = (
        match action {
            Action.StateCondition => true,
            Action.StateYes => true,
            Action.StateNo => true,
            _ => false
        }
    )

    if (condition_5) {
        return branch({
            work,
            action
        })
    }

    const condition_6 = (
        match action {
            Action.StateSubject => true,
            Action.StateLabel => true,
            Action.StateCase => true,
            _ => false
        }
    )

    if (condition_6) {
        return selection({
            work,
            action
        })
    }

    return match {
        action == Action.Sequence => sequence(work),
        _ => projection({
            work,
            action
        })
    }
}
