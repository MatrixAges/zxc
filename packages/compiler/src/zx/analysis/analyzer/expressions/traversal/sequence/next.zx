import integers from "std:integer"

import row from "../../../../semantic/types/row"
import { Phase, Action } from "../model"
import finish from "./finish"

import type { Work } from "../model"

export type Input = Work

export type Output = Work

export default function (in: Input): Output {
    const frame = in.frames.sequences[in.frames.sequences.length - 1]

    if (frame.index == frame.items.length) {
        return finish(in)
    }

    const tuple = frame.tuple
    const tables = { base: in.state.types.context.base, delta: in.state.types.delta }
    const target = row({ tables: tables, id: tuple ?? 0 })
    const table = target.delta ? tables.delta : tables.base
    const expected = tuple == null ? frame.element : table.children[integers.widen(target.first) + frame.index]

    return { ...in, node: frame.items[frame.index], expected: expected, phase: Phase.Evaluate, frames: { ...in.frames, actions: in.frames.actions.push(Action.Sequence)[0] } }
}
