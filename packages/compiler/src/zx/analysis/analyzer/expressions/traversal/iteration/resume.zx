import integers from "std:integer"

import gather from "../../../captures/gather"
import callback from "../../../iteration/callback"
import environment from "../../../iteration/environment"
import finish from "../../../iteration/finish"
import leave from "../../../iteration/leave"
import { Phase, Action } from "../model"
import start from "./start"

import type { Work } from "../model"

export type Input = {
    work: Work,
    action: Action
}

export type Output = Work

export default function (in: Input): Output {
    if (in.action == Action.IterationInitial) {
        return start({
            work: in.work
        })
    }

    const work = in.work
    const position = work.frames.iterations.length - 1
    const frame = work.frames.iterations[position]

    const captures = match {
        frame.context.capture_frame == null => {
            sources: [],
            targets: [],
            values: []
        },
        _ => gather({
            captures: work.state.local.captures,
            frame: frame.context.capture_frame
        })
    }

    const body = {
        local: work.state.local,
        value: work.value
    }

    const state = {
        ...work.state,
        local: leave({
            local: body.local,
            context: frame.context
        })
    }

    if (in.action == Action.IterationCondition) {
        const entered = callback({
            state,
            source: work.source,
            node: frame.step_node,
            type_id: state.local.expressions.types[integers.widen(frame.initial)],
            updating: true
        })

        const iterations = work.frames.iterations.splice(position, 1, [{
            ...frame,
            condition: body.value,
            condition_captures: captures,
            parameter: entered.parameter,
            context: entered.context
        }])[0]

        return {
            ...work,
            state: entered.state,
            node: entered.body,
            expected: null,
            phase: Phase.StateBlock,
            frames: {
                ...work.frames,
                iterations: iterations,
                actions: work.frames.actions.push(Action.IterationStep)[0]
            }
        }
    }

    if (in.action == Action.IterationStep && frame.result_node != null) {
        const entered = callback({
            state,
            source: work.source,
            node: frame.result_node,
            type_id: state.local.expressions.types[integers.widen(frame.initial)],
            updating: false
        })

        return {
            ...work,
            state: entered.state,
            node: entered.body,
            expected: frame.expected,
            phase: Phase.Evaluate,
            frames: {
                ...work.frames,
                iterations: work.frames.iterations.splice(position, 1, [{
                    ...frame,
                    step_body: body.value,
                    step_captures: captures,
                    result_parameter: entered.parameter,
                    context: entered.context
                }])[0],
                actions: work.frames.actions.push(Action.IterationReturn)[0]
            }
        }
    }

    const span = work.source.tree.nodes[frame.node].span

    const prepared = environment({
        state,
        frame: {
            ...frame,
            step_captures: match {
                in.action == Action.IterationStep => captures,
                _ => frame.step_captures
            }
        },
        body: in.action == Action.IterationReturn ? frame.step_body : body.value,
        projection:
            match {
                in.action == Action.IterationReturn && frame.result_parameter != null => {
                    parameter: frame.result_parameter,
                    body: body.value
                },
                _ => null
            },
        captures,
        span
    })

    const result = finish({
        local: prepared.state.local,
        frame: prepared.frame,
        body: prepared.body,
        projection: prepared.projection,
        start: span.start,
        end: span.end
    })

    return {
        ...work,
        state: {
            ...prepared.state,
            local: result.local
        },
        value: result.value,
        phase: Phase.Complete,
        frames: {
            ...work.frames,
            iterations: work.frames.iterations.pop()[0]
        }
    }
}
