import append from "core/expression_table/append/empty"
import { Kind } from "core/type_table/model"

import row from "../../semantic/types/row"

import type { Span } from "../../../frontend/lexer/token_model"
import type { Prepared } from "../model"
import type { Result } from "./model"

export type Input = { state: Prepared, expected: u32?, span: Span }

export type Output = Result

export default function (in: Input): Output {
    const expected = in.expected

    if (expected == null || row({ tables: { base: in.state.types.context.base, delta: in.state.types.delta }, id: expected }).kind != Kind.Optional) {
        return { state: { ...in.state, diagnostic: { code: "type_mismatch", message: "null requires an optional type context", start: in.span.start, end: in.span.end } }, value: 0 }
    }

    const result = append({ table: in.state.local.expressions, metadata: { type_id: expected, span_start: in.span.start, span_end: in.span.end }, optional: true })

    return { state: { ...in.state, local: { ...in.state.local, expressions: result.table } }, value: result.id }
}
