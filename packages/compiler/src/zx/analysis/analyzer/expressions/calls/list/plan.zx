import { type_id_u8, type_id_u64, type_id_string } from "core/const"
import { CollectionKind } from "core/expression_table/kinds"

import { no_diagnostic } from "../../../../../../const"
import {
    method_with,
    method_pop,
    method_sort,
    method_reverse,
    method_splice,
    method_concat,
    method_concat_text,
    method_push,
    unknown_method,
    with_arity,
    method_arity,
    sort_element,
    text_element,
    name_code,
    type_code,
} from "./const"

export type Input = {
    name: string,
    count: u64,
    list: u32,
    element: u32
}

export type Output = {
    kind: CollectionKind,
    replacement: bool,
    hints: u32[],
    code: string,
    message: string
}

export default function (in: Input): Output {
    const text = in.name == method_concat_text
    const replacement = in.name == method_with

    const kind = match in.name {
        method_pop => CollectionKind.Pop,
        method_sort => CollectionKind.Sort,
        method_reverse => CollectionKind.Reverse,
        method_splice => CollectionKind.Splice,
        method_concat => CollectionKind.Concat,
        method_concat_text => CollectionKind.Concat,
        _ => CollectionKind.Push,
    }

    const known =
        (
            - text
            - or replacement
            - or in.name == method_push
            - or in.name == method_pop
            - or in.name == method_sort
            - or in.name == method_reverse
            - or in.name == method_splice
            - or in.name == method_concat
        )

    const hints: u32[] = match {
        replacement => [
            type_id_u64,
            in.element
        ],
        kind == CollectionKind.Push => [in.element],
        kind == CollectionKind.Concat => [text ? type_id_string : in.list],
        kind == CollectionKind.Splice => [
            type_id_u64,
            type_id_u64,
            in.list
        ],
        _ => [],
    }

    const message = match {
        !known => unknown_method,
        text && in.element != type_id_u8 => text_element,
        in.count != hints.length =>
            match {
                replacement => with_arity,
                _ => method_arity
            },
        kind == CollectionKind.Sort &&
            (in.element < type_id_u8 || in.element > type_id_string) =>
            sort_element,
        _ => no_diagnostic,
    }

    return {
        kind,
        replacement,
        hints,
        code: !known ? name_code : type_code,
        message: message
    }
}
