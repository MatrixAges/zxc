import integers from "std:integer"

import value from "../bindings/value"
import reference from "./reference"

import type { Name } from "../../semantic/resolving/source/model"
import type { Prepared } from "../model"
import type { Result } from "./model"

export type Input = { state: Prepared, name: Name }

export type Output = Result

export default function (in: Input): Output {
    const resolved = value(in)

    if (resolved.state.diagnostic.message != "") {
        return { state: resolved.state, value: 0 }
    }

    const result = reference({ expressions: resolved.state.local.expressions, tables: { base: resolved.state.types.context.base, delta: resolved.state.types.delta }, facts: resolved.state.local.refinement.facts, type_id: resolved.state.local.symbols.types[integers.widen(resolved.symbol)], symbol: resolved.symbol, span: { start: in.name.start, end: in.name.end } })

    return { state: { ...resolved.state, local: { ...resolved.state.local, expressions: result.expressions } }, value: result.value }
}
