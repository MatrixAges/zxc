import matches from "../../../binding_path/match"

import type { Source } from "../request"

export type Input = {
    source: Source,
    node: u64,
    path: string
}

export type Output = bool

export default function (in: Input): Output {
    const native = in.source.native

    return matches({
        source: in.source.bytes,
        nodes: in.source.tree.nodes,
        native_names: match {
            native != null => native.text.expression_names,
            _ => null
        },
        node: in.node,
        path: in.path,
        rooted: false
    })
}
