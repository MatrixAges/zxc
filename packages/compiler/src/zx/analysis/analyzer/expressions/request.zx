import type { Values } from "core/constant/model"
import type { BlockTree } from "../../../frontend/parser/body/model"
import type { ExprTree } from "../../../frontend/parser/expressions/state/model"
import type { Prepared } from "../model"
import type { NativeModule } from "../source/model"

export type Source = {
    bytes: u8[],
    tree: ExprTree,
    blocks: BlockTree,
    constant_values?: Values,
    native?: NativeModule
}

export type Request = {
    state: Prepared,
    source: Source,
    node: u64,
    expected?: u32
}
