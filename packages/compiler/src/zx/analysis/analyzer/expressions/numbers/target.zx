import {
    type_id_u8,
    type_id_u64,
    type_id_i32,
    type_id_i64,
    type_id_f32,
    type_id_f64
} from "core/const"

import type { Target } from "./model"

export type Input = {
    expected?: u32,
    floating: bool,
    negative: bool
}

export type Output = Target

export default function (in: Input): Output {
    const id = in.expected ?? match {
        in.floating => type_id_f64,
        in.negative => type_id_i64,
        _ => type_id_u64,
    }

    return {
        id,
        floating: id == type_id_f32 || id == type_id_f64,
        single: id == type_id_f32,
        integer: id >= type_id_u8 && id <= type_id_i64,
        signed: id == type_id_i32 || id == type_id_i64
    }
}
