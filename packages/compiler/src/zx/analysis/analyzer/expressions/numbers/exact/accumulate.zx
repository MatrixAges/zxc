export type Input = { limbs: u64[], digit: u64 }

export type Output = { limbs: u64[], overflow: bool }

export default function (in: Input): Output {
    const result = loop({ limbs: in.limbs, carry: in.digit, index: 0 }, {
        while: current => current.index < current.limbs.length,
        next: current => {
            const value = current.limbs[current.index] * 10 + current.carry

            current.limbs[current.index] = value % 4294967296
            current.carry = value / 4294967296
            current.index += 1
        }
    })

    const overflow = result.carry != 0 && result.limbs.length == 32

    return { limbs: result.carry == 0 || overflow ? result.limbs : result.limbs.push(result.carry)[0], overflow: overflow }
}
