<Module>
    <Type from="context" as="Context" />
    <Type from="model" as="Model" />

    <Args in={Context.ModuleInput} out={Model.Prepared} />

    <Call
        module="declarations"
        in={{
            bytes: $in.bytes,
            syntax: $in.syntax,
            native: $in.native,
            type_base: $in.context.type_base,
            aliases: $in.context.aliases,
            nominal_base: $in.context.nominal_base,
            nominal_origin: $in.context.nominal_origin,
            shared: $in.context.shared
        }}
    />

    <If on={$ctx.declarations.diagnostic.message == ""}>
        <Call
            module="signature"
            in={{
                syntax: $in.syntax,
                types: $ctx.declarations.types
            }}
        />

        <If on={$ctx.signature.diagnostic.message == ""}>
            <Call
                module="stores"
                in={{
                    context: $in.context,
                    signature: $ctx.signature,
                    has_store: $in.syntax.has_store
                }}
            />

            <If on={$ctx.stores.diagnostic.message == ""}>
                <Call
                    module="initialize"
                    in={{
                        signature: $ctx.signature,
                        stores: $ctx.stores.stores,
                        allow_store: $ctx.stores.allow_store,
                        has_body: $in.syntax.body != null
                    }}
                />

                <Return
                    value={{
                        types: $ctx.signature.types,
                        local: $ctx.initialize.local,
                        input_type: $ctx.signature.input_type,
                        diagnostic: $ctx.initialize.diagnostic
                    }}
                />

                <Else>
                    <Call
                        fn="failure"
                        in={{
                            module: $in,
                            types: $ctx.signature.types,
                            diagnostic: $ctx.stores.diagnostic
                        }}
                    />

                    <Return value={$ctx.failure} />
                </Else>
            </If>

            <Else>
                <Call
                    fn="failure"
                    in={{
                        module: $in,
                        types: $ctx.signature.types,
                        diagnostic: $ctx.signature.diagnostic
                    }}
                />

                <Return value={$ctx.failure} />
            </Else>
        </If>

        <Else>
            <Call
                fn="failure"
                in={{
                    module: $in,
                    types: $ctx.declarations.types,
                    diagnostic: $ctx.declarations.diagnostic
                }}
            />

            <Return value={$ctx.failure} />
        </Else>
    </If>
</Module>
