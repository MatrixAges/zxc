import type { Import } from "../../../../frontend/parser/imports/model"

export type Input = {
    imports: Import[],
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const found = loop({
        imports: in.imports,
        index: in.index,
        low: 0,
        high: in.imports.length
    }, {
        while: current => current.low < current.high,
        next: current => {
            const middle = current.low + (current.high - current.low) / 2

            if (current.imports[middle].first <= current.index) {
                current.low = middle + 1
            } else {
                current.high = middle
            }
        }
    }).low

    if (found == 0) {
        return false
    }

    const item = in.imports[found - 1]

    return !item.exported && in.index < item.first + item.count
}
