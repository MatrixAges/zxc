import encoding from "std:encoding"

import { ImportKind } from "../../../../frontend/parser/imports/model"

import type { Program } from "../../../../frontend/parser/syntax/model"

export type Input = { source_text: string, syntax: Program, name: string, callable: bool }

export type Output = bool

export default function (in: Input): Output {
    return loop({ input: in, index: 0, found: false }, {
        while: current => !current.found && current.index < current.input.syntax.imports.length,
        next: current => {
            const item = current.input.syntax.imports[current.index]

            if ((item.kind == ImportKind.Function) == current.input.callable) {
                current.found = loop({ input: current.input, item: item, index: 0, found: false }, {
                    while: names => !names.found && names.index < names.item.count,
                    next: names => {
                        const span = names.input.syntax.import_names[names.item.first + names.index]
                        const name = encoding.sliceBytes(names.input.source_text, span.start, span.end)

                        names.found = name == names.input.name
                        names.index += 1
                    }
                }).found
            }

            current.index += 1
        }
    }).found
}
