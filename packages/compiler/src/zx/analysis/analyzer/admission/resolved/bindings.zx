import integers from "std:integer"

import position from "../../../../modules/binding/position"
import declared from "./declared"
import { DeclarationKind } from "./model"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    return loop({
        input: in,
        index: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < current.input.bindings.names.length,
        next: current => {
            const bindings = current.input.bindings
            const index = current.index
            const name = bindings.names[index]
            const namespace = bindings.namespaces[index]
            const id = bindings.ids[index]
            const input_type = bindings.input_types[index]
            const output_type = bindings.output_types[index]

            current.valid = declared({
                source_text: current.input.source_text,
                native: current.input.native,
                syntax: current.input.syntax,
                name: namespace ?? name,
                kind: DeclarationKind.Callable
            })

            const local = namespace ?? name
            const constants = current.input.constants

            current.valid = (
                - current.valid
                - and position({
                    names: current.input.aliases.names,
                    name: local
                }) == null
                - and (constants == null || position({
                    names: constants.names,
                    name: local
                }) == null)
            )

            if (current.valid) {
                current.valid = loop({
                    bindings,
                    limit: index,
                    name,
                    namespace: namespace ?? "",
                    index: 0,
                    valid: true
                }, {
                    while: previous =>
                        previous.valid && previous.index < previous.limit,
                    next: previous => {
                        previous.valid =
                            previous.bindings.names[previous.index] !=
                            previous.name ||
                            (
                                previous.bindings.namespaces[previous.index] ?? ""
                            ) != previous.namespace
                        previous.index += 1
                    },
                    return: state => state.valid
                })
            }

            if (current.valid) {
                if (bindings.intrinsics[index] != null) {
                    current.valid =
                        id == null && input_type == null && output_type == null
                } else {
                    const condition = (
                        - id != null
                        - and input_type != null
                        - and output_type != null
                    )

                    if (condition) {
                        const position = integers.widen(id)
                        current.valid = position < current.input.functions.files.length

                        if (current.valid) {
                            current.valid =
                                (
                                    - input_type ==
                                        current.input.functions.input_types[position]
                                    - and output_type ==
                                        current.input.functions.output_types[position]
                                    - and integers.widen(input_type) <
                                        current.input.table.kinds.length
                                    - and integers.widen(output_type) <
                                        current.input.table.kinds.length
                                )
                        }
                    } else {
                        current.valid = false
                    }
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
