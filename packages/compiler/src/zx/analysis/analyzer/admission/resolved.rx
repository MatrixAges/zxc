<Module>
    <Type from="./resolved/model" as="Model" />

    <Args in={Model.Request} out={bool} />

    <Call fn="resolved/constants" in={$in} />

    <If on={!$ctx.constants}>
        <Return value={false} />
    </If>

    <Call
        fn="../../../ir/canonical/validation/structure/functions"
        in={{
            functions: $in.functions,
            maximum_count: $in.maximum_count
        }}
    />

    <If on={!$ctx.functions}>
        <Return value={false} />
    </If>

    <Call fn="resolved/aliases" in={$in} />

    <If on={!$ctx.aliases}>
        <Return value={false} />
    </If>

    <Call fn="resolved/bindings" in={$in} />

    <If on={!$ctx.bindings}>
        <Return value={false} />
    </If>

    <Call fn="resolved/declarations" in={$in} />

    <Return value={$ctx.declarations} />
</Module>
