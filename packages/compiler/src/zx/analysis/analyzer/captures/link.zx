import integers from "zig:integers"

import type { Captures } from "../captures"

export type Input = { captures: Captures, frame: u32, source: u32, target: u32, value: u32 }

export type Output = Captures

export default function (in: Input): Output {
    const id = integers.narrow(in.captures.bindings.sources.length)
    const link: u32? = id
    const previous = in.captures.frames.last[integers.widen(in.frame)]
    const next = in.captures.bindings.next.push(null)[0]
    const frame = integers.widen(in.frame)

    return {
        ...in.captures,
        frames: {
            ...in.captures.frames,
            first: previous == null ? in.captures.frames.first.splice(frame, 1, [link])[0] : in.captures.frames.first,
            last: in.captures.frames.last.splice(frame, 1, [link])[0]
        },
        bindings: {
            sources: in.captures.bindings.sources.push(in.source)[0],
            targets: in.captures.bindings.targets.push(in.target)[0],
            values: in.captures.bindings.values.push(in.value)[0],
            next: previous != null ? next.splice(integers.widen(previous), 1, [link])[0] : next
        }
    }
}
