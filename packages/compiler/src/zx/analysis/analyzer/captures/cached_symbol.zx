import integers from "std:integer"

import lookup from "./lookup"

import type { Captures } from "../captures"

export type Input = {
    captures: Captures,
    owner?: u32,
    symbol: u32
}

export type Output = u32?

export default function (in: Input): Output {
    if (in.captures.current == in.owner) {
        return in.symbol
    }

    const path: u32[] = []

    const route = loop({
        frame: in.captures.current,
        path
    }, {
        while: state => state.frame != null &&
            (in.owner == null || state.frame != in.owner),
        next: state => {
            const frame = state.frame

            if (frame != null) {
                state.path = state.path.push(frame)[0]
                state.frame =
                    in.captures.frames.parents[integers.widen(frame)]
            }
        }
    })

    if (route.frame != in.owner) {
        return null
    }

    const symbol: u32? = in.symbol

    const loop_initial = {
        symbol,
        remaining: route.path.length
    }

    const loop_scope = {
        captures: in.captures,
        path: route.path
    }

    return loop(loop_initial, {
        while: state => state.symbol != null && state.remaining > 0,
        next: state => {
            const symbol = state.symbol

            if (symbol != null) {
                state.remaining -= 1
                state.symbol = lookup({
                    captures: loop_scope.captures,
                    frame: loop_scope.path[state.remaining],
                    source: symbol
                })
            }
        },
        return: state => state.symbol
    })
}
