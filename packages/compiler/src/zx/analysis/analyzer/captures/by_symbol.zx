import integers from "std:integer"

import ensure from "./ensure"

import type { Span } from "../../../frontend/lexer/token_model"
import type { Prepared } from "../model"

export type Input = {
    state: Prepared,
    owner?: u32,
    symbol: u32,
    span: Span
}

export type Output = {
    state: Prepared,
    symbol?: u32
}

export default function (in: Input): Output {
    if (in.state.local.captures.current == in.owner) {
        return {
            state: in.state,
            symbol: in.symbol
        }
    }

    const path: u32[] = []

    const route = loop({
        frame: in.state.local.captures.current,
        path
    }, {
        while: state =>
            state.frame != null &&
            (in.owner == null || state.frame != in.owner),
        next: state => {
            const frame = state.frame

            if (frame != null) {
                state.path = state.path.push(frame)[0]
                state.frame = in.state.local.captures.frames
                    .parents[
                        integers.widen(
                            frame
                        )
                    ]
            }
        }
    })

    if (route.frame != in.owner) {
        return {
            state: in.state,
            symbol: null
        }
    }

    const loop_initial = {
        state: in.state,
        symbol: in.symbol,
        remaining: route.path.length
    }

    const loop_scope = {
        path: route.path,
        span: in.span
    }

    return loop(loop_initial, {
        while: current => current.remaining > 0 &&
            current.state.diagnostic.message == "",
        next: current => {
            current.remaining -= 1

            const captured = ensure({
                state: current.state,
                frame: loop_scope.path[current.remaining],
                source: current.symbol,
                span: loop_scope.span
            })

            current.state = captured.state
            current.symbol = captured.symbol
        },
        return: current => ({
            state: current.state,
            symbol: current.symbol
        })
    })
}
