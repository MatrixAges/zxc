import integers from "std:integer"
import appendIteration from "core/expression_table/append/iteration"
import appendScope from "core/expression_table/append/scope"

import project from "./project"

import type { Local } from "../local"
import type { IterationFrame } from "./model"

export type Input = {
    local: Local,
    frame: IterationFrame,
    body: u32,
    projection?: {
        parameter: u32,
        body: u32
    },
    start: u64,
    end: u64
}

export type Output = {
    local: Local,
    value: u32
}

export default function (in: Input): Output {
    const metadata = {
        type_id: in.local.expressions.types[integers.widen(in.frame.initial)],
        span_start: in.start,
        span_end: in.end
    }

    const iteration = appendIteration({
        table: in.local.expressions,
        metadata,
        initial: in.frame.initial,
        condition_parameter: in.frame.condition_parameter,
        parameter: in.frame.parameter,
        environment_symbol: in.frame.readonly == null ? null : in.frame.readonly.symbol,
        condition: in.frame.condition,
        body: in.body,
        postcondition: in.frame.postcondition
    })

    const projected = match {
        in.projection == null => iteration,
        _ => project({
            table: iteration.table,
            iteration: iteration.id,
            parameter: in.projection.parameter,
            body: in.projection.body,
            start: in.start,
            end: in.end
        })
    }

    if (in.frame.readonly != null) {
        const result = appendScope({
            table: projected.table,
            metadata: {
                ...metadata,
                type_id: projected.table.types[integers.widen(projected.id)]
            },
            result: projected.id,
            symbols: [
                in.frame.readonly.initial_symbol,
                in.frame.readonly.symbol
            ],
            values: [
                in.frame.readonly.initial,
                in.frame.readonly.value
            ],
            borrows: [
                false,
                true
            ]
        })

        return {
            local: {
                ...in.local,
                expressions: result.table
            },
            value: result.id
        }
    }

    return {
        local: {
            ...in.local,
            expressions: projected.table
        },
        value: projected.id
    }
}
