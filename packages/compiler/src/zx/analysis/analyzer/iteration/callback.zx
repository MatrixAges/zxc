import integers from "std:integer"
import { Ownership } from "core/symbol_table/model"

import { ExprKind } from "../../../frontend/parser/expressions/state/model"
import bind from "../bindings/append"
import enter from "../captures/enter"
import { NameKind } from "../source/model"
import readName from "../source/name"
import { state_parameter, update_block } from "./const"

import type { Source } from "../expressions/request"
import type { Prepared } from "../model"
import type { Context } from "./model"

export type Input = {
    state: Prepared,
    source: Source,
    node: u64,
    type_id: u32,
    updating: bool
}

export type Output = {
    state: Prepared,
    context: Context,
    parameter: u32,
    body: u64
}

export default function (in: Input): Output {
    const node = in.source.tree.nodes[in.node]
    const entered = enter(in.state.local)

    const context: Context = {
        active: in.state.local.active.length,
        floor: in.state.local.scope_floor,
        depth: in.state.local.lambda_depth,
        captures: in.state.local.captures.current,
        capture_frame: entered.frame
    }

    if (node.kind != ExprKind.Lambda || node.count != 1) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: state_parameter,
                    start: node.span.start,
                    end: node.span.end
                }
            },
            context,
            parameter: 0,
            body: 0
        }
    }

    const body = in.source.tree.nodes[node.first]

    if (in.updating && body.kind != ExprKind.StateBlock) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: update_block,
                    start: body.span.start,
                    end: body.span.end
                }
            },
            context,
            parameter: 0,
            body: 0
        }
    }

    const binding = bind({
        local: entered.local,
        name: readName({
            source: in.source,
            kind: NameKind.Parameter,
            index: node.head - 1
        }),
        type_id: in.type_id,
        scope_start: context.active
    })

    const ownership = binding.local.symbols.ownership.with(
        integers.widen(binding.id),
        Ownership.Borrowed
    )

    return {
        state: {
            ...in.state,
            diagnostic: binding.diagnostic,
            local: {
                ...binding.local,
                symbols: {
                    ...binding.local.symbols,
                    ownership
                }
            }
        },
        context,
        parameter: binding.id,
        body: node.first
    }
}
