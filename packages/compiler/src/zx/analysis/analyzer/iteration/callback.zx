import integers from "std:integer"
import { Ownership } from "core/symbol_table/model"

import { ExprKind } from "../../../frontend/parser/expressions/state/model"
import bind from "../bindings/append"
import { NameKind } from "../source/model"
import readName from "../source/name"
import { context_parameters } from "./const"

import type { Source } from "../expressions/request"
import type { Local } from "../local"
import type { Prepared } from "../model"
import type { Context } from "./model"

export type Input = {
    state: Prepared,
    source: Source,
    node: u64,
    type_id: u32,
    updating: bool,
    readonly_value?: u32
}

export type Output = {
    state: Prepared,
    context: Context,
    parameter: u32,
    readonly_parameter?: u32,
    body: u64
}

export default function (in: Input): Output {
    const node = in.source.tree.nodes[in.node]

    const context: Context = {
        active: in.state.local.active.length,
        floor: in.state.local.scope_floor,
        depth: in.state.local.lambda_depth,
        captures: in.state.local.captures.current
    }

    if (
        node.kind != ExprKind.Lambda ||
            (node.count != 1 && !(in.readonly_value != null && node.count == 2))
    ) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: in.readonly_value != null ? context_parameters :
                        "loop callbacks require one inline state parameter",
                    start: node.span.start,
                    end: node.span.end
                }
            },
            context,
            parameter: 0,
            body: 0
        }
    }

    const body = in.source.tree.nodes[node.first]

    if (in.updating && body.kind != ExprKind.StateBlock) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: "loop next and do require a state update block",
                    start: body.span.start,
                    end: body.span.end
                }
            },
            context,
            parameter: 0,
            body: 0
        }
    }

    const local: Local = {
        ...in.state.local,
        scope_floor: context.active,
        lambda_depth: context.depth + 1,
        captures: {
            ...in.state.local.captures,
            current: null
        }
    }

    const name = readName({
        source: in.source,
        kind: NameKind.Parameter,
        index: node.count == 2 ?
            in.source.tree.parameters[node.head - 1].previous - 1 : node.head - 1
    })

    const binding = bind({
        local,
        name,
        type_id: in.type_id,
        scope_start: context.active
    })

    if (binding.diagnostic.message != "") {
        return {
            state: {
                ...in.state,
                diagnostic: binding.diagnostic
            },
            context,
            parameter: 0,
            body: 0
        }
    }

    const secondary = node.count == 2 && in.readonly_value != null ? bind({
        local: binding.local,
        name: readName({
            source: in.source,
            kind: NameKind.Parameter,
            index: node.head - 1
        }),
        type_id: binding.local.expressions.types[integers.widen(in.readonly_value)],
        scope_start: context.active
    }) : binding

    if (secondary.diagnostic.message != "") {
        return {
            state: {
                ...in.state,
                diagnostic: secondary.diagnostic
            },
            context,
            parameter: 0,
            body: 0
        }
    }

    const ownership = secondary.local.symbols.ownership.with(
        integers.widen(binding.id),
        Ownership.Borrowed
    )

    const borrowed = node.count == 2 ? ownership.with(
        integers.widen(secondary.id),
        Ownership.Borrowed
    ) : ownership

    return {
        state: {
            ...in.state,
            diagnostic: secondary.diagnostic,
            local: {
                ...secondary.local,
                symbols: {
                    ...secondary.local.symbols,
                    ownership: borrowed
                }
            }
        },
        context,
        parameter: binding.id,
        readonly_parameter: node.count == 2 ? secondary.id : null,
        body: node.first
    }
}
