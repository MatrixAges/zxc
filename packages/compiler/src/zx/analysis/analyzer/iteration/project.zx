import integers from "std:integer"
import scope from "core/expression_table/append/scope"

import type { Result } from "core/expression_table/append/model"
import type { Expressions } from "core/expression_table/model"

export type Input = {
    table: Expressions,
    iteration: u32,
    parameter: u32,
    body: u32,
    start: u64,
    end: u64
}

export type Output = Result

export default function (in: Input): Output {
    return scope({
        table: in.table,
        metadata: {
            type_id: in.table.types[integers.widen(in.body)],
            span_start: in.start,
            span_end: in.end
        },
        result: in.body,
        symbols: [in.parameter],
        values: [in.iteration],
        borrows: [false]
    })
}
