<Module>
    <Type from="ownership/request" as="Request" />
    <Type from="ownership/finish" as="Finish" />

    <Args in={Request.Input} out={Finish.Output} />

    <Call fn="ownership/request" in={$in} />

    <Call module="../../ownership/check" in={$ctx.request} />

    <Call
        fn="ownership/finish"
        in={{
            state: $in.state,
            outcome: $ctx.check
        }}
    />

    <Return value={$ctx.finish} />
</Module>
