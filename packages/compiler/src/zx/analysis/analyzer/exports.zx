import initial from "../semantic/resolving/initial"
import run from "../semantic/resolving/run"
import count from "../semantic/resolving/source/count"
import declaration from "../semantic/resolving/source/declaration"

import type { Diagnostic } from "../semantic/resolving/model"
import type { Types } from "./types/model"

export type State = { types: Types, diagnostic: Diagnostic }

export type Input = { state: State }

export type Output = { state: State, names: string[], types: u32[] }

export default function (in: Input): Output {
    const names: string[] = []
    const types: u32[] = []

    const result = loop({ state: in.state, count: count(in.state.types.context.source), names: names, types: types, index: 0 }, {
        while: current => current.index < current.count && current.state.diagnostic.message == "",
        next: current => {
            const name = declaration({ source: current.state.types.context.source, index: current.index }).name
            const prepared = initial({ context: current.state.types.context, delta: current.state.types.delta, cache: current.state.types.cache, initialize: false, named: true, name: name, reference: { enumeration: false, index: 0 } })
            const resolved = run(prepared)

            current.state.types.delta = resolved.delta
            current.state.types.cache = resolved.cache
            current.state.diagnostic = resolved.diagnostic

            if (resolved.diagnostic.message == "") {
                current.names = current.names.push(name.text)[0]
                current.types = current.types.push(resolved.result)[0]
            }

            current.index += 1
        }
    })

    return { state: result.state, names: result.names, types: result.types }
}
