import integers from "std:integer"
import project from "core/expression_table/append/projection"

import type { Span } from "../../../../frontend/lexer/token_model"
import type { Prepared } from "../../model"
import type { Bindings } from "../model"

export type Input = {
    state: Prepared,
    context: u32,
    targets: u32[],
    bindings: Bindings,
    span: Span
}

export type Output = {
    state: Prepared,
    bindings: Bindings
}

export default function (in: Input): Output {
    return loop({
        ...in,
        index: 0
    }, {
        while: active => active.index < active.targets.length,
        next: active => {
            const target = active.targets[active.index]
            const value = project({
                table: active.state.local.expressions,
                metadata: {
                    type_id:
                        active.state.local.symbols.types[integers.widen(
                            target
                        )],
                    span_start: active.span.start,
                    span_end: active.span.end
                },
                target: active.context,
                index: integers.narrow(active.index),
                tuple: true
            })

            active.state.local.expressions = value.table
            active.bindings.symbols = active.bindings.symbols.push(target)[0]
            active.bindings.values = active.bindings.values.push(value.id)[0]
            active.bindings.borrows = active.bindings.borrows.push(true)[0]
            active.index += 1
        },
        return: state => ({
            state: state.state,
            bindings: state.bindings
        })
    })
}
