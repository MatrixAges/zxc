import integers from "std:integer"
import { type_id_u8, type_id_f64 } from "core/const"
import { TransformKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import gather from "../../captures/gather"
import leave from "../../captures/leave"
import construct from "../../types/construct"
import { comparison_type_error } from "../sorting/const"

import type { Span } from "../../../../frontend/lexer/token_model"
import type { Prepared } from "../../model"
import type { Callback } from "../model"

export type Input = {
    state: Prepared,
    frame: u32,
    parameters: u32[],
    body: u32,
    kind: TransformKind,
    result_type: u32,
    span: Span
}

export type Output = {
    state: Prepared,
    callback: Callback,
    result_type: u32
}

export default function (in: Input): Output {
    const captures = gather({
        captures: in.state.local.captures,
        frame: in.frame
    })

    const state = {
        ...in.state,
        local: leave({
            local: in.state.local,
            frame: in.frame
        })
    }

    const body_type = state.local.expressions.types[integers.widen(in.body)]

    const valid_body_type = body_type < type_id_u8 || body_type > type_id_f64

    const invalid = (
        - in.kind == TransformKind.Sort
        - and (valid_body_type)
    )

    if (invalid) {
        return {
            state: {
                ...state,
                diagnostic: {
                    code: "type_mismatch",
                    message: comparison_type_error,
                    start: in.span.start,
                    end: in.span.end
                }
            },
            callback: {
                parameters: in.parameters,
                captures,
                body: in.body
            },
            result_type: in.result_type
        }
    }

    const result = match {
        in.kind == TransformKind.Map => construct({
            state,
            candidate: {
                kind: Kind.List,
                first: state.local.expressions.types[integers.widen(in.body)],
                second: 0,
                label: "",
                children: [],
                fields: {
                    names: [],
                    types: []
                },
                names: []
            },
            span: in.span
        }),
        _ => {
            state,
            id: in.result_type
        }
    }

    return {
        state: result.state,
        callback: {
            parameters: in.parameters,
            captures,
            body: in.body
        },
        result_type: result.id
    }
}
