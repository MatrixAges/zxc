import integers from "std:integer"
import project from "core/expression_table/append/projection"
import scope from "core/expression_table/append/scope"

import type { Span } from "../../../../frontend/lexer/token_model"
import type { Result } from "../../expressions/model"
import type { Prepared } from "../../model"
import type { Captures } from "../model"

export type Input = {
    state: Prepared,
    context: u32,
    body: u32,
    captures: Captures,
    indices?: u32[],
    direct?: bool,
    span: Span
}

export type Output = Result

export default function (in: Input): Output {
    if (in.captures.targets.length == 0) {
        return {
            state: in.state,
            value: in.body
        }
    }

    const values: u32[] = []
    const symbols: u32?[] = []
    const borrows: bool[] = []

    const bound_initial = {
        expressions: in.state.local.expressions,
        values,
        symbols,
        borrows,
        index: 0
    }

    const bound_scope = {
        captures: in.captures,
        indices: in.indices,
        direct: in.direct,
        types: in.state.local.symbols.types,
        context: in.context,
        span: in.span
    }

    const bound = loop(bound_initial, {
        while: current => current.index < bound_scope.captures.targets.length,
        next: current => {
            const target = bound_scope.captures.targets[current.index]
            const projected = match {
                bound_scope.direct ?? false => {
                    table: current.expressions,
                    id: bound_scope.context
                },
                _ => project({
                    table: current.expressions,
                    metadata: {
                        type_id: bound_scope.types[integers.widen(target)],
                        span_start: bound_scope.span.start,
                        span_end: bound_scope.span.end
                    },
                    target: bound_scope.context,
                    index: match {
                        bound_scope.indices == null => integers.narrow(current.index),
                        _ => bound_scope.indices[current.index]
                    },
                    tuple: true
                })
            }


            current.expressions = projected.table
            current.values = current.values.push(projected.id)[0]
            current.symbols = current.symbols.push(target)[0]
            current.borrows = current.borrows.push(true)[0]
            current.index += 1
        }
    })

    const result = scope({
        table: bound.expressions,
        metadata: {
            type_id: in.state.local.expressions.types[integers.widen(in.body)],
            span_start: in.span.start,
            span_end: in.span.end
        },
        result: in.body,
        symbols: bound.symbols,
        values: bound.values,
        borrows: bound.borrows
    })

    return {
        state: {
            ...in.state,
            local: {
                ...in.state.local,
                expressions: result.table
            }
        },
        value: result.id
    }
}
