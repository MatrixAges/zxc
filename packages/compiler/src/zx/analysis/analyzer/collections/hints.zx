import integers from "std:integer"
import { type_id_bool, type_id_u64 } from "core/const"
import { TransformKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import row from "../../semantic/types/row"
import payload from "../types/payload"

import type { Prepared } from "../model"

export type Input = {
    state: Prepared,
    kind: TransformKind,
    target: u32,
    second?: u32,
    expected?: u32
}

export type Output = {
    parameters: u32[],
    body?: u32,
    result: u32
}

export default function (in: Input): Output {
    const source = in.state.local.expressions.types[integers.widen(in.target)]

    const tables = {
        base: in.state.types.context.base,
        delta: in.state.types.delta
    }

    const element = row({
        tables,
        id: source
    }).first

    const second = in.second

    const accumulator =
        match {
            in.kind == TransformKind.Reduce &&
                second != null => in.state.local.expressions
                .types[integers.widen(
                    second
                )],
            _ => element
        }

    const hint = payload({
        types: in.state.types,
        expected: in.expected
    })

    const target = row({
        tables,
        id: hint ?? 0
    })

    const body: u32? = match {
        in.kind == TransformKind.Sort => null,
        in.kind == TransformKind.Filter || in.kind == TransformKind.Every ||
            in.kind == TransformKind.Some => type_id_bool,
        in.kind == TransformKind.Reduce => accumulator,
        hint != null && target.kind == Kind.List => target.first,
        _ => null
    }

    const parameters: u32[] = match in.kind {
        TransformKind.Sort => [
            element,
            element
        ],
        TransformKind.Reduce => [
            accumulator,
            element,
            type_id_u64,
            source
        ],
        _ => [
            element,
            type_id_u64,
            source
        ]
    }

    return {
        parameters,
        body,
        result: match in.kind {
            TransformKind.Filter => source,
            TransformKind.Sort => source,
            TransformKind.Reduce => accumulator,
            _ => type_id_bool,
        }
    }
}
