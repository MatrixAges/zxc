import integers from "std:integer"
import append from "core/expression_table/append/object"
import { Kind } from "core/type_table/model"

import row from "../../../semantic/types/row"
import construct from "../../types/construct"

import type { Span } from "../../../../frontend/lexer/token_model"
import type { Result } from "../../expressions/model"
import type { Entries } from "../../expressions/objects/model"
import type { Prepared } from "../../model"

export type Input = { state: Prepared, fields: Entries, span: Span }

export type Output = Result

export default function (in: Input): Output {
    const ids: u32[] = []

    const types = loop({ values: in.fields.values, types: in.state.local.expressions.types, fields: ids, index: 0 }, {
        while: current => current.index < current.values.length,
        next: current => {
            current.fields = current.fields.push(current.types[integers.widen(current.values[current.index])])[0]
            current.index += 1
        }
    }).fields

    const constructed = construct({ state: in.state, candidate: { kind: Kind.Object, first: 0, second: 0, label: "", children: [], fields: { names: in.fields.names, types: types }, names: [] }, span: in.span })

    if (constructed.state.diagnostic.message != "") {
        return { state: constructed.state, value: 0 }
    }

    const tables = { base: constructed.state.types.context.base, delta: constructed.state.types.delta }
    const target = row({ tables: tables, id: constructed.id })
    const table = target.delta ? tables.delta : tables.base

    const ordered = loop({ names: table.field_names, first: integers.widen(target.first), count: integers.widen(target.second), fields: in.fields, indices: ids, values: ids, index: 0 }, {
        while: current => current.index < current.count,
        next: current => {
            const found = loop({ names: current.fields.names, name: current.names[current.first + current.index], index: 0 }, {
                while: item => item.index < item.names.length && item.names[item.index] != item.name,
                next: item => { item.index += 1 }
            })

            current.indices = current.indices.push(integers.narrow(current.index))[0]
            current.values = current.values.push(current.fields.values[found.index])[0]
            current.index += 1
        }
    })

    const result = append({ table: constructed.state.local.expressions, metadata: { type_id: constructed.id, span_start: in.span.start, span_end: in.span.end }, indices: ordered.indices, values: ordered.values, evaluation: in.fields.values })

    return { state: { ...constructed.state, local: { ...constructed.state.local, expressions: result.table } }, value: result.id }
}
