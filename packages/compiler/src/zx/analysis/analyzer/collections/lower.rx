<Module>
    <Type from="model" as="Model" />
    <Type from="building/integer" as="Integer" />
    <Type from="core/expression_table/kinds" as="Expression" />

    <Args in={Model.Options} out={Integer.Output} />

    <If on={$in.kind == Expression.TransformKind.Sort}>
        <Call module="sorting" in={$in} />

        <Return value={$ctx.sorting} />
    </If>

    <Call fn="lowering/source" in={$in} />

    <Call
        fn="lowering/initial_result"
        in={{
            state: $ctx.source.state,
            span: $in.span,
            kind: $in.kind,
            source: $ctx.source.source,
            initial: $in.initial,
            result_type: $in.result_type
        }}
    />

    <Call
        fn="lowering/initial_state"
        in={{
            state: $ctx.initial_result.state,
            span: $in.span,
            kind: $in.kind,
            source: $ctx.source.source,
            result: $ctx.initial_result.value,
            initial: $in.initial,
            captures: $in.callback.captures.values
        }}
    />

    <If on={$ctx.initial_state.state.diagnostic.message == ""}>
        <Call
            fn="lowering/parameters"
            in={{
                state: $ctx.initial_state.state,
                initial: $ctx.initial_state.value,
                span: $in.span
            }}
        />

        <Call
            fn="lowering/condition"
            in={{
                state: $ctx.parameters.state,
                span: $in.span,
                kind: $in.kind,
                parameter: $ctx.parameters.condition_parameter
            }}
        />

        <Call
            module="step"
            in={{
                state: $ctx.condition.state,
                kind: $in.kind,
                parameter: $ctx.parameters.parameter,
                callback: $in.callback,
                span: $in.span
            }}
        />

        <If on={$ctx.step.state.diagnostic.message == ""}>
            <Call
                fn="lowering/finish"
                in={{
                    state: $ctx.step.state,
                    tuple: $in.tuple_result ? {
                        kind: $in.kind,
                        projection: $in.projection,
                        source: $ctx.source.source
                    } : null,
                    initial: $ctx.initial_state.value,
                    condition_parameter: $ctx.parameters.condition_parameter,
                    parameter: $ctx.parameters.parameter,
                    condition: $ctx.condition.value,
                    body: $ctx.step.value,
                    bindings: $ctx.source.bindings,
                    result_type: $in.result_type,
                    span: $in.span
                }}
            />

            <Return value={$ctx.finish} />

            <Else>
                <Return value={$ctx.step} />
            </Else>
        </If>

        <Else>
            <Return value={$ctx.initial_state} />
        </Else>
    </If>
</Module>
