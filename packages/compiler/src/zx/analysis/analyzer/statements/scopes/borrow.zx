import { ExpressionKind } from "core/expression_table/kinds"

export type Input = ExpressionKind

export type Output = bool

export default function (in: Input): Output {
    return in == ExpressionKind.Reference || in == ExpressionKind.Field || in == ExpressionKind.TupleField || in == ExpressionKind.Index || in == ExpressionKind.OptionalValue
}
