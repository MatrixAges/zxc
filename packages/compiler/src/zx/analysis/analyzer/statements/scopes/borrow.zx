import { ExpressionKind } from "core/expression_table/kinds"

export type Input = ExpressionKind

export type Output = bool

export default function (in: Input): Output {
    return (
        - in == ExpressionKind.Reference
        - or in == ExpressionKind.Field
        - or in == ExpressionKind.TupleField
        - or in == ExpressionKind.Index
        - or in == ExpressionKind.OptionalValue
    )
}
