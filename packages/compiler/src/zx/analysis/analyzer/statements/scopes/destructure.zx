import integers from "std:integer"
import project from "core/expression_table/append/projection"
import { ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import refine from "../../../../ir/canonical/refinement/bind"
import row from "../../../semantic/types/row"
import { NameKind } from "../../source/model"
import readName from "../../source/name"
import flat from "../pattern/flat"
import pad from "../pattern/pad"
import pattern from "../pattern/scopes"
import bind from "./bind"
import bindingName from "./binding_name"
import temporary from "./temporary"

import type { Source } from "../../expressions/request"
import type { Prepared } from "../../model"
import type { Scopes } from "./model"

export type Input = {
    state: Prepared,
    scopes: Scopes,
    source: Source,
    statement: u64,
    value: u32
}

export type Output = {
    state: Prepared,
    scopes: Scopes
}

export default function (in: Input): Output {
    const statement = in.source.blocks.statements[in.statement]

    const tables = {
        base: in.state.types.context.base,
        delta: in.state.types.delta
    }

    const target = row({
        tables,
        id: in.state.local.expressions.types[integers.widen(in.value)]
    })

    if (statement.second != 0) {
        const simple = flat({
            source: in.source,
            root: statement.second - 1
        })

        const captured =
            in.state.local.expressions.kinds[integers.widen(in.value)] ==
            ExpressionKind.Capture

        const complete =
            simple && target.kind == Kind.Tuple &&
            statement.count <= integers.widen(target.second)

        if (captured && !simple) {
            return {
                state: {
                    ...in.state,
                    diagnostic: {
                        code: "type_mismatch",
                        message:
                            "try destructuring requires a flat complete tuple binding",
                        start: statement.span.start,
                        end: statement.span.end
                    }
                },
                scopes: in.scopes
            }
        }

        if (!captured && !complete) {
            return pattern(in)
        }
    }

    const captured =
        in.state.local.expressions.kinds[integers.widen(in.value)] ==
        ExpressionKind.Capture

    const strict = captured || statement.second == 0
    const wrong_count = strict && integers.widen(target.second) != statement.count

    if (target.kind != Kind.Tuple || wrong_count) {
        return {
            state: {
                ...in.state,
                diagnostic: {
                    code: "type_mismatch",
                    message: "tuple destructuring must match every result slot",
                    start: statement.span.start,
                    end: statement.span.end
                }
            },
            scopes: in.scopes
        }
    }

    const table = target.delta ? tables.delta : tables.base
    const ids: u64[] = []

    const order = loop({
        names: in.source.blocks.names,
        head: statement.head,
        ids
    }, {
        while: current => current.head != 0,
        next: current => {
            current.ids = current.ids.push(current.head - 1)[0]
            current.head = current.names[current.head -
                1].previous
        },
        return: state => state.ids.reverse()[0]
    })

    const saved = temporary({
        scopes: in.scopes,
        local: in.state.local,
        value: in.value
    })

    const initial_symbols: u32?[] = []
    const start = in.scopes.frames[in.scopes.frames.length - 1].active_mark

    const result = loop({
        state: {
            ...in.state,
            local: saved.local,
            diagnostic: saved.diagnostic
        },
        scopes: saved.scopes,
        source: in.source,
        types: table.children,
        first: integers.widen(target.first),
        order,
        symbols: initial_symbols,
        saved: saved.value,
        start,
        index: 0
    }, {
        while: current =>
            current.index < current.order.length &&
            current.state.diagnostic.message == "",
        next: current => {
            const name = readName({
                source: current.source,
                kind: NameKind.Destructure,
                index: current.order[current.index]
            })

            if (name.text == "_") {
                current.symbols = current.symbols.push(null)[0]
            } else {
                current.state.diagnostic = bindingName({
                    scopes: current.scopes,
                    local: current.state.local,
                    name
                })

                if (current.state.diagnostic.message == "") {
                    const item = project({
                        table: current.state.local.expressions,
                        metadata: {
                            type_id:
                                current.types[current.first + current.index],
                            span_start: name.start,
                            span_end: name.end
                        },
                        target: current.saved,
                        index: integers.narrow(current.index),
                        tuple: true
                    })
                    const bound = bind({
                        scopes: current.scopes,
                        local: {
                            ...current.state.local,
                            expressions: item.table
                        },
                        name,
                        value: item.id,
                        scope_start: current.start
                    })

                    current.scopes = bound.scopes
                    current.state.local = bound.local
                    current.state.diagnostic = bound.diagnostic
                    current.symbols = current.symbols.push(bound.symbol)[0]
                }
            }

            current.index += 1
        }
    })

    if (result.state.diagnostic.message != "") {
        return {
            state: result.state,
            scopes: result.scopes
        }
    }

    const symbols = pad({
        values: result.symbols,
        count: integers.widen(target.second)
    })

    const err = symbols.length == 2 ? symbols[0] : null
    const value = symbols.length == 2 ? symbols[1] : null

    const facts = match {
        result.state.diagnostic.message == "" => refine({
            facts: result.state.local.refinement.facts,
            expressions: result.state.local.expressions,
            value: integers.widen(in.value),
            count: symbols.length,
            err,
            result: value
        }),
        _ => result.state.local.refinement.facts
    }

    return {
        state: {
            ...result.state,
            local: {
                ...result.state.local,
                refinement: {
                    ...result.state.local.refinement,
                    facts: facts
                }
            }
        },
        scopes: result.scopes
    }
}
