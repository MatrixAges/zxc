import integers from "std:integer"
import { scalar_bool } from "core/type_table/const"

import bindPredicate from "../../../../ir/canonical/refinement/bind"
import append from "../../bindings/append"
import borrow from "./borrow"

import type { Diagnostic } from "../../../semantic/resolving/model"
import type { Name } from "../../../semantic/resolving/source/model"
import type { Local } from "../../local"
import type { Scopes } from "./model"

export type Input = {
    scopes: Scopes,
    local: Local,
    name: Name,
    value: u32,
    scope_start: u64
}

export type Output = {
    scopes: Scopes,
    local: Local,
    symbol: u32,
    diagnostic: Diagnostic
}

export default function (in: Input): Output {
    const type_id = in.local.expressions.types[integers.widen(in.value)]

    if (type_id == 0) {
        return {
            scopes: in.scopes,
            local: in.local,
            symbol: 0,
            diagnostic: {
                code: "type_mismatch",
                message: "void results cannot be bound to a value",
                start: in.name.start,
                end: in.name.end
            }
        }
    }

    const result = append({
        local: in.local,
        name: in.name,
        type_id,
        scope_start: in.scope_start
    })

    if (result.diagnostic.message != "") {
        return {
            scopes: in.scopes,
            local: result.local,
            symbol: result.id,
            diagnostic: result.diagnostic
        }
    }

    const local = match {
        type_id == scalar_bool => {
            ...result.local,
            refinement: {
                ...result.local.refinement,
                facts: bindPredicate({
                    facts: result.local.refinement.facts,
                    expressions: result.local.expressions,
                    value: integers.widen(in.value),
                    count: 1,
                    err: result.id,
                    result: null
                })
            }
        },
        _ => result.local
    }

    const bindings = {
        symbols: in.scopes.bindings.symbols.push(result.id)[0],
        values: in.scopes.bindings.values.push(in.value)[0],
        borrows:
            in.scopes.bindings.borrows.push(
                borrow(
                    in.local.expressions.kinds[integers.widen(
                        in.value
                    )]
                )
            )[0]
    }

    return {
        scopes: {
            ...in.scopes,
            bindings: bindings
        },
        local,
        symbol: result.id,
        diagnostic: result.diagnostic
    }
}
