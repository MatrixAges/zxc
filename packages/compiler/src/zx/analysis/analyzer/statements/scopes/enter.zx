import mark from "../../../../ir/canonical/refinement/facts/mark"
import order from "../blocks/order"

import type { BlockTree } from "../../../../frontend/parser/body/model"
import type { Local } from "../../local"
import type { Scopes, Frame } from "./model"

export type Input = { scopes: Scopes, local: Local, tree: BlockTree, block: u64, state_symbol: u32 }

export type Output = Scopes

export default function (in: Input): Output {
    const source = in.tree.blocks[in.block]

    const frame: Frame = {
        source_block: in.block,
        state_symbol: in.state_symbol,
        statements: order({ items: in.tree.items, head: source.head, count: source.count }),
        next: 0,
        binding_mark: in.scopes.bindings.values.length,
        active_mark: in.local.active.length,
        facts_mark: mark(in.local.refinement.facts)
    }

    return { ...in.scopes, frames: in.scopes.frames.push(frame)[0] }
}
