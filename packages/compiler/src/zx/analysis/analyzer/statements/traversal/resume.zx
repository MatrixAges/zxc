import binding from "./binding"
import branch from "./branch"
import { Action } from "./model"
import selection from "./selection/resume"

import type { Body } from "./model"

export type Input = Body

export type Output = Body

export default function (in: Input): Output {
    const action = in.actions[in.actions.length - 1]

    const body = {
        ...in,
        actions: in.actions.pop()[0]
    }

    const condition = (
        - action == Action.Condition
        - or action == Action.Yes
        - or action == Action.No
    )

    if (condition) {
        return branch({
            body,
            action
        })
    }

    const condition_2 = (
        - action == Action.Subject
        - or action == Action.Label
        - or action == Action.Case
    )

    if (condition_2) {
        return selection({
            body,
            action
        })
    }

    return binding({
        body,
        action
    })
}
