import integers from "zig:integers"
import { StatementKind } from "core/control_table/model"

import selectionReturns from "../../../../ir/canonical/control/selection_returns"

import type { Control } from "core/control_table/model"

export type Input = { table: Control, first: u64, returns: bool[] }

export type Output = bool

export default function (in: Input): Output {
    if (in.table.statement_kinds.length == in.first) {
        return false
    }

    const index = in.table.statement_kinds.length - 1
    const payload = in.table.statement_payloads[index]

    return match in.table.statement_kinds[index] {
        StatementKind.Result => true,
        StatementKind.Branch => in.returns[integers.widen(in.table.branch_yes[integers.widen(payload)])] && in.returns[integers.widen(in.table.branch_no[integers.widen(payload)])],
        StatementKind.Switch => selectionReturns({ control: in.table, selection: integers.widen(payload), returns: in.returns }),
        _ => false,
    }
}
