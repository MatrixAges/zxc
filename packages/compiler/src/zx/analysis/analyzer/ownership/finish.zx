import type { Ownership } from "core/symbol_table/model"
import type { Output as Result } from "../../../ownership/result"
import type { Prepared } from "../model"

export type Input = {
    state: Prepared,
    outcome: Result
}

export type Output = {
    state: Prepared,
    ownership: Ownership
}

export default function (in: Input): Output {
    const state = match {
        in.outcome.message == "" => in.state,
        _ => {
            ...in.state,
            diagnostic: {
                code: in.outcome.code,
                message: in.outcome.message,
                start: in.outcome.start,
                end: in.outcome.end
            }
        }
    }

    return {
        state,
        ownership: in.outcome.ownership
    }
}
