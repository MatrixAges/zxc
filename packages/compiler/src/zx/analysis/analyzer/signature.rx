<Module>
    <Type from="./signature/initial" as="Initial" />
    <Type from="./signature/model" as="Model" />

    <Args in={Initial.Input} out={Model.Signature} />

    <Call fn="signature/initial" in={$in} />

    <If on={$in.syntax.body != null}>
        <Task name="input" out={$ctx.resolve}>
            <Call
                fn="signature/request"
                in={{
                    types: $in.types,
                    span: $ctx.initial.span,
                    name: "Input"
                }}
            />

            <Call module="../semantic/resolve" in={$ctx.request} />
        </Task>

        <If on={$ctx.task.input.diagnostic.message == ""}>
            <Task name="output" out={$ctx.resolve}>
                <Call
                    fn="signature/request"
                    in={{
                        types: {
                            context: $in.types.context,
                            delta: $ctx.task.input.delta,
                            cache: $ctx.task.input.cache,
                            nominal_delta: $in.types.nominal_delta
                        },
                        span: $ctx.initial.span,
                        name: "Output"
                    }}
                />

                <Call module="../semantic/resolve" in={$ctx.request} />
            </Task>

            <Return
                value={{
                    types: {
                        context: $in.types.context,
                        delta: $ctx.task.output.delta,
                        cache: $ctx.task.output.cache,
                        nominal_delta: $in.types.nominal_delta
                    },
                    span: $ctx.initial.span,
                    input_type: $ctx.task.input.id,
                    output_type: $ctx.task.output.id,
                    diagnostic: $ctx.task.output.diagnostic
                }}
            />

            <Else>
                <Return
                    value={{
                        types: {
                            context: $in.types.context,
                            delta: $ctx.task.input.delta,
                            cache: $ctx.task.input.cache,
                            nominal_delta: $in.types.nominal_delta
                        },
                        span: $ctx.initial.span,
                        input_type: $ctx.initial.input_type,
                        output_type: $ctx.initial.output_type,
                        diagnostic: $ctx.task.input.diagnostic
                    }}
                />
            </Else>
        </If>

        <Else>
            <Return value={$ctx.initial} />
        </Else>
    </If>
</Module>
