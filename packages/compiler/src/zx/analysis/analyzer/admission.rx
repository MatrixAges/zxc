<Module>
    <Call fn="admission/mode" in={$in.context.mode} />

    <Switch on={!$ctx.mode.validate}>
        <Case value={true}>
            <Return value={{ code: "", message: "", start: 0, end: 0 }} />
        </Case>
    </Switch>

    <Switch on={$ctx.mode.standalone && $in.syntax.imports.length > 0}>
        <Case value={true}>
            <Return value={{ code: "module", message: "modules with imports require the project analysis entry point", start: $in.syntax.imports[0].span.start, end: $in.syntax.imports[0].span.end }} />
        </Case>
    </Switch>

    <Switch on={$in.context.type_base.kinds.length > 0}>
        <Case value={true}>
            <Call module="../semantic/validate_types" in={{ table: $in.context.type_base, scalar_count: $in.context.scalar_count, maximum_count: $in.context.maximum_count }} />

            <Switch on={!$ctx.validate_types}>
                <Case value={true}>
                    <Return value={{ code: "contract", message: "invalid shared type table", start: 0, end: 0 }} />
                </Case>
            </Switch>
        </Case>
    </Switch>

    <Call module="../../ir/canonical/native_modules_check" in={{ table: $in.context.type_base, modules: $in.context.native_modules }} />

    <Switch on={!$ctx.native_modules_check}>
        <Case value={true}>
            <Return value={{ code: "contract", message: "invalid shared native module table", start: 0, end: 0 }} />
        </Case>
    </Switch>

    <Switch on={$ctx.mode.resolved}>
        <Case value={true}>
            <Call module="admission/resolved" in={{ source_text: $in.source_text, native: $in.native, syntax: $in.syntax, table: $in.context.type_base, aliases: $in.context.aliases, bindings: $in.context.function_imports, functions: $in.context.complete_functions, maximum_count: $in.context.maximum_count }} />

            <Switch on={!$ctx.resolved}>
                <Case value={true}>
                    <Return value={{ code: "contract", message: "resolved imports do not match the source declarations and function signatures", start: 0, end: 0 }} />
                </Case>
            </Switch>
        </Case>
    </Switch>

    <Call module="../semantic/origins" in={{ table: $in.context.type_base, origins: $in.context.nominal_base, names: $in.context.nominal_names }} />

    <Switch on={!$ctx.origins}>
        <Case value={true}>
            <Return value={{ code: "contract", message: "invalid shared nominal type table", start: 0, end: 0 }} />
        </Case>
    </Switch>

    <Return value={{ code: "", message: "", start: 0, end: 0 }} />
</Module>
