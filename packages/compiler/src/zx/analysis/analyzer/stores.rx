<Module>
    <Type from="./context" as="Context" />
    <Type from="./signature/model" as="Model" />
    <Type from="./stores/authorize" as="Authorize" />

    <Args
        in={{
            context: Context.Context,
            has_store: bool,
            signature: Model.Signature
        }}
        out={Authorize.Output}
    />

    <Call
        fn="stores/resolve"
        in={{
            context: $in.context,
            signature: $in.signature
        }}
    />

    <If on={$ctx.resolve.diagnostic.message == ""}>
        <Call
            fn="stores/authorize"
            in={{
                stores: $ctx.resolve.stores,
                has_store: $in.has_store,
                span: $in.signature.span
            }}
        />

        <Return value={$ctx.authorize} />

        <Else>
            <Return
                value={{
                    stores: $ctx.resolve.stores,
                    allow_store: false,
                    diagnostic: $ctx.resolve.diagnostic
                }}
            />
        </Else>
    </If>
</Module>
