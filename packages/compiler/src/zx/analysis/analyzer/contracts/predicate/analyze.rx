<Module>
    <Type from="model" as="Model" />

    <Args in={Model.PredicateInput} out={Model.PredicateOutput} />

    <Call fn="initial" in={$in} />

    <Call
        module="bind"
        in={{
            state: $ctx.initial,
            contract: $in.contract,
            output_type: $in.output_type
        }}
    />

    <If on={$ctx.bind.diagnostic.message == ""}>
        <Call
            fn="expression"
            in={{
                state: $ctx.bind,
                source: $in.source,
                node: $in.contract.predicate
            }}
        />

        <Call fn="../../expressions/traversal/advance" in={$ctx.expression} />
        <Call fn="check" in={$ctx.advance} />

        <Return value={$ctx.check} />

        <Else>
            <Call fn="failed" in={$ctx.bind} />

            <Return value={$ctx.failed} />
        </Else>
    </If>
</Module>
