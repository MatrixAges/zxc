<Module>
    <Type from="../../../../frontend/parser/header/model" as="Model" />
    <Type from="failed" as="Failed" />

    <Args
        in={{
            contract: Model.Contract,
            output_type: u32,
            state: Failed.Input
        }}
        out={Failed.Input}
    />

    <Task name="input" out={$ctx.append}>
        <Call
            fn="../../bindings/append"
            in={{
                local: $in.state.local,
                name: {
                    text: "in",
                    start: $in.contract.span.start,
                    end: $in.contract.span.end
                },
                type_id: $in.state.input_type,
                scope_start: 0
            }}
        />
    </Task>

    <If on={$ctx.task.input.diagnostic.message == "" && $in.contract.ensures}>
        <Task
            name="output"
            out={{
                ...$in.state,
                local: $ctx.append.local,
                diagnostic: $ctx.append.diagnostic
            }}
        >
            <Call
                fn="../../bindings/append"
                in={{
                    local: $ctx.task.input.local,
                    name: {
                        text: "out",
                        start: $in.contract.span.start,
                        end: $in.contract.span.end
                    },
                    type_id: $in.output_type,
                    scope_start: 0
                }}
            />
        </Task>

        <Return value={$ctx.task.output} />

        <Else>
            <Return
                value={{
                    ...$in.state,
                    local: $ctx.task.input.local,
                    diagnostic: $ctx.task.input.diagnostic
                }}
            />
        </Else>
    </If>
</Module>
