import { ExpressionKind } from "core/expression_table/kinds"

import type { Work } from "../../expressions/traversal/model"
import type { PredicateOutput } from "./model"

export type Input = Work

export type Output = PredicateOutput

export default function (in: Input): Output {
    const checked = loop({
        expressions: in.state.local.expressions,
        index: 0,
        diagnostic: in.state.diagnostic
    }, {
        while: current =>
            current.index < current.expressions.kinds.length &&
            current.diagnostic.message == "",
        next: current => {
            const kind = current.expressions.kinds[current.index]
            const forbidden =
                (
                    - kind == ExpressionKind.Call
                    - or kind == ExpressionKind.StoreGet
                    - or kind == ExpressionKind.ListOperation
                    - or kind == ExpressionKind.Transform
                    - or kind == ExpressionKind.Scope
                    - or kind == ExpressionKind.Iteration
                    - or kind == ExpressionKind.ListUpdate
                    - or kind == ExpressionKind.Capture
                    - or kind == ExpressionKind.OptionalValue
                    - or kind == ExpressionKind.Task
                    - or kind == ExpressionKind.AwaitTask
                    - or kind == ExpressionKind.CancelTask
                    - or kind == ExpressionKind.Parallel
                )

            if (forbidden) {
                current.diagnostic = {
                    code: "contract",
                    message:
                        "contracts cannot call functions, transform collections, capture errors, run tasks, unwrap optionals or access injected capabilities",
                    start: current.expressions.span_start[current.index],
                    end: current.expressions.span_end[current.index]
                }
            }

            current.index += 1
        }
    })

    return {
        types: in.state.types,
        symbols: in.state.local.symbols,
        expressions: in.state.local.expressions,
        predicate: in.value,
        diagnostic: checked.diagnostic
    }
}
