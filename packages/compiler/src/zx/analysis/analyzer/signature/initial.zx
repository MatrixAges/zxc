import type { Program } from "../../../frontend/parser/syntax/model"
import type { Types } from "../types/model"
import type { Signature } from "./model"

export type Input = { syntax: Program, types: Types }

export type Output = Signature

export default function (in: Input): Output {
    const body = in.syntax.body

    return {
        types: in.types,
        span: body != null ? in.syntax.blocks.blocks[body].span : { start: 0, end: 0 },
        input_type: 0,
        output_type: 0,
        diagnostic: { code: "", message: "", start: 0, end: 0 }
    }
}
