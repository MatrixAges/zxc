<Module>
    <Type from="./model" as="Model" />

    <Args
        in={{
            analysis: Model.Analysis
        }}
        out={Model.Analysis}
    />

    <If
        on={$in.analysis.program && !$in.analysis.linking &&
            $in.analysis.state.diagnostic.message == ""}
    >
        <Call fn="ownership/request" in={$in.analysis} />

        <Call module="../../ownership/check" in={$ctx.request} />

        <Call
            fn="../analyzer/ownership/finish"
            in={{
                state: $in.analysis.state,
                outcome: $ctx.check
            }}
        />

        <Return
            value={{
                ...$in.analysis,
                state: $ctx.finish.state,
                ownership: $ctx.finish.ownership
            }}
        />

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
