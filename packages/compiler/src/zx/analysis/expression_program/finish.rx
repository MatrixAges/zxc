<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Analysis} out={Model.Analysis} />

    <If on={$in.program && $in.state.diagnostic.message == ""}>
        <Call fn="finish" in={$in} />

        <Return value={$ctx.finish} />

        <Else>
            <Return value={$in} />
        </Else>
    </If>
</Module>
