<Module>
    <Type from="./evaluate/request" as="Request" />
    <Type from="./model" as="Model" />

    <Args in={Request.Input} out={Model.Analysis} />

    <If on={$in.analysis.state.diagnostic.message == ""}>
        <Call fn="evaluate/request" in={$in} />
        <Call fn="../analyzer/expressions/traversal/initial" in={$ctx.request} />
        <Call fn="../analyzer/expressions/traversal/advance" in={$ctx.initial} />

        <Return
            value={{
                ...$in.analysis,
                state: $ctx.advance.state,
                value: $ctx.advance.value
            }}
        />

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
