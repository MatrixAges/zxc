<Module>
    <Type from="evaluate/request" as="Request" />
    <Type from="model" as="Model" />

    <Args in={Request.Input} out={Model.Analysis} />

    <If
        on={$in.analysis.program && $in.analysis.state.diagnostic.message == "" &&
            $in.input.nonnull_bindings.length != 0}
    >
        <If on={$in.analysis.linking}>
            <Call
                fn="facts/add"
                in={{
                    analysis: $in.analysis,
                    names: $in.input.nonnull_bindings,
                    bindings: $in.input.binding_names
                }}
            />

            <Return value={$ctx.add} />

            <Else>
                <Return
                    value={{
                        ...$in.analysis,
                        state: {
                            ...$in.analysis.state,
                            diagnostic: {
                                code: "contract",
                                message:
                                    "external branch facts require expression linking",
                                start: $in.analysis.span.start,
                                end: $in.analysis.span.end
                            }
                        }
                    }}
                />
            </Else>
        </If>

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
