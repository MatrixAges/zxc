import type { Analysis, Result } from "./model"

export type Input = Analysis

export type Output = Result

export default function (in: Input): Output {
    return {
        type_delta: in.state.types.delta,
        body: { stores: in.state.local.stores, symbols: in.state.local.symbols, expressions: in.state.local.expressions, control: in.state.local.control, root: in.state.diagnostic.message == "" ? in.root : null },
        input_type: in.state.input_type,
        output_type: in.state.local.output_type,
        output_ownership: in.ownership,
        diagnostic: in.state.diagnostic
    }
}
