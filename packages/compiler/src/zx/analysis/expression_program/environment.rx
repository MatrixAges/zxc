<Module>
    <Type from="evaluate/request" as="Request" />
    <Type from="model" as="Model" />

    <Args in={Request.Input} out={Model.Analysis} />

    <If on={$in.analysis.program && $in.analysis.state.diagnostic.message == ""}>
        <Call
            fn="environment/tuple"
            in={{
                analysis: $in.analysis,
                types: $in.input.binding_types
            }}
        />

        <If on={$ctx.tuple.state.diagnostic.message == ""}>
            <Call fn="environment/input" in={$ctx.tuple} />

            <Return value={$ctx.input} />

            <Else>
                <Return value={$ctx.tuple} />
            </Else>
        </If>

        <Else>
            <Return value={$in.analysis} />
        </Else>
    </If>
</Module>
