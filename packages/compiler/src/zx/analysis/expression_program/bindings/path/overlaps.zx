import bytes from "std:bytes"
import { ascii_dot } from "core/ascii/const"

export type Input = {
    left: string,
    right: string
}

export type Output = bool

export default function (in: Input): Output {
    const left = bytes.fromText(in.left)
    const right = bytes.fromText(in.right)

    if (left.length == right.length) {
        return bytes.equals(left, right)
    }

    if (left.length < right.length) {
        return right[left.length] == ascii_dot && bytes.startsWith(right, 0, left)
    }

    return left[right.length] == ascii_dot && bytes.startsWith(left, 0, right)
}
