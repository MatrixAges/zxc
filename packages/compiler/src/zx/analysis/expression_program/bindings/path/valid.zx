import encoding from "std:encoding"

import keyword from "../../../../frontend/lexer/is_keyword"
import transition from "../../../../frontend/lexer/keyword_transition"
import value from "../../../../frontend/lexer/keyword_value"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    const bytes = encoding.encodeUtf8(in)

    const result = loop({ bytes: bytes, index: 0, start: true, keyword: 0, valid: true }, {
        while: current => current.valid && current.index < current.bytes.length,
        next: current => {
            const byte = current.bytes[current.index]

            if (byte == 46) {
                current.valid = !current.start && !keyword(value(current.keyword))
                current.start = true
                current.keyword = 0
            } else {
                const letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)

                current.valid = letter || byte == 95 || (current.start ? byte == 36 : byte >= 48 && byte <= 57)
                current.keyword = transition({ state: current.keyword, byte: byte })
                current.start = false
            }

            current.index += 1
        }
    })

    return result.valid && !result.start && !keyword(value(result.keyword))
}
