import encoding from "std:encoding"
import { ascii_dollar, ascii_dot } from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_underscore,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import keyword from "../../../../frontend/lexer/is_keyword"
import transition from "../../../../frontend/lexer/keyword_transition"
import value from "../../../../frontend/lexer/keyword_value"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    const bytes = encoding.encodeUtf8(in)

    const result = loop({
        bytes,
        index: 0,
        start: true,
        keyword: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.bytes.length,
        next: current => {
            const byte = current.bytes[current.index]

            if (byte == ascii_dot) {
                current.valid = !current.start && !keyword(
                    value(
                        current.keyword
                    )
                )
                current.start = true
                current.keyword = 0
            } else {
                const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
                const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
                const letter = upper || lower
                const digit = byte >= ascii_digit_first && byte <= ascii_digit_last

                const position = current.start ? byte == ascii_dollar : digit

                current.valid = letter || byte == ascii_underscore || position
                current.keyword = transition({
                    state: current.keyword,
                    byte
                })
                current.start = false
            }

            current.index += 1
        }
    })

    return result.valid && !result.start && !keyword(value(result.keyword))
}
