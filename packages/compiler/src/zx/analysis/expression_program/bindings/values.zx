import integers from "std:integer"
import symbol from "core/symbol_table/append"
import { Ownership } from "core/symbol_table/model"

import check from "./check"

import type { Analysis } from "../model"

export type Input = { analysis: Analysis, names: string[], types: u32[] }

export type Output = Analysis

export default function (in: Input): Output {
    return loop({ analysis: in.analysis, names: in.names, types: in.types, index: 0 }, {
        while: current => current.analysis.state.diagnostic.message == "" && current.index < current.names.length,
        next: current => {
            const name = current.names[current.index]
            const type_id = current.types[current.index]
            const span = current.analysis.span
            const count = current.analysis.state.types.context.base.kinds.length + current.analysis.state.types.delta.kinds.length
            const diagnostic = match {
                !current.analysis.program && integers.widen(type_id) >= count => { code: "contract", message: "expression binding type is missing from the shared type table", start: span.start, end: span.end },
                type_id == 0 => { code: "type_mismatch", message: "expression bindings cannot have type void", start: span.start, end: span.end },
                _ => check({ local: current.analysis.state.local, name: name, span: span }),
            }

            current.analysis.state.diagnostic = diagnostic

            if (diagnostic.message == "") {
                const binding = symbol({ table: current.analysis.state.local.symbols, name: name, type_id: type_id, span_start: span.start, span_end: span.end, ownership: Ownership.Copy })

                current.analysis.state.local.symbols = binding.table
                current.analysis.state.local.active = current.analysis.state.local.active.push(binding.id)[0]
                current.analysis.state.local.expression_bindings = current.analysis.state.local.expression_bindings.push(binding.id)[0]
            }

            current.index += 1
        }
    }).analysis
}
