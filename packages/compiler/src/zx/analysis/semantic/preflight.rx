<Module>
    <Type from="./merging/origin" as="Origin" />
    <Type from="./constructing/delta" as="Delta" />

    <Args
        in={{
            first: u64,
            names: string[],
            origins: Origin.Output,
            source: Delta.Output,
            target: Delta.Output
        }}
        out={u64[]?}
    />

    <Call
        fn="types/nominal/shape"
        in={{
            origins: $in.origins,
            names: $in.names
        }}
    />

    <Switch on={$ctx.shape}>
        <Case value={true}>
            <Call
                fn="merging/preflight/origins"
                in={{
                    source: $in.source,
                    origins: $in.origins,
                    names: $in.names
                }}
            />

            <Switch on={$ctx.origins.valid}>
                <Case value={true}>
                    <Call
                        fn="merging/preflight/bounds"
                        in={{
                            source: $in.source,
                            target: $in.target,
                            first: $in.first
                        }}
                    />

                    <Switch on={$ctx.bounds}>
                        <Case value={true}>
                            <Return value={$ctx.origins.indices} />
                        </Case>

                        <Default>
                            <Return value={null} />
                        </Default>
                    </Switch>
                </Case>

                <Default>
                    <Return value={null} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Return value={null} />
        </Default>
    </Switch>
</Module>
