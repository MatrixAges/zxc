<Module>
    <Type from="./merging/origin" as="Origin" />
    <Type from="./constructing/delta" as="Delta" />

    <Args
        in={{
            first: u64,
            names: string[],
            origins: Origin.Output,
            source: Delta.Output,
            target: Delta.Output
        }}
        out={u64[]?}
    />

    <Call
        fn="types/nominal/shape"
        in={{
            origins: $in.origins,
            names: $in.names
        }}
    />

    <If on={$ctx.shape}>
        <Call
            fn="merging/preflight/origins"
            in={$in.pick(["source", "origins", "names"])}
        />

        <If on={$ctx.origins.valid}>
            <Call
                fn="merging/preflight/bounds"
                in={$in.pick(["source", "target", "first"])}
            />

            <If on={$ctx.bounds}>
                <Return value={$ctx.origins.indices} />

                <Else>
                    <Return value={null} />
                </Else>
            </If>

            <Else>
                <Return value={null} />
            </Else>
        </If>

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
