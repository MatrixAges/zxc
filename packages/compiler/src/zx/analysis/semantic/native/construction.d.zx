export type Writer = opaque

export enum Message { TaskContainer, VoidList, TaskTuple, TaskObject, NativeTask, NestedTask }

export declare function kinds(writer: Writer): u8[]

export declare function first(writer: Writer): u32[]

export declare function second(writer: Writer): u32[]

export declare function labels(writer: Writer): string[]

export declare function children(writer: Writer): u32[]

export declare function allFieldTypes(writer: Writer): u32[]

export declare function allFieldNames(writer: Writer): string[]

export declare function names(writer: Writer): string[]

export declare function candidateKind(writer: Writer): u8

export declare function candidateFirst(writer: Writer): u32

export declare function candidateSecond(writer: Writer): u32

export declare function references(writer: Writer): u32[]

export declare function fieldNames(writer: Writer): string[]

export declare function fieldTypes(writer: Writer): u32[]

export declare function memberNames(writer: Writer): string[]

export declare function prepareNames(writer: Writer): void throws { OutOfMemory }

export declare function copyName(writer: Writer, index: u64): void throws { OutOfMemory }

export declare function sortNames(writer: Writer): void throws { OutOfMemory }

export declare function append(writer: Writer): u64 throws { OutOfMemory }

export declare function failType(writer: Writer, message: Message): void throws { InvalidSource, OutOfMemory }

export declare function failOwnership(writer: Writer, message: Message): void throws { InvalidSource, OutOfMemory }

export declare function failCapability(writer: Writer, message: Message): void throws { InvalidSource, OutOfMemory }
