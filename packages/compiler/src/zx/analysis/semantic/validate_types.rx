<Module>
    <Type from="constructing/delta" as="Delta" />
    <Type from="types/validation/shape" as="Shape" />

    <Args
        in={{
            maximum_count: u64,
            scalar_count: u64,
            table: Delta.Output,
            trusted: bool,
            prefix?: Shape.Prefix
        }}
        out={bool}
    />

    <If on={$in.trusted}>
        <Return value={true} />
    </If>

    <Call
        fn="types/validation/shape"
        in={$in.omit(["trusted"])}
    />

    <If on={$ctx.shape}>
        <Call
            fn="types/validation/rows"
            in={{
                table: $in.table,
                scalar_count: $in.scalar_count,
                prefix: $in.prefix
            }}
        />

        <Return value={$ctx.rows} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
