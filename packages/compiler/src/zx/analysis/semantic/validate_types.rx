<Module>
    <Type from="./constructing/delta" as="Delta" />

    <Args in={{ maximum_count: u64, scalar_count: u64, table: Delta.Output, trusted: bool }} out={bool} />

    <Switch on={$in.trusted}>
        <Case value={true}>
            <Return value={true} />
        </Case>
    </Switch>

    <Call fn="types/validation/shape" in={{ table: $in.table, scalar_count: $in.scalar_count, maximum_count: $in.maximum_count }} />

    <Switch on={$ctx.shape}>
        <Case value={true}>
            <Call fn="types/validation/rows" in={{ table: $in.table, scalar_count: $in.scalar_count }} />

            <Return value={$ctx.rows} />
        </Case>

        <Default>
            <Return value={false} />
        </Default>
    </Switch>
</Module>
