<Module>
    <Type from="./constructing/delta" as="Delta" />

    <Args
        in={{
            maximum_count: u64,
            scalar_count: u64,
            table: Delta.Output,
            trusted: bool
        }}
        out={bool}
    />

    <If on={$in.trusted}>
        <Return value={true} />
    </If>

    <Call
        fn="types/validation/shape"
        in={{
            table: $in.table,
            scalar_count: $in.scalar_count,
            maximum_count: $in.maximum_count
        }}
    />

    <If on={$ctx.shape}>
        <Call
            fn="types/validation/rows"
            in={{
                table: $in.table,
                scalar_count: $in.scalar_count
            }}
        />

        <Return value={$ctx.rows} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
