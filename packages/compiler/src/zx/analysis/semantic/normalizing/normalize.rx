<Module>
    <Type from="./append" as="Append" />
    <Type from="./cache" as="Cache" />
    <Type from="core/type_table/nominal" as="Nominal" />
    <Type from="../merging/origin" as="Origin" />
    <Type from="../resolving/model" as="Model" />

    <Args
        in={{
            base: Append.Output,
            cache: Cache.Output,
            delta: Append.Output,
            id: u32,
            origin: Nominal.Origin,
            origins: Origin.Output
        }}
        out={{
            cache: Cache.Output,
            delta: Append.Output,
            diagnostic: Model.Diagnostic,
            id: u32,
            origins: Origin.Output
        }}
    />

    <Call
        fn="normalize"
        in={$in.pick(["base", "delta", "origins", "origin"])}
    />

    <If on={$ctx.normalize.conflict}>
        <Return
            value={{
                delta: $in.delta,
                cache: $in.cache,
                id: $in.id,
                origins: $ctx.normalize.origins,
                diagnostic: {
                    code: "type_mismatch",
                    message:
                        "shared nominal declaration has incompatible identity or members",
                    start: 0,
                    end: 0
                }
            }}
        />

        <Else>
            <Call
                fn="cache"
                in={{
                    cache: $in.cache,
                    mapping: {
                        first: $in.base.kinds.length,
                        ids: $ctx.normalize.mapping
                    }
                }}
            />

            <Call
                fn="reference"
                in={{
                    id: $in.id,
                    mapping: {
                        first: $in.base.kinds.length,
                        ids: $ctx.normalize.mapping
                    }
                }}
            />

            <Return
                value={{
                    delta: $ctx.normalize.delta,
                    cache: $ctx.cache,
                    id: $ctx.reference,
                    origins: $ctx.normalize.origins,
                    diagnostic: {
                        code: "",
                        message: "",
                        start: 0,
                        end: 0
                    }
                }}
            />
        </Else>
    </If>
</Module>
