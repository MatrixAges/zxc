import integers from "std:integer"
import { Kind } from "core/type_table/model"

import row from "../entries/row"
import kind from "../types/kind"
import { Status } from "../types/nominal/model"
import equal from "./equal"
import reference from "./reference"

import type { Tables } from "core/type_table/model"
import type { Origins, Origin } from "core/type_table/nominal"
import type { Entry } from "../entries/model"
import type { Search } from "../types/nominal/model"
import type { Mapping } from "./model"

export type Input = {
    source: Entry,
    tables: Tables,
    origins: Origins,
    origin: Origin,
    mapping: Mapping
}

export type Output = Search

export default function (in: Input): Output {
    const nominal =
        in.source.kind == Kind.Enumeration || in.source.kind == Kind.NativeReference

    const count = nominal ? in.origins.base.ids.length + in.origins.delta.ids.length :
        in.tables.base.kinds.length + in.tables.delta.kinds.length

    const id: u32 = 0

    const direct =
        (
            - in.source.kind == Kind.Scalar
            - or in.source.kind == Kind.Optional
            - or in.source.kind == Kind.List
            - or in.source.kind == Kind.Task
        )

    const known =
        integers.widen(in.source.first) < in.mapping.first + in.mapping.ids.length

    const mapped = direct && known ? reference({
        mapping: in.mapping,
        id: in.source.first
    }) : 0

    const state = loop({
        input: in,
        nominal,
        direct,
        known,
        mapped,
        count,
        index: 0,
        status: Status.Missing,
        id
    }, {
        while: current =>
            current.status == Status.Missing && current.index < current.count,
        next: current => {
            const origin_count = current.input.origins.base.ids.length
            const new_origin = current.index >= origin_count
            const bindings = new_origin ? current.input.origins.delta :
                current.input.origins.base
            const position = new_origin ? current.index - origin_count : current.index
            const id = current.nominal ? bindings.ids[position] :
                integers.narrow(
                    current.index
                )
            const index = integers.widen(id)
            const base_count = current.input.tables.base.kinds.length
            const delta = index >= base_count
            const table = delta ? current.input.tables.delta :
                current.input.tables.base
            const local = delta ? index - base_count : index
            const shape =
                current.direct ? current.known &&
                table.first[local] == current.mapped :
                integers.widen(
                    table.second[local]
                ) == current.input.source.count
            const candidate =
                current.nominal ||
                (
                    kind(
                        table.kinds[local]
                    ) == current.input.source.kind && shape
                )
            const identity =
                (
                    - candidate
                    - and (
                        - !current.nominal
                        - or (
                            - bindings.kinds[position] == current.input.origin.kind
                            - and bindings.owners[position] == current.input.origin.owner
                            - and bindings.members[position] ==
                                current.input.origin.member
                            - and table.labels[local] == current.input.source.label
                        )
                    )
                )

            if (identity) {
                const matches = equal({
                    source: current.input.source,
                    target: row({
                        table,
                        index: local
                    }),
                    mapping: current.input.mapping
                })

                current.status = match {
                    matches => Status.Found,
                    current.nominal => Status.Conflict,
                    _ => Status.Missing
                }
                current.id = id
            }

            current.index += 1
        }
    })

    return {
        status: state.status,
        id: state.id
    }
}
