<Module>
    <Call fn="types/nominal/shape" in={{ origins: $in.origins, names: $in.names }} />

    <Switch on={$ctx.shape}>
        <Case value={true}>
            <Call fn="types/nominal/validate" in={$in} />

            <Return value={$ctx.validate} />
        </Case>

        <Default>
            <Return value={false} />
        </Default>
    </Switch>
</Module>
