<Module>
    <Type from="types/nominal/validate" as="Validate" />

    <Args in={Validate.Input} out={bool} />

    <Call
        fn="types/nominal/shape"
        in={{
            origins: $in.origins,
            names: $in.names
        }}
    />

    <If on={$ctx.shape}>
        <Call fn="types/nominal/validate" in={$in} />

        <Return value={$ctx.validate} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
