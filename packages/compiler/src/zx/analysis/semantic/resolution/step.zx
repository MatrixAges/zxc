import workspace from "zig:resolution"

import name from "./name"
import node from "./node"
import object from "./object"
import tuple from "./tuple"
import wrap from "./wrap"

import type { Workspace } from "zig:resolution"

export type Input = Workspace

export type Output = void

export default function (in: Input): Output {
    const operation = workspace.operation(in)

    if (operation == 0) {
        name(in)
    } else if (operation == 1) {
        workspace.cacheResult(in)
        workspace.leave(in)
        workspace.pop(in)
    } else if (operation == 2) {
        node(in)
    } else if (operation == 3) {
        wrap(in)
    } else if (operation == 4) {
        tuple(in)
    } else {
        object(in)
    }

    return
}
