import workspace from "zig:resolution"

import type { Workspace } from "zig:resolution"
import type { Table } from "../types/model"

export type Input = Workspace

export type Output = Table

export default function (in: Input): Output {
    return {
        kinds: workspace.kinds(in), first: workspace.first(in), second: workspace.second(in), labels: workspace.labels(in),
        children: workspace.children(in), field_types: workspace.allFieldTypes(in), field_names: workspace.allFieldNames(in), names: workspace.names(in)
    }
}
