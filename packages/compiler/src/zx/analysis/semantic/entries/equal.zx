import { Kind } from "core/type_table/model"

import type { Entry } from "./model"

export type Input = { left: Entry, right: Entry }

export type Output = bool

export default function (in: Input): Output {
    const left = in.left
    const right = in.right

    if (left.kind != right.kind) {
        return false
    }

    if (left.kind == Kind.Scalar || left.kind == Kind.Optional || left.kind == Kind.List) {
        return left.first == right.first
    }

    if (left.kind == Kind.Task) {
        return left.first == right.first && left.second == right.second
    }

    if (left.kind == Kind.NativeReference) {
        return left.label == right.label
    }

    if (left.kind == Kind.Enumeration && left.label != right.label) {
        return false
    }

    if (left.count != right.count) {
        return false
    }

    const state = loop({ left: left, right: right, index: 0, equal: true }, {
        while: current => current.equal && current.index < current.left.count,
        next: current => {
            const a = current.left.offset + current.index
            const b = current.right.offset + current.index
            const equal = match current.left.kind {
                Kind.Object => current.left.field_names[a] == current.right.field_names[b] &&
                    current.left.field_types[a] == current.right.field_types[b],
                Kind.Tuple => current.left.children[a] == current.right.children[b],
                _ => current.left.names[a] == current.right.names[b]
            }

            current.equal = equal
            current.index += 1
        }
    })

    return state.equal
}
