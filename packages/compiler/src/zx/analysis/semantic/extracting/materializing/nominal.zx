import integers from "std:integer"
import strings from "std:string"

import type { Bindings } from "core/type_table/nominal"
import type { State } from "../planning/model"

export type Input = {
    origins: Bindings,
    plan: State,
    labels: string[]
}

export type Output = {
    ids: u32[],
    kinds: u8[],
    owners: string[],
    members: string[],
    names: string[]
}

export default function (in: Input): Output {
    const empty: Bindings = {
        ids: [],
        kinds: [],
        owners: [],
        members: []
    }

    const origins = loop({
        source: in.origins,
        plan: in.plan,
        origins: empty,
        index: 0
    }, {
        while: current => current.index < current.plan.count,
        next: current => {
            const selected = current.plan.origins[current.index]

            if (selected != 0) {
                const source_index = selected - 1

                current.origins.ids =
                    current.origins.ids.push(
                        integers.narrow(
                            current.index
                        )
                    )[0]
                current.origins.kinds =
                    current.origins.kinds.push(
                        current.source.kinds[source_index]
                    )[0]
                current.origins.owners =
                    current.origins.owners.push(
                        strings.copy(
                            current.source.owners[source_index]
                        )
                    )[0]
                current.origins.members =
                    current.origins.members.push(
                        strings.copy(
                            current.source.members[source_index]
                        )
                    )[0]
            }

            current.index += 1
        },
        return: state => state.origins
    })

    const labels = in.labels

    return {
        ...origins,
        names: origins.ids.map(id => labels[integers.widen(id)])[0]
    }
}
