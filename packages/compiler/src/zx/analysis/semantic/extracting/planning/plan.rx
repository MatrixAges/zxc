<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Request} out={Model.State?} />

    <Call
        module="../../validate_types"
        in={{
            table: $in.table,
            scalar_count: $in.scalar_count,
            maximum_count: $in.maximum_count,
            trusted: false
        }}
    />

    <Call fn="valid" in={$in} />

    <If on={$ctx.validate_types && $ctx.valid}>
        <Call module="build" in={$in} />

        <Return value={$ctx.build} />

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
