import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const count = in.origins.ids.length

    return (
        - in.scalar_count <= in.table.kinds.length
        - and in.roots.length == in.table.kinds.length
        - and in.origins.kinds.length == count
        - and in.origins.owners.length == count
        - and in.origins.members.length == count
        - and in.names.length == count
    )
}
