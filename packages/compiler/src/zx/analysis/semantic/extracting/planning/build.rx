<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Request} out={Model.State} />

    <Call fn="initialize" in={{ kinds: $in.table.kinds, scalar_count: $in.scalar_count }} />
    <Call fn="roots" in={{ request: $in, state: $ctx.initialize }} />

    <Return value={$ctx.roots} />
</Module>
