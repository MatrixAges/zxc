import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export enum Status { Invalid, MissingOrigin, Ready }

export type State = {
    mapping: u64[]
    order: u32[]
    origins: u64[]
    count: u64
    status: Status
}

export type Request = {
    table: Table
    origins: Bindings
    names: string[]
    roots: bool[]
    scalar_count: u64
    maximum_count: u64
}
