import { Kind } from "core/type_table/model"

import candidate from "../entries/candidate"
import scan from "./scan"

import type { Tables } from "core/type_table/model"
import type { Candidate, Search } from "./model"

export type Input = {
    tables: Tables,
    candidate: Candidate
}

export type Output = Search

export default function (in: Input): Output {
    if (
        in.candidate.kind == Kind.Enumeration || in.candidate.kind == Kind.NativeReference
    ) {
        return {
            found: false,
            id: 0
        }
    }

    const entry = candidate(in.candidate)

    const direct =
        (
            match entry.kind {
                Kind.Scalar => true,
                Kind.Optional => true,
                Kind.List => true,
                Kind.Task => true,
                _ => false
            }
        )

    const base = scan({
        table: in.tables.base,
        entry,
        direct,
        offset: 0,
        previous: 0
    })

    if (base.found) {
        return base
    }

    return scan({
        table: in.tables.delta,
        entry,
        direct,
        offset: in.tables.base.kinds.length,
        previous: base.id
    })
}
