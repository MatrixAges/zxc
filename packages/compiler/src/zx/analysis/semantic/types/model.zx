import type { Kind, Table, Fields, TypeRow } from "core/type_table/model"

export type Row = TypeRow

export type Candidate = {
    kind: Kind
    first: u32
    second: u32
    label: string
    children: u32[]
    fields: Fields
    names: string[]
}

export type Search = { found: bool, id: u32 }

export type Result = { delta: Table, id: u32 }
