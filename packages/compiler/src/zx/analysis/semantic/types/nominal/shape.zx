import type { Bindings } from "core/type_table/nominal"

export type Input = {
    origins: Bindings,
    names: string[]
}

export type Output = bool

export default function (in: Input): Output {
    const count = in.origins.ids.length

    const condition = (
        - in.origins.kinds.length != count
        - or in.origins.owners.length != count
        - or in.origins.members.length != count
        - or in.names.length != count
    )

    if (condition) {
        return false
    }

    return loop({
        origins: in.origins,
        count,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const kind = current.origins.kinds[current.index]

            current.valid =
                kind <= 2 &&
                (
                    kind == 2 || current.origins.members[current.index] == ""
                )
            current.index += 1
        },
        return: state => state.valid
    })
}
