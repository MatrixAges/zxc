import integers from "zig:integers"
import { Kind } from "core/type_table/model"

import kind from "../../kind"

import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export type Input = { table: Table, origins: Bindings, names: string[], index: u64 }

export type Output = bool

export default function (in: Input): Output {
    const id = integers.widen(in.origins.ids[in.index])

    if (id >= in.table.kinds.length) {
        return false
    }

    const type_kind = kind(in.table.kinds[id])

    if ((type_kind != Kind.Enumeration && type_kind != Kind.NativeReference) || (type_kind == Kind.NativeReference && in.origins.kinds[in.index] != 1)) {
        return false
    }

    return in.table.labels[id] == in.names[in.index]
}
