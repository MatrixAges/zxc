import integers from "std:integer"
import { kind_native_reference } from "core/type_table/const"
import { Kind } from "core/type_table/model"

import kind from "../kind"

import type { Table } from "core/type_table/model"

export type Prefix = {
    rows: u64,
    children: u64,
    fields: u64,
    names: u64
}

export type Input = {
    table: Table,
    scalar_count: u64,
    maximum_count: u64,
    prefix?: Prefix
}

export type Output = bool

export default function (in: Input): Output {
    const count = in.table.kinds.length

    const different_second = in.table.second.length != count
    const different_labels = in.table.labels.length != count

    const not_length = in.table.field_names.length != in.table.field_types.length

    const not_maximum_count = in.table.children.length > in.maximum_count
    const not_maximum_count_2 = in.table.field_types.length > in.maximum_count
    const not_maximum_count_3 = in.table.names.length > in.maximum_count

    const condition = (
        - count > in.maximum_count
        - or in.table.first.length != count
        - or different_second
        - or different_labels
        - or not_length
        - or not_maximum_count
        - or not_maximum_count_2
        - or not_maximum_count_3
    )

    if (condition) {
        return false
    }

    const prefix = in.prefix
    const first_row = prefix == null ? 0 : prefix.rows
    const child_end = prefix == null ? 0 : prefix.children
    const field_end = prefix == null ? 0 : prefix.fields
    const name_end = prefix == null ? 0 : prefix.names
    const child_limit = in.table.children.length
    const field_limit = in.table.field_types.length
    const name_limit = in.table.names.length

    const invalid_prefix = (
        - first_row > count
        - or child_end > child_limit
        - or field_end > field_limit
        - or name_end > name_limit
    )

    if (invalid_prefix) {
        return false
    }

    const state = loop({
        table: in.table,
        scalar_count: in.scalar_count,
        index: first_row,
        child_end,
        field_end,
        name_end,
        valid: true
    }, {
        while: current => current.valid && current.index < current.table.kinds.length,
        next: current => {
            const code = current.table.kinds[current.index]
            const first = integers.widen(current.table.first[current.index])
            const count = integers.widen(current.table.second[current.index])
            const type_kind = kind(code)

            const unnamed = type_kind != Kind.Enumeration &&
                type_kind != Kind.NativeReference

            const condition_2 = match {
                code > kind_native_reference => true,
                unnamed => current.table.labels[current.index] != "",
                _ => false
            }

            if (condition_2) {
                current.valid = false
            } else if (type_kind == Kind.Object) {
                current.valid =
                    first == current.field_end &&
                    first <= current.table.field_types.length &&
                    count <= current.table.field_types.length - first

                if (current.valid) {
                    current.field_end += count
                }
            } else if (type_kind == Kind.Tuple) {
                current.valid =
                    first == current.child_end &&
                    first <= current.table.children.length &&
                    count <= current.table.children.length - first

                if (current.valid) {
                    current.child_end += count
                }
            } else if (type_kind == Kind.Enumeration || type_kind == Kind.ErrorSet) {
                current.valid =
                    first == current.name_end &&
                    first <= current.table.names.length &&
                    count <= current.table.names.length - first

                if (current.valid) {
                    current.name_end += count
                }
            } else if (type_kind == Kind.Scalar) {
                current.valid = first < current.scalar_count && count == 0
            } else if (type_kind == Kind.Optional || type_kind == Kind.List) {
                current.valid = count == 0
            } else if (type_kind == Kind.NativeReference) {
                current.valid = first == 0 && count == 0
            }

            current.index += 1
        }
    })

    const is_length = state.child_end == in.table.children.length
    const is_length_2 = state.field_end == in.table.field_types.length
    const is_length_3 = state.name_end == in.table.names.length

    return (
        - state.valid
        - and is_length
        - and is_length_2
        - and is_length_3
    )
}
