import row from "./row"

import type { Table } from "core/type_table/model"
import type { Prefix } from "./shape"

export type Input = {
    table: Table,
    scalar_count: u64,
    prefix?: Prefix
}

export type Output = bool

export default function (in: Input): Output {
    if (in.table.kinds.length < in.scalar_count) {
        return false
    }

    const prefix = in.prefix
    const first = prefix == null ? 0 : prefix.rows

    return loop({
        table: in.table,
        scalar_count: in.scalar_count,
        index: first,
        valid: true
    }, {
        while: current => current.valid && current.index < current.table.kinds.length,
        next: current => {
            current.valid = row({
                table: current.table,
                index: current.index,
                scalar_count: current.scalar_count
            })
            current.index += 1
        },
        return: state => state.valid
    })
}
