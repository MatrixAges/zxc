import integers from "zig:integers"
import names from "zig:type_names"

import kind from "../kind"
import { Kind } from "../model"

import type { Names } from "zig:type_names"
import type { Table } from "../model"

export type Input = { table: Table, index: u64, first: u64, count: u64, object: bool, names: Names }

export type Output = bool

export default function (in: Input): Output {
    const values = in.object ? in.table.field_types : in.table.children

    const state = loop({ table: in.table, values: values, owner: in.index, first: in.first, count: in.count, object: in.object, names: in.names, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const position = current.first + current.index
            const child = integers.widen(current.values[position])

            current.valid = child < current.owner && kind(current.table.kinds[child]) != Kind.Task

            if (current.valid && current.object) {
                current.valid = child != 0 && current.table.field_names[position] != "" &&
                    (current.index == 0 || names.fieldsAscending(current.names, position - 1, position))
            }

            current.index += 1
        }
    })

    return state.valid
}
