import integers from "std:integer"
import { Kind } from "core/type_table/model"

import kind from "../kind"
import ascending from "./ascending"

import type { Table } from "core/type_table/model"

export type Input = {
    table: Table,
    index: u64,
    first: u64,
    count: u64,
    object: bool
}

export type Output = bool

export default function (in: Input): Output {
    const values = in.object ? in.table.field_types : in.table.children

    return loop({
        table: in.table,
        values,
        owner: in.index,
        first: in.first,
        count: in.count,
        object: in.object,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const position = current.first + current.index
            const child = integers.widen(current.values[position])

            current.valid =
                child < current.owner &&
                kind(
                    current.table.kinds[child]
                ) != Kind.Task

            if (current.valid && current.object) {
                const name = current.table.field_names[position]
                const named_child = child != 0 && name != ""

                current.valid = match {
                    !named_child => false,
                    current.index == 0 => true,
                    _ => ascending({
                        left: current.table.field_names[position - 1],
                        right: name
                    })
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
