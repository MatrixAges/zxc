import integers from "zig:integers"
import { Kind } from "core/type_table/model"
import checkName from "lint/naming"
import { NameKind } from "lint/naming/model"

import kind from "../kind"
import children from "./children"
import members from "./members"

import type { Table } from "core/type_table/model"

export type Input = { table: Table, index: u64, scalar_count: u64 }

export type Output = bool

export default function (in: Input): Output {
    const type_kind = kind(in.table.kinds[in.index])
    const first = integers.widen(in.table.first[in.index])
    const second = integers.widen(in.table.second[in.index])

    if (in.index < in.scalar_count) {
        return type_kind == Kind.Scalar && first == in.index
    }

    if (type_kind == Kind.Scalar) {
        return false
    }

    if (type_kind == Kind.NativeReference) {
        return checkName({ name: in.table.labels[in.index], kind: NameKind.TypeDecl })
    }

    if (type_kind == Kind.Task) {
        return first < in.index && second < in.index && kind(in.table.kinds[first]) != Kind.Task && kind(in.table.kinds[second]) == Kind.ErrorSet
    }

    if (type_kind == Kind.Optional || type_kind == Kind.List) {
        return first < in.index && (type_kind != Kind.List || first != 0) && kind(in.table.kinds[first]) != Kind.Task
    }

    if (type_kind == Kind.Tuple || type_kind == Kind.Object) {
        return children({ table: in.table, index: in.index, first: first, count: second, object: type_kind == Kind.Object })
    }

    if (type_kind == Kind.Enumeration && (in.table.labels[in.index] == "" || second == 0)) {
        return false
    }

    return members({ values: in.table.names, first: first, count: second, errors: type_kind == Kind.ErrorSet })
}
