import integers from "std:integer"
import { Kind } from "core/type_table/model"
import checkName from "lint/naming"
import { NameKind } from "lint/naming/model"

import kind from "../kind"
import children from "./children"
import members from "./members"

import type { Table } from "core/type_table/model"

export type Input = {
    table: Table,
    index: u64,
    scalar_count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const type_kind = kind(in.table.kinds[in.index])
    const first = integers.widen(in.table.first[in.index])
    const second = integers.widen(in.table.second[in.index])

    if (in.index < in.scalar_count) {
        return type_kind == Kind.Scalar && first == in.index
    }

    if (type_kind == Kind.Scalar) {
        return false
    }

    if (type_kind == Kind.NativeReference) {
        return checkName({
            name: in.table.labels[in.index],
            kind: NameKind.TypeDecl
        })
    }

    if (type_kind == Kind.Task) {
        const valid_children = first < in.index && second < in.index

        if (!valid_children) {
            return false
        }

        const value_kind = kind(in.table.kinds[first])
        const error_kind = kind(in.table.kinds[second])

        return value_kind != Kind.Task && error_kind == Kind.ErrorSet
    }

    if (type_kind == Kind.Optional || type_kind == Kind.List) {
        const valid_type_kind = type_kind != Kind.List || first != 0
        const valid_child = first < in.index && valid_type_kind

        if (!valid_child) {
            return false
        }

        return kind(in.table.kinds[first]) != Kind.Task
    }

    if (type_kind == Kind.Tuple || type_kind == Kind.Object) {
        return children({
            table: in.table,
            index: in.index,
            first,
            count: second,
            object: type_kind == Kind.Object
        })
    }

    const condition = match {
        type_kind != Kind.Enumeration => false,
        in.table.labels[in.index] == "" => true,
        _ => second == 0
    }

    if (condition) {
        return false
    }

    return members({
        values: in.table.names,
        first,
        count: second,
        errors: type_kind == Kind.ErrorSet
    })
}
