<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Request} out={Model.Result} />

    <Call fn="initial" in={$in} />

    <If on={$in.initialize}>
        <Call module="initialize" in={$ctx.initial} />

        <If on={$ctx.initialize.diagnostic.message == ""}>
            <Call fn="declarations" in={$ctx.initialize} />

            <Return
                value={{
                    delta: $ctx.declarations.delta,
                    cache: $ctx.declarations.cache,
                    id: $ctx.declarations.result,
                    diagnostic: $ctx.declarations.diagnostic
                }}
            />

            <Else>
                <Return
                    value={{
                        delta: $ctx.initialize.delta,
                        cache: $ctx.initialize.cache,
                        id: $ctx.initialize.result,
                        diagnostic: $ctx.initialize.diagnostic
                    }}
                />
            </Else>
        </If>

        <Else>
            <Call fn="run" in={$ctx.initial} />

            <Return
                value={{
                    delta: $ctx.run.delta,
                    cache: $ctx.run.cache,
                    id: $ctx.run.result,
                    diagnostic: $ctx.run.diagnostic
                }}
            />
        </Else>
    </If>
</Module>
