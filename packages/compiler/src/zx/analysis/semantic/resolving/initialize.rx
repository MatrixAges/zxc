<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.State} out={Model.State} />

    <Call fn="initializing/aliases" in={$in} />

    <If on={$ctx.aliases.diagnostic.message == ""}>
        <Call fn="initializing/declarations" in={$ctx.aliases} />

        <Return value={$ctx.declarations} />

        <Else>
            <Return value={$ctx.aliases} />
        </Else>
    </If>
</Module>
