import frame from "./frame"
import { Operation } from "./model"
import run from "./run"
import count from "./source/count"
import declaration from "./source/declaration"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const completed = loop({ state: in, index: 0, count: count(in.context.source) }, {
        while: current => current.index < current.count && current.state.diagnostic.message == "",
        next: current => {
            const selected = declaration({ source: current.state.context.source, index: current.index })
            const entry = frame({ operation: Operation.Name, name: selected.name, reference: selected.value })

            current.state = run({ ...current.state, frames: current.state.frames.push(entry)[0] })
            current.index += 1
        }
    })

    return completed.state
}
