export type Input = { names: string[], name: string }

export type Output = bool

export default function (in: Input): Output {
    const state = loop({ names: in.names, name: in.name, index: 0, found: false }, {
        while: current => !current.found && current.index < current.names.length,
        next: current => {
            current.found = current.names[current.index] == current.name
            current.index += 1
        }
    })

    return state.found
}
