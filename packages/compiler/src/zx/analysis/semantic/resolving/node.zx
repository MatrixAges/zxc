import current from "./current"
import fail from "./fail"
import frame from "./frame"
import { Operation } from "./model"
import replace from "./replace"
import { NodeKind } from "./source/model"
import node from "./source/node"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const head = current(in.frames)

    const value = node({
        source: in.context.source,
        reference: head.reference
    })

    if (value.kind == NodeKind.Named) {
        return replace({
            state: in,
            frame: {
                ...head,
                operation: Operation.Name,
                name: value.name
            }
        })
    }

    if (value.kind == NodeKind.Selection || value.kind == NodeKind.Intersection) {
        const operation = match value.kind {
            NodeKind.Selection => Operation.Select,
            _ => Operation.Intersect
        }

        const state = replace({
            state: in,
            frame: {
                ...head,
                operation,
                name: value.name,
                position: value.position,
                count: value.count
            }
        })

        const child = frame({
            operation: Operation.Node,
            name: value.name,
            reference: value.child
        })

        return {
            ...state,
            frames: state.frames.push(child)[0]
        }
    }

    const condition = (
        match value.kind {
            NodeKind.Optional => true,
            NodeKind.List => true,
            NodeKind.Application => true,
            _ => false
        }
    )

    if (condition) {
        if (value.kind == NodeKind.Application && value.name.text != "Array") {
            return fail({
                state: in,
                code: "unsupported",
                message: "generic and database types are not enabled",
                name: value.name
            })
        }

        const state = replace({
            state: in,
            frame: {
                ...head,
                operation: Operation.Wrap,
                list: value.kind != NodeKind.Optional
            }
        })

        const child = frame({
            operation: Operation.Node,
            name: {
                text: "",
                start: 0,
                end: 0
            },
            reference: value.child
        })

        return {
            ...state,
            frames: state.frames.push(child)[0]
        }
    }

    if (value.kind == NodeKind.Tuple || value.kind == NodeKind.Object) {
        return replace({
            state: in,
            frame: {
                ...head,
                operation: match {
                    value.kind == NodeKind.Tuple => Operation.Tuple,
                    _ => Operation.Object
                },
                count: value.count,
                position: value.position,
                children: in.scratch.types.length,
                fields: in.scratch.names.length
            }
        })
    }

    return fail({
        state: in,
        code: "type_mismatch",
        message: "enum types require a named declaration",
        name: {
            text: "",
            start: 0,
            end: 0
        }
    })
}
