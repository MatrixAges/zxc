import declared from "./initializing/declared"
import imported from "./initializing/imported"
import count from "./source/count"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const aliases = loop({ state: in, index: 0 }, {
        while: current => current.index < current.state.context.aliases.names.length && current.state.diagnostic.message == "",
        next: current => {
            current.state = imported({ state: current.state, index: current.index })
            current.index += 1
        }
    })

    const declarations = loop({ state: aliases.state, index: 0, count: count(in.context.source) }, {
        while: current => current.index < current.count && current.state.diagnostic.message == "",
        next: current => {
            current.state = declared({ state: current.state, index: current.index })
            current.index += 1
        }
    })

    return declarations.state
}
