import { Kind } from "core/type_table/model"

import construct from "../construct"
import pop from "../pop"

import type { Fields } from "core/type_table/model"
import type { State } from "../model"

export type Input = {
    state: State,
    fields: Fields
}

export type Output = State

export default function (in: Input): Output {
    return pop(construct({
        state: in.state,
        candidate: {
            kind: Kind.Object,
            first: 0,
            second: 0,
            label: "",
            children: [],
            fields: in.fields,
            names: []
        }
    }))
}
