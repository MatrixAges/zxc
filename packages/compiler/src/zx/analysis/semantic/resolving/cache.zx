import current from "./current"

import type { State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    return current(in.frames)
        -> {
            ...in,
            cache: {
                names: in.cache.names.push(_.name.text)[0],
                ids: in.cache.ids.push(in.result)[0]
            },
            active: in.active.pop()[0],
            frames: in.frames.pop()[0]
        }
}
