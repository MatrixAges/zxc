<Module>
    <Type from="merging/model" as="Model" />

    <Args in={Model.Input} out={Model.State} />

    <If on={$in.request.checked}>
        <Call
            fn="merging/preflight/prefix"
            in={{
                source: $in.request.source,
                target: $in.request.base,
                first: $in.request.first
            }}
        />

        <If on={!$ctx.prefix}>
            <Return
                value={{
                    ...$in.state,
                    status: Model.Status.Invalid
                }}
            />
        </If>
    </If>

    <Call
        fn="merging/initialize"
        in={{
            mapping: $in.request.mapping,
            first: $in.request.first
        }}
    />

    <Call fn="merging/append" in={$in} />

    <Return value={$ctx.append} />
</Module>
