import integers from "zig:integers"

import find from "../types/find"

import type { Tables } from "core/type_table/model"
import type { Candidate } from "../types/model"

export type Input = { tables: Tables, candidate: Candidate }

export type Output = u64

export default function (in: Input): Output {
    const result = find(in)

    return result.found ? integers.widen(result.id) + 2 : 0
}
