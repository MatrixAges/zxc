import type { U32Buffer } from "std:memory"
import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export type Request = {
    source: Table
    origins: Bindings
    origin_indices: u64[]
    base: Table
    base_origins: Bindings
    mapping: U32Buffer
    first: u64
    checked: bool
}

export enum Status {
    Ready,
    MissingOrigin,
    Conflict,
    Invalid
}

export type State = {
    delta: Table
    origins: Bindings
    references: u32[]
    status: Status
}

export type Input = {
    request: Request,
    state: State
}
