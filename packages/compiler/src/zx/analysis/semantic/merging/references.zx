import integers from "std:integer"
import { Kind } from "core/type_table/model"

import kind from "../types/kind"

import type { Table } from "core/type_table/model"

export type Input = {
    source: Table,
    index: u64,
    mapping: u32[],
    references: u32[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const type_kind = kind(in.source.kinds[in.index])
    const empty = in.references.splice(0, 0, [])[1]

    const condition = (
        - type_kind == Kind.Optional
        - or type_kind == Kind.List
        - or type_kind == Kind.Task
    )

    if (condition) {
        const single = in.mapping[integers.widen(in.source.first[in.index])]
            -> empty.push(_)[0]

        return type_kind ==
            Kind.Task ? single.push(
                in.mapping[integers.widen(
                    in.source.second[in.index]
                )]
            )[0] : single
    }

    const dynamic = type_kind == Kind.Tuple || type_kind == Kind.Object
    const values = type_kind == Kind.Tuple ? in.source.children : in.source.field_types
    const count = dynamic ? integers.widen(in.source.second[in.index]) : 0
    const first = integers.widen(in.source.first[in.index])

    return loop({
        mapping: in.mapping,
        values,
        first,
        count,
        index: 0,
        references: empty
    }, {
        while: current => current.index < current.count,
        next: current => {
            const id =
                integers.widen(
                    current.values[current.first + current.index]
                )

            current.references = current.references.push(current.mapping[id])[0]
            current.index += 1
        },
        return: state => state.references
    })
}
