import writer from "zig:merge_writer"

import type { Writer } from "zig:merge_writer"
import type { Bindings } from "../types/nominal/model"

export type Input = Writer

export type Output = Bindings

export default function (in: Input): Output {
    return { ids: writer.originIds(in), kinds: writer.originKinds(in), owners: writer.originOwners(in), members: writer.originMembers(in) }
}
