import integers from "std:integer"
import { Kind } from "core/type_table/model"

import kind from "../types/kind"

import type { Table } from "core/type_table/model"
import type { Candidate } from "../types/model"

export type Input = {
    source: Table,
    index: u64,
    references: u32[]
}

export type Output = Candidate

export default function (in: Input): Output {
    const type_kind = kind(in.source.kinds[in.index])

    const single =
        type_kind == Kind.Optional || type_kind == Kind.List || type_kind == Kind.Task

    const first = integers.widen(in.source.first[in.index])
    const count = integers.widen(in.source.second[in.index])

    return {
        kind: type_kind,
        first: single ? in.references[0] : in.source.first[in.index],
        second: type_kind == Kind.Task ? in.references[1] : 0,
        label: in.source.labels[in.index],
        children: match {
            type_kind == Kind.Tuple => in.references,
            _ => []
        },
        fields: {
            names:
                match {
                    type_kind ==
                        Kind.Object => in.source.field_names.splice(
                            first,
                            count,
                            []
                        )[1],
                    _ => []
                },
            types: match {
                type_kind == Kind.Object => in.references,
                _ => []
            }
        },
        names:
            match {
                type_kind == Kind.Enumeration ||
                    type_kind ==
                    Kind.ErrorSet => in.source.names.splice(
                        first,
                        count,
                        []
                    )[1],
                _ => []
            }
    }
}
