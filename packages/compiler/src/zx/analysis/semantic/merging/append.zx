import integers from "std:integer"
import memory from "std:memory"
import { Kind } from "core/type_table/model"

import delta from "../constructing/delta"
import kind from "../types/kind"
import candidate from "./candidate"
import { Status } from "./model"
import nominal from "./nominal"
import origin from "./origin"
import references from "./references"
import structural from "./structural"

import type { Input, State } from "./model"

export type Output = State

export default function (in: Input): Output {
    return loop({
        request: in.request,
        state: in.state,
        index: in.request.first
    }, {
        while: current =>
            current.state.status == Status.Ready &&
            current.index < current.request.source.kinds.length,
        next: current => {
            const request = current.request
            const index = current.index
            const remapped = references({
                source: request.source,
                index,
                mapping: request.mapping,
                references: current.state.references
            })
            const value = candidate({
                source: request.source,
                index,
                references: remapped
            })
            const type_kind = kind(request.source.kinds[index])
            const is_nominal =
                type_kind == Kind.Enumeration || type_kind == Kind.NativeReference

            if (is_nominal && request.origin_indices[index] == 0) {
                current.state = {
                    ...current.state,
                    references: remapped,
                    status: Status.MissingOrigin
                }
            } else {
                const origin_index =
                    is_nominal ? request.origin_indices[index] - 1 : 0
                const identity = match {
                    is_nominal => {
                        kind: request.origins.kinds[origin_index],
                        owner: request.origins.owners[origin_index],
                        member: request.origins.members[origin_index]
                    },
                    _ => {
                        kind: 0,
                        owner: "",
                        member: ""
                    }
                }
                const tables = {
                    base: request.base,
                    delta: current.state.delta
                }
                const result = match {
                    is_nominal => nominal({
                        tables,
                        origins: {
                            base: request.base_origins,
                            delta: current.state.origins
                        },
                        origin: identity,
                        candidate: value
                    }),
                    _ => structural({
                        tables,
                        candidate: value
                    })
                }

                if (result == 1) {
                    current.state = {
                        ...current.state,
                        references: remapped,
                        status: Status.Conflict
                    }
                } else {
                    const id =
                        match {
                            result ==
                                0 => integers.narrow(
                                    request.base.kinds.length +
                                        current.state.delta.kinds.length
                                ),
                            _ => integers.narrow(
                                result - 2
                            )
                        }
                    const added = match {
                        result == 0 => delta({
                            delta: current.state.delta,
                            candidate: value
                        }),
                        _ => current.state.delta
                    }
                    const bound = match {
                        result == 0 && is_nominal => origin({
                            bindings: current.state.origins,
                            origin: identity,
                            id
                        }),
                        _ => current.state.origins
                    }
                    memory.writeU32(request.mapping, index, id)

                    current.state = {
                        delta: added,
                        origins: bound,
                        references: remapped,
                        status: Status.Ready
                    }
                }
            }

            current.index += 1
        },
        return: state => state.state
    })
}
