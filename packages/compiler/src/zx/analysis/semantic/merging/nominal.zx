import encode from "../types/nominal/encode"
import find from "../types/nominal/find"

import type { Tables } from "core/type_table/model"
import type { Origin, Origins } from "core/type_table/nominal"
import type { Candidate } from "../types/model"

export type Input = { tables: Tables, origins: Origins, origin: Origin, candidate: Candidate }

export type Output = u64

export default function (in: Input): Output {
    return encode(find(in))
}
