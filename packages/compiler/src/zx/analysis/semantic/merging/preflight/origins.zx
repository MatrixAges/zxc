import integers from "zig:integers"
import workspace from "zig:merge_workspace"

import binding from "../../types/nominal/validation/binding"

import type { Workspace } from "zig:merge_workspace"
import type { Table } from "../../types/model"
import type { Bindings } from "../../types/nominal/model"

export type Input = { source: Table, origins: Bindings, names: string[], workspace: Workspace }

export type Output = bool

export default function (in: Input): Output {
    workspace.allocateOrigins(in.workspace, in.source.kinds.length)

    const origins = loop({ source: in.source, origins: in.origins, names: in.names, workspace: in.workspace, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.origins.ids.length,
        next: current => {
            const id = integers.widen(current.origins.ids[current.index])
            const valid = id < current.source.kinds.length && !workspace.hasOrigin(current.workspace, id) &&
                binding({ table: current.source, origins: current.origins, names: current.names, index: current.index })

            if (valid) {
                workspace.setOrigin(current.workspace, id, current.index)
            }

            current.valid = valid
            current.index += 1
        }
    })

    return origins.valid
}
