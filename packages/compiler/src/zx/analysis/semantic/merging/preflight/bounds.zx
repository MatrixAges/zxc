import type { Table } from "core/type_table/model"

export type Input = {
    source: Table,
    target: Table,
    first: u64,
    complete: bool
}

export type Output = bool

export default function (in: Input): Output {
    const not_length = in.first <= in.source.kinds.length
    const not_length_2 = in.first <= in.target.kinds.length

    const valid_complete =
        !in.complete || in.first == 0 || in.first == in.target.kinds.length

    return (
        - not_length
        - and not_length_2
        - and (valid_complete)
    )
}
