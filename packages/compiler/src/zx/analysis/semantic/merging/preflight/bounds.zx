import type { Table } from "core/type_table/model"

export type Input = {
    source: Table,
    target: Table,
    first: u64,
    complete: bool
}

export type Output = bool

export default function (in: Input): Output {
    return in.first <= in.source.kinds.length && in.first <= in.target.kinds.length &&
        (!in.complete || in.first == 0 || in.first == in.target.kinds.length)
}
