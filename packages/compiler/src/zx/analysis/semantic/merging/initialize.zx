import integers from "std:integer"
import memory from "std:memory"

import type { U32Buffer } from "std:memory"

export type Input = {
    mapping: U32Buffer,
    first: u64
}

export type Output = void

export default function (in: Input): Output {
    const result = loop({
        index: 0
    }, {
        while: current => current.index < in.first,
        next: current => {
            memory.writeU32(
                in.mapping,
                current.index,
                integers.narrow(current.index)
            )
            current.index += 1
        }
    })
}
