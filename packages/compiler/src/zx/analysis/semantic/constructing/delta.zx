import { Kind } from "core/type_table/model"

import layout from "./layout"

import type { Table } from "core/type_table/model"
import type { Candidate } from "../types/model"

export type Input = {
    delta: Table,
    candidate: Candidate
}

export type Output = Table

export default function (in: Input): Output {
    const named =
        in.candidate.kind == Kind.ErrorSet || in.candidate.kind == Kind.Enumeration

    const row = layout({
        table: in.delta,
        candidate: in.candidate
    })

    return {
        kinds: in.delta.kinds.push(row.kind)[0],
        first: in.delta.first.push(row.first)[0],
        second: in.delta.second.push(row.second)[0],
        labels: in.delta.labels.push(in.candidate.label)[0],
        children:
            match {
                in.candidate.kind ==
                    Kind.Tuple => in.delta.children.concat(
                        in.candidate.children
                    )[0],
                _ => in.delta.children
            },
        field_types:
            match {
                in.candidate.kind ==
                    Kind.Object => in.delta.field_types.concat(
                        in.candidate.fields.types
                    )[0],
                _ => in.delta.field_types
            },
        field_names:
            match {
                in.candidate.kind ==
                    Kind.Object => in.delta.field_names.concat(
                        in.candidate.fields.names
                    )[0],
                _ => in.delta.field_names
            },
        names: named ? in.delta.names.concat(in.candidate.names)[0] : in.delta.names
    }
}
