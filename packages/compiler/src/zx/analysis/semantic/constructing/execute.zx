import update from "./update"

import type { Table } from "core/type_table/model"
import type { ConstructionInput, ConstructionOutput } from "./model"

export type Input = ConstructionInput

export type Output = ConstructionOutput

export default function (in: Input): Output {
    const empty: Table = { kinds: [], first: [], second: [], labels: [], children: [], field_types: [], field_names: [], names: [] }

    return update({ tables: { base: in.table, delta: empty }, candidate: in.candidate })
}
