import find from "../types/find"
import delta from "./delta"
import limit from "./limit"
import normalize from "./normalize"
import validate from "./validate"

import type { UpdateInput, ConstructionOutput } from "./model"

export type Input = UpdateInput

export type Output = ConstructionOutput

export default function (in: Input): Output {
    const issue = validate(in)

    if (issue.message != "") {
        return {
            delta: in.tables.delta,
            id: 0,
            diagnostic: issue
        }
    }

    const normalized = normalize(in.candidate)

    const found = find({
        tables: in.tables,
        candidate: normalized
    })

    if (found.found) {
        return {
            delta: in.tables.delta,
            id: found.id,
            diagnostic: issue
        }
    }

    const id = limit(in)

    return {
        delta: delta({
            delta: in.tables.delta,
            candidate: normalized
        }),
        id: id,
        diagnostic: issue
    }
}
