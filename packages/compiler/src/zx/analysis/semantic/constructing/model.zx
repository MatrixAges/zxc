import type { Fields, Table, Tables } from "core/type_table/model"
import type { Candidate } from "../types/model"

export type Diagnostic = {
    code: string,
    message: string
}

export type Layout = {
    kind: u8,
    first: u32,
    second: u32
}

export type Row = {
    layout: Layout,
    label: string,
    children: u32[],
    fields: Fields,
    names: string[]
}

export type Publication = {
    row?: Row,
    id: u32,
    diagnostic: Diagnostic
}

export type UpdateInput = {
    tables: Tables,
    candidate: Candidate
}

export type ConstructionOutput = {
    delta: Table,
    id: u32,
    diagnostic: Diagnostic
}
