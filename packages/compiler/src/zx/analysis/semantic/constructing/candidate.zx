import writer from "zig:construction"

import kind from "../types/kind"

import type { Writer } from "zig:construction"
import type { Candidate } from "../types/model"

export type Input = Writer

export type Output = Candidate

export default function (in: Input): Output {
    return {
        kind: kind(writer.candidateKind(in)), first: writer.candidateFirst(in), second: writer.candidateSecond(in), label: "",
        children: writer.references(in), fields: { names: writer.fieldNames(in), types: writer.fieldTypes(in) }, names: writer.memberNames(in)
    }
}
