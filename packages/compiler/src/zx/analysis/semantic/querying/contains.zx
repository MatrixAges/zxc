import integers from "zig:integers"
import { Kind } from "core/type_table/model"

import typeRow from "../types/row"
import row from "./row"

import type { Tables } from "core/type_table/model"

export type Input = { tables: Tables, id: u32, native_references: bool }

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.id)
    const target = in.native_references ? Kind.NativeReference : Kind.List

    if (typeRow({ tables: in.tables, id: in.id }).kind == target) {
        return true
    }

    const first = loop({ tables: in.tables, limit: index, target: target, index: 0, found: false }, {
        while: current => !current.found && current.index < current.limit,
        next: current => {
            current.found = typeRow({ tables: current.tables, id: integers.narrow(current.index) }).kind == current.target
            current.index += 1
        }
    })

    if (!first.found) {
        return false
    }

    const flags: bool[] = []

    const state = loop({ tables: in.tables, index: 0, first: first.index - 1, limit: index + 1, flags: flags, native_references: in.native_references }, {
        while: current => current.index < current.limit,
        next: current => {
            const found = current.index >= current.first && row({ tables: current.tables, index: current.index, flags: current.flags, native_references: current.native_references })

            current.flags = current.flags.push(found)[0]
            current.index += 1
        }
    })

    return state.flags[index]
}
