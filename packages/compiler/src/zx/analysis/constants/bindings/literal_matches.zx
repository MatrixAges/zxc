import integers from "std:integer"

import equal from "../value_equal"

import type { Literal } from "core/constant/model"

export type Input = {
    left: Literal,
    right: Literal,
    mapping: u32[],
    current_mapping: u32[]?
}

export type Output = bool

export default function (in: Input): Output {
    const left_index = integers.widen(in.left.type_id)
    const right_index = integers.widen(in.right.type_id)
    const current_mapping = in.current_mapping

    if (
        left_index >= in.mapping.length ||
            (
                current_mapping != null && right_index >= current_mapping.length
            )
    ) {
        return false
    }

    const right_type = current_mapping != null ? current_mapping[right_index] :
        in.right.type_id

    return in.mapping[left_index] == right_type && equal({
        left: in.left,
        right: in.right
    })
}
