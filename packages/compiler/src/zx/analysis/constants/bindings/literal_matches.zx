import integers from "std:integer"

import equal from "../value_equal"

import type { Literal } from "core/constant/model"

export type Input = {
    left: Literal,
    right: Literal,
    mapping: u32[],
    current_mapping?: u32[]
}

export type Output = bool

export default function (in: Input): Output {
    const left_index = integers.widen(in.left.type_id)
    const right_index = integers.widen(in.right.type_id)
    const current_mapping = in.current_mapping

    const not_length = left_index >= in.mapping.length

    const invalid_mapping = match {
        current_mapping != null => right_index >= current_mapping.length,
        _ => false
    }

    const condition = not_length || invalid_mapping

    if (condition) {
        return false
    }

    const right_type = match {
        current_mapping != null => current_mapping[right_index],
        _ => in.right.type_id
    }

    return in.mapping[left_index] == right_type && equal({
        left: in.left,
        right: in.right
    })
}
