import literalMatches from "./literal_matches"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const previous = in.previous
    const current = in.current

    if (previous == null || current == null) {
        return previous == null && current == null
    }

    const condition = (
        - previous.names.length != current.names.length
        - or previous.names.length != previous.values.length
        - or current.names.length != current.values.length
    )

    if (condition) {
        return false
    }

    return loop({
        previous,
        current,
        mapping: in.mapping,
        current_mapping: in.current_mapping,
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < state.previous.names.length,
        next: state => {
            const previous_value = state.previous.values[state.index]
            const current_value = state.current.values[state.index]

            state.valid =
                state.previous.names[state.index] ==
                state.current.names[state.index] && literalMatches({
                    left: previous_value,
                    right: current_value,
                    mapping: state.mapping,
                    current_mapping: state.current_mapping
                })

            state.index += 1
        },
        return: state => state.valid
    })
}
