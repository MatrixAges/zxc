<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Request} out={Model.Result} />

    <Call fn="closure" in={$in} />

    <Switch on={$ctx.closure.message != ""}>
        <Case value={true}>
            <Return value={{
                value: null,
                diagnostic: $ctx.closure
            }} />
        </Case>
    </Switch>

    <Call fn="initial" in={$in} />

    <Call fn="walk" in={{
        input: $in,
        cursor: $ctx.initial
    }} />

    <Call fn="publish" in={{
        input: $in,
        cursor: $ctx.walk
    }} />

    <Return value={$ctx.publish} />
</Module>
