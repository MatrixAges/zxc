<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Request} out={Model.Result} />

    <Call fn="closure" in={$in} />

    <If on={$ctx.closure.message != ""}>
        <Return
            value={{
                value: null,
                diagnostic: $ctx.closure
            }}
        />
    </If>

    <Call fn="initial" in={$in} />

    <Call
        fn="walk"
        in={{
            input: $in,
            cursor: $ctx.initial
        }}
    />

    <Call
        fn="publish"
        in={{
            input: $in,
            cursor: $ctx.walk
        }}
    />

    <Return value={$ctx.publish} />
</Module>
