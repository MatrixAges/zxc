import find from "core/constant/lookup"

import lookup from "../analyzer/bindings/lookup"

import type { Literal, Values } from "core/constant/model"

export type Input = {
    active: u32[],
    names: string[],
    constants: Values?,
    name: string
}

export type Output = Literal?

    export default function (in: Input): Output {
        const constants = in.constants

        if (constants == null) {
            return null
        }

        const local = lookup({
            active: in.active,
            names: in.names,
            scope_floor: 0,
            name: in.name
        })

        if (local != null) {
            return null
        }

        return find({
            constants,
            name: in.name
        })
    }
