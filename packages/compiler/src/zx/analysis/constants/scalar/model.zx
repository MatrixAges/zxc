import type { Literal } from "core/constant/model"
import type { BinaryOperator } from "core/expression_table/kinds"
import type { Target } from "../../analyzer/expressions/numbers/model"

export type Value = Literal

export type Signed = {
    magnitude: u64,
    negative: bool
}

export type Arithmetic = {
    left: Signed,
    right: Signed,
    operator: BinaryOperator,
    target: Target
}

export type IntegerResult = {
    value: Signed,
    message: string
}

export type Binary = {
    left: Value,
    right: Value,
    operator: BinaryOperator,
    type_id: u32
}

export type Result = {
    value: Value,
    message: string
}
