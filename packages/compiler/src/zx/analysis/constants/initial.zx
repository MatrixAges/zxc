import type { Cursor, Request } from "./model"
import type { Value } from "./scalar/model"

export type Input = Request

export type Output = Cursor

export default function (in: Input): Output {
    const values: Value?[] = in.expressions.kinds.map(kind => null)[0]

    return {
        frames: [{
            id: in.root,
            arm: 0
        }],
        values,
        diagnostic: {
            code: "",
            start: 0,
            end: 0,
            message: ""
        }
    }
}
