<Module>
    <Type from="model" as="Constants" />

    <Args in={Constants.Interface} out={bool} />

    <Task name="exports" out={$ctx.validate}>
        <Call
            module="validate"
            in={{
                types: $in.types,
                constants: $in.exports
            }}
        />
    </Task>

    <If on={!$ctx.task.exports}>
        <Return value={false} />
    </If>

    <Call
        module="validate"
        in={{
            types: $in.types,
            constants: $in.imports
        }}
    />

    <Return value={$ctx.validate} />
</Module>
