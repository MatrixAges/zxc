import floats from "std:float"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import { code_unsupported, message_non_finite } from "./const"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const index = integers.widen(in.input.root)
    const value = in.cursor.values[index]

    if (in.cursor.diagnostic.message != "") {
        return {
            value: null,
            diagnostic: in.cursor.diagnostic
        }
    }

    const condition = match {
        value == null => false,
        value.kind != ExpressionKind.Float => false,
        _ => !floats.isFinite(value.floating)
    }

    if (condition) {
        return {
            value: null,
            diagnostic: {
                code: code_unsupported,
                start: in.input.expressions.span_start[index],
                end: in.input.expressions.span_end[index],
                message: message_non_finite
            }
        }
    }

    return {
        value,
        diagnostic: in.cursor.diagnostic
    }
}
