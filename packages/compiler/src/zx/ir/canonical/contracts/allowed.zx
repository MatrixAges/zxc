import { ExpressionKind } from "../expressions/kinds"

export type Input = ExpressionKind

export type Output = bool

export default function (in: Input): Output {
    return match in {
        ExpressionKind.Call => false,
        ExpressionKind.StoreGet => false,
        ExpressionKind.ListOperation => false,
        ExpressionKind.Transform => false,
        ExpressionKind.Scope => false,
        ExpressionKind.Iteration => false,
        ExpressionKind.ListUpdate => false,
        ExpressionKind.Capture => false,
        ExpressionKind.OptionalValue => false,
        ExpressionKind.Task => false,
        ExpressionKind.AwaitTask => false,
        ExpressionKind.CancelTask => false,
        ExpressionKind.Parallel => false,
        _ => true
    }
}
