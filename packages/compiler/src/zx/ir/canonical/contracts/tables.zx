import integers from "std:integer"
import { max_u32 } from "core/const"

import symbols from "../body/symbols"
import offsets from "../expressions/validation/offsets"
import expressions from "../expressions/validation/validate"

import type { Contracts } from "core/contract_table/model"

export type Input = {
    contracts: Contracts,
    max_offset: u64
}

export type Output = bool

export default function (in: Input): Output {
    const contracts = in.contracts
    const count = contracts.kinds.length

    const condition = (
        - count > integers.widen(max_u32)
        - or contracts.predicates.length != count
        - or contracts.symbols.length != count
        - or contracts.expressions.length != count
        - or contracts.span_start.length != count
        - or contracts.span_end.length != count
    )

    if (condition) {
        return false
    }

    if (!offsets({
        starts: contracts.span_start,
        ends: contracts.span_end,
        max_offset: in.max_offset
    })) {
        return false
    }

    return loop({
        contracts,
        max_offset: in.max_offset,
        index: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < current.contracts.kinds.length,
        next: current => {
            current.valid = symbols({
                symbols: current.contracts.symbols[current.index],
                max_offset: current.max_offset
            }) &&
                expressions({
                    table: current.contracts.expressions[current.index],
                    max_offset: current.max_offset
                })
            current.index += 1
        },
        return: state => state.valid
    })
}
