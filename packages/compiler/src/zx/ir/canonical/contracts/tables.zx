import symbols from "../body/symbols"
import offsets from "../expressions/validation/offsets"
import expressions from "../expressions/validation/validate"

import type { Contracts } from "./model"

export type Input = { contracts: Contracts, max_offset: u64 }

export type Output = bool

export default function (in: Input): Output {
    const contracts = in.contracts
    const count = contracts.kinds.length

    if (count > 4294967295 || contracts.predicates.length != count || contracts.symbols.length != count || contracts.expressions.length != count || contracts.span_start.length != count || contracts.span_end.length != count) {
        return false
    }

    if (!offsets({ starts: contracts.span_start, ends: contracts.span_end, max_offset: in.max_offset })) {
        return false
    }

    const result = loop({ contracts: contracts, max_offset: in.max_offset, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.contracts.kinds.length,
        next: current => {
            current.valid = symbols({ symbols: current.contracts.symbols[current.index], max_offset: current.max_offset }) &&
                expressions({ table: current.contracts.expressions[current.index], max_offset: current.max_offset })
            current.index += 1
        }
    })

    return result.valid
}
