<Module>
    <Type from="./body/references/control" as="Control" />

    <Args in={{ body: Control.Input, max_offset: u64 }} out={bool} />

    <Call module="./body/structure" in={$in} />

    <Switch on={$ctx.structure}>
        <Case value={true}>
            <Call fn="./body/references/expressions" in={$in.body} />

            <Switch on={$ctx.expressions}>
                <Case value={true}>
                    <Call fn="./body/references/control" in={$in.body} />

                    <Return value={$ctx.control} />
                </Case>

                <Default>
                    <Return value={false} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Return value={false} />
        </Default>
    </Switch>
</Module>
