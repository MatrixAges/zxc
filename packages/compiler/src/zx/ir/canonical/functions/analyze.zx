import calls from "./calls"

import type { Functions } from "./model"

export type Input = {
    functions: Functions,
    concurrent: bool
}

export type Output = bool[]

export default function (in: Input): Output {
    const values: bool[] = in.functions.native_modules.map(value => false)[0]

    return loop({
        functions: in.functions,
        concurrent: in.concurrent,
        values,
        index: 0
    }, {
        while: current => current.index < current.values.length,
        next: current => {
            const allowed =
                current.functions.stores[current.index].paths.length == 0 &&
                (match {
                    current.functions.native_modules[current.index] != null =>
                        current.concurrent &&
                        current.functions.native_concurrent[current.index],
                    _ => calls({
                        expressions: current.functions.expressions[current.index],
                        allowed: current.values,
                        self_function: current.index,
                        limit: current.index,
                        concurrent: current.concurrent
                    })
                })

            current.values[current.index] = allowed
            current.index += 1
        },
        return: state => state.values
    })
}
