import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    allowed: bool[],
    self_function?: u64,
    limit: u64,
    concurrent: bool
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        expressions: in.expressions,
        allowed: in.allowed,
        self_function: in.self_function,
        limit: in.limit,
        concurrent: in.concurrent,
        index: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < current.expressions.kinds.length,
        next: current => {
            const kind = current.expressions.kinds[current.index]

            if (kind == ExpressionKind.StoreGet) {
                current.valid = false
            } else {
                const valid_kind = match kind {
                    ExpressionKind.Task => true,
                    ExpressionKind.AwaitTask => true,
                    ExpressionKind.CancelTask => true,
                    ExpressionKind.Parallel => true,
                    _ => false
                }

                const condition = (
                    - !current.concurrent
                    - and (
                        valid_kind
                    )
                )

                if (condition) {
                    current.valid = false
                } else if (kind == ExpressionKind.Call) {
                    const payload =
                        integers.widen(
                            current.expressions.payloads[current.index]
                        )
                    const target =
                        integers.widen(
                            current.expressions.call_functions[payload]
                        )

                    const no_stores = current.expressions.call_store_count[payload] == 0
                    const self_call = match {
                        !no_stores => false,
                        current.self_function == null => false,
                        _ => target == current.self_function
                    }

                    current.valid = match {
                        !no_stores => false,
                        self_call => true,
                        target < current.limit => current.allowed[target],
                        _ => false
                    }
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
