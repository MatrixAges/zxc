import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions,
    allowed: bool[],
    self_function?: u64,
    limit: u64,
    concurrent: bool
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        expressions: in.expressions,
        allowed: in.allowed,
        self_function: in.self_function,
        limit: in.limit,
        concurrent: in.concurrent,
        index: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < current.expressions.kinds.length,
        next: current => {
            const kind = current.expressions.kinds[current.index]

            if (kind == ExpressionKind.StoreGet) {
                current.valid = false
            } else {
                const condition = (
                    - !current.concurrent
                    - and (
                        - kind == ExpressionKind.Task
                        - or kind == ExpressionKind.AwaitTask
                        - or kind == ExpressionKind.CancelTask
                        - or kind == ExpressionKind.Parallel
                    )
                )

                if (condition) {
                    current.valid = false
                } else if (kind == ExpressionKind.Call) {
                    const payload =
                        integers.widen(
                            current.expressions.payloads[current.index]
                        )
                    const target =
                        integers.widen(
                            current.expressions.call_functions[payload]
                        )

                    current.valid =
                        (
                            - current.expressions.call_store_count[payload] == 0
                            - and (
                                - current.self_function != null
                                - and target == current.self_function
                                - or (
                                    target < current.limit &&
                                        current.allowed[target]
                                )
                            )
                        )
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
