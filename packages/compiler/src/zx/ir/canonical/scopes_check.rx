<Module>
    <Type from="scopes/model" as="Model" />

    <Args in={Model.Program} out={bool} />

    <Call module="./scopes/prepare" in={$in} />

    <Call
        module="./scopes/check"
        in={{
            program: $in,
            prepared: $ctx.prepare
        }}
    />

    <Return value={$ctx.check} />
</Module>
