<Module>
    <Type from="./contracts/model" as="Model" />

    <Args in={Model.Program} out={bool} />

    <Call module="./contract_tables_check" in={{ contracts: $in.contracts, max_offset: $in.max_offset }} />

    <Switch on={$ctx.contract_tables_check}>
        <Case value={true}>
            <Call fn="./contracts/predicates" in={$in} />

            <Return value={$ctx.predicates} />
        </Case>

        <Default>
            <Return value={false} />
        </Default>
    </Switch>
</Module>
