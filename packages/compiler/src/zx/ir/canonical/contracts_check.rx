<Module>
    <Type from="contracts/model" as="Model" />

    <Args in={Model.Program} out={bool} />

    <Call
        module="./contract_tables_check"
        in={{
            contracts: $in.contracts,
            max_offset: $in.max_offset
        }}
    />

    <If on={$ctx.contract_tables_check}>
        <Call fn="./contracts/predicates" in={$in} />

        <Return value={$ctx.predicates} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
