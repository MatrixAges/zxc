<Module>
    <Type from="./tasks/model" as="Model" />

    <Args in={Model.Program} out={bool} />

    <Call fn="./tasks/interface" in={$in} />

    <Switch on={$ctx.interface}>
        <Case value={true}>
            <Call fn="./tasks/references" in={$in} />

            <Switch on={$ctx.references}>
                <Case value={true}>
                    <Call fn="./tasks/consumption" in={$in} />

                    <Return value={$ctx.consumption} />
                </Case>

                <Default>
                    <Return value={false} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Return value={false} />
        </Default>
    </Switch>
</Module>
