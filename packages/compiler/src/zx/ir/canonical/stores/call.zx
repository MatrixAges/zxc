import integers from "std:integer"

import validate from "./validate"

import type { Stores } from "core/store_table/model"

export type Input = {
    available: Stores,
    required: Stores,
    slots: u32[],
    first: u64,
    count: u64,
    orchestration: bool
}

export type Output = bool

export default function (in: Input): Output {
    const condition = (
        - !validate(in.available)
        - or !validate(in.required)
        - or in.first > in.slots.length
        - or in.count > in.slots.length - in.first
        - or in.count != in.required.paths.length
        - or (in.count != 0 && !in.orchestration)
    )

    if (condition) {
        return false
    }

    return loop({
        available: in.available,
        required: in.required,
        slots: in.slots,
        first: in.first,
        count: in.count,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const id = current.slots[current.first + current.index]
            const index = integers.widen(id)

            if (index >= current.available.paths.length) {
                current.valid = false
            } else {
                const duplicate = loop({
                    slots: current.slots,
                    first: current.first,
                    limit: current.index,
                    index: 0,
                    id,
                    found: false
                }, {
                    while: previous =>
                        previous.index < previous.limit && !previous.found,
                    next: previous => {
                        previous.found =
                            previous.slots[previous.first + previous.index] ==
                            previous.id
                        previous.index += 1
                    }
                })

                current.valid = (
                    - !duplicate.found
                    - and current.available.types[index] ==
                        current.required.types[current.index]
                    - and current.available.paths[index] ==
                        current.required.paths[current.index]
                    - and (
                        !current.required.readable[current.index] ||
                            current.available.readable[index]
                    )
                    - and (
                        !current.required.writable[current.index] ||
                            current.available.writable[index]
                    )
                )
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
