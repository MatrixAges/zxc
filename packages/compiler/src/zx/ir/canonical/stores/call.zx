import integers from "std:integer"

import validate from "./validate"

import type { Stores } from "core/store_table/model"

export type Input = {
    available: Stores,
    required: Stores,
    slots: u32[],
    first: u64,
    count: u64,
    orchestration: bool
}

export type Output = bool

export default function (in: Input): Output {
    const not_length = in.count != in.required.paths.length

    const valid_count = in.count != 0 && !in.orchestration

    const condition = match {
        !validate(in.available) => true,
        !validate(in.required) => true,
        in.first > in.slots.length => true,
        in.count > in.slots.length - in.first => true,
        not_length => true,
        _ => valid_count
    }

    if (condition) {
        return false
    }

    return loop({
        available: in.available,
        required: in.required,
        slots: in.slots,
        first: in.first,
        count: in.count,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const id = current.slots[current.first + current.index]
            const index = integers.widen(id)

            if (index >= current.available.paths.length) {
                current.valid = false
            } else {
                const duplicate = loop({
                    slots: current.slots,
                    first: current.first,
                    limit: current.index,
                    index: 0,
                    id,
                    found: false
                }, {
                    while: previous =>
                        previous.index < previous.limit && !previous.found,
                    next: previous => {
                        previous.found =
                            previous.slots[previous.first + previous.index] ==
                            previous.id
                        previous.index += 1
                    }
                })

                const available = current.available
                const required = current.required
                const slot = current.index
                const readable = required.readable
                const writable = required.writable

                current.valid = match {
                    duplicate.found => false,
                    available.types[index] != required.types[slot] => false,
                    available.paths[index] != required.paths[slot] => false,
                    readable[slot] && !available.readable[index] => false,
                    _ => !writable[slot] || available.writable[index]
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
