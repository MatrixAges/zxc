import integers from "std:integer"
import { max_u32 } from "core/const"

import type { Stores } from "core/store_table/model"

export type Input = Stores

export type Output = bool

export default function (in: Input): Output {
    const count = in.paths.length

    return count <= integers.widen(max_u32) && in.types.length == count &&
        in.handles.length == count && in.readable.length == count &&
        in.writable.length == count
}
