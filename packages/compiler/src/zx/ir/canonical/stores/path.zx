export type Input = {
    paths: string[],
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const path = in.paths[in.index]

    const condition = (
        - path.length < 6
        - or path[0] != 115
        - or path[1] != 116
        - or path[2] != 111
        - or path[3] != 114
        - or path[4] != 101
        - or path[5] != 46
    )

    if (condition) {
        return false
    }

    const previous = loop({
        paths: in.paths,
        path,
        limit: in.index,
        index: 0,
        repeated: false
    }, {
        while: current => current.index < current.limit && !current.repeated,
        next: current => {
            const other = current.paths[current.index]

            const same = loop({
                left: current.path,
                right: other,
                index: 0,
                equal: current.path.length == other.length
            }, {
                while: bytes => bytes.equal && bytes.index < bytes.left.length,
                next: bytes => {
                    bytes.equal =
                        bytes.left[bytes.index] == bytes.right[bytes.index]
                    bytes.index += 1
                }
            })

            current.repeated = same.equal
            current.index += 1
        }
    })

    return !previous.repeated
}
