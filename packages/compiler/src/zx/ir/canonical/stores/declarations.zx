import integers from "std:integer"
import { Kind } from "core/type_table/model"

import contains from "../../../analysis/semantic/querying/execute"
import kind from "../../../analysis/semantic/types/kind"
import path from "./path"

import type { Table } from "core/type_table/model"

export type Input = {
    table: Table,
    paths: string[],
    slot_types: u32[],
    type_only: bool
}

export type Output = bool

export default function (in: Input): Output {
    const not_length = in.paths.length != in.slot_types.length

    const valid_type_only = in.type_only && in.paths.length != 0

    const condition = (
        - not_length
        - or (valid_type_only)
    )

    if (condition) {
        return false
    }

    return loop({
        table: in.table,
        paths: in.paths,
        slot_types: in.slot_types,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.paths.length,
        next: current => {
            const type_id = current.slot_types[current.index]
            const index = integers.widen(type_id)

            const not_length_2 = index < current.table.kinds.length

            const valid_path = match {
                !not_length_2 => false,
                kind(current.table.kinds[index]) != Kind.Object => false,
                _ => path({
                    paths: current.paths,
                    index: current.index
                })
            }

            current.valid = match {
                valid_path => !contains({
                    table: current.table,
                    id: type_id,
                    native_references: true
                }),
                _ => false
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
