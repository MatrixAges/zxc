import integers from "std:integer"
import { scalar_bool } from "core/type_table/const"

import assume from "../refinement/assume"
import bindPredicate from "../refinement/bind"
import restoreFacts from "../refinement/facts/restore"
import restoreActivity from "./activity/restore"
import block from "./block"
import branch from "./branch"
import callback from "./callback"
import declare from "./declare"
import destructure from "./destructure"
import expression from "./expression"
import { Declaration, Phase } from "./model"
import selection from "./selection"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const frame = in.frame
    const program = in.context.program
    const state = in.state

    if (frame.phase == Phase.Restore) {
        const activity = restoreActivity({
            activity: state.activity,
            mark: frame.a
        })

        return restoreFacts({
            facts: state.refinement.facts,
            mark: {
                nonnull: frame.b,
                captures: frame.c
            }
        })
            -> {
                state: {
                    ...state,
                    activity,
                    refinement: {
                        ...state.refinement,
                        facts: _
                    }
                },
                valid: true
            }
    }

    if (frame.phase == Phase.RestoreFacts) {
        return restoreFacts({
            facts: state.refinement.facts,
            mark: {
                nonnull: frame.a,
                captures: frame.b
            }
        })
            -> {
                state: {
                    ...state,
                    refinement: {
                        ...state.refinement,
                        facts: _
                    }
                },
                valid: true
            }
    }

    if (frame.phase == Phase.Assume) {
        return assume({
            state: state.refinement,
            expressions: program.body.expressions,
            condition: frame.a,
            truth: frame.b != 0
        })
            -> {
                state: {
                    ...state,
                    refinement: _
                },
                valid: true
            }
    }

    if (frame.phase == Phase.Declare || frame.phase == Phase.ScopeDeclare) {
        const ordinary = frame.phase == Phase.Declare
        const value = ordinary ? frame.b : frame.c

        const declared = declare({
            program,
            state,
            symbol: frame.a,
            type_id: program.body.expressions.types[value],
            owner: ordinary ? 0 : frame.b,
            mode: ordinary ? Declaration.Ordinary : Declaration.Scope
        })

        if (
            !declared.valid || program.body.expressions.types[value] != scalar_bool
        ) {
            return declared
        }

        return bindPredicate({
            facts: declared.state.refinement.facts,
            expressions: program.body.expressions,
            value,
            count: 1,
            err: integers.narrow(frame.a),
            result: null
        })
            -> {
                ...declared,
                state: {
                    ...declared.state,
                    refinement: {
                        ...declared.state.refinement,
                        facts: _
                    }
                }
            }
    }

    return match frame.phase {
        Phase.Block => block(in),
        Phase.BlockNext => block(in),
        Phase.Expression => expression(in),
        Phase.Destructure => destructure(in),
        Phase.Branch => branch(in),
        Phase.BranchPost => branch(in),
        Phase.Switch => selection(in),
        Phase.IterationCondition => callback(in),
        Phase.IterationBody => callback(in),
        Phase.Transform => callback(in),
        _ => {
            state,
            valid: false
        }
    }
}
