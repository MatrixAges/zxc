import integers from "std:integer"
import { BinaryOperator, ExpressionKind } from "core/expression_table/kinds"

import { Phase } from "./model"
import schedule from "./schedule"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const expressions = in.context.program.body.expressions
    const payload = integers.widen(expressions.payloads[in.frame.a])
    const facts = in.state.refinement.facts.nonnull.length
    const captures = in.state.refinement.facts.capture_errors.length
    const depth = in.frame.b + 1
    const flags = in.frame.c

    const restored = schedule({
        state: in.state,
        frame: {
            phase: Phase.RestoreFacts,
            a: facts,
            b: captures,
            c: 0
        }
    })

    if (expressions.kinds[in.frame.a] == ExpressionKind.Conditional) {
        const condition = integers.widen(expressions.conditional_conditions[payload])

        return schedule({
            state: restored,
            frame: {
                phase: Phase.Expression,
                a: integers.widen(expressions.conditional_no[payload]),
                b: depth,
                c: flags
            }
        })
            -> schedule({
                state: _,
                frame: {
                    phase: Phase.Assume,
                    a: condition,
                    b: 0,
                    c: 0
                }
            })
            -> schedule({
                state: _,
                frame: {
                    phase: Phase.RestoreFacts,
                    a: facts,
                    b: captures,
                    c: 0
                }
            })
            -> schedule({
                state: _,
                frame: {
                    phase: Phase.Expression,
                    a: integers.widen(expressions.conditional_yes[payload]),
                    b: depth,
                    c: flags
                }
            })
            -> schedule({
                state: _,
                frame: {
                    phase: Phase.Assume,
                    a: condition,
                    b: 1,
                    c: 0
                }
            })
            -> schedule({
                state: _,
                frame: {
                    phase: Phase.Expression,
                    a: condition,
                    b: depth,
                    c: flags
                }
            })
            -> {
                state: _,
                valid: true
            }
    }

    const left = integers.widen(expressions.binary_left[payload])
    const operator = expressions.binary_operators[payload]

    const right_value = schedule({
        state: restored,
        frame: {
            phase: Phase.Expression,
            a: integers.widen(expressions.binary_right[payload]),
            b: depth,
            c: flags
        }
    })

    return (operator == BinaryOperator.LogicalAnd ? 1 : 0)
        -> (operator == BinaryOperator.LogicalAnd || operator == BinaryOperator.LogicalOr
            ? schedule({
                state: right_value,
                frame: {
                    phase: Phase.Assume,
                    a: left,
                    b: _,
                    c: 0
                }
            })
            : right_value)
                -> schedule({
                    state: _,
                    frame: {
                        phase: Phase.Expression,
                        a: left,
                        b: depth,
                        c: flags
                    }
                })
                -> {
                    state: _,
                    valid: true
                }
}
