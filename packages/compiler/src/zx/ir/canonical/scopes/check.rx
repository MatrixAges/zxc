<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Context} out={bool} />

    <Call fn="./initialize" in={$in.program} />

    <If on={$ctx.initialize.valid}>
        <Call
            fn="./walk"
            in={{
                context: $in,
                state: $ctx.initialize.state
            }}
        />

        <If on={$ctx.walk.valid}>
            <Call fn="./declared" in={$ctx.walk.state.activity.declared} />

            <If on={$ctx.declared}>
                <Call fn="./returned" in={$in} />

                <Return value={$ctx.returned} />

                <Else>
                    <Return value={false} />
                </Else>
            </If>

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
