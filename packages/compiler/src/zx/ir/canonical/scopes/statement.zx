import integers from "std:integer"
import { StatementKind } from "core/control_table/model"

import { Phase } from "./model"
import parallel from "./parallel_statement"
import schedule from "./schedule"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const program = in.context.program
    const control = program.body.control
    const kind = control.statement_kinds[in.frame.a]
    const payload = integers.widen(control.statement_payloads[in.frame.a])

    if (kind == StatementKind.Parallel) {
        return parallel({ context: in.context, state: in.state, frame: { phase: Phase.BlockNext, a: payload, b: 0, c: 0 } })
    }

    if (kind == StatementKind.Result) {
        const value = control.results[payload]

        if (value == null) {
            return { state: in.state, valid: program.output_type == 0 }
        }

        const id = integers.widen(value)

        if (program.body.expressions.types[id] != program.output_type) {
            return { state: in.state, valid: false }
        }

        return { state: schedule({ state: in.state, frame: { phase: Phase.Expression, a: id, b: 0, c: 0 } }), valid: true }
    }

    if (kind == StatementKind.StoreSet) {
        const slot = integers.widen(control.setter_slots[payload])
        const value = integers.widen(control.setter_values[payload])

        if (!program.transaction || slot >= program.body.stores.paths.length || !program.body.stores.writable[slot] || program.body.expressions.types[value] != program.body.stores.types[slot]) {
            return { state: in.state, valid: false }
        }

        return { state: schedule({ state: in.state, frame: { phase: Phase.Expression, a: value, b: 0, c: 0 } }), valid: true }
    }

    if (kind == StatementKind.Branch && program.body.expressions.types[integers.widen(control.branch_conditions[payload])] != 1) {
        return { state: in.state, valid: false }
    }

    const continuation = match kind {
        StatementKind.Constant => schedule({ state: in.state, frame: { phase: Phase.Declare, a: integers.widen(control.constant_symbols[payload]), b: integers.widen(control.constant_values[payload]), c: 0 } }),
        StatementKind.Destructure => schedule({ state: in.state, frame: { phase: Phase.Destructure, a: payload, b: 0, c: 0 } }),
        StatementKind.Branch => schedule({ state: in.state, frame: { phase: Phase.Branch, a: payload, b: in.frame.b, c: 0 } }),
        StatementKind.Switch => schedule({ state: in.state, frame: { phase: Phase.Switch, a: payload, b: in.frame.b, c: 0 } }),
        _ => in.state
    }

    const value = match kind {
        StatementKind.Constant => control.constant_values[payload],
        StatementKind.Destructure => control.destructure_values[payload],
        StatementKind.Branch => control.branch_conditions[payload],
        StatementKind.Switch => control.selection_subjects[payload],
        _ => control.evaluations[payload]
    }

    return { state: schedule({ state: continuation, frame: { phase: Phase.Expression, a: integers.widen(value), b: 0, c: 0 } }), valid: true }
}
