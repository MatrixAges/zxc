import integers from "std:integer"

import restore from "../refinement/facts/restore"
import { Phase } from "./model"
import schedule from "./schedule"

import type { Result, State, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const control = in.context.program.body.control
    const payload = in.frame.a
    const condition = integers.widen(control.branch_conditions[payload])

    if (in.frame.phase == Phase.BranchPost) {
        const restored: State = restore({
            facts: in.state.refinement.facts,
            mark: {
                nonnull: in.frame.b,
                captures: in.frame.c
            }
        })
            -> {
                ...in.state,
                refinement: {
                    ...in.state.refinement,
                    facts: _
                }
            }

        const yes =
            in.context.prepared.returns[integers.widen(
                control.branch_no[payload]
            )]
        ? schedule({
            state: restored,
            frame: {
                phase: Phase.Assume,
                a: condition,
                b: 1,
                c: 0
            }
        })
        : restored

        return (in.context.prepared
            .returns[integers.widen(
                control.branch_yes[payload]
            )]
            ? schedule({
                state: yes,
                frame: {
                    phase: Phase.Assume,
                    a: condition,
                    b: 0,
                    c: 0
                }
            })
            : yes)
                -> {
                    state: _,
                    valid: true
                }
    }

    const facts = in.state.refinement.facts.nonnull.length
    const captures = in.state.refinement.facts.capture_errors.length

    return schedule({
        state: in.state,
        frame: {
            phase: Phase.BranchPost,
            a: payload,
            b: facts,
            c: captures
        }
    })
        -> schedule({
            state: _,
            frame: {
                phase: Phase.Block,
                a: integers.widen(control.branch_no[payload]),
                b: in.frame.b + 1,
                c: 0
            }
        })
        -> schedule({
            state: _,
            frame: {
                phase: Phase.Assume,
                a: condition,
                b: 0,
                c: 0
            }
        })
        -> schedule({
            state: _,
            frame: {
                phase: Phase.RestoreFacts,
                a: facts,
                b: captures,
                c: 0
            }
        })
        -> schedule({
            state: _,
            frame: {
                phase: Phase.Block,
                a: integers.widen(control.branch_yes[payload]),
                b: in.frame.b + 1,
                c: 0
            }
        })
        -> schedule({
            state: _,
            frame: {
                phase: Phase.Assume,
                a: condition,
                b: 1,
                c: 0
            }
        })
        -> {
            state: _,
            valid: true
        }
}
