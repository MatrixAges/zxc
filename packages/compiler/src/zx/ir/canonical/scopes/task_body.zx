import integers from "std:integer"

import set from "./activity/set"
import clear from "./clear"
import { Phase } from "./model"
import schedule from "./schedule"
import capturesActive from "./task_captures"

import type { Result, State, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const expressions = in.context.program.body.expressions
    const payload = integers.widen(expressions.payloads[in.frame.a])
    const first = integers.widen(expressions.task_capture_first[payload])
    const count = integers.widen(expressions.task_capture_count[payload])

    const valid = capturesActive({ active: in.state.activity.active, symbols: expressions.task_captures, first: first, count: count })

    if (!valid) {
        return { state: in.state, valid: false }
    }

    const restoration = schedule({ state: in.state, frame: { phase: Phase.Restore, a: in.state.activity.changed_symbols.length, b: in.state.refinement.facts.nonnull.length, c: in.state.refinement.facts.capture_errors.length } })
    const cleared = clear(restoration.activity)

    const activity = loop({ activity: cleared, expressions: expressions, first: first, count: count, index: 0 }, {
        while: current => current.index < current.count,
        next: current => {
            current.activity = set({ activity: current.activity, symbol: integers.widen(current.expressions.task_captures[current.first + current.index]), value: true })
            current.index += 1
        }
    }).activity

    const captured: State = { ...restoration, activity: activity }
    const state = schedule({ state: captured, frame: { phase: Phase.Expression, a: integers.widen(expressions.task_bodies[payload]), b: in.frame.b + 1, c: in.frame.c == 1 || in.frame.c == 3 ? 3 : 2 } })

    return { state: state, valid: true }
}
