import state from "zig:flow_state"
import integers from "zig:integers"

import { Phase } from "./model"
import schedule from "./schedule"

import type { Program } from "./model"

export type Input = Program

export type Output = bool

export default function (in: Input): Output {
    if (in.body.symbols.names.length == 0) {
        return false
    }

    state.setDeclared(in.writer, 0)
    state.setActive(in.writer, 0, true)

    const root = in.body.root

    if (root != null) {
        schedule({ writer: in.writer, frame: { phase: Phase.Block, a: integers.widen(root), b: 0, c: 0 } })
    }

    return true
}
