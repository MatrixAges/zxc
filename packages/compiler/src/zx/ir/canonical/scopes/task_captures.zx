import integers from "std:integer"

export type Input = { active: bool[], symbols: u32[], first: u64, count: u64 }

export type Output = bool

export default function (in: Input): Output {
    return loop({ active: in.active, symbols: in.symbols, first: in.first, count: in.count, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            current.valid = current.active[integers.widen(current.symbols[current.first + current.index])]
            current.index += 1
        }
    }).valid
}
