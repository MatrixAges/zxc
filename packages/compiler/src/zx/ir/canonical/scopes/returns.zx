import integers from "zig:integers"

import { StatementKind } from "../control/model"
import selectionReturns from "../control/selection_returns"

import type { Context } from "./model"

export type Input = { context: Context, statement: u64 }

export type Output = bool

export default function (in: Input): Output {
    const control = in.context.program.body.control
    const payload = integers.widen(control.statement_payloads[in.statement])

    return match control.statement_kinds[in.statement] {
        StatementKind.Result => true,
        StatementKind.Branch => in.context.prepared.returns[integers.widen(control.branch_yes[payload])] && in.context.prepared.returns[integers.widen(control.branch_no[payload])],
        StatementKind.Switch => selectionReturns({ control: control, selection: payload, returns: in.context.prepared.returns }),
        _ => false
    }
}
