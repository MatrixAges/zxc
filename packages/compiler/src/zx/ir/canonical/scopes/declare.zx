import set from "./activity/set"
import { Declaration } from "./model"

import type { Program, Result, State } from "./model"

export type Input = {
    program: Program,
    state: State,
    symbol: u64,
    type_id: u32,
    owner: u64,
    mode: Declaration
}

export type Output = Result

export default function (in: Input): Output {
    if (in.symbol >= in.program.body.symbols.names.length) {
        return {
            state: in.state,
            valid: false
        }
    }

    const type_id = in.program.body.symbols.types[in.symbol]
    const activity = in.state.activity

    if (in.mode == Declaration.Ordinary) {
        const condition = (
            - activity.declared[in.symbol]
            - or type_id != in.type_id
            - or type_id == 0
        )

        if (condition) {
            return {
                state: in.state,
                valid: false
            }
        }
    } else {
        const condition_2 = match {
            activity.active[in.symbol] => true,
            !activity.declared[in.symbol] => false,
            _ => activity.owners[in.symbol] != in.owner + 1
        }

        if (condition_2) {
            return {
                state: in.state,
                valid: false
            }
        }

        if (in.mode == Declaration.Scope && type_id == 0) {
            return {
                state: in.state,
                valid: false
            }
        }
    }

    const active = set({
        activity,
        symbol: in.symbol,
        value: true
    })

    return {
        state: {
            activity: {
                active: active.active,
                declared: active.declared.with(in.symbol, true),
                owners: match {
                    in.mode == Declaration.Ordinary => active.owners,
                    _ => active.owners.with(
                        in.symbol,
                        in.owner + 1
                    )
                },
                changed_symbols: active.changed_symbols,
                changed_values: active.changed_values
            },
            refinement: in.state.refinement,
            frames: in.state.frames
        },
        valid: true
    }
}
