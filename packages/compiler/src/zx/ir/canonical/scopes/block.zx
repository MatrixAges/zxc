import integers from "std:integer"
import { max_nesting_depth } from "core/const"

import { Phase } from "./model"
import returns from "./returns"
import schedule from "./schedule"
import statement from "./statement"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const frame = in.frame

    const control = in.context.program
        -> _.body.control

    if (frame.phase == Phase.Block) {
        if (frame.b > max_nesting_depth) {
            return {
                state: in.state,
                valid: false
            }
        }

        return schedule({
            state: in.state,
            frame: {
                phase: Phase.Restore,
                a: in.state.activity.changed_symbols.length,
                b: in.state.refinement.facts.nonnull.length,
                c: in.state.refinement.facts.capture_errors.length
            }
        })
            -> schedule({
                state: _,
                frame: {
                    phase: Phase.BlockNext,
                    a: frame.a,
                    b: 0,
                    c: frame.b
                }
            })
            -> {
                state: _,
                valid: true
            }
    }

    const count = integers.widen(control.block_count[frame.a])

    if (frame.b == count) {
        return {
            state: in.state,
            valid: true
        }
    }

    const first = integers.widen(control.block_first[frame.a])

    if (frame.b != 0 && returns({
        context: in.context,
        statement: first + frame.b - 1
    })) {
        return {
            state: in.state,
            valid: false
        }
    }

    return schedule({
        state: in.state,
        frame: {
            phase: Phase.BlockNext,
            a: frame.a,
            b: frame.b + 1,
            c: frame.c
        }
    })
        -> statement({
            context: in.context,
            state: _,
            frame: {
                phase: Phase.BlockNext,
                a: first + frame.b,
                b: frame.c,
                c: 0
            }
        })
}
