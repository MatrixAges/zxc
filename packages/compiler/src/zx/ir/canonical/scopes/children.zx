import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import { Phase } from "./model"
import schedule from "./schedule"
import sequence from "./sequence"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const expressions = in.context.program.body.expressions
    const kind = expressions.kinds[in.frame.a]
    const payload = integers.widen(expressions.payloads[in.frame.a])
    const depth = in.frame.b + 1
    const flags = in.frame.c

    if (kind == ExpressionKind.List || kind == ExpressionKind.Tuple || kind == ExpressionKind.Template) {
        return { state: sequence({ state: in.state, values: expressions.sequence_items, first: integers.widen(expressions.sequence_first[payload]), count: integers.widen(expressions.sequence_count[payload]), depth: depth, flags: flags }), valid: true }
    }

    if (kind == ExpressionKind.Parallel) {
        return { state: sequence({ state: in.state, values: expressions.parallel_tasks, first: integers.widen(expressions.parallel_first[payload]), count: integers.widen(expressions.parallel_count[payload]), depth: depth, flags: flags }), valid: true }
    }

    if (kind == ExpressionKind.Object) {
        const fields = sequence({ state: in.state, values: expressions.object_field_values, first: integers.widen(expressions.object_first[payload]), count: integers.widen(expressions.object_count[payload]), depth: depth, flags: flags })
        const evaluation = sequence({ state: fields, values: expressions.object_evaluation_values, first: integers.widen(expressions.object_evaluation_first[payload]), count: integers.widen(expressions.object_evaluation_count[payload]), depth: depth, flags: flags })

        return { state: evaluation, valid: true }
    }

    const arguments = kind == ExpressionKind.ListOperation
    ? sequence({ state: in.state, values: expressions.collection_arguments, first: integers.widen(expressions.collection_first[payload]), count: integers.widen(expressions.collection_count[payload]), depth: depth, flags: flags })
    : in.state

    const value = kind == ExpressionKind.ListUpdate
    ? schedule({ state: arguments, frame: { phase: Phase.Expression, a: integers.widen(expressions.update_values[payload]), b: depth, c: flags } })
    : arguments

    const index = match kind {
        ExpressionKind.ListUpdate => integers.widen(expressions.update_indices[payload]),
        ExpressionKind.Index => integers.widen(expressions.index_values[payload]),
        _ => 0
    }

    const indexed = kind == ExpressionKind.ListUpdate || kind == ExpressionKind.Index
    ? schedule({ state: value, frame: { phase: Phase.Expression, a: index, b: depth, c: flags } })
    : value

    const child = match kind {
        ExpressionKind.Field => expressions.projection_targets[payload],
        ExpressionKind.TupleField => expressions.projection_targets[payload],
        ExpressionKind.Index => expressions.index_targets[payload],
        ExpressionKind.Length => expressions.lengths[payload],
        ExpressionKind.Some => expressions.some[payload],
        ExpressionKind.Capture => expressions.captures[payload],
        ExpressionKind.AwaitTask => expressions.awaits[payload],
        ExpressionKind.CancelTask => expressions.cancellations[payload],
        ExpressionKind.OptionalValue => expressions.optional_values[payload],
        ExpressionKind.Unary => expressions.unary_operands[payload],
        ExpressionKind.ListOperation => expressions.collection_targets[payload],
        ExpressionKind.ListUpdate => expressions.update_targets[payload],
        _ => expressions.call_arguments[payload]
    }

    return { state: schedule({ state: indexed, frame: { phase: Phase.Expression, a: integers.widen(child), b: depth, c: flags } }), valid: true }
}
