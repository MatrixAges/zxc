import control from "../control/validate"
import expressions from "../expressions/validation/validate"
import stores from "../stores/validate"
import symbols from "./symbols"
import tree from "./tree"

import type { Body } from "../body_model"

export type Input = { body: Body, max_offset: u64 }

export type Output = bool

export default function (in: Input): Output {
    if (!stores(in.body.stores)) {
        return false
    }

    if (!symbols({ symbols: in.body.symbols, max_offset: in.max_offset })) {
        return false
    }

    if (!expressions({ table: in.body.expressions, max_offset: in.max_offset })) {
        return false
    }

    if (!control(in.body.control)) {
        return false
    }

    return tree({ control: in.body.control, root: in.body.root })
}
