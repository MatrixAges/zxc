import integers from "std:integer"
import { max_u32 } from "core/const"

import offsets from "../expressions/validation/offsets"

import type { Symbols } from "core/symbol_table/model"

export type Input = {
    symbols: Symbols,
    max_offset: u64
}

export type Output = bool

export default function (in: Input): Output {
    const index_limit = integers.widen(max_u32)

    const count = in.symbols.names.length

    const not_length = count != in.symbols.types.length
    const not_length_2 = count != in.symbols.ownership.length
    const not_length_3 = count != in.symbols.span_start.length
    const not_length_4 = count != in.symbols.span_end.length

    const condition = (
        - count > index_limit
        - or not_length
        - or not_length_2
        - or not_length_3
        - or not_length_4
    )

    if (condition) {
        return false
    }

    return offsets({
        starts: in.symbols.span_start,
        ends: in.symbols.span_end,
        max_offset: in.max_offset
    })
}
