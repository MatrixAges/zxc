import offsets from "../expressions/validation/offsets"

import type { Symbols } from "core/symbol_table/model"

export type Input = { symbols: Symbols, max_offset: u64 }

export type Output = bool

export default function (in: Input): Output {
    const count = in.symbols.names.length

    if (count > 4294967295 || count != in.symbols.types.length || count != in.symbols.ownership.length || count != in.symbols.span_start.length || count != in.symbols.span_end.length) {
        return false
    }

    return offsets({ starts: in.symbols.span_start, ends: in.symbols.span_end, max_offset: in.max_offset })
}
