<Module>
    <Type from="references/control" as="Control" />

    <Args
        in={{
            body: Control.Input,
            max_offset: u64
        }}
        out={bool}
    />

    <Task name="stores" out={$ctx.validate}>
        <Call fn="../stores/validate" in={$in.body.stores} />
    </Task>

    <If on={!$ctx.task.stores}>
        <Return value={false} />
    </If>

    <Call
        fn="./symbols"
        in={{
            symbols: $in.body.symbols,
            max_offset: $in.max_offset
        }}
    />

    <If on={!$ctx.symbols}>
        <Return value={false} />
    </If>

    <Task name="expressions" out={$ctx.validate}>
        <Call
            fn="../expressions/validation/validate"
            in={{
                table: $in.body.expressions,
                max_offset: $in.max_offset
            }}
        />
    </Task>

    <If on={!$ctx.task.expressions}>
        <Return value={false} />
    </If>

    <Call
        module="../control/structure"
        in={{
            control: $in.body.control,
            root: $in.body.root
        }}
    />

    <Return value={$ctx.structure} />
</Module>
