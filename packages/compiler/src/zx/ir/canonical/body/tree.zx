import integers from "std:integer"
import { max_nesting_depth, max_u32 } from "core/const"
import { StatementKind } from "core/control_table/model"

import type { Control } from "core/control_table/model"

export type Input = {
    control: Control,
    root?: u32
}

export type Output = bool

export default function (in: Input): Output {
    const block_id = in.root

    if (block_id == null) {
        return in.control.block_first.length == 0
    }

    const root = integers.widen(block_id)

    const blocks = in.control.block_first

    if (root >= blocks.length) {
        return false
    }

    if (blocks.length == 1) {
        return true
    }

    const depths: u32[] = blocks.map(value => 0)[0]

    const checked = loop({
        control: in.control,
        depths,
        block: 0,
        index: 0,
        edge: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.block < current.control.block_first.length,
        next: current => {
            if (
                current.index ==
                    integers.widen(
                        current.control.block_count[current.block]
                    )
            ) {
                current.block += 1
                current.index = 0
            } else {
                const statement =
                    integers.widen(
                        current.control.block_first[current.block]
                    ) + current.index
                const kind = current.control.statement_kinds[statement]
                const payload =
                    integers.widen(
                        current.control.statement_payloads[statement]
                    )
                const count = match kind {
                    StatementKind.Branch => 2,
                    StatementKind.Switch =>
                        integers.widen(
                            current.control.selection_count[payload]
                        ),
                    _ => 0
                }

                if (current.edge == count) {
                    current.index += 1
                    current.edge = 0
                } else {
                    const child = match kind {
                        StatementKind.Branch =>
                            integers.widen(
                                match {
                                    current.edge ==
                                        0 => current.control.branch_yes[payload],
                                    _ => current.control.branch_no[payload]
                                }
                            ),
                        _ =>
                            integers.widen(
                                current.control
                                    .case_bodies[integers.widen(
                                        current.control.selection_first[payload]
                                    ) + current.edge]
                            )
                    }
                    const child_depth = current.depths[child]
                    const depth = integers.widen(child_depth) + 1

                    current.valid = child != root && depth <= max_nesting_depth

                    if (current.valid) {
                        current.depths[child] = max_u32

                        if (
                            depth > integers.widen(current.depths[current.block])
                        ) {
                            current.depths[current.block] = integers.narrow(depth)
                        }
                    }

                    current.edge += 1
                }
            }
        }
    })

    // Children precede parents. Once attached, an earlier block only needs its marker.
    return checked.valid && checked.depths.every(
        (depth, index) => index == root || depth == max_u32
    )
}
