import optional from "./optional"
import required from "./required"

import type { Body } from "core/ir/body"

export type Input = Body

export type Output = bool

export default function (in: Input): Output {
    if (!required({ values: in.control.evaluations, count: in.expressions.kinds.length })) {
        return false
    }

    if (!required({ values: in.control.constant_values, count: in.expressions.kinds.length })) {
        return false
    }

    if (!required({ values: in.control.parallel_values, count: in.expressions.kinds.length })) {
        return false
    }

    if (!required({ values: in.control.destructure_values, count: in.expressions.kinds.length })) {
        return false
    }

    if (!required({ values: in.control.branch_conditions, count: in.expressions.kinds.length })) {
        return false
    }

    if (!required({ values: in.control.selection_subjects, count: in.expressions.kinds.length })) {
        return false
    }

    if (!required({ values: in.control.setter_values, count: in.expressions.kinds.length })) {
        return false
    }

    if (!optional({ values: in.control.case_values, count: in.expressions.kinds.length })) {
        return false
    }

    if (!optional({ values: in.control.results, count: in.expressions.kinds.length })) {
        return false
    }

    if (!required({ values: in.control.constant_symbols, count: in.symbols.names.length })) {
        return false
    }

    if (!optional({ values: in.control.parallel_symbols, count: in.symbols.names.length })) {
        return false
    }

    if (!optional({ values: in.control.destructure_symbols, count: in.symbols.names.length })) {
        return false
    }

    return true
}
