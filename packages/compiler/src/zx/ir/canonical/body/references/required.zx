import integers from "std:integer"

export type Input = { values: u32[], count: u64 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ input: in, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.input.values.length,
        next: current => {
            current.valid = integers.widen(current.input.values[current.index]) < current.input.count
            current.index += 1
        }
    })

    return result.valid
}
