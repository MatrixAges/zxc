<Module>
    <Type from="native/model" as="Model" />

    <Args in={Model.Context} out={bool} />

    <Call fn="./native/structure" in={$in.modules} />

    <If on={$ctx.structure}>
        <Call module="./native/declarations_check" in={$in.modules} />

        <If on={$ctx.declarations_check}>
            <Call module="./native/bindings_check" in={$in} />

            <If on={$ctx.bindings_check}>
                <Call fn="./native/owners" in={$in} />

                <Return value={$ctx.owners} />

                <Else>
                    <Return value={false} />
                </Else>
            </If>

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
