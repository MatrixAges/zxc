import complete from "./payloads/complete"
import step from "./payloads/step"

import type { Expressions } from "core/expression_table/model"
import type { State } from "./payloads/model"

export type Input = Expressions

export type Output = bool

export default function (in: Input): Output {
    const initial: State = {
        table: in,
        index: 0,
        valid: true,
        integers: 0,
        negative_integers: 0,
        floats: 0,
        strings: 0,
        booleans: 0,
        some: 0,
        captures: 0,
        tasks: 0,
        awaits: 0,
        cancellations: 0,
        parallels: 0,
        optional_values: 0,
        enumerations: 0,
        errors: 0,
        references: 0,
        stores: 0,
        projections: 0,
        indices: 0,
        lengths: 0,
        sequences: 0,
        collections: 0,
        transforms: 0,
        scopes: 0,
        iterations: 0,
        updates: 0,
        calls: 0,
        unary: 0,
        binary: 0,
        conditionals: 0,
        matches: 0,
        objects: 0,
    }

    const result = loop(initial, {
        while: current => current.valid && current.index < current.table.kinds.length,
        next: current => {
            current = step(current)
            current.index += 1
        }
    })

    return complete(result)
}
