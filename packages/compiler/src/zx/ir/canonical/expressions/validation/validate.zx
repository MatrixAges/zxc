import offsets from "./offsets"
import payloads from "./payloads"
import ranges from "./ranges"
import widths from "./widths"

import type { Expressions } from "../model"

export type Input = { table: Expressions, max_offset: u64 }

export type Output = bool

export default function (in: Input): Output {
    if (!widths(in.table)) {
        return false
    }

    if (!ranges(in.table) || !payloads(in.table)) {
        return false
    }

    return offsets({ starts: in.table.span_start, ends: in.table.span_end, max_offset: in.max_offset })
}
