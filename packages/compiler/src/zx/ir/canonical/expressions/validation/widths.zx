import integers from "std:integer"
import { max_u32 } from "core/const"

import type { Expressions } from "core/expression_table/model"

export type Input = Expressions

export type Output = bool

export default function (in: Input): Output {
    if (in.kinds.length > integers.widen(max_u32)) {
        return false
    }

    const condition = (
        - in.kinds.length != in.types.length
        - or in.kinds.length != in.span_start.length
        - or in.kinds.length != in.span_end.length
        - or in.kinds.length != in.payloads.length
    )

    if (condition) {
        return false
    }

    if (in.sequence_first.length != in.sequence_count.length) {
        return false
    }

    if (in.projection_targets.length != in.projection_indices.length) {
        return false
    }

    if (in.index_targets.length != in.index_values.length) {
        return false
    }

    if (
        in.task_bodies.length != in.task_capture_first.length ||
            in.task_bodies.length != in.task_capture_count.length
    ) {
        return false
    }

    if (in.parallel_first.length != in.parallel_count.length) {
        return false
    }

    if (in.parallel_tasks.length != in.parallel_fields.length) {
        return false
    }

    const condition_2 = (
        - in.collection_kinds.length != in.collection_targets.length
        - or in.collection_kinds.length != in.collection_first.length
        - or in.collection_kinds.length != in.collection_count.length
    )

    if (condition_2) {
        return false
    }

    const condition_3 = (
        - in.transform_kinds.length != in.transform_targets.length
        - or in.transform_kinds.length != in.transform_bodies.length
        - or in.transform_kinds.length != in.transform_initials.length
        - or in.transform_kinds.length != in.transform_first.length
        - or in.transform_kinds.length != in.transform_count.length
    )

    if (condition_3) {
        return false
    }

    if (
        in.scope_results.length != in.scope_first.length ||
            in.scope_results.length != in.scope_count.length
    ) {
        return false
    }

    if (
        in.scope_symbols.length != in.scope_values.length ||
            in.scope_symbols.length != in.scope_borrows.length
    ) {
        return false
    }

    const condition_4 = (
        - in.iteration_initials.length != in.iteration_condition_parameters.length
        - or in.iteration_initials.length != in.iteration_parameters.length
        - or in.iteration_initials.length != in.iteration_environment_symbols.length
        - or in.iteration_initials.length != in.iteration_conditions.length
        - or in.iteration_initials.length != in.iteration_bodies.length
        - or in.iteration_initials.length != in.iteration_postconditions.length
    )

    if (condition_4) {
        return false
    }

    if (
        in.update_targets.length != in.update_indices.length ||
            in.update_targets.length != in.update_values.length
    ) {
        return false
    }

    const condition_5 = (
        - in.call_functions.length != in.call_arguments.length
        - or in.call_functions.length != in.call_store_first.length
        - or in.call_functions.length != in.call_store_count.length
    )

    if (condition_5) {
        return false
    }

    if (in.unary_operators.length != in.unary_operands.length) {
        return false
    }

    if (
        in.binary_operators.length != in.binary_left.length ||
            in.binary_operators.length != in.binary_right.length
    ) {
        return false
    }

    if (
        in.conditional_conditions.length != in.conditional_yes.length ||
            in.conditional_conditions.length != in.conditional_no.length
    ) {
        return false
    }

    const condition_6 = (
        - in.match_subjects.length != in.match_fallbacks.length
        - or in.match_subjects.length != in.match_first.length
        - or in.match_subjects.length != in.match_count.length
    )

    if (condition_6) {
        return false
    }

    if (in.match_conditions.length != in.match_results.length) {
        return false
    }

    const condition_7 = (
        - in.object_first.length != in.object_count.length
        - or in.object_first.length != in.object_evaluation_first.length
        - or in.object_first.length != in.object_evaluation_count.length
    )

    if (condition_7) {
        return false
    }

    if (in.object_field_indices.length != in.object_field_values.length) {
        return false
    }

    return true
}
