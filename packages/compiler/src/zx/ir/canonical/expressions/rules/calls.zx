import integers from "std:integer"

import call from "../../stores/call"
import typed from "./typed"

import type { Check } from "./model"

export type Input = Check

export type Output = bool

export default function (in: Input): Output {
    const context = in.context
    const expressions = context.expressions
    const function_index = integers.widen(expressions.call_functions[in.payload])

    const not_length = function_index < context.functions.input_types.length

    if (!not_length) {
        return false
    }

    if (in.type_id != context.functions.output_types[function_index]) {
        return false
    }

    const argument_valid = typed({
        expressions,
        index: context.index,
        id: expressions.call_arguments[in.payload],
        type_id: context.functions.input_types[function_index]
    })

    if (!argument_valid) {
        return false
    }

    return call({
        available: context.stores,
        required: context.functions.stores[function_index],
        slots: expressions.call_stores,
        first: integers.widen(expressions.call_store_first[in.payload]),
        count: integers.widen(expressions.call_store_count[in.payload]),
        orchestration: context.orchestration
    })
}
