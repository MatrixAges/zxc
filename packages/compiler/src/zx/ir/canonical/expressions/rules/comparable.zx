import integers from "std:integer"
import { Kind } from "core/type_table/model"

import kind from "../../../../analysis/semantic/types/kind"

import type { Table } from "core/type_table/model"

export type Input = { table: Table, type_id: u32 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ table: in.table, type_id: in.type_id }, {
        while: current => kind(current.table.kinds[integers.widen(current.type_id)]) == Kind.Optional,
        next: current => {
            current.type_id = current.table.first[integers.widen(current.type_id)]
        }
    })

    const target = kind(in.table.kinds[integers.widen(result.type_id)])

    return (target == Kind.Scalar && result.type_id != 0) || target == Kind.Enumeration || target == Kind.ErrorSet
}
