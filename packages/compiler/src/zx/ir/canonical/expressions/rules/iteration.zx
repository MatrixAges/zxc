import integers from "std:integer"
import { type_id_void, type_id_bool, type_id_u64 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import typed from "./typed"

import type { Check } from "./model"

export type Input = Check

export type Output = bool

export default function (in: Input): Output {
    const context = in.context
    const expressions = context.expressions

    if (in.kind == ExpressionKind.ListUpdate) {
        if (in.target != Kind.List) {
            return false
        }

        const valid_target = typed({
            expressions,
            index: context.index,
            id: expressions.update_targets[in.payload],
            type_id: in.type_id
        })

        if (!valid_target) {
            return false
        }

        const valid_index = typed({
            expressions,
            index: context.index,
            id: expressions.update_indices[in.payload],
            type_id: type_id_u64
        })

        if (!valid_index) {
            return false
        }

        return typed({
            expressions,
            index: context.index,
            id: expressions.update_values[in.payload],
            type_id: context.table.first[integers.widen(in.type_id)]
        })
    }

    const parameter = integers.widen(expressions.iteration_parameters[in.payload])

    const condition_parameter =
        integers.widen(
            expressions.iteration_condition_parameters[in.payload]
        )

    const different_parameter = parameter != condition_parameter

    const not_length = parameter < context.symbols.types.length
    const not_length_2 = condition_parameter < context.symbols.types.length

    if (in.type_id == type_id_void) {
        return false
    }

    const valid_initial = typed({
        expressions,
        index: context.index,
        id: expressions.iteration_initials[in.payload],
        type_id: in.type_id
    })

    if (!valid_initial) {
        return false
    }

    const valid_body = typed({
        expressions,
        index: context.index,
        id: expressions.iteration_bodies[in.payload],
        type_id: in.type_id
    })

    if (!valid_body) {
        return false
    }

    const valid_condition = typed({
        expressions,
        index: context.index,
        id: expressions.iteration_conditions[in.payload],
        type_id: type_id_bool
    })

    const valid_parameters = (
        - valid_condition
        - and different_parameter
        - and not_length
        - and not_length_2
    )

    if (!valid_parameters) {
        return false
    }

    return context.symbols.types[parameter] == in.type_id &&
        context.symbols.types[condition_parameter] == in.type_id
}
