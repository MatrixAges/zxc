import integers from "zig:integers"
import { ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import typed from "./typed"

import type { Check } from "./model"

export type Input = Check

export type Output = bool

export default function (in: Input): Output {
    const context = in.context
    const expressions = context.expressions

    if (in.kind == ExpressionKind.ListUpdate) {
        return in.target == Kind.List && typed({ expressions: expressions, index: context.index, id: expressions.update_targets[in.payload], type_id: in.type_id }) &&
            typed({ expressions: expressions, index: context.index, id: expressions.update_indices[in.payload], type_id: 5 }) &&
            typed({ expressions: expressions, index: context.index, id: expressions.update_values[in.payload], type_id: context.table.first[integers.widen(in.type_id)] })
    }

    const parameter = integers.widen(expressions.iteration_parameters[in.payload])
    const condition_parameter = integers.widen(expressions.iteration_condition_parameters[in.payload])

    return in.type_id != 0 && typed({ expressions: expressions, index: context.index, id: expressions.iteration_initials[in.payload], type_id: in.type_id }) &&
        typed({ expressions: expressions, index: context.index, id: expressions.iteration_bodies[in.payload], type_id: in.type_id }) &&
        typed({ expressions: expressions, index: context.index, id: expressions.iteration_conditions[in.payload], type_id: 1 }) &&
        parameter != condition_parameter && parameter < context.symbols.types.length && condition_parameter < context.symbols.types.length &&
        context.symbols.types[parameter] == in.type_id && context.symbols.types[condition_parameter] == in.type_id
}
