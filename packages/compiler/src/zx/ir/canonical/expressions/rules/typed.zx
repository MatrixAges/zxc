import integers from "zig:integers"

import type { Expressions } from "core/expression_table/model"

export type Input = { expressions: Expressions, index: u64, id: u32, type_id: u32 }

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.id)

    return index < in.index && in.expressions.types[index] == in.type_id
}
