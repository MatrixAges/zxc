import integers from "std:integer"
import { type_id_u8, type_id_u64, type_id_string, type_id_void } from "core/const"
import { CollectionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import kind from "../../../../analysis/semantic/types/kind"
import { Numeric } from "./model"
import numeric from "./numeric"
import typed from "./typed"

import type { Check } from "./model"

export type Input = Check

export type Output = bool

export default function (in: Input): Output {
    const context = in.context
    const expressions = context.expressions
    const table = context.table
    const source_index = integers.widen(expressions.collection_targets[in.payload])

    if (source_index >= context.index) {
        return false
    }

    const operation = expressions.collection_kinds[in.payload]
    const source_id = expressions.types[source_index]
    const source_type = integers.widen(source_id)
    const count = integers.widen(expressions.collection_count[in.payload])

    if (kind(table.kinds[source_type]) != Kind.List) {
        return false
    }

    if (operation == CollectionKind.Slice) {
        return count == 0 && in.type_id == source_id
    }

    const type_index = integers.widen(in.type_id)

    const condition = (
        - in.target != Kind.Tuple
        - or table.second[type_index] != 2
    )

    if (condition) {
        return false
    }

    const first = integers.widen(table.first[type_index])

    if (table.children[first] != source_id) {
        return false
    }

    const expected = match operation {
        CollectionKind.Push => 1,
        CollectionKind.Concat => 1,
        CollectionKind.Splice => 3,
        _ => 0
    }

    if (count != expected) {
        return false
    }

    const element = table.first[source_type]

    const arguments = loop({
        context,
        first: integers.widen(expressions.collection_first[in.payload]),
        count,
        operation,
        element,
        source: source_id,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const hint = match current.operation {
                CollectionKind.Push => current.element,
                CollectionKind.Splice => current.index < 2 ? type_id_u64 : current.source,
                _ => current.source
            }
            const context = current.context

            const id =
                context.expressions.collection_arguments[current.first + current.index]
            const valid_argument = typed({
                expressions: context.expressions,
                index: context.index,
                id,
                type_id: hint
            })

            const string_concat = current.operation == CollectionKind.Concat &&
                current.element == type_id_u8

            current.valid = match {
                valid_argument => true,
                !string_concat => false,
                _ => typed({
                    expressions: context.expressions,
                    index: context.index,
                    id,
                    type_id: type_id_string
                })
            }

            current.index += 1
        }
    })

    if (!arguments.valid) {
        return false
    }

    const business = table.children[first + 1]

    return match operation {
        CollectionKind.Pop =>
            kind(table.kinds[integers.widen(
                business
            )]) == Kind.Optional &&
            table.first[integers.widen(
                business
            )] == element,
        CollectionKind.Splice => business == source_id,
        CollectionKind.Sort =>
            business == type_id_void && (
                numeric(element) != Numeric.Other || element == type_id_string
            ),
        _ => business == type_id_void
    }
}
