import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import kind from "../../../../analysis/semantic/types/kind"
import typed from "./typed"

import type { Check } from "./model"

export type Input = Check

export type Output = bool

export default function (in: Input): Output {
    const context = in.context
    const expressions = context.expressions

    if (in.kind == ExpressionKind.Conditional) {
        return typed({
            expressions,
            index: context.index,
            id: expressions.conditional_conditions[in.payload],
            type_id: 1
        }) &&
            typed({
                expressions,
                index: context.index,
                id: expressions.conditional_yes[in.payload],
                type_id: in.type_id
            }) &&
            typed({
                expressions,
                index: context.index,
                id: expressions.conditional_no[in.payload],
                type_id: in.type_id
            })
    }

    const subject = expressions.match_subjects[in.payload]

    if (subject != null && integers.widen(subject) >= context.index) {
        return false
    }

    const condition_type = match {
        subject == null => 1,
        _ => expressions.types[integers.widen(
            subject
        )]
    }

    const target = kind(context.table.kinds[integers.widen(
        condition_type
    )])

    const valid_target = match target {
        Kind.Scalar => true,
        Kind.Enumeration => true,
        Kind.ErrorSet => true,
        _ => false
    }

    const invalid_type = !valid_target || condition_type == 0
    const condition = subject != null && invalid_type

    if (condition) {
        return false
    }

    const result = loop({
        context,
        condition_type,
        result_type: in.type_id,
        first: integers.widen(expressions.match_first[in.payload]),
        count: integers.widen(expressions.match_count[in.payload]),
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.count,
        next: current => {
            const context = current.context
            const position = current.first + current.index

            current.valid = typed({
                expressions: context.expressions,
                index: context.index,
                id: context.expressions.match_conditions[position],
                type_id: current.condition_type
            }) &&
                typed({
                    expressions: context.expressions,
                    index: context.index,
                    id: context.expressions.match_results[position],
                    type_id: current.result_type
                })
            current.index += 1
        }
    })

    return result.valid && typed({
        expressions,
        index: context.index,
        id: expressions.match_fallbacks[in.payload],
        type_id: in.type_id
    })
}
