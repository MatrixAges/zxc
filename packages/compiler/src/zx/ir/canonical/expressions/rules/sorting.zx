import integers from "std:integer"
import { type_id_u8, type_id_f64 } from "core/const"
import { Kind } from "core/type_table/model"

import kind from "../../../../analysis/semantic/types/kind"

import type { Check } from "./model"

export type Input = Check

export type Output = bool

export default function (in: Input): Output {
    const context = in.context
    const expressions = context.expressions
    const payload = in.payload
    const initial = expressions.transform_initials[payload]
    const target = expressions.transform_targets[payload]
    const source = expressions.types[integers.widen(target)]
    const first = integers.widen(expressions.transform_first[payload])

    const source_kind = kind(context.table.kinds[integers.widen(source)])
    const counts = expressions.transform_count

    const valid = (
        - source_kind == Kind.List
        - and initial != null
        - and counts[payload] == 3
        - and in.type_id == source
    )

    if (!valid || initial == null) {
        return false
    }

    const parameters_initial = {
        index: 0,
        valid: true
    }

    const parameters_scope = {
        expressions,
        first,
        initial,
        context,
        source
    }

    const parameters = loop(parameters_initial, {
        while: current => current.valid && current.index < 3,
        next: current => {
            const symbol = integers.widen(
                parameters_scope.expressions
                    .transform_parameters[
                        parameters_scope.first + current.index
                    ]
            )
            const expected = match {
                current.index == 2 => parameters_scope.expressions
                    .types[
                        integers.widen(
                            parameters_scope.initial
                        )
                    ],
                _ => parameters_scope.context.table
                    .first[integers.widen(
                        parameters_scope.source
                    )]
            }

            current.valid = symbol < parameters_scope.context.symbols.types.length &&
                parameters_scope.context.symbols.types[symbol] == expected
            current.index += 1
        },
        return: current => current.valid
    })

    const body_type = expressions
        .types[integers.widen(
            expressions.transform_bodies[payload]
        )]

    return parameters && body_type >= type_id_u8 && body_type <= type_id_f64
}
