import integers from "zig:integers"
import { ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"

import kind from "../../../../analysis/semantic/types/kind"
import typed from "./typed"

import type { Check } from "./model"

export type Input = Check

export type Output = bool

export default function (in: Input): Output {
    const context = in.context
    const expressions = context.expressions
    const table = context.table

    if (in.kind == ExpressionKind.Some) {
        return in.target == Kind.Optional && typed({ expressions: expressions, index: context.index, id: expressions.some[in.payload], type_id: table.first[integers.widen(in.type_id)] })
    }

    const child = match in.kind {
        ExpressionKind.OptionalValue => expressions.optional_values[in.payload],
        ExpressionKind.Length => expressions.lengths[in.payload],
        ExpressionKind.Index => expressions.index_targets[in.payload],
        _ => expressions.projection_targets[in.payload]
    }

    const child_index = integers.widen(child)

    if (child_index >= context.index) {
        return false
    }

    const child_type = expressions.types[child_index]
    const child_type_index = integers.widen(child_type)
    const child_kind = kind(table.kinds[child_type_index])

    if (in.kind == ExpressionKind.OptionalValue) {
        return child_kind == Kind.Optional && table.first[child_type_index] == in.type_id
    }

    if (in.kind == ExpressionKind.Length) {
        return in.type_id == 5 && (child_kind == Kind.List || child_type == 10)
    }

    if (in.kind == ExpressionKind.Index) {
        return typed({ expressions: expressions, index: context.index, id: expressions.index_values[in.payload], type_id: 5 }) &&
            (child_type == 10 ? in.type_id == 2 : child_kind == Kind.List && table.first[child_type_index] == in.type_id)
    }

    const field = integers.widen(expressions.projection_indices[in.payload])
    const first = integers.widen(table.first[child_type_index])

    if (field >= integers.widen(table.second[child_type_index])) {
        return false
    }

    return in.kind == ExpressionKind.Field ?
        child_kind == Kind.Object && table.field_types[first + field] == in.type_id :
        child_kind == Kind.Tuple && table.children[first + field] == in.type_id
}
