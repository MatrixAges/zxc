import blockValid from "./block_valid"
import payloads from "./payloads"
import segments from "./segments"
import widths from "./widths"

import type { Control } from "./model"

export type Input = Control

export type Output = bool

export default function (in: Input): Output {
    if (!widths(in)) {
        return false
    }

    if (!segments({ first: in.parallel_first, count: in.parallel_count, length: in.parallel_values.length })) {
        return false
    }

    if (!segments({ first: in.destructure_first, count: in.destructure_count, length: in.destructure_symbols.length })) {
        return false
    }

    if (!segments({ first: in.selection_first, count: in.selection_count, length: in.case_bodies.length })) {
        return false
    }

    if (!segments({ first: in.block_first, count: in.block_count, length: in.statement_kinds.length }) || !payloads(in)) {
        return false
    }

    const result = loop({ control: in, block: 0, valid: true }, {
        while: current => current.valid && current.block < current.control.block_first.length,
        next: current => {
            current.valid = blockValid({ control: current.control, block: current.block })
            current.block += 1
        }
    })

    return result.valid
}
