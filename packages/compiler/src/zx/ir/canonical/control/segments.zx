import integers from "std:integer"
import { max_u32 } from "core/const"

export type Input = {
    first: u32[],
    count: u32[],
    length: u64
}

export type Output = bool

export default function (in: Input): Output {
    const index_limit = integers.widen(max_u32)

    const not_length = in.first.length != in.count.length

    const limit = index_limit

    const condition = (
        - in.length > limit
        - or in.first.length > limit
        - or not_length
    )

    if (condition) {
        return false
    }

    const result = loop({
        input: in,
        index: 0,
        next: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.input.first.length,
        next: current => {
            const first = integers.widen(current.input.first[current.index])
            const count = integers.widen(current.input.count[current.index])

            if (first != current.next || first > current.input.length) {
                current.valid = false
            } else if (count > current.input.length - first) {
                current.valid = false
            } else {
                current.next = first + count
            }

            current.index += 1
        }
    })

    return result.valid && result.next == in.length
}
