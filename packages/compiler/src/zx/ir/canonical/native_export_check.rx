<Module>
    <Type from="./native/model" as="Model" />

    <Args in={Model.ExportContext} out={bool} />

    <Call fn="./native/exports/owner" in={$in} />

    <If on={$ctx.owner != null}>
        <Call
            fn="./native/export_name"
            in={{
                functions: $in.functions,
                index: $in.index
            }}
        />

        <Call fn="./native/text" in={$ctx.export_name} />

        <If on={$ctx.text}>
            <Call
                fn="./native/exports/effects"
                in={{
                    members: $in.functions.native_errors[$in.index],
                    fallible: $in.functions.native_fallible[$in.index]
                }}
            />

            <If on={$ctx.effects}>
                <Call
                    fn="./native/exports/unoccupied"
                    in={{
                        modules: $in.modules,
                        owner: $ctx.owner,
                        name: $ctx.export_name
                    }}
                />

                <If on={$ctx.unoccupied}>
                    <Call
                        fn="./native/exports/compatible"
                        in={{
                            context: $in,
                            owner: $ctx.owner,
                            name: $ctx.export_name
                        }}
                    />

                    <Return value={$ctx.compatible} />

                    <Else>
                        <Return value={false} />
                    </Else>
                </If>

                <Else>
                    <Return value={false} />
                </Else>
            </If>

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
