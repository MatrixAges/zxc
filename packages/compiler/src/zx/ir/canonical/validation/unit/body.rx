<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Request} out={bool} />

    <Call
        module="../../contracts_check"
        in={{
            table: $in.context.table,
            contracts: $in.unit.contracts,
            input_type: $in.unit.input_type,
            output_type: $in.unit.output_type,
            max_offset: $in.context.max_offset
        }}
    />

    <If on={$ctx.contracts_check}>
        <Call fn="symbols" in={$in} />

        <If on={$ctx.symbols}>
            <Call fn="expressions" in={$in} />

            <If on={$ctx.expressions}>
                <Call module="flow" in={$in} />

                <Return value={$ctx.flow} />

                <Else>
                    <Return value={false} />
                </Else>
            </If>

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
