import integers from "std:integer"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const symbols = in.unit.body.symbols

    if (symbols.names.length == 0 || symbols.types[0] != in.unit.input_type) {
        return false
    }

    return loop({ symbols: symbols, count: in.context.table.kinds.length, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.symbols.names.length,
        next: current => {
            current.valid = current.symbols.names[current.index].length != 0 && integers.widen(current.symbols.types[current.index]) < current.count
            current.index += 1
        }
    }).valid
}
