<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Request} out={bool} />

    <Call
        module="../../stores_check"
        in={{
            table: $in.context.table,
            paths: $in.unit.body.stores.paths,
            slot_types: $in.unit.body.stores.types,
            type_only: $in.unit.type_only
        }}
    />

    <If on={$ctx.stores_check}>
        <Call fn="ports" in={$in} />

        <If on={$ctx.ports}>
            <If on={$in.unit.type_only}>
                <Call fn="type_only" in={$in.unit} />

                <Return value={$ctx.type_only} />

                <Else>
                    <Call module="body" in={$in} />

                    <Return value={$ctx.body} />
                </Else>
            </If>

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
