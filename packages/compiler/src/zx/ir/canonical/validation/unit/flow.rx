<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Request} out={bool} />

    <Call
        module="../../scopes_check"
        in={{
            table: $in.context.table,
            body: $in.unit.body,
            functions:
                $in.context.functions.pick(
                    [
                        "native_modules",
                        "native_concurrent",
                        "stores",
                        "expressions"
                    ]
                ),
            output_type: $in.unit.output_type,
            transaction: $in.unit.transaction
        }}
    />

    <If on={$ctx.scopes_check}>
        <Call
            module="../../tasks_check"
            in={{
                table: $in.context.table,
                body: $in.unit.body,
                input_type: $in.unit.input_type,
                output_type: $in.unit.output_type
            }}
        />

        <If on={$ctx.tasks_check}>
            <Call fn="ownership_request" in={$in} />

            <Call
                module="../../../../ownership/check"
                in={$ctx.ownership_request}
            />

            <Call
                fn="ownership_result"
                in={{
                    outcome: $ctx.check,
                    declared: $in.unit.output_ownership
                }}
            />

            <Return value={$ctx.ownership_result} />

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
