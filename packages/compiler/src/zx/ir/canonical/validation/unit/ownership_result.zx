import { Ownership } from "core/symbol_table/model"

import type { Output as Result } from "../../../../ownership/result"

export type Input = {
    outcome: Result,
    declared: Ownership
}

export type Output = bool

export default function (in: Input): Output {
    if (in.outcome.message != "") {
        return false
    }

    return in.declared == Ownership.Borrowed || in.declared == in.outcome.ownership
}
