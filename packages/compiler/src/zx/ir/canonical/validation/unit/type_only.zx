import type { Unit } from "../model"

export type Input = Unit

export type Output = bool

export default function (in: Input): Output {
    return in.input_type == 0 && in.output_type == 0 && in.body.symbols.names.length == 0 && in.body.expressions.kinds.length == 0 && in.body.root == null && in.contracts.kinds.length == 0
}
