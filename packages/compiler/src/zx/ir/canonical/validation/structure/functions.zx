import type { Complete } from "core/function_table/complete"

export type Input = {
    functions: Complete,
    maximum_count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const table = in.functions
    const count = table.files.length

    const different_input_types = table.input_types.length != count
    const different_output_types = table.output_types.length != count
    const different_ownership = table.ownership.length != count
    const different_store_modes = table.store_modes.length != count
    const different_contracts = table.contracts.length != count
    const different_native_inputs = table.native_inputs.length != count
    const different_native_modules = table.native_modules.length != count
    const different_native_members = table.native_members.length != count
    const different_native_exports = table.native_exports.length != count
    const different_native_allocato = table.native_allocators.length != count
    const different_native_io = table.native_io.length != count
    const different_native_process = table.native_process.length != count
    const different_native_tuples = table.native_tuples.length != count
    const different_native_fallible = table.native_fallible.length != count
    const different_native_errors = table.native_errors.length != count
    const different_native_concurre = table.native_concurrent.length != count
    const different_expressions = table.expressions.length != count

    const condition = (
        - count > in.maximum_count
        - or different_input_types
        - or different_output_types
        - or different_ownership
        - or different_store_modes
        - or different_contracts
        - or different_native_inputs
        - or different_native_modules
        - or different_native_members
        - or different_native_exports
        - or different_native_allocato
        - or different_native_io
        - or different_native_process
        - or different_native_tuples
        - or different_native_fallible
        - or different_native_errors
        - or different_native_concurre
        - or table.symbols.length != count
        - or different_expressions
        - or table.control.length != count
        - or table.roots.length != count
        - or table.stores.length != count
    )

    if (condition) {
        return false
    }

    return loop({
        table,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.table.files.length,
        next: current => {
            const index = current.index

            if (current.table.native_modules[index] == null) {
                const table = current.table
                current.valid = match {
                    table.native_inputs[index] != null => false,
                    table.native_members[index].length != 0 => false,
                    table.native_exports[index] != null => false,
                    table.native_allocators[index] => false,
                    table.native_io[index] => false,
                    table.native_process[index] => false,
                    table.native_tuples[index] => false,
                    table.native_fallible[index] => false,
                    table.native_errors[index] != null => false,
                    _ => !table.native_concurrent[index]
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
