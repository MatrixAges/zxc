import type { Complete } from "core/function_table/complete"

export type Input = {
    functions: Complete,
    maximum_count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const table = in.functions
    const count = table.files.length

    const condition = (
        - count > in.maximum_count
        - or table.input_types.length != count
        - or table.output_types.length != count
        - or table.ownership.length != count
        - or table.store_modes.length != count
        - or table.contracts.length != count
        - or table.native_inputs.length != count
        - or table.native_modules.length != count
        - or table.native_members.length != count
        - or table.native_exports.length != count
        - or table.native_allocators.length != count
        - or table.native_io.length != count
        - or table.native_process.length != count
        - or table.native_tuples.length != count
        - or table.native_fallible.length != count
        - or table.native_errors.length != count
        - or table.native_concurrent.length != count
        - or table.symbols.length != count
        - or table.expressions.length != count
        - or table.control.length != count
        - or table.roots.length != count
        - or table.stores.length != count
    )

    if (condition) {
        return false
    }

    return loop({
        table,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.table.files.length,
        next: current => {
            const index = current.index

            if (current.table.native_modules[index] == null) {
                current.valid =
                    (
                        - current.table.native_inputs[index] == null
                        - and current.table.native_members[index].length == 0
                        - and current.table.native_exports[index] == null
                        - and !current.table.native_allocators[index]
                        - and !current.table.native_io[index]
                        - and !current.table.native_process[index]
                        - and !current.table.native_tuples[index]
                        - and !current.table.native_fallible[index]
                        - and current.table.native_errors[index] == null
                        - and !current.table.native_concurrent[index]
                    )
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
