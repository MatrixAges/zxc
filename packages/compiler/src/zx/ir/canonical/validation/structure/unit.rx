<Module>
    <Type from="../model" as="Model" />

    <Args
        in={{
            max_offset: u64,
            unit: Model.Unit
        }}
        out={bool}
    />

    <Call
        module="../../body_check"
        in={{
            body: $in.unit.body,
            max_offset: $in.max_offset
        }}
    />

    <If on={$ctx.body_check}>
        <Call
            module="../../contract_tables_check"
            in={{
                contracts: $in.unit.contracts,
                max_offset: $in.max_offset
            }}
        />

        <Return value={$ctx.contract_tables_check} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
