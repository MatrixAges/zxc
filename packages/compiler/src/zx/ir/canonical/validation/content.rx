<Module>
    <Type from="./model" as="Model" />

    <Args in={Model.Program} out={bool} />

    <If on={$in.constant_exports != null}>
        <Call
            fn="../../../analysis/constants/valid"
            in={{
                constants: $in.constant_exports,
                types: {
                    base: $in.context.table,
                    delta: {
                        kinds: [],
                        first: [],
                        second: [],
                        labels: [],
                        children: [],
                        field_types: [],
                        field_names: [],
                        names: []
                    }
                }
            }}
        />

        <If on={!$ctx.valid}>
            <Return value={false} />
        </If>
    </If>

    <Call
        module="unit/check"
        in={{
            context: $in.context,
            unit: $in.unit
        }}
    />

    <If on={$ctx.check}>
        <Call fn="functions/check_all" in={$in.context} />

        <If on={$ctx.check_all}>
            <Call fn="exports" in={$in} />

            <If on={$ctx.exports}>
                <Call fn="effects/walk" in={$in} />

                <Return value={$ctx.walk} />

                <Else>
                    <Return value={false} />
                </Else>
            </If>

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
