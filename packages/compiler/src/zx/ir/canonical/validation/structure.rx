<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Program} out={bool} />

    <Call
        module="structure/unit"
        in={{
            unit: $in.unit,
            max_offset: $in.context.max_offset
        }}
    />

    <If on={$ctx.unit}>
        <Call fn="structure/walk" in={$in.context} />

        <Return value={$ctx.walk} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
