import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Context } from "../model"

export type Input = { context: Context, index: u64 }

export type Output = bool

export default function (in: Input): Output {
    return loop({ expressions: in.context.functions.expressions[in.index], limit: in.index, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.expressions.kinds.length,
        next: current => {
            if (current.expressions.kinds[current.index] == ExpressionKind.Call) {
                const payload = integers.widen(current.expressions.payloads[current.index])

                current.valid = integers.widen(current.expressions.call_functions[payload]) < current.limit
            }

            current.index += 1
        }
    }).valid
}
