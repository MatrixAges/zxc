import { StoreMode } from "core/function_table/complete"

import type { Input as Function } from "./forward"

export type Input = Function

export type Output = bool

export default function (in: Input): Output {
    const table = in.context.functions
    const index = in.index
    const no_stores = table.stores[index].paths.length == 0
    const transaction = table.store_modes[index] == StoreMode.transaction
    const no_contracts = table.contracts[index].kinds.length == 0
    const no_symbols = table.symbols[index].names.length == 0
    const no_expressions = table.expressions[index].kinds.length == 0

    return (
        - no_stores
        - and transaction
        - and no_contracts
        - and no_symbols
        - and no_expressions
        - and table.roots[index] == null
    )
}
