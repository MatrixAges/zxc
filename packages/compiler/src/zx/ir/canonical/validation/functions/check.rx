<Module>
    <Type from="forward" as="Forward" />

    <Args in={Forward.Input} out={bool} />

    <Call fn="forward" in={$in} />

    <If on={$ctx.forward}>
        <If on={$in.context.functions.native_modules[$in.index] != null}>
            <Call fn="external_body" in={$in} />

            <If on={!$ctx.external_body}>
                <Return value={false} />
            </If>

            <Call
                module="../external/check"
                in={{
                    table: $in.context.table,
                    functions: $in.context.functions.omit([
                        "store_modes",
                        "contracts",
                        "symbols",
                        "expressions",
                        "control",
                        "roots",
                        "stores"
                    ]),
                    modules: $in.context.modules,
                    index: $in.index
                }}
            />

            <Return value={$ctx.check} />

            <Else>
                <Call
                    fn="select"
                    in={{
                        functions: $in.context.functions,
                        index: $in.index
                    }}
                />

                <Call
                    module="../unit/check"
                    in={{
                        context: $in.context,
                        unit: $ctx.select
                    }}
                />

                <Return value={$ctx.check} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
