<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Program} out={bool} />

    <Call fn="structure/header" in={$in} />

    <If on={!$ctx.header}>
        <Return value={false} />
    </If>

    <Call
        module="../../../analysis/semantic/validate_types"
        in={{
            table: $in.context.table,
            scalar_count: $in.context.scalar_count,
            maximum_count: $in.context.maximum_count,
            trusted: false
        }}
    />

    <If on={!$ctx.validate_types}>
        <Return value={false} />
    </If>

    <Call module="structure" in={$in} />

    <If on={!$ctx.structure}>
        <Return value={false} />
    </If>

    <Call
        module="../native_modules_check"
        in={{
            table: $in.context.table,
            modules: $in.context.modules
        }}
    />

    <If on={!$ctx.native_modules_check}>
        <Return value={false} />
    </If>

    <Call module="content" in={$in} />

    <Return value={$ctx.content} />
</Module>
