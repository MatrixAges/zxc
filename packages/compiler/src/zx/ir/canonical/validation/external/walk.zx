import check from "compiler/ir_external_check"

import type { Modules } from "core/native_module_table/model"
import type { Table as Signatures } from "core/signature_table/model"
import type { Table } from "core/type_table/model"

export type Input = {
    table: Table,
    functions: Signatures,
    modules: Modules
}

export type Output = bool

export default function (in: Input): Output {
    const count = in.functions.files.length

    return loop({
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < count,
        next: current => {
            current.valid = check({
                table: in.table,
                functions: in.functions,
                modules: in.modules,
                index: current.index
            })

            current.index += 1
        },
        return: state => state.valid
    })
}
