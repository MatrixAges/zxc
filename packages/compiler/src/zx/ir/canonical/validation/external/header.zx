import integers from "std:integer"
import { StoreMode } from "core/function_table/complete"
import { Ownership } from "core/symbol_table/model"

import text from "../../native/text"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const table = in.context.functions
    const index = in.index
    const module_id = table.native_modules[index]

    const condition = (
        - module_id == null
        - or integers.widen(module_id) >= in.context.modules.specifiers.length
        - or table.native_members[index].length == 0
        - or table.stores[index].paths.length != 0
        - or table.store_modes[index] != StoreMode.transaction
        - or table.contracts[index].kinds.length != 0
        - or table.ownership[index] != Ownership.Borrowed
        - or table.symbols[index].names.length != 0
        - or table.expressions[index].kinds.length != 0
        - or table.roots[index] != null
        - or integers.widen(
            table.input_types[index]
        ) >= in.context.table.kinds.length
        - or integers.widen(
            table.output_types[index]
        ) >= in.context.table.kinds.length
    )

    if (condition) {
        return false
    }

    return loop({
        members: table.native_members[index],
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.members.length,
        next: current => {
            current.valid = text(current.members[current.index])
            current.index += 1
        },
        return: state => state.valid
    })
}
