import integers from "std:integer"
import { Ownership } from "core/symbol_table/model"

import text from "../../native/text"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const table = in.functions
    const index = in.index
    const module_id = table.native_modules[index]

    const condition = match {
        module_id == null => true,
        integers.widen(module_id) >= in.modules.specifiers.length => true,
        table.native_members[index].length == 0 => true,
        table.ownership[index] != Ownership.Borrowed => true,
        integers.widen(table.input_types[index]) >= in.table.kinds.length => true,
        _ =>
            integers.widen(table.output_types[index]) >= in.table.kinds.length
    }

    if (condition) {
        return false
    }

    return loop({
        members: table.native_members[index],
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.members.length,
        next: current => {
            current.valid = text(current.members[current.index])
            current.index += 1
        },
        return: state => state.valid
    })
}
