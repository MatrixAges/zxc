<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Request} out={bool} />

    <Call fn="header" in={$in} />

    <If on={$ctx.header}>
        <Call
            module="../../native_export_check"
            in={{
                functions:
                    $in.context.functions.pick(
                        [
                            "input_types",
                            "output_types",
                            "native_modules",
                            "native_members",
                            "native_exports",
                            "native_fallible",
                            "native_errors",
                            "native_concurrent"
                        ]
                    ),
                modules: $in.context.modules,
                index: $in.index
            }}
        />

        <If on={$ctx.native_export_check}>
            <Call fn="capabilities" in={$in} />

            <If on={$ctx.capabilities}>
                <Call fn="shape" in={$in} />

                <If on={$ctx.shape != null}>
                    <Call
                        module="../../native_type_check"
                        in={$ctx.shape}
                    />

                    <Return value={$ctx.native_type_check} />

                    <Else>
                        <Return value={true} />
                    </Else>
                </If>

                <Else>
                    <Return value={false} />
                </Else>
            </If>

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
