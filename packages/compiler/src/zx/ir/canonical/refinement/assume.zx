import integers from "std:integer"
import { max_u64 } from "core/const"
import {
    BinaryOperator,
    ExpressionKind,
    UnaryOperator
} from "core/expression_table/kinds"

import compare from "./compare"

import type { Expressions } from "core/expression_table/model"
import type { Refinement } from "./model"

export type Input = {
    state: Refinement,
    expressions: Expressions,
    condition: u64,
    truth: bool
}

export type Output = Refinement

export default function (in: Input): Output {
    const overflow = in.state.epoch == max_u64
    const epoch = overflow ? 1 : in.state.epoch + 1

    const visits = match {
        overflow => in.state.visits.map(value => 0)[0],
        _ => in.state.visits
    }

    const initial: Refinement =
        {
            ...in.state,
            visits: visits,
            epoch,
            conditions: in.state.conditions.push(in.condition)[0],
            truths: in.state.truths.push(in.truth)[0]
        }

    return loop({
        state: initial,
        expressions: in.expressions
    }, {
        while: current => current.state.conditions.length != 0,
        next: current => {
            const position = current.state.conditions.length - 1
            const condition = current.state.conditions[position]
            const truth = current.state.truths[position]

            current.state.conditions = current.state.conditions.pop()[0]
            current.state.truths = current.state.truths.pop()[0]

            const expressions = current.expressions
            const kind = expressions.kinds[condition]
            const payload = integers.widen(expressions.payloads[condition])

            if (kind == ExpressionKind.Reference) {
                const symbol = integers.widen(expressions.references[payload])

                if (symbol < current.state.facts.predicates.length) {
                    const predicate = current.state.facts.predicates[symbol]

                    if (predicate != null) {
                        const slot = symbol * 2 + (truth ? 1 : 0)

                        if (current.state.visits.length <= slot) {
                            current.state.visits = current.state.visits.push(0)[0]
                            current.state.conditions =
                                current.state.conditions.push(condition)[0]
                            current.state.truths = current.state.truths.push(truth)[0]
                        } else if (
                            current.state.visits[slot] != current.state.epoch
                        ) {
                            current.state.visits[slot] = current.state.epoch
                            current.state.conditions =
                                current.state.conditions.push(
                                    integers.widen(
                                        predicate
                                    )
                                )[0]
                            current.state.truths = current.state.truths.push(truth)[0]
                        }
                    }
                }
            } else if (kind == ExpressionKind.Scope) {
                current.state.conditions =
                    current.state.conditions.push(
                        integers.widen(
                            expressions.scope_results[payload]
                        )
                    )[0]
                current.state.truths = current.state.truths.push(truth)[0]
            } else if (
                kind == ExpressionKind.Unary &&
                    expressions.unary_operators[payload] == UnaryOperator.Not
            ) {
                current.state.conditions =
                    current.state.conditions.push(
                        integers.widen(
                            expressions.unary_operands[payload]
                        )
                    )[0]
                current.state.truths = current.state.truths.push(!truth)[0]
            } else if (kind == ExpressionKind.Binary) {
                const operator = expressions.binary_operators[payload]

                const is_logical_and = operator == BinaryOperator.LogicalAnd

                const valid_operator = operator == BinaryOperator.LogicalOr && !truth

                const condition_2 = (
                    - is_logical_and
                    - and truth
                    - or (valid_operator)
                )

                if (condition_2) {
                    current.state.conditions =
                        current.state.conditions.push(
                            integers.widen(
                                expressions.binary_right[payload]
                            )
                        )[0]
                    current.state.conditions =
                        current.state.conditions.push(
                            integers.widen(
                                expressions.binary_left[payload]
                            )
                        )[0]
                    current.state.truths = current.state.truths.push(truth)[0]
                    current.state.truths = current.state.truths.push(truth)[0]
                } else {
                    current.state.facts = compare({
                        facts: current.state.facts,
                        expressions,
                        payload,
                        truth
                    })
                }
            }
        },
        return: state => state.state
    })
}
