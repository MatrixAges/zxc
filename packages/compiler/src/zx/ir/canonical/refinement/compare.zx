import integers from "zig:integers"
import { BinaryOperator, ExpressionKind } from "core/expression_table/kinds"

import add from "./facts/add"
import resolveCapture from "./facts/resolve_capture"

import type { Expressions } from "core/expression_table/model"
import type { Facts } from "./facts/model"

export type Input = { facts: Facts, expressions: Expressions, payload: u64, truth: bool }

export type Output = Facts

export default function (in: Input): Output {
    const expressions = in.expressions
    const operator = expressions.binary_operators[in.payload]

    if (operator != BinaryOperator.Equal && operator != BinaryOperator.NotEqual) {
        return in.facts
    }

    const left = integers.widen(expressions.binary_left[in.payload])
    const right = integers.widen(expressions.binary_right[in.payload])

    const reference = match {
        expressions.kinds[left] == ExpressionKind.Reference && expressions.kinds[right] == ExpressionKind.None => left,
        expressions.kinds[right] == ExpressionKind.Reference && expressions.kinds[left] == ExpressionKind.None => right,
        _ => expressions.kinds.length
    }

    if (reference == expressions.kinds.length) {
        return in.facts
    }

    const symbol = expressions.references[integers.widen(expressions.payloads[reference])]
    const present = operator == BinaryOperator.NotEqual ? in.truth : !in.truth

    return present
    ? add({ facts: in.facts, symbol: symbol })
    : resolveCapture({ facts: in.facts, symbol: symbol })
}
