import { Kind } from "core/type_table/model"

import row from "../../../analysis/semantic/types/row"
import contains from "./facts/contains"

import type { Tables } from "core/type_table/model"
import type { Facts } from "./facts/model"

export type Input = { facts: Facts, tables: Tables, type_id: u32, symbol: u32 }

export type Output = u32

export default function (in: Input): Output {
    const value = row({ tables: in.tables, id: in.type_id })

    return value.kind == Kind.Optional && contains({ facts: in.facts, symbol: in.symbol }) ? value.first : in.type_id
}
