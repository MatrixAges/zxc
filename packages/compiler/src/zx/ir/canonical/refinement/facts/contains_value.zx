import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import contains from "./contains"
import samePath from "./same_path"

import type { Expressions } from "core/expression_table/model"
import type { Facts } from "./model"

export type Input = { facts: Facts, expressions: Expressions, value: u32 }

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.value)

    if (in.expressions.kinds[index] == ExpressionKind.Reference) {
        return contains({ facts: in.facts, symbol: in.expressions.references[integers.widen(in.expressions.payloads[index])] })
    }

    return loop({ expressions: in.expressions, values: in.facts.nonnull, projected: in.facts.projected, value: in.value, index: 0, found: false }, {
        while: current => !current.found && current.index < current.values.length,
        next: current => {
            current.found = current.projected[current.index] && samePath({ expressions: current.expressions, left: current.value, right: current.values[current.index] })
            current.index += 1
        }
    }).found
}
