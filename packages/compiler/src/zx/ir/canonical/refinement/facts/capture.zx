import type { Facts } from "./model"

export type Input = { facts: Facts, err: u32, result: u32 }

export type Output = Facts

export default function (in: Input): Output {
    return {
        nonnull: in.facts.nonnull,
        capture_errors: in.facts.capture_errors.push(in.err)[0],
        capture_results: in.facts.capture_results.push(in.result)[0]
    }
}
