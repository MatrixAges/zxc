import type { Facts, Mark } from "./model"

export type Input = { facts: Facts, mark: Mark }

export type Output = Facts

export default function (in: Input): Output {
    return {
        nonnull: in.facts.nonnull.splice(0, in.mark.nonnull, [])[1],
        projected: in.facts.projected.splice(0, in.mark.nonnull, [])[1],
        capture_errors: in.facts.capture_errors.splice(0, in.mark.captures, [])[1],
        capture_results: in.facts.capture_results.splice(0, in.mark.captures, [])[1]
    }
}
