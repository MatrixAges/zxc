import type { Facts } from "./model"

export type Input = { facts: Facts, symbol: u32 }

export type Output = bool

export default function (in: Input): Output {
    return loop({ values: in.facts.nonnull, projected: in.facts.projected, symbol: in.symbol, index: 0, found: false }, {
        while: current => !current.found && current.index < current.values.length,
        next: current => {
            current.found = !current.projected[current.index] && current.values[current.index] == current.symbol
            current.index += 1
        }
    }).found
}
