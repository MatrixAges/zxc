<Module>
    <Type from="./native/type_model" as="TypeModel" />

    <Args in={TypeModel.Input} out={bool} />

    <Call fn="native/type_bounds" in={$in} />

    <If on={$ctx.type_bounds}>
        <Call fn="native/type_walk" in={$in} />

        <Return value={$ctx.type_walk} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
