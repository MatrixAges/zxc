import classify from "../../../../modules/specifier/check"
import { Kind } from "../../../../modules/specifier/model"
import text from "../text"

import type { Modules } from "core/native_module_table/model"

export type Input = Modules

export type Output = bool

export default function (in: Input): Output {
    return loop({
        modules: in,
        index: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < current.modules.specifiers.length,
        next: current => {
            const kind = classify(current.modules.specifiers[current.index])
            const identity = current.modules.identities[current.index]

            const valid_kind = match kind {
                Kind.File => false,
                Kind.Package => false,
                Kind.Invalid => false,
                _ => true
            }

            const valid_name = match {
                valid_kind => text(current.modules.import_names[current.index]),
                _ => false
            }

            current.valid = match {
                !valid_name => false,
                identity == null => true,
                _ => text(identity)
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
