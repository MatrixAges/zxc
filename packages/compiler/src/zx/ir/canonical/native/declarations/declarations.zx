import classify from "../../../../modules/specifier/check"
import { Kind } from "../../../../modules/specifier/model"
import text from "../text"

import type { Modules } from "../model"

export type Input = Modules

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ modules: in, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.modules.specifiers.length,
        next: current => {
            const kind = classify(current.modules.specifiers[current.index])
            const identity = current.modules.identities[current.index]

            current.valid = kind != Kind.File && kind != Kind.Package && kind != Kind.Invalid && text(current.modules.import_names[current.index]) && (identity == null || text(identity))

            current.index += 1
        }
    })

    return result.valid
}
