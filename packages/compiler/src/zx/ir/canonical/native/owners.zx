import { kind_native_reference } from "core/type_table/const"

import owner from "./owner"

import type { Context } from "./model"

export type Input = {
    context: Context,
    first: u64
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        context: in.context,
        index: in.first,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < current.context.table.kinds.length,
        next: current => {
            if (
                current.context.table.kinds[current.index] == kind_native_reference
            ) {
                current.valid = owner({
                    context: current.context,
                    type_id: current.index
                }) != null
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
