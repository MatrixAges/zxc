import module from "./module"
import owner from "./owner"
import structure from "./structure"

import type { Context } from "./model"

export type Input = Context

export type Output = bool

export default function (in: Input): Output {
    if (!structure(in.modules)) {
        return false
    }

    const modules = loop({ context: in, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.context.modules.specifiers.length,
        next: current => {
            current.valid = module({ context: current.context, index: current.index })
            current.index += 1
        }
    })

    if (!modules.valid) {
        return false
    }

    const types = loop({ context: in, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.context.table.kinds.length,
        next: current => {
            if (current.context.table.kinds[current.index] == 8) {
                current.valid = owner({ context: current.context, type_id: current.index }) != null
            }

            current.index += 1
        }
    })

    return types.valid
}
