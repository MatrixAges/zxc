import integers from "zig:integers"

import key from "./key"
import text from "./text"

import type { Context } from "./model"

export type Input = { context: Context, module: u64 }

export type Output = bool

export default function (in: Input): Output {
    const modules = in.context.modules
    const owner = key({ modules: modules, index: in.module })

    const result = loop({ context: in.context, module: in.module, owner: owner, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.context.modules.type_names[current.module].length,
        next: current => {
            const modules = current.context.modules
            const name = modules.type_names[current.module][current.index]
            const type_id = modules.type_ids[current.module][current.index]
            const duplicate = loop({ names: modules.type_names[current.module], name: name, count: current.index, index: 0, found: false }, {
                while: previous => !previous.found && previous.index < previous.count,
                next: previous => {
                    previous.found = previous.names[previous.index] == previous.name
                    previous.index += 1
                }
            })

            const shared = loop({ modules: modules, count: current.module, owner: current.owner, name: name, type_id: type_id, index: 0, valid: true }, {
                while: previous => previous.valid && previous.index < previous.count,
                next: previous => {
                    if (key({ modules: previous.modules, index: previous.index }) == previous.owner) {
                        const binding = loop({ names: previous.modules.type_names[previous.index], ids: previous.modules.type_ids[previous.index], name: previous.name, type_id: previous.type_id, index: 0, valid: true }, {
                            while: other => other.valid && other.index < other.names.length,
                            next: other => {
                                other.valid = other.names[other.index] != other.name || other.ids[other.index] == other.type_id
                                other.index += 1
                            }
                        })

                        previous.valid = binding.valid
                    }

                    previous.index += 1
                }
            })

            current.valid = integers.widen(type_id) < current.context.table.kinds.length && text(name) && !duplicate.found && shared.valid
            current.index += 1
        }
    })

    return result.valid
}
