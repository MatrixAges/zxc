<Module>
    <Type from="./declarations/declarations" as="Declarations" />

    <Args in={Declarations.Input} out={bool} />

    <Call fn="./declarations/declarations" in={$in} />

    <If on={$ctx.declarations}>
        <Call fn="./declarations/namespaces" in={$in} />

        <If on={$ctx.namespaces}>
            <Call fn="./declarations/imports_unique" in={$in} />

            <Return value={$ctx.imports_unique} />

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
