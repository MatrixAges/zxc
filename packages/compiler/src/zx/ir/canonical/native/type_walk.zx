import integers from "zig:integers"
import { Kind } from "core/type_table/model"

import kind from "../../../analysis/semantic/types/kind"
import typeName from "./type_name"

import type { Input } from "./type_model"

export type Output = bool

export default function (in: Input): Output {
    const type_ids: u32[] = [in.type_id]
    const positions: u32?[] = [null]

    const result = loop({ input: in, type_ids: type_ids, positions: positions, position: 0, valid: true }, {
        while: current => current.valid && current.type_ids.length != 0,
        next: current => {
            const index = current.type_ids.length - 1
            const type_id = current.type_ids[index]
            const next_child = current.positions[index]
            const type_index = integers.widen(type_id)
            const type_kind = kind(current.input.table.kinds[type_index])

            if (next_child == null) {
                if (current.type_ids.length > 256 - current.input.depth || current.position == current.input.names.length || type_kind == Kind.Task) {
                    current.valid = false
                } else {
                    current.valid = typeName({ names: current.input.binding_names, types: current.input.binding_types, name: current.input.names[current.position], type_id: type_id, required: type_kind == Kind.NativeReference })
                    current.position += 1
                    current.positions[index] = 0
                }
            } else {
                const count: u32 = match type_kind {
                    Kind.Optional => 1,
                    Kind.List => 1,
                    Kind.Object => current.input.table.second[type_index],
                    Kind.Tuple => current.input.table.second[type_index],
                    _ => 0
                }

                if (next_child == count) {
                    current.type_ids = current.type_ids.pop()[0]
                    current.positions = current.positions.pop()[0]

                    if (current.type_ids.length == 0) {
                        current.valid = current.position == current.input.names.length
                    }
                } else {
                    const first = current.input.table.first[type_index]
                    const child = match type_kind {
                        Kind.Object => current.input.table.field_types[integers.widen(first) + integers.widen(next_child)],
                        Kind.Tuple => current.input.table.children[integers.widen(first) + integers.widen(next_child)],
                        _ => first
                    }

                    current.positions[index] = next_child + 1
                    current.type_ids = current.type_ids.push(child)[0]
                    current.positions = current.positions.push(null)[0]
                }
            }
        }
    })

    return result.valid
}
