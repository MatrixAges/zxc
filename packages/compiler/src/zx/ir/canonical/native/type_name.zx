export type Input = { names: string[], types: u32[], name: string?, type_id: u32, required: bool }

export type Output = bool

export default function (in: Input): Output {
    const name = in.name

    if (name == null) {
        return !in.required
    }

    const result = loop({ names: in.names, types: in.types, name: name, type_id: in.type_id, index: 0, found: false }, {
        while: current => !current.found && current.index < current.names.length,
        next: current => {
            current.found = current.types[current.index] == current.type_id && current.names[current.index] == current.name
            current.index += 1
        }
    })

    return result.found
}
