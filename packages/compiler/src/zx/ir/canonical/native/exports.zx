import integers from "zig:integers"

import compatible from "./compatible"
import errors from "./errors"
import exportName from "./export_name"
import key from "./key"
import text from "./text"

import type { ExportContext } from "./model"

export type Input = ExportContext

export type Output = bool

export default function (in: Input): Output {
    const functions = in.functions
    const modules = in.modules
    const module = functions.native_modules[in.index]

    if (module == null) {
        return false
    }

    const owner = key({ modules: modules, index: integers.widen(module) })
    const name = exportName({ functions: functions, index: in.index })
    const members = functions.native_errors[in.index]

    if (!text(name) || (members != null && (!functions.native_fallible[in.index] || !errors(members)))) {
        return false
    }

    const bindings = loop({ modules: modules, owner: owner, name: name, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.modules.specifiers.length,
        next: current => {
            if (key({ modules: current.modules, index: current.index }) == current.owner) {
                const duplicate = loop({ names: current.modules.type_names[current.index], name: current.name, index: 0, found: false }, {
                    while: other => !other.found && other.index < other.names.length,
                    next: other => {
                        other.found = other.names[other.index] == other.name
                        other.index += 1
                    }
                })

                current.valid = !duplicate.found
            }

            current.index += 1
        }
    })

    if (!bindings.valid) {
        return false
    }

    const previous = loop({ context: in, owner: owner, name: name, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.context.index,
        next: current => {
            const functions = current.context.functions
            const module = functions.native_modules[current.index]

            if (module != null && key({ modules: current.context.modules, index: integers.widen(module) }) == current.owner && exportName({ functions: functions, index: current.index }) == current.name) {
                current.valid = compatible({ functions: functions, left: current.context.index, right: current.index })
            }

            current.index += 1
        }
    })

    return previous.valid
}
