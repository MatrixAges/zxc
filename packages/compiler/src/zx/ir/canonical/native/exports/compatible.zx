import integers from "std:integer"
import exportName from "core/native_module_table/export_name"
import key from "core/native_module_table/key"

import compatible from "../compatible"

import type { ExportContext } from "../model"

export type Input = {
    context: ExportContext,
    owner: string,
    name: string
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        context: in.context,
        owner: in.owner,
        name: in.name,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.context.index,
        next: current => {
            const functions = current.context.functions
            const module = functions.native_modules[current.index]

            if (module != null && key({
                modules: current.context.modules,
                index: integers.widen(module)
            }) == current.owner && exportName({
                functions,
                index: current.index
            }) == current.name) {
                current.valid = compatible({
                    functions,
                    left: current.context.index,
                    right: current.index
                })
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
