import integers from "std:integer"
import key from "core/native_module_table/key"

import type { ExportContext } from "../model"

export type Input = ExportContext

export type Output = string?

export default function (in: Input): Output {
    const module = in.functions.native_modules[in.index]

    return match {
        module == null => null,
        _ => key({
            modules: in.modules,
            index: integers.widen(module)
        })
    }
}
