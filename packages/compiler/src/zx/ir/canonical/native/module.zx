import classify from "../../../modules/specifier/check"
import { Kind } from "../../../modules/specifier/model"
import bindings from "./bindings"
import key from "./key"
import text from "./text"

import type { Context } from "./model"

export type Input = { context: Context, index: u64 }

export type Output = bool

export default function (in: Input): Output {
    const modules = in.context.modules
    const kind = classify(modules.specifiers[in.index])
    const identity = modules.identities[in.index]

    if (kind == Kind.File || kind == Kind.Package || kind == Kind.Invalid || !text(modules.import_names[in.index]) || (identity != null && !text(identity))) {
        return false
    }

    const namespace = loop({ names: modules.type_namespaces[in.index], index: 0, valid: true }, {
        while: current => current.valid && current.index < current.names.length,
        next: current => {
            current.valid = text(current.names[current.index])
            current.index += 1
        }
    })

    if (!namespace.valid || !bindings({ context: in.context, module: in.index })) {
        return false
    }

    const duplicate = loop({ modules: modules, owner: key({ modules: modules, index: in.index }), name: modules.import_names[in.index], count: in.index, index: 0, found: false }, {
        while: current => !current.found && current.index < current.count,
        next: current => {
            current.found = key({ modules: current.modules, index: current.index }) == current.owner && current.modules.import_names[current.index] == current.name
            current.index += 1
        }
    })

    return !duplicate.found
}
