import integers from "std:integer"
import { max_nesting_depth } from "core/const"

import type { Input } from "./type_model"

export type Output = bool

export default function (in: Input): Output {
    return (
        - in.depth < max_nesting_depth
        - and in.names.length != 0
        - and integers.widen(in.type_id) < in.table.kinds.length
        - and in.binding_names.length == in.binding_types.length
    )
}
