import integers from "std:integer"
import { max_u32 } from "core/const"

import type { Modules } from "core/native_module_table/model"

export type Input = Modules

export type Output = bool

export default function (in: Input): Output {
    const count = in.specifiers.length

    const condition = (
        - count > integers.widen(max_u32)
        - or in.identities.length != count
        - or in.import_names.length != count
        - or in.type_ids.length != count
        - or in.type_names.length != count
        - or in.type_namespaces.length != count
    )

    if (condition) {
        return false
    }

    return loop({
        modules: in,
        index: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < current.modules.specifiers.length,
        next: current => {
            const names = current.modules.type_names[current.index]
            const ids = current.modules.type_ids[current.index]

            current.valid =
                names.length == ids.length &&
                names.length <= integers.widen(
                    max_u32
                )
            current.index += 1
        },
        return: state => state.valid
    })
}
