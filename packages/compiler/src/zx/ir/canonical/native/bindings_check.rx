<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Context} out={bool} />

    <Call fn="./bindings/binding_values" in={$in} />

    <If on={$ctx.binding_values}>
        <Call fn="./bindings/bindings_unique" in={$in.modules} />

        <If on={$ctx.bindings_unique}>
            <Call fn="./bindings/bindings_consistent" in={$in.modules} />

            <Return value={$ctx.bindings_consistent} />

            <Else>
                <Return value={false} />
            </Else>
        </If>

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
