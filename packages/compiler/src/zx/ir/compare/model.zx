import type { Input as Native } from "./native_columns"

export type Columns = {
    words: u8[][],
    tags: u8[][],
    options: u32?[][],
    text: string[][]
}

export type ColumnPair = {
    left: Columns,
    right: Columns,
    masks: u8[]
}

export type Header = {
    columns: ColumnPair,
    native: Native
}
