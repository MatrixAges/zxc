import columns from "./columns"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const previous = in.previous.files
    const count = in.current.paths.length
    const old_count = previous.paths.length
    const read_high = previous.read_high.length
    const read_low = previous.read_low.length
    const current_shape = columns(in.current)
    const previous_shape = columns(previous)

    return (
        - current_shape
        - and previous_shape
        - and count == old_count
        - and read_high == count
        - and read_low == count
    )
}
