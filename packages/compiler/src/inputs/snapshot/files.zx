import same from "./same"
import settled from "./settled"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.current.paths.length,
        next: state => {
            const cursor = {
                current: in.current,
                previous: in.previous.files,
                index: state.index,
                now_high: in.now_high,
                now_low: in.now_low
            }

            state.valid = same(cursor) && settled(cursor)
            state.index += 1
        },
        return: state => state.valid
    })
}
