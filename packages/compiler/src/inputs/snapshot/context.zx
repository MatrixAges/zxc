import { fingerprint_width } from "./const"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const matches = in.context == in.previous.context
    const width = in.previous.fingerprint.length
    const checksums_match = in.stored_checksum == in.actual_checksum

    return (
        - matches
        - and checksums_match
        - and width == fingerprint_width
    )
}
