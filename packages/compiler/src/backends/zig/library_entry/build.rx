<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={Entry.Output} />

    <If on={$in.function_id != null}>
        <If on={$in.store_count == 0}>
            <Call fn="parameter" in={$in.input_type} />

            <Call
                module="../../../zx/modules/forward_entry/build"
                in={{
                    parameter: $ctx.parameter.symbol,
                    function_id: $in.function_id,
                    input_type: $in.input_type,
                    output_type: $in.output_type,
                    unit: $ctx.parameter.unit
                }}
            />

            <Return value={$ctx.build} />
        </If>
    </If>

    <Return value={null} />
</Module>
