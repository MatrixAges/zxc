import { Ownership } from "core/symbol_table/model"

import { input_name } from "./const"

import type { Symbols as Output } from "core/symbol_table/model"

export type Input = u32

export default function (in: Input): Output {
    return {
        names: [input_name],
        types: [in],
        span_start: [0],
        span_end: [0],
        ownership: [Ownership.Copy]
    }
}
