export type Input = string?[]

export type Output = bool

export default function (in: Input): Output {
    return loop({
        values: in,
        index: 0,
        scoped: false
    }, {
        while: current => !current.scoped && current.index < current.values.length,
        next: current => {
            current.scoped = current.values[current.index] != null
            current.index += 1
        }
    }).scoped
}
