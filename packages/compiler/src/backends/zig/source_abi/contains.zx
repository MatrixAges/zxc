import bytes from "std:bytes"

import type { Bindings } from "./model"

export type Input = {
    modules: Bindings,
    identity: string
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        modules: in.modules,
        identity: bytes.fromText(in.identity),
        index: 0,
        found: false
    }, {
        while: current =>
            !current.found && current.index < current.modules.specifiers.length,
        next: current => {
            const key = current.modules.identities[current.index] ??
                current.modules.specifiers[current.index]

            current.found = bytes.equals(bytes.fromText(key), current.identity)
            current.index += 1
        }
    }).found
}
