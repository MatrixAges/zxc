import bytes from "std:bytes"

import type { Names as Input, Result as Output } from "./model"

export default function (in: Input): Output {
    if (in.actual.length != in.expected.length) {
        return false
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < in.actual.length,
        next: current => {
            current.valid = bytes.equals(
                in.actual[current.index],
                in.expected[current.index]
            )
            current.index += 1
        },
        return: current => current.valid
    })
}
