import integers from "std:integer"
import { kind_scalar, kind_object, scalar_void } from "core/type_table/const"

import type { Program as Input } from "../../../../zx/ir/canonical/validation/model"

export type Output = bool

export default function (in: Input): Output {
    const input_index = integers.widen(in.unit.input_type)
    const output_index = integers.widen(in.unit.output_type)
    const table = in.context.table

    if (table.kinds[input_index] != kind_scalar) {
        return false
    }

    if (table.first[input_index] != scalar_void) {
        return false
    }

    return table.kinds[output_index] == kind_object
}
