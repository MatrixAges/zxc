import bytes from "std:bytes"

export type Input = {
    names: u8[][],
    value: u8[]
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        found: false
    }, {
        while: current => !current.found && current.index < in.names.length,
        next: current => {
            current.found = bytes.equals(in.names[current.index], in.value)
            current.index += 1
        },
        return: current => current.found
    })
}
