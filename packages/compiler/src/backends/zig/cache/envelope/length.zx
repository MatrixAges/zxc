import bytes from "std:bytes"

import { newline, word_radix } from "./const"
import hexWord from "./hex_word"

import type { Length as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { writer, payload_size } = in

    bytes.writeU64Le(writer, hexWord(payload_size / word_radix))
    bytes.writeU64Le(writer, hexWord(payload_size % word_radix))
    bytes.writeByte(writer, newline)
}
