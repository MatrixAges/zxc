import {
    digest_text_width,
    length_width,
    marker,
    maximum_payload,
    separator_count
} from "./const"

import type { Layout as Output, Request as Input } from "./model"

export default function (in: Input): Output {
    const header_size =
        marker.length + digest_text_width * 2 + length_width + separator_count

    if (in.reading && in.size < header_size) {
        return {
            accepted: false,
            payload_size: 0
        }
    }

    const payload_size = in.reading ? in.size - header_size : in.size

    return {
        accepted: payload_size <= maximum_payload,
        payload_size
    }
}
