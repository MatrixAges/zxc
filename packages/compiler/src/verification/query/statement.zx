export type Input = { declarations: string, definitions: string, predicate: string }

export type Output = string

export default function (in: Input): Output {
    return `(set-logic QF_BV)\n(set-option :produce-models true)\n(set-option :timeout 10000)\n${in.declarations}\n${in.definitions}\n(assert ${in.predicate})\n(check-sat)\n`
}
