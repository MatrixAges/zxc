<Module>
    <Type from="model" as="Registration" />

    <Args in={Registration.Input} out={Registration.Output} />

    <Call
        module="core/bytes/index/get"
        in={{
            index: $in.index,
            key: $in.identity
        }}
    />

    <If on={$ctx.get != null}>
        <Return
            value={{
                index: $in.index,
                previous: $ctx.get
            }}
        />
    </If>

    <Call
        module="core/bytes/index/insert"
        in={{
            index: $in.index,
            key: $in.identity,
            value: $in.row
        }}
    />

    <Return
        value={{
            index: $ctx.insert,
            previous: null
        }}
    />
</Module>
