export type Input = { items: u64[]; start: u64; count: u64; replacement: u64[]; };
export type Output = { items: u64[]; removed: u64[]; };

export default function (in: Input): Output {
const owned = in.items.clone();
const replacement = in.replacement.clone();
const [items, removed] = owned.splice(in.start, in.count, replacement);

return { items, removed };
}
