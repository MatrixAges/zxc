export type Input = { left: f64; right: f64; };
export type Output = { sum: f64; difference: f64; product: f64; quotient: f64; remainder: f64; };

export default function (in: Input): Output {
return { sum: in.left + in.right, difference: in.left - in.right, product: in.left * in.right, quotient: in.left / in.right, remainder: in.left % in.right };
}
