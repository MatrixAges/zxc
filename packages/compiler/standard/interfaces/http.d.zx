export enum Method { Get, Head, Post, Put, Patch, Delete, Options }

export type Header = { name: string, value: u8[] }

export type Options = { url: string, method: Method, headers: Header[], body: u8[]?, max_body_bytes: u64, max_header_bytes: u64 }

export type Response = { status: u16, headers: Header[], body: u8[] }

export declare function request(allocator, io, in: Options): Response throws {
  AccessDenied, AddressFamilyUnsupported, AddressInUse, AddressUnavailable, Canceled,
  CertificateBundleLoadFailure, ConnectionPending, ConnectionRefused,
  ConnectionResetByPeer, DetectingNetworkConfigurationFailed, HostUnreachable,
  HttpChunkInvalid, HttpChunkTruncated, HttpConnectionClosing,
  HttpContentEncodingUnsupported, HttpHeadersInvalid, HttpHeadersOversize,
  HttpHeadersTooLarge, HttpRedirectLocationInvalid, HttpRedirectLocationMissing,
  HttpRedirectLocationOversize, HttpRequestTruncated, HttpUpgradeUnsupported,
  InvalidDnsAAAARecord, InvalidDnsARecord, InvalidDnsCnameRecord, InvalidFormat,
  InvalidHeaderLimit, InvalidHostName, InvalidHttpHeader, InvalidPort, InvalidUrl,
  InvalidUtf8, ManagedHttpHeader, NameServerFailure, NetworkDown, NetworkUnreachable,
  NoAddressReturned, OptionUnsupported, OutOfMemory, ProcessFdQuotaExceeded,
  ProtocolUnsupportedByAddressFamily, ProtocolUnsupportedBySystem, ReadFailed,
  RedirectRequiresResend, ResolvConfParseFailed, SocketModeUnsupported, StreamTooLong,
  SystemFdQuotaExceeded, SystemResources, Timeout, TlsInitializationFailed,
  TooManyHttpRedirects, Unexpected, UnexpectedCharacter, UnknownHostName,
  UnsupportedRequestBody, UnsupportedUriScheme, UriMissingHost, UrlCredentialsUnsupported,
  WouldBlock, WriteFailed
} concurrent
