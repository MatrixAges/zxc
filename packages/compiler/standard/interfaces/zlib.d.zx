export type DecompressOptions = { data: u8[]; max_output_length: u32; };
export type CompressOptions = { data: u8[]; level: i32; };

export declare function gzip(allocator, in: u8[]): u8[] throws;
export declare function deflate(allocator, in: u8[]): u8[] throws;
export declare function deflateRaw(allocator, in: u8[]): u8[] throws;
export declare function gzipWith(allocator, in: CompressOptions): u8[] throws;
export declare function deflateWith(allocator, in: CompressOptions): u8[] throws;
export declare function deflateRawWith(allocator, in: CompressOptions): u8[] throws;
export declare function gunzip(allocator, in: DecompressOptions): u8[] throws;
export declare function inflate(allocator, in: DecompressOptions): u8[] throws;
export declare function inflateRaw(allocator, in: DecompressOptions): u8[] throws;
