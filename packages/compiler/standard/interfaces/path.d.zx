export type Parts = { root: string
 dir: string
 base: string
 ext: string
 name: string }

export declare function isAbsolute(in: string): bool
export declare function basename(in: string): string
export declare function dirname(in: string): string
export declare function extname(in: string): string
export declare function parse(allocator, in: string): Parts throws { OutOfMemory }

export declare function format(allocator, in: Parts): string throws { OutOfMemory }

export declare function normalize(allocator, in: string): string throws { OutOfMemory, WriteFailed }

export declare function join(allocator, in: string[]): string throws { OutOfMemory, WriteFailed }

export declare function resolve(allocator, in: { cwd: string
 paths: string[] }): string throws { InvalidWorkingDirectory, MissingDriveDirectory, OutOfMemory, WriteFailed }

export declare function relative(allocator, in: { cwd: string
 from: string
 to: string }): string throws { InvalidWorkingDirectory, MissingDriveDirectory, OutOfMemory, WriteFailed }
