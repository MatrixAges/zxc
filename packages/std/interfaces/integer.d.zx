export declare function widen(value: u32): u64 concurrent

export declare function widenShort(value: u16): u64 concurrent

export declare function widenByte(value: u8): u64 concurrent

export declare function widenSigned(value: u32): i64 concurrent

export declare function narrow(value: u64): u32 throws { IntegerOverflow } concurrent

export declare function narrowSigned(value: i64): u32 throws { IntegerOverflow } concurrent

export declare function bitMask(index: u64): u64 throws { IntegerOverflow } concurrent

export declare function andBits(left: u64, right: u64): u64 concurrent

export declare function orBits(left: u64, right: u64): u64 concurrent
