export type U8Buffer = opaque
export type U32Buffer = opaque
export type U64Buffer = opaque
export type OptionalU32Buffer = opaque

export declare function readU32(
    target: U32Buffer,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readU64(
    target: U64Buffer,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function writeU8(
    target: U8Buffer,
    index: u64,
    value: u8
): void throws { IndexOutOfBounds }

export declare function writeU32(
    target: U32Buffer,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function writeU64(
    target: U64Buffer,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function copyBytes(
    target: U8Buffer,
    offset: u64,
    source: u8[],
    start: u64,
    end: u64
): u64 throws { IndexOutOfBounds }

export declare function writeUtf8Scalar(
    target: U8Buffer,
    offset: u64,
    codepoint: u64
): u64 throws { IndexOutOfBounds, InvalidUnicodeScalar }

export declare function writeOptionalU32(
    target: OptionalU32Buffer,
    index: u64,
    value: u32?
): void throws { IndexOutOfBounds }
