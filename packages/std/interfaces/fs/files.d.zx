export declare function readFile(allocator, io, in: { path: string, max_bytes: u64 }): u8[] throws {
  AccessDenied, AntivirusInterference, BadPathName, Canceled, ConnectionResetByPeer,
  DeviceBusy, FileBusy, FileLocksUnsupported, FileNotFound, FileTooBig, InputOutput,
  InvalidPath, InvalidUtf8, IsDir, LockViolation, NameTooLong, NetworkNotFound, NoDevice,
  NoSpaceLeft, NotDir, NotOpenForReading, OutOfMemory, PathAlreadyExists,
  PermissionDenied, PipeBusy, ProcessFdQuotaExceeded, ReadOnlyFileSystem,
  SocketUnconnected, StreamTooLong, SymLinkLoop, SystemFdQuotaExceeded, SystemResources,
  Unexpected, WouldBlock
} concurrent

