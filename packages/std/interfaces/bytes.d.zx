export type AtomicRows = opaque
export type Writer = opaque

export declare function write(out: Writer, value: u8[]): void throws { OutOfMemory }

export declare function writeMasked(out: Writer, value: u8[], mask: u8): void throws {
    OutOfMemory
}

export declare function writeByte(out: Writer, value: u8): void throws { OutOfMemory }

export declare function writeU32Le(out: Writer, value: u32): void throws { OutOfMemory }

export declare function writeU64Le(out: Writer, value: u64): void throws { OutOfMemory }

export declare function writeU32sLe(out: Writer, value: u32[]): void throws {
    OutOfMemory
}

export declare function writeU64sLe(out: Writer, value: u64[]): void throws {
    OutOfMemory
}

export declare function repeat(
    allocator,
    count: u64,
    value: u8
): u8[] throws { OutOfMemory } concurrent

export declare function fromText(in: string): u8[] concurrent

export declare function join(
    allocator,
    separator: u8[],
    values: u8[][]
): u8[] throws { OutOfMemory } concurrent

export declare function encodeU64Le(
    allocator,
    in: u64
): u8[] throws { OutOfMemory } concurrent

export declare function count(haystack: u8[], needle: u8): u64 concurrent

export declare function indexOfScalar(haystack: u8[], start: u64, needle: u8): u64? concurrent

export declare function lastIndexOfScalar(haystack: u8[], needle: u8): u64? concurrent

export declare function indexOfSlice(haystack: u8[], start: u64, needle: u8[]): u64? concurrent

export declare function indexOfText(haystack: u8[], start: u64, needle: string): u64? concurrent

export declare function startsWith(haystack: u8[], start: u64, prefix: u8[]): bool concurrent

export declare function startsWithText(haystack: u8[], start: u64, prefix: string): bool concurrent

export declare function equals(left: u8[], right: u8[]): bool concurrent

export declare function lessThan(left: u8[], right: u8[]): bool concurrent

export declare function hash(in: u8[]): u64 concurrent

export declare function readU32(
    in: u8[],
    offset: u64,
    little_endian: bool
): u32 throws { IndexOutOfBounds } concurrent

export declare function loadAtomic(in: u8[], index: u64): u8 throws {
    IndexOutOfBounds
} concurrent

export declare function atomicRowsCount(in: AtomicRows): u64

export declare function atomicRowLength(in: AtomicRows, row: u64): u64 throws {
    IndexOutOfBounds
}

export declare function loadAtomicCell(in: AtomicRows, row: u64, index: u64): u8 throws {
    IndexOutOfBounds
}

export declare function storeAtomicCell(
    in: AtomicRows,
    row: u64,
    index: u64,
    value: u8
): void throws { IndexOutOfBounds }

export declare function fillAtomicRow(
    in: AtomicRows,
    row: u64,
    value: u8
): void throws { IndexOutOfBounds }
