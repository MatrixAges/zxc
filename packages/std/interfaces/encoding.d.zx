export declare function encodeBase64(allocator, in: u8[]): string throws { OutOfMemory } concurrent

export declare function decodeBase64(allocator, in: string): u8[] throws { InvalidCharacter, InvalidPadding, NoSpaceLeft, OutOfMemory } concurrent

export declare function encodeHex(allocator, in: u8[]): string throws { OutOfMemory, Overflow } concurrent

export declare function decodeHex(allocator, in: string): u8[] throws { InvalidCharacter, InvalidHex, InvalidLength, NoSpaceLeft, OutOfMemory } concurrent

export declare function encodeUtf8(in: string): u8[] throws { InvalidUtf8 } concurrent

export declare function decodeUtf8(in: u8[]): string throws { InvalidUtf8 } concurrent

export declare function sliceBytes(text: string, start: u64, end: u64): string throws { InvalidRange } concurrent
