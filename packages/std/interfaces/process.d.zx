export declare function argv(allocator, process): string[] throws { InvalidUtf8, OutOfMemory } concurrent

export declare function getEnv(allocator, process, key: string): string? throws {
  EnvironmentVariableMissing, InvalidEnvironmentKey, InvalidUtf8, InvalidWtf8,
  OutOfMemory
} concurrent

export declare function cwd(allocator, io): string throws {
  Canceled, CurrentDirUnlinked, InvalidUtf8, NameTooLong, OutOfMemory, PathExceedsLimit,
  Unexpected
} concurrent

export declare function readStdin(allocator, io, max_bytes: u64): u8[] throws { OutOfMemory, ReadFailed, StreamTooLong } concurrent

export declare function readStdinText(allocator, io, max_bytes: u64): string throws { InvalidUtf8, OutOfMemory, ReadFailed, StreamTooLong } concurrent

export declare function writeStdout(io, data: u8[]): void throws { WriteFailed } concurrent

export declare function writeStdoutText(io, text: string): void throws { InvalidUtf8, WriteFailed } concurrent

export declare function writeStderr(io, data: u8[]): void throws { WriteFailed } concurrent

export declare function writeStderrText(io, text: string): void throws { InvalidUtf8, WriteFailed } concurrent
