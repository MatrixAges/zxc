import crypto from "std:crypto";
export enum Algorithm { Aes128Gcm, Aes256Gcm, ChaCha20Poly1305 }

export type Input = { algorithm: Algorithm; key: u8[]; nonce: u8[]; aad: u8[]; ciphertext: u8[]; tag: u8[]; };
export type Output = u8[];

export default function (in: Input): Output {
  switch (in.algorithm) {
    case Algorithm.Aes128Gcm: return crypto.decryptAes128Gcm({ key: in.key, nonce: in.nonce, aad: in.aad, ciphertext: in.ciphertext, tag: in.tag });
    case Algorithm.Aes256Gcm: return crypto.decryptAes256Gcm({ key: in.key, nonce: in.nonce, aad: in.aad, ciphertext: in.ciphertext, tag: in.tag });
    case Algorithm.ChaCha20Poly1305: return crypto.decryptChaCha20Poly1305({ key: in.key, nonce: in.nonce, aad: in.aad, ciphertext: in.ciphertext, tag: in.tag });
  }
}
