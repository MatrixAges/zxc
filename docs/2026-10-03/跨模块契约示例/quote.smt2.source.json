	"sources": [
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-03/跨模块契约示例/quote.zx",
			"source": "import discount from \"library\";\n\nexport type Input = { raw_price: u32; discount: u32; };\n\nexport type Output = { final_price: u32; };\n\nexport default function (in: Input): Output\n  ensures (out.final_price <= in.raw_price)\n{\n  if (in.discount > in.raw_price) {\n    return { final_price: 0 };\n  }\n\n  return discount(in);\n}\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/.zxc/examples/verified_discount_library/source/module_0.zx",
			"source": "export type Input = { raw_price: u32; discount: u32; };\n\nexport type Output = { final_price: u32; };\n\nexport default function (in: Input): Output\n  requires (in.discount <= in.raw_price)\n  ensures (out.final_price == in.raw_price - in.discount)\n{\n  return { final_price: in.raw_price - in.discount };\n}\n"
		}
