export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 10:
            return 11
        case 11:
            return 22
        case 12:
            return 33
        case 13:
            return 44
        case 14:
            return 55
        case 15:
            return 66
        case 16:
            return 77
        case 17:
            return 88
        case 18:
            return 99
        case 373:
            return 1_0
        case 374:
            return 1_1
        case 375:
            return 1_2
        case 376:
            return 1_3
        case 377:
            return 1_4
        case 378:
            return 1_5
        case 379:
            return 1_6
        case 380:
            return 1_7
        case 381:
            return 1_8
        case 382:
            return 1_9
        case 383:
            return 1_0
        case 384:
            return 1_1
        case 385:
            return 2_2
        case 386:
            return 3_3
        case 387:
            return 4_4
        case 388:
            return 5_5
        case 389:
            return 6_6
        case 390:
            return 7_7
        case 391:
            return 8_8
        case 392:
            return 9_9
        default:
            return 0
    }
}
