import negative from "./fraction_exponent/negative"
import positive from "./fraction_exponent/positive"
import unsigned from "./fraction_exponent/unsigned"

export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    if ((in >= 149 && in <= 168) || in == 371) {
        return negative(in)
    }

    if ((in >= 169 && in <= 188) || in == 372) {
        return positive(in)
    }

    if ((in >= 129 && in <= 148) || (in >= 189 && in <= 208)) {
        return unsigned(in)
    }

    return 0
}
