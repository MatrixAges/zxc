export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 149:
            return 0.0e-1
        case 150:
            return 1.1e-1
        case 151:
            return 2.2e-1
        case 152:
            return 3.3e-1
        case 153:
            return 4.4e-1
        case 154:
            return 5.5e-1
        case 155:
            return 6.6e-1
        case 156:
            return 7.7e-1
        case 157:
            return 8.8e-1
        case 158:
            return 9.9e-1
        case 159:
            return 0.0E-1
        case 160:
            return 1.1E-1
        case 161:
            return 2.2E-1
        case 162:
            return 3.3E-1
        case 163:
            return 4.4E-1
        case 164:
            return 5.5E-1
        case 165:
            return 6.6E-1
        case 166:
            return 7.7E-1
        case 167:
            return 8.8E-1
        case 168:
            return 9.9E-1
        case 371:
            return 1.0e-10_0
        default:
            return 0
    }
}
