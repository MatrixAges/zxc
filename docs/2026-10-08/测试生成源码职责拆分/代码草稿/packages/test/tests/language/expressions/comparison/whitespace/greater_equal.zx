export type Input = { shape: u64
 value: f64 }

export type Output = bool

export default function (in: Input): Output {
  switch (in.shape) {
    case 54: return in.value	>= 1

    case 55: return in.value >=	1

    case 56: return in.value	>=	1

    case 57: return in.value>= 1

    case 58: return in.value >=1

    case 59: return in.value>=1

    case 60: return in.value>= 1

    case 61: return in.value >=1

    case 62: return in.value>=1

    case 63: return in.value >= 1

    case 64: return in.value >= 1

    case 65: return in.value >= 1

    case 66: return in.value
>= 1

    case 67: return in.value >=
1

    case 68: return in.value
>=
1

    case 69: return in.value>= 1

    case 70: return in.value >=1

    case 71: return in.value>=1

    default: return false
  }
}
