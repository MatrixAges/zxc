export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 129:
            return 0.0e1
        case 130:
            return 1.1e1
        case 131:
            return 2.2e1
        case 132:
            return 3.3e1
        case 133:
            return 4.4e1
        case 134:
            return 5.5e1
        case 135:
            return 6.6e1
        case 136:
            return 7.7e1
        case 137:
            return 8.8e1
        case 138:
            return 9.9e1
        case 139:
            return 0.0E1
        case 140:
            return 1.1E1
        case 141:
            return 2.2E1
        case 142:
            return 3.3E1
        case 143:
            return 4.4E1
        case 144:
            return 5.5E1
        case 145:
            return 6.6E1
        case 146:
            return 7.7E1
        case 147:
            return 8.8E1
        case 148:
            return 9.9E1
        case 189:
            return 0.0e0
        case 190:
            return 1.1e0
        case 191:
            return 2.2e0
        case 192:
            return 3.3e0
        case 193:
            return 4.4e0
        case 194:
            return 5.5e0
        case 195:
            return 6.6e0
        case 196:
            return 7.7e0
        case 197:
            return 8.8e0
        case 198:
            return 9.9e0
        case 199:
            return 0.0E0
        case 200:
            return 1.1E0
        case 201:
            return 2.2E0
        case 202:
            return 3.3E0
        case 203:
            return 4.4E0
        case 204:
            return 5.5E0
        case 205:
            return 6.6E0
        case 206:
            return 7.7E0
        case 207:
            return 8.8E0
        case 208:
            return 9.9E0
        default:
            return 0
    }
}
