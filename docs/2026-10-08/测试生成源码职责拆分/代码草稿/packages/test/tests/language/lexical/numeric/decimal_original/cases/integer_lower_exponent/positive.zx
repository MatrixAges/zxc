export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 59:
            return 0e+1
        case 60:
            return 1e+1
        case 61:
            return 2e+1
        case 62:
            return 3e+1
        case 63:
            return 4e+1
        case 64:
            return 5e+1
        case 65:
            return 6e+1
        case 66:
            return 7e+1
        case 67:
            return 8e+1
        case 68:
            return 9e+1
        case 249:
            return 0e+01
        case 250:
            return 1e+01
        case 251:
            return 2e+01
        case 252:
            return 3e+01
        case 253:
            return 4e+01
        case 254:
            return 5e+01
        case 255:
            return 6e+01
        case 256:
            return 7e+01
        case 257:
            return 8e+01
        case 258:
            return 9e+01
        default:
            return 0
    }
}
