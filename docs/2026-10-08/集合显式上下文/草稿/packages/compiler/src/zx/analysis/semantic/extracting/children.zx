import workspace from "zig:extract_workspace"
import integers from "zig:integers"

import type { Workspace } from "zig:extract_workspace"

export type Input = { values: u32[], offset: u64, count: u64, workspace: Workspace }

export type Output = u32[]

export default function (in: Input): Output {
    const values = in.values.splice(in.offset, in.count, [])[1]

    return values.map((id, context) => integers.narrow(workspace.getMapping(context, integers.widen(id))), in.workspace)
}
