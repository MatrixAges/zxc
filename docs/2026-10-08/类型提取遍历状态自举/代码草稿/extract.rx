<Module>
    <Switch on={$in.index < $in.table.kinds.length}>
        <Case value={true}>
            <Call fn="extracting/mapped" in={{ workspace: $in.workspace, index: $in.index }} />

            <Switch on={$ctx.mapped != 0}>
                <Case value={true}>
                    <Return value={$ctx.mapped} />
                </Case>

                <Default>
                    <Call fn="extracting/include" in={$in} />

                    <Return value={$ctx.include} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Return value={0} />
        </Default>
    </Switch>
</Module>
