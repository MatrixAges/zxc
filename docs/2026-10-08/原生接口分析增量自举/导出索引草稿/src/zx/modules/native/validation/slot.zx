import hash from "../name_hash"

export type Input = { slots: string?[], name: string }

export type Output = { index: u64, found: bool }

export default function (in: Input): Output {
    const result = loop({ slots: in.slots, name: in.name, index: hash(in.name) % in.slots.length, active: true, found: false }, {
        while: current => current.active,
        next: current => {
            const name = current.slots[current.index]

            if (name == null) {
                current.active = false
            } else if (name == current.name) {
                current.found = true
                current.active = false
            } else {
                current.index = current.index + 1 == current.slots.length ? 0 : current.index + 1
            }
        }
    })

    return { index: result.index, found: result.found }
}
