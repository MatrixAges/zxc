<Module>
    <Call fn="signatures/initial" in={{ context: $in.context, functions: $in.functions, parameters: $in.parameters }} />
    <Call fn="interface/namespace" in={$in.namespace} />

    <Switch on={$ctx.namespace}>
        <Case value={true}>
            <Call fn="interface/export_index" in={$in.context.resolved.names} />
            <Call fn="interface/exports" in={{ source: $in.context.source, resolved: $in.context.resolved, slots: $ctx.export_index }} />

            <Switch on={$ctx.exports.diagnostic.message == ""}>
                <Case value={true}>
                    <Call fn="signatures/functions" in={{ resolution: $ctx.initial, functions: $in.functions, parameters: $in.parameters }} />

                    <Switch on={$ctx.functions.resolution.diagnostic.message == ""}>
                        <Case value={true}>
                            <Call fn="interface/members" in={{ source: $in.context.source.indexed.bytes, functions: $in.functions, errors: $in.errors, signatures: $ctx.functions.signatures }} />

                            <Return value={{ delta: $ctx.functions.resolution.delta, cache: $ctx.functions.resolution.cache, diagnostic: $ctx.functions.resolution.diagnostic, exports: $ctx.exports.exports, members: $ctx.members }} />
                        </Case>

                        <Default>
                            <Return value={{ delta: $ctx.functions.resolution.delta, cache: $ctx.functions.resolution.cache, diagnostic: $ctx.functions.resolution.diagnostic, exports: $ctx.exports.exports, members: [] }} />
                        </Default>
                    </Switch>
                </Case>

                <Default>
                    <Return value={{ delta: $ctx.initial.delta, cache: $ctx.initial.cache, diagnostic: $ctx.exports.diagnostic, exports: $ctx.exports.exports, members: [] }} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Return value={{ delta: $ctx.initial.delta, cache: $ctx.initial.cache, diagnostic: { code: "module", message: "native namespaces require nonempty UTF-8 member names", start: 0, end: 0 }, exports: [], members: [] }} />
        </Default>
    </Switch>
</Module>
