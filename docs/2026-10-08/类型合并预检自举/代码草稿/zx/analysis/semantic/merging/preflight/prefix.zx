import equal from "../../entries/equal"
import row from "../../entries/row"

import type { Table } from "../../types/model"

export type Input = { source: Table, target: Table, first: u64 }

export type Output = bool

export default function (in: Input): Output {
    const prefix = loop({ source: in.source, target: in.target, first: in.first, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.first,
        next: current => {
            const valid = equal({ left: row({ table: current.source, index: current.index }), right: row({ table: current.target, index: current.index }) })

            current.valid = valid
            current.index += 1
        }
    })

    return prefix.valid
}
