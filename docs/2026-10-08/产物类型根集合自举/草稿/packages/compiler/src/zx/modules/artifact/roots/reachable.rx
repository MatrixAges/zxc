<Module>
    <Call fn="collect" in={$in} />

    <Switch on={$ctx.collect.valid}>
        <Case value={true}>
            <Call fn="closure" in={{ table: $in.request.table, needed: $ctx.collect.needed }} />

            <Return value={$ctx.closure.valid ? $ctx.closure.needed : null} />
        </Case>

        <Default>
            <Return value={null} />
        </Default>
    </Switch>
</Module>
