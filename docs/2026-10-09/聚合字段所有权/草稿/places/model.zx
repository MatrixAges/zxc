export enum State { Copy, Borrowed, Owned, Loaned, Moved }

export enum Operation { Assign, Borrow, Freeze }

export type Layout = {
    parents: u64[]
    children: u64[]
    siblings: u64[]
    references: bool[]
    types: u32[]
    field_indices: u64[]
}

export type Request = { layout: Layout, states: State[], id: u64, operation: Operation, value: State }
