import { WorkAction } from "../work/model"
import iteration from "./callbacks/iteration"
import transformFinish from "./callbacks/transform_finish"
import transformStart from "./callbacks/transform_start"
import family from "./family"
import { Family } from "./model"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => current.active && current.complete && !current.failed && current.work.actions.length != 0 && family(current.work.actions[current.work.actions.length - 1]) == Family.Callbacks,
        next: current => {
            const action = current.work.actions[current.work.actions.length - 1]

            if (action == WorkAction.IterationRound || action == WorkAction.IterationAdvance || action == WorkAction.IterationInitial || action == WorkAction.IterationCondition || action == WorkAction.IterationBody || action == WorkAction.IterationFinish) {
                current = iteration(current)
            } else if (action == WorkAction.TransformTarget || action == WorkAction.TransformInitial || action == WorkAction.TransformParameter) {
                current = transformStart(current)
            } else if (action == WorkAction.TransformBody || action == WorkAction.TransformFinish) {
                current = transformFinish(current)
            }
        }
    })
}
