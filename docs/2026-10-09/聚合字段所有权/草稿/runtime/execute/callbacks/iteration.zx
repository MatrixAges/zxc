import { WorkAction } from "../../work/model"
import callback from "./iteration/callback"
import resolve from "./iteration/resolve"
import start from "./iteration/start"

import type { Machine } from "../model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    const action = in.work.actions[in.work.actions.length - 1]

    if (action == WorkAction.IterationInitial || action == WorkAction.IterationRound) {
        return start(in)
    }

    if (action == WorkAction.IterationCondition || action == WorkAction.IterationBody) {
        return callback(in)
    }

    return resolve(in)
}
