import { Operation } from "../../../places/model"
import place from "../../place"
import { Phase } from "./model"

import type { Session } from "./model"

export type Input = Session

export type Output = Session

export default function (in: Input): Output {
    const memory = place({ types: in.types, references: in.references, layout: in.layout.tree, memory: { forest: in.forest, facts: in.facts, states: in.states, memo: in.memo, trail: in.trail }, id: in.root, operation: in.permanent ? Operation.Freeze : Operation.Borrow, fact: 0 })

    return { ...in, forest: memory.forest, facts: memory.facts, states: memory.states, phase: Phase.Done }
}
