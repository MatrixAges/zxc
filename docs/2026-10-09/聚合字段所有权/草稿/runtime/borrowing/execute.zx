import { Phase } from "./execute/model"
import propagate from "./execute/propagate"
import query from "./execute/query"

import type { Table } from "../../../analysis/semantic/types/model"
import type { Expressions } from "../../../ir/canonical/expressions/model"
import type { Built } from "../../layout/model"
import type { Memory } from "../model"
import type { Session } from "./execute/model"

export type Input = { types: Table, references: bool[], expressions: Expressions, layout: Built, memory: Memory, expression: u64, permanent: bool }

export type Output = Memory

export default function (in: Input): Output {
    const initial: Session = {
        types: in.types,
        references: in.references,
        forest: in.memory.forest,
        facts: in.memory.facts,
        expressions: in.expressions,
        layout: in.layout,
        memo: in.memory.memo,
        permanent: in.permanent,
        states: in.memory.states,
        trail: in.memory.trail,
        work: [in.expression],
        cursors: [0],
        expression: 0,
        query: 0,
        position: 0,
        root: 0,
        phase: Phase.Next,
        active: true,
    }

    const result = loop(initial, {
        while: current => current.active,
        next: current => {
            if (current.phase == Phase.Next || current.phase == Phase.Query || current.phase == Phase.Descend || current.phase == Phase.Expand || current.phase == Phase.Done) {
                current = query(current)
            } else if (current.phase == Phase.Enter) {
                current = propagate(current)
            }
        }
    })

    return { forest: result.forest, facts: result.facts, states: result.states, memo: result.memo, trail: result.trail.splice(0, 0, [])[1] }
}
