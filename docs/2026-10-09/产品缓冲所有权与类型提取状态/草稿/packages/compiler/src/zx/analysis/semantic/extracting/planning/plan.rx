<Module>
    <Call module="../../validate_types" in={{ table: $in.table, scalar_count: $in.scalar_count, maximum_count: $in.maximum_count }} />
    <Call fn="valid" in={$in} />

    <Switch on={$ctx.validate_types && $ctx.valid}>
        <Case value={true}>
            <Call module="build" in={$in} />

            <Return value={$ctx.build} />
        </Case>

        <Default>
            <Return value={null} />
        </Default>
    </Switch>
</Module>
