<Module>
    <Call fn="factories/create" in={$in} />
    <Call fn="steps/patch" in={{ ...$ctx.create, columns: { left: $ctx.create.columns.left, right: $ctx.create.columns.left } }} />

    <Return value={{ columns: $ctx.patch.columns, before: { left: $in.left, right: $in.right }, original: { left: $in.left, right: $in.right }, marker: $ctx.patch.marker, rounds: $ctx.patch.round }} />
</Module>
