<Module>
    <Switch on={$in.record.has_body}>
        <Case value={true}>
            <Switch on={$in.record.body_function == null}>
                <Case value={true}>
                    <Call fn="entry_source" in={{ path: $in.record.path, file_name: $in.file_name, type_only: $in.type_only }} />

                    <Switch on={$ctx.entry_source}>
                        <Case value={true}>
                            <Call module="with_body" in={{ request: $in, body: $in.entry }} />

                            <Return value={$ctx.with_body} />
                        </Case>

                        <Default>
                            <Return value={null} />
                        </Default>
                    </Switch>
                </Case>

                <Default>
                    <Call fn="function_source" in={{ path: $in.record.path, functions: $in.functions, index: $in.record.body_function ?? 0 }} />

                    <Switch on={$ctx.function_source}>
                        <Case value={true}>
                            <Call fn="function_body" in={{ functions: $in.functions, index: $in.record.body_function ?? 0 }} />
                            <Call module="with_body" in={{ request: $in, body: $ctx.function_body }} />

                            <Return value={$ctx.with_body} />
                        </Case>

                        <Default>
                            <Return value={null} />
                        </Default>
                    </Switch>
                </Default>
            </Switch>
        </Case>

        <Default>
            <Call module="reachable" in={{ request: $in, body: null }} />

            <Return value={$ctx.reachable} />
        </Default>
    </Switch>
</Module>
