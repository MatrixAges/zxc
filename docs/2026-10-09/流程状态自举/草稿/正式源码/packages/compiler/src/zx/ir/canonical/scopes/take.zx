import type { Frame, State } from "./model"

export type Input = State

export type Output = { state: State, frame: Frame }

export default function (in: Input): Output {
    const position = in.frames.phases.length - 1
    const frame: Frame = { phase: in.frames.phases[position], a: in.frames.a[position], b: in.frames.b[position], c: in.frames.c[position] }

    return {
        state: {
            activity: in.activity,
            refinement: in.refinement,
            frames: {
                phases: in.frames.phases.pop()[0],
                a: in.frames.a.pop()[0],
                b: in.frames.b.pop()[0],
                c: in.frames.c.pop()[0]
            }
        },
        frame: frame
    }
}
