import integers from "zig:integers"

import restore from "../refinement/facts/restore"
import { Phase } from "./model"
import schedule from "./schedule"

import type { Result, State, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const control = in.context.program.body.control
    const payload = in.frame.a
    const condition = integers.widen(control.branch_conditions[payload])

    if (in.frame.phase == Phase.BranchPost) {
        const facts = restore({ facts: in.state.refinement.facts, mark: { nonnull: in.frame.b, captures: in.frame.c } })
        const restored: State = { ...in.state, refinement: { ...in.state.refinement, facts: facts } }

        const yes = in.context.prepared.returns[integers.widen(control.branch_no[payload])]
        ? schedule({ state: restored, frame: { phase: Phase.Assume, a: condition, b: 1, c: 0 } })
        : restored

        const no = in.context.prepared.returns[integers.widen(control.branch_yes[payload])]
        ? schedule({ state: yes, frame: { phase: Phase.Assume, a: condition, b: 0, c: 0 } })
        : yes

        return { state: no, valid: true }
    }

    const facts = in.state.refinement.facts.nonnull.length
    const captures = in.state.refinement.facts.capture_errors.length
    const post = schedule({ state: in.state, frame: { phase: Phase.BranchPost, a: payload, b: facts, c: captures } })
    const no_body = schedule({ state: post, frame: { phase: Phase.Block, a: integers.widen(control.branch_no[payload]), b: in.frame.b + 1, c: 0 } })
    const no_facts = schedule({ state: no_body, frame: { phase: Phase.Assume, a: condition, b: 0, c: 0 } })
    const restored = schedule({ state: no_facts, frame: { phase: Phase.RestoreFacts, a: facts, b: captures, c: 0 } })
    const yes_body = schedule({ state: restored, frame: { phase: Phase.Block, a: integers.widen(control.branch_yes[payload]), b: in.frame.b + 1, c: 0 } })
    const yes_facts = schedule({ state: yes_body, frame: { phase: Phase.Assume, a: condition, b: 1, c: 0 } })

    return { state: yes_facts, valid: true }
}
