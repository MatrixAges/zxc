import integers from "zig:integers"

import { Phase } from "./model"

import type { Program, Result } from "./model"

export type Input = Program

export type Output = Result

export default function (in: Input): Output {
    if (in.body.symbols.names.length == 0) {
        return {
            state: {
                activity: { active: [], declared: [], owners: [], changed_symbols: [], changed_values: [] },
                refinement: { facts: { nonnull: [], capture_errors: [], capture_results: [] }, conditions: [], truths: [] },
                frames: { phases: [], a: [], b: [], c: [] }
            },
            valid: false
        }
    }

    const root = in.body.root

    return {
        state: {
            activity: {
                active: in.body.symbols.names.map((value, index) => index == 0),
                declared: in.body.symbols.names.map((value, index) => index == 0),
                owners: in.body.symbols.names.map(value => 0),
                changed_symbols: [],
                changed_values: []
            },
            refinement: { facts: { nonnull: [], capture_errors: [], capture_results: [] }, conditions: [], truths: [] },
            frames: {
                phases: root == null ? [] : [Phase.Block],
                a: root == null ? [] : [integers.widen(root)],
                b: root == null ? [] : [0],
                c: root == null ? [] : [0]
            }
        },
        valid: true
    }
}
