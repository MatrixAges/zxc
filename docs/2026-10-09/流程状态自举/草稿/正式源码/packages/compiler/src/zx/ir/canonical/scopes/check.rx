<Module>
    <Call fn="./initialize" in={$in.program} />

    <Switch on={$ctx.initialize.valid}>
        <Case value={true}>
            <Call fn="./walk" in={{ context: $in, state: $ctx.initialize.state }} />

            <Switch on={$ctx.walk.valid}>
                <Case value={true}>
                    <Call fn="./declared" in={$ctx.walk.state.activity.declared} />

                    <Switch on={$ctx.declared}>
                        <Case value={true}>
                            <Call fn="./returned" in={$in} />

                            <Return value={$ctx.returned} />
                        </Case>

                        <Default>
                            <Return value={false} />
                        </Default>
                    </Switch>
                </Case>

                <Default>
                    <Return value={false} />
                </Default>
            </Switch>
        </Case>

        <Default>
            <Return value={false} />
        </Default>
    </Switch>
</Module>
