import integers from "zig:integers"

import { BinaryOperator, ExpressionKind, UnaryOperator } from "../expressions/kinds"
import compare from "./compare"

import type { Expressions } from "../expressions/model"
import type { Refinement } from "./model"

export type Input = { state: Refinement, expressions: Expressions, condition: u64, truth: bool }

export type Output = Refinement

export default function (in: Input): Output {
    const initial: Refinement = {
        facts: in.state.facts,
        conditions: in.state.conditions.push(in.condition)[0],
        truths: in.state.truths.push(in.truth)[0]
    }

    return loop({ state: initial, expressions: in.expressions }, {
        while: current => current.state.conditions.length != 0,
        next: current => {
            const position = current.state.conditions.length - 1
            const condition = current.state.conditions[position]
            const truth = current.state.truths[position]

            current.state.conditions = current.state.conditions.pop()[0]
            current.state.truths = current.state.truths.pop()[0]

            const expressions = current.expressions
            const kind = expressions.kinds[condition]
            const payload = integers.widen(expressions.payloads[condition])

            if (kind == ExpressionKind.Unary && expressions.unary_operators[payload] == UnaryOperator.Not) {
                current.state.conditions = current.state.conditions.push(integers.widen(expressions.unary_operands[payload]))[0]
                current.state.truths = current.state.truths.push(!truth)[0]
            } else if (kind == ExpressionKind.Binary) {
                const operator = expressions.binary_operators[payload]

                if ((operator == BinaryOperator.LogicalAnd && truth) || (operator == BinaryOperator.LogicalOr && !truth)) {
                    current.state.conditions = current.state.conditions.push(integers.widen(expressions.binary_right[payload]))[0]
                    current.state.conditions = current.state.conditions.push(integers.widen(expressions.binary_left[payload]))[0]
                    current.state.truths = current.state.truths.push(truth)[0]
                    current.state.truths = current.state.truths.push(truth)[0]
                } else {
                    current.state.facts = compare({ facts: current.state.facts, expressions: expressions, payload: payload, truth: truth })
                }
            }
        }
    }).state
}
