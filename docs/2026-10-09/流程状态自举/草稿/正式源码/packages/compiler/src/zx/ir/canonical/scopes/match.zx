import integers from "zig:integers"

import { Phase } from "./model"
import schedule from "./schedule"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const program = in.context.program
    const expressions = program.body.expressions
    const payload = integers.widen(expressions.payloads[in.frame.a])
    const depth = in.frame.b + 1
    const fallback = schedule({ state: in.state, frame: { phase: Phase.Expression, a: integers.widen(expressions.match_fallbacks[payload]), b: depth, c: in.frame.c } })

    const cases = loop({ state: fallback, expressions: expressions, first: integers.widen(expressions.match_first[payload]), index: integers.widen(expressions.match_count[payload]), depth: depth, flags: in.frame.c }, {
        while: current => current.index != 0,
        next: current => {
            current.index -= 1

            const position = current.first + current.index
            const expressions = current.expressions

            current.state = schedule({ state: current.state, frame: { phase: Phase.Expression, a: integers.widen(expressions.match_results[position]), b: current.depth, c: current.flags } })
            current.state = schedule({ state: current.state, frame: { phase: Phase.Expression, a: integers.widen(expressions.match_conditions[position]), b: current.depth, c: current.flags } })
        }
    }).state

    const subject = expressions.match_subjects[payload]

    return {
        state: subject == null ? cases : schedule({ state: cases, frame: { phase: Phase.Expression, a: integers.widen(subject), b: depth, c: in.frame.c } }),
        valid: true
    }
}
