import { ExpressionKind } from "../expressions/kinds"
import capture from "./facts/capture"

import type { Expressions } from "../expressions/model"
import type { Facts } from "./facts/model"

export type Input = { facts: Facts, expressions: Expressions, value: u64, count: u64, err: u32?, result: u32? }

export type Output = Facts

export default function (in: Input): Output {
    const err = in.err
    const result = in.result

    if (in.expressions.kinds[in.value] == ExpressionKind.Capture && in.count == 2 && err != null && result != null) {
        return capture({ facts: in.facts, err: err, result: result })
    }

    return in.facts
}
