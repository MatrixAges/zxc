import assume from "../refinement/assume"
import restoreFacts from "../refinement/facts/restore"
import restoreActivity from "./activity/restore"
import block from "./block"
import branch from "./branch"
import callback from "./callback"
import declare from "./declare"
import destructure from "./destructure"
import expression from "./expression"
import { Declaration, Phase } from "./model"
import selection from "./selection"

import type { Result, Step } from "./model"

export type Input = Step

export type Output = Result

export default function (in: Input): Output {
    const frame = in.frame
    const program = in.context.program
    const state = in.state

    if (frame.phase == Phase.Restore) {
        const activity = restoreActivity({ activity: state.activity, mark: frame.a })
        const facts = restoreFacts({ facts: state.refinement.facts, mark: { nonnull: frame.b, captures: frame.c } })

        return { state: { ...state, activity: activity, refinement: { ...state.refinement, facts: facts } }, valid: true }
    }

    if (frame.phase == Phase.RestoreFacts) {
        const facts = restoreFacts({ facts: state.refinement.facts, mark: { nonnull: frame.a, captures: frame.b } })

        return { state: { ...state, refinement: { ...state.refinement, facts: facts } }, valid: true }
    }

    if (frame.phase == Phase.Assume) {
        const refinement = assume({ state: state.refinement, expressions: program.body.expressions, condition: frame.a, truth: frame.b != 0 })

        return { state: { ...state, refinement: refinement }, valid: true }
    }

    return match frame.phase {
        Phase.Block => block(in),
        Phase.BlockNext => block(in),
        Phase.Expression => expression(in),
        Phase.Declare => declare({ program: program, state: state, symbol: frame.a, type_id: program.body.expressions.types[frame.b], owner: 0, mode: Declaration.Ordinary }),
        Phase.ScopeDeclare => declare({ program: program, state: state, symbol: frame.a, type_id: 0, owner: frame.b, mode: Declaration.Scope }),
        Phase.Destructure => destructure(in),
        Phase.Branch => branch(in),
        Phase.BranchPost => branch(in),
        Phase.Switch => selection(in),
        Phase.IterationCondition => callback(in),
        Phase.IterationBody => callback(in),
        Phase.Transform => callback(in),
        _ => { state: state, valid: false }
    }
}
