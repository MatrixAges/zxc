import type { Frame, State } from "./model"

export type Input = { state: State, frame: Frame }

export type Output = State

export default function (in: Input): Output {
    return {
        activity: in.state.activity,
        refinement: in.state.refinement,
        frames: {
            phases: in.state.frames.phases.push(in.frame.phase)[0],
            a: in.state.frames.a.push(in.frame.a)[0],
            b: in.state.frames.b.push(in.frame.b)[0],
            c: in.state.frames.c.push(in.frame.c)[0]
        }
    }
}
