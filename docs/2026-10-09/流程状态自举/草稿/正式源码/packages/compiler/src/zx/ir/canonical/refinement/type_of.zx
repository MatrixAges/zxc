import integers from "zig:integers"

import kind from "../../../analysis/semantic/types/kind"
import { Kind } from "../../../analysis/semantic/types/model"
import contains from "./facts/contains"

import type { Table } from "../../../analysis/semantic/types/model"
import type { Facts } from "./facts/model"

export type Input = { facts: Facts, table: Table, type_id: u32, symbol: u32 }

export type Output = u32

export default function (in: Input): Output {
    const index = integers.widen(in.type_id)

    return kind(in.table.kinds[index]) == Kind.Optional && contains({ facts: in.facts, symbol: in.symbol }) ? in.table.first[index] : in.type_id
}
