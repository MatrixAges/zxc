import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const count = in.origins.ids.length

    return in.scalar_count <= in.table.kinds.length &&
        in.roots.length == in.table.kinds.length &&
        in.origins.kinds.length == count &&
        in.origins.owners.length == count &&
        in.origins.members.length == count &&
        in.names.length == count
}
