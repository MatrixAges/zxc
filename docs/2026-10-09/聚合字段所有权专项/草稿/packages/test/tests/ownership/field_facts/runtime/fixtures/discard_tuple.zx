import seed from "./seed_tuple"

export type Input = { values: u64[], count: u64, choice: bool }

export type Output = u64

export default function (in: Input): Output {
    loop(seed({ meta: { index: 0, limit: in.count }, pair: [0, true], values: in.values }), {
        while: state => state.meta.index < state.meta.limit,
        next: state => {
            state.pair[0] += state.values[state.meta.index]
            state.pair[1] = !state.pair[1]
            state.meta.index += 1
        }
    })

    return in.count
}
