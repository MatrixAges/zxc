import seed from "./seed_optional"

export type Input = { values: u64[], count: u64, choice: bool }

export type Output = u64

export default function (in: Input): Output {
    loop(seed({ meta: { index: 0, limit: in.count }, previous: in.choice ? { value: 0 } : null, values: in.values }), {
        while: state => state.meta.index < state.meta.limit,
        next: state => {
            const previous = state.previous

            if (previous != null) {
                state.previous = { value: previous.value + state.values[state.meta.index] }
            } else {
                state.previous = { value: state.values[state.meta.index] }
            }

            state.meta.index += 1
        }
    })

    return in.count
}
