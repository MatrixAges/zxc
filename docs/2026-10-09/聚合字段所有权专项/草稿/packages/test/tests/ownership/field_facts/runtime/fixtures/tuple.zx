export type Input = { values: u64[], count: u64, choice: bool }

export type Output = { fresh: u64[], view: u64[] }

export default function (in: Input): Output {
    const fresh = in.values.map(item => item + 1)

    const box: [u64[], u64[]] = match in.choice {
        true => [fresh, in.values],
        _ => [fresh, fresh]
    }

    return { fresh: box[0], view: box[1] }
}
