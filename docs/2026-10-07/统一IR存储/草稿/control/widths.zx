import type { Control } from "./model"

export type Input = Control

export type Output = bool

export default function (in: Input): Output {
    if (in.statement_kinds.length != in.statement_payloads.length) {
        return false
    }

    if (in.constant_values.length != in.constant_symbols.length) {
        return false
    }

    if (in.parallel_first.length != in.parallel_count.length) {
        return false
    }

    if (in.parallel_values.length != in.parallel_symbols.length) {
        return false
    }

    if (in.destructure_values.length != in.destructure_first.length || in.destructure_values.length != in.destructure_count.length) {
        return false
    }

    if (in.branch_conditions.length != in.branch_yes.length || in.branch_conditions.length != in.branch_no.length) {
        return false
    }

    if (in.selection_subjects.length != in.selection_first.length || in.selection_subjects.length != in.selection_count.length || in.selection_subjects.length != in.selection_exhaustive.length) {
        return false
    }

    if (in.case_values.length != in.case_bodies.length) {
        return false
    }

    if (in.setter_slots.length != in.setter_values.length) {
        return false
    }

    if (in.block_first.length != in.block_count.length) {
        return false
    }

    return true
}
