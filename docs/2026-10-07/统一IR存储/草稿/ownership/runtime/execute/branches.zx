import { WorkAction } from "../work/model"
import binary from "./branches/binary"
import conditional from "./branches/conditional"
import matchFlow from "./branches/match"
import selection from "./branches/selection"
import statement from "./branches/statement"
import family from "./family"
import { Family } from "./model"

import type { Machine } from "./model"

export type Input = Machine

export type Output = Machine

export default function (in: Input): Output {
    return loop(in, {
        while: current => current.active && current.complete && !current.failed && current.work.actions.length != 0 && family(current.work.actions[current.work.actions.length - 1]) == Family.Branches,
        next: current => {
            const action = current.work.actions[current.work.actions.length - 1]

            if (action == WorkAction.BranchCondition || action == WorkAction.BranchYes || action == WorkAction.BranchNo) {
                current = statement(current)
            } else if (action == WorkAction.SwitchSubject || action == WorkAction.SwitchCase || action == WorkAction.SwitchResult) {
                current = selection(current)
            } else if (action == WorkAction.MatchSubject || action == WorkAction.MatchArm || action == WorkAction.MatchCondition || action == WorkAction.MatchResult || action == WorkAction.MatchFinish) {
                current = matchFlow(current)
            } else if (action == WorkAction.BinaryLeft || action == WorkAction.BinaryRight) {
                current = binary(current)
            } else if (action == WorkAction.ConditionalCondition || action == WorkAction.ConditionalYes || action == WorkAction.ConditionalNo) {
                current = conditional(current)
            }
        }
    })
}
