import ensure from "./project/ensure"
import expression from "./project/expression"
import { Phase } from "./project/model"
import path from "./project/path"
import rehash from "./project/rehash"

import type { Program } from "../ir/input_model"
import type { Built, Roots } from "./model"
import type { Session } from "./project/model"

export type Input = { program: Program, references: bool[], roots: Roots }

export type Output = Built

export default function (in: Input): Output {
    const empty: u64[] = []

    const initial: Session = {
        program: in.program,
        references: in.references,
        cached: in.roots.cached,
        heads: in.roots.heads,
        next: in.roots.next,
        parents: in.roots.tree.parents,
        children: in.roots.tree.children,
        siblings: in.roots.tree.siblings,
        reference_flags: in.roots.tree.references,
        bindings: empty,
        slots: empty,
        key_parents: empty,
        key_fields: empty,
        values: empty,
        path: empty,
        phase: Phase.Expression,
        expression: 0,
        ancestor: 0,
        record: 0,
        path_index: 0,
        parent: 0,
        child_expression: 0,
        direct: false,
        capacity: 0,
        cursor: 0,
        active: true,
    }

    const result = loop(initial, {
        while: current => current.active,
        next: current => {
            if (current.phase == Phase.Expression) {
                current = expression(current)
            } else if (current.phase == Phase.AncestorStart || current.phase == Phase.Ancestor || current.phase == Phase.Root || current.phase == Phase.Path) {
                current = path(current)
            } else if (current.phase == Phase.Ensure) {
                current = ensure(current)
            } else if (current.phase == Phase.Grow || current.phase == Phase.Clear || current.phase == Phase.Rehash) {
                current = rehash(current)
            }
        }
    })

    return { tree: { parents: result.parents, children: result.children, siblings: result.siblings, references: result.reference_flags }, cached: result.cached, slots: result.slots, parents: result.key_parents, fields: result.key_fields, values: result.values }
}
