import integers from "zig:integers"

import kind from "../types/kind"
import { Kind } from "../types/model"

import type { Table } from "../types/model"

export type Input = { types: Table, id: u64 }

export type Output = bool

export default function (in: Input): Output {
    const result = loop({ types: in.types, id: in.id }, {
        while: current => kind(current.types.kinds[current.id]) == Kind.Optional,
        next: current => {
            current.id = integers.widen(current.types.first[current.id])
        }
    })

    const type_kind = kind(result.types.kinds[result.id])

    return type_kind == Kind.List || type_kind == Kind.Object || type_kind == Kind.Tuple || type_kind == Kind.Task || (type_kind == Kind.Scalar && result.types.first[result.id] == 10)
}
