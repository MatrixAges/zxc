export type Input = { left: f32, right: f32 }

export type Output = { scalar: f32, field: f32, element: f32 }

export default function (in: Input): Output {
    const initial = { scalar: in.left, box: { value: in.left }, values: [in.left], right: in.right, round: 0 }

    const result = loop(initial, {
        while: state => state.round < 1,
        next: state => {
            state.scalar %= state.right
            state.box.value %= state.right
            state.values[0] %= state.right

            state.round += 1
        }
    })

    return { scalar: result.scalar, field: result.box.value, element: result.values[0] }
}
