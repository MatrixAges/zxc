import binding from "./binding"
import unique from "./unique"

import type { Table } from "../../model"
import type { Bindings } from "../model"

export type Input = { table: Table, origins: Bindings, names: string[], index: u64 }

export type Output = bool

export default function (in: Input): Output {
    return binding(in) && unique({ origins: in.origins, names: in.names, index: in.index })
}
