import encode from "../types/nominal/encode"
import find from "../types/nominal/find"
import bindings from "./bindings"
import candidate from "./candidate"
import table from "./table"

import type { Writer } from "zig:merge_writer"
import type { Table } from "../types/model"
import type { Bindings } from "../types/nominal/model"

export type Input = { source: Table, index: u64, writer: Writer, origins: Bindings, origin: u64 }

export type Output = u64

export default function (in: Input): Output {
    const result = find({
        tables: { base: table(in.writer), delta: { kinds: [], first: [], second: [], labels: [], children: [], field_types: [], field_names: [], names: [] } },
        origins: { base: bindings(in.writer), delta: { ids: [], kinds: [], owners: [], members: [] } },
        origin: { kind: in.origins.kinds[in.origin], owner: in.origins.owners[in.origin], member: in.origins.members[in.origin] },
        candidate: candidate({ source: in.source, index: in.index, writer: in.writer })
    })

    return encode(result)
}
