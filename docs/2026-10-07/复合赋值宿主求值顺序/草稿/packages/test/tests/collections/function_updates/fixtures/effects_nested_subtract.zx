import probe from "zig:probe"

import type { PatchInput } from "./types"

export type Input = PatchInput

export type Output = i64[]

export default function (in: Input): Output {
    const initial = { ...in, round: 0, boxes: [{ values: in.values }] }

    const result = loop(initial, {
        while: state => state.round < state.count,
        next: state => {
            state.boxes[0].values = probe.source(state.boxes[0].values)
            state.boxes[probe.container(state.enabled ? 0 : 1)].values[probe.index(state.selected)] -= probe.value(state.delta)

            state.round = probe.after(state.round) + 1
        }
    })

    return result.boxes[0].values
}
