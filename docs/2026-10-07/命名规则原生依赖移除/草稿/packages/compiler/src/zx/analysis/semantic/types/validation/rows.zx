import row from "./row"

import type { Table } from "../model"

export type Input = { table: Table, scalar_count: u64 }

export type Output = bool

export default function (in: Input): Output {
    if (in.table.kinds.length < in.scalar_count) {
        return false
    }

    const state = loop({ table: in.table, scalar_count: in.scalar_count, index: 0, valid: true }, {
        while: current => current.valid && current.index < current.table.kinds.length,
        next: current => {
            current.valid = row({ table: current.table, index: current.index, scalar_count: current.scalar_count })
            current.index += 1
        }
    })

    return state.valid
}
