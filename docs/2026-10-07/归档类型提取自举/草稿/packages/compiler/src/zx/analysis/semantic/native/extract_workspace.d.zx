export type Workspace = opaque

export declare function hasMapping(workspace: Workspace, index: u64): bool

export declare function getMapping(workspace: Workspace, index: u64): u64

export declare function setMapping(workspace: Workspace, index: u64, value: u64): void

export declare function push(workspace: Workspace, index: u64, ready: bool): void throws { OutOfMemory }

export declare function length(workspace: Workspace): u64

export declare function lastId(workspace: Workspace): u64

export declare function lastReady(workspace: Workspace): bool

export declare function pop(workspace: Workspace): void

export declare function prepareReferences(workspace: Workspace, count: u64, dynamic: bool): void throws { OutOfMemory }

export declare function appendType(workspace: Workspace, index: u64): u64 throws { OutOfMemory }

export declare function appendOrigin(workspace: Workspace, index: u64, origin: u64): void throws { OutOfMemory }
