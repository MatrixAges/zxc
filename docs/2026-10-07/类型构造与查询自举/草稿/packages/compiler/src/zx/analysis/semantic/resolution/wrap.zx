import workspace from "zig:resolution"

import { Kind } from "../types/model"
import intern from "./intern"
import validate from "./validate"

import type { Workspace } from "zig:resolution"

export type Input = Workspace

export type Output = void

export default function (in: Input): Output {
    validate({ workspace: in, kind: workspace.isList(in) ? Kind.List : Kind.Optional })

    workspace.setResult(in, intern({ workspace: in, kind: workspace.isList(in) ? Kind.List : Kind.Optional }))
    workspace.pop(in)

    return
}
