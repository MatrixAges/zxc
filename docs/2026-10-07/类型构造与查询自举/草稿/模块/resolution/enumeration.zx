import { Message } from "zig:resolution"
import workspace from "zig:resolution"

import type { Workspace } from "zig:resolution"

export type Input = Workspace

export type Output = void

export default function (in: Input): Output {
    const count = workspace.memberCount(in)

    if (count == 0) {
        workspace.failType(in, workspace.declaredStart(in), workspace.declaredEnd(in), Message.EmptyEnum)
    }

    workspace.allocateMembers(in, count)

    loop({ workspace: in, count: count, index: 0 }, {
        while: current => current.index < current.count,
        next: current => {
            const name = workspace.memberName(current.workspace, current.index)

            loop({ workspace: current.workspace, name: name, member: current.index, index: 0 }, {
                while: previous => previous.index < previous.member,
                next: previous => {
                    if (workspace.fieldNames(previous.workspace)[previous.index] == previous.name) {
                        workspace.failName(previous.workspace, workspace.memberStart(previous.workspace, previous.member), workspace.memberEnd(previous.workspace, previous.member), Message.DuplicateMember)
                    }

                    previous.index += 1
                }
            })

            workspace.saveMember(current.workspace, current.index)
            current.index += 1
        }
    })

    workspace.setResult(in, workspace.appendEnumeration(in))

    return
}
