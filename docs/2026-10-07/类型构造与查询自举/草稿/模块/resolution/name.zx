import { Message } from "zig:resolution"
import workspace from "zig:resolution"

import builtin from "./builtin"
import enumeration from "./enumeration"

import type { Workspace } from "zig:resolution"

export type Input = Workspace

export type Output = void

export default function (in: Input): Output {
    const name = workspace.name(in)
    const scalar = builtin(name)

    if (scalar != 0) {
        workspace.setResult(in, scalar - 1)
        workspace.pop(in)

        return
    }

    const resolved = workspace.resolved(in)

    if (resolved != 0) {
        workspace.setResult(in, resolved - 1)
        workspace.pop(in)

        return
    }

    const alias = loop({ workspace: in, name: name, index: 0, result: 0 }, {
        while: current => current.result == 0 && current.index < workspace.aliasCount(current.workspace),
        next: current => {
            if (workspace.aliasName(current.workspace, current.index) == current.name) {
                current.result = workspace.aliasType(current.workspace, current.index) + 1
            }

            current.index += 1
        }
    })

    if (alias.result != 0) {
        workspace.setResult(in, alias.result - 1)
        workspace.pop(in)

        return
    }

    if (workspace.visiting(in)) {
        workspace.failType(in, workspace.nameStart(in), workspace.nameEnd(in), Message.Recursive)
    }

    if (workspace.visitingCount(in) >= 256) {
        workspace.failUnsupported(in, workspace.nameStart(in), workspace.nameEnd(in), Message.Depth)
    }

    const declaration = loop({ workspace: in, name: name, index: 0, found: 0 }, {
        while: current => current.found == 0 && current.index < workspace.declarationCount(current.workspace),
        next: current => {
            if (workspace.declarationName(current.workspace, current.index) == current.name) {
                current.found = current.index + 1
            }

            current.index += 1
        }
    })

    if (declaration.found == 0) {
        workspace.failName(in, workspace.nameStart(in), workspace.nameEnd(in), Message.Unknown)

        return
    }

    workspace.enter(in)
    workspace.setOperation(in, 1)
    workspace.selectDeclaration(in, declaration.found - 1)

    const kind = workspace.nodeKind(in)

    if (workspace.nativeInterface(in) && kind == 0 && workspace.nodeName(in) == "opaque") {
        workspace.setResult(in, workspace.appendNative(in))
    } else if (kind == 5) {
        enumeration(in)
    } else {
        workspace.pushValue(in)
    }

    return
}
