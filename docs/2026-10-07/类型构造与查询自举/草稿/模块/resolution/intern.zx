import integers from "zig:integers"
import workspace from "zig:resolution"

import find from "../types/find"
import { Kind } from "../types/model"
import candidate from "./candidate"
import table from "./table"

import type { Workspace } from "zig:resolution"

export type Input = { workspace: Workspace, kind: Kind }

export type Output = u64

export default function (in: Input): Output {
    const result = find({
        tables: { base: table(in.workspace), delta: { kinds: [], first: [], second: [], labels: [], children: [], field_types: [], field_names: [], names: [] } },
        candidate: candidate(in)
    })

    if (result.found) {
        return integers.widen(result.id)
    }

    return match in.kind {
        Kind.Optional => workspace.appendOptional(in.workspace),
        Kind.List => workspace.appendList(in.workspace),
        Kind.Tuple => workspace.appendTuple(in.workspace),
        _ => workspace.appendObject(in.workspace)
    }
}
