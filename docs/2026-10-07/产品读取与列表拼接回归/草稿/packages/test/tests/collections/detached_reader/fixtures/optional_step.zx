import read from "./read"

import type { State, StepInput } from "./model"

export type Input = StepInput

export type Output = State

export default function (in: Input): Output {
    const selected = in.state.values.length == 0 ? 0 : in.item % in.state.values.length
    const old = read({ values: in.state.values, selected: selected }) ?? { value: 0, label: in.state.label }

    return { values: in.state.values.push({ value: old.value + in.item + 1, label: old.label })[0], seen: in.state.seen + old.value, label: old.label, count: in.state.count + 1 }
}
