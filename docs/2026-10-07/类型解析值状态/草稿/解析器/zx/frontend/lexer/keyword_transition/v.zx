export type Input = { state: u64, byte: u8 }

export type Output = u64

export default function (in: Input): Output {
    switch (in.state) {
        case 212: return match {
            in.byte == 97 => 213,
            _ => 1
        }
        case 213: return match {
            in.byte == 114 => 214,
            _ => 1
        }
        default: return 1
    }
}
