import begin from "./begin"
import comment from "./comment"
import endIdentifier from "./end_identifier"
import isLetter from "./is_letter"
import keywordTransition from "./keyword_transition"
import { Mode } from "./model"
import number from "./number"
import isDigit from "./number/is_digit"
import string from "./string"
import template from "./template/advance"

import type { AdvanceInput, LexerState } from "./model"

export type Input = AdvanceInput

export type Output = LexerState

export default function (in: Input): Output {
    if (in.state.offset < in.state.skip_until) {
        return in.state
    }

    if (in.state.mode == Mode.Idle) {
        return begin(in)
    }

    if (in.state.mode == Mode.Identifier) {
        if (isLetter(in.byte) || isDigit(in.byte) || in.byte == 95) {
            const next_keyword = keywordTransition({ state: in.state.keyword_state, byte: in.byte })

            return { ...in.state, keyword_state: next_keyword }
        }

        const ended = endIdentifier(in.state)

        return begin({ byte: in.byte, next: in.next, after: in.after, has_next: in.has_next, has_after: in.has_after, state: ended })
    }

    if (in.state.mode == Mode.Number) {
        return number(in)
    }

    if (in.state.mode == Mode.String || in.state.mode == Mode.StringEscape) {
        return string(in)
    }

    if (in.state.mode == Mode.LineComment || in.state.mode == Mode.BlockComment) {
        return comment(in)
    }

    return template(in)
}
