import type { Diagnostic, Result } from "../../lexer/model"
import type { Span } from "../../lexer/token_model"
import type { State, Declaration } from "../declarations/model"
import type { Tree, Order } from "../types/model"

export enum Phase { Declarations, Start, Declare, Function, Name, Open, Inject, Parameter, Colon, ParameterType, Separator, OutputColon, OutputType, Throws, ErrorOpen, ErrorName, ErrorSeparator, Concurrent, End, Done }

export type Function = {
    name: Span,
    first_parameter: u64,
    count: u64,
    output: u64,
    allocator_argument: bool,
    io_argument: bool,
    process_argument: bool,
    fallible: bool,
    errors_present: bool,
    first_error: u64,
    error_count: u64,
    concurrent: bool
}

export type Parameter = { name: Span, value: u64 }

export type Control = { phase: Phase, index: u64, injected: u64, parameter: Span, current: Function, diagnostic: Diagnostic }

export type NativeState = { lexed: Result, declarations: State, functions: Function[], parameters: Parameter[], errors: Span[], control: Control }

export type NativeOutput = {
    types: Tree,
    type_order: Order,
    declarations: Declaration[],
    members: Span[],
    functions: Function[],
    parameters: Parameter[],
    errors: Span[],
    diagnostic: Diagnostic
}
