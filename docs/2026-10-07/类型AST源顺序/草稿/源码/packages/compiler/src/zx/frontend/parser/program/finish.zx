import order from "../types/order"
import diagnostic from "./diagnostic"

import type { Program } from "../syntax/model"
import type { BodyStage } from "./body/model"

export type Input = BodyStage

export type Output = Program

export default function (in: Input): Output {
    const issue = diagnostic(in)
    const lexical = in.body.expression.prepared.lexical.lexed

    return {
        types: in.body.expression.types.tree,
        type_order: order(in.body.expression.types.tree),
        expressions: in.body.expression.tree,
        blocks: in.body.tree,
        tokens: lexical.tokens,
        comments: lexical.comments,
        imports: in.prefix.imports,
        import_names: in.prefix.names,
        declarations: in.prefix.declarations,
        members: in.prefix.members,
        contracts: in.contracts,
        has_store: in.header.has_store,
        function_start: in.prefix.function_start,
        body: in.prefix.present ? in.body.control.result : null,
        diagnostic: issue
    }
}
