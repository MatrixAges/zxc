export type Input = f64

export type Output = f64

export default function (in: Input): Output {
    const initial = { obj: { extends: in }, round: 0 }

    const result = loop(initial, {
        while: state => state.round < 1,
        next: state => {
            state.obj.extends = 42

            state.round += 1
        }
    })

    return result.obj.extends
}
