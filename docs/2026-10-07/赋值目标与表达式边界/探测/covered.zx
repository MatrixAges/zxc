export type Input = f64

export type Output = f64

export default function (in: Input): Output {
    const initial = { value: in, extends: in, round: 0 }

    const result = loop(initial, {
        while: state => state.round < 1,
        next: state => {
            (state.value) = 1

            state.round += 1
        }
    })

    return result.value
}
