export type Input = string

export type Output = string

export default function (in: Input): Output {
    const initial = { value: in, round: 0 }

    const result = loop(initial, {
        while: state => state.round < 1,
        next: state => {
            state.value	=	"U+0009"

            state.round += 1
        }
    })

    return result.value
}
