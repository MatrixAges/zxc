export type Input = bool

export type Output = bool

export default function (in: Input): Output {
    const initial = { value: false, extends: false, round: 0 }

    const result = loop(initial, {
        while: state => state.round < 1,
        next: state => {
            state.value
=
true

            state.round += 1
        }
    })

    return result.value
}
