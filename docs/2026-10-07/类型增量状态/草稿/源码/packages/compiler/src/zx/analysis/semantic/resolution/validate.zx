import { Message } from "zig:resolution"
import workspace from "zig:resolution"

import container from "../types/container"
import { Violation } from "../types/container_model"
import candidate from "./candidate"
import table from "./table"

import type { Workspace } from "zig:resolution"
import type { Kind, Table } from "../types/model"

export type Input = { workspace: Workspace, kind: Kind }

export type Output = void

export default function (in: Input): Output {
    const empty: Table = { kinds: [], first: [], second: [], labels: [], children: [], field_types: [], field_names: [], names: [] }
    const violation = container({ tables: { base: table(in.workspace), delta: empty }, candidate: candidate(in) })

    if (violation == Violation.TaskContainer) {
        workspace.failOwnership(in.workspace, 0, 0, Message.TaskContainer)
    } else if (violation == Violation.VoidList) {
        workspace.failType(in.workspace, 0, 0, Message.VoidList)
    } else if (violation == Violation.TaskTuple) {
        workspace.failOwnership(in.workspace, 0, 0, Message.TaskTuple)
    } else if (violation == Violation.TaskObject) {
        workspace.failOwnership(in.workspace, 0, 0, Message.TaskObject)
    }

    return
}
