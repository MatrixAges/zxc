import { Message } from "zig:resolution"
import workspace from "zig:resolution"

import type { Workspace } from "zig:resolution"

export type Input = Workspace

export type Output = void

export default function (in: Input): Output {
    const kind = workspace.nodeKind(in)

    if (kind == 0) {
        workspace.readName(in)
        workspace.setOperation(in, 0)
    } else if (kind == 2 || kind == 3 || kind == 6) {
        if (kind == 6 && workspace.nodeName(in) != "Array") {
            workspace.readName(in)
            workspace.failUnsupported(in, workspace.nameStart(in), workspace.nameEnd(in), Message.Application)
        }

        workspace.setList(in, kind != 2)
        workspace.setOperation(in, 3)
        workspace.pushChild(in)
    } else if (kind == 4) {
        workspace.allocateChildren(in, workspace.itemCount(in))
        workspace.setPosition(in, workspace.firstItem(in))
        workspace.setOperation(in, 4)
    } else if (kind == 1) {
        workspace.allocateFields(in, workspace.fieldCount(in))
        workspace.setPosition(in, workspace.firstField(in))
        workspace.setOperation(in, 5)
    } else {
        workspace.failType(in, 0, 0, Message.AnonymousEnum)
    }

    return
}
