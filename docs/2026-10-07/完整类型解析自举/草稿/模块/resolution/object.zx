import integers from "zig:integers"
import { Message } from "zig:resolution"
import workspace from "zig:resolution"

import { Kind } from "../types/model"
import intern from "./intern"

import type { Workspace } from "zig:resolution"

export type Input = Workspace

export type Output = void

export default function (in: Input): Output {
    if (workspace.waiting(in)) {
        if (workspace.result(in) == 0) {
            workspace.failType(in, workspace.nameStart(in), workspace.nameEnd(in), Message.VoidField)
        }

        workspace.saveField(in)
        workspace.setIndex(in, workspace.frameIndex(in) + 1)
        workspace.nextField(in)
        workspace.setWaiting(in, false)
    }

    if (workspace.frameIndex(in) == workspace.fieldCount(in)) {
        loop({ workspace: in, index: 0 }, {
            while: current => current.index < workspace.fieldCount(current.workspace),
            next: current => {
                if (workspace.typeKind(current.workspace, integers.widen(workspace.fieldTypes(current.workspace)[current.index])) == 6) {
                    workspace.failOwnership(current.workspace, 0, 0, Message.TaskObject)
                }

                current.index += 1
            }
        })

        workspace.sortFields(in)
        workspace.setResult(in, intern({ workspace: in, kind: Kind.Object }))
        workspace.pop(in)

        return
    }

    workspace.readFieldName(in)

    loop({ workspace: in, index: 0, count: workspace.frameIndex(in), name: workspace.name(in) }, {
        while: previous => previous.index < previous.count,
        next: previous => {
            if (workspace.fieldNames(previous.workspace)[previous.index] == previous.name) {
                workspace.failName(previous.workspace, workspace.nameStart(previous.workspace), workspace.nameEnd(previous.workspace), Message.DuplicateField)
            }

            previous.index += 1
        }
    })

    workspace.setWaiting(in, true)
    workspace.pushField(in)

    return
}
