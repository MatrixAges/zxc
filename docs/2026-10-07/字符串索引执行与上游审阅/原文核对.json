    "files": [
        {
            "path": "test/built-ins/String/15.5.5.5.2-1-1.js",
            "sha256": "b0348d870502431c89059cd1247415712d7c8d657cbf522440352776823e205a",
            "observations": ["new String(\"hello world\") 上设置 foo=1，然后 s[\"foo\"]===1。"],
            "reason": "String wrapper 的动态数据属性与字符串键查找。ZX string 是字节切片，不可增加 foo，索引要求 u64；不能用普通对象 foo 字段代替 String exotic receiver。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-1-2.js",
            "sha256": "274719c9e208ee3bee67bb1755988491f82712e23488b435403463f24838db90",
            "observations": ["primitive String(\"hello world\") 的 s[\"foo\"]===undefined。"],
            "reason": "非数字 property key 与 primitive 装箱后的缺失属性返回 undefined。ZX 不支持 string-key 索引，静态类型拒绝不是运行时 undefined。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-1.js",
            "sha256": "eec5e75ee67639155c0443503c3ece6b4cbe79c428046b000f188f47ea7e9268",
            "observations": ["new String(\"hello world\") 的缺失属性 s[\"foo\"]===undefined。"],
            "reason": "String wrapper、非数字属性键和缺失属性返回值；没有任何数值字符读取观察。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-2.js",
            "sha256": "b15f569be78d1a10ea6325553d98aed83ebb757f2821ea7642a9d1609744493f",
            "observations": ["primitive String(\"hello world\") 的 s[\"foo\"]===undefined。"],
            "reason": "String exotic 的非数字缺失属性读取，不能改成 u64 字节访问或一个 optional 对象字段。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-3.js",
            "sha256": "97e94a03219d97312971df1c72560915ff1421bdf3ca7868d1a48d74b9cd3b42",
            "observations": ["new String(\"hello world\") 的 s[NaN]===undefined。"],
            "reason": "NaN 转 property key 后的 String exotic 缺失属性语义，加上 wrapper。ZX 索引为 u64，没有 NaN 或该 ToPropertyKey 机制。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-4.js",
            "sha256": "f54d48a8ee20a3de45c8e81e6cfe29d0246cc4f085dd1cf3d2c63e1b27866197",
            "observations": ["new String(\"hello world\") 的 s[Infinity]===undefined。"],
            "reason": "Infinity property key 与 wrapper 的缺失属性语义；ZX u64 不含 Infinity，不能用编译拒绝充当 undefined。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-5.js",
            "sha256": "57175139db334ff9330d07923480dfbae255e528d42820d13fdc17e51f1a9ec1",
            "observations": ["new String(\"hello world\") 的 s[Math.pow(2,32)-1]===undefined，实际数值为 4294967295。"],
            "reason": "数值可由 u64 表达，但 ZX 字节索引越界抛 IndexOutOfBounds，原文返回 undefined；还包含 String wrapper。不能将它归为仅不支持大整数。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-6.js",
            "sha256": "325218c79c75635188d0186b062059be17ee08ee36afb9853b0608ebf8d4211a",
            "observations": ["primitive String(\"hello world\") 的 s[NaN]===undefined。"],
            "reason": "NaN 的 property-key 转换与 missing-property 返回；ZX u64 字节索引无此转换。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-7.js",
            "sha256": "7c3693b5ae2bead3042cfbd70dccbea8c884db9914f3e853667ed2b92e0761f9",
            "observations": ["primitive String(\"hello world\") 的 s[Infinity]===undefined。"],
            "reason": "Infinity property-key 转换和缺失属性返回；ZX unsigned 整数索引无法保留。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-3-8.js",
            "sha256": "f14bd65979ea49734cec01e99df1e94ddc6c19850aebf1c75df8d4269b63a6a7",
            "observations": [
                "primitive String(\"hello world\") 的 s[Math.pow(2,32)-1]===undefined，实际数值为 4294967295。"
            ],
            "reason": "4294967295 可表达为 u64，障碍是越界返回 undefined 与 IndexOutOfBounds 不同，以及 JS property lookup 机制。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-7-1.js",
            "sha256": "1d6591c1561d6d54ef2d697e273457e3067bf43aaf3a2d814a2cdec46ccd556f",
            "observations": ["new String(\"hello world\") 的 s[-1]===undefined。"],
            "reason": "直接括号索引的 -1 是 property key，不是 at 的倒数索引。ZX 不接收负 u64 索引，也没有 wrapper 缺失属性返回。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-7-2.js",
            "sha256": "d757792cdfe6a624ac30ba883db6cb83d18ad50f20a13f71f774eb0d1cee614a",
            "observations": ["primitive String(\"hello world\") 的 s[-1]===undefined。"],
            "reason": "负 property key 的缺失属性返回；不能把 -1 改成末尾索引，那会错误地引入 at 相对索引语义。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-7-3.js",
            "sha256": "7191ac3d6ba5cacfdd76f1f6292388c11bb0c87802a5bc34b504227f30ba93a3",
            "observations": ["new String(\"hello world\") 的 s[11]===undefined；原字符串长度恰为 11。"],
            "reason": "这是 index==length 边界，尽管元数据写 greater than。ZX index 11 会抛 IndexOutOfBounds，加上 wrapper 差异，不能将错误归为字符编码。"
        },
        {
            "path": "test/built-ins/String/15.5.5.5.2-7-4.js",
            "sha256": "6f7a071e446d6dcec5a8c6d0140565a2406d84cd37a88e7cc50728ae1cada48c",
            "observations": ["primitive String(\"hello world\") 的 s[11]===undefined；长度恰为 11。"],
            "reason": "相同 ASCII 长度边界，JS 返回 undefined，ZX 抛 IndexOutOfBounds；非 UTF-16/UTF-8 差异。"
        },
        {
            "path": "test/built-ins/String/numeric-properties.js",
            "sha256": "6a6a4dff7e029df4ec3872bec6e2a75d1848d1f002023b6321e5c45c28fc381c",
            "observations": [
                "str=new String(\"abc\")。",
                "str[0]===\"a\"，其属性 writable=false、enumerable=true、configurable=false。",
                "str[1]===\"b\"，其属性三个标志同上。",
                "str[2]===\"c\"，其属性三个标志同上。"
            ],
            "reason": "三个底层 ASCII 字符值可用字节索引加 decodeUtf8 表达，但原文同时要求 wrapper 的 numeric own-property descriptor。ZX 的不可变字节不是 JS 属性描述符；不能删掉三组 verifyProperty。"
        },
        {
            "path": "test/built-ins/String/prototype/at/index-argument-tointeger.js",
            "sha256": "563b86b614bb22f0bdc35ab51d67bf1ea68395e71bb22699f92ab48eed02337f",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "s=\"01\"，index 对象的 valueOf 返回 1，s.at(index)===\"1\"。",
                "valueOfCallCount===1。"
            ],
            "reason": "索引对象的 valueOf/ToInteger 与恰好调用一次是核心，另有方法反射。不能预先提供 u64=1 后把 ASCII 结果子集算完整。"
        },
        {
            "path": "test/built-ins/String/prototype/at/index-non-numeric-argument-tointeger-invalid.js",
            "sha256": "40f3f86ec5d2337f1c25fd0699589c15486b897077fdce53fb884380b5442135",
            "observations": ["typeof String.prototype.at===\"function\"。", "\"01\".at(Symbol()) 抛 TypeError。"],
            "reason": "Symbol 转索引时的 TypeError 与方法反射。ZX 不提供 at 或 Symbol 动态 ToInteger，静态参数类型拒绝不等价。"
        },
        {
            "path": "test/built-ins/String/prototype/at/index-non-numeric-argument-tointeger.js",
            "sha256": "37a09110b92218ff022e8e84abee3259c6083d880f193fc679f1bbfb803de03e",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "对 \"01\"，false/null/undefined/空字符串/function() {}/[] 六种索引均得到 \"0\"。",
                "true 与字符串 \"1\" 两种索引均得到 \"1\"。"
            ],
            "reason": "八种不同 ToInteger 输入，含 null/undefined/function/array。ZX typed u64 不实施这些转换；不能按结果硬编码为 0/1。"
        },
        {
            "path": "test/built-ins/String/prototype/at/length.js",
            "sha256": "6deec5fb10036c20d1d0fc20f0c6fdba65dce728993041fe086d722d49bb06fa",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "at.length 的 value=1、writable=false、enumerable=false、configurable=true。"
            ],
            "reason": "函数对象 length 与 descriptor，不是被索引字符串的长度；不能拿 string.length 或静态 callable 类型代替。"
        },
        {
            "path": "test/built-ins/String/prototype/at/name.js",
            "sha256": "6173636983f106f5cde1dd263908c13ec9b67af828490f395a636a2b431dd311",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "String.prototype.at.name===\"at\"。",
                "name 属性 enumerable=false、writable=false、configurable=true。"
            ],
            "reason": "JS 方法名和属性描述符反射。ZX 不存在可反射的 String.prototype.at 函数对象。"
        },
        {
            "path": "test/built-ins/String/prototype/at/prop-desc.js",
            "sha256": "0dda6580709740d9ee00b9e90296adfaecfe104f658c18fd7c647e72b3262155",
            "observations": [
                "原文两次独立检查 typeof String.prototype.at===\"function\"。",
                "String.prototype 上 at 属性 enumerable=false、writable=true、configurable=true。"
            ],
            "reason": "两个 typeof 检查及 prototype 方法属性 descriptor 均必须保留，不能只检查 ZX 支持字符串索引。"
        },
        {
            "path": "test/built-ins/String/prototype/at/return-abrupt-from-this.js",
            "sha256": "040e88575f07f143a860498fb21dccc461c8ac99b84604233c69bd4b49df502b",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "String.prototype.at.call(undefined) 抛 TypeError。",
                "String.prototype.at.call(null) 抛 TypeError。"
            ],
            "reason": "RequireObjectCoercible、generic this 以及方法反射。ZX string typed input 没有 null/undefined receiver 或 JS call 协议。"
        },
        {
            "path": "test/built-ins/String/prototype/at/returns-code-unit.js",
            "sha256": "a67ce4e6a1595fbce73142d091b580507b617361454cc016de68695ec1d13661",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "完整输入 s=\"12\\uD80034\"。",
                "at(0/1/2/3/4) 分别为 \"1\"/\"2\"/单独高代理 D800/\"3\"/\"4\"。"
            ],
            "reason": "整个输入含孤立 UTF-16 高代理，不能作为相同有效 UTF-8 string 传入；index 2 的孤立代理结果也不可表示。其余四项虽为 ASCII 输出，不能换掉完整输入后截取登记；还需 typeof at。"
        },
        {
            "path": "test/built-ins/String/prototype/at/returns-item-relative-index.js",
            "sha256": "a4be170547d99a5eed0dd4e86710ed8b4ae2b22246212f98eacd44f357744bae",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "s=\"12345\"；at(0)===\"1\"、at(-1)===\"5\"、at(-3)===\"3\"、at(-4)===\"2\"。"
            ],
            "reason": "只有 index 0 的 ASCII 值投影符合 unsigned 字节读取；三项负相对索引和方法反射都未支持。预先将负数换成正索引会删除原文核心。"
        },
        {
            "path": "test/built-ins/String/prototype/at/returns-item.js",
            "sha256": "c15c0d8635a9255f3ea7a82a57974a5973352be043c6834be296080e4324aa23",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "完整 ASCII 输入 s=\"12345\"；at(0..4) 分别返回字符串 \"1\"..\"5\"。"
            ],
            "reason": "五个非负、范围内 ASCII 字符观察可以经字节索引加 decodeUtf8 保留精确字符串值；直接 u8 或数字模板不能替代字符。但整份仍含 typeof String.prototype.at，当前没有 at 方法对象，不能丢掉这项标为 adapted。"
        },
        {
            "path": "test/built-ins/String/prototype/at/returns-undefined-for-out-of-range-index.js",
            "sha256": "ec8106380287ef3f7a15adfc6fd1a351191078bff47102574be2500d3c2ced8a",
            "observations": [
                "typeof String.prototype.at===\"function\"。",
                "s=\"\"；at(-2)、at(0)、at(1) 均返回 undefined。"
            ],
            "reason": "原文将负索引与零长度越界都返回 undefined；ZX u64 不接收 -2，index 0/1 抛 IndexOutOfBounds。改为 optional/null 或捕获错误改变返回与失败机制。"
        }
    ]
}
