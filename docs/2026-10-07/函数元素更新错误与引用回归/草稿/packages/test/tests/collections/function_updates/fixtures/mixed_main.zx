import patch from "./step"

import type { DataInput, DataOutput } from "./types"

export type Input = DataInput

export type Output = DataOutput

export default function (in: Input): Output {
    const seen: i64 = 0

    const initial = { ...in, round: 0, mirror: in.values, seen }

    const result = loop(initial, {
        while: state => state.round < state.outer,
        next: state => {
            const old = state.mirror
            const next = patch({ values: state.values, mirror: state.mirror, count: state.inner, selected: state.selected, delta: state.delta })

            state.values = next.values
            state.mirror = next.mirror

            if (state.inner > 0) {
                state.seen += old[state.selected]
            }

            state.round += 1
        }
    })

    return { original: in.values, values: result.values, mirror: result.mirror, seen: result.seen, steps: result.round }
}
