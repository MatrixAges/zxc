import integers from "zig:integers"

import find from "../types/find"
import { Kind } from "../types/model"
import delta from "./delta"
import fields from "./fields/sort"
import validate from "./validate"

import type { Table } from "../types/model"
import type { ConstructionInput, ConstructionOutput } from "./model"

export type Input = ConstructionInput

export type Output = ConstructionOutput

export default function (in: Input): Output {
    const empty: Table = { kinds: [], first: [], second: [], labels: [], children: [], field_types: [], field_names: [], names: [] }
    const issue = validate(in)

    if (issue.message != "") {
        return { delta: empty, id: 0, diagnostic: issue }
    }

    const normalized = {
        ...in.candidate,
        fields: in.candidate.kind == Kind.Object ? fields(in.candidate.fields) : in.candidate.fields,
        names: in.candidate.kind == Kind.ErrorSet ? in.candidate.names.sort()[0] : in.candidate.names
    }

    const found = find({ tables: { base: in.table, delta: empty }, candidate: normalized })

    if (found.found) {
        return { delta: empty, id: found.id, diagnostic: issue }
    }

    return { delta: delta(normalized), id: integers.narrow(in.table.kinds.length), diagnostic: issue }
}
