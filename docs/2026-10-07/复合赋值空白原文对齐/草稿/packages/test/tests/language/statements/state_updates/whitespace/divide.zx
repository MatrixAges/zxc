import tab from "./divide/tab"
import verticalTab from "./divide/vertical_tab"
import formFeed from "./divide/form_feed"
import space from "./divide/space"
import lineFeed from "./divide/line_feed"
import carriageReturn from "./divide/carriage_return"

export type Input = { left: f64, right: f64, shape: u8 }

export type Output = { scalar: f64, field: f64, element: f64 }

export default function (in: Input): Output {
    if (in.shape >= 0 && in.shape < 3) {
        return tab(in)
    }

    if (in.shape >= 3 && in.shape < 6) {
        return verticalTab(in)
    }

    if (in.shape >= 6 && in.shape < 9) {
        return formFeed(in)
    }

    if (in.shape >= 9 && in.shape < 12) {
        return space(in)
    }

    if (in.shape >= 12 && in.shape < 15) {
        return lineFeed(in)
    }

    if (in.shape >= 15 && in.shape < 18) {
        return carriageReturn(in)
    }

    return { scalar: in.left, field: in.left, element: in.left }
}
