import host from "zig:host"

export type State = { count: u64, total: u64, text: string }

export type Input = { seed: State, steps: u64[] }

export type Output = State

export default function (in: Input): Output {
    return in.steps.reduce((state, item) => match host.subject(item) {
        0 => state,
        host.pattern(1) => ({...state, count: state.count + 1, total: state.total + state.count + host.amount(item)}),
        _ => ({count: state.count + 2, total: state.total + state.count + host.amount(item) + 10, text: state.text})
    }, in.seed)
}
