<Store name="application_state" version={7}>
  <Object name="counter">
    <Field name="value" type="u64" value={1 + 2} />
    <Field name="history" type="u64[]" value={[8]} />
  </Object>
  <Object name="settings">
    <Field name="label" type="string" value={"fresh"} />
    <Field name="enabled" type="bool" value={true} />
    <Field name="missing" type="u64?" value={null} />
    <Field name="maybe" type="u64?" value={17} />
    <Field name="matrix" type="u64[][]" value={[[], [2, 3]]} />
  </Object>
</Store>
