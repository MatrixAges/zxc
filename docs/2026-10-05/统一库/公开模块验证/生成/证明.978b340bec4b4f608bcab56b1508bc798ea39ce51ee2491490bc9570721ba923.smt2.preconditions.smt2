(set-logic QF_BV)
(set-option :produce-models true)
(set-option :timeout 10000)
(declare-fun input_0 () Bool)
(declare-fun input_1 () (_ BitVec 8))
(define-fun term_0 () Bool (not true))
(define-fun term_1 () (_ BitVec 8) (ite true input_1 input_1))
(define-fun term_2 () Bool (or false true))
(define-fun term_3 () Bool (not term_0))
(define-fun term_4 () Bool (and term_3 term_2))
(define-fun term_5 () Bool (not term_4))
(define-fun term_6 () Bool (and term_4 (not true)))
(define-fun term_7 () Bool (and term_4 (= input_0 true)))
(define-fun term_8 () Bool (and term_7 (not true)))
(define-fun term_9 () Bool (or false false))
(define-fun term_10 () Bool (not (= input_0 true)))
(define-fun term_11 () Bool (and term_4 term_10))
(define-fun term_12 () (_ BitVec 8) (_ bv0 8))
(define-fun term_13 () Bool (and term_11 (not true)))
(define-fun term_14 () Bool (or term_9 false))

(assert true)
(check-sat)
