<Module>
  <Parallel>
    <Task name="allocate" out="ctx.values">
      <Call fn="map_values" in="$in.values" out="local.values" />
      <Return value="local.values" />
    </Task>
    <Task name="check">
      <Call fn="first" in="$in.missing" />
    </Task>
  </Parallel>
  <Return value="ctx.values" />
</Module>
