export type Input = u64[]

export type State = { old_length: u64, values: u64[] }

export type Output = State

export default function (in: Input): Output {
  const values: u64[] = []
  const initial: State = { old_length: 0, values: values }

  return in.reduce((state, item) => ({ old_length: state.values.length, values: item == 0 ? state.values : state.values.push(item)[0] }), initial)
}
