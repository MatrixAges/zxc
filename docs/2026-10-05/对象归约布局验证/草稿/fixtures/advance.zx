export type Child = { value: u64 }

export type State = { count: u64, total: u64, last: u64, labels: string[], text: string, child: Child }

export type Input = { state: State, item: u64 }

export type Output = State

export default function (in: Input): Output {
  return {...in.state, count: in.state.count + 1, total: in.state.total + in.state.count + in.item, last: in.state.count}
}
