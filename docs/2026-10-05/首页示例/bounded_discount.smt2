(set-logic QF_BV)
(set-option :produce-models true)
(set-option :timeout 10000)
(declare-fun input_0 () (_ BitVec 64))
(declare-fun input_1 () (_ BitVec 64))
(define-fun term_0 () Bool (bvule input_0 input_1))
(define-fun term_1 () Bool (not true))
(define-fun term_2 () (_ BitVec 64) (bvsub input_1 input_0))
(define-fun term_3 () Bool (= (bvsub ((_ zero_extend 1) input_1) ((_ zero_extend 1) input_0)) ((_ zero_extend 1) (bvsub input_1 input_0))))
(define-fun term_4 () Bool (and term_0 (not term_3)))
(define-fun term_5 () Bool (and term_0 term_3))
(define-fun term_6 () Bool (bvule term_2 input_1))
(define-fun term_7 () Bool (and term_5 (not term_6)))
(define-fun term_8 () Bool (and term_5 term_6))

(assert (or term_1 term_4 term_7))
(check-sat)
