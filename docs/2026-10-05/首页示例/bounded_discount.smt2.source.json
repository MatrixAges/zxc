			"source": "export type Input = {\n  price: u64\n  discount: u64\n}\n\nexport type Output = u64\n\nexport default function (in: Input): Output\n  requires (in.discount <= in.price)\n  ensures (out <= in.price)\n{\n  return in.price - in.discount\n}\n"
		}
