<Module>
  <Store from="state" as="inner"/>
  <Call fn="advance" in="{increment: $in, state: store.inner.counter}" setter="[store.inner.counter]" out="ctx.first"/>
  <Call fn="advance" in="{increment: $in, state: store.inner.counter}" setter="[store.inner.counter]" out="ctx.second"/>
  <Return value="{first: ctx.first, second: ctx.second}"/>
</Module>
