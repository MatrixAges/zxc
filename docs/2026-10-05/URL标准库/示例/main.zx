import params from "std:url/search_params"

export type Input = { query: string, key: string, value: string, match_value: string? }

export type Output = {
  original: string, appended: string, assigned: string, removed: string,
  ordered: string, first: string?, all: string[], found: bool, count: u64,
  keys: string[], values: string[]
}

export default function (in: Input): Output {
  const parsed = params.parse(in.query)
  const appended = params.append({entries: parsed, key: in.key, value: in.value})
  const assigned = params.set({entries: appended, key: in.key, value: in.value})
  const removed = params.remove({entries: appended, key: in.key, value: in.match_value})
  const ordered = params.sort(appended)

  return {
    original: params.stringify(parsed),
    appended: params.stringify(appended),
    assigned: params.stringify(assigned),
    removed: params.stringify(removed),
    ordered: params.stringify(ordered),
    first: params.get({entries: appended, key: in.key}),
    all: params.getAll({entries: appended, key: in.key}),
    found: params.has({entries: appended, key: in.key, value: in.match_value}),
    count: params.size(appended),
    keys: params.keys(ordered),
    values: params.values(ordered)
  }
}
