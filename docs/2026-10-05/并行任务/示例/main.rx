<Module>
  <Call fn="identity" args={$in.value} name="seed" />
  <Parallel>
    <Task name="number">
      <Call fn="identity" args={ctx.seed} name="first" />
      <Call fn="identity" args={ctx.first} name="second" />
      <Return value={ctx.second} />
    </Task>
    <Task name="flag">
      <Switch on={$in.enabled}>
        <Case value={true}>
          <Parallel>
            <Task name="flag">
              <Call fn="invert" args={$in.enabled} name="value" />
              <Return value={ctx.value} />
            </Task>
            <Call fn="identity" args={ctx.seed} />
          </Parallel>
          <Return value={ctx.flag} />
        </Case>
        <Default>
          <Return value={true} />
        </Default>
      </Switch>
    </Task>
    <Task name="discard">
      <Call fn="identity" args={ctx.seed} />
    </Task>
  </Parallel>
  <Return value={{value: ctx.number, enabled: ctx.flag}} />
</Module>
