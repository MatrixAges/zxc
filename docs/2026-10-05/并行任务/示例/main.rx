<Module>
  <Call fn="identity" in={$in.value} name="number" />
  <Parallel>
    <Task name="number" out={{value: ctx.second}}>
      <Call fn="identity" in={ctx.number} name="first" />
      <Call fn="identity" in={ctx.first} name="second" />
    </Task>
    <Task name="flag">
      <Switch on={$in.enabled}>
        <Case value={true}>
          <Parallel>
            <Task name="flag" out={ctx.value}>
              <Call fn="invert" in={$in.enabled} name="value" />
            </Task>
            <Call fn="identity" in={ctx.number} />
          </Parallel>
          <Return value={ctx.task.flag} />
        </Case>
        <Default>
          <Return value={true} />
        </Default>
      </Switch>
    </Task>
    <Task name="discard">
      <Call fn="identity" in={ctx.number} />
    </Task>
  </Parallel>
  <Return value={{value: ctx.task.number.value, enabled: ctx.task.flag}} />
</Module>
