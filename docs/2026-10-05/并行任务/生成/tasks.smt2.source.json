{
	"sources": [
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行任务/示例/identity.zx",
			"source": "export type Input = u8\n\nexport type Output = u8\n\nexport default function (in: Input): Output ensures(out == in) {\n  return in\n}\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行任务/示例/invert.zx",
			"source": "export type Input = bool\n\nexport type Output = bool\n\nexport default function (in: Input): Output {\n  return !in\n}\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行任务/示例/main.rx",
			"source": "<Module>\n  <Call fn=\"identity\" in=\"$in.value\" out=\"ctx.seed\" />\n  <Parallel>\n    <Task name=\"number\" out=\"ctx.number\">\n      <Call fn=\"identity\" in=\"ctx.seed\" out=\"local.first\" />\n      <Call fn=\"identity\" in=\"local.first\" out=\"local.second\" />\n      <Return value=\"local.second\" />\n    </Task>\n    <Task name=\"flag\" out=\"ctx.flag\">\n      <Switch on=\"$in.enabled\">\n        <Case value=\"true\">\n          <Parallel>\n            <Task name=\"nested\" out=\"local.flag\">\n              <Call fn=\"invert\" in=\"$in.enabled\" out=\"local.value\" />\n              <Return value=\"local.value\" />\n            </Task>\n            <Call fn=\"identity\" in=\"ctx.seed\" />\n          </Parallel>\n          <Return value=\"local.flag\" />\n        </Case>\n        <Default>\n          <Return value=\"true\" />\n        </Default>\n      </Switch>\n    </Task>\n    <Task name=\"discard\">\n      <Call fn=\"identity\" in=\"ctx.seed\" />\n    </Task>\n  </Parallel>\n  <Return value=\"{value: ctx.number, enabled: ctx.flag}\" />\n</Module>\n"
		}
	],
