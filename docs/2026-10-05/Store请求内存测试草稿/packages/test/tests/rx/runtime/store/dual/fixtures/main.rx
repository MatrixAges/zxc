<Module>
  <Store from="left" as="left" />
  <Store from="right" as="right" />

  <Call fn="snapshot" in="store.left.counter" out="ctx.before_left" />
  <Call fn="snapshot" in="store.right.counter" out="ctx.before_right" />
  <Call service="write_left" in="$in" out="ctx.first" />
  <Call fn="snapshot" in="store.right.counter" out="ctx.untouched" />
  <Call service="write_right" in="$in" out="ctx.second" />
  <Call fn="snapshot" in="store.left.counter" out="ctx.after_left" />
  <Call fn="snapshot" in="store.right.counter" out="ctx.after_right" />

  <Return value="{before_left: ctx.before_left, before_right: ctx.before_right, untouched: ctx.untouched, after_left: ctx.after_left, after_right: ctx.after_right, first: ctx.first, second: ctx.second}" />
</Module>
