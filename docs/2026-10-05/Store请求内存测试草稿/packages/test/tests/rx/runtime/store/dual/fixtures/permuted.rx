<Module>
  <Store from="right" as="right" />
  <Store from="left" as="left" />

  <Call fn="read_pair" in="{first: store.right.counter.value, second: store.left.counter.value}" out="ctx.initial" />
  <Call fn="write_left_pair" in="{first: store.right.counter.value, second: store.right.counter.value, increment: $in}" setter="[store.left.counter]" out="ctx.written" />

  <Return value="{initial: ctx.initial, written: ctx.written}" />
</Module>
