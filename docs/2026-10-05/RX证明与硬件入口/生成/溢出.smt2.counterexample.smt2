(set-logic QF_BV)
(set-option :produce-models true)
(set-option :timeout 10000)
(declare-fun input_0 () (_ BitVec 64))
(define-fun term_0 () (_ BitVec 64) (_ bv2 64))
(define-fun term_1 () (_ BitVec 64) (bvmul input_0 term_0))
(define-fun term_2 () Bool (= (bvmul ((_ sign_extend 64) input_0) ((_ sign_extend 64) term_0)) ((_ sign_extend 64) (bvmul input_0 term_0))))
(define-fun term_3 () Bool (not term_2))
(define-fun term_4 () (_ BitVec 64) (ite term_2 term_1 term_1))
(define-fun term_5 () Bool (or false term_2))
(define-fun term_6 () Bool (not term_3))
(define-fun term_7 () Bool (and term_6 term_5))
(define-fun term_8 () Bool (not term_7))
(define-fun term_9 () Bool (and term_7 (not true)))

(assert (or term_8 term_9))
(check-sat)
(get-model)
