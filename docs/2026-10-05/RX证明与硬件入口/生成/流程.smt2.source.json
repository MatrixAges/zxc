		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/RX证明与硬件入口/示例/read.zx",
			"source": "export type Input = { enabled: bool, value: u8 }\n\nexport type Output = u8\n\nexport default function (in: Input): Output {\n  return in.value\n}\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/RX证明与硬件入口/示例/main.rx",
			"source": "<Module>\n  <Call fn=\"read\" in=\"$in\" out=\"ctx.value\" />\n  <Task name=\"select\">\n    <Switch on=\"$in.enabled\">\n      <Case value=\"true\">\n        <Return value=\"ctx.value\" />\n      </Case>\n      <Default>\n        <Return value=\"0\" />\n      </Default>\n    </Switch>\n  </Task>\n</Module>\n"
		}
	],
