			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行纯计算证明/示例/identity.zx",
			"source": "export type Input = u8\n\nexport type Output = u8\n\nexport default function (in: Input): Output ensures(out == in) {\n  return in\n}\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行纯计算证明/示例/checked.zx",
			"source": "export type Input = u8\n\nexport type Output = u8\n\nexport default function (in: Input): Output ensures(out == in) {\n  return 0\n}\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行纯计算证明/示例/invert.zx",
			"source": "export type Input = bool\n\nexport type Output = bool\n\nexport default function (in: Input): Output {\n  return !in\n}\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行纯计算证明/示例/main.rx",
			"source": "<Module>\n  <Parallel>\n    <Call fn=\"identity\" in=\"$in.value\" out=\"ctx.value\" />\n    <Call service=\"flag\" in=\"$in.enabled\" out=\"ctx.flag\" />\n    <Call fn=\"checked\" in=\"$in.value\" />\n  </Parallel>\n  <Return value=\"{value: ctx.value, enabled: ctx.flag}\" />\n</Module>\n"
		},
		{
			"path": "/Users/xiewendao/Documents/MatrixAges/zxc/docs/2026-10-05/并行纯计算证明/示例/flag.rx",
			"source": "<Module>\n  <Parallel>\n    <Call fn=\"invert\" in=\"$in\" out=\"ctx.value\" />\n    <Call fn=\"invert\" in=\"$in\" />\n  </Parallel>\n  <Return value=\"ctx.value\" />\n</Module>\n"
		}
	],
