export type Input = { first: u64[], second: u64[], choice: bool }

export type Output = { first: u64[], second: u64[] }

export default function (in: Input): Output {
  const first = in.first.map((item) => item)
  const second = in.second.map((item) => item)
  const source: { lists: Output } = { lists: { first: first, second: second } }

  return {...source.lists}
}
