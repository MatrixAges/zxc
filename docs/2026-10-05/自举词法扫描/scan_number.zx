import type { State, Result } from "./number_state.zx"
import { Phase } from "./number_state.zx"
import encoding from "std:encoding"
import isDigit from "./is_digit.zx"
import numberStep from "./number_step.zx"
import numberResult from "./number_result.zx"

export type Input = string

export type Output = Result

export default function (in: Input): Output {
  const bytes = encoding.encodeUtf8(in)

  if (bytes.length == 0 || !isDigit(bytes[0])) {
    return { end: 0, diagnostic: "expected a digit" }
  }

  const initial: State = { end: 0, phase: Phase.Integer, last_byte: 0, separators_valid: true }

  const state = bytes.reduce((state, byte) => numberStep({ state: state, byte: byte }), initial)

  return numberResult(state)
}
