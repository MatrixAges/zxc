export type State = { count: u64, total: u64, labels: string[] }

export type Input = { seed: State, steps: u64[] }

export type Output = State

export default function (in: Input): Output {
  return in.steps.reduce((state, item) => item == 0 ? state : ({ ...state, count: state.count + 1, total: state.total + state.count + item }), in.seed)
}
