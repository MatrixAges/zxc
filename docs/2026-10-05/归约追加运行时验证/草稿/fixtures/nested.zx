export type Input = { seed: u64[], steps: { enabled: bool, value: u64, values: u64[] }[] }

export type Output = u64[]

export default function (in: Input): Output {
  const initial = in.seed.map(item => item)

  return in.steps.reduce((items, step) => step.enabled ? (step.values.length > 0 ? items.concat(step.values)[0] : items.push(step.value)[0]) : items, initial)
}
