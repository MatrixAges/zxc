import type { Utf8State } from "./model.zx"
import step from "./step.zx"

export type Input = u8[]

export type Output = bool

export default function (in: Input): Output {
  const initial: Utf8State = { valid: true, remaining: 0, low: 128, high: 191 }
  const state = in.reduce((state, byte) => step({ byte: byte, state: state }), initial)

  return state.valid && state.remaining == 0
}
