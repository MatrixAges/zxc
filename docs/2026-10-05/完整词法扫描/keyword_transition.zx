import { Keyword } from "./keyword_model.zx"
import root from "./keyword_transition/root.zx"
import a from "./keyword_transition/a.zx"
import b from "./keyword_transition/b.zx"
import c from "./keyword_transition/c.zx"
import d from "./keyword_transition/d.zx"
import e from "./keyword_transition/e.zx"
import f from "./keyword_transition/f.zx"
import i from "./keyword_transition/i.zx"
import l from "./keyword_transition/l.zx"
import m from "./keyword_transition/m.zx"
import n from "./keyword_transition/n.zx"
import r from "./keyword_transition/r.zx"
import s from "./keyword_transition/s.zx"
import t from "./keyword_transition/t.zx"
import v from "./keyword_transition/v.zx"
import w from "./keyword_transition/w.zx"

export type Input = { keyword: Keyword, byte: u8 }

export type Output = Keyword

export default function (in: Input): Output {
  switch (in.keyword) {
    case Keyword.Root: return root(in)
    case Keyword.A: return a(in)
    case Keyword.As: return a(in)
    case Keyword.Asy: return a(in)
    case Keyword.Asyn: return a(in)
    case Keyword.Aw: return a(in)
    case Keyword.Awa: return a(in)
    case Keyword.Awai: return a(in)
    case Keyword.B: return b(in)
    case Keyword.Br: return b(in)
    case Keyword.Bre: return b(in)
    case Keyword.Brea: return b(in)
    case Keyword.C: return c(in)
    case Keyword.Ca: return c(in)
    case Keyword.Cas: return c(in)
    case Keyword.Co: return c(in)
    case Keyword.Con: return c(in)
    case Keyword.Cons: return c(in)
    case Keyword.D: return d(in)
    case Keyword.De: return d(in)
    case Keyword.Def: return d(in)
    case Keyword.Defa: return d(in)
    case Keyword.Defau: return d(in)
    case Keyword.Defaul: return d(in)
    case Keyword.E: return e(in)
    case Keyword.El: return e(in)
    case Keyword.Els: return e(in)
    case Keyword.En: return e(in)
    case Keyword.Enu: return e(in)
    case Keyword.Ex: return e(in)
    case Keyword.Exp: return e(in)
    case Keyword.Expo: return e(in)
    case Keyword.Expor: return e(in)
    case Keyword.F: return f(in)
    case Keyword.Fa: return f(in)
    case Keyword.Fal: return f(in)
    case Keyword.Fals: return f(in)
    case Keyword.Fo: return f(in)
    case Keyword.Fu: return f(in)
    case Keyword.Fun: return f(in)
    case Keyword.Func: return f(in)
    case Keyword.Funct: return f(in)
    case Keyword.Functi: return f(in)
    case Keyword.Functio: return f(in)
    case Keyword.I: return i(in)
    case Keyword.Im: return i(in)
    case Keyword.Imp: return i(in)
    case Keyword.Impo: return i(in)
    case Keyword.Impor: return i(in)
    case Keyword.L: return l(in)
    case Keyword.Le: return l(in)
    case Keyword.M: return m(in)
    case Keyword.Ma: return m(in)
    case Keyword.Mat: return m(in)
    case Keyword.Matc: return m(in)
    case Keyword.N: return n(in)
    case Keyword.Ne: return n(in)
    case Keyword.Nu: return n(in)
    case Keyword.Nul: return n(in)
    case Keyword.R: return r(in)
    case Keyword.Re: return r(in)
    case Keyword.Ret: return r(in)
    case Keyword.Retu: return r(in)
    case Keyword.Retur: return r(in)
    case Keyword.S: return s(in)
    case Keyword.Sw: return s(in)
    case Keyword.Swi: return s(in)
    case Keyword.Swit: return s(in)
    case Keyword.Switc: return s(in)
    case Keyword.T: return t(in)
    case Keyword.Th: return t(in)
    case Keyword.Thr: return t(in)
    case Keyword.Thro: return t(in)
    case Keyword.Tr: return t(in)
    case Keyword.Tru: return t(in)
    case Keyword.Ty: return t(in)
    case Keyword.Typ: return t(in)
    case Keyword.V: return v(in)
    case Keyword.Va: return v(in)
    case Keyword.W: return w(in)
    case Keyword.Wh: return w(in)
    case Keyword.Whi: return w(in)
    case Keyword.Whil: return w(in)
    default: return Keyword.Dead
  }
}
