export type Input = u8

export type Output = bool

export default function (in: Input): Output {
  return in == 123 ||
    in == 125 ||
    in == 40 ||
    in == 41 ||
    in == 58 ||
    in == 59 ||
    in == 44 ||
    in == 46 ||
    in == 63 ||
    in == 91 ||
    in == 93 ||
    in == 43 ||
    in == 45 ||
    in == 42 ||
    in == 47 ||
    in == 37 ||
    in == 60 ||
    in == 62 ||
    in == 61 ||
    in == 33 ||
    in == 38 ||
    in == 124
}
