import { Keyword } from "../keyword_model.zx"

export type Input = { keyword: Keyword, byte: u8 }

export type Output = Keyword

export default function (in: Input): Output {
  switch (in.keyword) {
    case Keyword.T: return match {
      in.byte == 104 => Keyword.Th,
      in.byte == 114 => Keyword.Tr,
      in.byte == 121 => Keyword.Ty,
      _ => Keyword.Dead
    }
    case Keyword.Th: return match {
      in.byte == 114 => Keyword.Thr,
      _ => Keyword.Dead
    }
    case Keyword.Thr: return match {
      in.byte == 111 => Keyword.Thro,
      _ => Keyword.Dead
    }
    case Keyword.Thro: return match {
      in.byte == 119 => Keyword.Throw,
      _ => Keyword.Dead
    }
    case Keyword.Tr: return match {
      in.byte == 117 => Keyword.Tru,
      _ => Keyword.Dead
    }
    case Keyword.Tru: return match {
      in.byte == 101 => Keyword.True,
      _ => Keyword.Dead
    }
    case Keyword.Ty: return match {
      in.byte == 112 => Keyword.Typ,
      _ => Keyword.Dead
    }
    case Keyword.Typ: return match {
      in.byte == 101 => Keyword.Type,
      _ => Keyword.Dead
    }
    default: return Keyword.Dead
  }
}
