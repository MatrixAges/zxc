import { Keyword } from "../keyword_model.zx"

export type Input = { keyword: Keyword, byte: u8 }

export type Output = Keyword

export default function (in: Input): Output {
  switch (in.keyword) {
    case Keyword.A: return match {
      in.byte == 115 => Keyword.As,
      in.byte == 119 => Keyword.Aw,
      _ => Keyword.Dead
    }
    case Keyword.As: return match {
      in.byte == 121 => Keyword.Asy,
      _ => Keyword.Dead
    }
    case Keyword.Asy: return match {
      in.byte == 110 => Keyword.Asyn,
      _ => Keyword.Dead
    }
    case Keyword.Asyn: return match {
      in.byte == 99 => Keyword.Async,
      _ => Keyword.Dead
    }
    case Keyword.Aw: return match {
      in.byte == 97 => Keyword.Awa,
      _ => Keyword.Dead
    }
    case Keyword.Awa: return match {
      in.byte == 105 => Keyword.Awai,
      _ => Keyword.Dead
    }
    case Keyword.Awai: return match {
      in.byte == 116 => Keyword.Await,
      _ => Keyword.Dead
    }
    default: return Keyword.Dead
  }
}
