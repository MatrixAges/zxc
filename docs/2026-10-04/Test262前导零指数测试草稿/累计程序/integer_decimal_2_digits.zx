export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 10:
            return 11
        case 11:
            return 22
        case 12:
            return 33
        case 13:
            return 44
        case 14:
            return 55
        case 15:
            return 66
        case 16:
            return 77
        case 17:
            return 88
        case 18:
            return 99
        default:
            return 0
    }
}
