export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 169:
            return 0.0e+1
        case 170:
            return 1.1e+1
        case 171:
            return 2.2e+1
        case 172:
            return 3.3e+1
        case 173:
            return 4.4e+1
        case 174:
            return 5.5e+1
        case 175:
            return 6.6e+1
        case 176:
            return 7.7e+1
        case 177:
            return 8.8e+1
        case 178:
            return 9.9e+1
        case 179:
            return 0.0E+1
        case 180:
            return 1.1E+1
        case 181:
            return 2.2E+1
        case 182:
            return 3.3E+1
        case 183:
            return 4.4E+1
        case 184:
            return 5.5E+1
        case 185:
            return 6.6E+1
        case 186:
            return 7.7E+1
        case 187:
            return 8.8E+1
        case 188:
            return 9.9E+1
        default:
            return 0
    }
}
