export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 69:
            return 0E+1
        case 70:
            return 1E+1
        case 71:
            return 2E+1
        case 72:
            return 3E+1
        case 73:
            return 4E+1
        case 74:
            return 5E+1
        case 75:
            return 6E+1
        case 76:
            return 7E+1
        case 77:
            return 8E+1
        case 78:
            return 9E+1
        case 259:
            return 0E+01
        case 260:
            return 1E+01
        case 261:
            return 2E+01
        case 262:
            return 3E+01
        case 263:
            return 4E+01
        case 264:
            return 5E+01
        case 265:
            return 6E+01
        case 266:
            return 7E+01
        case 267:
            return 8E+01
        case 268:
            return 9E+01
        default:
            return 0
    }
}
