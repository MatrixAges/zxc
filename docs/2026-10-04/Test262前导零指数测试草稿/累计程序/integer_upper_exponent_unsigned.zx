export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 29:
            return 0E1
        case 30:
            return 1E1
        case 31:
            return 2E1
        case 32:
            return 3E1
        case 33:
            return 4E1
        case 34:
            return 5E1
        case 35:
            return 6E1
        case 36:
            return 7E1
        case 37:
            return 8E1
        case 38:
            return 9E1
        case 89:
            return 0E0
        case 90:
            return 1E0
        case 91:
            return 2E0
        case 92:
            return 3E0
        case 93:
            return 4E0
        case 94:
            return 5E0
        case 95:
            return 6E0
        case 96:
            return 7E0
        case 97:
            return 8E0
        case 98:
            return 9E0
        case 219:
            return 0E01
        case 220:
            return 1E01
        case 221:
            return 2E01
        case 222:
            return 3E01
        case 223:
            return 4E01
        case 224:
            return 5E01
        case 225:
            return 6E01
        case 226:
            return 7E01
        case 227:
            return 8E01
        case 228:
            return 9E01
        case 279:
            return 0E00
        case 280:
            return 1E00
        case 281:
            return 2E00
        case 282:
            return 3E00
        case 283:
            return 4E00
        case 284:
            return 5E00
        case 285:
            return 6E00
        case 286:
            return 7E00
        case 287:
            return 8E00
        case 288:
            return 9E00
        default:
            return 0
    }
}
