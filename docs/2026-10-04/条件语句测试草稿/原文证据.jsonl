{"path": "test/language/statements/if/S12.5_A2.js", "sha256": "e6de405072a409c00b7cf1e50ce69b84b219272c28897eef5d6b7abd66d0d9ec", "body": "if (eval(\"true\")) {\n} else {\n    throw new Test262Error('#1: In the \"if\" Statement eval as Expression is admitted'); \n}", "negative": false}
