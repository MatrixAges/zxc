export type Input = { shape: u64; value: f64; };

export type Output = bool;

export default function (in: Input): Output {
  switch (in.shape) {
    case 36: return in.value	<= 1;
    case 37: return in.value <=	1;
    case 38: return in.value	<=	1;
    case 39: return in.value<= 1;
    case 40: return in.value <=1;
    case 41: return in.value<=1;
    case 42: return in.value<= 1;
    case 43: return in.value <=1;
    case 44: return in.value<=1;
    case 45: return in.value <= 1;
    case 46: return in.value <= 1;
    case 47: return in.value <= 1;
    case 48: return in.value
<= 1;
    case 49: return in.value <=
1;
    case 50: return in.value
<=
1;
    case 51: return in.value<= 1;
    case 52: return in.value <=1;
    case 53: return in.value<=1;
    default: return false;
  }
}
