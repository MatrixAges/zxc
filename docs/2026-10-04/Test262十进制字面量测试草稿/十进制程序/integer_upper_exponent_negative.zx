export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 49:
            return 0E-1
        case 50:
            return 1E-1
        case 51:
            return 2E-1
        case 52:
            return 3E-1
        case 53:
            return 4E-1
        case 54:
            return 5E-1
        case 55:
            return 6E-1
        case 56:
            return 7E-1
        case 57:
            return 8E-1
        case 58:
            return 9E-1
        default:
            return 0
    }
}
