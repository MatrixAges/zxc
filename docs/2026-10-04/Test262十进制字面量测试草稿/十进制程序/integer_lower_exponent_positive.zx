export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 59:
            return 0e+1
        case 60:
            return 1e+1
        case 61:
            return 2e+1
        case 62:
            return 3e+1
        case 63:
            return 4e+1
        case 64:
            return 5e+1
        case 65:
            return 6e+1
        case 66:
            return 7e+1
        case 67:
            return 8e+1
        case 68:
            return 9e+1
        default:
            return 0
    }
}
