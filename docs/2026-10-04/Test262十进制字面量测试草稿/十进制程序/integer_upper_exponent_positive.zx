export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 69:
            return 0E+1
        case 70:
            return 1E+1
        case 71:
            return 2E+1
        case 72:
            return 3E+1
        case 73:
            return 4E+1
        case 74:
            return 5E+1
        case 75:
            return 6E+1
        case 76:
            return 7E+1
        case 77:
            return 8E+1
        case 78:
            return 9E+1
        default:
            return 0
    }
}
