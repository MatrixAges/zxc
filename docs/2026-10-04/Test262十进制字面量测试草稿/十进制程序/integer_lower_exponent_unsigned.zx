export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 19:
            return 0e1
        case 20:
            return 1e1
        case 21:
            return 2e1
        case 22:
            return 3e1
        case 23:
            return 4e1
        case 24:
            return 5e1
        case 25:
            return 6e1
        case 26:
            return 7e1
        case 27:
            return 8e1
        case 28:
            return 9e1
        case 79:
            return 0e0
        case 80:
            return 1e0
        case 81:
            return 2e0
        case 82:
            return 3e0
        case 83:
            return 4e0
        case 84:
            return 5e0
        case 85:
            return 6e0
        case 86:
            return 7e0
        case 87:
            return 8e0
        case 88:
            return 9e0
        default:
            return 0
    }
}
