import integerDigit from "./十进制程序/integer_digit"
import integerDecimal2Digits from "./十进制程序/integer_decimal_2_digits"
import integerLowerExponentUnsigned from "./十进制程序/integer_lower_exponent_unsigned"
import integerUpperExponentUnsigned from "./十进制程序/integer_upper_exponent_unsigned"
import integerLowerExponentNegative from "./十进制程序/integer_lower_exponent_negative"
import integerUpperExponentNegative from "./十进制程序/integer_upper_exponent_negative"
import integerLowerExponentPositive from "./十进制程序/integer_lower_exponent_positive"
import integerUpperExponentPositive from "./十进制程序/integer_upper_exponent_positive"

export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    if ((in >= 0 && in <= 9)) {
        return integerDigit(in)
    }

    if ((in >= 10 && in <= 18)) {
        return integerDecimal2Digits(in)
    }

    if ((in >= 19 && in <= 28) || (in >= 79 && in <= 88)) {
        return integerLowerExponentUnsigned(in)
    }

    if ((in >= 29 && in <= 38) || (in >= 89 && in <= 98)) {
        return integerUpperExponentUnsigned(in)
    }

    if ((in >= 39 && in <= 48)) {
        return integerLowerExponentNegative(in)
    }

    if ((in >= 49 && in <= 58)) {
        return integerUpperExponentNegative(in)
    }

    if ((in >= 59 && in <= 68)) {
        return integerLowerExponentPositive(in)
    }

    if ((in >= 69 && in <= 78)) {
        return integerUpperExponentPositive(in)
    }

    return 0
}
