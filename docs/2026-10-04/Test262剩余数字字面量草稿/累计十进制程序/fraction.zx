export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 99:
            return 0.0
        case 100:
            return 1.0
        case 101:
            return 2.0
        case 102:
            return 3.0
        case 103:
            return 4.0
        case 104:
            return 5.0
        case 105:
            return 6.0
        case 106:
            return 7.0
        case 107:
            return 8.0
        case 108:
            return 9.0
        case 109:
            return 0.00
        case 110:
            return 1.00
        case 111:
            return 2.00
        case 112:
            return 3.00
        case 113:
            return 4.00
        case 114:
            return 5.00
        case 115:
            return 6.00
        case 116:
            return 7.00
        case 117:
            return 8.00
        case 118:
            return 9.00
        case 119:
            return 0.0
        case 120:
            return 1.1
        case 121:
            return 2.2
        case 122:
            return 3.3
        case 123:
            return 4.4
        case 124:
            return 5.5
        case 125:
            return 6.6
        case 126:
            return 7.7
        case 127:
            return 8.8
        case 128:
            return 9.9
        default:
            return 0
    }
}
