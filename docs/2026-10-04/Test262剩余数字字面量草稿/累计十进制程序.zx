import integerDigit from "./累计十进制程序/integer_digit"
import integerDecimal2Digits from "./累计十进制程序/integer_decimal_2_digits"
import integerLowerExponentUnsigned from "./累计十进制程序/integer_lower_exponent_unsigned"
import integerUpperExponentUnsigned from "./累计十进制程序/integer_upper_exponent_unsigned"
import integerLowerExponentNegative from "./累计十进制程序/integer_lower_exponent_negative"
import integerUpperExponentNegative from "./累计十进制程序/integer_upper_exponent_negative"
import integerLowerExponentPositive from "./累计十进制程序/integer_lower_exponent_positive"
import integerUpperExponentPositive from "./累计十进制程序/integer_upper_exponent_positive"
import fraction from "./累计十进制程序/fraction"
import fractionExponentUnsigned from "./累计十进制程序/fraction_exponent_unsigned"
import fractionExponentNegative from "./累计十进制程序/fraction_exponent_negative"
import fractionExponentPositive from "./累计十进制程序/fraction_exponent_positive"
import integerLeadingZero2Digits from "./累计十进制程序/integer_leading_zero_2_digits"
import integerLeadingZero3Digits from "./累计十进制程序/integer_leading_zero_3_digits"
import integerLeadingZero4Digits from "./累计十进制程序/integer_leading_zero_4_digits"
import integerDecimal3Digits from "./累计十进制程序/integer_decimal_3_digits"
import integerSigned from "./累计十进制程序/integer_signed"

export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    if ((in >= 0 && in <= 9)) {
        return integerDigit(in)
    }

    if ((in >= 10 && in <= 18)) {
        return integerDecimal2Digits(in)
    }

    if ((in >= 19 && in <= 28) || (in >= 79 && in <= 88) || (in >= 209 && in <= 218) || (in >= 269 && in <= 278)) {
        return integerLowerExponentUnsigned(in)
    }

    if ((in >= 29 && in <= 38) || (in >= 89 && in <= 98) || (in >= 219 && in <= 228) || (in >= 279 && in <= 288)) {
        return integerUpperExponentUnsigned(in)
    }

    if ((in >= 39 && in <= 48) || (in >= 229 && in <= 238)) {
        return integerLowerExponentNegative(in)
    }

    if ((in >= 49 && in <= 58) || (in >= 239 && in <= 248)) {
        return integerUpperExponentNegative(in)
    }

    if ((in >= 59 && in <= 68) || (in >= 249 && in <= 258)) {
        return integerLowerExponentPositive(in)
    }

    if ((in >= 69 && in <= 78) || (in >= 259 && in <= 268)) {
        return integerUpperExponentPositive(in)
    }

    if ((in >= 99 && in <= 128)) {
        return fraction(in)
    }

    if ((in >= 129 && in <= 148) || (in >= 189 && in <= 208)) {
        return fractionExponentUnsigned(in)
    }

    if ((in >= 149 && in <= 168) || in == 371) {
        return fractionExponentNegative(in)
    }

    if ((in >= 169 && in <= 188) || in == 372) {
        return fractionExponentPositive(in)
    }

    if ((in >= 289 && in <= 290)) {
        return integerLeadingZero2Digits(in)
    }

    if ((in >= 291 && in <= 300) || (in >= 311 && in <= 320) || (in >= 331 && in <= 340) || (in >= 351 && in <= 360)) {
        return integerLeadingZero3Digits(in)
    }

    if ((in >= 301 && in <= 310) || (in >= 321 && in <= 330) || (in >= 341 && in <= 350) || (in >= 361 && in <= 370)) {
        return integerLeadingZero4Digits(in)
    }

    if ((in >= 373 && in <= 392)) {
        return integerDecimal3Digits(in)
    }

    if ((in >= 393 && in <= 402)) {
        return integerSigned(in)
    }

    return 0
}
