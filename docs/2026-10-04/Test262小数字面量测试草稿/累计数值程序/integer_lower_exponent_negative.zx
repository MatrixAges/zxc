export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 39:
            return 0e-1
        case 40:
            return 1e-1
        case 41:
            return 2e-1
        case 42:
            return 3e-1
        case 43:
            return 4e-1
        case 44:
            return 5e-1
        case 45:
            return 6e-1
        case 46:
            return 7e-1
        case 47:
            return 8e-1
        case 48:
            return 9e-1
        default:
            return 0
    }
}
