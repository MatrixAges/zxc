export type Input = u64

export type Output = f64

export default function (in: Input): Output {
    switch (in) {
        case 29:
            return 0E1
        case 30:
            return 1E1
        case 31:
            return 2E1
        case 32:
            return 3E1
        case 33:
            return 4E1
        case 34:
            return 5E1
        case 35:
            return 6E1
        case 36:
            return 7E1
        case 37:
            return 8E1
        case 38:
            return 9E1
        case 89:
            return 0E0
        case 90:
            return 1E0
        case 91:
            return 2E0
        case 92:
            return 3E0
        case 93:
            return 4E0
        case 94:
            return 5E0
        case 95:
            return 6E0
        case 96:
            return 7E0
        case 97:
            return 8E0
        case 98:
            return 9E0
        default:
            return 0
    }
}
