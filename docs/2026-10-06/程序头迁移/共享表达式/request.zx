import parse from "../../../../packages/compiler/src/zx/frontend/parser/body/expression"
import start from "../../../../packages/compiler/src/zx/frontend/parser/expressions/state/start"

import type { State } from "./model"

export type Input = { state: State, start: u64 }

export type Output = State

export default function (in: owned Input): Output {
  const parsed = parse({ expression: start({
    prepared: in.state.state.prepared,
    tree: in.state.state.tree,
    types: in.state.state.types,
    start: in.start, depth: 0, minimum: 0, allow_lambda: true
  }), tree: in.state.body })

  const result = {
    root: parsed.expression.control.result,
    index: parsed.expression.control.root_index,
    valid: parsed.control.diagnostic.message == "" && !parsed.control.expression_diagnostic
  }

  const results = in.state.results.push(result)[0]

  return { state: parsed.expression, body: parsed.tree, results: results }
}
