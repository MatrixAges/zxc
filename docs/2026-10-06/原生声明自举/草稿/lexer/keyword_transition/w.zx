export type Input = { state: u64, byte: u8 }

export type Output = u64

export default function (in: Input): Output {
    switch (in.state) {
        case 215: return match {
            in.byte == 104 => 216,
            _ => 1
        }
        case 216: return match {
            in.byte == 105 => 217,
            _ => 1
        }
        case 217: return match {
            in.byte == 108 => 218,
            _ => 1
        }
        case 218: return match {
            in.byte == 101 => 219,
            _ => 1
        }
        default: return 1
    }
}
