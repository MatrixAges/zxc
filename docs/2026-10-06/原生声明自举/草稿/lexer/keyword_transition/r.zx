export type Input = { state: u64, byte: u8 }

export type Output = u64

export default function (in: Input): Output {
    switch (in.state) {
        case 162: return match {
            in.byte == 101 => 163,
            _ => 1
        }
        case 163: return match {
            in.byte == 113 => 164,
            in.byte == 116 => 170,
            _ => 1
        }
        case 164: return match {
            in.byte == 117 => 165,
            _ => 1
        }
        case 165: return match {
            in.byte == 105 => 166,
            _ => 1
        }
        case 166: return match {
            in.byte == 114 => 167,
            _ => 1
        }
        case 167: return match {
            in.byte == 101 => 168,
            _ => 1
        }
        case 168: return match {
            in.byte == 115 => 169,
            _ => 1
        }
        case 170: return match {
            in.byte == 117 => 171,
            _ => 1
        }
        case 171: return match {
            in.byte == 114 => 172,
            _ => 1
        }
        case 172: return match {
            in.byte == 110 => 173,
            _ => 1
        }
        default: return 1
    }
}
