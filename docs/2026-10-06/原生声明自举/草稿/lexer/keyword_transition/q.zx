export type Input = { state: u64, byte: u8 }

export type Output = u64

export default function (in: Input): Output {
    switch (in.state) {
        case 150: return match {
            in.byte == 117 => 151,
            _ => 1
        }
        case 151: return match {
            in.byte == 101 => 152,
            _ => 1
        }
        case 152: return match {
            in.byte == 114 => 153,
            _ => 1
        }
        case 153: return match {
            in.byte == 121 => 154,
            _ => 1
        }
        case 154: return match {
            in.byte == 77 => 155,
            in.byte == 79 => 159,
            _ => 1
        }
        case 155: return match {
            in.byte == 97 => 156,
            _ => 1
        }
        case 156: return match {
            in.byte == 110 => 157,
            _ => 1
        }
        case 157: return match {
            in.byte == 121 => 158,
            _ => 1
        }
        case 159: return match {
            in.byte == 110 => 160,
            _ => 1
        }
        case 160: return match {
            in.byte == 101 => 161,
            _ => 1
        }
        default: return 1
    }
}
