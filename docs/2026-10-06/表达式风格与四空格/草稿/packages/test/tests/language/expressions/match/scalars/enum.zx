export enum State { First, Second, Third }

export type Input = { target: u8
    first: u8
    second: u8 }

export type Output = u8

export default function (in: Input): Output {
    const target = match {
        in.target == 0 => State.First,
        in.target == 1 => State.Second,
        _ => State.Third
    }

    const first = match {
        in.first == 0 => State.First,
        in.first == 1 => State.Second,
        _ => State.Third
    }

    const second = match {
        in.second == 0 => State.First,
        in.second == 1 => State.Second,
        _ => State.Third
    }

    return match target {
        first => 11,
        second => 22,
        _ => 33,
    }
}
