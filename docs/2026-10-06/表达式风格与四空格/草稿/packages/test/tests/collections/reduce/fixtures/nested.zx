export type Input = { seed: u64[], steps: { enabled: bool, value: u64, values: u64[] }[] }

export type Output = u64[]

export default function (in: Input): Output {
    const initial = in.seed.map(item => item)

    return in.steps.reduce((items, step) => match {
        step.enabled => (match {
            step.values.length > 0 => items.concat(step.values)[0],
            _ => items.push(step.value)[0]
        }),
        _ => items
    }, initial)
}
