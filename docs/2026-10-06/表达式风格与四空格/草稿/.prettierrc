{
    "$schema": "https://json.schemastore.org/prettierrc",
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 120,
    "useTabs": false,
    "semi": false,
    "tabWidth": 4,
    "jsxSingleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf"
}
