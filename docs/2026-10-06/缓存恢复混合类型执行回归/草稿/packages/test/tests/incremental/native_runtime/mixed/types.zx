import type { Mode } from "zig:choice"

export type Request = {
  values: Mode[],
  saved: u64?,
  record: { value: u64, enabled: bool },
  pair: [u64, bool],
  mode: Mode,
  index: u64
}

export type Response = {
  values: Mode[],
  saved: u64?,
  record: { value: u64, enabled: bool },
  pair: [u64, bool],
  mode: Mode,
  picked: Mode?,
  missing: bool
}
