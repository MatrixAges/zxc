import type { Fields } from "./model"

export type Input = { fields: Fields, name: string }

export type Output = u32

export default function (in: Input): Output {
    const state = loop({ fields: in.fields, name: in.name, index: 0 }, {
        while: value => value.fields.names[value.index] != value.name,
        next: value => { value.index += 1 }
    })

    return state.fields.types[state.index]
}
