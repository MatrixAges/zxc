import type { Bindings } from "../model"

export type Input = { origins: Bindings, names: string[], index: u64 }

export type Output = bool

export default function (in: Input): Output {
    const state = loop({ origins: in.origins, names: in.names, index: in.index, previous: 0, unique: true }, {
        while: current => current.unique && current.previous < current.index,
        next: current => {
            const previous = current.previous
            const index = current.index
            const same_id = current.origins.ids[previous] == current.origins.ids[index]
            const same_origin = current.origins.kinds[previous] == current.origins.kinds[index] &&
                current.origins.owners[previous] == current.origins.owners[index] &&
                current.origins.members[previous] == current.origins.members[index]

            current.unique = !same_id && !(same_origin && current.names[previous] == current.names[index])
            current.previous += 1
        }
    })

    return state.unique
}
