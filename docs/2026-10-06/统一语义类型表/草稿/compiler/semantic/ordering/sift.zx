import columns from "zig:named_columns"

import type { Columns } from "zig:named_columns"

export type Input = { columns: Columns, start: u64, count: u64 }

export type Output = void

export default function (in: Input): Output {
    const state = loop({ columns: in.columns, root: in.start, count: in.count, active: true }, {
        while: current => current.active && current.root < current.count / 2,
        next: current => {
            const left = current.root * 2 + 1
            const right = left + 1
            const child = right < current.count && columns.less(current.columns, left, right) ? right : left

            if (columns.less(current.columns, current.root, child)) {
                columns.swap(current.columns, current.root, child)
                current.root = child
            } else {
                current.active = false
            }
        }
    })

    return
}
