export enum Role { Invalid, Module, Import, Call, Task, Parallel, Switch, Case, Default, Emit, Return, Gateway, Group, Route, Store, StoreRef, Object, Field }

export enum ValueType { String, OptionalString, Unsigned, Protocol, Method }

export type Field = { count: u64, minimum: u64, empty: bool, name: string, kind: ValueType, required: bool, fallback: u64 }
