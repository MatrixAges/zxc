import { ValueType } from "../model"

import type { Field } from "../model"

export type Input = u64

export type Output = Field

export default function (in: Input): Output {
  switch (in) {
    case 0:
      return { count: 4, minimum: 0, empty: true, name: "fn", kind: ValueType.OptionalString, required: false, fallback: 0 }
    case 1:
      return { count: 4, minimum: 0, empty: true, name: "module", kind: ValueType.OptionalString, required: false, fallback: 0 }
    case 2:
      return { count: 4, minimum: 0, empty: true, name: "in", kind: ValueType.OptionalString, required: false, fallback: 0 }
    case 3:
      return { count: 4, minimum: 0, empty: true, name: "setter", kind: ValueType.OptionalString, required: false, fallback: 0 }
    default:
      return { count: 4, minimum: 0, empty: true, name: "", kind: ValueType.OptionalString, required: false, fallback: 0 }
  }
}
