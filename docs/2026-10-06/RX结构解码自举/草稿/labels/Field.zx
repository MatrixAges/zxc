import { ValueType } from "../model"

import type { Field } from "../model"

export type Input = u64

export type Output = Field

export default function (in: Input): Output {
  switch (in) {
    case 0:
      return { count: 3, minimum: 0, empty: true, name: "name", kind: ValueType.String, required: true, fallback: 0 }
    case 1:
      return { count: 3, minimum: 0, empty: true, name: "type", kind: ValueType.String, required: true, fallback: 0 }
    case 2:
      return { count: 3, minimum: 0, empty: true, name: "value", kind: ValueType.String, required: true, fallback: 0 }
    default:
      return { count: 3, minimum: 0, empty: true, name: "", kind: ValueType.OptionalString, required: false, fallback: 0 }
  }
}
