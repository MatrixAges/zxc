import { PartKind, EventKind } from "../model"
import addPart from "./add_part"

import type { Graph } from "./model"

export type Input = { graph: Graph, offset: u64 }

export type Output = Graph

export default function (in: Input): Output {
  const start = in.graph.frames[in.graph.frames.length - 1].text_start
  const reference = in.graph.interpolations + 1
  const graph = addPart({ graph: in.graph, kind: PartKind.Expression, span: { start: start, end: in.offset }, interpolation: reference, text_start: in.offset + 1 })
  const events = graph.events.push({ kind: EventKind.InterpolationClose, offset: in.offset, reference: reference })[0]

  return { templates: graph.templates, parts: graph.parts, events: events, frames: graph.frames, interpolations: reference, token_templates: graph.token_templates }
}
