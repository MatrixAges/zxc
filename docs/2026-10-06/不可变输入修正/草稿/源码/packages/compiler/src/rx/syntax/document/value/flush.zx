import type { State } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
  const end = in.control.location.offset

  if (in.control.text_start == end) {
    return in
  }

  const head = in.tree.parts.length + 1
  const count = in.control.value_count + 1
  const parts = in.tree.parts.push({ span: { start: in.control.text_start, end: end }, character: false, codepoint: 0, previous: in.control.value_head })[0]

  return {
    source: in.source, tree: { nodes: in.tree.nodes, attributes: in.tree.attributes, text: in.tree.text, children: in.tree.children, parts: parts }, frames: in.frames, frame: in.frame,
    control: { ...in.control, value_head: head, value_count: count, text_start: end }
  }
}
