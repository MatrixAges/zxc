import { Phase } from "../body/model"
import initial from "./body/initial"
import advance from "./body/step"

import type { BodyStage } from "./body/model"
import type { HeaderStage } from "./header/model"

export type Input = HeaderStage

export type Output = BodyStage

export default function (in: Input): Output {
  return loop(initial(in), {
    while: value => value.prefix.present && value.header.diagnostic.message == "" && !value.header.expression_diagnostic && value.body.control.phase != Phase.Done,
    next: value => {
      value = advance(value)
    }
  })
}
