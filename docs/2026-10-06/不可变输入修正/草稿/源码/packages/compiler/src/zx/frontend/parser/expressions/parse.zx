import parse from "../body/expression"
import emptyTree from "../body/state/empty_tree"
import initial from "./state/initial"
import { Phase } from "./state/model"

import type { PreparedInput } from "./prepare/model"
import type { Parsed } from "./result"

export type Input = { prepared: PreparedInput, start: u64, depth: u64, minimum: u8, allow_lambda: bool }

export type Output = Parsed

export default function (in: Input): Output {
  const parsed = parse({ expression: initial(in), tree: emptyTree() })
  const control = parsed.control.diagnostic.message != "" ? { ...parsed.expression.control, phase: Phase.Done, diagnostic: parsed.control.diagnostic } : parsed.expression.control

  return { prepared: parsed.expression.prepared, tree: parsed.expression.tree, types: parsed.expression.types, frames: parsed.expression.frames, control: control, body: parsed.tree }
}
