import finish from "../../../lexer/finish"
import flush from "../../../lexer/flush"
import appendTokenIds from "../boundary/append_token_ids"

import type { Session } from "./model"

export type Input = { session: Session, end: u64 }

export type Output = Session

export default function (in: Input): Output {
  const previous = in.session.lexer.tokens.length
  const lexer = finish(flush({ ...in.session.lexer, source_length: in.end }))
  const token_templates = appendTokenIds({ ids: in.session.token_templates, count: lexer.tokens.length - previous, template: 0 }).ids

  return { present: in.session.present, start: in.session.start, lexer: lexer, token_templates: token_templates }
}
