import diagnostic from "./diagnostic"

import type { Expression } from "../syntax/model"
import type { Parsed } from "./result"

export type Input = Parsed

export type Output = Expression

export default function (in: Input): Output {
  const issue = diagnostic(in)
  const lexical = in.prepared.lexical.lexed

  return {
    types: in.types.tree,
    expressions: in.tree,
    blocks: in.body,
    tokens: lexical.tokens,
    comments: lexical.comments,
    result: in.control.result,
    diagnostic: issue
  }
}
