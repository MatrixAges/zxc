import { Symbol } from "../../../lexer/token_model"
import restart from "../../expressions/state/restart"
import { Phase } from "../model"
import fail from "./fail"

import type { State } from "../model"

export type Input = { state: State, resume: Phase, minimum: u8 }

export type Output = State

export default function (in: Input): Output {
  if (in.state.expression.control.token.symbol == Symbol.Semicolon) {
    return fail({ state: in.state, code: "syntax", message: "semicolons are not allowed in ZX" })
  }

  const depth = in.state.frame.depth
  const expression = restart({ state: in.state.expression, depth: depth, minimum: in.minimum })

  return { expression: expression, tree: in.state.tree, frames: in.state.frames, suspended: in.state.suspended, frame: in.state.frame, control: { ...in.state.control, phase: Phase.Expression, resume: in.resume } }
}
