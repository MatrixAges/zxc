import type { Diagnostic } from "../../../lexer/model"
import type { Token, Span } from "../../../lexer/token_model"
import type { Boundary, Template, Part, Event } from "../model"

export type Input = Diagnostic

export type Output = Boundary

export default function (in: Input): Output {
  const tokens: Token[] = []
  const comments: Span[] = []
  const templates: Template[] = []
  const parts: Part[] = []
  const events: Event[] = []
  const token_templates: u64[] = []

  return { lexed: { tokens: tokens, comments: comments, diagnostic: in }, templates: templates, parts: parts, events: events, token_templates: token_templates }
}
