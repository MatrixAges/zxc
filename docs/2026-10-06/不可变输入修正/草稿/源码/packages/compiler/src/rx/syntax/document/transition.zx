import { Phase } from "./model"

import type { State } from "./model"

export type Input = { state: State, phase: Phase }

export type Output = State

export default function (in: Input): Output {
  return { source: in.state.source, tree: in.state.tree, frames: in.state.frames, frame: in.state.frame, control: { ...in.state.control, phase: in.phase } }
}
